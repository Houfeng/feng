module fcts_bin;

import std.io;
import std.test;

// 用于异常测试的自定义 type
type ExAppError {
  let code: int;
  let msg: string;
}

// 用于异常测试的 spec
spec ExDescribable {
  func ex_describe(): string;
}

type ExTaggedError: ExDescribable {
  let msg: string;

  func ex_describe(): string {
    return self.msg;
  }
}

// 构造 spec 值并 throw
func make_ex_describable(msg: string): ExDescribable {
  let e = ExTaggedError { msg: msg };
  return e;
}

func throw_ex_spec(msg: string): string {
  throw make_ex_describable(msg);
  return "unreachable";
}

// throw 自定义 type
func throw_ex_type(code: int, msg: string): string {
  let e = ExAppError { code: code, msg: msg };
  throw e;
  return "unreachable";
}

// catch 中 break 辅助
func throw_ex_void() {
  throw "boom";
}

func ex_break_from_catch(): string {
  while true {
    try throw_ex_void() catch ex: string {
      break;
    }
  }
  return "after-break";
}

// catch 中 continue 辅助
func ex_continue_from_catch(): int {
  var index = 0;
  var skipped = 0;
  while index < 3 {
    index += 1;
    try throw_ex_void() catch ex: string {
      skipped += 1;
      continue;
    }
  }
  return skipped;
}

// catch 中 return 辅助
func ex_return_from_catch(): string {
  let value = try throw_ex_text() catch ex: string {
    return "catch-return";
  };
  return value;
}

func throw_ex_text(): string {
  throw "boom";
  return "unreachable";
}

/** 异常处理测试 - lambda 中的 try/catch 辅助函数 */

func run_action(f: Action) {
  f();
}

func lambda_throw_error(): string {
  throw "lambda-error";
  return "unreachable";
}

func lambda_throw_int() {
  let v: i32 = 99;
  throw v;
}

func test_lambda_basic_try_catch(): bool {
  var caught = false;
  run_action(() {
    try lambda_throw_error() catch ex: string {
      if ex == "lambda-error" {
        caught = true;
      }
    }
  });
  return caught;
}

func test_lambda_try_catch_expression(): bool {
  var value: int = 0;
  let fallback: int = -1;
  run_action(() {
    value = try parse_int("bad") catch ex: string {
      fallback;
    };
  });
  return value == -1;
}

func test_lambda_multiple_catch(): bool {
  var catch_type = "";
  run_action(() {
    try lambda_throw_int() catch ex: string {
      catch_type = "string";
    } catch ex: i32 {
      catch_type = "int";
    }
  });
  return catch_type == "int";
}

func test_lambda_anonymous_catch(): bool {
  var anon_caught = false;
  run_action(() {
    try lambda_throw_error() catch {
      anon_caught = true;
    }
  });
  return anon_caught;
}

func test_lambda_auto_propagation(): bool {
  var propagated = false;
  try run_action(() {
    lambda_throw_error();
  }) catch ex: string {
    if ex == "lambda-error" {
      propagated = true;
    }
  }
  return propagated;
}

func test_lambda_rethrow_in_catch(): bool {
  var rethrown = false;
  try run_action(() {
    try lambda_throw_error() catch ex: string {
      throw "rethrown: " + ex;
    }
  }) catch ex: string {
    if ex == "rethrown: lambda-error" {
      rethrown = true;
    }
  }
  return rethrown;
}

func test_lambda_try_catch_normal_path(): bool {
  var value: int = 0;
  let fallback: int = -1;
  run_action(() {
    value = try parse_int("ok") catch ex: string {
      fallback;
    };
  });
  return value == 42;
}

func test_lambda_try_catch_string_result(): bool {
  var value = "";
  run_action(() {
    value = try lambda_throw_error() catch ex: string {
      "caught: " + ex;
    };
  });
  return value == "caught: lambda-error";
}

func test_basic_try_catch(): bool {
  var caught = false;
  try throw_error() catch ex: string {
    if ex == "test error" {
      caught = true;
    }
  }
  return caught;
}

func test_try_catch_expression(): bool {
  let fallback: int = -1;
  let value = try parse_int("bad") catch ex: string {
    fallback;
  };
  return value == -1;
}

func test_try_catch_normal_path(): bool {
  let fallback: int = -1;
  let ok_value = try parse_int("ok") catch ex: string {
    fallback;
  };
  return ok_value == 42;
}

func test_multiple_catch_clauses(): bool {
  var catch_type = "";
  try throw_int() catch ex: string {
    catch_type = "string";
  } catch ex: i32 {
    catch_type = "int";
  }
  return catch_type == "int";
}

func test_catch_unknown_fallback(): bool {
  var unknown_caught = false;
  try throw_error() catch ex: int {
    // 不匹配
  } catch ex: unknown {
    unknown_caught = true;
  }
  return unknown_caught;
}

func test_anonymous_catch(): bool {
  var anon_caught = false;
  try throw_error() catch {
    anon_caught = true;
  }
  return anon_caught;
}

func test_auto_propagation(): bool {
  var propagated = false;
  try call_auto_propagate() catch ex: string {
    if ex == "propagated" {
      propagated = true;
    }
  }
  return propagated;
}

func test_no_throw_path(): bool {
  var no_error = true;
  try maybe_throw(false) catch ex: string {
    no_error = false;
  }
  return no_error;
}

func test_rethrow_in_catch(): bool {
  var rethrown = false;
  try call_rethrow() catch ex: string {
    if ex == "rethrown: test error" {
      rethrown = true;
    }
  }
  return rethrown;
}

func test_throw_catch_custom_type(): bool {
  var app_code = 0;
  var app_msg = "";
  try throw_ex_type(404, "not found") catch ex: ExAppError {
    app_code = ex.code;
    app_msg = ex.msg;
  }
  return app_code == 404 && app_msg == "not found";
}

func test_throw_catch_spec_value(): bool {
  var spec_msg = "";
  try throw_ex_spec("spec-error") catch ex: ExTaggedError {
    spec_msg = ex.msg;
  }
  return spec_msg == "spec-error";
}

/** 异常处理测试 */
open func test_exception() {
  describe("exception", () {
    test("basic try/catch", () {
      assert(test_basic_try_catch(), "basic try/catch");
    });

    test("try/catch expression", () {
      assert(test_try_catch_expression(), "try/catch expression");
    });

    test("try/catch normal path", () {
      assert(test_try_catch_normal_path(), "try/catch normal path");
    });

    test("multiple catch clauses", () {
      assert(test_multiple_catch_clauses(), "multiple catch clauses");
    });

    test("catch unknown fallback", () {
      assert(test_catch_unknown_fallback(), "catch unknown fallback");
    });

    test("anonymous catch", () {
      assert(test_anonymous_catch(), "anonymous catch");
    });

    test("try without catch auto-propagation", () {
      assert(test_auto_propagation(), "try without catch auto-propagation");
    });

    test("try/catch normal path (no throw)", () {
      assert(test_no_throw_path(), "try/catch normal path (no throw)");
    });

    test("rethrow in catch", () {
      assert(test_rethrow_in_catch(), "rethrow in catch");
    });

    test("break from catch", () {
      assert(ex_break_from_catch() == "after-break", "break from catch");
    });

    test("continue from catch", () {
      assert(ex_continue_from_catch() == 3, "continue from catch");
    });

    test("return from catch", () {
      assert(ex_return_from_catch() == "catch-return", "return from catch");
    });

    test("throw/catch custom type", () {
      assert(test_throw_catch_custom_type(), "throw/catch custom type");
    });

    test("throw/catch spec value via concrete type", () {
      assert(test_throw_catch_spec_value(), "throw/catch spec value via concrete type");
    });

    test("lambda basic try/catch", () {
      assert(test_lambda_basic_try_catch(), "lambda basic try/catch");
    });

    test("lambda try/catch expression", () {
      assert(test_lambda_try_catch_expression(), "lambda try/catch expression");
    });

    test("lambda multiple catch clauses", () {
      assert(test_lambda_multiple_catch(), "lambda multiple catch clauses");
    });

    test("lambda anonymous catch", () {
      assert(test_lambda_anonymous_catch(), "lambda anonymous catch");
    });

    test("lambda auto-propagation", () {
      assert(test_lambda_auto_propagation(), "lambda auto-propagation");
    });

    test("lambda rethrow in catch", () {
      assert(test_lambda_rethrow_in_catch(), "lambda rethrow in catch");
    });

    test("lambda try/catch normal path", () {
      assert(test_lambda_try_catch_normal_path(), "lambda try/catch normal path");
    });

    test("lambda try/catch string result", () {
      assert(test_lambda_try_catch_string_result(), "lambda try/catch string result");
    });

    test("throw/catch tuple type", () {
      assert(test_throw_catch_tuple_point(), "throw/catch tuple type");
    });

    test("throw/catch trivial @value type", () {
      assert(test_throw_catch_value_point(), "throw/catch trivial @value type");
    });

    test("throw/catch aggregate @value type", () {
      assert(test_throw_catch_value_error(), "throw/catch aggregate @value type");
    });

    test("@value type exception value semantics", () {
      assert(test_value_exception_independence(), "@value type exception value semantics");
    });

    test("multiple catch clauses with @value types", () {
      assert(test_multiple_catch_value_types(), "multiple catch clauses with @value types");
    });

    test("@value type exception rethrow", () {
      assert(test_value_exception_rethrow(), "@value type exception rethrow");
    });
  });
}

func throw_error() {
  throw "test error";
}

func throw_int() {
  let v: i32 = 42;
  throw v;
}

func parse_int(s: string): int {
  if s == "ok" {
    return 42;
  }
  throw "parse failed";
  return 0;
}

func auto_propagate() {
  throw_propagated();
}

func throw_propagated() {
  throw "propagated";
}

func maybe_throw(do_throw: bool) {
  if do_throw {
    throw "error";
  }
}

func call_auto_propagate() {
  auto_propagate();
}

func call_rethrow() {
  try throw_error() catch ex: string {
    throw "rethrown: " + ex;
  }
}

// ============================================================================
// @value type exception tests (§9.14)
// ============================================================================

// Tuple type for exception testing (also exercises the value-semantics path)
type ExTuplePoint(float, float);

func throw_tuple_point(x: float, y: float): float {
  let p: ExTuplePoint = (x, y);
  throw p;
  return 0.0;
}

func test_throw_catch_tuple_point(): bool {
  var caught_x: float = 0.0;
  var caught_y: float = 0.0;
  try throw_tuple_point(5.0, 6.0) catch ex: ExTuplePoint {
    caught_x = ex.item1;
    caught_y = ex.item2;
  }
  return caught_x == 5.0 && caught_y == 6.0;
}

// Trivial @value type for exception testing
@value
type ExValuePoint {
  var x: float;
  var y: float;
}

// Aggregate @value type for exception testing (has managed field)
@value
type ExValueError {
  let code: int;
  let message: string;
}

// Throw trivial @value type
func throw_value_point(x: float, y: float): float {
  let p = ExValuePoint { x: x, y: y };
  throw p;
  return 0.0;
}

// Throw aggregate @value type
func throw_value_error(code: int, msg: string): string {
  let e = ExValueError { code: code, message: msg };
  throw e;
  return "unreachable";
}

// Test throw/catch trivial @value type
func test_throw_catch_value_point(): bool {
  var caught_x: float = 0.0;
  var caught_y: float = 0.0;
  try throw_value_point(3.0, 4.0) catch ex: ExValuePoint {
    caught_x = ex.x;
    caught_y = ex.y;
  }
  return caught_x == 3.0 && caught_y == 4.0;
}

// Test throw/catch aggregate @value type
func test_throw_catch_value_error(): bool {
  var caught_code: int = 0;
  var caught_msg = "";
  try throw_value_error(404, "not found") catch ex: ExValueError {
    caught_code = ex.code;
    caught_msg = ex.message;
  }
  return caught_code == 404 && caught_msg == "not found";
}

// Test value semantics: caught @value is independent copy
func throw_value_point_direct() {
  let original = ExValuePoint { x: 1.0, y: 2.0 };
  throw original;
}

func test_value_exception_independence(): bool {
  var original = ExValuePoint { x: 1.0, y: 2.0 };
  var caught_x: float = 0.0;
  try throw_value_point_direct() catch ex: ExValuePoint {
    caught_x = ex.x;
    // Modify caught value should not affect original
    ex.x = 999.0;
  }
  // Original should still be 1.0 (value semantics)
  return caught_x == 1.0 && original.x == 1.0;
}

// Test multiple catch clauses with @value types
func test_multiple_catch_value_types(): bool {
  var catch_type = "";
  try throw_value_error(500, "error") catch ex: ExValuePoint {
    catch_type = "point";
  } catch ex: ExValueError {
    catch_type = "error";
  }
  return catch_type == "error";
}

// Test @value type exception with rethrow
func throw_rethrown_value_error() {
  try throw_value_error(100, "first") catch ex: ExValueError {
    throw ExValueError { code: ex.code + 1, message: "rethrown" };
  }
}

func test_value_exception_rethrow(): bool {
  var rethrown_code: int = 0;
  try throw_rethrown_value_error() catch ex: ExValueError {
    rethrown_code = ex.code;
  }
  return rethrown_code == 101;
}
