module fcts_bin;

import std.io;
import std.test;
import std.text;
import std.collections;

/** 数组测试 */
open func test_array() {
  describe("array", () {
    test("array literal", () {
      let nums = [1, 2, 3];
      assert(nums.length() == (i64)3, "array literal");
    });

    test("array index access", () {
      let nums = [1, 2, 3];
      assert(nums[0] == 1 && nums[1] == 2 && nums[2] == 3, "array index access");
    });

    test("writable array T[!]", () {
      let writable: int[!] = [10, 20, 30];
      writable[0] = 99;
      assert(writable[0] == 99, "writable array T[!]");
    });

    test("array creation expression Type[:n]", () {
      let buf: int[!] = int[: (i64)5];
      assert(buf.length() == (i64)5 && buf[0] == 0, "array creation expression Type[:n]");
    });

    test("empty array", () {
      let empty: int[] = [];
      assert(empty.length() == (i64)0, "empty array");
    });

    test("multi-dimensional array", () {
      let matrix = [[1, 2], [3, 4]];
      assert(matrix[0][0] == 1 && matrix[1][1] == 4, "multi-dimensional array");
    });

    test("writable outer array int[][!]", () {
      let w_matrix: int[][!] = [[1, 2], [3, 4]];
      w_matrix[0] = [5, 6];
      assert(w_matrix[0][0] == 5, "writable outer array int[][!]");
    });

    test("writable inner array int[!][]", () {
      let iw_matrix: int[!][] = [[1, 2], [3, 4]];
      iw_matrix[0][0] = 99;
      assert(iw_matrix[0][0] == 99, "writable inner array int[!][]");
    });

    test("explicit cast T[!] to T[]", () {
      let writable: int[!] = [10, 20, 30];
      writable[0] = 99;
      let ro = (int[])writable;
      assert(ro[0] == 99, "explicit cast T[!] to T[]");
    });

    test("for/in array traversal", () {
      let items = [10, 20, 30];
      var sum = 0;
      for let item in items {
        sum += item;
      }
      assert(sum == 60, "for/in array traversal");
    });

    test("array reference semantics", () {
      let arr1: int[!] = [1, 2, 3];
      let arr2 = arr1;
      arr2[0] = 100;
      assert(arr1[0] == 100, "array reference semantics");
    });

    test("string array", () {
      let names = ["Alice", "Bob", "Charlie"];
      assert(names[1] == "Bob", "string array");
    });

    test("array default zero value (empty)", () {
      let default_arr: int[];
      assert(default_arr.length() == (i64)0, "array default zero value (empty)");
    });
  });
}
