module fcts_bin;

import std.io;
import std.test;
import std.collections;
import fcts_lib.helper;

// 变长参数函数
func join_strings(sep: string, parts: string...): string {
  var result = "";
  let length = parts.length();
  for var i: int = (int)0; i < length; i += (int)1 {
    if i > (int)0 {
      result = result + sep;
    }
    result = result + parts[i];
  }
  return result;
}

// 仅变长参数
func count_args(items: int...): int {
  return items.length();
}

// 零分配转发已有变参数组
func forward_join_strings(sep: string, parts: string...): string {
  return join_strings(sep, ...parts);
}

func receives_same_array(expected: int[], actual: int...): bool {
  return expected == actual;
}

func generic_count_args<T>(items: T...): int {
  return items.length();
}

func generic_forward_args<T>(items: T...): int {
  return generic_count_args<T>(...items);
}

type VariadicRelay {
  func count(items: int...): int {
    return items.length();
  }

  func forward(items: int...): int {
    return self.count(...items);
  }

  static func forwardStatic(items: int...): int {
    return count_args(...items);
  }

  func genericForward<T>(items: T...): int {
    return 1;
  }

  static func genericForwardStatic<T>(items: T...): int {
    return 1;
  }
}

/** 引用类型变参构造函数，保存归一化后的只读数组。 */
type VariadicConstructor {
  let first: int;
  let rest: int[];

  func VariadicConstructor(first: int, rest: int...) {
    self.first = first;
    self.rest = rest;
  }
}

/** 仅包含变参位的构造函数，覆盖零固定参数的归一化。 */
type VariadicOnlyConstructor {
  let values: int[];

  func VariadicOnlyConstructor(values: int...) {
    self.values = values;
  }
}

/** 泛型宿主的变参构造函数，覆盖具化构造路径。 */
type GenericVariadicConstructor<T> {
  let first: T;
  let rest: T[];

  func GenericVariadicConstructor(first: T, rest: T...) {
    self.first = first;
    self.rest = rest;
  }
}

/** 值类型变参构造函数，验证与引用类型使用同一调用规则。 */
@value
type VariadicValueConstructor {
  let first: int;
  let rest: int[];

  func VariadicValueConstructor(first: int, rest: int...) {
    self.first = first;
    self.rest = rest;
  }
}

/** 验证成员声明初始化器中的变参值类型构造调用。 */
type VariadicConstructorHolder {
  let value = VariadicValueConstructor(1, 2, 3);
}

var prepacked_eval_count: int = 0;

func make_prepacked_args(): int[] {
  prepacked_eval_count += 1;
  return [7, 8];
}

// callable-form spec 中的变长参数
spec Printer(args: string...): void;
spec VariadicCounter(args: int...): int;

/** 变长参数测试 */
open func test_variadic() {
  describe("variadic", () {
    test("variadic multiple args", () {
      let result = join_strings(", ", "a", "b", "c");
      assert(result == "a, b, c", "variadic multiple args");
    });

    test("variadic single arg", () {
      let single = join_strings("-", "only");
      assert(single == "only", "variadic single arg");
    });

    test("variadic zero args", () {
      let empty = join_strings("+");
      assert(empty == "", "variadic zero args");
    });

    test("variadic-only function", () {
      assert(count_args(1, 2, 3, 4, 5) == 5, "variadic-only function");
      assert(count_args() == 0, "variadic-only function (zero args)");
    });

    test("variadic constructor ordinary packing", () {
      let empty = VariadicConstructor(1);
      let multiple = VariadicConstructor(2, 3, 4);
      assert(empty.first == 1 && empty.rest.length() == 0,
             "variadic constructor zero suffix");
      assert(multiple.first == 2 && multiple.rest.length() == 2 &&
             multiple.rest[0] == 3 && multiple.rest[1] == 4,
             "variadic constructor multiple suffix");
    });

    test("variadic-only constructor ordinary packing", () {
      let empty = VariadicOnlyConstructor();
      let multiple = VariadicOnlyConstructor(1, 2, 3);
      assert(empty.values.length() == 0,
             "variadic-only constructor zero args");
      assert(multiple.values.length() == 3 &&
             multiple.values[0] == 1 && multiple.values[2] == 3,
             "variadic-only constructor multiple args");
    });

    test("generic variadic constructor packing and forwarding", () {
      let empty = GenericVariadicConstructor<int>(1);
      let values: int[] = [3, 4];
      let forwarded = GenericVariadicConstructor<int>(2, ...values);
      assert(empty.first == 1 && empty.rest.length() == 0,
             "generic variadic constructor zero suffix");
      assert(forwarded.first == 2 && forwarded.rest == values,
             "generic variadic constructor prepacked forwarding");
    });

    test("variadic constructor prepacked forwarding", () {
      let values: int[] = [5, 6];
      let constructed = VariadicConstructor(4, ...values);
      assert(constructed.rest == values,
             "variadic constructor preserves prepacked array identity");
    });

    test("variadic value constructor and field initializer", () {
      let value = VariadicValueConstructor(7, 8, 9);
      let holder = VariadicConstructorHolder();
      assert(value.first == 7 && value.rest.length() == 2 &&
             value.rest[0] == 8 && value.rest[1] == 9,
             "variadic value constructor ordinary packing");
      assert(holder.value.first == 1 && holder.value.rest.length() == 2 &&
             holder.value.rest[0] == 2 && holder.value.rest[1] == 3,
             "variadic constructor field initializer");
    });

    test("variadic callable-form spec", () {
      let p: Printer = (args: string...) {
        // 简单使用
      };
      p("hello", "world");
      assert(true, "variadic callable-form spec");
    });

    test("prepacked variadic function forwarding", () {
      let words: string[] = ["a", "b", "c"];
      let result = forward_join_strings("-", ...words);
      assert(result == "a-b-c", "prepacked variadic function forwarding");
    });

    test("prepacked variadic empty array", () {
      let empty: int[] = [];
      assert(count_args(...empty) == 0, "prepacked variadic empty array");
    });

    test("prepacked variadic preserves array identity", () {
      let values: int[] = [1, 2, 3];
      assert(receives_same_array(values, ...values),
             "prepacked variadic preserves array identity");
    });

    test("prepacked variadic method forwarding", () {
      let values: int[] = [1, 2, 3, 4];
      let relay = VariadicRelay {};
      assert(relay.forward(...values) == 4,
             "prepacked variadic instance method forwarding");
      assert(VariadicRelay.forwardStatic(...values) == 4,
             "prepacked variadic static method forwarding");
    });

    test("prepacked generic variadic forwarding", () {
      let values: int[] = [1, 2, 3];
      let relay = VariadicRelay {};
      assert(generic_forward_args(...values) == 3,
             "prepacked generic function inference");
      assert(relay.genericForward<int>(...values) == 1,
             "prepacked generic instance method forwarding");
      assert(VariadicRelay.genericForwardStatic<int>(...values) == 1,
             "prepacked generic static method forwarding");
    });

    test("prepacked callable-form spec forwarding", () {
      let counter: VariadicCounter = (args: int...) {
        return args.length();
      };
      let values: int[] = [4, 5];
      assert(counter(...values) == 2,
             "prepacked callable-form spec forwarding");
    });

    test("prepacked cross-package variadic forwarding", () {
      let values: int[] = [6, 7, 8];
      assert(lib_count_args(...values) == 3,
             "prepacked cross-package variadic forwarding");
    });

    test("prepacked expression evaluates once", () {
      prepacked_eval_count = 0;
      assert(count_args(...make_prepacked_args()) == 2,
             "prepacked expression result");
      assert(prepacked_eval_count == 1,
             "prepacked expression evaluates once");
    });

    test("prepacked variadic constructor expression evaluates once", () {
      prepacked_eval_count = 0;
      let constructed = VariadicConstructor(1, ...make_prepacked_args());
      assert(constructed.rest.length() == 2,
             "prepacked variadic constructor expression result");
      assert(prepacked_eval_count == 1,
             "prepacked variadic constructor expression evaluates once");
    });
  });
}
