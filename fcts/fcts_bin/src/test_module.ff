module fcts_bin;

import std.io;
import std.test;
import fcts_lib.helper;
import fcts_lib.test;

/** 模块与导入测试 */
open func test_module() {
  describe("module", () {
    test("cross-package function call", () {
      let result = lib_helper();
      assert(result == 42, "cross-package function call");
    });

    test("cross-package type usage", () {
      let user = LibUser("cross-pkg", 30);
      assert(user.name == "cross-pkg" && user.age == 30, "cross-package type usage");
    });

    test("cross-package method call", () {
      let user = LibUser("cross-pkg", 30);
      assert(user.greet() == "Hello, cross-pkg", "cross-package method call");
    });

    test("cross-package spec satisfaction", () {
      let user = LibUser("cross-pkg", 30);
      let named: LibNamed = user;
      assert(named.display() == "cross-pkg", "cross-package spec satisfaction");
    });

    test("cross-package enum", () {
      let color = LibColor.Green;
      assert((int)color == 1, "cross-package enum");
    });

    test("cross-package generic type", () {
      let box = LibBox<int> { value: 123 };
      assert(true, "cross-package generic type");
      let sbox = LibBox<string> { value: "pkg" };
      assert(true, "cross-package generic type (string)");
    });

    test("cross-package open generic constraint forwarding", () {
      assert(generic_constraint_forwarding_cross_package(), "cross-package open generic constraint forwarding");
    });
  });
}
