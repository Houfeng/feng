module fcts_bin;

import std.io;
import fcts_lib.helper;

// 基本 type 定义
type Point {
  var x: int;
  var y: int;
}

// 带构造函数的 type
type Person {
  let name: string;
  var age: int;

  func Person(name: string, age: int) {
    self.name = name;
    self.age = age;
  }

  func info(): string {
    return self.name;
  }
}

// 带静态成员的 type
type Counter {
  open static var count: int = 0;

  open static func create(value: int): Counter {
    Counter.count += 1;
    return Counter { value: value };
  }

  open static func get_count(): int {
    return Counter.count;
  }

  var value: int;

  func get_value(): int {
    return self.value;
  }
}

// 带终结器的 type
type Resource {
  var id: int;

  func Resource(id: int) {
    self.id = id;
  }

  func ~Resource() {
    // 终结器在释放前自动调用
  }
}

/** type 类型定义测试 */
open func test_type() {
  println("--- test_type ---");

  // 基本 type + 对象字面量
  let p = Point { x: 10, y: 20 };
  assert(p.x == 10 && p.y == 20, "basic type with object literal");

  // var 成员修改
  p.x = 30;
  assert(p.x == 30, "var member mutation");

  // 构造函数
  let person = Person("Alice", 25);
  assert(person.name == "Alice" && person.age == 25, "constructor");

  // 成员方法
  assert(person.info() == "Alice", "member method");

  // 对象字面量覆盖构造函数
  let person2 = Person("Bob", 30) { age: 31 };
  assert(person2.name == "Bob" && person2.age == 31, "object literal override after constructor");

  // 引用语义
  let a = Point { x: 1, y: 2 };
  let b = a;
  b.x = 99;
  assert(a.x == 99, "reference semantics");

  // 默认零值
  let empty_point: Point;
  assert(empty_point.x == 0 && empty_point.y == 0, "default zero value for type");

  // Type() 构造
  let p2 = Point();
  assert(p2.x == 0 && p2.y == 0, "Type() construction");

  // Type {} 简写
  let p3 = Point {};
  assert(p3.x == 0 && p3.y == 0, "Type {} shorthand");

  // 静态成员
  Counter.count = 0;
  let c1 = Counter.create(10);
  let c2 = Counter.create(20);
  assert(Counter.get_count() == 2, "static member and method");
  assert(c1.get_value() == 10 && c2.get_value() == 20, "static factory creates instances");

  // 终结器 (确保不会 crash)
  let r = Resource(1);
  assert(r.id == 1, "type with destructor");

  // == / != 引用比较
  let pa = Point { x: 1, y: 2 };
  let pb = Point { x: 1, y: 2 };
  let pc = pa;
  assert(pa != pb, "object == compares reference identity (different)");
  assert(pa == pc, "object == compares reference identity (same)");
}
