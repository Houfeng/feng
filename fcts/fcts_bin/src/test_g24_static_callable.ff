module fcts_bin;

import std.test;
import fcts_lib.test.forward_callable;

/** Keep the argument generic while observing which callable is selected. */
spec G24StaticReader<T>(value: T): i32;
/** First target for immutable and mutable bindings. */
func g24_static_first<T>(value: T): i32 { return 31; }
/** A different result detects late loading of a reassigned callable field. */
func g24_static_second<T>(value: T): i32 { return 47; }
/** Static state is independently initialized for each closed owner. */
type G24StaticCalls<T> {
    open static let first: G24StaticReader<T> = g24_static_first<T>;
    open static var current: G24StaticReader<T> = g24_static_first<T>;
    open static let fallback: G24StaticReader<T>;
}
/** Value owners use aggregate metadata, with the same field call protocol. */
@value type G24StaticValueCalls<T> {
    open static let first: G24StaticReader<T> = g24_static_first<T>;
    open static var current: G24StaticReader<T> = g24_static_first<T>;
}
/** A non-generic owner is an independent control for the same value-call route. */
type G24StaticPlainCalls {
    open static let first: G24StaticReader<i32> = g24_static_first<i32>;
}
/** Reassign during argument evaluation after the old callee has been selected. */
func g24_replace_static_callee(): i32 {
    G24StaticCalls<i32>.current = g24_static_second<i32>;
    return 1;
}
/** Exercise a static callable field through an open generic shared body. */
func g24_shared_static_call<T>(value: T): i32 {
    return G24StaticCalls<T>.first(value) + G24StaticValueCalls<T>.first(value);
}
/** Imported static generic fields preserve each complete spec argument's subject. */
func g24_imported_static_call<T: G24ForwardBoth>(value: T): i32 {
    return G24ForwardOwner<T>.shared_reader(value);
}

/** Static callable bindings retain ordinary call evaluation and initialization rules. */
func test_g24_static_callable() {
    describe("G24 static callable field calls", () {
        test("reference and value owners support direct and shared calls", () {
            assert(G24StaticCalls<string>.first("a") == 31, "reference owner");
            assert(G24StaticValueCalls<string>.first("b") == 31, "value owner");
            assert(G24StaticPlainCalls.first(1) == 31, "non-generic control");
            assert(g24_shared_static_call<string>("c") == 62, "open shared body");
        });
        test("mutable callees are selected before argument side effects", () {
            G24StaticCalls<i32>.current = g24_static_first<i32>;
            assert(G24StaticCalls<i32>.current(g24_replace_static_callee()) == 31, "old callee for current call");
            assert(G24StaticCalls<i32>.current(1) == 47, "new callee for next call");
            assert(G24StaticCalls<string>.current("independent") == 31, "closed owner state is separate");
            G24StaticValueCalls<i32>.current = g24_static_second<i32>;
            assert(G24StaticValueCalls<i32>.current(1) == 47, "mutable aggregate-owner field");
        });
        test("uninitialized static callables use the closed default", () {
            assert(G24StaticCalls<string>.fallback("ignored") == 0, "closed scalar result");
            assert(G24StaticCalls<i32>.fallback(1) == 0, "separate closed argument type");
        });
        test("imported shared static fields keep complete spec subjects", () {
            let reference: G24ForwardBoth = G24ForwardReference { marker: 79 };
            let value: G24ForwardBoth = G24ForwardValue { marker: 83, text: "payload" };
            assert(g24_imported_static_call<G24ForwardBoth>(reference) == 79, "reference-backed spec");
            assert(g24_imported_static_call<G24ForwardBoth>(value) == 83, "value-backed spec");
        });
    });
}
