module fcts_bin;

import std;
import std.io;
import std.test;

// 基本 tuple type
type TPoint(int, int);

// 三元素 tuple
type TTriple(int, string, bool);

// Unit type
type TUnit();

// Tuple 满足 spec
spec TSummable {
  func tsum(): int;
}

fit TPoint: TSummable {
  func tsum(): int {
    return self.item1 + self.item2;
  }
}

// 接受 spec 参数
func consume_tsummable(value: TSummable): int {
  return value.tsum();
}

// tuple fit self regression tests (§9.8)
spec TCopyable {
  func tcopy(): TFitTuple;
  func tget_sum(): int;
  func tget_sum_lambda(): int;
  func tlet_self(): TFitTuple;
}

// callable spec for lambda self capture test
spec TIntProducer(): int;

type TFitTuple(int, int);

fit TFitTuple: TCopyable {
  func tcopy(): TFitTuple {
    return self;
  }

  func tget_sum(): int {
    return self.item1 + self.item2;
  }

  // lambda 捕获 self（§9.15 tuple self 指针化回归）
  func tget_sum_lambda(): int {
    let fn: TIntProducer = () -> self.item1 + self.item2;
    return fn();
  }

  // let y = self 逃逸（§9.15 tuple self 指针化回归）
  func tlet_self(): TFitTuple {
    let y = self;
    return y;
  }
}

func consume_tcopyable(value: TCopyable): TFitTuple {
  return value.tcopy();
}

// 返回 unit
func make_tunit(): TUnit {
  return ();
}

// --- 泛型 tuple 类型 ---

// 泛型 tuple：两元素
type GTPair<A, B>(A, B);

// 泛型 tuple：三元素
type GTTriple<A, B, C>(A, B, C);

// 泛型 tuple 含 managed 字段（aggregate 实例路径）
type GTNamed<T>(string, T);

// 返回泛型 tuple 的泛型函数
func gtmake_pair<T>(first: T, second: int): GTPair<T, int> {
  return (first, second);
}

// 接受泛型 tuple 参数的泛型函数
func gtsum_pair(p: GTPair<int, int>): int {
  return p.item1 + p.item2;
}

// 泛型 triple 函数
func gtmake_triple<A, B, C>(a: A, b: B, c: C): GTTriple<A, B, C> {
  return (a, b, c);
}

/** Tuple 类型测试 */
open func test_tuple() {
  describe("tuple", () {
    test("unit type creation and destructuring", () {
      let unit: TUnit = ();
      let () = unit;
      let () = ();
      assert(true, "unit type creation and destructuring");
    });

    test("unit returned from function", () {
      let u2 = make_tunit();
      let () = u2;
      assert(true, "unit returned from function");
    });

    test("tuple literal and .itemN access", () {
      let point: TPoint = (5, 6);
      assert(point.item1 == 5 && point.item2 == 6, "tuple literal and .itemN access");
    });

    test("tuple method via fit", () {
      let point: TPoint = (5, 6);
      assert(point.tsum() == 11, "tuple method via fit");
    });

    test("tuple assigned to spec", () {
      let point: TPoint = (5, 6);
      let s: TSummable = point;
      assert(s.tsum() == 11, "tuple assigned to spec");
      assert(consume_tsummable(point) == 11, "tuple passed as spec argument");
    });

    test("var tuple reassignment", () {
      var mpoint: TPoint = (1, 2);
      mpoint = (3, 4);
      assert(mpoint.item1 == 3 && mpoint.item2 == 4, "var tuple reassignment");
    });

    test("tuple destructuring with skip", () {
      let (x, , z) = (7, 8, 9);
      assert(x == 7 && z == 9, "tuple destructuring with skip");
    });

    test("triple tuple", () {
      let triple: TTriple = (42, "hello", true);
      assert(triple.item1 == 42, "triple tuple item1");
      assert(triple.item2 == "hello", "triple tuple item2");
      assert(triple.item3, "triple tuple item3");
    });

    // --- Tuple fit self regression tests (§9.8) ---

    test("tuple fit method self access regression", () {
      let t: TFitTuple = (3, 7);
      assert(t.tget_sum() == 10, "tuple fit method reads self fields correctly");
    });

    test("tuple fit method self return regression", () {
      let t: TFitTuple = (5, 8);
      let copy = t.tcopy();
      assert(copy.item1 == 5 && copy.item2 == 8, "tuple fit return self produces correct value");
    });

    test("tuple fit method self return via spec regression", () {
      let t: TFitTuple = (2, 9);
      let copy = consume_tcopyable(t);
      assert(copy.item1 == 2 && copy.item2 == 9, "tuple fit via spec return self produces correct value");
    });

    test("tuple fit method assigned to spec regression", () {
      let t: TFitTuple = (4, 6);
      let s: TCopyable = t;
      assert(s.tget_sum() == 10, "tuple assigned to spec, fit method works");
      let copy = s.tcopy();
      assert(copy.item1 == 4 && copy.item2 == 6, "tuple spec variable fit return self works");
    });

    // --- Tuple self 指针化回归测试 (§9.15) ---

    test("tuple fit self lambda capture", () {
      let t: TFitTuple = (3, 7);
      assert(t.tget_sum_lambda() == 10, "tuple fit lambda capture self reads fields correctly");
    });

    test("tuple fit self lambda capture via spec", () {
      let t: TFitTuple = (5, 8);
      let s: TCopyable = t;
      assert(s.tget_sum_lambda() == 13, "tuple fit lambda capture self via spec");
    });

    test("tuple fit self let binding escape", () {
      let t: TFitTuple = (2, 9);
      let copy = t.tlet_self();
      assert(copy.item1 == 2 && copy.item2 == 9, "tuple fit let y = self produces independent copy");
    });

    test("tuple fit self let binding via spec", () {
      let t: TFitTuple = (6, 3);
      let s: TCopyable = t;
      let copy = s.tlet_self();
      assert(copy.item1 == 6 && copy.item2 == 3, "tuple fit let y = self via spec");
    });

    // --- 泛型 tuple 测试 ---

    test("generic tuple construction and field access (trivial)", () {
      let p: GTPair<int, int> = (1, 2);
      assert(p.item1 == 1 && p.item2 == 2, "generic tuple trivial field access");
    });

    test("generic tuple construction and field access (mixed)", () {
      let p: GTPair<int, string> = (42, "hello");
      assert(p.item1 == 42 && p.item2 == "hello", "generic tuple mixed field access");
    });

    test("generic triple tuple", () {
      let t: GTTriple<int, string, bool> = (10, "world", true);
      assert(t.item1 == 10, "generic triple item1");
      assert(t.item2 == "world", "generic triple item2");
      assert(t.item3, "generic triple item3");
    });

    test("generic tuple value semantics", () {
      let p1: GTPair<int, int> = (5, 10);
      var p2: GTPair<int, int> = p1;
      p2 = (99, 20);
      assert(p1.item1 == 5 && p1.item2 == 10, "original unchanged after value copy");
      assert(p2.item1 == 99 && p2.item2 == 20, "copy has new value");
    });

    test("generic tuple as function return", () {
      let p = gtmake_pair<string>("test", 7);
      assert(p.item1 == "test" && p.item2 == 7, "generic tuple returned from generic function");
    });

    test("generic tuple as function parameter", () {
      let p: GTPair<int, int> = (15, 25);
      assert(gtsum_pair(p) == 40, "generic tuple passed as function parameter");
    });

    test("generic tuple with managed field (aggregate instance)", () {
      let n: GTNamed<int> = ("label", 42);
      assert(n.item1 == "label", "generic tuple managed field item1");
      assert(n.item2 == 42, "generic tuple generic field item2");
    });

    test("generic tuple with managed field value semantics", () {
      let n1: GTNamed<int> = ("original", 1);
      var n2: GTNamed<int> = n1;
      n2 = ("modified", 99);
      assert(n1.item1 == "original" && n1.item2 == 1, "original string unchanged after aggregate value copy");
      assert(n2.item1 == "modified" && n2.item2 == 99, "aggregate copy has new values");
    });

    test("generic triple returned from generic function", () {
      let t = gtmake_triple<int, string, bool>(1, "a", false);
      assert(t.item1 == 1 && t.item2 == "a" && !t.item3, "generic triple from generic function");
    });

    test("std.Tuple<T1, T2> construction and access", () {
      let t: Tuple<int, string> = (10, "hello");
      assert(t.item1 == 10 && t.item2 == "hello", "std.Tuple<T1,T2> field access");
    });

    test("std.Tuple<T1, T2> value semantics", () {
      let t1: Tuple<int, string> = (1, "a");
      var t2: Tuple<int, string> = t1;
      t2 = (99, "b");
      assert(t1.item1 == 1 && t1.item2 == "a", "std.Tuple original unchanged after value copy");
      assert(t2.item1 == 99 && t2.item2 == "b", "std.Tuple copy has new values");
    });

    test("std.Tuple<T1, T2, T3> construction and access", () {
      let t: Tuple<int, string, bool> = (42, "world", true);
      assert(t.item1 == 42, "std.Tuple<T1,T2,T3> item1");
      assert(t.item2 == "world", "std.Tuple<T1,T2,T3> item2");
      assert(t.item3, "std.Tuple<T1,T2,T3> item3");
    });
  });
}
