module fcts_bin;

import std.io;
import std.test;
import std.text;
import std.collections;

/** 字符串测试 */
open func test_string() {
  describe("string", () {
    test("string literal", () {
      let s = "Hello, World!";
      assert(s == "Hello, World!", "string literal");
    });

    test("string escape sequences", () {
      let escaped = "line1\nline2";
      assert(escaped.length() > (i64)10, "string escape \\n");

      let tab = "a\tb";
      assert(tab.length() == (i64)3, "string escape \\t");

      let quote = "say: \"hi\"";
      assert(quote.length() == (i64)9, "string escape \\\"");

      let backslash = "path\\file";
      assert(backslash.length() == (i64)9, "string escape \\\\");
    });

    test("string concatenation", () {
      let full = "Hello" + ", " + "World";
      assert(full == "Hello, World", "string concatenation");
    });

    test("string value equality", () {
      let a = "test";
      let b = "te" + "st";
      assert(a == b, "string value equality");
    });

    test("string != comparison", () {
      assert("abc" != "def", "string != comparison");
    });

    test("empty string", () {
      let empty = "";
      assert(empty == "" && empty.length() == (i64)0, "empty string");
    });

    test("string length()", () {
      let msg = "Hello";
      assert(msg.length() == (i64)5, "string length()");
    });

    test("string UTF-8 length (Chinese chars)", () {
      let chinese = "你好";
      assert(chinese.length() == (i64)6, "string UTF-8 length (Chinese chars)");
    });

    test("string default zero value", () {
      let default_s: string;
      assert(default_s == "", "string default zero value");
    });

    test("string format with placeholder", () {
      let formatted = string.format("Hello, {0}!", "World");
      assert(formatted == "Hello, World!", "string format with placeholder");
    });

    test("string format multiple placeholders", () {
      let multi = string.format("{0} + {1} = {2}", "1", "2", "3");
      assert(multi == "1 + 2 = 3", "string format multiple placeholders");
    });
  });
}
