module fcts_bin;

import std;
import std.test;
import fcts_lib.test;

/**
 * 跨包回归测试：推断泛型字段导出一致性。
 *
 * fcts_lib.test.InferredGenericFields 与 InferredGenericFieldsGeneric<T>
 * 在源码中用 `let x = List<byte>()` / `let x = List<T>()` 形式声明字段，
 * 类型由构造调用推断而非显式标注。历史上此类字段在 .ft 导出时丢失
 * 类型实参，导致跨包消费者报 CE0032: codegen: unknown type 'List'。
 *
 * 本用例跨包引用这两个类型，验证：
 *  - 字段类型在跨包消费时正确解析为泛型实例；
 *  - seal / open 可见性修饰符不影响类型解析；
 *  - 具化泛型（List<byte>）与开放泛型（List<T>，调用点具化）均工作正常。
 */

/** 工厂函数：返回具化实例，供 run_case 形态测试使用。 */
func make_inferred_generic_holder(): InferredGenericFieldsGeneric<i32> {
  return InferredGenericFieldsGeneric<i32>();
}

open func test_inferred_generic_field() {
  describe("inferred generic field (cross-package)", () {

    test("sealed concrete generic field (List<byte>)", () {
      let obj = InferredGenericFields();
      // seal 字段跨包不可直接访问，通过公开方法间接验证底层 List 可用
      obj.appendSealed((byte)65);
      obj.appendSealed((byte)66);
      assert(obj.sealedSize() == 2, "sealed concrete field usable");
      assert(obj.sealedAt(0) == (byte)65, "sealed concrete field value[0]");
      assert(obj.sealedAt(1) == (byte)66, "sealed concrete field value[1]");
    });

    test("open concrete generic field (List<byte>)", () {
      let obj = InferredGenericFields();
      // open 字段跨包可直接访问
      obj.openConcrete.add((byte)97);
      obj.openConcrete.add((byte)98);
      obj.openConcrete.add((byte)99);
      assert(obj.openConcrete.size() == 3, "open concrete field usable");
      let entries = obj.openConcrete.entries();
      assert(entries[0] == (byte)97, "open concrete field value[0]");
      assert(entries[2] == (byte)99, "open concrete field value[2]");
    });

    test("sealed open generic field (List<T> instantiated as List<byte>)", () {
      // 泛型类型内部 seal 推断字段（List<T>()）的方法调用：
      // 通过公开访问器间接调用 List<T>.add/get，验证 reified type dep
      // 已正确收集、字段类型解析为泛型实例而非 VOID。
      let obj = InferredGenericFieldsGeneric<byte>();
      obj.appendSealed((byte)0x41);
      obj.appendSealed((byte)0x42);
      assert(obj.sealedSize() == 2, "sealed open generic field usable");
      assert(obj.sealedAt(0) == (byte)0x41, "sealed open generic field value[0]");
      assert(obj.sealedAt(1) == (byte)0x42, "sealed open generic field value[1]");
    });

    test("sealed open generic field with int instantiation", () {
      // 同一泛型类型用不同类型参数具化，验证 seal 字段方法调用
      // 在不同具化上下文都工作。
      let obj = InferredGenericFieldsGeneric<int>();
      obj.appendSealed(100);
      obj.appendSealed(200);
      obj.appendSealed(300);
      assert(obj.sealedSize() == 3, "sealed open generic field int usable");
      assert(obj.sealedAt(0) == 100, "sealed open generic field int value[0]");
      assert(obj.sealedAt(2) == 300, "sealed open generic field int value[2]");
    });

    test("open open generic field (List<T> instantiated as List<int>)", () {
      let obj = InferredGenericFieldsGeneric<int>();
      obj.openOpen.add(10);
      obj.openOpen.add(20);
      obj.openOpen.add(30);
      assert(obj.openOpen.size() == 3, "open open generic field usable");
      let entries = obj.openOpen.entries();
      assert(entries[0] == 10, "open open generic field value[0]");
      assert(entries[2] == 30, "open open generic field value[2]");
    });

    test("open generic field with different instantiation (List<i64>)", () {
      let obj = InferredGenericFieldsGeneric<i64>();
      obj.openOpen.add((i64)1000);
      obj.openOpen.add((i64)2000);
      assert(obj.openOpen.size() == 2, "open generic field i64 usable");
      let entries = obj.openOpen.entries();
      assert(entries[0] == (i64)1000, "open generic field i64 value[0]");
      assert(entries[1] == (i64)2000, "open generic field i64 value[1]");
    });

    test("factory function returning concrete instance with seal field method calls", () {
      // 工厂函数返回具化实例，调用方通过 seal 访问器操作推断泛型字段。
      // 覆盖跨包具化调用点 + 方法调用链路（run_case 形态）。
      let obj = make_inferred_generic_holder();
      obj.appendSealed(11);
      obj.appendSealed(22);
      assert(obj.sealedSize() == 2, "factory seal field size");
      assert(obj.sealedAt(0) == 11, "factory seal field value[0]");
      assert(obj.sealedAt(1) == 22, "factory seal field value[1]");
      obj.openOpen.add(33);
      assert(obj.openOpen.size() == 1, "factory open field size");
      assert(obj.openOpen.entries()[0] == 33, "factory open field value[0]");
    });

    test("same-module concrete generic instance with inferred generic field", () {
      // 本包定义泛型类型 + 推断泛型字段 + 具化调用点 + 方法调用。
      // 覆盖单文件（本包）场景：字段初始化器 Inner<T>() 在具化实例
      // Holder<i32>() 的构造调用 codegen 中需代入 T→i32。
      let h = LocalHolder<i32>();
      h.push(42);
      assert(h.pop() == 42, "local holder push/pop");
      h.push(99);
      assert(h.pop() == 99, "local holder push/pop 2nd");
    });

    test("generic owner resolves every inferred field fact category", () {
      let holder = LocalInferredFactHolder<i32>();
      assert(holder.integerValue() == 1, "builtin integer field initializer");
      assert(holder.booleanValue(), "builtin boolean field initializer");
      assert(holder.textValue() == "ready", "builtin string field initializer");
      assert(holder.stateValue() == LocalInferredState.Pending,
             "enum declaration field initializer");
      assert(holder.payloadMarker() == 7,
             "object declaration field initializer");
      assert(holder.genericValue() == 0,
             "generic type-ref field default value");
      assert(holder.explicitStateValue() == LocalInferredState.Ready,
             "explicit field type control");

      holder.update(9, false, "changed", LocalInferredState.Ready);
      holder.setGenericValue(42);
      assert(holder.integerValue() == 9, "inferred integer field assignment");
      assert(!holder.booleanValue(), "inferred boolean field assignment");
      assert(holder.textValue() == "changed", "inferred string field assignment");
      assert(holder.stateValue() == LocalInferredState.Ready,
             "inferred enum field assignment");
      assert(holder.genericValue() == 42,
             "inferred generic type-ref field assignment");
    });
  });
}

/** 推导为 DECL 的枚举类型。 */
enum LocalInferredState {
  Pending = 0,
  Ready = 1
}

/** 推导为 DECL 的非泛型对象类型。 */
type LocalInferredPayload {
  seal var marker: int = 7;

  func markerValue(): int {
    return self.marker;
  }
}

/** 推导为 TYPE_REF 的泛型对象类型。 */
type LocalInferredGenericPayload<T> {
  seal var value: T;

  func setValue(value: T) {
    self.value = value;
  }

  func getValue(): T {
    return self.value;
  }
}

/** 覆盖开放泛型 owner 中全部字段类型事实类别。 */
type LocalInferredFactHolder<T> {
  seal var integer = 1;
  seal var boolean = true;
  seal var text = "ready";
  seal var state = LocalInferredState.Pending;
  seal var payload = LocalInferredPayload();
  seal var genericPayload = LocalInferredGenericPayload<T>();
  seal var explicitState: LocalInferredState = LocalInferredState.Ready;

  func integerValue(): int {
    return self.integer;
  }

  func booleanValue(): bool {
    return self.boolean;
  }

  func textValue(): string {
    return self.text;
  }

  func stateValue(): LocalInferredState {
    return self.state;
  }

  func payloadMarker(): int {
    return self.payload.markerValue();
  }

  func genericValue(): T {
    return self.genericPayload.getValue();
  }

  func explicitStateValue(): LocalInferredState {
    return self.explicitState;
  }

  func update(integer: int,
              boolean: bool,
              text: string,
              state: LocalInferredState) {
    self.integer = integer;
    self.boolean = boolean;
    self.text = text;
    self.state = state;
  }

  func setGenericValue(value: T) {
    self.genericPayload.setValue(value);
  }
}

/** 本包定义的泛型类型，含推断泛型字段，用于验证单文件场景。 */
type LocalInner<T> {
  var value: T;

  func LocalInner() {}

  func set_value(next: T) {
    self.value = next;
  }

  func get_value(): T {
    return self.value;
  }
}

/** 持有 LocalInner<T> 推断字段的泛型容器。 */
type LocalHolder<T> {
  seal let items = LocalInner<T>();

  func LocalHolder() {}

  func push(item: T) {
    self.items.set_value(item);
  }

  func pop(): T {
    return self.items.get_value();
  }
}
