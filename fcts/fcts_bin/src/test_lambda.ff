module fcts_bin;

import std.io;
import std.test;

// 可调用形状
spec IntMapper(x: i32): i32;
spec IntProducer(): i32;
spec Action(): void;

// 兼容 callable spec (用于强转测试)
spec IntMapper2(x: i32): i32;

// lambda 捕获 self 的 type
type SelfCapBox {
  var n: i32;

  func make_reader(): IntProducer {
    return () -> self.n;
  }
}

// type 字段 callable lambda 默认值
type FieldLambdaBox {
  var n: i32;
  let read: IntProducer = () -> self.n;
}

/** Lambda 与闭包测试 */
open func test_lambda() {
  describe("lambda", () {
    test("single-expression lambda", () {
      let double: IntMapper = (x: i32) -> x * 2;
      assert(double(5) == 10, "single-expression lambda");
    });

    test("multi-line lambda", () {
      let compute: IntMapper = (x: i32) {
        let temp = x + 10;
        return temp * 2;
      };
      assert(compute(5) == 30, "multi-line lambda");
    });

    test("closure captures let binding", () {
      let base = 100;
      let add_base: IntMapper = (x: i32) -> x + base;
      assert(add_base(5) == 105, "closure captures let binding");
    });

    test("closure captures var binding (reference)", () {
      var counter = 0;
      let inc: Action = () {
        counter += 1;
      };
      inc();
      inc();
      inc();
      assert(counter == 3, "closure captures var binding (reference)");
    });

    test("lambda as argument", () {
      let result = apply_mapper(10, (x: i32) -> x * 3);
      assert(result == 30, "lambda as argument");
    });

    test("lambda as return value (closure)", () {
      let adder = make_adder(100);
      assert(adder(5) == 105, "lambda as return value (closure)");
    });

    test("method value", () {
      let obj = LambdaTestObj { value: 42 };
      let getter: IntProducer = obj.get_value;
      assert(getter() == 42, "method value");
    });

    test("callable spec cast", () {
      let mapper_a: IntMapper = (x: i32) -> x + 1;
      let mapper_b: IntMapper2 = (IntMapper2)mapper_a;
      assert(mapper_b(41) == 42, "callable spec cast");
    });

    test("lambda captures self in method (reference)", () {
      let scbox = SelfCapBox { n: 7 };
      let screader: IntProducer = scbox.make_reader();
      scbox.n = 8;
      assert(screader() == 8, "lambda captures self in method (reference)");
    });

    test("type field callable lambda default", () {
      let flbox = FieldLambdaBox { n: 7 };
      assert(flbox.read() == 7, "type field callable lambda default");
    });
  });
}

func apply_mapper(x: i32, f: IntMapper): i32 {
  return f(x);
}

func make_adder(base: i32): IntMapper {
  return (x: i32) -> x + base;
}

type LambdaTestObj {
  let value: i32;

  func get_value(): i32 {
    return self.value;
  }
}
