module fcts_bin;

import std.io;
import std.test;
import fcts_lib.test;

// 可调用形状
spec IntMapper(x: int): int;
spec IntProducer(): int;
spec Action(): void;

// 兼容 callable spec (用于强转测试)
spec IntMapper2(x: int): int;

// lambda 捕获 self 的 type
type SelfCapBox {
  var n: int;

  func make_reader(): IntProducer {
    return () -> self.n;
  }
}

// type 字段 callable lambda 默认值
type FieldLambdaBox {
  var n: int;
  let read: IntProducer = () -> self.n;
}

/** Two independently owned closures over one local binding. */
type SnapshotReaders {
  var advance: IntProducer;
  var read: IntProducer;
}

/** Value receiver whose captured copy contains a managed reference. */
@value
type SnapshotCounter {
  var n: int;
  var leaf: LibAdvancedLifetimeLeaf;

  /** Capture the copy and then update the caller's receiver. */
  func readers(): SnapshotReaders {
    let it = self;
    let advance: IntProducer = () { it.n += 1; return it.n; };
    let read: IntProducer = () -> it.n;
    self.n += 10;
    return SnapshotReaders { advance: advance, read: read };
  }
}

/** Lambda 与闭包测试 */
open func test_lambda() {
  describe("lambda", () {
    test("single-expression lambda", () {
      let double: IntMapper = (x: int) -> x * 2;
      assert(double(5) == 10, "single-expression lambda");
    });

    test("multi-line lambda", () {
      let compute: IntMapper = (x: int) {
        let temp = x + 10;
        return temp * 2;
      };
      assert(compute(5) == 30, "multi-line lambda");
    });

    test("closure captures let binding", () {
      let base = 100;
      let add_base: IntMapper = (x: int) -> x + base;
      assert(add_base(5) == 105, "closure captures let binding");
    });

    test("closure captures var binding (reference)", () {
      var counter = 0;
      let inc: Action = () {
        counter += 1;
      };
      inc();
      inc();
      inc();
      assert(counter == 3, "closure captures var binding (reference)");
    });

    test("lambda as argument", () {
      let result = apply_mapper(10, (x: int) -> x * 3);
      assert(result == 30, "lambda as argument");
    });

    test("lambda as return value (closure)", () {
      let adder = make_adder(100);
      assert(adder(5) == 105, "lambda as return value (closure)");
    });

    test("method value", () {
      let obj = LambdaTestObj { value: 42 };
      let getter: IntProducer = obj.get_value;
      assert(getter() == 42, "method value");
    });

    test("callable spec cast", () {
      let mapper_a: IntMapper = (x: int) -> x + 1;
      let mapper_b: IntMapper2 = (IntMapper2)mapper_a;
      assert(mapper_b(41) == 42, "callable spec cast");
    });

    test("lambda captures self in method (reference)", () {
      let scbox = SelfCapBox { n: 7 };
      let screader: IntProducer = scbox.make_reader();
      scbox.n = 8;
      assert(screader() == 8, "lambda captures self in method (reference)");
    });

    test("closures share an explicit value receiver snapshot", () {
      let before = LibAdvancedLifetimeLeaf.finalizedCount();
      var advance: IntProducer = () -> 0;
      var read: IntProducer = () -> 0;
      {
        let counter = SnapshotCounter { n: 1, leaf: LibAdvancedLifetimeLeaf("snapshot") };
        let readers = counter.readers();
        advance = readers.advance;
        read = readers.read;
        assert(counter.n == 11 && read() == 1, "method updates the original receiver");
        assert(advance() == 2 && read() == 2 && counter.n == 11, "both closures use the same copy");
      }
      advance = () -> 0;
      assert(read() == 2 && LibAdvancedLifetimeLeaf.finalizedCount() == before,
             "one closure keeps the snapshot alive");
      read = () -> 0;
      assert(LibAdvancedLifetimeLeaf.finalizedCount() == before + 1,
             "last closure releases the managed field once");
    });

    test("type field callable lambda default", () {
      let flbox = FieldLambdaBox { n: 7 };
      assert(flbox.read() == 7, "type field callable lambda default");
    });
  });
}

func apply_mapper(x: int, f: IntMapper): int {
  return f(x);
}

func make_adder(base: int): IntMapper {
  return (x: int) -> x + base;
}

type LambdaTestObj {
  let value: int;

  func get_value(): int {
    return self.value;
  }
}
