module fcts_bin;

import std.io;
import std.test;

/** let/var 绑定与作用域测试 */
open func test_binding() {
  describe("binding", () {
    test("let binding with type inference", () {
      let a = 10;
      assert(a == 10, "let binding with type inference");
    });

    test("var binding mutation", () {
      var b = 20;
      b = 30;
      assert(b == 30, "var binding mutation");
    });

    test("explicit type annotation", () {
      let c: i32 = 100;
      assert(c == 100, "explicit type annotation");
    });

    test("default zero value for int", () {
      let d: i32;
      assert(d == 0, "default zero value for int");
    });

    test("default zero value for string", () {
      let e: string;
      assert(e == "", "default zero value for string");
    });

    test("default zero value for bool", () {
      let f: bool;
      assert(f == false, "default zero value for bool");
    });

    test("block scope shadowing", () {
      let label = "outer";
      if true {
        let label = "inner";
        assert(label == "inner", "block scope shadowing (inner)");
      }
      assert(label == "outer", "block scope shadowing (outer restored)");
    });

    test("var mutation in loop", () {
      var counter = 0;
      for var i = 0; i < 5; i += 1 {
        counter += 1;
      }
      assert(counter == 5, "var mutation in loop");
    });
  });
}
