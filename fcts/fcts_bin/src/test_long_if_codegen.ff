module fcts_bin;
import std.test;

/** Observe evaluation and destruction without counting synthesized defaults. */
type VCGBranchProbe {
    open let number:i32;
    open static var calls:i32;
    open static var destroyed:i32;
    open static var expectedRelease:i32;
    open static var ordered:bool;
    /** Nested condition temporaries must unwind in reverse creation order. */
    func ~VCGBranchProbe() {
        if self.number != 0 {
            if self.number != VCGBranchProbe.expectedRelease { VCGBranchProbe.ordered=false; }
            VCGBranchProbe.expectedRelease-=1;
            VCGBranchProbe.destroyed+=1;
        }
    }
}
/** The array literal argument forces a condition preamble and owns its probe. */
func vcgBranchCondition(values:VCGBranchProbe[], target:i32, throwAt:i32):bool {
    VCGBranchProbe.calls+=1;
    let number=values[0].number;
    if number != VCGBranchProbe.calls { VCGBranchProbe.ordered=false; }
    if number == throwAt { throw "long condition"; }
    return number == target;
}
/** Ninety-six else-if clauses exceed the old limit without changing semantics. */
func vcgLongBranch(target:i32, throwAt:i32):i32 {
    var result:i32=-1;
    if vcgBranchCondition([VCGBranchProbe{number:1}],target,throwAt) { result=1; }
    else if vcgBranchCondition([VCGBranchProbe{number:2}],target,throwAt) { result=2; }
    else if vcgBranchCondition([VCGBranchProbe{number:3}],target,throwAt) { result=3; }
    else if vcgBranchCondition([VCGBranchProbe{number:4}],target,throwAt) { result=4; }
