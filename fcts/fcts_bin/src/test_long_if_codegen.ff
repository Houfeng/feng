    else if vcgBranchCondition([VCGBranchProbe{number:9}],target,throwAt) { result=9; }
    else if vcgBranchCondition([VCGBranchProbe{number:10}],target,throwAt) { result=10; }
    else if vcgBranchCondition([VCGBranchProbe{number:11}],target,throwAt) { result=11; }
