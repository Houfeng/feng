    else if vcgBranchCondition([VCGBranchProbe{number:97}],target,throwAt) { result=97; }
    else { result=0; }
    return result;
}
/** Reset per-invocation observations before creating any condition temporary. */
func vcgResetBranches(count:i32) {
    VCGBranchProbe.calls=0;
    VCGBranchProbe.destroyed=0;
    VCGBranchProbe.expectedRelease=count;
    VCGBranchProbe.ordered=true;
}
/** Match before, at, and after the old wrapper limit, then reach the final else. */
func test_long_if_codegen() {
    describe("long if codegen", () {
        test("only conditions up to the selected clause run and release in reverse order", () {
            let targets:i32[]=[1,64,65,66,97];
            for let target in targets {
                vcgResetBranches(target);
                let result=vcgLongBranch(target,0);
                assert(result==target && VCGBranchProbe.calls==target, "ordered short circuit conditions");
                assert(VCGBranchProbe.destroyed==target && VCGBranchProbe.expectedRelease==0 &&
                       VCGBranchProbe.ordered, "reverse cleanup after selected branch");
            }
        });
        test("the final else runs after every condition is false", () {
            vcgResetBranches(97);
            assert(vcgLongBranch(0,0)==0 && VCGBranchProbe.calls==97, "complete false chain");
            assert(VCGBranchProbe.destroyed==97 && VCGBranchProbe.ordered, "complete reverse cleanup");
        });
        test("an exception beyond the old limit releases all evaluated temporaries", () {
            vcgResetBranches(70);
            var caught=false;
            try vcgLongBranch(0,70) catch message:string { caught=message=="long condition"; }
            assert(caught && VCGBranchProbe.calls==70, "exception stops later conditions");
            assert(VCGBranchProbe.destroyed==70 && VCGBranchProbe.expectedRelease==0 &&
                   VCGBranchProbe.ordered, "exception unwinds condition temporaries");
        });
    });
}
