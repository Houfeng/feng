module fcts_bin;

import std.io;
import std.test;

// union-form spec
spec IntOrString: int | string;

// 用于 union 的自定义 type
type UnionTag {
  let tag: string;
}

spec TagOrInt: UnionTag | int;

// union 含 spec 类型
spec UnionGreetable {
  func ugreet(): string;
}

type UnionUser: UnionGreetable {
  let name: string;

  func ugreet(): string {
    return self.name;
  }
}

spec DisplayUnion: UnionGreetable | string;

// 泛型 union
type UnionError {
  let code: int;
}

spec UnionResult<T>: UnionError | T;

// union 含 spec 辅助函数
func make_display_named(name: string): DisplayUnion {
  let named: UnionGreetable = UnionUser { name: name };
  return named;
}

func print_display_union(value: DisplayUnion): string {
  return match value {
    v: UnionGreetable { v.ugreet() }
    v: string { v }
    else { "else" }
  };
}

// 测试用例 1: 联合类型（无嵌套）作为泛型约束
spec SimpleUnion: int | string;

func identity_union<T: SimpleUnion>(value: T): T {
  return value;
}

// 测试用例 2: 联合类型（有嵌套），父级作为约束，调用点传入子类型
spec ChildUnion: int | bool;
spec ParentUnion: ChildUnion | string;

func identity_parent<T: ParentUnion>(value: T): T {
  return value;
}

// 测试用例 3: object-form spec，A 作为泛型约束，调用时使用 B
spec ObjectA {
  func get_value(): int;
}

type ObjectB: ObjectA {
  let value: int;

  func get_value(): int {
    return self.value;
  }
}

func use_object_a<T: ObjectA>(item: T): int {
  return item.get_value();
}

/** 联合类型测试 */
open func test_union() {
  describe("union", () {
    test("union entry with int", () {
      let v1: IntOrString = 42;
      match v1 {
        v: int {
          assert(v == 42, "union entry with int");
        }
        else {}
      }
    });

    test("union entry with string", () {
      let v2: IntOrString = "hello";
      match v2 {
        v: string {
          assert(v == "hello", "union entry with string");
        }
        else {}
      }
    });

    test("union match narrowing", () {
      let v3: IntOrString = 100;
      let result = match v3 {
        int { "is int" }
        string { "is string" }
        else { "else" }
      };
      assert(result == "is int", "union match narrowing");
    });

    test("union match string branch", () {
      let v4: IntOrString = "world";
      let result2 = match v4 {
        int { "int" }
        string { "string" }
        else { "else" }
      };
      assert(result2 == "string", "union match string branch");
    });

    test("union with custom type", () {
      let v5: TagOrInt = UnionTag { tag: "x" };
      let result3 = match v5 {
        UnionTag { "tag" }
        int { "int" }
        else { "else" }
      };
      assert(result3 == "tag", "union with custom type");
    });

    test("union with custom type (int branch)", () {
      let v6: TagOrInt = 99;
      let result4 = match v6 {
        UnionTag { "tag" }
        int { "int" }
        else { "else" }
      };
      assert(result4 == "int", "union with custom type (int branch)");
    });

    test("union default zero value", () {
      let default_choice: IntOrString;
      let default_result = match default_choice {
        int { "int" }
        string { "string" }
        else { "else" }
      };
      assert(default_result == "int", "union default zero value");
    });

    test("union with spec member (Named branch)", () {
      let du1 = make_display_named("spec-user");
      assert(print_display_union(du1) == "spec-user", "union with spec member (Named branch)");
    });

    test("union with spec member (string branch)", () {
      let du2: DisplayUnion = "text";
      assert(print_display_union(du2) == "text", "union with spec member (string branch)");
    });

    test("generic union (value branch)", () {
      let ok_val: UnionResult < int > = 42;
      let ok_result = match ok_val {
        int { "int-ok" }
        UnionError { "error" }
        else { "else" }
      };
      assert(ok_result == "int-ok", "generic union (value branch)");
    });

    test("generic union (error branch)", () {
      let err_val: UnionResult < int > = UnionError { code: 7 };
      let err_result = match err_val {
        int { "int" }
        UnionError { "error-ok" }
        else { "else" }
      };
      assert(err_result == "error-ok", "generic union (error branch)");
    });

    test("simple union as generic constraint (int)", () {
      let v: SimpleUnion = 42;
      let result: SimpleUnion = identity_union(v);
      match result {
        int {
          assert(true, "simple union as generic constraint (int)");
        }
        else {
          assert(false, "simple union as generic constraint (int) - expected int");
        }
      }
    });

    test("simple union as generic constraint (string)", () {
      let v: SimpleUnion = "hello";
      let result: SimpleUnion = identity_union(v);
      match result {
        string {
          assert(true, "simple union as generic constraint (string)");
        }
        else {
          assert(false, "simple union as generic constraint (string) - expected string");
        }
      }
    });

    test("nested union - parent constraint with child type, 1", () {
      let child: ChildUnion = 42;
      let parent: ParentUnion = child;
      let result: ParentUnion = identity_parent(parent);
      match result {
        ChildUnion {
          assert(true, "nested union - parent constraint with child type");
        }
        else {
          assert(false, "nested union - parent constraint with child type - expected ChildUnion");
        }
      }
    });

    test("nested union - parent constraint with child type, 2", () {
      let child: ChildUnion = 42;
      let result = identity_parent(child);
      match result {
        int {
          assert(true, "nested union - parent constraint with child type");
        }
        else {
          assert(false, "nested union - parent constraint with child type - expected ChildUnion");
        }
      }
    });

    // test("nested union - parent constraint with child type, 3", () {
    //   let child: int = 42;
    //   let result = identity_parent(child);
    //   match result {
    //     42 {
    //       assert(true, "nested union - parent constraint with child type");
    //     }
    //     else {
    //       assert(false, "nested union - parent constraint with child type - expected ChildUnion");
    //     }
    //   }
    // });

    test("nested union - parent constraint with string", () {
      let v: ParentUnion = "test";
      let result: ParentUnion = identity_parent(v);
      match result {
        string {
          assert(true, "nested union - parent constraint with string");
        }
        else {
          assert(false, "nested union - parent constraint with string - expected string");
        }
      }
    });

    test("object-form spec as generic constraint", () {
      let b: ObjectB = ObjectB { value: 123 };
      let result: int = use_object_a(b);
      assert(result == 123, "object-form spec as generic constraint");
    });
  });
}
