module fcts_bin;

import std.io;
import std.test;

// union-form spec
spec IntOrString: i32 | string;

// 用于 union 的自定义 type
type UnionTag {
  let tag: string;
}

spec TagOrInt: UnionTag | i32;

// union 含 spec 类型
spec UnionGreetable {
  func ugreet(): string;
}

type UnionUser: UnionGreetable {
  let name: string;

  func ugreet(): string {
    return self.name;
  }
}

spec DisplayUnion: UnionGreetable | string;

// 泛型 union
type UnionError {
  let code: i32;
}

spec UnionResult<T>: UnionError | T;

// union 含 spec 辅助函数
func make_display_named(name: string): DisplayUnion {
  let named: UnionGreetable = UnionUser { name: name };
  return named;
}

func print_display_union(value: DisplayUnion): string {
  return match value {
    v: UnionGreetable { v.ugreet() }
    v: string { v }
    else { "else" }
  };
}

/** 联合类型测试 */
open func test_union() {
  describe("union", () {
    test("union entry with int", () {
      let v1: IntOrString = 42;
      match v1 {
        v: i32 {
          assert(v == 42, "union entry with int");
        }
        else {}
      }
    });

    test("union entry with string", () {
      let v2: IntOrString = "hello";
      match v2 {
        v: string {
          assert(v == "hello", "union entry with string");
        }
        else {}
      }
    });

    test("union match narrowing", () {
      let v3: IntOrString = 100;
      let result = match v3 {
        i32 { "is int" }
        string { "is string" }
        else { "else" }
      };
      assert(result == "is int", "union match narrowing");
    });

    test("union match string branch", () {
      let v4: IntOrString = "world";
      let result2 = match v4 {
        i32 { "int" }
        string { "string" }
        else { "else" }
      };
      assert(result2 == "string", "union match string branch");
    });

    test("union with custom type", () {
      let v5: TagOrInt = UnionTag { tag: "x" };
      let result3 = match v5 {
        UnionTag { "tag" }
        i32 { "int" }
        else { "else" }
      };
      assert(result3 == "tag", "union with custom type");
    });

    test("union with custom type (int branch)", () {
      let v6: TagOrInt = 99;
      let result4 = match v6 {
        UnionTag { "tag" }
        i32 { "int" }
        else { "else" }
      };
      assert(result4 == "int", "union with custom type (int branch)");
    });

    test("union default zero value", () {
      let default_choice: IntOrString;
      let default_result = match default_choice {
        i32 { "int" }
        string { "string" }
        else { "else" }
      };
      assert(default_result == "int", "union default zero value");
    });

    test("union with spec member (Named branch)", () {
      let du1 = make_display_named("spec-user");
      assert(print_display_union(du1) == "spec-user", "union with spec member (Named branch)");
    });

    test("union with spec member (string branch)", () {
      let du2: DisplayUnion = "text";
      assert(print_display_union(du2) == "text", "union with spec member (string branch)");
    });

    test("generic union (value branch)", () {
      let ok_val: UnionResult < i32 > = 42;
      let ok_result = match ok_val {
        i32 { "int-ok" }
        UnionError { "error" }
        else { "else" }
      };
      assert(ok_result == "int-ok", "generic union (value branch)");
    });

    test("generic union (error branch)", () {
      let err_val: UnionResult < i32 > = UnionError { code: 7 };
      let err_result = match err_val {
        i32 { "int" }
        UnionError { "error-ok" }
        else { "else" }
      };
      assert(err_result == "error-ok", "generic union (error branch)");
    });
  });
}
