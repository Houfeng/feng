module fcts_bin;

import std.io;

// union-form spec
spec IntOrString: int | string;

// 用于 union 的自定义 type
type UnionTag {
  let tag: string;
}

spec TagOrInt: UnionTag | int;

/// 联合类型测试
open func test_union() {
  println("--- test_union ---");

  // 值进入 union - int
  let v1: IntOrString = 42;
  if v1 {
    int {
      if v1 == 42 {
        println("[PASS] union entry with int");
      }
    }
    else {}
  }

  // 值进入 union - string
  let v2: IntOrString = "hello";
  if v2 {
    string {
      if v2 == "hello" {
        println("[PASS] union entry with string");
      }
    }
    else {}
  }

  // if 目标值匹配 - 类型收窄
  let v3: IntOrString = 100;
  let result = if v3 {
    int { "is int" }
    string { "is string" }
    else { "else" }
  };
  if result == "is int" {
    println("[PASS] union match narrowing");
  }

  // union 匹配 string 分支
  let v4: IntOrString = "world";
  let result2 = if v4 {
    int { "int" }
    string { "string" }
    else { "else" }
  };
  if result2 == "string" {
    println("[PASS] union match string branch");
  }

  // union 带自定义 type
  let v5: TagOrInt = UnionTag { tag: "x" };
  let result3 = if v5 {
    UnionTag { "tag" }
    int { "int" }
    else { "else" }
  };
  if result3 == "tag" {
    println("[PASS] union with custom type");
  }

  // union 带自定义 type - int 分支
  let v6: TagOrInt = 99;
  let result4 = if v6 {
    UnionTag { "tag" }
    int { "int" }
    else { "else" }
  };
  if result4 == "int" {
    println("[PASS] union with custom type (int branch)");
  }
}
