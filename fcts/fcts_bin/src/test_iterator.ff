module fcts_bin;

import std.io;
import std.test;
import std.text;

// 迭代结果 tuple
type IterPair(bool, int);

// 自定义 Cursor
type RCursor {
  var current: int;
  let end: int;

  @iterator
  func next(): IterPair {
    if self.current >= self.end {
      return (false, 0);
    }
    let value = self.current;
    self.current = self.current + 1;
    return (true, value);
  }
}

// 可迭代类型
type IRange {
  let start: int;
  let end: int;

  @iterable
  func iter(): RCursor {
    return RCursor { current: self.start, end: self.end };
  }
}

// 自迭代 Cursor (直接 @iterator, 无需 @iterable)
type SelfCursor {
  var current: int;
  let limit: int;

  @iterator
  func next(): IterPair {
    if self.current >= self.limit {
      return (false, 0);
    }
    let value = self.current;
    self.current = self.current + 1;
    return (true, value);
  }
}

// ---- @value type 迭代器 (覆盖 value-semantics for-in 路径) ----

// @value 自迭代 Cursor: source 本身是 @value cursor (self-cursor 路径)
@value
type ValueSelfCursor {
  seal var current: int;
  seal let limit: int;

  open func ValueSelfCursor(current: int, limit: int) {
    self.current = current;
    self.limit = limit;
  }

  @iterator
  open func next(): IterPair {
    if self.current >= self.limit {
      return (false, 0);
    }
    let value = self.current;
    self.current = self.current + 1;
    return (true, value);
  }
}

// @value Cursor: 由 @iterable 返回
@value
type ValueCursor {
  seal var current: int;
  seal let end: int;

  open func ValueCursor(current: int, end: int) {
    self.current = current;
    self.end = end;
  }

  @iterator
  open func next(): IterPair {
    if self.current >= self.end {
      return (false, 0);
    }
    let value = self.current;
    self.current = self.current + 1;
    return (true, value);
  }
}

// @value 可迭代类型: @iterable 返回 @value cursor
@value
type ValueRange {
  seal let start: int;
  seal let end: int;

  open func ValueRange(start: int, end: int) {
    self.start = start;
    self.end = end;
  }

  @iterable
  open func iter(): ValueCursor {
    return ValueCursor(self.start, self.end);
  }
}

/** 自定义迭代器测试 */
open func test_iterator() {
  describe("iterator", () {
    test("custom iterator for/in (1+2+3)", () {
      let r = IRange { start: 1, end: 4 };
      var sum = 0;
      for let n in r {
        sum += n;
      }
      assert(sum == 6, "custom iterator for/in (1+2+3)");
    });

    test("self-cursor iterator", () {
      let c = SelfCursor { current: 0, limit: 3 };
      var count = 0;
      for let i in c {
        count += 1;
      }
      assert(count == 3, "self-cursor iterator");
    });

    test("nested custom iterators", () {
      let r2 = IRange { start: 0, end: 2 };
      var pairs = 0;
      for let i in r2 {
        for let j in r2 {
          pairs += 1;
        }
      }
      assert(pairs == 4, "nested custom iterators");
    });

    test("array and iterator coexist", () {
      let nums: int[] = [10, 20];
      var arr_sum = 0;
      for let n in nums {
        arr_sum += n;
      }
      let r3 = IRange { start: 0, end: 2 };
      var iter_sum = 0;
      for let i in r3 {
        iter_sum += i;
      }
      assert(arr_sum == 30 && iter_sum == 1, "array and iterator coexist");
    });

    // @value type for-in 测试

    test("@value @iterable → @value cursor", () {
      let vr = ValueRange(1, 4);
      var sum = 0;
      for let n in vr {
        sum += n;
      }
      assert(sum == 6, "@value @iterable → @value cursor");
    });

    test("@value self-cursor iterator", () {
      let vc = ValueSelfCursor(0, 3);
      var count = 0;
      for let i in vc {
        count += 1;
      }
      assert(count == 3, "@value self-cursor iterator");
    });

    test("@value self-cursor sum", () {
      let vc = ValueSelfCursor(1, 4);
      var sum = 0;
      for let n in vc {
        sum += n;
      }
      assert(sum == 6, "@value self-cursor sum");
    });

    test("std string byte for/in", () {
      let text = "abc";
      var result = "";
      for let b in text {
        result = result + b;
      }
      assert(result == "abc", "std string byte for/in");
    });

    test("std string rune for/in via runes()", () {
      let text = "A中B";
      var result = "";
      for let r in text.runes() {
        result = result + "[" + r + "]";
      }
      assert(result == "[A][中][B]", "std string rune for/in via runes()");
    });

    test("std StringByteIterator direct self-cursor", () {
      let iter = StringByteIterator("xyz");
      var result = "";
      for let b in iter {
        result = result + b;
      }
      assert(result == "xyz", "std StringByteIterator direct self-cursor");
    });
  });
}
