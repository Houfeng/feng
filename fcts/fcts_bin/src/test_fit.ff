module fcts_bin;

import std.io;
import std.test;
import std.text;

// 用于 fit 测试的 spec
spec Describable {
  func describe(): string;
}

// 用于 fit 测试的 type
type FitAnimal {
  let kind: string;
}

// 契约适配
fit FitAnimal: Describable {
  func describe(): string {
    return "Animal: " + self.kind;
  }
}

// 用于自扩展测试的 type
type FitBox {
  var value: int;
}

// 自扩展
fit FitBox {
  func doubled(): int {
    return self.value * 2;
  }

  func is_positive(): bool {
    return self.value > 0;
  }
}

// 静态扩展方法
fit FitBox {
  open static func of(v: int): FitBox {
    return FitBox { value: v };
  }
}

// fit 内建类型 i32
fit i32 {
  func fit_doubled(): i32 {
    return self * 2;
  }
}

// fit 内建类型 int[]
fit int[] {
  func fit_head(): int {
    return self[0];
  }
}

// 泛型 fit 用 spec
spec FitReadable<T> {
  func fit_read(): T;
}

// 泛型 fit 用 type
type FitGenBox<T> {
  var value: T;
}

// 泛型 fit
fit FitGenBox<T>: FitReadable<T> {
  func fit_read(): T {
    return self.value;
  }
}

// 泛型 fit 辅助函数
func read_fit_int(reader: FitReadable<int>): int {
  return reader.fit_read();
}

/** fit 适配测试 */
open func test_fit() {
  describe("fit", () {
    test("fit contract adaptation", () {
      let animal = FitAnimal { kind: "cat" };
      let d: Describable = animal;
      assert(d.describe() == "Animal: cat", "fit contract adaptation");
    });

    test("fit self-extension method", () {
      let box = FitBox { value: 5 };
      assert(box.doubled() == 10, "fit self-extension method");
      assert(box.is_positive(), "fit self-extension method (bool)");
    });

    test("fit static method", () {
      let box2 = FitBox.of(42);
      assert(box2.value == 42, "fit static method");
    });

    test("fit method via spec view", () {
      let desc: Describable = FitAnimal { kind: "dog" };
      assert(desc.describe() == "Animal: dog", "fit method via spec view");
    });

    test("fit builtin i32 method", () {
      let doubled: i32 = 21;
      assert(doubled.fit_doubled() == 42, "fit builtin i32 method");
    });

    test("fit builtin int[] method", () {
      let xs: int[] = [7, 9];
      assert(xs.fit_head() == 7, "fit builtin int[] method");
    });

    test("generic fit", () {
      let gbox: FitGenBox<int> = FitGenBox<int>();
      gbox.value = 42;
      assert(read_fit_int(gbox) == 42, "generic fit");
    });

    test("fit builtin string methods (cross-module)", () {
      assert("hello".length() == (i64)5, "fit builtin string.length (cross-module)");
      assert("hello".indexOf("ll") == (i64)2, "fit builtin string.indexOf (cross-module)");
    });

    test("fit builtin string.join (cross-module)", () {
      let joined = string.join(", ", ["a", "b", "c"]);
      assert(joined == "a, b, c", "fit builtin string.join (cross-module)");
    });
  });
}