module fcts_bin;

import std.io;
import std.test;

func returns_true(): bool {
  return true;
}

func returns_false(): bool {
  return false;
}

/** 表达式与运算测试 */
open func test_expression() {
  describe("expression", () {
    test("arithmetic operations", () {
      let a = 10;
      let b = 3;
      assert(a + b == 13, "addition");
      assert(a - b == 7, "subtraction");
      assert(a * b == 30, "multiplication");
      assert(a / b == 3, "integer division (truncate toward zero)");
      assert(a % b == 1, "modulo");
    });

    test("negative modulo", () {
      let neg = -7;
      assert(neg % 3 == -1, "negative modulo");
    });

    test("comparison operators", () {
      assert(5 < 10 && 10 > 5 && 5 <= 5 && 5 >= 5 && 5 == 5 && 5 != 6, "comparison operators");
    });

    test("logical operators", () {
      assert(true && true, "logical AND");
      assert(true || false, "logical OR");
      assert(!false, "logical NOT");
    });

    test("short-circuit evaluation", () {
      let short_and = false && returns_true();
      assert(!short_and, "short-circuit AND");
      let short_or = true || returns_false();
      assert(short_or, "short-circuit OR");
    });

    test("bitwise operators", () {
      let x: int = 0b1010;
      let y: int = 0b1100;
      assert((x & y) == 0b1000, "bitwise AND");
      assert((x | y) == 0b1110, "bitwise OR");
      assert((x ^ y) == 0b0110, "bitwise XOR");
      let bitmask: int = 0xFF;
      let inverted: int = ~bitmask;
      assert((inverted & 0xFF) == 0, "bitwise NOT");
      assert((1 << 3) == 8, "left shift");
      assert((8 >> 2) == 2, "right shift");
    });

    test("bitwise NOT type inference", () {
      let v: u64 = 0x0000FFFFFFFFFFFF;
      let cleared: u64 = v & (u64)(~0xFFFFFF);
      assert((cleared & 0xFFFFFF) == 0, "tilde literal cast clears low 24 bits");
      let mask: u64 = 1 << 48;
      let flag_on: u64 = 0;
      let flag_set: u64 = flag_on | mask;
      let flag_cleared: u64 = flag_set & (u64)(~(1 << 48));
      assert((flag_cleared & mask) == 0, "tilde on shifted literal clears flag");
      let bm: u64 = 0xFF;
      let inv: u64 = ~bm;
      assert((inv & 0xFF) == 0, "tilde on u64 variable");
    });

    test("bitwise AND type inference across widths", () {
      let hi: u64 = 0x0000FFFFFFFFFFFF;
      let lo: u32 = 0x0000FFFF;
      let masked: u64 = hi & (u64)lo;
      assert(masked == 0x000000000000FFFF, "u64 & (u64)u32 narrows to low 16 bits");
      let a: i32 = 0b1010;
      let b: i64 = 0b1100;
      let r: i64 = (i64)a & b;
      assert(r == 0b1000, "cast-then-AND across i32/i64");
    });

    test("bitwise OR type inference across widths", () {
      let base: u64 = 0xFF00;
      let add: u32 = 0x00FF;
      let combined: u64 = base | (u64)add;
      assert(combined == 0xFFFF, "u64 | (u64)u32 combines all bits");
      let x: i32 = 0b0010;
      let y: i64 = 0b1000;
      let z: i64 = (i64)x | y;
      assert(z == 0b1010, "cast-then-OR across i32/i64");
    });

    test("bitwise XOR type inference across widths", () {
      let a: u64 = 0x0F0F;
      let b: u32 = 0x00FF;
      let r: u64 = a ^ (u64)b;
      assert(r == 0x0FF0, "u64 ^ (u64)u32 flips bits");
      let p: i32 = 0b1010;
      let q: i64 = 0b0110;
      let s: i64 = (i64)p ^ q;
      assert(s == 0b1100, "cast-then-XOR across i32/i64");
    });

    test("shift operators type inference across widths", () {
      let val: u64 = 0x1;
      let amt: u32 = 32;
      let shifted: u64 = val << (u64)amt;
      assert(shifted == (0x1 << 32), "u64 << (u64)u32");
      let back: u64 = shifted >> (u64)amt;
      assert(back == 1, "u64 >> (u64)u32");
      let signed_val: i32 = 0b1000;
      let arith: i32 = signed_val >> 2;
      assert(arith == 0b10, "i32 >> arithmetic shift");
      let small: i32 = 1;
      let promoted: i64 = (i64)small << 4;
      assert(promoted == 16, "cast-then-SHL across i32/i64");
    });

    test("compound assignment", () {
      var c = 10;
      c += 5;
      assert(c == 15, "compound += ");
      c -= 3;
      assert(c == 12, "compound -= ");
      c *= 2;
      assert(c == 24, "compound *= ");
      c /= 4;
      assert(c == 6, "compound /= ");
      c %= 4;
      assert(c == 2, "compound %= ");
    });

    test("bitwise compound assignment", () {
      var m: int = 0xFF;
      m &= 0x0F;
      assert(m == 0x0F, "compound &= ");
      m |= 0xF0;
      assert(m == 0xFF, "compound |= ");
      m ^= 0x0F;
      assert(m == 0xF0, "compound ^= ");

      var sh: int = 1;
      sh <<= 4;
      assert(sh == 16, "compound <<= ");
      sh >>= 2;
      assert(sh == 4, "compound >>= ");
    });

    test("operator precedence", () {
      assert(2 + 3 * 4 == 14, "operator precedence (mul before add)");
      assert((2 + 3) * 4 == 20, "parentheses override precedence");
    });

    test("explicit cast", () {
      let big: i64 = 1000;
      let small = (i32)big;
      assert(small == 1000, "explicit cast i64 to i32");

      let fi = 3.7;
      let ti = (int)fi;
      assert(ti == 3, "explicit cast double to int (truncate)");
    });

    test("string concatenation", () {
      let s1 = "Hello";
      let s2 = ", World!";
      assert(s1 + s2 == "Hello, World!", "string concatenation");
    });

    test("unary negation", () {
      let neg_val = -42;
      assert(neg_val == 0 - 42, "unary negation");
    });

    test("integer division truncation direction", () {
      assert((-7) / 3 == -2, "negative division truncates toward zero");
      assert(7 / (-3) == -2, "positive / negative truncates toward zero");
      assert((-7) / (-3) == 2, "negative / negative is positive");
    });

    test("integer modulo sign follows dividend", () {
      assert((-7) % 3 == -1, "negative dividend negative remainder");
      assert(7 % (-3) == 1, "positive dividend positive remainder");
      assert((-7) % (-3) == -1, "both negative: remainder follows dividend");
    });

    test("float modulo", () {
      let x: double = 7.8;
      let y: double = 3.2;
      let rem = x % y;
      assert(rem > 1.3 && rem < 1.5, "float modulo remainder");
      let neg_x: double = -7.8;
      let neg_rem = neg_x % y;
      assert(neg_rem > -1.5 && neg_rem < -1.3, "float modulo sign follows dividend");
    });

    test("cast integer truncation", () {
      let over: i32 = 257;
      let b: u8 = (u8)over;
      assert(b == 1, "i32 to u8 truncates high bits");
      let neg: i32 = -1;
      let un: u8 = (u8)neg;
      assert(un == 0xFF, "negative i32 to u8 wraps");
    });

    test("cast int to float and back", () {
      let n: i32 = 42;
      let f = (double)n;
      assert(f > 41.0 && f < 43.0, "i32 to double");
      let back = (i32)f;
      assert(back == 42, "double to i32 round-trip");
    });

    test("operator precedence bitwise layers", () {
      let a: int = 0b1100;
      let b: int = 0b1010;
      let c: int = 0b1001;
      assert((a & b | c) == (0b1000 | 0b1001), "& higher than |");
      assert((a ^ b & c) == (a ^ (b & c)), "& higher than ^");
      assert((a | b ^ c) == (a | (b ^ c)), "^ higher than |");
    });

    test("operator precedence shift vs comparison", () {
      assert((1 << 3) == 8, "shift before comparison via parens");
      let x: int = 4;
      assert(x << 1 > 7, "shift higher than >");
      assert(x >> 1 < 3, "shift higher than <");
    });

    test("operator precedence comparison vs equality", () {
      let lo: int = 1;
      let hi: int = 10;
      assert(lo < hi == true, "< higher than ==");
      assert(hi > lo != false, "> higher than !=");
    });

    test("operator precedence bitwise vs logical", () {
      let mask: int = 0xFF;
      let flag: int = 0;
      assert((mask & 0x0F) != 0 && flag == 0, "& higher than &&");
      let bits: int = 0;
      assert((bits | 0x01) != 0 || flag != 0, "| higher than ||");
    });

    test("parentheses override precedence", () {
      assert((2 + 3) * 4 == 20, "parens override mul/add");
      assert(((1 | 2) & 3) == 3, "parens override | / &");
      assert(((1 ^ 2) | 4) == 7, "parens override ^ / |");
    });

    test("left-to-right evaluation order", () {
      let parts: int[!] = int[:3];
      parts[0] = 1;
      parts[1] = 2;
      parts[2] = 3;
      let sum = parts[0] + parts[1] + parts[2];
      assert(sum == 6, "left-to-right arithmetic");
      let chained = parts[0] < parts[1] && parts[1] < parts[2];
      assert(chained, "left-to-right comparison chain");
    });

    test("unary tilde on various integer widths", () {
      let b: u8 = 0x0F;
      let inv_b: u8 = ~b;
      assert(inv_b == 0xF0, "tilde on u8");
      let s: i16 = 0x00FF;
      let inv_s: i16 = ~s;
      assert((inv_s & 0x00FF) == 0, "tilde on i16");
      let w: u32 = 0x0000FFFF;
      let inv_w: u32 = ~w;
      assert((inv_w & 0x0000FFFF) == 0, "tilde on u32");
    });
  });
}
