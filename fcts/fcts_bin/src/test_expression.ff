module fcts_bin;

import std.io;

func returns_true(): bool {
  return true;
}

func returns_false(): bool {
  return false;
}

/// 表达式与运算测试
open func test_expression() {
  println("--- test_expression ---");

  // 算术运算
  let a = 10;
  let b = 3;
  if a + b == 13 {
    println("[PASS] addition");
  }
  if a - b == 7 {
    println("[PASS] subtraction");
  }
  if a * b == 30 {
    println("[PASS] multiplication");
  }
  if a / b == 3 {
    println("[PASS] integer division (truncate toward zero)");
  }
  if a % b == 1 {
    println("[PASS] modulo");
  }

  // 负数取模
  let neg = -7;
  if neg % 3 == -1 {
    println("[PASS] negative modulo");
  }

  // 比较运算
  if 5 < 10 && 10 > 5 && 5 <= 5 && 5 >= 5 && 5 == 5 && 5 != 6 {
    println("[PASS] comparison operators");
  }

  // 逻辑运算
  if true && true {
    println("[PASS] logical AND");
  }
  if true || false {
    println("[PASS] logical OR");
  }
  if !false {
    println("[PASS] logical NOT");
  }

  // 短路求值 - && 左侧 false 不执行右侧
  let short_and = false && returns_true();
  if !short_and {
    println("[PASS] short-circuit AND");
  }

  // 短路求值 - || 左侧 true 不执行右侧
  let short_or = true || returns_false();
  if short_or {
    println("[PASS] short-circuit OR");
  }

  // 位运算
  let x: int = 0b1010;
  let y: int = 0b1100;
  if (x & y) == 0b1000 {
    println("[PASS] bitwise AND");
  }
  if (x | y) == 0b1110 {
    println("[PASS] bitwise OR");
  }
  if (x ^ y) == 0b0110 {
    println("[PASS] bitwise XOR");
  }
  let bitmask: int = 0xFF;
  let inverted: int = ~bitmask;
  if (inverted & 0xFF) == 0 {
    println("[PASS] bitwise NOT");
  }
  if (1 << 3) == 8 {
    println("[PASS] left shift");
  }
  if (8 >> 2) == 2 {
    println("[PASS] right shift");
  }

  // 复合赋值
  var c = 10;
  c += 5;
  if c == 15 {
    println("[PASS] compound += ");
  }
  c -= 3;
  if c == 12 {
    println("[PASS] compound -= ");
  }
  c *= 2;
  if c == 24 {
    println("[PASS] compound *= ");
  }
  c /= 4;
  if c == 6 {
    println("[PASS] compound /= ");
  }
  c %= 4;
  if c == 2 {
    println("[PASS] compound %= ");
  }

  // 位运算复合赋值
  var m: int = 0xFF;
  m &= 0x0F;
  if m == 0x0F {
    println("[PASS] compound &= ");
  }
  m |= 0xF0;
  if m == 0xFF {
    println("[PASS] compound |= ");
  }
  m ^= 0x0F;
  if m == 0xF0 {
    println("[PASS] compound ^= ");
  }

  var sh: int = 1;
  sh <<= 4;
  if sh == 16 {
    println("[PASS] compound <<= ");
  }
  sh >>= 2;
  if sh == 4 {
    println("[PASS] compound >>= ");
  }

  // 运算符优先级
  if 2 + 3 * 4 == 14 {
    println("[PASS] operator precedence (mul before add)");
  }
  if (2 + 3) * 4 == 20 {
    println("[PASS] parentheses override precedence");
  }

  // 显式类型转换
  let big: i64 = 1000;
  let small = (i32)big;
  if small == 1000 {
    println("[PASS] explicit cast i64 to i32");
  }

  let fi = 3.7;
  let ti = (int)fi;
  if ti == 3 {
    println("[PASS] explicit cast double to int (truncate)");
  }

  // 字符串拼接
  let s1 = "Hello";
  let s2 = ", World!";
  if s1 + s2 == "Hello, World!" {
    println("[PASS] string concatenation");
  }

  // 一元取负
  let neg_val = -42;
  if neg_val == 0 - 42 {
    println("[PASS] unary negation");
  }
}
