module fcts_bin;

import std.test;

/** Produces one integer from a captured loop binding. */
spec LoopBindingReader(): int;

/** Iterator result used by the G07 iterator-protocol binding cases. */
type LoopBindingIteratorResult(bool, int);

/** Mutable cursor used to compare iterator-protocol and array loop bindings. */
type LoopBindingCursor {
  var current: int;
  let end: int;

  /** Produce the next integer until the configured end value is reached. */
  @iterator
  func next(): LoopBindingIteratorResult {
    if self.current >= self.end {
      return (false, 0);
    }
    let value = self.current;
    self.current += 1;
    return (true, value);
  }
}

/** Iterable range used by the G07 protocol-path closure cases. */
type LoopBindingRange {
  let start: int;
  let end: int;

  /** Create one independent cursor for this traversal. */
  @iterable
  func iter(): LoopBindingCursor {
    return LoopBindingCursor { current: self.start, end: self.end };
  }
}

/** Pair element used by the G07 tuple loop-binding cases. */
type LoopBindingPair(int, int);

/** Empty tuple element used to verify an empty loop pattern. */
type LoopBindingUnit();

/** Triple element used to verify an empty tuple-pattern position. */
type LoopBindingTriple(int, int, int);

/** Iterator result carrying one pair for tuple loop destructuring. */
type LoopBindingPairIteratorResult(bool, LoopBindingPair);

/** Mutable cursor that yields pair elements. */
type LoopBindingPairCursor {
  var current: int;
  let end: int;

  /** Produce the next pair until the configured end value is reached. */
  @iterator
  func next(): LoopBindingPairIteratorResult {
    if self.current >= self.end {
      return (false, (0, 0));
    }
    let value = self.current;
    self.current += 1;
    return (true, (value, value + 10));
  }
}

/** Iterable pair range used by the protocol-path tuple case. */
type LoopBindingPairRange {
  let start: int;
  let end: int;

  /** Create one independent pair cursor for this traversal. */
  @iterable
  func iter(): LoopBindingPairCursor {
    return LoopBindingPairCursor { current: self.start, end: self.end };
  }
}

/** Verify per-iteration loop binding identity and closure capture behavior. */
open func test_loop_binding() {
  describe("loop binding identity", () {
    test("LOOP-BIND01 for/in var does not modify the source array", () {
      let source: int[!] = [1, 2, 3];
      for var value in source {
        value += 10;
      }
      assert(source[0] == 1 && source[1] == 2 && source[2] == 3,
             "each var loop binding is separate from its source element");
    });

    test("LOOP-BIND02 for/in var does not change the next initial value", () {
      let source = [1, 2, 3];
      var observed = 0;
      for var value in source {
        observed = observed * 10 + value;
        value = 9;
      }
      assert(observed == 123,
             "each iteration starts from its own source element value");
    });

    test("LOOP-BIND03 captured for/in let bindings are per iteration", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      var index = 0;
      for let value in [10, 20, 30] {
        readers[index] = () -> value;
        index += 1;
      }
      assert(readers[0]() == 10 && readers[1]() == 20 && readers[2]() == 30,
             "escaping closures retain their own let iteration binding");
    });

    test("LOOP-BIND04 captured for/in var observes same-round mutation", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      var index = 0;
      for var value in [1, 2, 3] {
        readers[index] = () -> value;
        value += 100;
        index += 1;
      }
      assert(readers[0]() == 101 && readers[1]() == 102 && readers[2]() == 103,
             "each closure observes its own mutated var iteration binding");
    });

    test("LOOP-BIND05 same-round closures share only that round", () {
      let empty: LoopBindingReader = () -> 0;
      let first: LoopBindingReader[!] = [empty, empty, empty];
      let second: LoopBindingReader[!] = [empty, empty, empty];
      var index = 0;
      for var value in [1, 2, 3] {
        first[index] = () -> value;
        second[index] = () -> value;
        value += 10;
        index += 1;
      }
      assert(first[0]() == 11 && second[0]() == 11 &&
             first[1]() == 12 && second[1]() == 12 &&
             first[2]() == 13 && second[2]() == 13,
             "closures share within one round and remain isolated across rounds");
    });

    test("LOOP-BIND06 three-clause initializer executes once", () {
      var initializerCount = 0;
      var iterationCount = 0;
      for initializerCount += 1; iterationCount < 3; iterationCount += 1 {
      }
      assert(initializerCount == 1 && iterationCount == 3,
             "the initializer executes once before the first condition");
    });

    test("LOOP-BIND07 three-clause loop shares an outer binding", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      var shared = 0;
      for var index = 0; index < 3; index += 1 {
        readers[index] = () -> shared;
        shared = index + 1;
      }
      assert(readers[0]() == 3 && readers[1]() == 3 && readers[2]() == 3,
             "closures from every round share the original outer binding");
    });

    test("LOOP-BIND08 three-clause initializer binding is shared", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      for var index = 0; index < 3; index += 1 {
        readers[index] = () -> index;
      }
      assert(readers[0]() == 3 && readers[1]() == 3 && readers[2]() == 3,
             "closures from every round share the initializer binding");
    });

    test("LOOP-BIND09 three-clause body let bindings are per iteration", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      for var index = 0; index < 3; index += 1 {
        let snapshot = index;
        readers[index] = () -> snapshot;
      }
      assert(readers[0]() == 0 && readers[1]() == 1 && readers[2]() == 2,
             "each body execution creates a new let binding");
    });

    test("LOOP-BIND10 three-clause body var observes same-round mutation", () {
      let empty: LoopBindingReader = () -> 0;
      let readers: LoopBindingReader[!] = [empty, empty, empty];
      for var index = 0; index < 3; index += 1 {
        var current = index;
        readers[index] = () -> current;
        current += 10;
      }
      assert(readers[0]() == 10 && readers[1]() == 11 && readers[2]() == 12,
             "each body execution retains its own mutated var binding");
    });

    test("LOOP-BIND11 iterator protocol matches array capture semantics", () {
      let empty: LoopBindingReader = () -> 0;
      let letReaders: LoopBindingReader[!] = [empty, empty, empty];
      let varReaders: LoopBindingReader[!] = [empty, empty, empty];
      var index = 0;
      for let value in (LoopBindingRange { start: 4, end: 7 }) {
        letReaders[index] = () -> value;
        index += 1;
      }
      index = 0;
      for var value in (LoopBindingRange { start: 4, end: 7 }) {
        varReaders[index] = () -> value;
        value += 20;
        index += 1;
      }
      assert(letReaders[0]() == 4 && letReaders[1]() == 5 &&
             letReaders[2]() == 6 && varReaders[0]() == 24 &&
             varReaders[1]() == 25 && varReaders[2]() == 26,
             "iterator and array paths use the same per-iteration bindings");
    });

    test("LOOP-BIND14 for/in let destructures tuple elements", () {
      let first: LoopBindingPair = (1, 10);
      let second: LoopBindingPair = (2, 20);
      let third: LoopBindingPair = (3, 30);
      let source: LoopBindingPair[] = [first, second, third];
      var observed = 0;
      for let (left, right) in source {
        observed = observed * 100 + left * 10 + right;
      }
      assert(observed == 204060,
             "each tuple position initializes its let binding by position");
    });

    test("LOOP-BIND15 for/in var components do not modify the source", () {
      let first: LoopBindingPair = (1, 10);
      let second: LoopBindingPair = (2, 20);
      let source: LoopBindingPair[!] = [first, second];
      var observed = 0;
      for var (left, right) in source {
        left += 100;
        right += 200;
        observed += left + right;
      }
      assert(observed == 633 && source[0].item1 == 1 &&
             source[0].item2 == 10 && source[1].item1 == 2 &&
             source[1].item2 == 20,
             "var tuple components are per-round values, not source fields");
    });

    test("LOOP-BIND16 empty tuple-pattern positions create no binding", () {
      let first: LoopBindingTriple = (1, 100, 3);
      let second: LoopBindingTriple = (4, 200, 6);
      let source: LoopBindingTriple[] = [first, second];
      let unit: LoopBindingUnit = ();
      let units: LoopBindingUnit[] = [unit, unit];
      var observed = 0;
      var unitCount = 0;
      for let (first, , third) in source {
        observed += first * 10 + third;
      }
      for let () in units {
        unitCount += 1;
      }
      assert(observed == 59 && unitCount == 2,
             "empty positions skip fields and an empty pattern still iterates");
    });

    test("LOOP-BIND17 iterator protocol supports tuple destructuring", () {
      var observed = 0;
      for let (left, right) in (LoopBindingPairRange { start: 1, end: 4 }) {
        observed += left * 10 + right;
      }
      assert(observed == 96,
             "iterator and array paths destructure the same element shape");
    });

    test("LOOP-BIND18 captured tuple components retain per-round identity", () {
      let empty: LoopBindingReader = () -> 0;
      let leftReaders: LoopBindingReader[!] = [empty, empty, empty];
      let rightReaders: LoopBindingReader[!] = [empty, empty, empty];
      let first: LoopBindingPair = (1, 10);
      let second: LoopBindingPair = (2, 20);
      let third: LoopBindingPair = (3, 30);
      let source: LoopBindingPair[!] = [first, second, third];
      var index = 0;
      for var (left, right) in source {
        leftReaders[index] = () -> left;
        rightReaders[index] = () -> right;
        left += 100;
        right += 200;
        index += 1;
      }
      assert(leftReaders[0]() == 101 && leftReaders[1]() == 102 &&
             leftReaders[2]() == 103 && rightReaders[0]() == 210 &&
             rightReaders[1]() == 220 && rightReaders[2]() == 230 &&
             source[0].item1 == 1 && source[0].item2 == 10,
             "each captured component shares only its own round binding");
    });
  });
}
