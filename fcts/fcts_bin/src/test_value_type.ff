module fcts_bin;

import std.io;
import std.test;

// trivial @value type (all scalar fields)
@value
type VPoint {
  var x: int;
  var y: int;

  func sum(): int {
    return self.x + self.y;
  }

  func scaleBy(factor: int): VPoint {
    var result: VPoint;
    result.x = self.x * factor;
    result.y = self.y * factor;
    return result;
  }

  func reset() {
    self.x = 0;
    self.y = 0;
  }

  func copy(): VPoint {
    return self;
  }
}

// aggregate @value type (contains managed field)
@value
type VPerson {
  var name: string;
  var age: int;
}

// nested @value type
@value
type VRect {
  var origin: VPoint;
  var width: int;
  var height: int;
}

// trivial @value type with constructors
@value
type VCounter {
  var count: int;

  func VCounter() {
    self.count = 0;
  }

  func VCounter(initial: int) {
    self.count = initial;
  }

  func increment() {
    self.count = self.count + 1;
  }

  func incrementBy(amount: int) {
    self.count = self.count + amount;
  }

  func getCount(): int {
    return self.count;
  }

  func copy(): VCounter {
    return self;
  }
}

// aggregate @value type with constructors
@value
type VTagged {
  var label: string;
  var value: int;

  func VTagged() {
    self.label = "";
    self.value = 0;
  }

  func VTagged(label: string, value: int) {
    self.label = label;
    self.value = value;
  }

  func describe(): string {
    return self.label;
  }

  func copy(): VTagged {
    return self;
  }
}

// @value type with let (immutable) fields
@value
type VImmutable {
  let id: int;
  var name: string;

  func getId(): int {
    return self.id;
  }

  func setName(newName: string) {
    self.name = newName;
  }
}

// function taking @value type parameter
func vpoint_sum(p: VPoint): int {
  return p.x + p.y;
}

// function returning @value type
func make_vpoint(x: int, y: int): VPoint {
  var p: VPoint;
  p.x = x;
  p.y = y;
  return p;
}

// function returning @value type via constructor
func make_counter(n: int): VCounter {
  return VCounter(n);
}

// function calling method on @value parameter
func vpoint_method_sum(p: VPoint): int {
  return p.sum();
}

// --- Spec satisfaction types (§9.7) ---

// spec for @value type declaration-head satisfaction (TYPE_OWN_METHOD)
spec VDescribable {
  func describe(): string;
}

// @value type satisfies spec via declaration head (own method)
@value
type VItem: VDescribable {
  var label: string;
  var value: int;

  func describe(): string {
    return self.label;
  }

  func getValue(): int {
    return self.value;
  }
}

// @value type satisfies spec via fit (FIT_METHOD)
@value
type VTag {
  var name: string;
}

fit VTag: VDescribable {
  func describe(): string {
    return "tag:" + self.name;
  }
}

// spec with let field for @value type
spec VNamed {
  let name: string;
  func displayName(): string;
}

// @value type satisfies spec with let field + own method
@value
type VWidget: VNamed {
  let name: string;
  var id: int;

  func VWidget(name: string, id: int) {
    self.name = name;
    self.id = id;
  }

  func displayName(): string {
    return "[" + self.name + "]";
  }
}

// function accepting spec parameter
func consume_vdescribable(item: VDescribable): string {
  return item.describe();
}

// function accepting VNamed spec parameter
func consume_vnamed(item: VNamed): string {
  return item.displayName();
}

/** @value type 测试 */
open func test_value_type() {
  describe("value-type", () {
    test("trivial @value type default init", () {
      var p: VPoint;
      assert(p.x == 0 && p.y == 0, "trivial @value type default init");
    });

    test("trivial @value type field mutation", () {
      var p: VPoint;
      p.x = 10;
      p.y = 20;
      assert(p.x == 10 && p.y == 20, "trivial @value type field mutation");
    });

    test("trivial @value type value copy", () {
      var p1: VPoint;
      p1.x = 1;
      p1.y = 2;
      var p2: VPoint = p1;
      p2.x = 99;
      assert(p1.x == 1 && p1.y == 2, "original unchanged after value copy");
      assert(p2.x == 99 && p2.y == 2, "copy has new value");
    });

    test("trivial @value type as function parameter", () {
      var p: VPoint;
      p.x = 3;
      p.y = 4;
      assert(vpoint_sum(p) == 7, "trivial @value type as function parameter");
    });

    test("trivial @value type returned from function", () {
      let p = make_vpoint(5, 6);
      assert(p.x == 5 && p.y == 6, "trivial @value type returned from function");
    });

    test("trivial @value type equality", () {
      var p1: VPoint;
      p1.x = 1;
      p1.y = 2;
      var p2: VPoint;
      p2.x = 1;
      p2.y = 2;
      var p3: VPoint;
      p3.x = 1;
      p3.y = 3;
      assert(p1 == p2, "equal @value types");
      assert(p1 != p3, "unequal @value types");
    });

    test("aggregate @value type with string field", () {
      var person: VPerson;
      person.name = "Alice";
      person.age = 25;
      assert(person.name == "Alice" && person.age == 25,
             "aggregate @value type with string field");
    });

    test("aggregate @value type value copy", () {
      var p1: VPerson;
      p1.name = "Bob";
      p1.age = 30;
      var p2: VPerson = p1;
      p2.name = "Charlie";
      assert(p1.name == "Bob", "original string unchanged after value copy");
      assert(p2.name == "Charlie", "copy has new string");
    });

    test("nested @value type field access", () {
      var rect: VRect;
      rect.origin.x = 10;
      rect.origin.y = 20;
      rect.width = 100;
      rect.height = 200;
      assert(rect.origin.x == 10 && rect.origin.y == 20,
             "nested @value type field access");
      assert(rect.width == 100 && rect.height == 200,
             "outer @value type field access");
    });

    test("let @value type field immutability", () {
      var p: VPoint;
      p.x = 5;
      p.y = 10;
      let q: VPoint = p;
      // q.x and q.y should not be mutable
      assert(q.x == 5 && q.y == 10, "let @value type preserves values");
    });

    test("trivial @value type constructor call", () {
      let c = VCounter(10);
      assert(c.count == 10, "trivial @value type constructor call");
    });

    test("trivial @value type default constructor", () {
      let c = VCounter();
      assert(c.count == 0, "trivial @value type default constructor");
    });

    test("trivial @value type object literal with constructor", () {
      let c = VCounter { count: 42 };
      assert(c.count == 42, "trivial @value type object literal");
    });

    test("trivial @value type empty object literal", () {
      let c = VCounter {};
      assert(c.count == 0, "trivial @value type empty object literal");
    });

    test("trivial @value type constructor value semantics", () {
      let c1 = VCounter(5);
      var c2 = c1;
      c2.count = 99;
      assert(c1.count == 5, "original unchanged after value copy");
      assert(c2.count == 99, "copy has new value");
    });

    test("aggregate @value type constructor call", () {
      let t = VTagged("hello", 42);
      assert(t.label == "hello" && t.value == 42,
             "aggregate @value type constructor call");
    });

    test("aggregate @value type default constructor", () {
      let t = VTagged();
      assert(t.label == "" && t.value == 0,
             "aggregate @value type default constructor");
    });

    test("aggregate @value type object literal with constructor", () {
      let t = VTagged { label: "world", value: 7 };
      assert(t.label == "world" && t.value == 7,
             "aggregate @value type object literal");
    });

    test("aggregate @value type constructor value semantics", () {
      let t1 = VTagged("abc", 1);
      var t2 = t1;
      t2.label = "xyz";
      assert(t1.label == "abc", "original string unchanged after value copy");
      assert(t2.label == "xyz", "copy has new string");
    });

    test("trivial @value type constructor self mutation", () {
      let c = VCounter(100);
      assert(c.count == 100, "constructor self mutation via parameter");
    });

    test("@value type constructor returned from function", () {
      let c = make_counter(77);
      assert(c.count == 77, "@value type constructor returned from function");
    });

    // --- Method tests (§9.6) ---

    test("trivial @value type method call (read-only)", () {
      var p: VPoint;
      p.x = 3;
      p.y = 4;
      assert(p.sum() == 7, "method reads self fields correctly");
    });

    test("trivial @value type method with parameter", () {
      var p: VPoint;
      p.x = 2;
      p.y = 3;
      let scaled = p.scaleBy(10);
      assert(scaled.x == 20 && scaled.y == 30, "method with parameter returns correct value");
      assert(p.x == 2 && p.y == 3, "original unchanged after method call");
    });

    test("trivial @value type method mutates var field via self", () {
      var p: VPoint;
      p.x = 5;
      p.y = 10;
      p.reset();
      assert(p.x == 0 && p.y == 0, "method mutates var fields via self");
    });

    test("trivial @value type method self escape (copy returns value)", () {
      var p: VPoint;
      p.x = 1;
      p.y = 2;
      let q = p.copy();
      assert(q.x == 1 && q.y == 2, "self escape via return produces value copy");
    });

    test("trivial @value type method self escape (let binding)", () {
      var c = VCounter(5);
      let snapshot = c.copy();
      c.incrementBy(10);
      assert(snapshot.getCount() == 5, "self escape copy is independent");
      assert(c.getCount() == 15, "original mutated independently");
    });

    test("trivial @value type method increment", () {
      var c = VCounter(0);
      c.increment();
      c.increment();
      c.increment();
      assert(c.count == 3, "method increments var field correctly");
    });

    test("trivial @value type method incrementBy", () {
      var c = VCounter(10);
      c.incrementBy(5);
      assert(c.getCount() == 15, "method with parameter mutates var field");
    });

    test("trivial @value type chained method calls", () {
      var p: VPoint;
      p.x = 1;
      p.y = 2;
      let result = p.scaleBy(3).sum();
      assert(result == 9, "chained method calls work correctly");
    });

    test("aggregate @value type method call", () {
      let t = VTagged("hello", 42);
      assert(t.describe() == "hello", "aggregate @value method reads string field");
    });

    test("aggregate @value type method self escape", () {
      var t = VTagged("original", 1);
      let copy = t.copy();
      t.label = "modified";
      assert(copy.describe() == "original", "aggregate self escape produces independent copy");
      assert(t.describe() == "modified", "original can be mutated independently");
    });

    test("@value type let field accessible via method", () {
      var v: VImmutable;
      v.name = "test";
      assert(v.getId() == 0, "let field readable via method");
    });

    test("@value type var field mutable via method", () {
      var v: VImmutable;
      v.name = "initial";
      v.setName("updated");
      assert(v.name == "updated", "var field mutable via method");
    });

    test("@value type let binding method call", () {
      let p: VPoint = VPoint { x: 7, y: 8 };
      assert(p.sum() == 15, "method call on let-bound @value works");
    });

    test("@value type method on function parameter", () {
      var p: VPoint;
      p.x = 10;
      p.y = 20;
      assert(vpoint_sum(p) == 30, "function param method not needed here");
      // Test method call on param
      let s = vpoint_method_sum(p);
      assert(s == 30, "method call on function parameter works");
    });

    // --- Spec satisfaction tests (§9.7) ---

    test("@value type declaration-head spec satisfaction (direct-call)", () {
      var item: VItem;
      item.label = "widget";
      item.value = 42;
      assert(item.describe() == "widget", "direct-call on @value type satisfying spec");
    });

    test("@value type passed as spec parameter (TYPE_OWN_METHOD)", () {
      var item: VItem;
      item.label = "test";
      item.value = 7;
      let result = consume_vdescribable(item);
      assert(result == "test", "@value type coerced to spec parameter via own method");
    });

    test("@value type assigned to spec variable (TYPE_OWN_METHOD)", () {
      var item: VItem;
      item.label = "assigned";
      item.value = 99;
      let d: VDescribable = item;
      assert(d.describe() == "assigned", "@value type assigned to spec variable");
    });

    test("@value type fit method via spec (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "important";
      assert(tag.describe() == "tag:important", "fit method direct-call on @value type");
    });

    test("@value type fit passed as spec parameter (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "urgent";
      let result = consume_vdescribable(tag);
      assert(result == "tag:urgent", "@value type coerced to spec via fit method");
    });

    test("@value type fit assigned to spec variable (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "low";
      let d: VDescribable = tag;
      assert(d.describe() == "tag:low", "@value type with fit assigned to spec variable");
    });

    test("@value type spec with let field (TYPE_OWN_FIELD + TYPE_OWN_METHOD)", () {
      let w = VWidget("Button", 1);
      assert(w.displayName() == "[Button]", "direct-call on @value with let field");
      let result = consume_vnamed(w);
      assert(result == "[Button]", "@value with let field passed as spec parameter");
    });

    test("@value type spec value semantics preserved after coercion", () {
      var item: VItem;
      item.label = "original";
      item.value = 1;
      let d: VDescribable = item;
      item.label = "modified";
      item.value = 2;
      // spec box holds a copy, so it should still show original
      assert(d.describe() == "original", "spec box holds independent copy");
      assert(item.describe() == "modified", "original value mutated independently");
    });
  });
}
