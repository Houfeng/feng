module fcts_bin;

import std.io;
import std.test;

// trivial @value type (all scalar fields)
@value
type VPoint {
  var x: int;
  var y: int;

  func sum(): int {
    return self.x + self.y;
  }

  func scaleBy(factor: int): VPoint {
    var result: VPoint;
    result.x = self.x * factor;
    result.y = self.y * factor;
    return result;
  }

  func reset() {
    self.x = 0;
    self.y = 0;
  }

  func copy(): VPoint {
    return self;
  }
}

// aggregate @value type (contains managed field)
@value
type VPerson {
  var name: string;
  var age: int;
}

// nested @value type
@value
type VRect {
  var origin: VPoint;
  var width: int;
  var height: int;
}

// trivial @value type with constructors
@value
type VCounter {
  var count: int;

  func VCounter() {
    self.count = 0;
  }

  func VCounter(initial: int) {
    self.count = initial;
  }

  func increment() {
    self.count = self.count + 1;
  }

  func incrementBy(amount: int) {
    self.count = self.count + amount;
  }

  func getCount(): int {
    return self.count;
  }

  func copy(): VCounter {
    return self;
  }
}

// aggregate @value type with constructors
@value
type VTagged {
  var label: string;
  var value: int;

  func VTagged() {
    self.label = "";
    self.value = 0;
  }

  func VTagged(label: string, value: int) {
    self.label = label;
    self.value = value;
  }

  func describe(): string {
    return self.label;
  }

  func copy(): VTagged {
    return self;
  }
}

// @value type with let (immutable) fields
@value
type VImmutable {
  let id: int;
  var name: string;

  func getId(): int {
    return self.id;
  }

  func setName(newName: string) {
    self.name = newName;
  }
}

// function taking @value type parameter
func vpoint_sum(p: VPoint): int {
  return p.x + p.y;
}

// function returning @value type
func make_vpoint(x: int, y: int): VPoint {
  var p: VPoint;
  p.x = x;
  p.y = y;
  return p;
}

// function returning @value type via constructor
func make_counter(n: int): VCounter {
  return VCounter(n);
}

// function calling method on @value parameter
func vpoint_method_sum(p: VPoint): int {
  return p.sum();
}

// --- Spec satisfaction types (§9.7) ---

// spec for @value type declaration-head satisfaction (TYPE_OWN_METHOD)
spec VDescribable {
  func describe(): string;
}

// @value type satisfies spec via declaration head (own method)
@value
type VItem: VDescribable {
  var label: string;
  var value: int;

  func describe(): string {
    return self.label;
  }

  func getValue(): int {
    return self.value;
  }
}

// @value type satisfies spec via fit (FIT_METHOD)
@value
type VTag {
  var name: string;
}

fit VTag: VDescribable {
  func describe(): string {
    return "tag:" + self.name;
  }
}

// spec with let field for @value type
spec VNamed {
  let name: string;
  func displayName(): string;
}

// @value type satisfies spec with let field + own method
@value
type VWidget: VNamed {
  let name: string;
  var id: int;

  func VWidget(name: string, id: int) {
    self.name = name;
    self.id = id;
  }

  func displayName(): string {
    return "[" + self.name + "]";
  }
}

// function accepting spec parameter
func consume_vdescribable(item: VDescribable): string {
  return item.describe();
}

// function accepting VNamed spec parameter
func consume_vnamed(item: VNamed): string {
  return item.displayName();
}

// --- Fit extension self access/escape tests (§9.8) ---

// spec for fit self access tests (trivial @value)
spec VFitCopyable {
  func fit_copy(): VFitBox;
  func fit_get_value(): int;
}

// trivial @value type for fit self access tests
@value
type VFitBox {
  var value: int;
}

// fit extension with self access patterns (trivial @value)
fit VFitBox: VFitCopyable {
  func fit_copy(): VFitBox {
    return self;
  }

  func fit_get_value(): int {
    return self.value;
  }
}

// aggregate @value type for fit self escape tests
@value
type VFitNamed {
  var label: string;
  var count: int;
}

// spec for aggregate fit self tests
spec VFitNamedCopyable {
  func fit_copy(): VFitNamed;
  func fit_get_label(): string;
  func fit_get_count(): int;
  func fit_mutate_count(): void;
}

// fit extension with self access patterns (aggregate @value)
fit VFitNamed: VFitNamedCopyable {
  func fit_copy(): VFitNamed {
    return self;
  }

  func fit_get_label(): string {
    return self.label;
  }

  func fit_get_count(): int {
    return self.count;
  }

  func fit_mutate_count(): void {
    self.count = self.count + 1;
  }
}

// function accepting spec parameter for fit tests
func consume_vfitcopyable(item: VFitCopyable): VFitBox {
  return item.fit_copy();
}

// function accepting VFitNamedCopyable spec parameter
func consume_vfitnamedcopyable(item: VFitNamedCopyable): VFitNamed {
  return item.fit_copy();
}

// function that takes @value by value (for foo(self) test)
func vfitbox_value(v: VFitBox): int {
  return v.value;
}

// helper: creates an aggregate @value, coerces to spec box, returns result
// box goes out of scope on return, exercising release_children path
func spec_box_scope_cycle(label: string): string {
  var item: VItem;
  item.label = label;
  item.value = 1;
  let d: VDescribable = item;
  return d.describe();
}

// helper: creates multiple spec boxes in sequence, each goes out of scope
func spec_box_multi_cycle(count: int): string {
  var result: string = "";
  var i = 0;
  while i < count {
    var item: VItem;
    item.label = "cycle";
    item.value = i;
    let d: VDescribable = item;
    result = d.describe();
    i = i + 1;
  }
  return result;
}

// --- Generic @value type (§9.10) ---

// 泛型 @value type（trivial 实例：全字段 trivial 也走 aggregate 路径）
@value
type VGPair<A, B> {
  var left: A;
  var right: B;

  func get_left(): A {
    return self.left;
  }

  func get_right(): B {
    return self.right;
  }

  func set_left(value: A) {
    self.left = value;
  }

  func set_right(value: B) {
    self.right = value;
  }
}

// 泛型 @value type 带泛型方法
@value
type VGBox<T> {
  var value: T;

  func get(): T {
    return self.value;
  }

  func set(next: T) {
    self.value = next;
  }

  func echo<U>(item: U): U {
    return item;
  }

  func replace<U>(next: T, result: U): U {
    self.value = next;
    return result;
  }
}

// 泛型 @value type + fit + spec dispatch (§9.10 补充)
spec TBoxReader<T> {
  func read(): T;
}

spec TBoxWriter<T> {
  func write(val: T): void;
}

fit VGBox<T>: TBoxReader<T> {
  func read(): T {
    return self.value;
  }
}

fit VGBox<T>: TBoxWriter<T> {
  func write(val: T): void {
    self.value = val;
  }
}

// 泛型 @value type（aggregate 实例：含 string 字段）
@value
type VGTagged<T> {
  var label: string;
  var value: T;

  func describe(): string {
    return self.label;
  }
}

// 接受泛型 @value type 参数的函数
func vgpair_sum_left(p: VGPair<int, int>): int {
  return p.get_left();
}

// 返回泛型 @value type 的函数
func make_vgpair(a: int, b: string): VGPair<int, string> {
  var p: VGPair<int, string>;
  p.left = a;
  p.right = b;
  return p;
}

// §9.11: @value @abi type (值语义 + ABI 兼容，支持 & 取地址)
@value @abi
type VAbiPoint {
  var x: int;
  var y: int;
}

// @value @abi type with nested @value @abi field (allowed: @value has no managed header)
@value @abi
type VAbiRect {
  var origin: VAbiPoint;
  var width: int;
  var height: int;
}

// §9.12: @abi func with @value @abi parameter/return (ABI interop)

// @abi func taking @value @abi parameter
@abi
func vabi_point_sum(p: VAbiPoint): int {
  return p.x + p.y;
}

// @abi func returning @value @abi
@abi
func vabi_make_point(x: int, y: int): VAbiPoint {
  var p: VAbiPoint;
  p.x = x;
  p.y = y;
  return p;
}

// @abi func with both @value @abi parameter and return
@abi
func vabi_translate(p: VAbiPoint, dx: int, dy: int): VAbiPoint {
  var result: VAbiPoint;
  result.x = p.x + dx;
  result.y = p.y + dy;
  return result;
}

// @abi func with nested @value @abi parameter
@abi
func vabi_rect_area(r: VAbiRect): int {
  return r.width * r.height;
}

/** @value type 测试 */
open func test_value_type() {
  describe("value-type", () {
    test("trivial @value type default init", () {
      var p: VPoint;
      assert(p.x == 0 && p.y == 0, "trivial @value type default init");
    });

    test("trivial @value type field mutation", () {
      var p: VPoint;
      p.x = 10;
      p.y = 20;
      assert(p.x == 10 && p.y == 20, "trivial @value type field mutation");
    });

    test("trivial @value type value copy", () {
      var p1: VPoint;
      p1.x = 1;
      p1.y = 2;
      var p2: VPoint = p1;
      p2.x = 99;
      assert(p1.x == 1 && p1.y == 2, "original unchanged after value copy");
      assert(p2.x == 99 && p2.y == 2, "copy has new value");
    });

    test("trivial @value type as function parameter", () {
      var p: VPoint;
      p.x = 3;
      p.y = 4;
      assert(vpoint_sum(p) == 7, "trivial @value type as function parameter");
    });

    test("trivial @value type returned from function", () {
      let p = make_vpoint(5, 6);
      assert(p.x == 5 && p.y == 6, "trivial @value type returned from function");
    });

    test("trivial @value type equality", () {
      var p1: VPoint;
      p1.x = 1;
      p1.y = 2;
      var p2: VPoint;
      p2.x = 1;
      p2.y = 2;
      var p3: VPoint;
      p3.x = 1;
      p3.y = 3;
      assert(p1 == p2, "equal @value types");
      assert(p1 != p3, "unequal @value types");
    });

    test("aggregate @value type with string field", () {
      var person: VPerson;
      person.name = "Alice";
      person.age = 25;
      assert(person.name == "Alice" && person.age == 25,
             "aggregate @value type with string field");
    });

    test("aggregate @value type value copy", () {
      var p1: VPerson;
      p1.name = "Bob";
      p1.age = 30;
      var p2: VPerson = p1;
      p2.name = "Charlie";
      assert(p1.name == "Bob", "original string unchanged after value copy");
      assert(p2.name == "Charlie", "copy has new string");
    });

    test("nested @value type field access", () {
      var rect: VRect;
      rect.origin.x = 10;
      rect.origin.y = 20;
      rect.width = 100;
      rect.height = 200;
      assert(rect.origin.x == 10 && rect.origin.y == 20,
             "nested @value type field access");
      assert(rect.width == 100 && rect.height == 200,
             "outer @value type field access");
    });

    test("let @value type field immutability", () {
      var p: VPoint;
      p.x = 5;
      p.y = 10;
      let q: VPoint = p;
      // q.x and q.y should not be mutable
      assert(q.x == 5 && q.y == 10, "let @value type preserves values");
    });

    test("trivial @value type constructor call", () {
      let c = VCounter(10);
      assert(c.count == 10, "trivial @value type constructor call");
    });

    test("trivial @value type default constructor", () {
      let c = VCounter();
      assert(c.count == 0, "trivial @value type default constructor");
    });

    test("trivial @value type object literal with constructor", () {
      let c = VCounter { count: 42 };
      assert(c.count == 42, "trivial @value type object literal");
    });

    test("trivial @value type empty object literal", () {
      let c = VCounter {};
      assert(c.count == 0, "trivial @value type empty object literal");
    });

    test("trivial @value type constructor value semantics", () {
      let c1 = VCounter(5);
      var c2 = c1;
      c2.count = 99;
      assert(c1.count == 5, "original unchanged after value copy");
      assert(c2.count == 99, "copy has new value");
    });

    test("aggregate @value type constructor call", () {
      let t = VTagged("hello", 42);
      assert(t.label == "hello" && t.value == 42,
             "aggregate @value type constructor call");
    });

    test("aggregate @value type default constructor", () {
      let t = VTagged();
      assert(t.label == "" && t.value == 0,
             "aggregate @value type default constructor");
    });

    test("aggregate @value type object literal with constructor", () {
      let t = VTagged { label: "world", value: 7 };
      assert(t.label == "world" && t.value == 7,
             "aggregate @value type object literal");
    });

    test("aggregate @value type constructor value semantics", () {
      let t1 = VTagged("abc", 1);
      var t2 = t1;
      t2.label = "xyz";
      assert(t1.label == "abc", "original string unchanged after value copy");
      assert(t2.label == "xyz", "copy has new string");
    });

    test("trivial @value type constructor self mutation", () {
      let c = VCounter(100);
      assert(c.count == 100, "constructor self mutation via parameter");
    });

    test("@value type constructor returned from function", () {
      let c = make_counter(77);
      assert(c.count == 77, "@value type constructor returned from function");
    });

    // --- Method tests (§9.6) ---

    test("trivial @value type method call (read-only)", () {
      var p: VPoint;
      p.x = 3;
      p.y = 4;
      assert(p.sum() == 7, "method reads self fields correctly");
    });

    test("trivial @value type method with parameter", () {
      var p: VPoint;
      p.x = 2;
      p.y = 3;
      let scaled = p.scaleBy(10);
      assert(scaled.x == 20 && scaled.y == 30, "method with parameter returns correct value");
      assert(p.x == 2 && p.y == 3, "original unchanged after method call");
    });

    test("trivial @value type method mutates var field via self", () {
      var p: VPoint;
      p.x = 5;
      p.y = 10;
      p.reset();
      assert(p.x == 0 && p.y == 0, "method mutates var fields via self");
    });

    test("trivial @value type method self escape (copy returns value)", () {
      var p: VPoint;
      p.x = 1;
      p.y = 2;
      let q = p.copy();
      assert(q.x == 1 && q.y == 2, "self escape via return produces value copy");
    });

    test("trivial @value type method self escape (let binding)", () {
      var c = VCounter(5);
      let snapshot = c.copy();
      c.incrementBy(10);
      assert(snapshot.getCount() == 5, "self escape copy is independent");
      assert(c.getCount() == 15, "original mutated independently");
    });

    test("trivial @value type method increment", () {
      var c = VCounter(0);
      c.increment();
      c.increment();
      c.increment();
      assert(c.count == 3, "method increments var field correctly");
    });

    test("trivial @value type method incrementBy", () {
      var c = VCounter(10);
      c.incrementBy(5);
      assert(c.getCount() == 15, "method with parameter mutates var field");
    });

    test("trivial @value type chained method calls", () {
      var p: VPoint;
      p.x = 1;
      p.y = 2;
      let result = p.scaleBy(3).sum();
      assert(result == 9, "chained method calls work correctly");
    });

    test("aggregate @value type method call", () {
      let t = VTagged("hello", 42);
      assert(t.describe() == "hello", "aggregate @value method reads string field");
    });

    test("aggregate @value type method self escape", () {
      var t = VTagged("original", 1);
      let copy = t.copy();
      t.label = "modified";
      assert(copy.describe() == "original", "aggregate self escape produces independent copy");
      assert(t.describe() == "modified", "original can be mutated independently");
    });

    test("@value type let field accessible via method", () {
      var v: VImmutable;
      v.name = "test";
      assert(v.getId() == 0, "let field readable via method");
    });

    test("@value type var field mutable via method", () {
      var v: VImmutable;
      v.name = "initial";
      v.setName("updated");
      assert(v.name == "updated", "var field mutable via method");
    });

    test("@value type let binding method call", () {
      let p: VPoint = VPoint { x: 7, y: 8 };
      assert(p.sum() == 15, "method call on let-bound @value works");
    });

    test("@value type method on function parameter", () {
      var p: VPoint;
      p.x = 10;
      p.y = 20;
      assert(vpoint_sum(p) == 30, "function param method not needed here");
      // Test method call on param
      let s = vpoint_method_sum(p);
      assert(s == 30, "method call on function parameter works");
    });

    // --- Spec satisfaction tests (§9.7) ---

    test("@value type declaration-head spec satisfaction (direct-call)", () {
      var item: VItem;
      item.label = "widget";
      item.value = 42;
      assert(item.describe() == "widget", "direct-call on @value type satisfying spec");
    });

    test("@value type passed as spec parameter (TYPE_OWN_METHOD)", () {
      var item: VItem;
      item.label = "test";
      item.value = 7;
      let result = consume_vdescribable(item);
      assert(result == "test", "@value type coerced to spec parameter via own method");
    });

    test("@value type assigned to spec variable (TYPE_OWN_METHOD)", () {
      var item: VItem;
      item.label = "assigned";
      item.value = 99;
      let d: VDescribable = item;
      assert(d.describe() == "assigned", "@value type assigned to spec variable");
    });

    test("@value type fit method via spec (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "important";
      assert(tag.describe() == "tag:important", "fit method direct-call on @value type");
    });

    test("@value type fit passed as spec parameter (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "urgent";
      let result = consume_vdescribable(tag);
      assert(result == "tag:urgent", "@value type coerced to spec via fit method");
    });

    test("@value type fit assigned to spec variable (FIT_METHOD)", () {
      var tag: VTag;
      tag.name = "low";
      let d: VDescribable = tag;
      assert(d.describe() == "tag:low", "@value type with fit assigned to spec variable");
    });

    test("@value type spec with let field (TYPE_OWN_FIELD + TYPE_OWN_METHOD)", () {
      let w = VWidget("Button", 1);
      assert(w.displayName() == "[Button]", "direct-call on @value with let field");
      let result = consume_vnamed(w);
      assert(result == "[Button]", "@value with let field passed as spec parameter");
    });

    test("@value type spec value semantics preserved after coercion", () {
      var item: VItem;
      item.label = "original";
      item.value = 1;
      let d: VDescribable = item;
      item.label = "modified";
      item.value = 2;
      // spec box holds a copy, so it should still show original
      assert(d.describe() == "original", "spec box holds independent copy");
      assert(item.describe() == "modified", "original value mutated independently");
    });

    // --- Fit extension self access/escape tests (§9.8) ---

    test("@value fit method self field access (trivial)", () {
      var box: VFitBox;
      box.value = 42;
      assert(box.fit_get_value() == 42, "fit method reads self.value correctly");
    });

    test("@value fit method self escape via return (trivial)", () {
      var box: VFitBox;
      box.value = 10;
      let copy = box.fit_copy();
      assert(copy.value == 10, "fit method return self produces value copy");
    });

    test("@value fit method self escape via return is independent (trivial)", () {
      var box: VFitBox;
      box.value = 20;
      let copy = box.fit_copy();
      copy.value = 99;
      assert(box.value == 20, "original unchanged after fit copy mutation");
      assert(copy.value == 99, "fit copy has new value");
    });

    test("@value fit method self escape via let binding (trivial)", () {
      var box: VFitBox;
      box.value = 30;
      // fit_copy returns self, exercises let y = self path in fit body
      let snapshot = box.fit_copy();
      box.value = 50;
      assert(snapshot.value == 30, "fit let binding captures independent copy");
      assert(box.value == 50, "original mutated independently");
    });

    test("@value fit method self escape via function call (trivial)", () {
      var box: VFitBox;
      box.value = 77;
      // fit_copy passes self as argument (escape via foo(self))
      let result = vfitbox_value(box.fit_copy());
      assert(result == 77, "fit method foo(self) passes value copy");
    });

    test("@value fit method self escape via spec parameter (trivial)", () {
      var box: VFitBox;
      box.value = 55;
      let result = consume_vfitcopyable(box);
      assert(result.value == 55, "fit method via spec returns value copy");
    });

    test("@value fit method self escape via assigned spec variable (trivial)", () {
      var box: VFitBox;
      box.value = 88;
      let s: VFitCopyable = box;
      box.value = 0;
      assert(s.fit_get_value() == 88, "spec box holds independent copy via fit");
    });

    test("@value fit method self access (aggregate, string field)", () {
      var named: VFitNamed;
      named.label = "hello";
      named.count = 5;
      assert(named.fit_get_label() == "hello", "fit method reads aggregate self.label");
      assert(named.fit_get_count() == 5, "fit method reads aggregate self.count");
    });

    test("@value fit method self escape via return (aggregate)", () {
      var named: VFitNamed;
      named.label = "world";
      named.count = 10;
      let copy = named.fit_copy();
      assert(copy.label == "world", "aggregate fit copy preserves string field");
      assert(copy.count == 10, "aggregate fit copy preserves int field");
    });

    test("@value fit method self escape via return is independent (aggregate)", () {
      var named: VFitNamed;
      named.label = "original";
      named.count = 1;
      let copy = named.fit_copy();
      copy.label = "modified";
      copy.count = 99;
      assert(named.label == "original", "original string unchanged after aggregate fit copy");
      assert(named.count == 1, "original count unchanged after aggregate fit copy");
      assert(copy.label == "modified", "aggregate fit copy has new string");
      assert(copy.count == 99, "aggregate fit copy has new count");
    });

    test("@value fit method self mutation via var field (aggregate)", () {
      var named: VFitNamed;
      named.label = "test";
      named.count = 0;
      named.fit_mutate_count();
      assert(named.count == 1, "fit method mutates var field via self");
      named.fit_mutate_count();
      assert(named.count == 2, "fit method mutates var field via self (second call)");
    });

    test("@value fit method self escape via spec parameter (aggregate)", () {
      var named: VFitNamed;
      named.label = "spec";
      named.count = 42;
      let result = consume_vfitnamedcopyable(named);
      assert(result.label == "spec", "aggregate fit via spec returns copy with string");
      assert(result.count == 42, "aggregate fit via spec returns copy with int");
    });

    // --- Box release tests (§9.9) ---

    test("aggregate @value spec box released on scope exit", () {
      // Each call creates a spec box (aggregate @value with string field),
      // box is released when the function returns. Call multiple times to
      // exercise retain/release cycle.
      let r1 = spec_box_scope_cycle("first");
      let r2 = spec_box_scope_cycle("second");
      let r3 = spec_box_scope_cycle("third");
      assert(r1 == "first", "first cycle box released correctly");
      assert(r2 == "second", "second cycle box released correctly");
      assert(r3 == "third", "third cycle box released correctly");
      // Verify aggregate @value still works after multiple box cycles
      var item: VItem;
      item.label = "after";
      item.value = 99;
      assert(item.describe() == "after", "aggregate @value works after box cycles");
    });

    test("aggregate @value spec box released in loop", () {
      // Multiple boxes created and released within a loop scope
      let result = spec_box_multi_cycle(5);
      assert(result == "cycle", "multi-cycle boxes released correctly");
      // Verify aggregate @value still works after loop box cycles
      var tag: VTag;
      tag.name = "post-loop";
      assert(tag.describe() == "tag:post-loop", "aggregate @value works after loop box cycles");
    });

    // --- Generic @value type tests (§9.10) ---

    test("generic @value type instantiation (trivial fields)", () {
      var p: VGPair<int, int>;
      p.left = 10;
      p.right = 20;
      assert(p.left == 10 && p.right == 20, "generic @value type with trivial fields");
    });

    test("generic @value type instantiation (mixed fields)", () {
      var p: VGPair<int, string>;
      p.left = 42;
      p.right = "hello";
      assert(p.left == 42 && p.right == "hello", "generic @value type with mixed fields");
    });

    test("generic @value type method call", () {
      var p: VGPair<int, int>;
      p.left = 3;
      p.right = 7;
      assert(p.get_left() == 3, "generic @value method get_left");
      assert(p.get_right() == 7, "generic @value method get_right");
    });

    test("generic @value type method mutation", () {
      var p: VGPair<int, int>;
      p.left = 1;
      p.right = 2;
      p.set_left(100);
      p.set_right(200);
      assert(p.left == 100 && p.right == 200, "generic @value method mutates fields");
    });

    test("generic @value type value semantics", () {
      var p1: VGPair<int, int>;
      p1.left = 5;
      p1.right = 10;
      var p2: VGPair<int, int> = p1;
      p2.left = 99;
      assert(p1.left == 5 && p1.right == 10, "original unchanged after value copy");
      assert(p2.left == 99 && p2.right == 10, "copy has new value");
    });

    test("generic @value type as function parameter", () {
      var p: VGPair<int, int>;
      p.left = 15;
      p.right = 25;
      assert(vgpair_sum_left(p) == 15, "generic @value type as function parameter");
    });

    test("generic @value type returned from function", () {
      let p = make_vgpair(7, "world");
      assert(p.left == 7 && p.right == "world", "generic @value type returned from function");
    });

    test("generic @value type aggregate instance (string field)", () {
      var t: VGTagged<int>;
      t.label = "tag1";
      t.value = 42;
      assert(t.describe() == "tag1", "generic @value aggregate method call");
      assert(t.value == 42, "generic @value aggregate field access");
    });

    test("generic @value type aggregate value semantics", () {
      var t1: VGTagged<int>;
      t1.label = "original";
      t1.value = 1;
      var t2: VGTagged<int> = t1;
      t2.label = "modified";
      t2.value = 99;
      assert(t1.label == "original" && t1.value == 1, "original unchanged after aggregate value copy");
      assert(t2.label == "modified" && t2.value == 99, "aggregate copy has new values");
    });

    test("generic @value type with generic method (echo)", () {
      var box: VGBox<int>;
      box.value = 10;
      let echoed: int = box.echo(42);
      assert(echoed == 42, "generic @value type generic method echo");
      assert(box.value == 10, "box value unchanged after echo");
    });

    test("generic @value type with generic method (replace)", () {
      var box: VGBox<int>;
      box.value = 5;
      let result: string = box.replace(20, "replaced");
      assert(result == "replaced", "generic @value generic method replace returns U");
      assert(box.value == 20, "generic @value generic method replace updates T");
    });

    test("generic @value type get/set methods", () {
      var box: VGBox<string>;
      box.set("hello");
      assert(box.get() == "hello", "generic @value type get/set with string");
      box.set("world");
      assert(box.get() == "world", "generic @value type get/set updates value");
    });

    test("generic @value type aggregate instance (string value)", () {
      var t: VGTagged<string>;
      t.label = "str-tag";
      t.value = "inner";
      assert(t.describe() == "str-tag", "generic @value aggregate with string value");
      assert(t.value == "inner", "generic @value aggregate string value access");
    });

    // §9.10 补充：泛型 @value type + fit + spec dispatch

    test("generic @value type fit method via spec (member, direct)", () {
      var box: VGBox<int>;
      box.value = 42;
      let reader: TBoxReader<int> = box;
      assert(reader.read() == 42, "generic @value fit read via spec");
    });

    test("generic @value type fit method via spec (member, mutate)", () {
      var box: VGBox<int>;
      box.value = 0;
      let writer: TBoxWriter<int> = box;
      writer.write(100);
      // @value types have value semantics: spec coercion creates a boxed copy,
      // so mutations through the spec variable don't affect the original.
      assert(box.value == 0, "generic @value fit write via spec preserves original (value semantics)");
    });

    test("generic @value type fit method via spec parameter", () {
      var box: VGBox<int>;
      box.value = 7;
      let r: TBoxReader<int> = box;
      assert(r.read() == 7, "generic @value fit method dispatched via spec parameter");
    });

    // --- @value @abi type tests (§9.11) ---

    test("@value @abi type declaration and basic usage", () {
      var p: VAbiPoint;
      p.x = 10;
      p.y = 20;
      assert(p.x == 10 && p.y == 20, "@value @abi type basic field access");
    });

    test("@value @abi type & takes address of lvalue", () {
      var p: VAbiPoint;
      p.x = 3;
      p.y = 7;
      let addr: VAbiPoint* = &p;
      let addr2: VAbiPoint* = &p;
      // Pointers are opaque in Feng; verify identity via ==
      assert(addr == addr2, "@value @abi & on same variable produces equal pointers");
    });

    test("@value @abi type & produces distinct pointers for distinct vars", () {
      var p1: VAbiPoint;
      p1.x = 1;
      p1.y = 2;
      var p2: VAbiPoint;
      p2.x = 3;
      p2.y = 4;
      let a1: VAbiPoint* = &p1;
      let a2: VAbiPoint* = &p2;
      assert(a1 != a2, "@value @abi & on different variables produces distinct pointers");
    });

    test("@value @abi nested type & takes address", () {
      var r: VAbiRect;
      r.origin.x = 5;
      r.origin.y = 10;
      r.width = 200;
      r.height = 100;
      let addr: VAbiRect* = &r;
      let addr2: VAbiRect* = &r;
      assert(addr == addr2, "@value @abi nested type & produces valid pointer");
    });

    test("@value @abi & on member field", () {
      var r: VAbiRect;
      r.origin.x = 42;
      r.origin.y = 99;
      r.width = 10;
      r.height = 20;
      let originAddr: VAbiPoint* = &r.origin;
      let originAddr2: VAbiPoint* = &r.origin;
      assert(originAddr == originAddr2, "@value @abi & on member field produces valid pointer");
    });

    test("@value @abi type value semantics preserved", () {
      var p1: VAbiPoint;
      p1.x = 5;
      p1.y = 10;
      var p2: VAbiPoint = p1;
      p2.x = 99;
      assert(p1.x == 5, "@value @abi value copy is independent");
      assert(p2.x == 99, "@value @abi copy has new value");
    });

    // --- @abi func @value @abi ABI interop tests (§9.12) ---

    test("@abi func with @value @abi parameter", () {
      var p: VAbiPoint;
      p.x = 10;
      p.y = 20;
      assert(vabi_point_sum(p) == 30, "@abi func receives @value @abi parameter correctly");
    });

    test("@abi func returning @value @abi", () {
      let p = vabi_make_point(42, 99);
      assert(p.x == 42 && p.y == 99, "@abi func returns @value @abi correctly");
    });

    test("@abi func with @value @abi parameter and return", () {
      var p: VAbiPoint;
      p.x = 5;
      p.y = 10;
      let translated = vabi_translate(p, 3, 7);
      assert(translated.x == 8 && translated.y == 17,
             "@abi func with @value @abi param and return works correctly");
      // Verify original is unchanged (value semantics)
      assert(p.x == 5 && p.y == 10,
             "@value @abi original unchanged after @abi func call");
    });

    test("@abi func with nested @value @abi parameter", () {
      var r: VAbiRect;
      r.origin.x = 0;
      r.origin.y = 0;
      r.width = 10;
      r.height = 20;
      assert(vabi_rect_area(r) == 200,
             "@abi func with nested @value @abi parameter works correctly");
    });

    test("@abi func with @value @abi compiles and generates wrapper", () {
      // The @abi func declarations (vabi_point_sum, vabi_make_point,
      // vabi_translate, vabi_rect_area) exercise the ABI wrapper
      // generation for @value @abi parameter/return types.
      // The compilation itself verifies the wrapper C types are correct.
      // Runtime behavior is tested by direct calls above.
      assert(true, "@abi func @value @abi ABI wrappers generated successfully");
    });
  });
}
