module fcts_bin;

import fcts_lib.test;

func generic_constraint_forwarding_cross_package(): bool {
  let payload = LibGenericDisplayPayload { value: 42 };
  let inner = LibGenericInner<LibGenericDisplayPayload, LibGenericDisplayPayload> {
    name: "inner",
    payload1: payload,
    payload2: payload,
    value: 1
  };
  let outer = LibGenericOuter<LibGenericDisplayPayload> { inner: inner };
  let copied = outer.getInner();
  return copied.displayPayload2() == "lib-generic-display-payload" && outer.displayInner() == "lib-generic-display-payload";
}
