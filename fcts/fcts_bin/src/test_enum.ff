module fcts_bin;

import std.io;
import std.test;

// 隐式取值 enum
enum Direction {
  North,
  East,
  South,
  West
}

// 显式取值 enum
enum HttpStatus {
  Ok = 200,
  NotFound = 404,
  ServerError = 500
}

/** enum 枚举测试 */
open func test_enum() {
  describe("enum", () {
    test("enum implicit value (first = 0)", () {
      let d = Direction.North;
      assert((int)d == 0, "enum implicit value (first = 0)");
    });

    test("enum implicit value (sequential)", () {
      let d2 = Direction.West;
      assert((int)d2 == 3, "enum implicit value (sequential)");
    });

    test("enum explicit value", () {
      let s = HttpStatus.Ok;
      assert((int)s == 200, "enum explicit value");
      let s2 = HttpStatus.NotFound;
      assert((int)s2 == 404, "enum explicit value (404)");
    });

    test("enum == comparison", () {
      let d = Direction.North;
      let d3 = Direction.North;
      assert(d == d3, "enum == comparison");
    });

    test("enum != comparison", () {
      let d = Direction.North;
      let d4 = Direction.South;
      assert(d != d4, "enum != comparison");
    });

    test("enum default value (first item)", () {
      let default_dir: Direction;
      assert(default_dir == Direction.North, "enum default value (first item)");
    });

    test("enum to int explicit cast", () {
      let code = (int)HttpStatus.ServerError;
      assert(code == 500, "enum to int explicit cast");
    });

    test("enum match - single value", () {
      let d = Direction.East;
      let label = match d {
        Direction.North { "N" }
        Direction.East { "E" }
        Direction.South { "S" }
        Direction.West { "W" }
        else { "?" }
      };
      assert(label == "E", "enum match - single value");
    });

    test("enum match - value list", () {
      let s = HttpStatus.NotFound;
      let kind = match s {
        HttpStatus.Ok { "ok" }
        HttpStatus.NotFound, HttpStatus.ServerError { "error" }
        else { "?" }
      };
      assert(kind == "error", "enum match - value list");
    });

    test("enum match - statement form", () {
      let d = Direction.South;
      var label = "unknown";
      match d {
        Direction.North { label = "N"; }
        Direction.South { label = "S"; }
        else { label = "other"; }
      }
      assert(label == "S", "enum match - statement form");
    });

    test("enum match - explicit values", () {
      let s = HttpStatus.Ok;
      let code = match s {
        HttpStatus.Ok { 200 }
        HttpStatus.NotFound { 404 }
        else { 500 }
      };
      assert(code == 200, "enum match - explicit values");
    });
  });
}
