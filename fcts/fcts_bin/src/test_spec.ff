module fcts_bin;

import std.io;
import std.test;

// object-form spec
spec Printable {
  func to_string(): string;
}

// spec 继承
spec DetailPrintable: Printable {
  func detail(): string;
}

// callable-form spec
spec Transformer(x: i32): i32;

// type 声明头满足 spec
type SpecItem: Printable {
  let label: string;

  func to_string(): string {
    return self.label;
  }
}

// type 满足多个 spec
type DetailItem: DetailPrintable {
  let label: string;
  let desc: string;

  func to_string(): string {
    return self.label;
  }

  func detail(): string {
    return self.label + ": " + self.desc;
  }
}

// spec 中的字段
spec HasName {
  let name: string;
}

type NamedEntity: HasName {
  let name: string;
}

// 用于 spec 参数/返回值测试
spec SpecGreetable {
  func spec_greet(): string;
}

type SpecUser: SpecGreetable {
  let name: string;

  func spec_greet(): string {
    return self.name;
  }
}

// spec 作为函数参数
func announce_spec(n: SpecGreetable): string {
  return n.spec_greet();
}

// spec 作为返回值
func make_spec_named(label: string): SpecGreetable {
  let u = SpecUser { name: label };
  return u;
}

// 转发 spec 返回值
func forward_spec(label: string): SpecGreetable {
  return make_spec_named(label);
}

// spec 中带 var 字段 (用于修改测试)
spec MutableNamed {
  var mname: string;
  func mgreet(): string;
}

type MutableUser: MutableNamed {
  var mname: string;

  func mgreet(): string {
    return self.mname;
  }
}

/** spec 契约测试 */
open func test_spec() {
  describe("spec", () {
    test("object-form spec via declaration", () {
      let item = SpecItem { label: "test" };
      let p: Printable = item;
      assert(p.to_string() == "test", "object-form spec via declaration");
    });

    test("spec inheritance", () {
      let detail = DetailItem { label: "item", desc: "a test item" };
      let dp: DetailPrintable = detail;
      assert(dp.to_string() == "item" && dp.detail() == "item: a test item", "spec inheritance");
    });

    test("callable-form spec", () {
      let t: Transformer = (x: i32) -> x * 2;
      assert(t(5) == 10, "callable-form spec");
    });

    test("function assigned to callable-form spec", () {
      let t2: Transformer = double_it;
      assert(t2(7) == 14, "function assigned to callable-form spec");
    });

    test("spec field matching", () {
      let entity = NamedEntity { name: "entity1" };
      let hn: HasName = entity;
      assert(hn.name == "entity1", "spec field matching");
    });

    test("default witness (spec default value)", () {
      let default_p: Printable;
      assert(default_p.to_string() == "", "default witness (spec default value)");
    });

    test("spec as function parameter", () {
      let su = SpecUser { name: "param" };
      assert(announce_spec(su) == "param", "spec as function parameter");
    });

    test("spec as function return value", () {
      let sn = make_spec_named("returned");
      assert(sn.spec_greet() == "returned", "spec as function return value");
    });

    test("spec return value forwarding", () {
      let sf = forward_spec("forwarded");
      assert(sf.spec_greet() == "forwarded", "spec return value forwarding");
    });

    test("spec var field mutation via spec view", () {
      let mu = MutableUser { mname: "before" };
      let mn: MutableNamed = mu;
      mn.mname = "after";
      assert(mn.mgreet() == "after", "spec var field mutation via spec view");
      assert(mu.mname == "after", "spec var field mutation reflects on original");
    });

    test("spec == / != comparison", () {
      let sa = SpecUser { name: "alice" };
      let sb = SpecUser { name: "bob" };
      let sna: SpecGreetable = sa;
      let sna2: SpecGreetable = sa;
      let snb: SpecGreetable = sb;
      assert(sna == sna2, "spec == same reference");
      assert(sna != snb, "spec != different reference");
    });
  });
}

func double_it(x: i32): i32 {
  return x * 2;
}
