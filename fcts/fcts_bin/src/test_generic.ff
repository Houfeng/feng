module fcts_bin;

import std.io;
import std.test;

// 泛型 func
func gidentity<T>(value: T): T {
  return value;
}

// 泛型约束
spec GSizeable {
  func gsize(): int;
}

type GSizedList: GSizeable {
  let count: int;

  func gsize(): int {
    return self.count;
  }
}

func get_gsize<T: GSizeable>(item: T): int {
  return item.gsize();
}

// 泛型 spec
spec GReader<T> {
  func read_val(): T;
}

type IntReader: GReader<int> {
  let value: int;

  func read_val(): int {
    return self.value;
  }
}

type StringReader: GReader<string> {
  let value: string;

  func read_val(): string {
    return self.value;
  }
}

// 泛型 type 用于接受值
func wrap_int(v: int): int {
  return gidentity<int>(v);
}

func wrap_string(v: string): string {
  return gidentity<string>(v);
}

// 泛型 type 带方法
type GBox<T> {
  var value: T;

  func set_val(next: T) {
    self.value = next;
  }

  func get_val(): T {
    return self.value;
  }
}

// 用于验证用户类型作为泛型实参时的递归默认值。
type TestType {
  let x: int;
}

// 泛型 void 函数
func gdiscard<T>(x: T) {
}

// 多类型参数
func gswap_discard<T, U>(a: T, b: U) {
}

// 泛型 type 上的泛型方法
type GMethodBox<T> {
  var value: T;

  func echo<U>(item: U): U {
    return item;
  }

  func replace<U>(next: T, result: U): U {
    self.value = next;
    return result;
  }

  func current(): T {
    return self.value;
  }
}

// 泛型自约束 - spec Eq<T>
spec GEq<T> {
  func gsame(other: T): bool;
}

type GKey: GEq<GKey> {
  var id: int;

  func gsame(other: GKey): bool {
    return self.id == other.id;
  }
}

// 泛型自约束 - MiniMap
type GMiniMap<K: GEq<K>, V> {
  var key: K;
  var val: V;

  func gput(key: K, val: V) {
    self.key = key;
    self.val = val;
  }

  func ghas(key: K): bool {
    return key.gsame(self.key);
  }

  func gget(key: K): V {
    return self.val;
  }
}

// 函数级自约束
func gsame_as<U: GEq<U>>(left: U, right: U): bool {
  return left.gsame(right);
}

// 泛型自约束返回自身 - Cloneable
spec GCloneable<T> {
  func gclone_val(): T;
}

type GCloneKey: GCloneable<GCloneKey> {
  var id: int;

  func gclone_val(): GCloneKey {
    return GCloneKey { id: self.id };
  }
}

type GCopier<K: GCloneable<K>> {
  func gcopy(key: K): K {
    return key.gclone_val();
  }
}

// 泛型 spec 继承
spec GSequence<T> {
  func gfirst(): T;
}

spec GCollection<T>: GSequence<T> {
  func gcount(): int;
}

type GIntList: GCollection<int> {
  let head: int;
  let len: int;

  func gfirst(): int {
    return self.head;
  }

  func gcount(): int {
    return self.len;
  }
}

// 泛型约束转发
func gfirst_of<T, C: GSequence<T>>(col: C): T {
  return col.gfirst();
}

// 泛型聚合返回用 spec。
spec GNamed {
  func ggreet(): string;
}

// 泛型聚合返回用 type。
type GNamedUser: GNamed {
  let name: string;

  func ggreet(): string {
    return self.name;
  }
}

// 创建并以 spec 视图返回聚合值。
func make_gnamed<T>(name: string): GNamed {
  let user: GNamedUser = GNamedUser { name: name };
  return user;
}

// 转发 spec 视图形式的聚合值。
func forward_gnamed<T>(named: GNamed): GNamed {
  return named;
}

// 通过泛型函数链路重新创建 spec 视图值。
func rebound_gnamed<T>(name: string): GNamed {
  return make_gnamed<T>(name);
}

// spec 作为泛型实参的约束入口。
func gid_gnamed<T: GNamed>(value: T): T {
  return value;
}

// spec 作为泛型实参的容器。
type GNamedHolder<T: GNamed> {
  var value: T;

  func set_named(next: T) {
    self.value = next;
  }

  func read_named(): string {
    return self.value.ggreet();
  }

  func relay_named<U: GNamed>(item: U): string {
    return item.ggreet();
  }
}

// 泛型值实参场景的容器。
type GValueHolder<T> {
  var value: T;

  func put_value(value: T) {
    self.value = value;
  }

  func read_value(): T {
    return self.value;
  }

  func echo_value<U>(value: U): U {
    return value;
  }

  func echo_value_through_method(value: T): T {
    return self.echo_value(value);
  }
}

// 泛型约束 witness 字段访问用 spec。
spec GMutableNamed {
  var gname: string;
  func greet_mutable(): string;
}

// 泛型约束 witness 字段访问用 type。
type GMutableUser: GMutableNamed {
  var gname: string;

  func greet_mutable(): string {
    return self.gname;
  }
}

// 通过泛型约束访问并修改字段。
func rename_gmutable<T: GMutableNamed>(user: T, next: string): string {
  user.gname = next;
  return user.gname;
}

// 通过泛型约束调用方法。
func greet_gmutable<T: GMutableNamed>(user: T): string {
  return user.greet_mutable();
}

// 父级约束转发用父 spec。
spec GForwardNamed {
  func gforward_name(): string;
}

// 父级约束转发用子 spec。
spec GLabelled: GForwardNamed {
}

// 父级约束转发用 type。
type GForwardItem: GLabelled {
  func gforward_name(): string {
    return "item";
  }
}

// 使用父级约束读取名称。
func use_gforward_named<T: GForwardNamed>(value: T): string {
  return value.gforward_name();
}

// 将子级约束转发给父级约束函数。
func use_glabelled<U: GLabelled>(value: U): string {
  return use_gforward_named<U>(value);
}

// 具体化父泛型 spec。
spec GCountSequence<T> {
  func gsize_value(): int;
}

// 具体化父泛型 spec 的子 spec。
spec GIntCountSequence: GCountSequence<int> {
}

// 具体化父泛型 spec 的实现类型。
type GCounter: GIntCountSequence {
  var n: int;

  func gsize_value(): int {
    return self.n;
  }
}

// 通过具体化子 spec 视图调用继承成员。
func check_gint_sequence(seq: GIntCountSequence): int {
  return seq.gsize_value();
}

// 重新声明父泛型 spec 成员的具体化子 spec。
spec GIntSequenceOverride: GCountSequence<int> {
  func gsize_value(): int;
}

// 实现重新声明成员的具体化子 spec。
type GOverrideCounter: GIntSequenceOverride {
  func gsize_value(): int {
    return 1;
  }
}

// 泛型数组创建用元素类型。
type GPair<A, B> {
  var left: A;
  var right: B;
}

// 嵌套泛型默认初始化用容器。
type GNestedHolder<T> {
  var inner: GBox<T>;
}

// 非自约束泛型映射用 spec。
spec GHashable {
  func ghash(): int;
  func gsame_hash(hash: int): bool;
}

// 非自约束泛型映射用 key。
type GHashKey: GHashable {
  var code: int;

  func ghash(): int {
    return self.code;
  }

  func gsame_hash(hash: int): bool {
    return self.ghash() == hash;
  }
}

// 非自约束泛型映射。
type GHashMiniMap<K: GHashable, V> {
  var key: K;
  var val: V;

  func gput_hash(key: K, val: V) {
    self.key = key;
    self.val = val;
  }

  func ghas_hash(key: K): bool {
    return key.gsame_hash(self.key.ghash());
  }

  func gget_hash(key: K): V {
    return self.val;
  }
}

// === 重载决议场景：泛型候选必须先满足约束,非泛型候选优先 ===
// 见 docs/specifications/feng-generics-draft.md §5 规则:类型参数推导+约束验证+非泛型优先分层.

// 约束 spec:只有实现了 GTaggable 的类型才能被泛型重载接受.
spec GTaggable {
  func gtag(): string;
}

// GTaggableUser 实现了 GTaggable:泛型重载对它成立.
type GTaggableUser: GTaggable {
  let label: string;

  func gtag(): string {
    return self.label;
  }
}

// GUnrelatedUser 未实现 GTaggable:泛型重载对它不成立.
type GUnrelatedUser {
  let name: string;
}

// 重载集合:1) 非泛型重载接受任意 GTaggable(spec 视图);2) 泛型重载要求 T: GTaggable.
// 两个签名返回不同的字符串,使运行时可以验证哪个重载被命中.
func gtag_overload(value: GTaggable): string {
  return "non-generic";
}

func gtag_overload<T: GTaggable>(value: T): string {
  return "generic";
}

// 重载集合:仅泛型重载,没有非泛型候选.约束满足时泛型必须被选中.
func gtag_generic_only<T: GTaggable>(value: T): string {
  return "generic-only";
}

// 重载集合:1) 非泛型精确匹配(接受 GTaggableUser);2) 泛型重载(也接受 GTaggableUser).
// 当实参是 GTaggableUser 时,非泛型精确匹配必须胜出.
func gtag_exact(value: GTaggableUser): string {
  return "non-generic-exact";
}

func gtag_exact<T: GTaggable>(value: T): string {
  return "generic";
}

// === arity 重载场景:同名不同 arity 的类型独立使用 ===
// type Container<T> (arity=1) 和 type Container<T,U> (arity=2) 按 (name, arity) 共存.

type Container<T> {
  var value: T;

  func get(): T {
    return self.value;
  }

  func set(next: T) {
    self.value = next;
  }
}

type Container<T, U> {
  var first: T;
  var second: U;

  func get_first(): T {
    return self.first;
  }

  func get_second(): U {
    return self.second;
  }
}

/** 泛型声明在前的 arity=1 View。 */
type ArityView<T> {
  static func new(): ArityView<T> {
    return ArityView<T>();
  }

  func generic_value(): int {
    return 1;
  }
}

/** 与 ArityView<T> 同名、后声明的 arity=0 View。 */
type ArityView {
  static func new(): ArityView {
    return ArityView();
  }

  func plain_value(): int {
    return 2;
  }
}

/** 泛型测试 */
open func test_generic() {
  describe("generic", () {
    test("generic function (explicit type arg)", () {
      let r1 = gidentity<int>(100);
      assert(r1 == 100, "generic function (explicit type arg)");
    });

    test("generic function (type inference)", () {
      let r2 = gidentity(200);
      assert(r2 == 200, "generic function (type inference int)");
      let r3 = gidentity("test");
      assert(r3 == "test", "generic function (type inference string)");
    });

    test("generic func wrap", () {
      assert(wrap_int(42) == 42, "generic func wrap int");
      assert(wrap_string("hello") == "hello", "generic func wrap string");
    });

    test("generic constraint", () {
      let list = GSizedList { count: 5 };
      assert(get_gsize(list) == 5, "generic constraint");
    });

    test("generic spec (int reader)", () {
      let ir = IntReader { value: 77 };
      let reader: GReader<int> = ir;
      let rv = reader.read_val();
      assert(rv == 77, "generic spec (int reader)");
    });

    test("generic spec (string reader)", () {
      let sr = StringReader { value: "data" };
      let sreader: GReader<string> = sr;
      let sv = sreader.read_val();
      assert(sv == "data", "generic spec (string reader)");
    });

    test("generic type method (int)", () {
      let gbox: GBox<int> = GBox<int>();
      gbox.set_val(7);
      assert(gbox.get_val() == 7, "generic type method (int)");
    });

    test("generic type method (string)", () {
      let sbox: GBox<string> = GBox<string>();
      sbox.set_val("gen");
      assert(sbox.get_val() == "gen", "generic type method (string)");
    });

    test("generic type constructor", () {
      let cbox: GBox<int> = GBox<int>();
      cbox.value = 99;
      assert(cbox.value == 99, "generic type constructor");
    });

    test("generic type constructor default value (string)", () {
      let box = GBox<string>();
      assert(box.value == "", "generic string field defaults to empty string");
    });

    test("generic type constructor default value (int)", () {
      let box = GBox<int>();
      assert(box.value == 0, "generic int field defaults to zero");
    });

    test("generic type constructor default value (user type)", () {
      let box = GBox<TestType>();
      assert(box.value.x == 0, "generic user type field defaults recursively");
    });

    test("generic void function", () {
      gdiscard(1);
      gdiscard("hello");
      gdiscard(true);
      assert(true, "generic void function");
    });

    test("generic two type params", () {
      gswap_discard(1, "hello");
      gswap_discard("world", 42);
      assert(true, "generic two type params");
    });

    test("generic type with generic method", () {
      let mbox: GMethodBox<int> = GMethodBox<int>();
      let echo_val: int = mbox.echo(20);
      let replace_val: int = mbox.replace<int>(22, echo_val);
      assert(mbox.current() + replace_val + mbox.echo(1) == 43, "generic type with generic method");
    });

    test("generic self constraint (Eq)", () {
      let ka = GKey { id: 7 };
      let kb = GKey { id: 7 };
      let kc = GKey { id: 8 };
      assert(ka.gsame(kb), "generic self constraint (same)");
      assert(!kc.gsame(ka), "generic self constraint (different)");
    });

    test("generic self constraint MiniMap", () {
      let ka = GKey { id: 7 };
      let kb = GKey { id: 7 };
      let gmap: GMiniMap<GKey, string> = GMiniMap<GKey, string>();
      gmap.gput(ka, "self constraint ok");
      assert(gmap.ghas(ka), "generic self constraint MiniMap");
      assert(gmap.gget(ka) == "self constraint ok", "generic self constraint MiniMap get");
      assert(gsame_as(ka, kb), "function self constraint");
    });

    test("generic self constraint return (Cloneable)", () {
      let ck = GCloneKey { id: 7 };
      let copier: GCopier<GCloneKey> = GCopier<GCloneKey>();
      let copied = copier.gcopy(ck);
      assert(copied.id == 7, "generic self constraint return");
    });

    test("generic spec inheritance", () {
      let glist = GIntList { head: 10, len: 3 };
      let gcol: GCollection<int> = glist;
      assert(gcol.gfirst() == 10, "generic spec inheritance (first)");
      assert(gcol.gcount() == 3, "generic spec inheritance (count)");
      let gseq: GSequence<int> = glist;
      assert(gseq.gfirst() == 10, "generic spec inheritance (parent view)");
    });

    test("generic constraint forwarding", () {
      let glist = GIntList { head: 10, len: 3 };
      assert(gfirst_of<int, GIntList>(glist) == 10, "generic constraint forwarding");
    });

    test("generic aggregate return", () {
      let created: GNamed = make_gnamed<int>("generic aggregate return ok");
      assert(created.ggreet() == "generic aggregate return ok", "generic aggregate return created");
      let forwarded: GNamed = forward_gnamed<int>(created);
      assert(forwarded.ggreet() == "generic aggregate return ok", "generic aggregate return forwarded");
      let rebound: GNamed = rebound_gnamed<int>("generic aggregate return ok");
      assert(rebound.ggreet() == "generic aggregate return ok", "generic aggregate return rebound");
    });

    test("generic spec value argument", () {
      let named: GNamed = GNamedUser { name: "spec generic value ok" };
      let from_fn: GNamed = gidentity(named);
      assert(from_fn.ggreet() == "spec generic value ok", "generic spec value argument function");
      let holder: GValueHolder<GNamed> = GValueHolder<GNamed>();
      holder.put_value(named);
      let from_type_arg: GNamed = holder.read_value();
      assert(from_type_arg.ggreet() == "spec generic value ok", "generic spec value argument type");
      let from_method: GNamed = holder.echo_value(named);
      assert(from_method.ggreet() == "spec generic value ok", "generic spec value argument method");
      let from_self_call: GNamed = holder.echo_value_through_method(named);
      assert(from_self_call.ggreet() == "spec generic value ok", "generic spec value argument self call");
    });

    test("generic aggregate three entrances", () {
      let named: GNamed = GNamedUser { name: "phase-e-ok" };
      let from_fn: GNamed = gid_gnamed<GNamed>(named);
      let holder: GNamedHolder<GNamed> = GNamedHolder<GNamed>();
      holder.set_named(from_fn);
      let from_method: string = holder.relay_named<GNamed>(from_fn);
      assert(from_method == "phase-e-ok", "generic aggregate entrance method");
      assert(holder.read_named() == "phase-e-ok", "generic aggregate entrance holder");
    });

    test("generic constraint witness field", () {
      let user: GMutableUser = GMutableUser { gname: "before" };
      assert(rename_gmutable(user, "generic constraint field ok") == "generic constraint field ok", "generic constraint witness field rename");
      assert(greet_gmutable(user) == "generic constraint field ok", "generic constraint witness method");
    });

    test("generic parent constraint forwarding", () {
      let item: GForwardItem = GForwardItem {};
      assert(use_glabelled<GForwardItem>(item) == "item", "generic parent constraint forwarding");
    });

    test("generic spec parent concrete inheritance", () {
      let counter: GCounter = GCounter { n: 7 };
      assert(check_gint_sequence(counter) == 7, "generic spec parent inherited member");
    });

    test("generic spec parent concrete override", () {
      let counter: GIntSequenceOverride = GOverrideCounter {};
      assert(counter.gsize_value() == 1, "generic spec parent override");
    });

    test("generic array creation", () {
      let pairs: GPair<int, int>[!] = GPair<int, int>[: (int)2];
      pairs[0].left = 10;
      pairs[0].right = 20;
      assert(pairs[0].left == 10 && pairs[0].right == 20, "generic array creation");
    });

    test("generic nested default", () {
      let holder: GNestedHolder<int> = GNestedHolder<int>();
      holder.inner.value = 11;
      assert(holder.inner.value == 11, "generic nested default");
    });

    test("generic object literal", () {
      let box: GBox<int> = GBox<int>() { value: 7 };
      assert(box.value == 7, "generic object literal");
    });

    test("generic non-self constraint MiniMap", () {
      let key = GHashKey { code: 9 };
      let same_key = GHashKey { code: 9 };
      let map: GHashMiniMap<GHashKey, string> = GHashMiniMap<GHashKey, string>();
      map.gput_hash(key, "hash constraint ok");
      assert(map.ghas_hash(same_key), "generic non-self constraint MiniMap has");
      assert(map.gget_hash(key) == "hash constraint ok", "generic non-self constraint MiniMap get");
    });

    test("overload: generic candidate excluded when constraint unsatisfied", () {
      // GUnrelatedUser 不满足 GTaggable,泛型重载必须被剔除,只剩非泛型重载可用.
      // 但 GUnrelatedUser 不接受 GTaggable 形参,所以这里用 GTaggable 视图实参
      // 间接验证:GTaggable 视图实参同时满足泛型约束与非泛型形参,
      // 此时非泛型精确(实际为 spec 视图上转,非精确)与泛型精确均匹配.
      // 预期:非泛型候选胜出.
      let user = GTaggableUser { label: "tagged" };
      let taggable: GTaggable = user;
      let which = gtag_overload(taggable);
      assert(which == "non-generic", "overload: generic candidate excluded when constraint unsatisfied");
    });

    test("overload: generic candidate selected when no non-generic fallback", () {
      // 仅泛型重载,且约束满足:必须命中泛型.
      let user = GTaggableUser { label: "tagged" };
      let which = gtag_generic_only(user);
      assert(which == "generic-only", "overload: generic candidate selected when no non-generic fallback");
    });

    test("overload: non-generic exact match preferred over generic", () {
      // GTaggableUser 同时满足 GTaggableUser 精确匹配(非泛型)与泛型重载.
      // 预期:非泛型精确匹配胜出.
      let user = GTaggableUser { label: "tagged" };
      let which = gtag_exact(user);
      assert(which == "non-generic-exact", "overload: non-generic exact match preferred over generic");
    });

    test("arity overload: same-name types with different arity used independently", () {
      // Container<T> (arity=1) and Container<T,U> (arity=2) coexist by (name, arity).
      let c1: Container<int> = Container<int>() { value: 42 };
      assert(c1.get() == 42, "arity overload: Container<int> get");
      c1.set(99);
      assert(c1.get() == 99, "arity overload: Container<int> set");

      let c2: Container<int, string> = Container<int, string>() { first: 1, second: "hello" };
      assert(c2.get_first() == 1, "arity overload: Container<int, string> get_first");
      assert(c2.get_second() == "hello", "arity overload: Container<int, string> get_second");
    });

    test("arity overload: bare constructor selects arity zero regardless of declaration order", () {
      let direct = ArityView();
      assert(direct.plain_value() == 2, "arity overload: bare constructor selects arity zero");

      let from_static = ArityView.new();
      assert(from_static.plain_value() == 2, "arity overload: bare static target selects arity zero");
    });
  });
}
