module fcts_bin;

import std.test;

/** Callable surface used to verify authorized concrete method values. */
spec FriendIntProducer(): int;

/** Object-form surface whose seal members are exposed only to FriendReader. */
spec FriendSurface {
  @friend(FriendReader)
  seal var value: int;

  @friend(FriendReader)
  seal func read(): int;

  @friend(FriendReader)
  seal static func marker(): int;

  @friend(FriendReader)
  seal static let markerValue: int;
}

/** Concrete implementation used through FriendSurface's witness view. */
type FriendSurfaceValue: FriendSurface {
  var value: int;

  func FriendSurfaceValue(value: int) {
    self.value = value;
  }

  func read(): int {
    return self.value;
  }

  static func marker(): int {
    return 17;
  }

  static let markerValue: int = 19;
}

/** Concrete owner covering instance/static fields and methods. */
type FriendVault {
  @friend(FriendReader)
  seal var value: int;

  @friend(FriendReader)
  seal static var shared: int = 10;

  func FriendVault(value: int) {
    self.value = value;
  }

  @friend(FriendReader)
  seal func read(): int {
    return self.value;
  }

  @friend(FriendReader)
  seal static func readShared(): int {
    return FriendVault.shared;
  }
}

/** Friend type exercising direct, method-value, static and spec-view access. */
type FriendReader {
  func readVault(vault: FriendVault): int {
    vault.value = vault.value + 1;
    let producer: FriendIntProducer = vault.read;
    return producer();
  }

  static func updateShared(): int {
    FriendVault.shared = FriendVault.shared + 1;
    return FriendVault.readShared();
  }

  func readSurface(surface: FriendSurface): int {
    surface.value = surface.value + 2;
    return surface.read();
  }

  static func readSurfaceMarker<T: FriendSurface>(): int {
    return T.marker() + T.markerValue;
  }

  func readFitTarget(target: FriendFitTarget): int {
    return target.fitValue();
  }

  static func readFitTargetStatic(): int {
    return FriendFitTarget.fitStaticValue();
  }
}

/** Same-package fit methods use FriendReader's exact friend identity. */
fit FriendReader {
  func readVaultFromFit(vault: FriendVault): int {
    return vault.value;
  }

  static func readVaultStaticFromFit(): int {
    return FriendVault.shared;
  }

  static func readSurfaceMarkerFromFit<T: FriendSurface>(): int {
    return T.markerValue;
  }
}

/** Target extended with fit-owned friend members. */
type FriendFitTarget {}

fit FriendFitTarget {
  @friend(FriendReader)
  seal func fitValue(): int {
    return 23;
  }

  @friend(FriendReader)
  seal static func fitStaticValue(): int {
    return 29;
  }
}

/** Generic owner used to verify exact owner-parameter substitution. */
type FriendGenericOwner<T> {
  @friend(FriendGenericReader<T>)
  seal let value: T;

  func FriendGenericOwner(value: T) {
    self.value = value;
  }
}

/** Generic friend whose active type argument must match the owner instance. */
type FriendGenericReader<T> {
  func read(owner: FriendGenericOwner<T>): T {
    return owner.value;
  }
}

/** Observable lifecycle state for friend implementation-context execution. */
type FriendImplementationState {
  /** Number of finalized friend implementation-context readers. */
  seal static var finalizedCountValue: int = 0;

  /** Sum recorded by finalized friend implementation-context readers. */
  seal static var finalizedTotalValue: int = 0;

  /** Reset the lifecycle observations before one executable test. */
  static func reset(): void {
    FriendImplementationState.finalizedCountValue = 0;
    FriendImplementationState.finalizedTotalValue = 0;
  }

  /** Record values computed through friend access in a finalizer. */
  static func record(total: int): void {
    FriendImplementationState.finalizedCountValue += 1;
    FriendImplementationState.finalizedTotalValue += total;
  }

  /** Return the number of observed finalizer executions. */
  static func finalizedCount(): int {
    return FriendImplementationState.finalizedCountValue;
  }

  /** Return the aggregate recorded by observed finalizers. */
  static func finalizedTotal(): int {
    return FriendImplementationState.finalizedTotalValue;
  }
}

/** Friend owner used by every executable type implementation context. */
type FriendImplementationVault {
  /** Instance value available only to the designated reader. */
  @friend(FriendImplementationReader)
  seal let value: int;

  /** Static value available only to the designated reader. */
  @friend(FriendImplementationReader)
  seal static let shared: int = 10;

  /** Construct one vault with a stable observable value. */
  func FriendImplementationVault(value: int) {
    self.value = value;
  }

  /** Read the instance value through a friend-only method. */
  @friend(FriendImplementationReader)
  seal func read(): int {
    return self.value;
  }

  /** Read the static value through a friend-only method. */
  @friend(FriendImplementationReader)
  seal static func readShared(): int {
    return FriendImplementationVault.shared;
  }
}

/** Exercise friend authorization in fields, construction and finalization. */
type FriendImplementationReader {
  /** Direct instance-field friend access from an instance initializer. */
  seal let initializedField: int = FriendImplementationVault(31).value;

  /** Direct static-field friend access from a static initializer. */
  seal static let initializedStaticField: int = FriendImplementationVault.shared;

  /** Instance-method friend call from an instance initializer. */
  seal let initializedCall: int = FriendImplementationVault(32).read();

  /** Static-method friend call from a static initializer. */
  seal static let initializedStaticCall: int = FriendImplementationVault.readShared();

  /** Bound friend method formed from an instance initializer. */
  seal let initializedMethod: FriendIntProducer = FriendImplementationVault(33).read;

  /** Nested lambda inheriting the instance initializer's lexical owner. */
  seal let initializedLambda: FriendIntProducer =
    () -> FriendImplementationVault(34).read();

  /** Vault retained until the finalizer executes. */
  seal let retained: FriendImplementationVault;

  /** Constructor result from direct instance and static friend accesses. */
  seal let constructedDirect: int;

  /** Constructor result from a bound friend method. */
  seal let constructedMethod: int;

  /** Constructor result from a nested lambda capturing its parameter. */
  seal let constructedLambda: int;

  /** Construct a reader while consuming its lexical owner's friend rights. */
  func FriendImplementationReader(vault: FriendImplementationVault) {
    self.retained = vault;
    self.constructedDirect = vault.value + vault.read() +
      FriendImplementationVault.shared + FriendImplementationVault.readShared();
    let method: FriendIntProducer = vault.read;
    let nested: FriendIntProducer = () -> vault.read();
    self.constructedMethod = method();
    self.constructedLambda = nested();
  }

  /** Consume the same friend rights before this reader's fields are released. */
  func ~FriendImplementationReader() {
    let method: FriendIntProducer = self.retained.read;
    // P02 is intentionally isolated: this lambda verifies lexical friend
    // authorization without exercising the deferred finalizer self-capture bug.
    let nested: FriendIntProducer = () -> FriendImplementationVault(35).read();
    FriendImplementationState.record(
      self.retained.value + self.retained.read() +
      FriendImplementationVault.shared + FriendImplementationVault.readShared() +
      method() + nested()
    );
  }

  /** Return all field-initializer and constructor observations. */
  func contextTotal(): int {
    return self.initializedField + FriendImplementationReader.initializedStaticField +
      self.initializedCall + FriendImplementationReader.initializedStaticCall +
      self.initializedMethod() + self.initializedLambda() +
      self.constructedDirect + self.constructedMethod + self.constructedLambda;
  }
}

/** Construct and release one reader so its finalizer is observable by caller. */
func exerciseFriendImplementationContexts(): int {
  let reader = FriendImplementationReader(FriendImplementationVault(40));
  return reader.contextTotal();
}

/** Verify @friend's compile-time authorization across all runtime paths. */
open func test_friend() {
  describe("friend member access", () {
    test("concrete instance, static and method-value access", () {
      let reader = FriendReader();
      let vault = FriendVault(5);
      assert(reader.readVault(vault) == 6,
             "friend instance field and bound method value");
      assert(FriendReader.updateShared() == 11,
             "friend static field and method");
      assert(reader.readVaultFromFit(vault) == 6 &&
             FriendReader.readVaultStaticFromFit() == 11,
             "same-package fit uses target friend identity");
    });

    test("object-form spec witness access", () {
      let reader = FriendReader();
      let surface: FriendSurface = FriendSurfaceValue(7);
      assert(reader.readSurface(surface) == 9,
             "friend accesses seal spec instance members through witness");
      assert(FriendReader.readSurfaceMarker<FriendSurfaceValue>() == 36 &&
             FriendReader.readSurfaceMarkerFromFit<FriendSurfaceValue>() == 19,
             "type and fit friends access seal spec static members through witness");
    });

    test("fit-owned and generic friend members", () {
      let reader = FriendReader();
      assert(reader.readFitTarget(FriendFitTarget()) == 23 &&
             FriendReader.readFitTargetStatic() == 29,
             "friend accesses fit-owned instance and static methods");
      assert(FriendGenericReader<int>().read(FriendGenericOwner<int>(31)) == 31,
             "generic friend identity follows owner substitution");
    });

    test("type implementation contexts execute friend access", () {
      FriendImplementationState.reset();
      let contextTotal = exerciseFriendImplementationContexts();
      assert(contextTotal == 330,
             "field initializers and constructor execute friend access");
      assert(FriendImplementationState.finalizedCount() == 1 &&
             FriendImplementationState.finalizedTotal() == 175,
             "finalizer executes direct, method-value and nested friend access");
    });
  });
}
