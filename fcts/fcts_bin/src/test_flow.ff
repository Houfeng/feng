module fcts_bin;

import std.io;
import fcts_lib.helper;

/** 流程控制测试 */
open func test_flow() {
  println("--- test_flow ---");

  // if/else if/else
  let x = 15;
  assert(x > 10 && x <= 20, "if/else if/else");

  // if 表达式
  let label = if x >= 18 { "adult" } else { "minor" };
  assert(label == "minor", "if expression");

  // 条件匹配 - 单值
  let age = 18;
  let result = if age {
    0 { "baby" }
    18 { "adult" }
    60 { "senior" }
    else { "other" }
  };
  assert(result == "adult", "value match - single value");

  // 条件匹配 - 值列表
  let code = 20;
  let tag = if code {
    10, 20, 30 { "tens" }
    else { "other" }
  };
  assert(tag == "tens", "value match - value list");

  // 条件匹配 - 整数闭区间
  let score = 85;
  let grade = if score {
    0...59 { "F" }
    60...69 { "D" }
    70...79 { "C" }
    80...89 { "B" }
    90...100 { "A" }
    else { "?" }
  };
  assert(grade == "B", "value match - integer range");

  // while 循环
  var sum = 0;
  var i = 1;
  while i <= 10 {
    sum += i;
    i += 1;
  }
  assert(sum == 55, "while loop");

  // for 三段式循环
  var product = 1;
  for var j = 1; j <= 5; j += 1 {
    product *= j;
  }
  assert(product == 120, "for three-part loop");

  // for/in 数组迭代
  let items = [10, 20, 30];
  var total = 0;
  for let item in items {
    total += item;
  }
  assert(total == 60, "for/in array iteration");

  // break
  var count = 0;
  for var k = 0; k < 100; k += 1 {
    if k == 5 {
      break;
    }
    count += 1;
  }
  assert(count == 5, "break");

  // continue
  var even_sum = 0;
  for var n = 0; n < 10; n += 1 {
    if n % 2 != 0 {
      continue;
    }
    even_sum += n;
  }
  assert(even_sum == 20, "continue");

  // 嵌套循环 break
  var outer_count = 0;
  for var o = 0; o < 5; o += 1 {
    for var p = 0; p < 5; p += 1 {
      if p == 2 {
        break;
      }
    }
    outer_count += 1;
  }
  assert(outer_count == 5, "nested loop break (inner only)");

  // 条件匹配 - 混合区间和单值
  let val = 100;
  let category = if val {
    0 { "zero" }
    1...9 { "single" }
    10, 20, 30 { "special" }
    100 { "hundred" }
    else { "other" }
  };
  assert(category == "hundred", "value match - mixed range and values");
}
