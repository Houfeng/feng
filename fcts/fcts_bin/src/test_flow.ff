module fcts_bin;

import std.io;
import std.test;

// 用于 if 表达式聚合返回测试
spec FlowNamed {
  func flow_name(): string;
}

type FlowUser: FlowNamed {
  let name: string;

  func flow_name(): string {
    return self.name;
  }
}

// 用于 infix match union member + binding 测试
spec FlowIntOrText: i32 | string;

// return if 表达式 (标量)
func flow_int_pick(flag: bool): i32 {
  return if flag {
    100;
  } else {
    200;
  };
}

// return if 表达式 (聚合)
func flow_pick(flag: bool, a: FlowNamed, b: FlowNamed): FlowNamed {
  return if flag {
    a;
  } else {
    b;
  };
}

// return match 值匹配 (聚合)
func flow_match_pick(tag: i32, a: FlowNamed, b: FlowNamed): FlowNamed {
  return match tag {
    0 { a }
    else { b }
  };
}

/** 流程控制测试 */
open func test_flow() {
  describe("flow", () {
    test("if/else if/else", () {
      let x = 15;
      assert(x > 10 && x <= 20, "if/else if/else");
    });

    test("if expression", () {
      let x = 15;
      let label = if x >= 18 { "adult" } else { "minor" };
      assert(label == "minor", "if expression");
    });

    test("value match - single value", () {
      let age = 18;
      let result = match age {
        0 { "baby" }
        18 { "adult" }
        60 { "senior" }
        else { "other" }
      };
      assert(result == "adult", "value match - single value");
    });

    test("value match - value list", () {
      let code = 20;
      let tag = match code {
        10, 20, 30 { "tens" }
        else { "other" }
      };
      assert(tag == "tens", "value match - value list");
    });

    test("value match - integer range", () {
      let score = 85;
      let grade = match score {
        0...59 { "F" }
        60...69 { "D" }
        70...79 { "C" }
        80...89 { "B" }
        90...100 { "A" }
        else { "?" }
      };
      assert(grade == "B", "value match - integer range");
    });

    test("while loop", () {
      var sum = 0;
      var i = 1;
      while i <= 10 {
        sum += i;
        i += 1;
      }
      assert(sum == 55, "while loop");
    });

    test("for three-part loop", () {
      var product = 1;
      for var j = 1; j <= 5; j += 1 {
        product *= j;
      }
      assert(product == 120, "for three-part loop");
    });

    test("for/in array iteration", () {
      let items = [10, 20, 30];
      var total = 0;
      for let item in items {
        total += item;
      }
      assert(total == 60, "for/in array iteration");
    });

    test("break", () {
      var count = 0;
      for var k = 0; k < 100; k += 1 {
        if k == 5 {
          break;
        }
        count += 1;
      }
      assert(count == 5, "break");
    });

    test("continue", () {
      var even_sum = 0;
      for var n = 0; n < 10; n += 1 {
        if n % 2 != 0 {
          continue;
        }
        even_sum += n;
      }
      assert(even_sum == 20, "continue");
    });

    test("nested loop break (inner only)", () {
      var outer_count = 0;
      for var o = 0; o < 5; o += 1 {
        for var p = 0; p < 5; p += 1 {
          if p == 2 {
            break;
          }
        }
        outer_count += 1;
      }
      assert(outer_count == 5, "nested loop break (inner only)");
    });

    test("value match - mixed range and values", () {
      let val = 100;
      let category = match val {
        0 { "zero" }
        1...9 { "single" }
        10, 20, 30 { "special" }
        100 { "hundred" }
        else { "other" }
      };
      assert(category == "hundred", "value match - mixed range and values");
    });

    test("value match - string", () {
      let word = "hello";
      let translated = match word {
        "hi", "hello" { "greeting" }
        "bye", "goodbye" { "farewell" }
        else { "unknown" }
      };
      assert(translated == "greeting", "value match - string");
    });

    test("value match - string (second branch)", () {
      let word2 = "bye";
      let translated2 = match word2 {
        "hi", "hello" { "greeting" }
        "bye", "goodbye" { "farewell" }
        else { "unknown" }
      };
      assert(translated2 == "farewell", "value match - string (second branch)");
    });

    test("for/in continue", () {
      let nums = [1, 2, 3];
      var forin_sum = 0;
      for let n in nums {
        if n == 2 {
          continue;
        }
        forin_sum += n;
      }
      assert(forin_sum == 4, "for/in continue");
    });

    test("empty for loop (infinite + break)", () {
      var empty_for_count = 0;
      for ;; {
        if empty_for_count == 3 {
          break;
        }
        empty_for_count += 1;
      }
      assert(empty_for_count == 3, "empty for loop (infinite + break)");
    });

    test("return if expression (scalar)", () {
      assert(flow_int_pick(true) == 100 && flow_int_pick(false) == 200, "return if expression (scalar)");
    });

    test("if expression returns aggregate", () {
      let left: FlowNamed = FlowUser { name: "left" };
      let right: FlowNamed = FlowUser { name: "right" };
      let picked = flow_pick(true, left, right);
      assert(picked.flow_name() == "left", "if expression returns aggregate (true)");
      let picked2 = flow_pick(false, left, right);
      assert(picked2.flow_name() == "right", "if expression returns aggregate (false)");
    });

    test("value match returns aggregate", () {
      let left: FlowNamed = FlowUser { name: "left" };
      let right: FlowNamed = FlowUser { name: "right" };
      let match_picked = flow_match_pick(0, left, right);
      assert(match_picked.flow_name() == "left", "value match returns aggregate");
    });

    test("infix match - simple value", () {
      let x = 5;
      assert(x match 5, "infix match - simple value (true)");
      assert(!(x match 6), "infix match - simple value (false)");
    });

    test("infix match - integer range", () {
      let x = 5;
      assert(x match 1...10, "infix match - integer range (true)");
      assert(!(x match 11...20), "infix match - integer range (false)");
    });

    test("infix match - multi-label pipe", () {
      let x = 7;
      assert(x match 1 | 3 | 5 | 7, "infix match - multi-label (true)");
      assert(!(x match 2 | 4 | 6), "infix match - multi-label (false)");
    });

    test("infix match - string", () {
      let s = "hi";
      assert(s match "hi" | "hello", "infix match - string (true)");
      assert(!(s match "bye"), "infix match - string (false)");
    });

    test("infix match - mixed value and range", () {
      let x = 100;
      assert(x match 0 | 1...9 | 100, "infix match - mixed (true)");
      assert(!(x match 1 | 2 | 3), "infix match - mixed (false)");
    });

    test("infix match - in if condition", () {
      let x = 5;
      if x match 5 {
        assert(true, "infix match - if condition");
      } else {
        assert(false, "infix match - if condition (should be true)");
      }
    });

    test("infix match - in if condition with &&", () {
      let x = 5;
      if x match 5 && x > 0 {
        assert(true, "infix match - if condition with &&");
      } else {
        assert(false, "infix match - if condition with && (should be true)");
      }
    });

    test("infix match - union member type (int)", () {
      let v: FlowIntOrText = 42;
      assert(v match i32, "infix match - union member type (int)");
    });

    test("infix match - union member type (string)", () {
      let s: FlowIntOrText = "hello";
      assert(s match string, "infix match - union member type (string)");
    });

    test("infix match - union member type (false)", () {
      let v: FlowIntOrText = 42;
      assert(!(v match string), "infix match - union member type (false)");
    });

    test("infix match - union member type + binding", () {
      let v: FlowIntOrText = 42;
      if v match n: i32 && n > 0 {
        assert(true, "infix match - binding in &&");
      } else {
        assert(false, "infix match - binding in && (should be true)");
      }
    });

    test("infix match - union member type + binding (string)", () {
      let v: FlowIntOrText = "hi";
      if v match s: string && s == "hi" {
        assert(true, "infix match - binding string in &&");
      } else {
        assert(false, "infix match - binding string in && (should be true)");
      }
    });

    test("infix match - union member type + binding (mismatch)", () {
      let v: FlowIntOrText = 42;
      if v match n: i32 && n > 100 {
        assert(false, "infix match - binding mismatch (should not enter)");
      } else {
        assert(true, "infix match - binding mismatch (else path)");
      }
    });

    test("infix match - union multi-label type", () {
      let v: FlowIntOrText = 42;
      assert(v match i32 | string, "infix match - union multi-label (int)");
      let s: FlowIntOrText = "hi";
      assert(s match i32 | string, "infix match - union multi-label (string)");
    });

    test("infix match - while condition with binding", () {
      let v: FlowIntOrText = 42;
      var executed = false;
      while v match n: i32 && n > 0 {
        executed = true;
        break;
      }
      assert(executed, "infix match - while condition with binding");
    });

    test("infix match - while loop counts down", () {
      var counter: FlowIntOrText = 3;
      var sum = 0;
      while counter match n: i32 && n > 0 {
        sum += n;
        counter = n - 1;
      }
      assert(sum == 6, "infix match - while loop counts down");
    });

    test("infix match - binding not visible after statement", () {
      let v: FlowIntOrText = 42;
      if v match n: i32 {
        assert(n == 42, "infix match - binding visible in body");
      }
      // n is not visible here (semantic error if referenced)
    });

    test("infix match - unary not over multi-label value", () {
      let x = 4;
      // Without correct precedence, `!x match 1 | 2 | 3` would parse as
      // `(!x) match ...` and never enter the branch. The fix wraps the
      // match expression atomically, so this asserts the logical-not
      // applies to the whole match result.
      assert(!(x match 1 | 2 | 3), "infix match - unary not over multi-label (false)");
      let y = 2;
      assert(!(y match 1 | 2 | 3) == false, "infix match - unary not over multi-label (true)");
    });

    test("infix match - unary not over range", () {
      let x = 50;
      assert(!(x match 1...10), "infix match - unary not over range (false)");
      let y = 5;
      assert(!(y match 1...10) == false, "infix match - unary not over range (true)");
    });

    test("infix match - unary not in if condition", () {
      let x = 7;
      if !(x match 1 | 2 | 3) {
        assert(true, "infix match - unary not in if condition");
      } else {
        assert(false, "infix match - unary not in if condition (should be true)");
      }
    });

    test("infix match - nested conjunction of match expressions", () {
      let x = 5;
      // Both subexpressions must evaluate as booleans; the conjunction
      // verifies the match operator yields bool under parentheses.
      if (x match 5) && (x match 1...10) {
        assert(true, "infix match - nested conjunction");
      } else {
        assert(false, "infix match - nested conjunction (should be true)");
      }
    });

    test("infix match - disjunction without binding", () {
      let v: FlowIntOrText = 42;
      // `||` does not propagate match bindings; using the union member
      // type form (no binding) keeps the condition well-formed.
      if (v match i32) || (v match string) {
        assert(true, "infix match - disjunction without binding");
      } else {
        assert(false, "infix match - disjunction without binding (should be true)");
      }
    });
  });
}
