module fcts_bin;

import std.io;
import fcts_lib.helper;

// 顶层函数
func add(a: int, b: int): int {
  return a + b;
}

// 有返回值的函数
func multiply(a: int, b: int): int {
  return a * b;
}

// void 省略
func do_nothing() {
}

// 显式 void
func do_nothing2(): void {
}

// 参数 var
func increment(var x: int): int {
  x += 1;
  return x;
}

// 参数 let (显式)
func readonly_param(let x: int): int {
  return x + 1;
}

// 函数重载 - 不同参数类型
func describe(x: int): string {
  return "int";
}

func describe(x: string): string {
  return "string";
}

// 函数重载 - 不同参数数量
func sum_nums(a: int): int {
  return a;
}

func sum_nums(a: int, b: int): int {
  return a + b;
}

func sum_nums(a: int, b: int, c: int): int {
  return a + b + c;
}

/** 函数测试 */
open func test_function() {
  println("--- test_function ---");

  // 顶层函数调用
  assert(add(3, 4) == 7, "top-level function");

  // 有返回值的函数
  assert(multiply(3, 4) == 12, "function with return value");

  // void 函数
  do_nothing();
  do_nothing2();
  assert(true, "void function");

  // var 参数
  assert(increment(10) == 11, "var parameter");

  // let 参数
  assert(readonly_param(10) == 11, "explicit let parameter");

  // 函数重载 - 类型
  assert(describe(42) == "int" && describe("hi") == "string", "function overload by type");

  // 函数重载 - 参数数量
  assert(sum_nums(1) == 1 && sum_nums(1, 2) == 3 && sum_nums(1, 2, 3) == 6, "function overload by arity");
}
