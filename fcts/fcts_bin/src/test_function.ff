module fcts_bin;

import std.io;
import std.test;

// 顶层函数
func add(a: i32, b: i32): i32 {
  return a + b;
}

// 有返回值的函数
func multiply(a: i32, b: i32): i32 {
  return a * b;
}

// void 省略
func do_nothing() {
}

// 显式 void
func do_nothing2(): void {
}

// 参数 var
func increment(var x: i32): i32 {
  x += 1;
  return x;
}

// 参数 let (显式)
func readonly_param(let x: i32): i32 {
  return x + 1;
}

// 函数重载 - 不同参数类型
func type_of(x: i32): string {
  return "int";
}

func type_of(x: string): string {
  return "string";
}

// 函数重载 - 不同参数数量
func sum_nums(a: i32): i32 {
  return a;
}

func sum_nums(a: i32, b: i32): i32 {
  return a + b;
}

func sum_nums(a: i32, b: i32, c: i32): i32 {
  return a + b + c;
}

// 方法重载
type OverloadObj {
  let name: string;

  func olabel(n: i32): string {
    return "int";
  }

  func olabel(s: string): string {
    return s;
  }

  func olabel(): string {
    return self.name;
  }
}

/** 函数测试 */
open func test_function() {
  describe("function", () {
    test("top-level function", () {
      assert(add(3, 4) == 7, "top-level function");
    });

    test("function with return value", () {
      assert(multiply(3, 4) == 12, "function with return value");
    });

    test("void function", () {
      do_nothing();
      do_nothing2();
      assert(true, "void function");
    });

    test("var parameter", () {
      assert(increment(10) == 11, "var parameter");
    });

    test("explicit let parameter", () {
      assert(readonly_param(10) == 11, "explicit let parameter");
    });

    test("function overload by type", () {
      assert(type_of(42) == "int" && type_of("hi") == "string", "function overload by type");
    });

    test("function overload by arity", () {
      assert(sum_nums(1) == 1 && sum_nums(1, 2) == 3 && sum_nums(1, 2, 3) == 6, "function overload by arity");
    });

    test("method overload", () {
      let obj = OverloadObj { name: "feng" };
      assert(obj.olabel(7) == "int", "method overload by type (int)");
      assert(obj.olabel("hello") == "hello", "method overload by type (string)");
      assert(obj.olabel() == "feng", "method overload by arity (no args)");
    });
  });
}
