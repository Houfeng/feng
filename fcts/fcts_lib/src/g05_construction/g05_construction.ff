open module fcts_lib.g05_construction;

/** Cross-package construction probe for CTOR06. */
open type G05ImportedConstruction {
  /** Trace of the most recent imported construction. */
  seal static var traceValue: int = 0;

  /** Number of observable imported construction steps. */
  seal static var callCountValue: int = 0;

  /** Value established by the declaration initializer. */
  open var declarationValue: int = G05ImportedConstruction.recordValue(10, 1);

  /** Value established by the constructor. */
  open var constructorValue: int;

  /** Value established by the consumer's object literal. */
  open var literalValue: int;

  /** Construct an imported probe and record the constructor phase. */
  open func G05ImportedConstruction() {
    self.constructorValue = G05ImportedConstruction.recordValue(20, 2);
  }

  /** Reset the imported construction trace before one assertion. */
  open static func reset(): void {
    G05ImportedConstruction.traceValue = 0;
    G05ImportedConstruction.callCountValue = 0;
  }

  /** Record the consumer-side object-literal value evaluation. */
  open static func markLiteral(value: int): int {
    return G05ImportedConstruction.recordValue(value, 3);
  }

  /** Return the current imported construction trace. */
  open static func trace(): int {
    return G05ImportedConstruction.traceValue;
  }

  /** Return the current imported construction call count. */
  open static func calls(): int {
    return G05ImportedConstruction.callCountValue;
  }

  /** Append one marker and return the supplied field value. */
  seal static func recordValue(value: int, marker: int): int {
    G05ImportedConstruction.traceValue =
      G05ImportedConstruction.traceValue * 10 + marker;
    G05ImportedConstruction.callCountValue += 1;
    return value;
  }
}

/** Imported probe finalized by member declaration initialization. */
open type G05ImportedDeclarationBoundLet {
  /** Immutable value finalized in the provider's first construction phase. */
  open let value: int = 101;
}

/** Imported probe finalized by its selected constructor. */
open type G05ImportedConstructorBoundLet {
  /** Immutable value left unbound until the constructor phase. */
  open let value: int;

  /** Finalize the immutable value in provider code. */
  open func G05ImportedConstructorBoundLet(value: int) {
    self.value = value;
  }
}

/** Imported probe finalized by the consumer's object literal. */
open type G05ImportedLiteralBoundLet {
  /** Immutable value exported as unbound for consumer initialization. */
  open let value: int;
}

/** Imported probe left explicitly unbound through all construction phases. */
open type G05ImportedDefaultUnboundLet {
  /** Immutable value that retains its default zero value. */
  open let value: int;
}

/** Imported probe with no explicit constructor and therefore a public default constructor. */
open type G05ImportedImplicitDefaultConstructor {
  /** Mutable value used by every supported default-construction spelling. */
  open var value: int;
}

/** Imported probe exposing public no-argument and one-argument constructors. */
open type G05ImportedPublicConstructorSurface {
  /** Number of selected constructor bodies executed since reset. */
  seal static var callCountValue: int = 0;

  /** Value established by the selected constructor or consumer literal. */
  open var value: int;

  /** Execute the public no-argument constructor. */
  open func G05ImportedPublicConstructorSurface() {
    G05ImportedPublicConstructorSurface.callCountValue += 1;
    self.value = 410;
  }

  /** Execute the public one-argument constructor. */
  open func G05ImportedPublicConstructorSurface(value: int) {
    G05ImportedPublicConstructorSurface.callCountValue += 1;
    self.value = value;
  }

  /** Reset the constructor execution count. */
  open static func resetCalls(): void {
    G05ImportedPublicConstructorSurface.callCountValue = 0;
  }

  /** Return the constructor execution count. */
  open static func calls(): int {
    return G05ImportedPublicConstructorSurface.callCountValue;
  }
}

/** Imported probe whose construction is available only inside its owning type. */
open type G05ImportedSealedOwnerConstruction {
  /** Value established by an owner-authorized sealed constructor. */
  open var value: int;

  /** Private no-argument constructor retained in package metadata. */
  seal func G05ImportedSealedOwnerConstruction() {
    self.value = 510;
  }

  /** Private one-argument constructor retained in package metadata. */
  seal func G05ImportedSealedOwnerConstruction(value: int) {
    self.value = value;
  }

  /** Construct an instance through the owning type's static context. */
  open static func create(value: int): G05ImportedSealedOwnerConstruction {
    return G05ImportedSealedOwnerConstruction(value);
  }

  /** Construct a copy through the owning type's instance context. */
  open func copy(): G05ImportedSealedOwnerConstruction {
    return G05ImportedSealedOwnerConstruction(self.value);
  }
}
