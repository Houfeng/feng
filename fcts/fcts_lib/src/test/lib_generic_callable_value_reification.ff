open module fcts_lib.test;

import std;
import std.collections;

/** Produces one closed generic value. */
open spec LibCallableProducer<T>(): T;

/** Maps one closed generic value to another value of the same type. */
open spec LibCallableMapper<T>(value: T): T;

/** Object-form payload used as a consumer-only generic argument. */
open spec LibCallableNamed {
  /** Return the payload's observable label. */
  func label(): string;
}

/** Identity implementation used by closed top-level callable values. */
open func libCallableIdentity<T>(value: T): T {
  return value;
}

/** Form an explicitly closed top-level generic function value. */
open func libCallableTopMapper<T>(): LibCallableMapper<T> {
  return libCallableIdentity<T>;
}

/** Form the same top-level value through an explicit callable conversion. */
open func libCallableTopMapperCast<T>(): LibCallableMapper<T> {
  return (LibCallableMapper<T>)libCallableIdentity<T>;
}

/** Form an escaping lambda in an imported top-level generic shared body. */
open func libCallableLambda<T>(value: T): LibCallableProducer<T> {
  return () -> value;
}

/** Forward an already formed callable through the generic callable ABI. */
open func libCallableForward<T>(
  producer: LibCallableProducer<T>
): LibCallableProducer<T> {
  return producer;
}

/** Reference receiver whose final T is selected by the consumer. */
open type LibCallableReader<T> {
  /** Mutable payload observed through bound reference-method values. */
  open var value: T;

  /** Construct one reference receiver. */
  func LibCallableReader(value: T) {
    self.value = value;
  }

  /** Read the current receiver payload. */
  open func read(): T {
    return self.value;
  }

  /** Form a bound self method in a generic-owner shared body. */
  open func reader(): LibCallableProducer<T> {
    return self.read;
  }

  /** Form a bound self method through an explicit callable conversion. */
  open func readerCast(): LibCallableProducer<T> {
    return (LibCallableProducer<T>)self.read;
  }

  /** Form a closed top-level function in a generic-owner shared body. */
  open func mapper(): LibCallableMapper<T> {
    return libCallableIdentity<T>;
  }

  /** Form an escaping lambda in a generic-owner shared body. */
  open func lambdaReader(): LibCallableProducer<T> {
    return () -> self.value;
  }

  /** Keep owner T and method U in distinct descriptor domains. */
  open func methodMapper<U>(): LibCallableMapper<U> {
    return libCallableIdentity<U>;
  }

  /** Capture method U in a lambda while owner T remains active. */
  open func methodLambda<U>(value: U): LibCallableProducer<U> {
    return () -> value;
  }
}

/** Form a reference-receiver method in a top-level generic shared body. */
open func libCallableBindReference<T>(
  reader: LibCallableReader<T>
): LibCallableProducer<T> {
  return reader.read;
}

/** Value receiver whose final layout is selected by the consumer. */
@value
open type LibCallableValueReader<T> {
  /** Payload copied into bound value-method closures. */
  open var value: T;

  /** Read the copied receiver payload. */
  open func read(): T {
    return self.value;
  }

  /** Form a bound self method in a generic value-owner shared body. */
  open func reader(): LibCallableProducer<T> {
    return self.read;
  }
}

/** Form a value-receiver method in a top-level generic shared body. */
open func libCallableBindValue<T>(
  reader: LibCallableValueReader<T>
): LibCallableProducer<T> {
  return reader.read;
}

/** Generic tuple used to verify fit method values with descriptor-sized T. */
open type LibCallableTuple<T>(T, string);

/** Supply a fit-body method for the generic tuple receiver. */
open fit LibCallableTuple<T> {
  /** Return the tuple's generic field. */
  open func first(): T {
    return self.item1;
  }
}

/** Form a tuple fit method in an imported top-level generic shared body. */
open func libCallableBindTuple<T>(
  value: LibCallableTuple<T>
): LibCallableProducer<T> {
  return value.first;
}

/** Non-generic owner used to close an explicitly generic instance method. */
open type LibCallableMethodSource {
  /** Construct one method source. */
  func LibCallableMethodSource() {}

  /** Generic instance identity method. */
  open func identity<T>(value: T): T {
    return value;
  }

  /** Form an explicitly closed generic instance method value. */
  open func mapper<T>(): LibCallableMapper<T> {
    return self.identity<T>;
  }

  /** Form the same method value through an explicit callable conversion. */
  open func mapperCast<T>(): LibCallableMapper<T> {
    return (LibCallableMapper<T>)self.identity<T>;
  }
}

/** Generic static owner returning a closed top-level callable value. */
open type LibCallableStaticFactory<T> {
  /** Form the owner-T top-level callable without allocating a closure. */
  open static func mapper(): LibCallableMapper<T> {
    return libCallableIdentity<T>;
  }
}

/** Alternate callable surface with the same closed ABI as LibCallableMapper. */
open spec LibCallableMapperAlt<T>(value: T): T;

/** Stores two callable surfaces formed from one source declaration. */
@value
open type LibCallableSurfacePair<T> {
  /** Primary callable surface. */
  open let primary: LibCallableMapper<T>;

  /** Alternate callable surface. */
  open let alternate: LibCallableMapperAlt<T>;

  /** Construct one pair of independently typed callable surfaces. */
  func LibCallableSurfacePair(
    primary: LibCallableMapper<T>,
    alternate: LibCallableMapperAlt<T>
  ) {
    self.primary = primary;
    self.alternate = alternate;
  }
}

/** Aggregate used by a callable target's own reified dependency graph. */
@value
open type LibCallableNestedBox<T> {
  /** Closed generic payload. */
  open let value: T;

  /** Construct one nested payload. */
  func LibCallableNestedBox(value: T) {
    self.value = value;
  }
}

/** Use both managed-type and aggregate dependencies inside a target callable. */
open func libCallableNestedLeaf<T>(value: T): T {
  let values = List<T>();
  values.add(value);
  let box = LibCallableNestedBox<T>(values.get(0));
  return box.value;
}

/** Form another generic callable value inside the target callable body. */
open func libCallableNested<T>(value: T): T {
  let mapper: LibCallableMapper<T> = libCallableNestedLeaf<T>;
  return mapper(value);
}

/** Return a target whose descriptor has recursive callable dependencies. */
open func libCallableNestedMapper<T>(): LibCallableMapper<T> {
  return libCallableNested<T>;
}

/** Form the same target declaration through two callable-form surfaces. */
open func libCallableSurfaces<T>(): LibCallableSurfacePair<T> {
  let primary: LibCallableMapper<T> = libCallableNested<T>;
  let alternate: LibCallableMapperAlt<T> = libCallableNested<T>;
  return LibCallableSurfacePair<T>(primary, alternate);
}

/** Pair whose layout depends independently on owner T and method U. */
@value
open type LibCallablePair<T, U> {
  /** Owner-generic value. */
  open let owner: T;

  /** Method-generic value. */
  open let method: U;

  /** Construct one two-domain result. */
  func LibCallablePair(owner: T, method: U) {
    self.owner = owner;
    self.method = method;
  }
}

/** Maps method U into a result that also contains owner T. */
open spec LibCallablePairMapper<T, U>(value: U): LibCallablePair<T, U>;

/** Descriptor-sized receiver combining owner and method generic domains. */
@value
open type LibCallablePairOwner<T> {
  /** Owner-generic captured value. */
  open let owner: T;

  /** Construct one pair owner. */
  func LibCallablePairOwner(owner: T) {
    self.owner = owner;
  }

  /** Build a result whose ABI depends on both T and U. */
  open func pair<U>(value: U): LibCallablePair<T, U> {
    return LibCallablePair<T, U>(self.owner, value);
  }

  /** Form an explicitly closed generic method from a value receiver. */
  open func mapper<U>(): LibCallablePairMapper<T, U> {
    return self.pair<U>;
  }
}

/** Tuple receiver used by the explicitly generic fit-method path. */
open type LibCallableGenericFitOwner<T>(T, string);

/** Supply a generic fit method whose U is selected when its value forms. */
open fit LibCallableGenericFitOwner<T> {
  /** Return the method-generic argument after observing the captured receiver. */
  open func echo<U>(value: U): U {
    self.item2;
    return value;
  }
}

/** Form an explicitly generic fit method in an imported shared body. */
open func libCallableBindGenericFit<T, U>(
  owner: LibCallableGenericFitOwner<T>
): LibCallableMapper<U> {
  return owner.echo<U>;
}

/** Concrete tuple receiver used to isolate a fit method's own U domain. */
open type LibCallableConcreteFitOwner(i64, string);

/** Supply a generic fit method without an owner-generic domain. */
open fit LibCallableConcreteFitOwner {
  /** Return the method-generic argument after observing the receiver. */
  open func echo<U>(value: U): U {
    self.item1;
    return value;
  }
}

/** Form a generic fit method whose receiver type itself is not generic. */
open func libCallableBindConcreteFit<U>(
  owner: LibCallableConcreteFitOwner
): LibCallableMapper<U> {
  return owner.echo<U>;
}

/** Explicitly convert an unbound lambda through an open callable target. */
open func libCallableLambdaCast<T>(value: T): LibCallableProducer<T> {
  return (LibCallableProducer<T>)(() -> value);
}
