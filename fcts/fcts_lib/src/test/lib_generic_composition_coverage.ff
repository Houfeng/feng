open module fcts_lib.test;

import std;
import std.collections;

/** Reference leaf used by the heterogeneous generic composition tests. */
open type LibCompositionLeaf<T> {
  /** Generic payload. */
  open let payload: T;

  /** Managed field following the generic payload. */
  open let label: string;

  /** Scalar field following the managed field. */
  open let code: i64;

  /** Construct a populated leaf. */
  func LibCompositionLeaf(payload: T, label: string, code: i64) {
    self.payload = payload;
    self.label = label;
    self.code = code;
  }
}

/** Tuple layer combining a generic reference family and a direct generic slot. */
open type LibCompositionPair<T>(LibCompositionLeaf<T>, T);

/** Value layer whose concrete layout depends transitively on T. */
@value
open type LibCompositionValue<T> {
  /** Nested generic tuple. */
  open var pair: LibCompositionPair<T>;

  /** Managed field after the nested tuple. */
  open var marker: string;

  /** Scalar tail used to verify the complete concrete layout. */
  open var revision: i64;

  /** Construct a populated value layer. */
  func LibCompositionValue(
    pair: LibCompositionPair<T>,
    marker: string,
    revision: i64
  ) {
    self.pair = pair;
    self.marker = marker;
    self.revision = revision;
  }
}

/** Reference layer storing the descriptor-sized value and its leaf. */
open type LibCompositionEnvelope<T> {
  /** Stored heterogeneous value. */
  open var value: LibCompositionValue<T>;

  /** Independently stored reference leaf. */
  open var leaf: LibCompositionLeaf<T>;

  /** Construct a populated envelope. */
  func LibCompositionEnvelope(
    value: LibCompositionValue<T>,
    leaf: LibCompositionLeaf<T>
  ) {
    self.value = value;
    self.leaf = leaf;
  }

  /** Store and return a value through the generic member-function body. */
  open func replaceValue(
    next: LibCompositionValue<T>
  ): LibCompositionValue<T> {
    self.value = next;
    return self.value;
  }
}

/** Return an heterogeneous value through a generic top-level function body. */
open func libCompositionRoundTrip<T>(
  value: LibCompositionValue<T>
): LibCompositionValue<T> {
  return value;
}

/** Invoke a callable with the complete heterogeneous generic value. */
open type LibCompositionCallableFlow<T> {
  /** Construct an empty flow object. */
  func LibCompositionCallableFlow() {
  }

  /** Pass the value through a generic callable parameter and return path. */
  open func map(
    callback: Func<LibCompositionValue<T>, LibCompositionValue<T> >,
    value: LibCompositionValue<T>
  ): LibCompositionValue<T> {
    return callback(value);
  }
}

/** Parent object-form contract carried by the composite spec packet. */
open spec LibCompositionReadable<T> {
  /** Return the generic payload. */
  func read(): T;
}

/** Child object-form contract used at the packet construction boundary. */
open spec LibCompositionDetailed<T>: LibCompositionReadable<T> {
  /** Return the subject detail. */
  func detail(): string;
}

/** Independent contract combined with the child contract by an intersection. */
open spec LibCompositionRevisioned {
  /** Return the subject revision. */
  func specRevision(): i64;
}

/** Generic named intersection used as a callable constraint. */
open spec LibCompositionComplete<T>:
  LibCompositionDetailed<T> & LibCompositionRevisioned;

/** Concrete subject satisfying every contract in the named intersection. */
open type LibCompositionSpecSubject<T>:
  LibCompositionDetailed<T>, LibCompositionRevisioned {
  /** Generic payload returned through the parent contract. */
  open let payload: T;

  /** Managed detail returned through the child contract. */
  open let label: string;

  /** Scalar revision returned through the independent contract. */
  open let version: i64;

  /** Construct a fully populated subject. */
  func LibCompositionSpecSubject(payload: T, label: string, version: i64) {
    self.payload = payload;
    self.label = label;
    self.version = version;
  }

  /** Implement the generic parent contract. */
  func read(): T {
    return self.payload;
  }

  /** Implement the generic child contract. */
  func detail(): string {
    return self.label;
  }

  /** Implement the independent intersection member contract. */
  func specRevision(): i64 {
    return self.version;
  }
}

/** Value packet combining an object-spec value and the heterogeneous payload. */
@value
open type LibCompositionSpecPacket<T> {
  /** Parent-spec view stored after a child-to-parent conversion. */
  open var subject: LibCompositionReadable<T>;

  /** Heterogeneous generic payload transported with the witness value. */
  open var value: LibCompositionValue<T>;

  /** Detail captured through the child-spec view. */
  open var detail: string;

  /** Construct a populated packet. */
  func LibCompositionSpecPacket(
    subject: LibCompositionReadable<T>,
    value: LibCompositionValue<T>,
    detail: string
  ) {
    self.subject = subject;
    self.value = value;
    self.detail = detail;
  }
}

/** Callable-form contract transporting the complete spec packet. */
open spec LibCompositionPacketMapper<T>(
  packet: LibCompositionSpecPacket<T>
): LibCompositionSpecPacket<T>;

/** Build a packet while projecting the generic child contract to its parent. */
open func libCompositionBuildSpecPacket<T>(
  subject: LibCompositionDetailed<T>,
  value: LibCompositionValue<T>
): LibCompositionSpecPacket<T> {
  return LibCompositionSpecPacket<T>(subject, value, subject.detail());
}

/** Invoke both members of a named generic intersection constraint. */
open func libCompositionCheckComplete<
  T,
  U: LibCompositionComplete<T>
>(subject: U, payload: T): i64 {
  let detail = subject.detail();
  if detail == "" {
    return 0;
  }
  return subject.specRevision();
}

/** Pass a packet through the generic callable-form contract. */
open func libCompositionMapSpecPacket<T>(
  mapper: LibCompositionPacketMapper<T>,
  packet: LibCompositionSpecPacket<T>
): LibCompositionSpecPacket<T> {
  return mapper(packet);
}

/** Non-cyclic state copied from a left endpoint. */
open type LibCompositionMutualLeftState<T> {
  /** Copied left payload. */
  open let payload: T;

  /** Construct a left state value. */
  func LibCompositionMutualLeftState(payload: T) {
    self.payload = payload;
  }
}

/** Non-cyclic state copied from a right endpoint. */
open type LibCompositionMutualRightState<T> {
  /** Copied right payload. */
  open let payload: T;

  /** Construct a right state value. */
  func LibCompositionMutualRightState(payload: T) {
    self.payload = payload;
  }
}

/** Left endpoint in a mutually related generic object graph. */
open type LibCompositionMutualLeft<T> {
  /** Payload owned by the left endpoint. */
  open let payload: T;

  /** Right endpoints connected through an empty-default array boundary. */
  open var rights: LibCompositionMutualRight<T>[] = [];

  /** Non-cyclic state copied from each connected right endpoint. */
  open let rightStates = List<LibCompositionMutualRightState<T> >();

  /** Construct an unconnected left endpoint. */
  func LibCompositionMutualLeft(payload: T) {
    self.payload = payload;
  }

  /** Store and return a right endpoint through the shared generic body. */
  open func connectRight(
    right: LibCompositionMutualRight<T>
  ): LibCompositionMutualRight<T> {
    self.rights = [right];
    self.rightStates.add(
      LibCompositionMutualRightState<T>(right.payload)
    );
    return self.rights[0];
  }

  /** Return a stored right endpoint. */
  open func rightAt(index: int): LibCompositionMutualRight<T> {
    return self.rights[index];
  }

  /** Return the copied state for a stored right endpoint. */
  open func rightStateAt(index: int): LibCompositionMutualRightState<T> {
    return self.rightStates.get(index);
  }

  /** Remove all right links so the behavior test does not retain a cycle. */
  open func clearRights() {
    self.rights = [];
    self.rightStates.clear();
  }
}

/** Right endpoint in a mutually related generic object graph. */
open type LibCompositionMutualRight<T> {
  /** Payload owned by the right endpoint. */
  open let payload: T;

  /** Left endpoints connected through an empty-default array boundary. */
  open var lefts: LibCompositionMutualLeft<T>[] = [];

  /** Non-cyclic state copied from each connected left endpoint. */
  open let leftStates = List<LibCompositionMutualLeftState<T> >();

  /** Construct an unconnected right endpoint. */
  func LibCompositionMutualRight(payload: T) {
    self.payload = payload;
  }

  /** Store and return a left endpoint through the shared generic body. */
  open func connectLeft(
    left: LibCompositionMutualLeft<T>
  ): LibCompositionMutualLeft<T> {
    self.lefts = [left];
    self.leftStates.add(
      LibCompositionMutualLeftState<T>(left.payload)
    );
    return self.lefts[0];
  }

  /** Return a stored left endpoint. */
  open func leftAt(index: int): LibCompositionMutualLeft<T> {
    return self.lefts[index];
  }

  /** Return the copied state for a stored left endpoint. */
  open func leftStateAt(index: int): LibCompositionMutualLeftState<T> {
    return self.leftStates.get(index);
  }

  /** Remove all left links so the behavior test does not retain a cycle. */
  open func clearLefts() {
    self.lefts = [];
    self.leftStates.clear();
  }
}

/** Tuple containing both endpoints and the payload carried across their edge. */
open type LibCompositionMutualPair<T>(
  LibCompositionMutualLeft<T>[],
  LibCompositionMutualRight<T>[],
  T
);

/** Value snapshot embedding the tuple formed by the mutually related types. */
@value
open type LibCompositionMutualSnapshot<T> {
  /** Both graph endpoints and their generic edge payload. */
  open var pair: LibCompositionMutualPair<T>;

  /** Managed value following the generic tuple. */
  open var marker: string;

  /** Scalar tail used to verify the complete value layout. */
  open var revision: i64;

  /** Construct a populated graph snapshot. */
  func LibCompositionMutualSnapshot(
    pair: LibCompositionMutualPair<T>,
    marker: string,
    revision: i64
  ) {
    self.pair = pair;
    self.marker = marker;
    self.revision = revision;
  }
}

/** Build and return a value snapshot from both sides of the generic graph. */
open func libCompositionBuildMutualSnapshot<T>(
  left: LibCompositionMutualLeft<T>,
  right: LibCompositionMutualRight<T>,
  payload: T,
  marker: string,
  revision: i64
): LibCompositionMutualSnapshot<T> {
  let lefts: LibCompositionMutualLeft<T>[] = [left];
  let rights: LibCompositionMutualRight<T>[] = [right];
  let pair: LibCompositionMutualPair<T> = (lefts, rights, payload);
  return LibCompositionMutualSnapshot<T>(pair, marker, revision);
}
