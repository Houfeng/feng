open module fcts_lib.test;

import std;

open type LibGenericDisplayPayload: Display {
  let value: i32;
  func toString(): string {
    return "lib-generic-display-payload";
  }
}

open type LibGenericInner<T1, T2: Display> {
  let name: string;
  let payload1: T1;
  let payload2: T2;
  let value: i32;
  func getPayload1(): T1 {
    return self.payload1;
  }
  func getPayload2(): T2 {
    return self.payload2;
  }
  func displayPayload2(): string {
    return self.payload2.toString();
  }
}

open type LibGenericOuter<T: Display> {
  let inner: LibGenericInner<T, T>;
  func getInner(): LibGenericInner<T, T> {
    return self.inner;
  }
  func displayInner(): string {
    return self.inner.displayPayload2();
  }
}
