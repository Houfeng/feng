open module fcts_lib.test;

import std;

open type LibGenericDisplayPayload: Display {
  let value: int;
  func toString(): string {
    return "lib-generic-display-payload";
  }
}

open type LibGenericInner<T1, T2: Display> {
  let name: string;
  let payload1: T1;
  let payload2: T2;
  let value: int;
  func getPayload1(): T1 {
    return self.payload1;
  }
  func getPayload2(): T2 {
    return self.payload2;
  }
  func displayPayload2(): string {
    return self.payload2.toString();
  }
}

open type LibGenericOuter<T: Display> {
  let inner: LibGenericInner<T, T>;
  func getInner(): LibGenericInner<T, T> {
    return self.inner;
  }
  func displayInner(): string {
    return self.inner.displayPayload2();
  }
}

open func lib_generic_constraint_forwarding(): bool {
  let payload = LibGenericDisplayPayload { value: 42 };
  let inner = LibGenericInner<LibGenericDisplayPayload, LibGenericDisplayPayload> {
    name: "inner",
    payload1: payload,
    payload2: payload,
    value: 1
  };
  let outer = LibGenericOuter<LibGenericDisplayPayload> { inner: inner };
  let copied = outer.getInner();
  return copied.displayPayload2() == "lib-generic-display-payload" && outer.displayInner() == "lib-generic-display-payload";
}
