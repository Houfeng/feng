open module fcts_lib.test;

import std.io;

/** 跨包测试用 type */
open type LibUser: LibNamed {
  open let name: string;
  open var age: int;

  open func LibUser(name: string, age: int) {
    self.name = name;
    self.age = age;
  }

  open func display(): string {
    return self.name;
  }

  open func greet(): string {
    return "Hello, " + self.name;
  }
}
