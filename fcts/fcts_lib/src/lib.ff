open module fcts_lib;

import std.io;

/// 跨包测试用 spec
open spec LibNamed {
  let name: string;
  func display(): string;
}

/// 跨包测试用 type
open type LibUser: LibNamed {
  open let name: string;
  open var age: int;

  open func LibUser(name: string, age: int) {
    self.name = name;
    self.age = age;
  }

  open func display(): string {
    return self.name;
  }

  open func greet(): string {
    return "Hello, " + self.name;
  }
}

/// 跨包测试用辅助函数
open func lib_helper(): int {
  return 42;
}

/// 跨包测试用泛型 type
open type LibBox<T> {
  open let value: T;
}

/// 跨包测试用 enum
open enum LibColor {
  Red,
  Green,
  Blue
}
