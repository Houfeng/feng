module benchmark.binarytrees;
import std;
import std.collections;
import std.numeric;
import std.io;

/** A reference node with two optional children managed by normal Feng ownership. */
type Node { let left: Option<Node>; let right: Option<Node>; }

/** Recursively allocate the actual nodes of a complete tree. */
func makeTree(depth: int): Node {
    if depth == 0 { return Node { left: none, right: none }; }
    return Node { left: makeTree(depth - 1), right: makeTree(depth - 1) };
}

/** Count real nodes by following the tree's children. */
func check(node: Option<Node>): i64 {
    return match node { n: Node {(i64)1 + check(n.left) + check(n.right) } else {(i64)0 } };
}

/** Construct, inspect and release one temporary tree. */
func temporary(depth: int): i64 { let tree = makeTree(depth); return check(tree); }

/** Execute the stretch, temporary and long-lived tree workloads. */
func main(args: string[]) {
    if args.length() != 2 { throw "expected depth"; }
    let parsed = i64.parse(args[1]); if parsed < 6 || parsed > 20 { throw "invalid depth"; }
    let depth = (int)parsed;
    println("{0}", temporary(depth + 1)); let longLived = makeTree(depth);
    for var d: int = 4; d <= depth; d += 2 {
        var iterations: i64 = 1;
        for var exponent: int = 0; exponent < depth - d + 4; exponent += 1 { iterations *= 2; }
        var sum: i64 = 0;
        for var i: i64 = 0; i < iterations; i += 1 { sum += temporary(d); }
        println("{0} {1} {2}", d.toString(), iterations.toString(), sum.toString());
    }
    println("{0}", check(longLived));
}
