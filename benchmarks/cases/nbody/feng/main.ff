module benchmark.nbody;
import std.collections;
import std.numeric;
import std.math;

/** Print full-precision floating checksums through the public C ABI. */
@cdecl("libc", "printf", 1)
extern func printEnergy(format: string*, before: f64, after: f64): i32;

/** One body's position, velocity and mass in normalized units. */
@value type Body { var x: f64; var y: f64; var z: f64; var vx: f64; var vy: f64; var vz: f64; var mass: f64; }

/** Construct the initial system and cancel its total momentum. */
func initial(): Body[!] {
    let bodies: Body[!] = [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 1.0 },
        Body { x: 4.841431442464721, y: -1.1603200440274284, z: -0.10362204447112311, vx: 0.001660076642744037, vy: 0.007699011184197404, vz: -0.0000690460016972063, mass: 0.0009547919384243266 },
        Body { x: 8.34336671824458, y: 4.124798564124305, z: -0.4035234171143214, vx: -0.002767425107268624, vy: 0.004998528012349172, vz: 0.000023041729757376393, mass: 0.0002858859806661308 },
        Body { x: 12.894369562139131, y: -15.111151401698631, z: -0.22330757889265573, vx: 0.002964601375647616, vy: 0.0023784717395948095, vz: -0.000029658956854023756, mass: 0.00004366244043351563 },
        Body { x: 15.379697114850917, y: -25.919314609987964, z: 0.17925877295037118, vx: 0.0026806777249038932, vy: 0.001628241700382423, vz: -0.00009515922545197159, mass: 0.000051513890204661145 }
    ];
    let solar: f64 = 4.0 * 3.141592653589793 * 3.141592653589793;
    var px: f64 = 0.0; var py: f64 = 0.0; var pz: f64 = 0.0;
    for var i: int = 0; i < 5; i += 1 {
        var b = bodies[i];
        b.vx *= 365.24; b.vy *= 365.24; b.vz *= 365.24; b.mass *= solar;
        px += b.vx * b.mass; py += b.vy * b.mass; pz += b.vz * b.mass; bodies[i] = b;
    }
    var sun = bodies[0]; sun.vx = -px / solar; sun.vy = -py / solar; sun.vz = -pz / solar; bodies[0] = sun;
    return bodies;
}

/** Compute kinetic and pairwise potential energy. */
func energy(bodies: Body[!]): f64 {
    var total: f64 = 0.0;
    for var i: int = 0; i < 5; i += 1 {
        let a = bodies[i]; total += 0.5 * a.mass * (a.vx * a.vx + a.vy * a.vy + a.vz * a.vz);
        for var j: int = i + 1; j < 5; j += 1 {
            let b = bodies[j]; let dx = a.x - b.x; let dy = a.y - b.y; let dz = a.z - b.z;
            total -= a.mass * b.mass / Math.sqrt(dx * dx + dy * dy + dz * dz);
        }
    }
    return total;
}

/** Advance all velocities, then all positions by one time step. */
func advance(bodies: Body[!]) {
    for var i: int = 0; i < 5; i += 1 {
        for var j: int = i + 1; j < 5; j += 1 {
            var a = bodies[i]; var b = bodies[j];
            let dx = a.x - b.x; let dy = a.y - b.y; let dz = a.z - b.z;
            let d2 = dx * dx + dy * dy + dz * dz; let magnitude = 0.01 / (d2 * Math.sqrt(d2));
            a.vx -= dx * b.mass * magnitude; a.vy -= dy * b.mass * magnitude; a.vz -= dz * b.mass * magnitude;
            b.vx += dx * a.mass * magnitude; b.vy += dy * a.mass * magnitude; b.vz += dz * a.mass * magnitude;
            bodies[i] = a; bodies[j] = b;
        }
    }
    for var i: int = 0; i < 5; i += 1 {
        var b = bodies[i]; b.x += 0.01 * b.vx; b.y += 0.01 * b.vy; b.z += 0.01 * b.vz; bodies[i] = b;
    }
}

/** Validate input, simulate the requested steps and emit the checksum. */
func main(args: string[]) {
    if args.length() != 2 { throw "expected step count"; }
    let steps = i64.parse(args[1]); if steps < 0 || steps > 100000000 { throw "invalid step count"; }
    let bodies = initial(); let before = energy(bodies);
    for var i: i64 = 0; i < steps; i += 1 { advance(bodies); }
    let format = "%.17g %.17g\n"; printEnergy(&format, before, energy(bodies));
}
