/* System-header symbol list shared by the codegen extern-declaration pass.
 *
 * Generated C always includes <stdlib.h>, <math.h>, <string.h>, <stddef.h>,
 * <stdint.h> and <stdbool.h>.  Any C symbol that already has a prototype in
 * one of these headers must NOT be re-declared by the codegen, because the
 * Feng type mapping may produce a signature that conflicts with the
 * authoritative system-header declaration.
 *
 * Include sites must define
 *   FENG_SYSTEM_HEADER_SYMBOL(name)
 * before including this file. */

#ifndef FENG_SYSTEM_HEADER_SYMBOL
#error "define FENG_SYSTEM_HEADER_SYMBOL(name) before including system_header_symbols.inc"
#endif

/* <stdlib.h> — memory */
FENG_SYSTEM_HEADER_SYMBOL(malloc)
FENG_SYSTEM_HEADER_SYMBOL(calloc)
FENG_SYSTEM_HEADER_SYMBOL(realloc)
FENG_SYSTEM_HEADER_SYMBOL(free)

/* <stdlib.h> — process */
