--- /dev/null
+++ b/fcts/fcts_lib/src/test/lib_value_literal_partial_cleanup.ff
@@ -0,0 +1,10 @@
+open module fcts_lib.test.partial_value;
+
+/** A generic partial value must release every field acquired before a throw. */
+@value open type PartialPair<T> { open let first: T; open let second: T; }
+/** Supply a possibly throwing second initializer from a separate package. */
+open spec PartialFactory<T>(): T;
+/** Descriptor-sized value construction uses the same unwind ownership rule. */
+open func makePartialPair<T>(first: T, second: PartialFactory<T>): PartialPair<T> {
+    return PartialPair<T> { first: first, second: second() };
+}
