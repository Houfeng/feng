diff --git a/fcts/fcts_bin/src/test_value_literal_partial_cleanup.ff b/fcts/fcts_bin/src/test_value_literal_partial_cleanup.ff
new file mode 100644
index 0000000000000000000000000000000000000000..c493ce6e9c2751abe3964175602477b335003864
--- /dev/null
+++ b/fcts/fcts_bin/src/test_value_literal_partial_cleanup.ff
@@ -0,0 +1,75 @@
+module fcts_bin;
+
+import std.test;
+import fcts_lib.test.partial_value;
+
+var partialCleanupDrops: int = 0;
+var partialCleanupOrder: int = 0;
+
+/** Observe each owned resource exactly once and in actual destruction order. */
+type PartialCleanupRef {
+    let id: int;
+    func ~PartialCleanupRef() {
+        if self.id > 0 {
+            partialCleanupDrops += 1;
+            partialCleanupOrder = partialCleanupOrder * 10 + self.id;
+        }
+    }
+}
+/** Two pointer fields ensure the selected slot recursively visits all leaves. */
+@value type PartialCleanupPair { let first: PartialCleanupRef; let second: PartialCleanupRef; }
+/** Both selected union fields need protection during partial initialization. */
+@value type PartialCleanupUnionPair { let first: PartialCleanupChoice; let second: PartialCleanupChoice; }
+/** A union field selects either a scalar, resource or nested value. */
+spec PartialCleanupChoice: i8 | PartialCleanupRef | PartialCleanupPair;
+
+/** Unwind both a completed union and a partially initialized outer value. */
+func partialCleanupThrow(): PartialCleanupRef { throw "slot-layout"; }
+/** The first field must be cleaned when evaluation of the second field throws. */
+func partialCleanupPartial() {
+    let first: PartialCleanupChoice = PartialCleanupRef { id: 5 };
+    let pair = PartialCleanupPair { first: PartialCleanupRef { id: 6 }, second: partialCleanupThrow() };
+}
+/** A nested selected aggregate must also unwind through the construction guard. */
+func partialCleanupPartialUnion() {
+    let pair = PartialCleanupUnionPair {
+        first: PartialCleanupPair { first: PartialCleanupRef { id: 6 }, second: PartialCleanupRef { id: 7 } },
+        second: partialCleanupThrow()
+    };
+}
+/** Keep the shared construction call inside a void try-expression target. */
+func partialCleanupPartialGeneric() {
+    let value = makePartialPair<PartialCleanupRef>(PartialCleanupRef { id: 8 },
+        () { return partialCleanupThrow(); });
+}
+
+/** Partial value construction transfers or unwinds each acquired resource. */
+func test_value_literal_partial_cleanup() {
+    describe("value literal partial cleanup", () {
+        test("exception and partial initialization cleanup", () {
+            partialCleanupDrops = 0;
+            partialCleanupOrder = 0;
+            var caught = false;
+            try partialCleanupPartial() catch error: string { caught = error == "slot-layout"; }
+            assert(caught, "exception reaches its handler");
+            assert(partialCleanupDrops == 2, "partial field and completed union are each cleaned");
+            assert(partialCleanupOrder == 65, "partial field is cleaned before the completed union");
+        });
+        test("nested selected field partial initialization cleanup", () {
+            partialCleanupDrops = 0;
+            partialCleanupOrder = 0;
+            var caught = false;
+            try partialCleanupPartialUnion() catch error: string { caught = error == "slot-layout"; }
+            assert(caught && partialCleanupDrops == 2 && partialCleanupOrder == 67,
+                "partial union releases the selected aggregate in field order");
+        });
+        test("source-hidden generic partial value cleanup", () {
+            partialCleanupDrops = 0;
+            partialCleanupOrder = 0;
+            var caught = false;
+            try partialCleanupPartialGeneric() catch error: string { caught = error == "slot-layout"; }
+            assert(caught && partialCleanupDrops == 1 && partialCleanupOrder == 8,
+                "generic construction and caller temporary each release their own token");
+        });
+    });
+}
