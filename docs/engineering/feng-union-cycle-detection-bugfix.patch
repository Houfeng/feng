@@ -0,0 +1,76 @@
+#include "../throw_constraint_helpers.h"
+
+/* Array recursion reaches a finite set, including permuted generic parameters;
+ * unused parameters never create managed edges. These need no code generation. */
+static void union_slot_recursive_references(void) {
+    const char *source =
+        "module slot.recursive;"
+        "spec Branch:i32|Branch[];"
+        "type Container{let value:Branch;}"
+        "spec Shift<T,U>:T|Shift<U,Node>[];"
+        "type Node{let value:Shift<i32,i64>;}"
+        "spec Rotate<T,U>:T|Rotate<U,T>[];"
+        "type RotateNode{let value:Rotate<i32,RotateNode>;}"
+        "spec Hollow<T>:i32|Hollow<T>[];"
+        "type Phantom{let value:Hollow<Phantom>;}"
+        "spec Growing<T>:T|Growing<T[]>[];"
+        "type GrowingNode{let value:Growing<GrowingNode>;}";
+    ThrowConstraintUnit unit = throw_constraint_analyze(source, NULL, NULL);
+    for (size_t i = 0U; i < unit.program->declaration_count; ++i) {
+        const FengDecl *decl = unit.program->declarations[i];
+        if (decl->kind != FENG_DECL_TYPE) continue;
+        FengSlice name = decl->as.type_decl.name;
+        bool expected = !(name.length == strlen("Container") && memcmp(name.data, "Container", name.length) == 0) &&
+                        !(name.length == strlen("Phantom") && memcmp(name.data, "Phantom", name.length) == 0);
+        THROW_CHECK(feng_semantic_type_is_potentially_cyclic(unit.analysis, decl) == expected);
+    }
+    throw_constraint_dispose(&unit);
+}
+
+/* Union references contribute only actual managed edges to the existing SCC graph. */
+void test_union_cycle_detection_codegen(void) {
+    union_slot_recursive_references();
+    const char *source =
+        "open module slot.layout;"
+        "@value open type Empty{}"
+        "open type Ref{let value:int;}"
+        "@value open type Pair{let first:Ref;let second:Ref;}"
+        "open spec View{let value:int;}"
+        "open spec Thunk():int;"
+        "open spec Small:i8|u8;"
+        "open spec Inner:i16|bool;"
+        "open spec Choice:i8|Ref|Pair|View|Thunk|Inner;"
+        "open spec Maybe<T>:Empty|T;"
+        "open spec Nested<T>:Maybe<T>|string;"
+        "open spec Phantom<T>:Empty|i32;"
+        "open type Node{var left:Maybe<Node>;var right:Maybe<Node>;}"
+        "open type NestedNode{var next:Nested<NestedNode>;}"
+        "open type GenericNode<T>{var next:Maybe<GenericNode<T>>;let value:T;}"
+        "open type ArrayNode{var next:Maybe<ArrayNode[]>;}"
+        "open type WrappedNode{var next:Maybe<Wrapped>;}"
+        "@value open type Wrapped{var next:Maybe<WrappedNode>;}"
+        "open type NoCycle{var next:Maybe<Ref>;}"
+        "open type PhantomNode{var next:Phantom<PhantomNode>;}"
+        "open type PointerNode{var next:Maybe<i32*>;}"
+        "open type Holder{var value:Choice;}"
+        "open func wrap<T>(value:T):Maybe<T>{return value;}"
+        "open func small(value:i8):Maybe<i8>{return wrap<i8>(value);}"
+        "open func flag(value:bool):Maybe<bool>{return wrap<bool>(value);}"
+        "open func real(value:f64):Maybe<f64>{return wrap<f64>(value);}"
+        "open func large(value:Pair):Maybe<Pair>{return wrap<Pair>(value);}"
+        "open func nested(value:Maybe<i8>):Maybe<Maybe<i8>>{return wrap<Maybe<i8>>(value);}"
+        "open func replace(holder:Holder,value:Choice){holder.value=value;}";
+    ThrowConstraintUnit unit = throw_constraint_analyze(source, NULL, NULL);
+    const char *cyclic[] = {"Node", "NestedNode", "GenericNode", "ArrayNode", "WrappedNode", "Wrapped"};
+    for (size_t i = 0U; i < unit.program->declaration_count; ++i) {
+        const FengDecl *decl = unit.program->declarations[i];
+        if (decl->kind != FENG_DECL_TYPE) continue;
+        bool expected = false;
+        for (size_t k = 0U; k < sizeof cyclic / sizeof *cyclic; ++k)
+            if (strlen(cyclic[k]) == decl->as.type_decl.name.length &&
+                memcmp(cyclic[k], decl->as.type_decl.name.data, strlen(cyclic[k])) == 0)
+                expected = true;
+        THROW_CHECK(feng_semantic_type_is_potentially_cyclic(unit.analysis, decl) == expected);
+    }
+    throw_constraint_dispose(&unit);
+}
