diff --git a/test/cli/fixtures/union_cycle_detection/main.ff b/test/cli/fixtures/union_cycle_detection/main.ff
new file mode 100644
index 0000000000000000000000000000000000000000..b4ea821307537931d9a37915c55c4b638f04c6cf
--- /dev/null
+++ b/test/cli/fixtures/union_cycle_detection/main.ff
@@ -0,0 +1,75 @@
+module union_slot_consumer;
+
+import union_cycle_provider;
+
+var dropped: int = 0;
+var cycleDrops: int = 0;
+var revive: bool = false;
+var saved: SlotOption<Cycle>;
+
+/** Fail independently of an active std.test context. */
+func require(ok: bool) { if !ok { throw "union-slot-layout"; } }
+/** A positive ID identifies one actual owned resource. */
+type Ref {
+    let id: int;
+    func ~Ref() { if self.id > 0 { dropped += 1; } }
+}
+/** The selected aggregate owns multiple pointers at the same payload base. */
+@value type Pair { let first: Ref; let second: Ref; }
+/** The collector must follow both selected fields and clear only live edges. */
+type Cycle {
+    var next: SlotOption<Cycle>;
+    var payload: SlotOption<Pair>;
+    func ~Cycle() {
+        cycleDrops += 1;
+        if revive { revive = false; saved = self; }
+    }
+}
+
+/** Build a two-node ring, with an independently owned external child. */
+func ring(external: Ref) {
+    let first = Cycle();
+    let second = Cycle();
+    first.next = second;
+    second.next = first;
+    first.payload = Pair { first: external, second: Ref { id: 2 } };
+    second.payload = Pair { first: external, second: Ref { id: 3 } };
+}
+
+/** Check resurrection and later collection using only language-visible state. */
+func cycles() {
+    let external = Ref { id: 1 };
+    revive = true;
+    ring(external);
+    // Collection runs all component finalizers once before testing resurrection.
+    require(cycleDrops == 2 && dropped == 2);
+    match saved {
+        node: Cycle {
+            require(match node.next { other: Cycle { true } else { false } });
+            require(match node.payload { pair: Pair { pair.first.id == 1 && pair.second.id > 1 } else { false } });
+        }
+        else { require(false); }
+    }
+    saved = SlotEmpty();
+    // A resurrected component runs its finalizers again on the next collection.
+    require(cycleDrops == 4 && dropped == 4 && external.id == 1);
+    ring(external);
+    require(cycleDrops == 6 && dropped == 6 && external.id == 1);
+}
+
+/** Nested generic union members remain visible after the provider source is removed. */
+func importedCycle() {
+    let first = SlotCycle<Ref> { payload: Ref { id: 6 } };
+    let second = SlotCycle<Ref> { payload: Ref { id: 7 } };
+    first.next = slotNest<SlotCycle<Ref>>(second);
+    second.next = slotNest<SlotCycle<Ref>>(first);
+}
+
+/** The test sets a deterministic collector threshold before process startup. */
+func main(args: string[]) {
+    dropped = 0;
+    cycles();
+    require(dropped == 7);
+    importedCycle();
+    require(dropped == 9);
+}
diff --git a/test/cli/fixtures/union_cycle_detection/provider.ff b/test/cli/fixtures/union_cycle_detection/provider.ff
new file mode 100644
index 0000000000000000000000000000000000000000..db682fd83949ee5dd69429dee9db50c7f12a3dc4
--- /dev/null
+++ b/test/cli/fixtures/union_cycle_detection/provider.ff
@@ -0,0 +1,20 @@
+open module union_cycle_provider;
+
+/** A trivial first member keeps small closed payloads independent of pointers. */
+@value open type SlotEmpty {}
+/** Every instantiation shares the same tag and payload prefix. */
+open spec SlotOption<T>: SlotEmpty | T;
+/** Preserve nested member identity, with a second independently managed choice. */
+open spec SlotNested<T>: SlotOption<T> | string;
+/** Construct a union in a source-hidden shared body. */
+open func slotWrap<T>(value: T): SlotOption<T> { return value; }
+/** Nest complete unions, including their own tags. */
+open func slotNest<T>(value: T): SlotNested<T> {
+    let inner = slotWrap<T>(value);
+    return inner;
+}
+/** Imported generic types contribute their selected reference edges to SCC. */
+open type SlotCycle<T> {
+    open var next: SlotNested<SlotCycle<T>>;
+    open let payload: T;
+}
