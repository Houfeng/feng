  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x31; seq[3] = (byte)0x3B; seq[4] = (byte)0x35; seq[5] = (byte)0x41;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/ctrl-up-captured");
  check(capturedKey.isControl() == true, "tui/input/ctrl-up-is-control");
