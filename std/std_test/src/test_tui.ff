func input_ctrl_arrow_up() {
  let mgr = makeInputManager();
  // ESC[1;5A = Ctrl+Up
  let seq: byte[!] = byte[:6];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x31; seq[3] = (byte)0x3B; seq[4] = (byte)0x35; seq[5] = (byte)0x41;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/ctrl-up-captured");
  check(capturedKey.isControl() == true, "tui/input/ctrl-up-is-control");
  check(capturedKey.isShift() == false, "tui/input/ctrl-up-not-shift");
}

func input_utf8_chinese() {
  let mgr = makeInputManager();
  // "你" = U+4F60 = 0xE4 0xBD 0xA0
  let seq: byte[!] = byte[:3];
  seq[0] = (byte)0xE4; seq[1] = (byte)0xBD; seq[2] = (byte)0xA0;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/utf8-chinese-captured");
  check(capturedKey.isPrintable() == true, "tui/input/utf8-chinese-is-printable");
  check(capturedKey.mods == (u8)0, "tui/input/utf8-chinese-mods");
}

func input_utf8_emoji() {
  let mgr = makeInputManager();
  // 😀 = U+1F600 = 0xF0 0x9F 0x98 0x80
  let seq: byte[!] = byte[:4];
  seq[0] = (byte)0xF0; seq[1] = (byte)0x9F; seq[2] = (byte)0x98; seq[3] = (byte)0x80;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/utf8-emoji-captured");
  check(capturedKey.isPrintable() == true, "tui/input/utf8-emoji-is-printable");
}

func input_invalid_utf8_resets() {
  let mgr = makeInputManager();
  // 0xC0 是 2 字节首字节，期望 1 个续传；0x00 不是合法续传（不在 0x80-0xBF）
  // 应重置状态机，无回调触发
  mgr.feed((u8)0xC0);
  mgr.feed((u8)0x00);
  check(keyCaptured == false, "tui/input/invalid-utf8-no-callback");
}

func input_unknown_csi_dropped() {
  let mgr = makeInputManager();
  // ESC[Z 是未知 CSI 序列，应丢弃，无回调
  let seq: byte[!] = byte[:3];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x5A;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == false, "tui/input/unknown-csi-no-callback");
}

func input_mouse_left_click() {
  let mgr = makeInputManager();
  // ESC[<0;10;5M = 左键点击 (10,5)，转 0-based → (9,4)
  let seq: byte[!] = byte[:10];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x3C; seq[3] = (byte)0x30; seq[4] = (byte)0x3B;
  seq[5] = (byte)0x31; seq[6] = (byte)0x30; seq[7] = (byte)0x3B; seq[8] = (byte)0x35; seq[9] = (byte)0x4D;
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-left-click-captured");
  check(capturedMouse.action == MouseAction.Press, "tui/input/mouse-left-click-action");
  check(capturedMouse.button == MouseButton.Left, "tui/input/mouse-left-click-button");
  check(capturedMouse.x == (u32)9, "tui/input/mouse-left-click-x");
  check(capturedMouse.y == (u32)4, "tui/input/mouse-left-click-y");
  check(capturedMouse.mods == (u8)0, "tui/input/mouse-left-click-mods");
  check(capturedMouse.hasTarget() == false, "tui/input/mouse-target-unbound");
}

func input_mouse_right_release() {
  let mgr = makeInputManager();
  // ESC[<2;10;5m = 右键释放 (10,5)，转 0-based → (9,4)
  let seq: byte[!] = byte[:10];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x3C; seq[3] = (byte)0x32; seq[4] = (byte)0x3B;
  seq[5] = (byte)0x31; seq[6] = (byte)0x30; seq[7] = (byte)0x3B; seq[8] = (byte)0x35; seq[9] = (byte)0x6D;
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-right-release-captured");
  check(capturedMouse.action == MouseAction.Release, "tui/input/mouse-right-release-action");
  check(capturedMouse.button == MouseButton.Right, "tui/input/mouse-right-release-button");
  check(capturedMouse.x == (u32)9, "tui/input/mouse-right-release-x");
  check(capturedMouse.y == (u32)4, "tui/input/mouse-right-release-y");
}

func input_mouse_wheel_up() {
  let mgr = makeInputManager();
  // ESC[<64;1;1M = 滚轮上 (1,1)，转 0-based → (0,0)
  let seq: byte[!] = byte[:10];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x3C; seq[3] = (byte)0x36; seq[4] = (byte)0x34; seq[5] = (byte)0x3B;
  seq[6] = (byte)0x31; seq[7] = (byte)0x3B; seq[8] = (byte)0x31; seq[9] = (byte)0x4D;
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-wheel-up-captured");
  check(capturedMouse.action == MouseAction.Press, "tui/input/mouse-wheel-up-action");
  check(capturedMouse.button == MouseButton.WheelUp, "tui/input/mouse-wheel-up-button");
  check(capturedMouse.x == (u32)0, "tui/input/mouse-wheel-up-x");
  check(capturedMouse.y == (u32)0, "tui/input/mouse-wheel-up-y");
}

func input_mouse_drag_left() {
  let mgr = makeInputManager();
  // ESC[<32;10;5M = 按住左键拖动 (10,5)，转 0-based → (9,4)
  // 32 → '3'=0x33 '2'=0x32，共 11 字节
  let seq: byte[!] = byte[:11];
  seq[0] = (byte)0x1B;  // ESC
  seq[1] = (byte)0x5B;  // '['
  seq[2] = (byte)0x3C;  // '<'
  seq[3] = (byte)0x33;  // '3'
  seq[4] = (byte)0x32;  // '2'
  seq[5] = (byte)0x3B;  // ';'
  seq[6] = (byte)0x31;  // '1'
  seq[7] = (byte)0x30;  // '0'
  seq[8] = (byte)0x3B;  // ';'
  seq[9] = (byte)0x35;  // '5'
  seq[10] = (byte)0x4D; // 'M'
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-drag-left-captured");
  check(capturedMouse.action == MouseAction.Move, "tui/input/mouse-drag-left-action");
  check(capturedMouse.button == MouseButton.Left, "tui/input/mouse-drag-left-button");
  check(capturedMouse.x == (u32)9, "tui/input/mouse-drag-left-x");
  check(capturedMouse.y == (u32)4, "tui/input/mouse-drag-left-y");
}

func input_mouse_hover_move() {
  let mgr = makeInputManager();
  // ESC[<35;10;5M = 悬停移动（无按钮） (10,5)，转 0-based → (9,4)
  // 35 → '3'=0x33 '5'=0x35，共 11 字节
  let seq: byte[!] = byte[:11];
  seq[0] = (byte)0x1B;  // ESC
  seq[1] = (byte)0x5B;  // '['
  seq[2] = (byte)0x3C;  // '<'
  seq[3] = (byte)0x33;  // '3'
  seq[4] = (byte)0x35;  // '5'
  seq[5] = (byte)0x3B;  // ';'
  seq[6] = (byte)0x31;  // '1'
  seq[7] = (byte)0x30;  // '0'
  seq[8] = (byte)0x3B;  // ';'
  seq[9] = (byte)0x35;  // '5'
  seq[10] = (byte)0x4D; // 'M'
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-hover-captured");
  check(capturedMouse.action == MouseAction.Move, "tui/input/mouse-hover-action");
  check(capturedMouse.button == MouseButton.None, "tui/input/mouse-hover-button-none");
  check(capturedMouse.x == (u32)9, "tui/input/mouse-hover-x");
  check(capturedMouse.y == (u32)4, "tui/input/mouse-hover-y");
}

func input_mouse_with_modifiers() {
  let mgr = makeInputManager();
  // ESC[<4;5;3M = 左键 + Shift (4=0+4)，坐标 (5,3) → 0-based (4,2)
  let seq: byte[!] = byte[:9];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x3C; seq[3] = (byte)0x34; seq[4] = (byte)0x3B;
  seq[5] = (byte)0x35; seq[6] = (byte)0x3B; seq[7] = (byte)0x33; seq[8] = (byte)0x4D;
  feedBytes(mgr, (byte[])seq);
  check(mouseCaptured == true, "tui/input/mouse-shift-captured");
  check(capturedMouse.isShift() == true, "tui/input/mouse-shift-is-shift");
  check(capturedMouse.button == MouseButton.Left, "tui/input/mouse-shift-button");
}

func input_unregistered_callback_drops_events() {
  // 不赋值 onKey/onMouse，feed 字节，零值回调执行空操作无异常
  let mgr = InputManager<i32>();  // 不注册回调
  var caught = false;
  try mgr.feed((u8)0x41) catch ex: string { caught = true; };
  check(caught == false, "tui/input/unregistered-key-no-throw");
  // 测试鼠标序列也不抛异常：ESC[<0;1;1M = 9 字节
  let seq: byte[!] = byte[:9];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x3C; seq[3] = (byte)0x30; seq[4] = (byte)0x3B;
  seq[5] = (byte)0x31; seq[6] = (byte)0x3B; seq[7] = (byte)0x31; seq[8] = (byte)0x4D;
  var caught2 = false;
  try feedBytes(mgr, (byte[])seq) catch ex: string { caught2 = true; };
  check(caught2 == false, "tui/input/unregistered-mouse-no-throw");
}

func input_build_enable_mouse_sgr_bytes() {
  // buildEnableMouseSgrBytes() 返回 16 字节，包含 1006h 和 1003h 两条序列
  let mgr = InputManager<i32>();
  let seq = mgr.buildEnableMouseSgrBytes();
  check(seq.length() == (int)16, "tui/input/enable-mouse-sgr-length");
  // 第一条：ESC[?1006h
  check(seq[0] == (byte)0x1B, "tui/input/enable-mouse-sgr-esc1");
  check(seq[1] == (byte)0x5B, "tui/input/enable-mouse-sgr-bracket1");
  check(seq[2] == (byte)0x3F, "tui/input/enable-mouse-sgr-question1");
  check(seq[7] == (byte)0x68, "tui/input/enable-mouse-sgr-h1");
  // 第二条：ESC[?1003h
  check(seq[8] == (byte)0x1B, "tui/input/enable-mouse-sgr-esc2");
  check(seq[15] == (byte)0x68, "tui/input/enable-mouse-sgr-h2");
}

func input_build_disable_mouse_sgr_bytes() {
  // buildDisableMouseSgrBytes() 返回 16 字节，包含 1003l 和 1006l 两条序列
  let mgr = InputManager<i32>();
  let seq = mgr.buildDisableMouseSgrBytes();
  check(seq.length() == (int)16, "tui/input/disable-mouse-sgr-length");
  // 第一条：ESC[?1003l
  check(seq[0] == (byte)0x1B, "tui/input/disable-mouse-sgr-esc1");
  check(seq[7] == (byte)0x6C, "tui/input/disable-mouse-sgr-l1");
  // 第二条：ESC[?1006l
  check(seq[8] == (byte)0x1B, "tui/input/disable-mouse-sgr-esc2");
  check(seq[15] == (byte)0x6C, "tui/input/disable-mouse-sgr-l2");
}

