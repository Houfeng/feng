module std_test;

import std;
import std.test;
import std.collections;
import std.text;

import std.tui;
import std.tui.common;
import std.tui.input;
import std.tui.screen;
import std.tui.view;
import std.tui.widgets;

// ─── 静态常量 ──────────────────────────────────────────────────────────────

func cell_mask_fg() {
  check(Cell.MASK_FG == (u64)0xFFFFFF, "tui/cell/mask-fg");
}

func cell_mask_bg() {
  check(Cell.MASK_BG == ((u64)0xFFFFFF << (u64)24), "tui/cell/mask-bg");
}

func cell_mask_flags() {
  check(Cell.MASK_FLAGS == ((u64)0xFF << (u64)48), "tui/cell/mask-flags");
}

func cell_style_bold_const() {
  check(Cell.STYLE_BOLD == ((u64)1 << (u64)48), "tui/cell/style-bold-const");
}

func cell_style_dim_const() {
  check(Cell.STYLE_DIM == ((u64)1 << (u64)49), "tui/cell/style-dim-const");
}

func cell_style_italic_const() {
  check(Cell.STYLE_ITALIC == ((u64)1 << (u64)50), "tui/cell/style-italic-const");
}

func cell_style_underline_const() {
  check(Cell.STYLE_UNDERLINE == ((u64)1 << (u64)51), "tui/cell/style-underline-const");
}

func cell_style_blink_const() {
  check(Cell.STYLE_BLINK == ((u64)1 << (u64)52), "tui/cell/style-blink-const");
}

func cell_style_reverse_const() {
  check(Cell.STYLE_REVERSE == ((u64)1 << (u64)53), "tui/cell/style-reverse-const");
}

func cell_style_hidden_const() {
  check(Cell.STYLE_HIDDEN == ((u64)1 << (u64)54), "tui/cell/style-hidden-const");
}

func cell_style_strikethrough_const() {
  check(Cell.STYLE_STRIKETHROUGH == ((u64)1 << (u64)55), "tui/cell/style-strikethrough-const");
}

// ─── 构造函数 ──────────────────────────────────────────────────────────────

func cell_ctor_default() {
  let c = Cell();
  check(c.value == (u64)0, "tui/cell/ctor-default-value");
  check(c.style == (u64)0, "tui/cell/ctor-default-style");
}

func cell_ctor_value() {
  let c = Cell((u64)65);
  check(c.value == (u64)65, "tui/cell/ctor-value-value");
  check(c.style == (u64)0, "tui/cell/ctor-value-style");
}

func cell_ctor_value_style() {
  let c = Cell((u64)65, Cell.STYLE_BOLD);
  check(c.value == (u64)65, "tui/cell/ctor-value-style-value");
  check(c.style == Cell.STYLE_BOLD, "tui/cell/ctor-value-style-style");
}

// ─── 前景色 / 背景色读写 ────────────────────────────────────────────────────

func cell_fore_color_rw() {
  let c = Cell((u64)65);
  check(c.foreColor() == (u32)0, "tui/cell/fore-color-init");
  c.foreColor((u32)0xABCDEE);
  check(c.foreColor() == (u32)0xABCDEE, "tui/cell/fore-color-set");
}

func cell_back_color_rw() {
  let c = Cell((u64)65);
  check(c.backColor() == (u32)0, "tui/cell/back-color-init");
  c.backColor((u32)0x123456);
  check(c.backColor() == (u32)0x123456, "tui/cell/back-color-set");
}

func cell_fore_back_color_independent() {
  let c = Cell((u64)65);
  c.foreColor((u32)0xFF);
  c.backColor((u32)0xFF00);
  check(c.foreColor() == (u32)0xFF, "tui/cell/fore-back-independent-fg");
  check(c.backColor() == (u32)0xFF00, "tui/cell/fore-back-independent-bg");
}

// ─── 样式标志位读写 ──────────────────────────────────────────────────────────

func cell_bold_rw() {
  let c = Cell((u64)65);
  check(c.bold() == false, "tui/cell/bold-init");
  c.bold(true);
  check(c.bold() == true, "tui/cell/bold-set-true");
  check(c.style == Cell.STYLE_BOLD, "tui/cell/bold-style-value");
  c.bold(false);
  check(c.bold() == false, "tui/cell/bold-set-false");
  check(c.style == (u64)0, "tui/cell/bold-cleared");
}

func cell_dim_rw() {
  let c = Cell((u64)65);
  check(c.dim() == false, "tui/cell/dim-init");
  c.dim(true);
  check(c.dim() == true, "tui/cell/dim-set-true");
  c.dim(false);
  check(c.dim() == false, "tui/cell/dim-set-false");
}

func cell_italic_rw() {
  let c = Cell((u64)65);
  check(c.italic() == false, "tui/cell/italic-init");
  c.italic(true);
  check(c.italic() == true, "tui/cell/italic-set-true");
  c.italic(false);
  check(c.italic() == false, "tui/cell/italic-set-false");
}

func cell_underline_rw() {
  let c = Cell((u64)65);
  check(c.underline() == false, "tui/cell/underline-init");
  c.underline(true);
  check(c.underline() == true, "tui/cell/underline-set-true");
  c.underline(false);
  check(c.underline() == false, "tui/cell/underline-set-false");
}

func cell_blink_rw() {
  let c = Cell((u64)65);
  check(c.blink() == false, "tui/cell/blink-init");
  c.blink(true);
  check(c.blink() == true, "tui/cell/blink-set-true");
  c.blink(false);
  check(c.blink() == false, "tui/cell/blink-set-false");
}

func cell_reverse_rw() {
  let c = Cell((u64)65);
  check(c.reverse() == false, "tui/cell/reverse-init");
  c.reverse(true);
  check(c.reverse() == true, "tui/cell/reverse-set-true");
  c.reverse(false);
  check(c.reverse() == false, "tui/cell/reverse-set-false");
}

func cell_hidden_rw() {
  let c = Cell((u64)65);
  check(c.hidden() == false, "tui/cell/hidden-init");
  c.hidden(true);
  check(c.hidden() == true, "tui/cell/hidden-set-true");
  c.hidden(false);
  check(c.hidden() == false, "tui/cell/hidden-set-false");
}

func cell_strikethrough_rw() {
  let c = Cell((u64)65);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-init");
  c.strikeThrough(true);
  check(c.strikeThrough() == true, "tui/cell/strikethrough-set-true");
  c.strikeThrough(false);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-set-false");
}

// ─── 样式组合 ──────────────────────────────────────────────────────────────

func cell_style_combination() {
  let c = Cell((u64)65);
  c.bold(true);
  c.italic(true);
  c.underline(true);
  check(c.bold() == true, "tui/cell/combination-bold");
  check(c.italic() == true, "tui/cell/combination-italic");
  check(c.underline() == true, "tui/cell/combination-underline");
  check(c.dim() == false, "tui/cell/combination-dim-false");
  check(c.blink() == false, "tui/cell/combination-blink-false");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(c.style == expected, "tui/cell/combination-style-value");
}

func cell_style_with_colors() {
  let c = Cell((u64)65);
  c.foreColor((u32)0xFFFFFF);
  c.backColor((u32)0x000000);
  c.bold(true);
  check(c.foreColor() == (u32)0xFFFFFF, "tui/cell/style-colors-fg");
  check(c.backColor() == (u32)0x000000, "tui/cell/style-colors-bg");
  check(c.bold() == true, "tui/cell/style-colors-bold");
  check(c.value == (u64)65, "tui/cell/style-colors-value");
}

// ─── Cell 直接字段读写（open var） ──────────────────────────────────────────

func cell_field_rw() {
  let c = Cell();
  check(c.value == (u64)0, "tui/cell/field-rw-value-init");
  check(c.style == (u64)0, "tui/cell/field-rw-style-init");
  c.value = (u64)0x4E2D;
  c.style = Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE;
  check(c.value == (u64)0x4E2D, "tui/cell/field-rw-value-write");
  check(c.style == (Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE), "tui/cell/field-rw-style-write");
  check(c.bold() == true, "tui/cell/field-rw-bold");
  check(c.underline() == true, "tui/cell/field-rw-underline");
  c.value = (u64)65;
  c.style = (u64)0;
  check(c.value == (u64)65, "tui/cell/field-rw-value-overwrite");
  check(c.style == (u64)0, "tui/cell/field-rw-style-clear");
  check(c.bold() == false, "tui/cell/field-rw-bold-cleared");
}

// ─── Buffer 构造函数 ──────────────────────────────────────────────────────

func buffer_ctor() {
  let buf = Buffer((u32)10, (u32)5);
  check(buf.width == (u32)10, "tui/buffer/ctor-width");
  check(buf.height == (u32)5, "tui/buffer/ctor-height");
  check(buf.cells.length() == (int)50, "tui/buffer/ctor-cells-length");
}

func buffer_default_cells() {
  let buf = Buffer((u32)3, (u32)2);
  // 直接通过 cells 数组读取默认值
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/default-cells-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/default-cells-style");
  let idx = (int)((u64)1 * (u64)3 + (u64)1); // y=1, x=1
  check(buf.cells[idx].value == (u64)0, "tui/buffer/default-cells-value-1-1");
  check(buf.cells[idx].style == (u64)0, "tui/buffer/default-cells-style-1-1");
}

// ─── Buffer 直接操作 cells（就地修改） ───────────────────────────────────────

func buffer_cells_in_place_modify() {
  let buf = Buffer((u32)4, (u32)4);
  let idx = (int)((u64)1 * (u64)4 + (u64)2);  // y=1, x=2
  buf.cells[idx].value = (u64)65;
  buf.cells[idx].bold(true);
  buf.cells[idx].foreColor((u32)0xFF0000);

  check(buf.cells[idx].value == (u64)65, "tui/buffer/in-place-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/in-place-bold");
  check(buf.cells[idx].foreColor() == (u32)0xFF0000, "tui/buffer/in-place-fg");
}

// ─── Buffer draw 文本（单行） ────────────────────────────────────────────────

func buffer_draw_text_ascii() {
  let buf = Buffer((u32)10, (u32)3);
  buf.draw((u32)0, (u32)0, "Hello");
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-ascii-h");
  check(buf.cells[(int)1].value == (u64)101, "tui/buffer/draw-text-ascii-e");
  check(buf.cells[(int)4].value == (u64)111, "tui/buffer/draw-text-ascii-o");
  // 未写入的位置应保持默认
  check(buf.cells[(int)5].value == (u64)0, "tui/buffer/draw-text-ascii-after");
}

func buffer_draw_text_chinese() {
  let buf = Buffer((u32)10, (u32)2);
  // "中" U+4E2D, "文" U+6587
  buf.draw((u32)0, (u32)0, "中文");
  check(buf.cells[(int)0].value == (u64)0x4E2D, "tui/buffer/draw-text-chinese-0");
  check(buf.cells[(int)1].value == (u64)0x6587, "tui/buffer/draw-text-chinese-1");
}

func buffer_draw_text_emoji() {
  let buf = Buffer((u32)10, (u32)2);
  // 😀 U+1F600
  buf.draw((u32)0, (u32)0, "😀");
  check(buf.cells[(int)0].value == (u64)0x1F600, "tui/buffer/draw-text-emoji");
}

func buffer_draw_text_clip() {
  let buf = Buffer((u32)4, (u32)2);
  // 在宽度为 4 的行写 6 个字符，后 2 个应被裁剪
  buf.draw((u32)0, (u32)0, "ABCDEF");
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-text-clip-a");
  check(buf.cells[(int)3].value == (u64)68, "tui/buffer/draw-text-clip-d");
  // 第 5 个字符 'E' (69) 应被裁剪，不写入到下一行
  check(buf.cells[(int)4].value == (u64)0, "tui/buffer/draw-text-clip-next-row");
}

func buffer_draw_text_offset_and_clip() {
  let buf = Buffer((u32)5, (u32)2);
  // 从 x=2 开始写，只有 3 个位置可用
  buf.draw((u32)2, (u32)0, "ABCDE");
  check(buf.cells[(int)2].value == (u64)65, "tui/buffer/draw-text-offset-a");
  check(buf.cells[(int)4].value == (u64)67, "tui/buffer/draw-text-offset-c");
}

func buffer_draw_text_empty() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)0, "");
  // 空字符串不改变任何 Cell
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-empty");
}

func buffer_draw_text_y_out_of_bounds() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)5, "Hello");
  // 行越界，整行不写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-y-oob");
}

func buffer_draw_text_with_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", CellStyle.Bold, CellStyle.Underline);
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-style-value");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-style-bold");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/draw-text-style-underline");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-style-bold-1");
}

// ─── Buffer draw 矩形文本（自动换行） ──────────────────────────────────────

func buffer_draw_rect_text_wrap() {
  let buf = Buffer((u32)5, (u32)3);
  // 在 5x2 矩形内绘制 "ABCDEFGH" (8字符)，应自动换行
  buf.draw((u32)0, (u32)0, (u32)5, (u32)2, "ABCDEFGH");
  // 第一行: A B C D E
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-wrap-0a");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-wrap-0e");
  // 第二行: F G H
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-wrap-1f");
  let idx12 = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx12].value == (u64)72, "tui/buffer/draw-rect-wrap-1h");
  // 第三行不应被写入
  let idx20 = (int)((u64)2 * (u64)5 + (u64)0);
  check(buf.cells[idx20].value == (u64)0, "tui/buffer/draw-rect-wrap-2-empty");
}

func buffer_draw_rect_text_clip_height() {
  let buf = Buffer((u32)5, (u32)2);
  // 在 5x3 矩形内绘制，但 Buffer 只有 2 行，第 3 行应被裁剪
  buf.draw((u32)0, (u32)0, (u32)5, (u32)3, "ABCDEFGHIJKLMN");
  // 第一行写入 5 个
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-clip-h-0");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-clip-h-4");
  // 第二行写入 5 个
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-clip-h-1f");
  let idx14 = (int)((u64)1 * (u64)5 + (u64)4);
  check(buf.cells[idx14].value == (u64)74, "tui/buffer/draw-rect-clip-h-1j");
}

// ─── Buffer draw 单码点 ────────────────────────────────────────────────────

func buffer_draw_codepoint() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)2, (u32)1, (u64)65, CellStyle.Bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-bold");
}

func buffer_draw_codepoint_out_of_bounds() {
  let buf = Buffer((u32)3, (u32)3);
  buf.draw((u32)5, (u32)0, (u64)65);
  buf.draw((u32)0, (u32)5, (u64)65);
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-codepoint-oob");
}

// ─── Buffer draw 矩形码点填充 ──────────────────────────────────────────────

func buffer_draw_rect_codepoint() {
  let buf = Buffer((u32)5, (u32)4);
  buf.draw((u32)1, (u32)1, (u32)3, (u32)2, (u64)65, CellStyle.Italic);
  // 矩形内 (1,1) 到 (3,2) 应被填充
  let idx11 = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx11].value == (u64)65, "tui/buffer/draw-rect-cp-11");
  let idx13 = (int)((u64)1 * (u64)5 + (u64)3);
  check(buf.cells[idx13].value == (u64)65, "tui/buffer/draw-rect-cp-13");
  let idx21 = (int)((u64)2 * (u64)5 + (u64)1);
  check(buf.cells[idx21].value == (u64)65, "tui/buffer/draw-rect-cp-21");
  check(buf.cells[idx21].italic() == true, "tui/buffer/draw-rect-cp-italic");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)65, "tui/buffer/draw-rect-cp-23");
  // 矩形外不应被写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-rect-cp-outside-0");
  let idx33 = (int)((u64)3 * (u64)5 + (u64)3);
  check(buf.cells[idx33].value == (u64)0, "tui/buffer/draw-rect-cp-outside-33");
}

// ─── Buffer fill ────────────────────────────────────────────────────────────

func buffer_fill() {
  let buf = Buffer((u32)3, (u32)3);
  buf.fill((u64)65, CellStyle.Bold);
  // 检查多个位置
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-0-0");
  let idx22 = (int)((u64)2 * (u64)3 + (u64)2);
  check(buf.cells[idx22].value == (u64)65, "tui/buffer/fill-2-2");
  let idx11 = (int)((u64)1 * (u64)3 + (u64)1);
  check(buf.cells[idx11].bold() == true, "tui/buffer/fill-bold");
}

func buffer_fill_no_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)88);
  check(buf.cells[(int)0].value == (u64)88, "tui/buffer/fill-no-style-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/fill-no-style-style");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].value == (u64)88, "tui/buffer/fill-no-style-value-3");
}

func buffer_fill_multi_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, CellStyle.Bold, CellStyle.Italic, CellStyle.Underline);
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-multi-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/fill-multi-italic");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/fill-multi-underline");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(buf.cells[(int)0].style == expected, "tui/buffer/fill-multi-combined");
}

// ─── Buffer clear ───────────────────────────────────────────────────────────

func buffer_clear() {
  let buf = Buffer((u32)3, (u32)2);
  buf.cells[(int)0].value = (u64)65;
  buf.cells[(int)0].bold(true);
  buf.cells[(int)3].value = (u64)66;
  buf.clear();
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/clear-value-0-0");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/clear-style-0-0");
  let idx01 = (int)((u64)1 * (u64)3 + (u64)0);
  check(buf.cells[idx01].value == (u64)0, "tui/buffer/clear-value-0-1");
  check(buf.cells[idx01].style == (u64)0, "tui/buffer/clear-style-0-1");
}

// ─── RgbColor 构造函数 ────────────────────────────────────────────────────

func rgb_color_default() {
  let c = RgbColor();
  check(c.r == (u8)0, "tui/rgb/ctor-default-r");
  check(c.g == (u8)0, "tui/rgb/ctor-default-g");
  check(c.b == (u8)0, "tui/rgb/ctor-default-b");
}

func rgb_color_ctor() {
  let c = RgbColor((u8)0xFF, (u8)0x80, (u8)0x40);
  check(c.r == (u8)0xFF, "tui/rgb/ctor-r");
  check(c.g == (u8)0x80, "tui/rgb/ctor-g");
  check(c.b == (u8)0x40, "tui/rgb/ctor-b");
}

func rgb_color_field_rw() {
  let c = RgbColor();
  c.r = (u8)10;
  c.g = (u8)20;
  c.b = (u8)30;
  check(c.r == (u8)10, "tui/rgb/field-rw-r");
  check(c.g == (u8)20, "tui/rgb/field-rw-g");
  check(c.b == (u8)30, "tui/rgb/field-rw-b");
}

// ─── Buffer draw 带前景色 ──────────────────────────────────────────────────

func buffer_draw_text_with_fg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-fg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-color");
  check(buf.cells[(int)0].backColor() == (u32)0, "tui/buffer/draw-text-fg-bg-default");
  check(buf.cells[(int)0].bold() == false, "tui/buffer/draw-text-fg-no-style");
}

func buffer_draw_text_with_fg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), CellStyle.Bold);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-style-color");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-style-bold");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-fg-style-bold-1");
}

// ─── Buffer draw 带前景色及背景色 ──────────────────────────────────────────

func buffer_draw_text_with_fg_bg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-bg");
}

func buffer_draw_text_with_fg_bg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF), CellStyle.Bold, CellStyle.Italic);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-style-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-style-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-bg-style-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/draw-text-fg-bg-style-italic");
}

// ─── Buffer draw 码点带颜色 ────────────────────────────────────────────────

func buffer_draw_codepoint_with_fg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00));
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-fg-value");
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-color");
}

func buffer_draw_codepoint_with_fg_bg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0xFF), CellStyle.Bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-bg-fg");
  check(buf.cells[idx].backColor() == (u32)0x00FFFF, "tui/buffer/draw-codepoint-fg-bg-bg");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-fg-bg-bold");
}

// ─── Buffer fill 带颜色 ────────────────────────────────────────────────────

func buffer_fill_with_fg_bg() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0x00), CellStyle.Bold);
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-fg-bg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x00FF00, "tui/buffer/fill-fg-bg-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-fg-bg-bold");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg-3");
}

// ─── Buffer 矩阵索引正确性 ──────────────────────────────────────────────────

func buffer_matrix_index() {
  let buf = Buffer((u32)5, (u32)4);
  // 在每个位置写入唯一的标识值
  var y: u32 = 0;
  while y < (u32)4 {
    var x: u32 = 0;
    while x < (u32)5 {
      let idx = (int)((u64)y * (u64)5 + (u64)x);
      buf.cells[idx].value = (u64)((u64)y * (u64)100 + (u64)x);
      x += (u32)1;
    }
    y += (u32)1;
  }
  // 验证读取
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/matrix-0-0");
  check(buf.cells[(int)4].value == (u64)4, "tui/buffer/matrix-4-0");
  let idx01 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx01].value == (u64)100, "tui/buffer/matrix-0-1");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)203, "tui/buffer/matrix-3-2");
  let idx34 = (int)((u64)3 * (u64)5 + (u64)4);
  check(buf.cells[idx34].value == (u64)304, "tui/buffer/matrix-4-3");
}

// ─── Screen 基础结构 ───────────────────────────────────────────────────────

func screen_ctor() {
  let scr = Screen((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/ctor-width");
  check(sz.item2 == (u32)5, "tui/screen/ctor-height");
}

func screen_buffer_returns_back() {
  let scr = Screen((u32)10, (u32)5);
  let buf = scr.buffer();
  // buffer() 返回的 Buffer 可正常绘制
  buf.draw((u32)0, (u32)0, "Hi");
  check(buf.cells[(int)0].value == (u64)72, "tui/screen/buffer-draw-h");
  check(buf.cells[(int)1].value == (u64)105, "tui/screen/buffer-draw-i");
}

func screen_clear() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.clear();
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/clear-0");
  check(scr.buffer().cells[(int)1].value == (u64)0, "tui/screen/clear-1");
}

func screen_clear_screen_only_no_wipe_buffer() {
  // clearScreen() 仅向 output 追加清屏序列，不清空 back 缓冲区
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.clearScreen();
  // back 缓冲区内容应保留
  check(scr.buffer().cells[(int)0].value == (u64)65, "tui/screen/clear-screen-keep-a");
  check(scr.buffer().cells[(int)1].value == (u64)66, "tui/screen/clear-screen-keep-b");
}

func screen_clear_screen_emits_clear_sequence() {
  // clearScreen() 后 buildPatchString() 应包含清屏序列 \x1b[2J\x1b[H
  let scr = Screen((u32)5, (u32)2);
  scr.clearScreen();
  let out = scr.buildPatchString();
  check(out.contains("\x1b[2J\x1b[H"), "tui/screen/clear-screen-emits-seq");
}

func screen_render_empty_no_diff() {
  let scr = Screen((u32)5, (u32)2);
  // front 和 back 都是空白，buildPatchString() 应返回空字符串（无差异）
  let out = scr.buildPatchString();
  check(out.length() == (int)0, "tui/screen/render-empty-no-diff");
}

func screen_render_full_diff() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  // 第一次 buildPatchString，front 全空白，back 有内容 → 应输出差异序列
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/render-full-diff-nonempty");
  // 第二次 buildPatchString，front 已同步 → 应无差异
  let out2 = scr.buildPatchString();
  check(out2.length() == (int)0, "tui/screen/render-after-sync-no-diff");
}

func screen_render_cursor_position() {
  let scr = Screen((u32)10, (u32)5);
  // 在 (2, 1) 处绘制
  scr.buffer().draw((u32)2, (u32)1, (u64)65);
  let out = scr.buildPatchString();
  // 应包含光标定位序列 \x1b[2;3H（行=2, 列=3，1-based）
  check(out.contains("\x1b[2;3H"), "tui/screen/render-cursor-position");
}

func screen_render_codepoint_output() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, (u64)65);  // 'A'
  let out = scr.buildPatchString();
  check(out.contains("A"), "tui/screen/render-codepoint-ascii");
}

func screen_render_codepoint_zero_to_space() {
  let scr = Screen((u32)5, (u32)2);
  // 先绘制非零内容并 buildPatchString 同步到 front
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.buildPatchString();
  // 清空 back 为码点 0，buildPatchString 时码点 0 应输出空格
  scr.buffer().fill((u64)0);
  let out = scr.buildPatchString();
  check(out.contains(" "), "tui/screen/render-codepoint-zero-space");
}

func screen_render_sgr_reset() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold);
  let out = scr.buildPatchString();
  // 渲染结束后应重置 SGR
  check(out.contains("\x1b[0m"), "tui/screen/render-sgr-reset");
}

func screen_render_sgr_bold() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold);
  let out = scr.buildPatchString();
  // SGR 序列应包含 bold (1)
  check(out.contains("\x1b[1m") || out.contains(";1m"), "tui/screen/render-sgr-bold");
}

func screen_render_sgr_fg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg-color");
}

func screen_render_sgr_fg_bg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X",
    RgbColor((u8)0xFF, (u8)0x00, (u8)0x00),
    RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0 和背景色 48;2;0;0;255
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg");
  check(out.contains("48;2;0;0;255"), "tui/screen/render-sgr-bg");
}

func screen_render_sgr_multi_style() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold, CellStyle.Italic, CellStyle.Underline);
  let out = scr.buildPatchString();
  // SGR 应包含 1;3;4
  check(out.contains("1"), "tui/screen/render-sgr-multi-bold");
  check(out.contains("3"), "tui/screen/render-sgr-multi-italic");
  check(out.contains("4"), "tui/screen/render-sgr-multi-underline");
}

func screen_render_partial_diff() {
  let scr = Screen((u32)10, (u32)2);
  // 第一次绘制 + buildPatchString
  scr.buffer().draw((u32)0, (u32)0, "Hello");
  let out1 = scr.buildPatchString();
  check(out1.length() > (int)0, "tui/screen/partial-diff-first");

  // 只修改一个 cell
  scr.buffer().draw((u32)0, (u32)0, (u64)74);  // 'J'
  let out2 = scr.buildPatchString();
  // 应只包含一个 cell 的差异，输出应比第一次短
  check(out2.length() < out1.length(), "tui/screen/partial-diff-second-shorter");
  check(out2.contains("J"), "tui/screen/partial-diff-second-contains-j");
}

func screen_render_no_sgr_for_unchanged_style() {
  let scr = Screen((u32)10, (u32)2);
  // 绘制两个连续 cell，相同样式
  scr.buffer().draw((u32)0, (u32)0, "AB", CellStyle.Bold);
  let out = scr.buildPatchString();
  // 应只发射一次 SGR bold（统计 "\x1b[" 后含 "1" 的 SGR 序列出现次数）
  // 验证：输出中 "1m" 或 ";1m" 只出现一次（不算最终 \x1b[0m）
  let resetSeq = "\x1b[0m";
  let withoutReset = out.replace(resetSeq, "");
  // bold SGR 序列 "\x1b[" 开头且以 "m" 结尾，包含 "1"
  check(withoutReset.contains("1m"), "tui/screen/no-sgr-repeat-bold-present");
}

func screen_resize() {
  let scr = Screen((u32)5, (u32)3);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  scr.buildPatchString();  // 同步 front

  // resize 后尺寸应更新
  scr.resize((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/resize-width");
  check(sz.item2 == (u32)5, "tui/screen/resize-height");

  // resize 后 back 为空白
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/resize-back-cleared");

  // resize 后 front 也清空，绘制新内容后 buildPatchString 应全量重绘
  scr.buffer().draw((u32)0, (u32)0, "X");
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/resize-render-full");
  check(out.contains("X"), "tui/screen/resize-render-contains-x");
}

func screen_render_unicode_chinese() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "中");
  let out = scr.buildPatchString();
  check(out.contains("中"), "tui/screen/render-unicode-chinese");
}

func screen_render_unicode_emoji() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "😀");
  let out = scr.buildPatchString();
  check(out.contains("😀"), "tui/screen/render-unicode-emoji");
}

// ─── TuiApp 构造与字段初始化 ─────────────────────────────────────────────

func tuiapp_ctor_no_fds() {
  let app = TuiApp();
  // 构造后未初始化状态
  check(app.isInitialized() == false, "tui/app/ctor-initialized");
  check(app.isRunning() == false, "tui/app/ctor-running");
  // screen 在字段声明处显式绑定为零尺寸实例，init() 后再调整为终端尺寸
  let size = app.screen.size();
  check(size.item1 == 0, "tui/app/ctor-screen-width");
  check(size.item2 == 0, "tui/app/ctor-screen-height");
}

func tuiapp_ctor_with_fds() {
  let fds: i32[!] = i32[:(int)2];
  fds[0] = (i32)3;
  fds[1] = (i32)4;
  let app = TuiApp((i32[])fds);
  check(app.isInitialized() == false, "tui/app/ctor-fds-initialized");
  let size = app.screen.size();
  check(size.item1 == 0, "tui/app/ctor-fds-screen-width");
  check(size.item2 == 0, "tui/app/ctor-fds-screen-height");
}

// ─── exit() 幂等性（不依赖 TTY 初始化） ──────────────────────────────────

func tuiapp_exit_idempotent_uninit() {
  let app = TuiApp();
  // 未 init 直接 exit，不应抛异常
  app.exit();
  app.exit();
  check(app.isInitialized() == false, "tui/app/exit-idempotent-uninit");
}

// ─── render() 空帧不抛异常（不依赖 TTY 初始化） ──────────────────────────

func tuiapp_render_empty_no_throw() {
  let app = TuiApp();
  // 未 init 状态下 render()：resizeRequested=false，直接 buildPatchBytes + write
  // 空白 Screen 的 buildPatchBytes 返回空数组，不触发 write，不会抛异常
  var caught = false;
  try app.render() catch ex: string { caught = true; };
  check(caught == false, "tui/app/render-empty-no-throw");
}

// ─── render() 有内容输出（不依赖 TTY 初始化，捕获 stdout 以避免 ANSI 污染终端） ─────────

func tuiapp_render_with_content() {
  let app = TuiApp();
  app.screen.resize(10, 5);
  app.screen.buffer().draw(0, 0, "Hi");
  // resizeRequested=false，直接 buildPatchBytes（有内容）+ write；
  // 保留真实 render/write 链路，但将 ANSI 字节捕获到测试管道中。
  var caught = false;
  let output = try captureStdout(() { app.render(); }, (int)64) catch ex: string {
    caught = true;
    "";
  };
  check(caught == false, "tui/app/render-with-content");
  check(output == "\x1b[1;1HH\x1b[1;2Hi", "tui/app/render-with-content-output");
}

func tuiapp_run_startup_clears_screen_keeps_buffer() {
  // run() 启动时应清屏但不擦除已绘制内容：构造后手动模拟 run() 启动渲染段
  // （不真正调用 run() 以免阻塞 poll）。验证 Screen.clearScreen() + hideCursor() + render() 的组合行为。
  let app = TuiApp();
  app.screen.resize(10, 5);
  app.screen.buffer().draw(0, 0, "Hi");
  // 模拟 run() 启动初始化渲染：clearScreen + hideCursor + buildPatchString
  app.screen.clearScreen();
  app.screen.hideCursor();
  let out = app.screen.buildPatchString();
  // 应包含清屏序列
  check(out.contains("\x1b[2J\x1b[H"), "tui/app/run-startup-clear-seq");
  // 应包含隐藏光标序列
  check(out.contains("\x1b[?25l"), "tui/app/run-startup-hide-cursor");
  // 应包含首帧 diff（Hi 内容）
  check(out.contains("Hi"), "tui/app/run-startup-first-frame-content");
  // back 缓冲区内容应保留（clearScreen 不清缓冲区）
  check(app.screen.buffer().cells[(int)0].value == (u64)72, "tui/app/run-startup-keep-buffer");
}

func tuiapp_run_drains_stdin_and_exit_stops() {
  // 阶段四补充：run() 将 stdin 纳入 poll 监听集合并在 POLLIN 时读取丢弃（防 busy-loop），
  // 退出由 exit() 置 running=false。此处不真正调用 run()（会阻塞 poll），验证退出机制：
  // 构造 TuiApp → 手动设 running=true → exit() 应置 running=false，证明循环可正常终止。
  let app = TuiApp();
  // exit() 未 init 时幂等，running 本为 false
  check(app.isRunning() == false, "tui/app/drain-before-exit");
  // 再次 exit 确认幂等（退出机制安全）
  app.exit();
  app.exit();
  check(app.isRunning() == false, "tui/app/drain-exit-running-false");
}

// ─── Phase 5: KeyEvent 测试 ──────────────────────────────────────────────

func key_mod_constants() {
  // MOD_CONTROL=1, MOD_ALT=2, MOD_SHIFT=4，位标志互不冲突
  check(MOD_CONTROL == (u8)1, "tui/key/mod-control-value");
  check(MOD_ALT == (u8)2, "tui/key/mod-alt-value");
  check(MOD_SHIFT == (u8)4, "tui/key/mod-shift-value");
  check((MOD_CONTROL | MOD_ALT | MOD_SHIFT) == (u8)7, "tui/key/mod-combined");
}

func key_special_key_enum() {
  // SpecialKey 枚举值通过 KeyEvent 构造间接验证可访问性
  let e1 = KeyEvent<i32>(SpecialKey.Escape, 0);
  let e2 = KeyEvent<i32>(SpecialKey.Tab, 0);
  let e3 = KeyEvent<i32>(SpecialKey.Enter, 0);
  let e4 = KeyEvent<i32>(SpecialKey.Backspace, 0);
  let e5 = KeyEvent<i32>(SpecialKey.ArrowUp, 0);
  let e6 = KeyEvent<i32>(SpecialKey.ArrowDown, 0);
  let e7 = KeyEvent<i32>(SpecialKey.ArrowLeft, 0);
  let e8 = KeyEvent<i32>(SpecialKey.ArrowRight, 0);
  let e9 = KeyEvent<i32>(SpecialKey.F1, 0);
  let e10 = KeyEvent<i32>(SpecialKey.F12, 0);
  check(e1.isPrintable() == false, "tui/key/special-escape");
  check(e2.isPrintable() == false, "tui/key/special-tab");
  check(e3.isPrintable() == false, "tui/key/special-enter");
  check(e4.isPrintable() == false, "tui/key/special-backspace");
  check(e5.isPrintable() == false, "tui/key/special-arrow-up");
  check(e6.isPrintable() == false, "tui/key/special-arrow-down");
  check(e7.isPrintable() == false, "tui/key/special-arrow-left");
  check(e8.isPrintable() == false, "tui/key/special-arrow-right");
  check(e9.isPrintable() == false, "tui/key/special-f1");
  check(e10.isPrintable() == false, "tui/key/special-f12");
}

func key_event_default_ctor() {
  // 默认构造：content=u32(0), mods=0
  let e = KeyEvent<i32>();
  check(e.mods == (u8)0, "tui/key/ctor-default-mods");
  check(e.isControl() == false, "tui/key/ctor-default-is-control");
  check(e.isShift() == false, "tui/key/ctor-default-is-shift");
  check(e.isPrintable() == false, "tui/key/ctor-default-is-printable");
}

func key_event_special_key() {
  // 构造特殊键事件
  let e = KeyEvent<i32>(SpecialKey.Enter, 0);
  check(e.isPrintable() == false, "tui/key/special-enter-is-printable");
  check(e.isControl() == false, "tui/key/special-enter-is-control");
  check(e.isShift() == false, "tui/key/special-enter-is-shift");
}

func key_event_printable() {
  // 构造可打印字符事件
  let e = KeyEvent<i32>((u32)0x61, 0);  // 'a'
  check(e.isPrintable() == true, "tui/key/printable-a-is-printable");
  check(e.isControl() == false, "tui/key/printable-a-is-control");
  check(e.isShift() == false, "tui/key/printable-a-is-shift");
}

func key_event_ctrl_combo() {
  // Ctrl+A：mods=MOD_CONTROL
  let e = KeyEvent<i32>((u32)0x01, MOD_CONTROL);
  check(e.isControl() == true, "tui/key/ctrl-a-is-control");
  check(e.isShift() == false, "tui/key/ctrl-a-is-shift");
  check(e.isPrintable() == true, "tui/key/ctrl-a-is-printable");
}

func key_event_shift_arrow() {
  // Shift+ArrowUp：mods=MOD_SHIFT
  let e = KeyEvent<i32>(SpecialKey.ArrowUp, MOD_SHIFT);
  check(e.isShift() == true, "tui/key/shift-arrow-is-shift");
  check(e.isControl() == false, "tui/key/shift-arrow-is-control");
  check(e.isPrintable() == false, "tui/key/shift-arrow-is-printable");
}

func key_event_target_binding() {
  let e = KeyEvent<i32>(SpecialKey.Enter, 0);
  check(e.hasTarget() == false, "tui/key/target-unbound");
  e.bindTarget(42);
  check(e.hasTarget() == true, "tui/key/target-bound");
  check(e.target == 42, "tui/key/target-value");
}

// ─── Phase 5: MouseEvent 测试 ────────────────────────────────────────────

func mouse_action_enum() {
  // 通过 MouseEvent 构造间接验证枚举值可访问
  let e1 = MouseEvent<i32>(MouseAction.Press, MouseButton.None, 0, 0, 0);
  let e2 = MouseEvent<i32>(MouseAction.Release, MouseButton.None, 0, 0, 0);
  let e3 = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 0, 0, 0);
  check(e1.action == MouseAction.Press, "tui/mouse/action-press");
  check(e2.action == MouseAction.Release, "tui/mouse/action-release");
  check(e3.action == MouseAction.Move, "tui/mouse/action-move");
}

func mouse_button_enum() {
  // 通过 MouseEvent 构造间接验证枚举值可访问
  let e1 = MouseEvent<i32>(MouseAction.Press, MouseButton.None, 0, 0, 0);
  let e2 = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  let e3 = MouseEvent<i32>(MouseAction.Press, MouseButton.Middle, 0, 0, 0);
  let e4 = MouseEvent<i32>(MouseAction.Press, MouseButton.Right, 0, 0, 0);
  let e5 = MouseEvent<i32>(MouseAction.Press, MouseButton.WheelUp, 0, 0, 0);
  let e6 = MouseEvent<i32>(MouseAction.Press, MouseButton.WheelDown, 0, 0, 0);
  check(e1.button == MouseButton.None, "tui/mouse/button-none");
  check(e2.button == MouseButton.Left, "tui/mouse/button-left");
  check(e3.button == MouseButton.Middle, "tui/mouse/button-middle");
  check(e4.button == MouseButton.Right, "tui/mouse/button-right");
  check(e5.button == MouseButton.WheelUp, "tui/mouse/button-wheel-up");
  check(e6.button == MouseButton.WheelDown, "tui/mouse/button-wheel-down");
}

func mouse_event_default_ctor() {
  let e = MouseEvent<i32>();
  check(e.action == MouseAction.Press, "tui/mouse/ctor-default-action");
  check(e.button == MouseButton.None, "tui/mouse/ctor-default-button");
  check(e.x == 0, "tui/mouse/ctor-default-x");
  check(e.y == 0, "tui/mouse/ctor-default-y");
  check(e.mods == (u8)0, "tui/mouse/ctor-default-mods");
  check(e.isControl() == false, "tui/mouse/ctor-default-is-control");
  check(e.isAlt() == false, "tui/mouse/ctor-default-is-alt");
  check(e.isShift() == false, "tui/mouse/ctor-default-is-shift");
}

func mouse_event_left_click() {
  let e = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 9, 4, 0);
  check(e.action == MouseAction.Press, "tui/mouse/left-click-action");
  check(e.button == MouseButton.Left, "tui/mouse/left-click-button");
  check(e.x == 9, "tui/mouse/left-click-x");
  check(e.y == 4, "tui/mouse/left-click-y");
  check(e.mods == (u8)0, "tui/mouse/left-click-mods");
}

func mouse_event_with_modifiers() {
  // SGR 鼠标：+4=Shift, +8=Alt, +16=Ctrl
  let mods: u8 = MOD_SHIFT | MOD_ALT | MOD_CONTROL;
  let e = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, mods);
  check(e.isShift() == true, "tui/mouse/mod-shift");
  check(e.isAlt() == true, "tui/mouse/mod-alt");
  check(e.isControl() == true, "tui/mouse/mod-control");
}

func mouse_event_move_action() {
  let e = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 5, 3, 0);
  check(e.action == MouseAction.Move, "tui/mouse/move-action");
  check(e.button == MouseButton.None, "tui/mouse/move-button-none");
}

func mouse_event_target_stop_and_lock() {
  let owner = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  check(owner.hasTarget() == false, "tui/mouse/target-unbound");
  check(owner.lock() == false, "tui/mouse/lock-rejects-unbound");
  check(owner.isStopped() == false, "tui/mouse/stop-default");
  owner.stop();
  check(owner.isStopped() == true, "tui/mouse/stop-set");

  owner.bindTarget(7);
  check(owner.hasTarget() == true, "tui/mouse/target-bound");
  check(owner.target == 7, "tui/mouse/target-value");
  check(owner.lock() == true, "tui/mouse/lock-first-owner");
  check(owner.lock() == true, "tui/mouse/lock-repeat-owner");
  check(owner.isLocked() == true, "tui/mouse/lock-state-set");
  check(MouseEvent<i32>.lockedTarget() == 7, "tui/mouse/locked-target-value");

  let competitor = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  competitor.bindTarget(9);
  check(competitor.lock() == false, "tui/mouse/lock-rejects-competitor");
  competitor.unlock();
  check(owner.isLocked() == true, "tui/mouse/unlock-rejects-competitor");

  let routed = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 0, 0, 0);
  routed.bindLockedTarget(MouseEvent<i32>.lockedTarget());
  check(routed.lock() == true, "tui/mouse/lock-routed-owner");
  routed.unlock();
  check(routed.isLocked() == false, "tui/mouse/unlock-owner");
}

func mouse_event_allows_window_outside_coordinates() {
  let event = MouseEvent<i32>(MouseAction.Move, MouseButton.None, -4, -2, 0);
  check(event.x == -4, "tui/mouse/window-outside-x");
  check(event.y == -2, "tui/mouse/window-outside-y");
}

func view_arrange_preserves_signed_geometry() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  view.style.position = Position.Absolute;
  view.style.x = -3;
  view.style.y = -2;
  view.style.width = 8;
  view.style.height = 5;

  view.arrange(manager);
  check(view.frame.x == -3, "tui/view/arrange-negative-x");
  check(view.frame.y == -2, "tui/view/arrange-negative-y");
  check(view.frame.width == 8, "tui/view/arrange-signed-width");
  check(view.frame.height == 5, "tui/view/arrange-signed-height");

  view.draw(manager);
  check(view.drawFrame.x == 0, "tui/view/draw-clip-negative-x");
  check(view.drawFrame.y == 0, "tui/view/draw-clip-negative-y");
  check(view.drawFrame.width == 5, "tui/view/draw-clip-negative-width");
  check(view.drawFrame.height == 3, "tui/view/draw-clip-negative-height");
}

func view_arrange_preserves_negative_percentage_offsets() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  let negativeQuarter: float = -0.25;
  let negativeHalf: float = -0.5;
  view.style.position = Position.Fixed;
  view.style.x = negativeQuarter;
  view.style.y = negativeHalf;
  view.style.width = -8;
  view.style.height = negativeHalf;

  view.arrange(manager);
  check(view.frame.x == -5, "tui/view/arrange-negative-percent-x");
  check(view.frame.y == -5, "tui/view/arrange-negative-percent-y");
  check(view.frame.width == 0, "tui/view/arrange-negative-width-zero");
  check(view.frame.height == 0, "tui/view/arrange-negative-height-zero");
}

func view_arrange_oversized_alignment_keeps_negative_origin() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  view.style.width = 30;
  view.style.height = 20;
  view.style.horizontalAlign = Align.Center;
  view.style.verticalAlign = Align.Center;

  view.arrange(manager);
  check(view.frame.x == -5, "tui/view/arrange-oversized-center-x");
  check(view.frame.y == -5, "tui/view/arrange-oversized-center-y");
  check(view.frame.width == 30, "tui/view/arrange-oversized-width");
  check(view.frame.height == 20, "tui/view/arrange-oversized-height");
}

func makeWidgetFrame(x: int, y: int, width: int, height: int): Rect {
  let frame = Rect();
  frame.x = x;
  frame.y = y;
  frame.width = width;
  frame.height = height;
  return frame;
}

func view_manager_mouse_target_lock_and_bubble() {
  let screen = Screen(40, 20);
  let manager = ViewManager(screen);
  let parent = Container();
  let child = View();
  let other = View();
  parent.addChild(child);
  manager.trace(parent, makeWidgetFrame(0, 0, 12, 12));
  manager.trace(child, makeWidgetFrame(2, 2, 4, 4));
  manager.trace(other, makeWidgetFrame(20, 2, 4, 4));

  var childDown = 0;
  var parentDown = 0;
  var childMove = 0;
  var parentMove = 0;
  var otherMove = 0;
  var targetStable = true;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    childDown += 1;
    targetStable = targetStable && event.hasTarget() &&
      event.target == (Widget)child;
    check(event.lock(), "tui/view/lock-hit-target");
  });
  parent.mouseDown.on((event: MouseEvent<Widget>) {
    parentDown += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  child.mouseMove.on((event: MouseEvent<Widget>) {
    childMove += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  parent.mouseMove.on((event: MouseEvent<Widget>) {
    parentMove += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  other.mouseMove.on((event: MouseEvent<Widget>) {
    otherMove += 1;
  });

  let press = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(press);
  check(childDown == 1, "tui/view/hit-child-down");
  check(parentDown == 1, "tui/view/bubble-parent-down");
  check(press.target == (Widget)child, "tui/view/press-target-child");
  check(press.isLocked(), "tui/view/press-lock-established");

  let competing = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 21, 3, 0);
  competing.bindTarget((Widget)other);
  check(competing.lock() == false, "tui/view/lock-cannot-be-stolen");
  competing.unlock();
  check(press.isLocked(), "tui/view/lock-cannot-be-foreign-unlocked");

  let outsideMove = MouseEvent<Widget>(MouseAction.Move, MouseButton.None, 21, 3, 0);
  manager.dispatchMouse(outsideMove);
  check(childMove == 1, "tui/view/locked-move-child");
  check(parentMove == 1, "tui/view/locked-move-bubbles");
  check(otherMove == 0, "tui/view/locked-move-skips-hit-test");
  check(outsideMove.target == (Widget)child, "tui/view/locked-move-target-child");
  check(targetStable, "tui/view/target-stable-during-bubble");

  child.mouseUp.on((event: MouseEvent<Widget>) {
    event.unlock();
  });
  let release = MouseEvent<Widget>(MouseAction.Release, MouseButton.Left, 21, 3, 0);
  manager.dispatchMouse(release);
  check(release.isLocked() == false, "tui/view/release-explicit-unlock");

  let unlockedMove = MouseEvent<Widget>(MouseAction.Move, MouseButton.None, 21, 3, 0);
  manager.dispatchMouse(unlockedMove);
  check(otherMove == 1, "tui/view/unlocked-move-hit-other");
  check(unlockedMove.target == (Widget)other, "tui/view/unlocked-move-target-other");

  parentDown = 0;
  var childAfterStop = 0;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    event.stop();
  });
  child.mouseDown.on((event: MouseEvent<Widget>) {
    if event.isStopped() {
      childAfterStop += 1;
    }
  });
  let stopped = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(stopped);
  check(stopped.isStopped(), "tui/view/stop-state-shared");
  check(childAfterStop == 1, "tui/view/stop-keeps-current-widget-listeners");
  check(parentDown == 0, "tui/view/stop-prevents-parent-bubble");
}

// ─── Phase 5: InputManager 测试 ──────────────────────────────────────────

// 模块级捕获变量（回调写入，测试读取验证）
seal var capturedKey: KeyEvent<i32> = KeyEvent<i32>();
seal var keyCaptured: bool = false;
seal var capturedMouse: MouseEvent<i32> = MouseEvent<i32>();
seal var mouseCaptured: bool = false;

func resetCaptures() {
  keyCaptured = false;
  mouseCaptured = false;
}

// 命名函数作为 onKey 回调
func captureKeyHandler(event: KeyEvent<i32>): void {
  capturedKey = event;
  keyCaptured = true;
}

// 命名函数作为 onMouse 回调
func captureMouseHandler(event: MouseEvent<i32>): void {
  capturedMouse = event;
  mouseCaptured = true;
}

func makeInputManager(): InputManager<i32> {
  resetCaptures();
  let mgr = InputManager<i32>();
  mgr.onKey = captureKeyHandler;
  mgr.onMouse = captureMouseHandler;
  return mgr;
}

func feedBytes(mgr: InputManager<i32>, bytes: byte[]) {
  let len = bytes.length();
  for var i: int = 0; i < len; i += 1 {
    mgr.feed((u8)bytes[i]);
  }
}

func input_printable_ascii() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x41);  // 'A'
  check(keyCaptured == true, "tui/input/printable-ascii-captured");
  check(capturedKey.isPrintable() == true, "tui/input/printable-ascii-is-printable");
  check(capturedKey.mods == (u8)0, "tui/input/printable-ascii-mods");
  check(capturedKey.hasTarget() == false, "tui/input/key-target-unbound");
}

func input_enter_key() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x0D);  // CR = Enter
  check(keyCaptured == true, "tui/input/enter-captured");
  check(capturedKey.isPrintable() == false, "tui/input/enter-not-printable");
}

func input_tab_key() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x09);  // HT = Tab
  check(keyCaptured == true, "tui/input/tab-captured");
  check(capturedKey.isPrintable() == false, "tui/input/tab-not-printable");
}

func input_backspace_bs() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x08);  // BS = Backspace
  check(keyCaptured == true, "tui/input/backspace-bs-captured");
  check(capturedKey.isPrintable() == false, "tui/input/backspace-bs-not-printable");
}

func input_backspace_del() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x7F);  // DEL = Backspace
  check(keyCaptured == true, "tui/input/backspace-del-captured");
  check(capturedKey.isPrintable() == false, "tui/input/backspace-del-not-printable");
}

func input_ctrl_c() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x03);  // Ctrl+C
  check(keyCaptured == true, "tui/input/ctrl-c-captured");
  check(capturedKey.isControl() == true, "tui/input/ctrl-c-is-control");
  check(capturedKey.isPrintable() == true, "tui/input/ctrl-c-is-printable");
}

func input_ctrl_a() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x01);  // Ctrl+A
  check(keyCaptured == true, "tui/input/ctrl-a-captured");
  check(capturedKey.isControl() == true, "tui/input/ctrl-a-is-control");
}

func input_ctrl_h_is_backspace_not_control() {
  // Ctrl+H = 0x08 = BS，优先映射为 SpecialKey.Backspace，不设 MOD_CONTROL
  let mgr = makeInputManager();
  mgr.feed((u8)0x08);
  check(keyCaptured == true, "tui/input/ctrl-h-captured");
  check(capturedKey.isControl() == false, "tui/input/ctrl-h-not-control");
  check(capturedKey.isPrintable() == false, "tui/input/ctrl-h-not-printable");
}

func input_ctrl_m_is_enter_not_control() {
  // Ctrl+M = 0x0D = CR，优先映射为 SpecialKey.Enter，不设 MOD_CONTROL
  let mgr = makeInputManager();
  mgr.feed((u8)0x0D);
  check(keyCaptured == true, "tui/input/ctrl-m-captured");
  check(capturedKey.isControl() == false, "tui/input/ctrl-m-not-control");
  check(capturedKey.isPrintable() == false, "tui/input/ctrl-m-not-printable");
}

func input_arrow_up() {
  let mgr = makeInputManager();
  let seq: byte[!] = byte[:3];
  seq[0] = (byte)0x1B;
  seq[1] = (byte)0x5B;
  seq[2] = (byte)0x41;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/arrow-up-captured");
  check(capturedKey.isPrintable() == false, "tui/input/arrow-up-not-printable");
  check(capturedKey.mods == (u8)0, "tui/input/arrow-up-mods-zero");
}

