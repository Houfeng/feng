func cell_strikethrough_rw() {
  let c = Cell((u64)65);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-init");
  c.strikeThrough(true);
  check(c.strikeThrough() == true, "tui/cell/strikethrough-set-true");
  c.strikeThrough(false);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-set-false");
}

// ─── 样式组合 ──────────────────────────────────────────────────────────────

func cell_style_combination() {
  let c = Cell((u64)65);
  c.bold(true);
  c.italic(true);
  c.underline(true);
  check(c.bold() == true, "tui/cell/combination-bold");
  check(c.italic() == true, "tui/cell/combination-italic");
  check(c.underline() == true, "tui/cell/combination-underline");
  check(c.dim() == false, "tui/cell/combination-dim-false");
  check(c.blink() == false, "tui/cell/combination-blink-false");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(c.style == expected, "tui/cell/combination-style-value");
}

func cell_style_with_colors() {
  let c = Cell((u64)65);
  c.foreColor((u32)0xFFFFFF);
  c.backColor((u32)0x000000);
  c.bold(true);
  check(c.foreColor() == (u32)0xFFFFFF, "tui/cell/style-colors-fg");
  check(c.backColor() == (u32)0x000000, "tui/cell/style-colors-bg");
  check(c.bold() == true, "tui/cell/style-colors-bold");
  check(c.value == (u64)65, "tui/cell/style-colors-value");
}

// ─── Cell 直接字段读写（open var） ──────────────────────────────────────────

func cell_field_rw() {
  let c = Cell();
  check(c.value == (u64)0, "tui/cell/field-rw-value-init");
  check(c.style == (u64)0, "tui/cell/field-rw-style-init");
  c.value = TextUtil.encodeCellValue("中");
  c.style = Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE;
  check(c.value == TextUtil.encodeCellValue("中"),
    "tui/cell/field-rw-value-write");
  check(c.style == (Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE), "tui/cell/field-rw-style-write");
  check(c.bold() == true, "tui/cell/field-rw-bold");
  check(c.underline() == true, "tui/cell/field-rw-underline");
  c.value = (u64)65;
  c.style = (u64)0;
  check(c.value == (u64)65, "tui/cell/field-rw-value-overwrite");
  check(c.style == (u64)0, "tui/cell/field-rw-style-clear");
  check(c.bold() == false, "tui/cell/field-rw-bold-cleared");
}

// ─── Buffer 构造函数 ──────────────────────────────────────────────────────

func buffer_ctor() {
  let buf = Buffer((u32)10, (u32)5);
  check(buf.width == (u32)10, "tui/buffer/ctor-width");
  check(buf.height == (u32)5, "tui/buffer/ctor-height");
  check(buf.cells.length() == (int)50, "tui/buffer/ctor-cells-length");
}

func buffer_default_cells() {
  let buf = Buffer((u32)3, (u32)2);
  // 直接通过 cells 数组读取默认值
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/default-cells-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/default-cells-style");
  let idx = (int)((u64)1 * (u64)3 + (u64)1); // y=1, x=1
  check(buf.cells[idx].value == (u64)0, "tui/buffer/default-cells-value-1-1");
  check(buf.cells[idx].style == (u64)0, "tui/buffer/default-cells-style-1-1");
}

// ─── Buffer 直接操作 cells（就地修改） ───────────────────────────────────────

func buffer_cells_in_place_modify() {
  let buf = Buffer((u32)4, (u32)4);
  let idx = (int)((u64)1 * (u64)4 + (u64)2);  // y=1, x=2
  buf.cells[idx].value = (u64)65;
  buf.cells[idx].bold(true);
  buf.cells[idx].foreColor((u32)0xFF0000);

  check(buf.cells[idx].value == (u64)65, "tui/buffer/in-place-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/in-place-bold");
  check(buf.cells[idx].foreColor() == (u32)0xFF0000, "tui/buffer/in-place-fg");
}

// ─── Buffer draw 文本（单行） ────────────────────────────────────────────────

func buffer_draw_text_ascii() {
  let buf = Buffer((u32)10, (u32)3);
  buf.draw((u32)0, (u32)0, "Hello");
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-ascii-h");
  check(buf.cells[(int)1].value == (u64)101, "tui/buffer/draw-text-ascii-e");
  check(buf.cells[(int)4].value == (u64)111, "tui/buffer/draw-text-ascii-o");
  // 未写入的位置应保持默认
  check(buf.cells[(int)5].value == (u64)0, "tui/buffer/draw-text-ascii-after");
}

func buffer_draw_text_chinese() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "中文");
  check(buf.cells[(int)0].value == TextUtil.encodeCellValue("中"),
    "tui/buffer/draw-text-chinese-0");
  check(buf.cells[(int)1].value == Cell.CONTINUATION,
    "tui/buffer/draw-text-chinese-0-continuation");
  check(buf.cells[(int)2].value == TextUtil.encodeCellValue("文"),
    "tui/buffer/draw-text-chinese-1");
  check(buf.cells[(int)3].value == Cell.CONTINUATION,
    "tui/buffer/draw-text-chinese-1-continuation");
}

func buffer_draw_text_emoji() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "😀");
  check(buf.cells[(int)0].value == TextUtil.encodeCellValue("😀"),
    "tui/buffer/draw-text-emoji");
  check(buf.cells[(int)1].value == Cell.CONTINUATION,
    "tui/buffer/draw-text-emoji-continuation");
}

/** 验证 TextUtil 在 Unicode locale 下返回终端显示列宽。 */
func text_util_measure_cell_width() {
  check(TextUtil.measureCellWidth((u32)65) == 1,
    "tui/text-util/ascii-width");
  check(TextUtil.measureCellWidth((u32)0x4E2D) == 2,
    "tui/text-util/chinese-width");
  check(TextUtil.measureCellWidth((u32)0x1F600) == 2,
    "tui/text-util/emoji-width");
  check(TextUtil.measureCellWidth("中文") == 4,
    "tui/text-util/string-width");
  check(TextUtil.measureCellWidth("é") == 1,
    "tui/text-util/combining-grapheme-width");
  check(TextUtil.encodeCellValue("é") == (u64)0x81CC65,
    "tui/text-util/combining-grapheme-encoding");
  check(TextUtil.cellValueByteLength(TextUtil.encodeCellValue("é")) == 3,
    "tui/text-util/combining-grapheme-byte-length");
  check(TextUtil.cellValueByteLength(TextUtil.encodeCellValue("👍🏻")) == 8 &&
    TextUtil.measureCellValueWidth(TextUtil.encodeCellValue("👍🏻")) == 2,
    "tui/text-util/full-inline-cell-capacity");
}

/** 验证 Buffer 将 8 字节内的组合 grapheme 完整保存到一个主 Cell。 */
func buffer_draw_combining_grapheme_inline() {
  let buf = Buffer((u32)3, (u32)1);
  buf.draw((u32)0, (u32)0, "éX");
  check(buf.cells[0].value == TextUtil.encodeCellValue("é") &&
    buf.cells[1].value == (u64)88 && buf.cells[2].value == (u64)0,
    "tui/buffer/combining-grapheme-inline-cell");

  let full = Buffer((u32)3, (u32)1);
  full.draw((u32)0, (u32)0, "👍🏻");
  check(full.cells[0].value == TextUtil.encodeCellValue("👍🏻") &&
    full.cells[1].value == Cell.CONTINUATION &&
    full.cells[2].value == (u64)0,
    "tui/buffer/full-capacity-grapheme-inline-cell");
}

/** 验证 Buffer 覆盖宽字符任一列时会整体清理旧占用关系。 */
func buffer_wide_glyph_occupancy_overwrite() {
  let buf = Buffer((u32)5, (u32)1);
  buf.draw((u32)0, (u32)0, "中文");
  buf.draw((u32)1, (u32)0, (u64)88);
  check(buf.cells[0].value == (u64)0 &&
    buf.cells[1].value == (u64)88,
    "tui/buffer/overwrite-wide-continuation-clears-lead");
  check(buf.cells[2].value == TextUtil.encodeCellValue("文") &&
    buf.cells[3].value == Cell.CONTINUATION,
    "tui/buffer/overwrite-wide-continuation-keeps-next-glyph");

  buf.draw((u32)2, (u32)0, (u64)89);
  check(buf.cells[2].value == (u64)89 &&
    buf.cells[3].value == (u64)0,
    "tui/buffer/overwrite-wide-lead-clears-continuation");

  buf.draw((u32)0, (u32)0, "ABCD");
  buf.draw((u32)1, (u32)0, "中");
  check(buf.cells[0].value == (u64)65 &&
    buf.cells[1].value == TextUtil.encodeCellValue("中") &&
    buf.cells[2].value == Cell.CONTINUATION &&
    buf.cells[3].value == (u64)68,
    "tui/buffer/wide-overwrites-complete-target-columns");
}

func buffer_draw_text_clip() {
  let buf = Buffer((u32)4, (u32)2);
  // 在宽度为 4 的行写 6 个字符，后 2 个应被裁剪
  buf.draw((u32)0, (u32)0, "ABCDEF");
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-text-clip-a");
  check(buf.cells[(int)3].value == (u64)68, "tui/buffer/draw-text-clip-d");
  // 第 5 个字符 'E' (69) 应被裁剪，不写入到下一行
  check(buf.cells[(int)4].value == (u64)0, "tui/buffer/draw-text-clip-next-row");
}

func buffer_draw_text_offset_and_clip() {
  let buf = Buffer((u32)5, (u32)2);
  // 从 x=2 开始写，只有 3 个位置可用
  buf.draw((u32)2, (u32)0, "ABCDE");
  check(buf.cells[(int)2].value == (u64)65, "tui/buffer/draw-text-offset-a");
  check(buf.cells[(int)4].value == (u64)67, "tui/buffer/draw-text-offset-c");
}

func buffer_draw_text_empty() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)0, "");
  // 空字符串不改变任何 Cell
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-empty");
}

func buffer_draw_text_y_out_of_bounds() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)5, "Hello");
  // 行越界，整行不写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-y-oob");
}

func buffer_draw_text_with_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", CellStyle.Bold, CellStyle.Underline);
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-style-value");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-style-bold");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/draw-text-style-underline");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-style-bold-1");
}

// ─── Buffer draw 矩形文本（自动换行） ──────────────────────────────────────

func buffer_draw_rect_text_wrap() {
  let buf = Buffer((u32)5, (u32)3);
  // 在 5x2 矩形内绘制 "ABCDEFGH" (8字符)，应自动换行
  buf.draw((u32)0, (u32)0, (u32)5, (u32)2, "ABCDEFGH");
  // 第一行: A B C D E
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-wrap-0a");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-wrap-0e");
  // 第二行: F G H
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-wrap-1f");
  let idx12 = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx12].value == (u64)72, "tui/buffer/draw-rect-wrap-1h");
  // 第三行不应被写入
  let idx20 = (int)((u64)2 * (u64)5 + (u64)0);
  check(buf.cells[idx20].value == (u64)0, "tui/buffer/draw-rect-wrap-2-empty");
}

func buffer_draw_rect_text_clip_height() {
  let buf = Buffer((u32)5, (u32)2);
  // 在 5x3 矩形内绘制，但 Buffer 只有 2 行，第 3 行应被裁剪
  buf.draw((u32)0, (u32)0, (u32)5, (u32)3, "ABCDEFGHIJKLMN");
  // 第一行写入 5 个
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-clip-h-0");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-clip-h-4");
  // 第二行写入 5 个
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-clip-h-1f");
  let idx14 = (int)((u64)1 * (u64)5 + (u64)4);
  check(buf.cells[idx14].value == (u64)74, "tui/buffer/draw-rect-clip-h-1j");
}

// ─── Buffer draw 单码点 ────────────────────────────────────────────────────

func buffer_draw_cell_value() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)2, (u32)1, (u64)65, CellStyle.Bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-bold");
}

func buffer_draw_cell_value_out_of_bounds() {
  let buf = Buffer((u32)3, (u32)3);
  buf.draw((u32)5, (u32)0, (u64)65);
  buf.draw((u32)0, (u32)5, (u64)65);
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-codepoint-oob");
}

// ─── Buffer draw 矩形码点填充 ──────────────────────────────────────────────

func buffer_draw_rect_cell_value() {
  let buf = Buffer((u32)5, (u32)4);
  buf.draw((u32)1, (u32)1, (u32)3, (u32)2, (u64)65, CellStyle.Italic);
  // 矩形内 (1,1) 到 (3,2) 应被填充
  let idx11 = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx11].value == (u64)65, "tui/buffer/draw-rect-cp-11");
  let idx13 = (int)((u64)1 * (u64)5 + (u64)3);
  check(buf.cells[idx13].value == (u64)65, "tui/buffer/draw-rect-cp-13");
  let idx21 = (int)((u64)2 * (u64)5 + (u64)1);
  check(buf.cells[idx21].value == (u64)65, "tui/buffer/draw-rect-cp-21");
  check(buf.cells[idx21].italic() == true, "tui/buffer/draw-rect-cp-italic");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)65, "tui/buffer/draw-rect-cp-23");
  // 矩形外不应被写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-rect-cp-outside-0");
  let idx33 = (int)((u64)3 * (u64)5 + (u64)3);
  check(buf.cells[idx33].value == (u64)0, "tui/buffer/draw-rect-cp-outside-33");
}

// ─── Buffer fill ────────────────────────────────────────────────────────────

func buffer_fill() {
  let buf = Buffer((u32)3, (u32)3);
  buf.fill((u64)65, CellStyle.Bold);
  // 检查多个位置
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-0-0");
  let idx22 = (int)((u64)2 * (u64)3 + (u64)2);
  check(buf.cells[idx22].value == (u64)65, "tui/buffer/fill-2-2");
  let idx11 = (int)((u64)1 * (u64)3 + (u64)1);
  check(buf.cells[idx11].bold() == true, "tui/buffer/fill-bold");
}

func buffer_fill_no_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)88);
  check(buf.cells[(int)0].value == (u64)88, "tui/buffer/fill-no-style-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/fill-no-style-style");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].value == (u64)88, "tui/buffer/fill-no-style-value-3");
}

func buffer_fill_multi_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, CellStyle.Bold, CellStyle.Italic, CellStyle.Underline);
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-multi-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/fill-multi-italic");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/fill-multi-underline");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(buf.cells[(int)0].style == expected, "tui/buffer/fill-multi-combined");
}

// ─── Buffer clear ───────────────────────────────────────────────────────────

func buffer_clear() {
  let buf = Buffer((u32)3, (u32)2);
  buf.cells[(int)0].value = (u64)65;
  buf.cells[(int)0].bold(true);
  buf.cells[(int)3].value = (u64)66;
  buf.clear();
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/clear-value-0-0");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/clear-style-0-0");
  let idx01 = (int)((u64)1 * (u64)3 + (u64)0);
  check(buf.cells[idx01].value == (u64)0, "tui/buffer/clear-value-0-1");
  check(buf.cells[idx01].style == (u64)0, "tui/buffer/clear-style-0-1");
}

// ─── RgbColor 构造函数 ────────────────────────────────────────────────────

func rgb_color_default() {
  let c = RgbColor();
  check(c.r == (u8)0, "tui/rgb/ctor-default-r");
  check(c.g == (u8)0, "tui/rgb/ctor-default-g");
  check(c.b == (u8)0, "tui/rgb/ctor-default-b");
}

func rgb_color_ctor() {
  let c = RgbColor((u8)0xFF, (u8)0x80, (u8)0x40);
  check(c.r == (u8)0xFF, "tui/rgb/ctor-r");
  check(c.g == (u8)0x80, "tui/rgb/ctor-g");
  check(c.b == (u8)0x40, "tui/rgb/ctor-b");
}

func rgb_color_field_rw() {
  let c = RgbColor();
  c.r = (u8)10;
  c.g = (u8)20;
  c.b = (u8)30;
  check(c.r == (u8)10, "tui/rgb/field-rw-r");
  check(c.g == (u8)20, "tui/rgb/field-rw-g");
  check(c.b == (u8)30, "tui/rgb/field-rw-b");
}

func rgb_color_alpha_constructors() {
  let defaults = RgbColor();
  let rgb = RgbColor((u8)1, (u8)2, (u8)3);
  let transparent = RgbColor((u8)4, (u8)5, (u8)6, (u8)0);
  let nonzero = RgbColor((u8)7, (u8)8, (u8)9, (u8)200);
  check(defaults.a == (u8)255, "tui/rgb/default-alpha-opaque");
  check(rgb.a == (u8)255, "tui/rgb/rgb-alpha-opaque");
  check(transparent.r == (u8)4 && transparent.g == (u8)5 &&
    transparent.b == (u8)6 && transparent.a == (u8)0,
    "tui/rgb/rgba-transparent-constructor");
  check(nonzero.a == (u8)200, "tui/rgb/rgba-nonzero-alpha");
}

func buffer_draw_alpha_color_channels() {
  let buf = Buffer((u32)3, (u32)1);
  buf.draw((u32)0, (u32)0, (u64)65,
    RgbColor((u8)0x11, (u8)0x22, (u8)0x33),
    RgbColor((u8)0x44, (u8)0x55, (u8)0x66), CellStyle.Bold);

  let transparent = RgbColor((u8)0, (u8)0, (u8)0, (u8)0);
  buf.draw((u32)0, (u32)0, (u64)66,
    transparent, transparent, CellStyle.Italic);
  check(buf.cells[0].value == (u64)66,
    "tui/buffer/transparent-colors-write-value");
  check(buf.cells[0].foreColor() == (u32)0x112233 &&
    buf.cells[0].backColor() == (u32)0x445566,
    "tui/buffer/transparent-colors-preserve-channels");
  check(!buf.cells[0].bold() && buf.cells[0].italic(),
    "tui/buffer/transparent-colors-replace-flags");

  buf.draw((u32)0, (u32)0, (u64)67,
    RgbColor((u8)0xAA, (u8)0xBB, (u8)0xCC, (u8)2),
    RgbColor((u8)0x01, (u8)0x02, (u8)0x03, (u8)200));
  check(buf.cells[0].foreColor() == (u32)0xAABBCC &&
    buf.cells[0].backColor() == (u32)0x010203,
    "tui/buffer/nonzero-alpha-is-opaque");

  buf.draw((u32)0, (u32)0, (u64)68, none, none);
  check(buf.cells[0].foreColor() == (u32)0 &&
    buf.cells[0].backColor() == (u32)0,
    "tui/buffer/none-remains-terminal-default");
}

func buffer_draw_wide_transparent_background() {
  let buf = Buffer((u32)3, (u32)1);
  buf.draw((u32)0, (u32)0, (u64)88, none,
    RgbColor((u8)0x12, (u8)0x34, (u8)0x56));
  buf.draw((u32)0, (u32)0, TextUtil.encodeCellValue("中"),
    RgbColor((u8)0xAB, (u8)0xCD, (u8)0xEF),
    RgbColor((u8)0, (u8)0, (u8)0, (u8)0));
  check(buf.cells[0].value == TextUtil.encodeCellValue("中") &&
    buf.cells[1].value == Cell.CONTINUATION,
    "tui/buffer/wide-transparent-occupancy");
  check(buf.cells[0].backColor() == (u32)0x123456 &&
    buf.cells[1].backColor() == (u32)0x123456,
    "tui/buffer/wide-transparent-background");
}

func buffer_draw_explicit_black_and_transparency() {
  let buf = Buffer((u32)2, (u32)1);
  let black = RgbColor((u8)0, (u8)0, (u8)0);
  let transparent = RgbColor((u8)0, (u8)0, (u8)0, (u8)0);
  buf.draw((u32)0, (u32)0, (u64)65, black, black);
  check((buf.cells[0].style & Cell.HAS_FG) != (u64)0 &&
    (buf.cells[0].style & Cell.HAS_BG) != (u64)0,
    "tui/buffer/explicit-black-presence");

  buf.draw((u32)0, (u32)0, (u64)66, transparent, transparent);
  check((buf.cells[0].style & Cell.HAS_FG) != (u64)0 &&
    (buf.cells[0].style & Cell.HAS_BG) != (u64)0,
    "tui/buffer/transparent-preserves-black-presence");

  buf.draw((u32)0, (u32)0, (u64)67, none, none);
  check((buf.cells[0].style & (Cell.HAS_FG | Cell.HAS_BG)) == (u64)0,
    "tui/buffer/default-clears-color-presence");
}

// ─── Buffer draw 带前景色 ──────────────────────────────────────────────────

func buffer_draw_text_with_fg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-fg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-color");
  check(buf.cells[(int)0].backColor() == (u32)0, "tui/buffer/draw-text-fg-bg-default");
  check(buf.cells[(int)0].bold() == false, "tui/buffer/draw-text-fg-no-style");
}

func buffer_draw_text_with_fg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), CellStyle.Bold);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-style-color");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-style-bold");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-fg-style-bold-1");
}

// ─── Buffer draw 带前景色及背景色 ──────────────────────────────────────────

func buffer_draw_text_with_fg_bg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-bg");
}

func buffer_draw_text_with_fg_bg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF), CellStyle.Bold, CellStyle.Italic);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-style-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-style-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-bg-style-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/draw-text-fg-bg-style-italic");
}

// ─── Buffer draw 码点带颜色 ────────────────────────────────────────────────

func buffer_draw_cell_value_with_fg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00));
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-fg-value");
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-color");
}

func buffer_draw_cell_value_with_fg_bg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0xFF), CellStyle.Bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-bg-fg");
  check(buf.cells[idx].backColor() == (u32)0x00FFFF, "tui/buffer/draw-codepoint-fg-bg-bg");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-fg-bg-bold");
}

// ─── Buffer fill 带颜色 ────────────────────────────────────────────────────

func buffer_fill_with_fg_bg() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0x00), CellStyle.Bold);
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-fg-bg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x00FF00, "tui/buffer/fill-fg-bg-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-fg-bg-bold");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg-3");
}

// ─── Buffer 矩阵索引正确性 ──────────────────────────────────────────────────

func buffer_matrix_index() {
  let buf = Buffer((u32)5, (u32)4);
  // 在每个位置写入唯一的标识值
  var y: u32 = 0;
  while y < (u32)4 {
    var x: u32 = 0;
    while x < (u32)5 {
      let idx = (int)((u64)y * (u64)5 + (u64)x);
      buf.cells[idx].value = (u64)((u64)y * (u64)100 + (u64)x);
      x += (u32)1;
    }
    y += (u32)1;
  }
  // 验证读取
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/matrix-0-0");
  check(buf.cells[(int)4].value == (u64)4, "tui/buffer/matrix-4-0");
  let idx01 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx01].value == (u64)100, "tui/buffer/matrix-0-1");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)203, "tui/buffer/matrix-3-2");
  let idx34 = (int)((u64)3 * (u64)5 + (u64)4);
  check(buf.cells[idx34].value == (u64)304, "tui/buffer/matrix-4-3");
}

// ─── Screen 基础结构 ───────────────────────────────────────────────────────

func screen_ctor() {
  let scr = Screen((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/ctor-width");
  check(sz.item2 == (u32)5, "tui/screen/ctor-height");
}

func screen_buffer_returns_back() {
  let scr = Screen((u32)10, (u32)5);
  let buf = scr.buffer();
  // buffer() 返回的 Buffer 可正常绘制
  buf.draw((u32)0, (u32)0, "Hi");
  check(buf.cells[(int)0].value == (u64)72, "tui/screen/buffer-draw-h");
  check(buf.cells[(int)1].value == (u64)105, "tui/screen/buffer-draw-i");
}

func screen_clear() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.clear();
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/clear-0");
  check(scr.buffer().cells[(int)1].value == (u64)0, "tui/screen/clear-1");
}

func screen_clear_screen_only_no_wipe_buffer() {
  // clearScreen() 仅向 output 追加清屏序列，不清空 back 缓冲区
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.clearScreen();
  // back 缓冲区内容应保留
  check(scr.buffer().cells[(int)0].value == (u64)65, "tui/screen/clear-screen-keep-a");
  check(scr.buffer().cells[(int)1].value == (u64)66, "tui/screen/clear-screen-keep-b");
}

func screen_clear_screen_emits_clear_sequence() {
  // clearScreen() 后 buildPatchString() 应包含清屏序列 \x1b[2J\x1b[H
  let scr = Screen((u32)5, (u32)2);
  scr.clearScreen();
  let out = scr.buildPatchString();
  check(out.contains("\x1b[2J\x1b[H"), "tui/screen/clear-screen-emits-seq");
}

func screen_render_empty_no_diff() {
  let scr = Screen((u32)5, (u32)2);
  // front 和 back 都是空白，buildPatchString() 应返回空字符串（无差异）
  let out = scr.buildPatchString();
  check(out.length() == (int)0, "tui/screen/render-empty-no-diff");
}

func screen_render_full_diff() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  // 第一次 buildPatchString，front 全空白，back 有内容 → 应输出差异序列
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/render-full-diff-nonempty");
  // 第二次 buildPatchString，front 已同步 → 应无差异
  let out2 = scr.buildPatchString();
  check(out2.length() == (int)0, "tui/screen/render-after-sync-no-diff");
}

func screen_render_cursor_position() {
  let scr = Screen((u32)10, (u32)5);
  // 在 (2, 1) 处绘制
  scr.buffer().draw((u32)2, (u32)1, (u64)65);
  let out = scr.buildPatchString();
  // 应包含光标定位序列 \x1b[2;3H（行=2, 列=3，1-based）
  check(out.contains("\x1b[2;3H"), "tui/screen/render-cursor-position");
}

func screen_render_cell_value_output() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, (u64)65);  // 'A'
  let out = scr.buildPatchString();
  check(out.contains("A"), "tui/screen/render-codepoint-ascii");
}

func screen_render_cell_value_zero_to_space() {
  let scr = Screen((u32)5, (u32)2);
  // 先绘制非零内容并 buildPatchString 同步到 front
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.buildPatchString();
  // 清空 back 为码点 0，buildPatchString 时码点 0 应输出空格
  scr.buffer().fill((u64)0);
  let out = scr.buildPatchString();
  check(out.contains(" "), "tui/screen/render-codepoint-zero-space");
}

func screen_render_sgr_reset() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold);
  let out = scr.buildPatchString();
  // 渲染结束后应重置 SGR
  check(out.contains("\x1b[0m"), "tui/screen/render-sgr-reset");
}

func screen_render_sgr_bold() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold);
  let out = scr.buildPatchString();
  // SGR 序列应包含 bold (1)
  check(out.contains("\x1b[1m") || out.contains(";1m"), "tui/screen/render-sgr-bold");
}

func screen_render_sgr_fg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg-color");
}

func screen_render_sgr_fg_bg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X",
    RgbColor((u8)0xFF, (u8)0x00, (u8)0x00),
    RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0 和背景色 48;2;0;0;255
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg");
  check(out.contains("48;2;0;0;255"), "tui/screen/render-sgr-bg");
}

func screen_render_sgr_explicit_black() {
  let scr = Screen((u32)2, (u32)1);
  let black = RgbColor((u8)0, (u8)0, (u8)0);
  scr.buffer().draw((u32)0, (u32)0, (u64)65, black, black);
  scr.buffer().draw((u32)1, (u32)0, (u64)66, none, none);
  let out = scr.buildPatchString();
  check(out.contains("38;2;0;0;0"),
    "tui/screen/render-explicit-black-foreground");
  check(out.contains("48;2;0;0;0"),
    "tui/screen/render-explicit-black-background");
  check(out.contains("\x1b[1;2H\x1b[0mB"),
    "tui/screen/render-black-to-default-reset");
}

/** 验证 SGR 将 Cell style 作为完整状态，正确清除已移除的颜色和样式。 */
func screen_render_sgr_complete_state_transitions() {
  let green = RgbColor((u8)0, (u8)180, (u8)120);
  let blue = RgbColor((u8)0, (u8)0, (u8)255);

  let backgroundScreen = Screen((u32)2, (u32)1);
  backgroundScreen.buffer().draw((u32)0, (u32)0, (u64)65,
    green, blue);
  backgroundScreen.buffer().draw((u32)1, (u32)0, (u64)66,
    green);
  let backgroundOut = backgroundScreen.buildPatchString();
  check(backgroundOut.contains(
    "\x1b[1;2H\x1b[0m\x1b[38;2;0;180;120mB"),
    "tui/screen/sgr-removes-background-before-foreground");

  let foregroundScreen = Screen((u32)2, (u32)1);
  foregroundScreen.buffer().draw((u32)0, (u32)0, (u64)65,
    green);
  foregroundScreen.buffer().draw((u32)1, (u32)0, (u64)66,
    CellStyle.Italic);
  let foregroundOut = foregroundScreen.buildPatchString();
  check(foregroundOut.contains(
    "\x1b[1;2H\x1b[0m\x1b[3mB"),
    "tui/screen/sgr-removes-foreground-before-style");

  let flagScreen = Screen((u32)2, (u32)1);
  flagScreen.buffer().draw((u32)0, (u32)0, (u64)65,
    CellStyle.Bold, CellStyle.Italic);
  flagScreen.buffer().draw((u32)1, (u32)0, (u64)66,
    CellStyle.Italic);
  let flagOut = flagScreen.buildPatchString();
  check(flagOut.contains("\x1b[1;2H\x1b[0m\x1b[3mB"),
    "tui/screen/sgr-removes-absent-style-flag");

  let additiveScreen = Screen((u32)2, (u32)1);
  additiveScreen.buffer().draw((u32)0, (u32)0, (u64)65,
    CellStyle.Italic);
  additiveScreen.buffer().draw((u32)1, (u32)0, (u64)66,
    CellStyle.Bold, CellStyle.Italic);
  let additiveOut = additiveScreen.buildPatchString();
  check(!additiveOut.contains("\x1b[1;2H\x1b[0m"),
    "tui/screen/sgr-additive-transition-does-not-reset");
}

func screen_render_sgr_multi_style() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", CellStyle.Bold, CellStyle.Italic, CellStyle.Underline);
  let out = scr.buildPatchString();
  // SGR 应包含 1;3;4
  check(out.contains("1"), "tui/screen/render-sgr-multi-bold");
  check(out.contains("3"), "tui/screen/render-sgr-multi-italic");
  check(out.contains("4"), "tui/screen/render-sgr-multi-underline");
}

func screen_render_partial_diff() {
  let scr = Screen((u32)10, (u32)2);
  // 第一次绘制 + buildPatchString
  scr.buffer().draw((u32)0, (u32)0, "Hello");
  let out1 = scr.buildPatchString();
  check(out1.length() > (int)0, "tui/screen/partial-diff-first");

  // 只修改一个 cell
  scr.buffer().draw((u32)0, (u32)0, (u64)74);  // 'J'
  let out2 = scr.buildPatchString();
  // 应只包含一个 cell 的差异，输出应比第一次短
  check(out2.length() < out1.length(), "tui/screen/partial-diff-second-shorter");
  check(out2.contains("J"), "tui/screen/partial-diff-second-contains-j");
}

func screen_render_no_sgr_for_unchanged_style() {
  let scr = Screen((u32)10, (u32)2);
  // 绘制两个连续 cell，相同样式
  scr.buffer().draw((u32)0, (u32)0, "AB", CellStyle.Bold);
  let out = scr.buildPatchString();
  // 应只发射一次 SGR bold（统计 "\x1b[" 后含 "1" 的 SGR 序列出现次数）
  // 验证：输出中 "1m" 或 ";1m" 只出现一次（不算最终 \x1b[0m）
  let resetSeq = "\x1b[0m";
  let withoutReset = out.replace(resetSeq, "");
  // bold SGR 序列 "\x1b[" 开头且以 "m" 结尾，包含 "1"
  check(withoutReset.contains("1m"), "tui/screen/no-sgr-repeat-bold-present");
}

func screen_resize() {
  let scr = Screen((u32)5, (u32)3);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  scr.buildPatchString();  // 同步 front

  // resize 后尺寸应更新
  scr.resize((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/resize-width");
  check(sz.item2 == (u32)5, "tui/screen/resize-height");

  // resize 后 back 为空白
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/resize-back-cleared");

  // resize 后 front 也清空，绘制新内容后 buildPatchString 应全量重绘
  scr.buffer().draw((u32)0, (u32)0, "X");
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/resize-render-full");
  check(out.contains("X"), "tui/screen/resize-render-contains-x");
}

func screen_render_unicode_chinese() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "中");
  let out = scr.buildPatchString();
  check(out.contains("中"), "tui/screen/render-unicode-chinese");
}

func screen_render_unicode_emoji() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "😀");
  let out = scr.buildPatchString();
  check(out.contains("😀"), "tui/screen/render-unicode-emoji");
}

/** 验证组合 grapheme 覆盖旧背景时作为一个 Cell 完整输出。 */
func screen_render_combining_grapheme_clears_old_background() {
  let scr = Screen((u32)3, (u32)1);
  scr.buffer().draw((u32)0, (u32)0, (u64)0, none,
    RgbColor((u8)0xFF, (u8)0, (u8)0));
  scr.buildPatchString();

  scr.buffer().clear();
  scr.buffer().draw((u32)0, (u32)0, "é",
    RgbColor((u8)0, (u8)0xFF, (u8)0),
    RgbColor((u8)0, (u8)0, (u8)0, (u8)0));
  let patch = scr.buildPatchString();
  check(patch.contains("é") && !patch.contains("\x1b[1;2H"),
    "tui/screen/combining-grapheme-single-cell-patch");
  check(scr.buffer().cells[0].value == TextUtil.encodeCellValue("é") &&
    scr.buffer().cells[1].value == (u64)0,
    "tui/screen/combining-grapheme-no-residual-cell");

  scr.buffer().clear();
  scr.buffer().draw((u32)0, (u32)0, "👍🏻");
  let full = scr.buildPatchString();
  check(full.contains("👍🏻"),
    "tui/screen/full-capacity-grapheme-output");
}

/** 验证 Screen diff 只输出宽字符主 Cell，并正确处理宽窄字符转换。 */
func screen_render_wide_glyph_transitions() {
  let scr = Screen((u32)4, (u32)1);
  scr.buffer().draw((u32)0, (u32)0, "😀");
  let wide = scr.buildPatchString();
  check(wide.contains("😀") && !wide.contains("\x1b[1;2H"),
    "tui/screen/wide-continuation-not-emitted");

  scr.buffer().draw((u32)1, (u32)0, (u64)88);
  let narrow = scr.buildPatchString();
  check(narrow.contains("X") && !narrow.contains("😀"),
    "tui/screen/overwrite-continuation-clears-wide-glyph");

  scr.buffer().draw((u32)0, (u32)0, "😀");
  let restored = scr.buildPatchString();
  check(restored.contains("😀") &&
    scr.buffer().cells[1].value == Cell.CONTINUATION,
    "tui/screen/wide-glyph-restored-after-overwrite");
}

// ─── TuiApp 构造与字段初始化 ─────────────────────────────────────────────

func tuiapp_ctor_no_fds() {
  let app = TuiApp();
  // 构造后未初始化状态
  check(app.isInitialized() == false, "tui/app/ctor-initialized");
  check(app.isRunning() == false, "tui/app/ctor-running");
  // screen 在字段声明处显式绑定为零尺寸实例，init() 后再调整为终端尺寸
  let size = app.screen.size();
  check(size.item1 == 0, "tui/app/ctor-screen-width");
  check(size.item2 == 0, "tui/app/ctor-screen-height");
}

func tuiapp_ctor_with_fds() {
  let fds: i32[!] = i32[:(int)2];
  fds[0] = (i32)3;
  fds[1] = (i32)4;
  let app = TuiApp((i32[])fds);
  check(app.isInitialized() == false, "tui/app/ctor-fds-initialized");
  let size = app.screen.size();
  check(size.item1 == 0, "tui/app/ctor-fds-screen-width");
  check(size.item2 == 0, "tui/app/ctor-fds-screen-height");
}

// ─── exit() 幂等性（不依赖 TTY 初始化） ──────────────────────────────────

func tuiapp_exit_idempotent_uninit() {
  let app = TuiApp();
  // 未 init 直接 exit，不应抛异常
  app.exit();
  app.exit();
  check(app.isInitialized() == false, "tui/app/exit-idempotent-uninit");
}

// ─── render() 空帧不抛异常（不依赖 TTY 初始化） ──────────────────────────

func tuiapp_render_empty_no_throw() {
  let app = TuiApp();
  // 未 init 状态下 render()：resizeRequested=false，直接 buildPatchBytes + write
  // 空白 Screen 的 buildPatchBytes 返回空数组，不触发 write，不会抛异常
  var caught = false;
  try app.render() catch ex: string { caught = true; };
  check(caught == false, "tui/app/render-empty-no-throw");
}

// ─── render() 有内容输出（不依赖 TTY 初始化，捕获 stdout 以避免 ANSI 污染终端） ─────────

func tuiapp_render_with_content() {
  let app = TuiApp();
  app.screen.resize(10, 5);
  app.screen.buffer().draw(0, 0, "Hi");
  // resizeRequested=false，直接 buildPatchBytes（有内容）+ write；
  // 保留真实 render/write 链路，但将 ANSI 字节捕获到测试管道中。
  var caught = false;
  let output = try captureStdout(() { app.render(); }, (int)64) catch ex: string {
    caught = true;
    "";
  };
  check(caught == false, "tui/app/render-with-content");
  check(output == "\x1b[1;1HH\x1b[1;2Hi", "tui/app/render-with-content-output");
}

func tuiapp_run_startup_clears_screen_keeps_buffer() {
  // run() 启动时应清屏但不擦除已绘制内容：构造后手动模拟 run() 启动渲染段
  // （不真正调用 run() 以免阻塞 poll）。验证 Screen.clearScreen() + hideCursor() + render() 的组合行为。
  let app = TuiApp();
  app.screen.resize(10, 5);
  app.screen.buffer().draw(0, 0, "Hi");
  // 模拟 run() 启动初始化渲染：clearScreen + hideCursor + buildPatchString
  app.screen.clearScreen();
  app.screen.hideCursor();
  let out = app.screen.buildPatchString();
  // 应包含清屏序列
  check(out.contains("\x1b[2J\x1b[H"), "tui/app/run-startup-clear-seq");
  // 应包含隐藏光标序列
  check(out.contains("\x1b[?25l"), "tui/app/run-startup-hide-cursor");
  // 应包含首帧 diff（Hi 内容）
  check(out.contains("Hi"), "tui/app/run-startup-first-frame-content");
  // back 缓冲区内容应保留（clearScreen 不清缓冲区）
  check(app.screen.buffer().cells[(int)0].value == (u64)72, "tui/app/run-startup-keep-buffer");
}

func tuiapp_run_drains_stdin_and_exit_stops() {
  // 阶段四补充：run() 将 stdin 纳入 poll 监听集合并在 POLLIN 时读取丢弃（防 busy-loop），
  // 退出由 exit() 置 running=false。此处不真正调用 run()（会阻塞 poll），验证退出机制：
  // 构造 TuiApp → 手动设 running=true → exit() 应置 running=false，证明循环可正常终止。
  let app = TuiApp();
  // exit() 未 init 时幂等，running 本为 false
  check(app.isRunning() == false, "tui/app/drain-before-exit");
  // 再次 exit 确认幂等（退出机制安全）
  app.exit();
  app.exit();
  check(app.isRunning() == false, "tui/app/drain-exit-running-false");
}

// ─── Phase 5: KeyEvent 测试 ──────────────────────────────────────────────

func key_mod_constants() {
  // MOD_CONTROL=1, MOD_ALT=2, MOD_SHIFT=4，位标志互不冲突
  check(MOD_CONTROL == (u8)1, "tui/key/mod-control-value");
  check(MOD_ALT == (u8)2, "tui/key/mod-alt-value");
  check(MOD_SHIFT == (u8)4, "tui/key/mod-shift-value");
  check((MOD_CONTROL | MOD_ALT | MOD_SHIFT) == (u8)7, "tui/key/mod-combined");
}

func key_special_key_enum() {
  // SpecialKey 枚举值通过 KeyEvent 构造间接验证可访问性
  let e1 = KeyEvent<i32>(SpecialKey.Escape, 0);
  let e2 = KeyEvent<i32>(SpecialKey.Tab, 0);
  let e3 = KeyEvent<i32>(SpecialKey.Enter, 0);
  let e4 = KeyEvent<i32>(SpecialKey.Backspace, 0);
  let e5 = KeyEvent<i32>(SpecialKey.ArrowUp, 0);
  let e6 = KeyEvent<i32>(SpecialKey.ArrowDown, 0);
  let e7 = KeyEvent<i32>(SpecialKey.ArrowLeft, 0);
  let e8 = KeyEvent<i32>(SpecialKey.ArrowRight, 0);
  let e9 = KeyEvent<i32>(SpecialKey.F1, 0);
  let e10 = KeyEvent<i32>(SpecialKey.F12, 0);
  check(e1.isPrintable() == false, "tui/key/special-escape");
  check(e2.isPrintable() == false, "tui/key/special-tab");
  check(e3.isPrintable() == false, "tui/key/special-enter");
  check(e4.isPrintable() == false, "tui/key/special-backspace");
  check(e5.isPrintable() == false, "tui/key/special-arrow-up");
  check(e6.isPrintable() == false, "tui/key/special-arrow-down");
  check(e7.isPrintable() == false, "tui/key/special-arrow-left");
  check(e8.isPrintable() == false, "tui/key/special-arrow-right");
  check(e9.isPrintable() == false, "tui/key/special-f1");
  check(e10.isPrintable() == false, "tui/key/special-f12");
}

func key_event_default_ctor() {
  // 默认构造：content=u32(0), mods=0
  let e = KeyEvent<i32>();
  check(e.mods == (u8)0, "tui/key/ctor-default-mods");
  check(e.isControl() == false, "tui/key/ctor-default-is-control");
  check(e.isShift() == false, "tui/key/ctor-default-is-shift");
  check(e.isPrintable() == false, "tui/key/ctor-default-is-printable");
}

func key_event_special_key() {
  // 构造特殊键事件
  let e = KeyEvent<i32>(SpecialKey.Enter, 0);
  check(e.isPrintable() == false, "tui/key/special-enter-is-printable");
  check(e.isControl() == false, "tui/key/special-enter-is-control");
  check(e.isShift() == false, "tui/key/special-enter-is-shift");
}

func key_event_printable() {
  // 构造可打印字符事件
  let e = KeyEvent<i32>((u32)0x61, 0);  // 'a'
  check(e.isPrintable() == true, "tui/key/printable-a-is-printable");
  check(e.isControl() == false, "tui/key/printable-a-is-control");
  check(e.isShift() == false, "tui/key/printable-a-is-shift");
}

func key_event_ctrl_combo() {
  // Ctrl+A：mods=MOD_CONTROL
  let e = KeyEvent<i32>((u32)0x01, MOD_CONTROL);
  check(e.isControl() == true, "tui/key/ctrl-a-is-control");
  check(e.isShift() == false, "tui/key/ctrl-a-is-shift");
  check(e.isPrintable() == true, "tui/key/ctrl-a-is-printable");
}

func key_event_shift_arrow() {
  // Shift+ArrowUp：mods=MOD_SHIFT
  let e = KeyEvent<i32>(SpecialKey.ArrowUp, MOD_SHIFT);
  check(e.isShift() == true, "tui/key/shift-arrow-is-shift");
  check(e.isControl() == false, "tui/key/shift-arrow-is-control");
  check(e.isPrintable() == false, "tui/key/shift-arrow-is-printable");
}

func key_event_target_binding() {
  let e = KeyEvent<i32>(SpecialKey.Enter, 0);
  check(e.hasTarget() == false, "tui/key/target-unbound");
  e.bindTarget(42);
  check(e.hasTarget() == true, "tui/key/target-bound");
  check(e.target == 42, "tui/key/target-value");
}

/** 验证 KeyEvent 的停止状态由引用别名共享且重复停止保持幂等。 */
func key_event_stop_state_is_shared() {
  let event = KeyEvent<i32>(SpecialKey.Enter, 0);
  let alias = event;
  check(event.isStopped() == false, "tui/key/stop-default");
  alias.stop();
  check(event.isStopped(), "tui/key/stop-reference-shared");
  event.stop();
  check(alias.isStopped(), "tui/key/stop-idempotent");
}

/** 验证阻止键盘默认行为与停止传播是两个相互独立的共享状态。 */
func key_event_prevent_default_is_independent() {
  let event = KeyEvent<i32>(SpecialKey.Tab, 0);
  let alias = event;
  check(event.isPrevented() == false, "tui/key/prevent-default");
  check(event.isStopped() == false, "tui/key/prevent-stop-default");
  alias.preventDefault();
  alias.preventDefault();
  check(event.isPrevented(), "tui/key/prevent-reference-shared");
  check(event.isStopped() == false, "tui/key/prevent-does-not-stop");
  event.stop();
  check(alias.isStopped(), "tui/key/stop-reference-shared-after-prevent");
  check(alias.isPrevented(), "tui/key/stop-keeps-prevented");
}

// ─── Phase 5: MouseEvent 测试 ────────────────────────────────────────────

func mouse_action_enum() {
  // 通过 MouseEvent 构造间接验证枚举值可访问
  let e1 = MouseEvent<i32>(MouseAction.Press, MouseButton.None, 0, 0, 0);
  let e2 = MouseEvent<i32>(MouseAction.Release, MouseButton.None, 0, 0, 0);
  let e3 = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 0, 0, 0);
  check(e1.action == MouseAction.Press, "tui/mouse/action-press");
  check(e2.action == MouseAction.Release, "tui/mouse/action-release");
  check(e3.action == MouseAction.Move, "tui/mouse/action-move");
}

func mouse_button_enum() {
  // 通过 MouseEvent 构造间接验证枚举值可访问
  let e1 = MouseEvent<i32>(MouseAction.Press, MouseButton.None, 0, 0, 0);
  let e2 = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  let e3 = MouseEvent<i32>(MouseAction.Press, MouseButton.Middle, 0, 0, 0);
  let e4 = MouseEvent<i32>(MouseAction.Press, MouseButton.Right, 0, 0, 0);
  let e5 = MouseEvent<i32>(MouseAction.Press, MouseButton.WheelUp, 0, 0, 0);
  let e6 = MouseEvent<i32>(MouseAction.Press, MouseButton.WheelDown, 0, 0, 0);
  check(e1.button == MouseButton.None, "tui/mouse/button-none");
  check(e2.button == MouseButton.Left, "tui/mouse/button-left");
  check(e3.button == MouseButton.Middle, "tui/mouse/button-middle");
  check(e4.button == MouseButton.Right, "tui/mouse/button-right");
  check(e5.button == MouseButton.WheelUp, "tui/mouse/button-wheel-up");
  check(e6.button == MouseButton.WheelDown, "tui/mouse/button-wheel-down");
}

func mouse_event_default_ctor() {
  let e = MouseEvent<i32>();
  check(e.action == MouseAction.Press, "tui/mouse/ctor-default-action");
  check(e.button == MouseButton.None, "tui/mouse/ctor-default-button");
  check(e.x == 0, "tui/mouse/ctor-default-x");
  check(e.y == 0, "tui/mouse/ctor-default-y");
  check(e.mods == (u8)0, "tui/mouse/ctor-default-mods");
  check(e.isControl() == false, "tui/mouse/ctor-default-is-control");
  check(e.isAlt() == false, "tui/mouse/ctor-default-is-alt");
  check(e.isShift() == false, "tui/mouse/ctor-default-is-shift");
}

func mouse_event_left_click() {
  let e = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 9, 4, 0);
  check(e.action == MouseAction.Press, "tui/mouse/left-click-action");
  check(e.button == MouseButton.Left, "tui/mouse/left-click-button");
  check(e.x == 9, "tui/mouse/left-click-x");
  check(e.y == 4, "tui/mouse/left-click-y");
  check(e.mods == (u8)0, "tui/mouse/left-click-mods");
}

func mouse_event_with_modifiers() {
  // SGR 鼠标：+4=Shift, +8=Alt, +16=Ctrl
  let mods: u8 = MOD_SHIFT | MOD_ALT | MOD_CONTROL;
  let e = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, mods);
  check(e.isShift() == true, "tui/mouse/mod-shift");
  check(e.isAlt() == true, "tui/mouse/mod-alt");
  check(e.isControl() == true, "tui/mouse/mod-control");
}

func mouse_event_move_action() {
  let e = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 5, 3, 0);
  check(e.action == MouseAction.Move, "tui/mouse/move-action");
  check(e.button == MouseButton.None, "tui/mouse/move-button-none");
}

func mouse_event_target_stop_and_lock() {
  let owner = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  check(owner.hasTarget() == false, "tui/mouse/target-unbound");
  check(owner.lock() == false, "tui/mouse/lock-rejects-unbound");
  check(owner.isStopped() == false, "tui/mouse/stop-default");
  owner.stop();
  check(owner.isStopped() == true, "tui/mouse/stop-set");

  owner.bindTarget(7);
  check(owner.hasTarget() == true, "tui/mouse/target-bound");
  check(owner.target == 7, "tui/mouse/target-value");
  check(owner.lock() == true, "tui/mouse/lock-first-owner");
  check(owner.lock() == true, "tui/mouse/lock-repeat-owner");
  check(owner.isLocked() == true, "tui/mouse/lock-state-set");
  check(MouseEvent<i32>.lockedTarget() == 7, "tui/mouse/locked-target-value");

  let competitor = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  competitor.bindTarget(9);
  check(competitor.lock() == false, "tui/mouse/lock-rejects-competitor");
  competitor.unlock();
  check(owner.isLocked() == true, "tui/mouse/unlock-rejects-competitor");

  let routed = MouseEvent<i32>(MouseAction.Move, MouseButton.None, 0, 0, 0);
  routed.bindLockedTarget(MouseEvent<i32>.lockedTarget());
  check(routed.lock() == true, "tui/mouse/lock-routed-owner");
  routed.unlock();
  check(routed.isLocked() == false, "tui/mouse/unlock-owner");
}

func mouse_event_allows_window_outside_coordinates() {
  let event = MouseEvent<i32>(MouseAction.Move, MouseButton.None, -4, -2, 0);
  check(event.x == -4, "tui/mouse/window-outside-x");
  check(event.y == -2, "tui/mouse/window-outside-y");
}

/** 验证阻止鼠标默认行为与停止传播是两个相互独立的状态。 */
func mouse_event_prevent_default_is_independent() {
  let event = MouseEvent<i32>(MouseAction.Press, MouseButton.Left, 0, 0, 0);
  check(event.isPrevented() == false, "tui/mouse/prevent-default");
  check(event.isStopped() == false, "tui/mouse/prevent-stop-default");
  event.preventDefault();
  event.preventDefault();
  check(event.isPrevented(), "tui/mouse/prevent-idempotent");
  check(event.isStopped() == false, "tui/mouse/prevent-does-not-stop");
  event.stop();
  check(event.isStopped(), "tui/mouse/stop-after-prevent");
  check(event.isPrevented(), "tui/mouse/stop-keeps-prevented");
}

/** 验证 DirtyMark 的空构造、组合构造和查询。 */
func dirty_mark_construction_and_query() {
  let empty = DirtyMark();
  check(empty.isEmpty(), "tui/dirty/empty-constructor");
  check(empty.has(DirtyType.Layout) == false &&
    empty.has(DirtyType.SubtreeLayout) == false,
    "tui/dirty/empty-has-no-marks");

  let combined = DirtyMark(
    DirtyType.Layout,
    DirtyType.SubtreeLayout,
    DirtyType.Layout
  );
  check(combined.isEmpty() == false, "tui/dirty/combined-not-empty");
  check(combined.has(DirtyType.Layout), "tui/dirty/combined-layout");
  check(combined.has(DirtyType.SubtreeLayout),
    "tui/dirty/combined-subtree-layout");
}

/** 验证 DirtyMark 的添加、移除、清空和独立值语义。 */
func dirty_mark_mutation_and_value_copy() {
  let original = DirtyMark(DirtyType.Layout);
  let copied = original;
  copied.add(DirtyType.SubtreeLayout);
  copied.add(DirtyType.SubtreeLayout);
  check(original.has(DirtyType.Layout) &&
    original.has(DirtyType.SubtreeLayout) == false,
    "tui/dirty/value-copy-independent");
  check(copied.has(DirtyType.Layout) &&
    copied.has(DirtyType.SubtreeLayout),
    "tui/dirty/add-idempotent");

  copied.remove(DirtyType.Layout);
  copied.remove(DirtyType.Layout);
  check(copied.has(DirtyType.Layout) == false &&
    copied.has(DirtyType.SubtreeLayout),
    "tui/dirty/remove-idempotent");
  copied.clear();
  check(copied.isEmpty(), "tui/dirty/clear");
}

/** 验证基础 View 初始需要布局自身及其子树。 */
func view_dirty_initial_state() {
  let view = View();
  check(view.dirty.has(DirtyType.Layout),
    "tui/view/dirty-initial-layout");
  check(view.dirty.has(DirtyType.SubtreeLayout),
    "tui/view/dirty-initial-subtree-layout");
}

/** 验证 Visibility/PointerEvents 的默认值、合并分类和 Patch 清理。 */
func style_visibility_and_pointer_events_apply() {
  let style = Style();
  style.visibility = Visibility.Collapse;
  style.pointerEvents = PointerEvents.None;
  style.clear();
  check(style.visibility == Visibility.Visible &&
    style.pointerEvents == PointerEvents.All,
    "tui/style/interaction-defaults");

  let pointerPatch = StylePatch();
  pointerPatch.pointerEvents = PointerEvents.None;
  let pointerResult = style.apply(pointerPatch);
  check(style.pointerEvents == PointerEvents.None,
    "tui/style/pointer-events-applied");
  check(!pointerResult.has(StyleChangeType.Layout) &&
    !pointerResult.has(StyleChangeType.Draw),
    "tui/style/pointer-events-no-visual-change");

  let hiddenPatch = StylePatch();
  hiddenPatch.visibility = Visibility.Hidden;
  let hiddenResult = style.apply(hiddenPatch);
  check(style.visibility == Visibility.Hidden &&
    !hiddenResult.has(StyleChangeType.Layout) &&
    hiddenResult.has(StyleChangeType.Draw),
    "tui/style/hidden-is-draw-change");

  hiddenPatch.visibility = Visibility.Collapse;
  let collapseResult = style.apply(hiddenPatch);
  check(style.visibility == Visibility.Collapse &&
    collapseResult.has(StyleChangeType.Layout) &&
    collapseResult.has(StyleChangeType.Draw),
    "tui/style/collapse-is-layout-and-draw-change");

  hiddenPatch.pointerEvents = PointerEvents.None;
  hiddenPatch.clear();
  style.pointerEvents = PointerEvents.All;
  let clearedResult = style.apply(hiddenPatch);
  check(style.visibility == Visibility.Collapse &&
    style.pointerEvents == PointerEvents.All &&
    !clearedResult.has(StyleChangeType.Layout) &&
    !clearedResult.has(StyleChangeType.Draw),
    "tui/style/patch-clear-removes-interaction-overrides");
}

/** 验证 Collapse child 的 frame 为零，且 margin 不占用 VStack 空间。 */
func vstack_collapse_child_has_no_space() {
  let manager = ViewManager(Screen(10, 5));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.width = auto;
  stack.style.height = auto;

  let collapsed = View();
  collapsed.style.width = 4;
  collapsed.style.height = 3;
  collapsed.style.horizontalAlign = Align.Start;
  collapsed.style.verticalAlign = Align.Start;
  let margin: int = 2;
  collapsed.style.margin = Thickness(margin);
  collapsed.style.visibility = Visibility.Collapse;

  let visible = View();
  visible.style.width = 2;
  visible.style.height = 1;
  visible.style.horizontalAlign = Align.Start;
  visible.style.verticalAlign = Align.Start;
  stack.addChild(collapsed);
  stack.addChild(visible);
  manager.root = stack;

  stack.doStyling(manager);
  manager.doArrange();
  check(collapsed.frame.width == 0 && collapsed.frame.height == 0,
    "tui/visibility/collapse-zero-frame");
  check(visible.frame.x == 0 && visible.frame.y == 0,
    "tui/visibility/collapse-skips-margin-and-flow");
  check(stack.frame.width == 2 && stack.frame.height == 1,
    "tui/visibility/collapse-not-in-auto-size");
}

/** 验证 Hidden 与 PointerEvents 在绘制、命中和冒泡中的统一行为。 */
func visibility_and_pointer_events_render_and_route() {
  let screen = Screen(3, 1);
  let manager = ViewManager(screen);
  let root = VStack();
  let bottom = View();
  bottom.style.position = Position.Absolute;
  bottom.style.width = 3;
  bottom.style.height = 1;
  bottom.style.backColor = RgbColor(0, 0, 0xFF);
  let top = View();
  top.style.position = Position.Absolute;
  top.style.width = 3;
  top.style.height = 1;
  top.style.backColor = RgbColor(0xFF, 0, 0);
  top.style.visibility = Visibility.Hidden;
  root.addChild(bottom);
  root.addChild(top);
  manager.root = root;

  var bottomHits = 0;
  var topHits = 0;
  var rootHits = 0;
  var managerHits = 0;
  bottom.mouseDown.on((event: MouseEvent<Widget>) { bottomHits += 1; });
  top.mouseDown.on((event: MouseEvent<Widget>) { topHits += 1; });
  root.mouseDown.on((event: MouseEvent<Widget>) { rootHits += 1; });
  manager.mouseDown.on((event: MouseEvent<Widget>) { managerHits += 1; });

  manager.doStyling();
  manager.doArrange();
  manager.doDraw();
  check(top.frame.width == 3 && top.frame.height == 1,
    "tui/visibility/hidden-keeps-layout");
  check(screen.buffer().cells[0].backColor() == (u32)0x0000FF,
    "tui/visibility/hidden-skips-draw");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(bottomHits == 1 && topHits == 0 && rootHits == 1 && managerHits == 1,
    "tui/visibility/hidden-skips-hit");

  top.style.visibility = Visibility.Visible;
  top.style.pointerEvents = PointerEvents.None;
  manager.doStyling();
  manager.doArrange();
  manager.doDraw();
  check(screen.buffer().cells[0].backColor() == (u32)0xFF0000,
    "tui/pointer-events/none-keeps-draw");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(bottomHits == 2 && topHits == 0 && rootHits == 2 && managerHits == 2,
    "tui/pointer-events/none-hits-underlying-widget");

  root.style.pointerEvents = PointerEvents.None;
  manager.doStyling();
  manager.doArrange();
  manager.doDraw();
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(bottomHits == 3 && topHits == 0 && rootHits == 2 && managerHits == 3,
    "tui/pointer-events/none-skips-bubble-node");

  root.style.visibility = Visibility.Hidden;
  manager.doStyling();
  manager.doArrange();
  manager.doDraw();
  check(screen.buffer().cells[0].value == (u64)0 &&
    screen.buffer().cells[0].backColor() == (u32)0,
    "tui/visibility/hidden-stops-draw-subtree");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(bottomHits == 3 && topHits == 0 && rootHits == 2 && managerHits == 4,
    "tui/visibility/hidden-subtree-reaches-manager-only");

  let lockOwner = MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0);
  lockOwner.bindTarget(bottom);
  check(lockOwner.lock(), "tui/visibility/lock-hidden-subtree-target");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(bottomHits == 3 && topHits == 0 && rootHits == 2 && managerHits == 5,
    "tui/visibility/locked-hidden-subtree-skips-widgets");
  lockOwner.unlock();
}

/** 验证键盘冒泡跳过不可见 Widget，且不受 PointerEvents 影响。 */
func visibility_skips_key_bubble_node() {
  let manager = ViewManager(Screen(3, 1));
  let root = Container();
  let child = View();
  child.tabIndex = 0;
  root.addChild(child);
  manager.root = root;
  check(manager.focus(child), "tui/visibility/key-focus-child");

  var childKeys = 0;
  var rootKeys = 0;
  var managerKeys = 0;
  child.key.on((event: KeyEvent<Widget>) { childKeys += 1; });
  root.key.on((event: KeyEvent<Widget>) { rootKeys += 1; });
  manager.key.on((event: KeyEvent<Widget>) { managerKeys += 1; });

  child.style.visibility = Visibility.Hidden;
  manager.doStyling();
  manager.dispatchKey(KeyEvent<Widget>(SpecialKey.Enter, 0));
  check(childKeys == 0 && rootKeys == 1 && managerKeys == 1,
    "tui/visibility/hidden-skips-key-bubble-node");

  child.style.visibility = Visibility.Visible;
  child.style.pointerEvents = PointerEvents.None;
  manager.doStyling();
  manager.dispatchKey(KeyEvent<Widget>(SpecialKey.Enter, 0));
  check(childKeys == 1 && rootKeys == 2 && managerKeys == 2,
    "tui/pointer-events/none-keeps-key-routing");
}

/** 验证正式样式阶段强制 Root 铺满 Screen，且不修改用户 Style。 */
func view_manager_styling_forces_root_frame() {
  let manager = ViewManager(Screen(7, 4));
  let root = View();
  root.style.position = Position.Absolute;
  root.style.x = 2;
  root.style.y = 1;
  root.style.width = 3;
  root.style.height = 2;
  let margin: int = 1;
  root.style.margin = Thickness(margin);
  manager.root = root;

  manager.doStyling();
  manager.doArrange();
  check(root.frame.x == 0 && root.frame.y == 0 &&
    root.frame.width == 7 && root.frame.height == 4,
    "tui/view-manager/root-fills-screen");
  check(root.style.position == Position.Absolute,
    "tui/view-manager/root-user-style-unchanged");
}

/** 按生产阶段顺序合并样式后直接调用组件布局实现。 */
func arrangeStyledWidget(widget: Widget, manager: ViewManager): void {
  widget.doStyling(manager);
  widget.arrange(manager);
}

/** 合并样式后直接调用组件绘制调度。 */
func drawStyledWidget(widget: Widget, manager: ViewManager): void {
  widget.doStyling(manager);
  widget.doDraw(manager);
}

func view_arrange_preserves_signed_geometry() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  view.style.position = Position.Absolute;
  view.style.x = -3;
  view.style.y = -2;
  view.style.width = 8;
  view.style.height = 5;

  arrangeStyledWidget(view, manager);
  check(view.frame.x == -3, "tui/view/arrange-negative-x");
  check(view.frame.y == -2, "tui/view/arrange-negative-y");
  check(view.frame.width == 8, "tui/view/arrange-signed-width");
  check(view.frame.height == 5, "tui/view/arrange-signed-height");

  drawStyledWidget(view, manager);
  check(view.drawFrame.x == 0, "tui/view/draw-clip-negative-x");
  check(view.drawFrame.y == 0, "tui/view/draw-clip-negative-y");
  check(view.drawFrame.width == 5, "tui/view/draw-clip-negative-width");
  check(view.drawFrame.height == 3, "tui/view/draw-clip-negative-height");
}

func view_arrange_preserves_negative_percentage_offsets() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  let negativeQuarter: double = -0.25;
  let negativeHalf: double = -0.5;
  view.style.position = Position.Fixed;
  view.style.x = negativeQuarter;
  view.style.y = negativeHalf;
  view.style.width = -8;
  view.style.height = negativeHalf;

  arrangeStyledWidget(view, manager);
  check(view.frame.x == -5, "tui/view/arrange-negative-percent-x");
  check(view.frame.y == -5, "tui/view/arrange-negative-percent-y");
  check(view.frame.width == 0, "tui/view/arrange-negative-width-zero");
  check(view.frame.height == 0, "tui/view/arrange-negative-height-zero");
}

func view_arrange_oversized_alignment_keeps_negative_origin() {
  let screen = Screen(20, 10);
  let manager = ViewManager(screen);
  let view = View();
  view.style.width = 30;
  view.style.height = 20;
  view.style.horizontalAlign = Align.Center;
  view.style.verticalAlign = Align.Center;

  arrangeStyledWidget(view, manager);
  check(view.frame.x == -5, "tui/view/arrange-oversized-center-x");
  check(view.frame.y == -5, "tui/view/arrange-oversized-center-y");
  check(view.frame.width == 30, "tui/view/arrange-oversized-width");
  check(view.frame.height == 20, "tui/view/arrange-oversized-height");
}

/** 验证 Auto 默认值、Full 优先级及基础 View 的零内在尺寸。 */
func view_auto_size_semantics() {
  let manager = ViewManager(Screen(20, 10));
  let view = View();
  var widthIsAuto = false;
  var heightIsAuto = false;
  if view.style.width match value: Auto {
    widthIsAuto = true;
  }
  if view.style.height match value: Auto {
    heightIsAuto = true;
  }
  check(widthIsAuto && heightIsAuto, "tui/view/auto-default-branches");

  arrangeStyledWidget(view, manager);
  check(view.frame.width == 20 && view.frame.height == 10,
    "tui/view/auto-full-precedence");

  view.style.horizontalAlign = Align.Start;
  view.style.verticalAlign = Align.Start;
  arrangeStyledWidget(view, manager);
  check(view.frame.width == 0 && view.frame.height == 0,
    "tui/view/auto-zero-intrinsic-size");

  let half: double = 0.5;
  view.style.width = 6;
  view.style.height = half;
  arrangeStyledWidget(view, manager);
  check(view.frame.width == 6 && view.frame.height == 5,
    "tui/view/auto-keeps-fixed-percent");

  view.style.position = Position.Absolute;
  view.style.x = 2;
  view.style.y = 3;
  view.style.width = auto;
  view.style.height = auto;
  arrangeStyledWidget(view, manager);
  check(view.frame.x == 2 && view.frame.y == 3 &&
    view.frame.width == 0 && view.frame.height == 0,
    "tui/view/auto-absolute-zero-intrinsic");
}

/** 验证无背景和透明背景的 View 不改动画布，非透明背景正常覆盖。 */
func view_draw_alpha_background_semantics() {
  let screen = Screen(3, 1);
  let manager = ViewManager(screen);
  let buffer = screen.buffer();
  buffer.draw((u32)0, (u32)0, (u64)88,
    RgbColor((u8)0x11, (u8)0x22, (u8)0x33),
    RgbColor((u8)0x44, (u8)0x55, (u8)0x66));

  let view = View();
  view.style.position = Position.Absolute;
  view.style.width = 1;
  view.style.height = 1;
  arrangeStyledWidget(view, manager);
  drawStyledWidget(view, manager);
  check(buffer.cells[0].value == (u64)88 &&
    buffer.cells[0].backColor() == (u32)0x445566,
    "tui/view/no-background-keeps-canvas");

  view.style.backColor = RgbColor((u8)0, (u8)0, (u8)0, (u8)0);
  drawStyledWidget(view, manager);
  check(buffer.cells[0].value == (u64)88 &&
    buffer.cells[0].backColor() == (u32)0x445566,
    "tui/view/transparent-background-keeps-canvas");

  view.style.backColor = RgbColor((u8)0x01, (u8)0x02, (u8)0x03);
  drawStyledWidget(view, manager);
  check(buffer.cells[0].value == (u64)0 &&
    buffer.cells[0].backColor() == (u32)0x010203,
    "tui/view/opaque-background-paints-canvas");
}

/** 验证 doDraw 统一缓存裁剪区域、登记 sequence，并排除不可见组件。 */
func view_do_draw_tracks_only_visible_frame() {
  let manager = ViewManager(Screen(3, 1));
  let view = View();
  view.style.position = Position.Fixed;
  view.style.x = -1;
  view.style.width = 2;
  view.style.height = 1;
  var hits = 0;
  view.mouseDown.on((event: MouseEvent<Widget>) {
    hits += 1;
  });
  manager.root = view;

  view.doStyling(manager);
  manager.doArrange();
  manager.doDraw();
  check(view.drawFrame.x == 0 && view.drawFrame.width == 1,
    "tui/view/do-draw-caches-clipped-frame");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(hits == 1, "tui/view/do-draw-tracks-visible-widget");

  view.style.x = 3;
  view.dirty.add(DirtyType.Layout);
  view.doStyling(manager);
  manager.doArrange();
  manager.doDraw();
  check(view.drawFrame.width == 0 && view.drawFrame.height == 0,
    "tui/view/do-draw-caches-empty-frame");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 0, 0, 0));
  check(hits == 1, "tui/view/do-draw-skips-empty-widget");
}

/** 验证 VStack 按顺序直接放置普通流 children，并保留用户 Style。 */
func vstack_arranges_direct_children() {
  let manager = ViewManager(Screen(20, 12));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.x = 2;
  stack.style.y = 1;
  stack.style.width = 10;
  stack.style.height = 9;
  let spacing: int = 1;
  stack.style.padding = Thickness(spacing);

  let first = View();
  first.style.x = 91;
  first.style.y = 92;
  first.style.width = 4;
  first.style.height = 2;
  first.style.horizontalAlign = Align.Start;
  first.style.verticalAlign = Align.Start;
  first.style.margin = Thickness(spacing);

  let second = View();
  second.style.position = Position.Relative;
  second.style.x = 81;
  second.style.y = 82;
  second.style.width = 2;
  second.style.height = 1;
  second.style.horizontalAlign = Align.Center;
  second.style.verticalAlign = Align.End;

  stack.addChild(first);
  stack.addChild(second);
  manager.root = stack;
  stack.doStyling(manager);
  manager.doArrange();

  check(stack.frame.x == 2 && stack.frame.y == 1 &&
    stack.frame.width == 10 && stack.frame.height == 9,
    "tui/vstack/fixed-frame");
  check(first.frame.x == 4 && first.frame.y == 3 &&
    first.frame.width == 4 && first.frame.height == 2,
    "tui/vstack/first-child-position");
  check(second.frame.x == 6 && second.frame.y == 6 &&
    second.frame.width == 2 && second.frame.height == 1,
    "tui/vstack/second-child-position");
  var styleUnchanged = false;
  if first.style.x match firstX: int &&
  first.style.y match firstY: int &&
  second.style.x match secondX: int &&
  second.style.y match secondY: int {
    styleUnchanged = firstX == 91 && firstY == 92 &&
      secondX == 81 && secondY == 82;
  }
  check(styleUnchanged, "tui/vstack/style-unchanged");
  var parentPreserved = false;
  if first.parent match parent: ContainerWidget {
    parentPreserved = (Widget)parent == (Widget)stack;
  }
  check(parentPreserved, "tui/vstack/parent-preserved");
}

/** 验证 VStack 的 Auto 尺寸来自普通流 children 与自身 padding。 */
func vstack_auto_size_from_children() {
  let manager = ViewManager(Screen(30, 20));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.x = 3;
  stack.style.y = 2;
  stack.style.width = auto;
  stack.style.height = auto;
  let padding: int = 1;
  stack.style.padding = Thickness(padding);

  let first = View();
  first.style.width = 4;
  first.style.height = 2;
  first.style.horizontalAlign = Align.Start;
  first.style.verticalAlign = Align.Start;
  let second = View();
  second.style.width = 6;
  second.style.height = 3;
  second.style.horizontalAlign = Align.End;
  second.style.verticalAlign = Align.Start;
  stack.addChild(first);
  stack.addChild(second);
  manager.root = stack;

  stack.doStyling(manager);
  manager.doArrange();
  check(stack.frame.x == 3 && stack.frame.y == 2 &&
    stack.frame.width == 8 && stack.frame.height == 7,
    "tui/vstack/auto-frame");
  check(first.frame.x == 4 && first.frame.y == 3,
    "tui/vstack/auto-first-child");
  check(second.frame.x == 4 && second.frame.y == 5,
    "tui/vstack/auto-second-child");
  check(stack.dirty.isEmpty(), "tui/vstack/auto-layout-stable");

  first.style.height = 4;
  first.dirty.add(DirtyType.Layout);
  first.requestReflow();
  stack.doStyling(manager);
  manager.doArrange();
  check(stack.frame.width == 8 && stack.frame.height == 9,
    "tui/vstack/auto-reflow-frame");
  check(second.frame.y == 7,
    "tui/vstack/auto-reflow-moves-following-child");
  check(stack.dirty.isEmpty(), "tui/vstack/auto-reflow-stable");
}

/** 验证 VStack 保留 child 的百分比尺寸和交叉轴 Full/End 语义。 */
func vstack_percentage_and_cross_axis_alignment() {
  let manager = ViewManager(Screen(20, 12));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.x = 1;
  stack.style.y = 1;
  stack.style.width = 12;
  stack.style.height = 10;
  let padding: int = 1;
  stack.style.padding = Thickness(padding);

  let percent = View();
  let half: double = 0.5;
  let quarter: double = 0.25;
  percent.style.width = half;
  percent.style.height = quarter;
  percent.style.horizontalAlign = Align.Start;
  percent.style.verticalAlign = Align.Start;

  let full = View();
  full.style.height = 1;
  full.style.horizontalAlign = Align.Full;
  full.style.verticalAlign = Align.Start;
  full.style.margin = Thickness(padding);

  let end = View();
  end.style.width = 2;
  end.style.height = 1;
  end.style.horizontalAlign = Align.End;
  end.style.verticalAlign = Align.Start;

  stack.addChild(percent);
  stack.addChild(full);
  stack.addChild(end);
  manager.root = stack;
  stack.doStyling(manager);
  manager.doArrange();

  check(percent.frame.x == 2 && percent.frame.y == 2 &&
    percent.frame.width == 5 && percent.frame.height == 2,
    "tui/vstack/percentage-child");
  check(full.frame.x == 3 && full.frame.y == 5 &&
    full.frame.width == 8 && full.frame.height == 1,
    "tui/vstack/full-cross-axis-child");
  check(end.frame.x == 10 && end.frame.y == 7 &&
    end.frame.width == 2 && end.frame.height == 1,
    "tui/vstack/end-cross-axis-child");
}

/** 验证 Absolute/Fixed child 脱离 VStack 普通流。 */
func vstack_floating_children_do_not_advance_flow() {
  let manager = ViewManager(Screen(20, 12));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.x = 1;
  stack.style.y = 1;
  stack.style.width = 10;
  stack.style.height = 8;

  let first = View();
  first.style.width = 3;
  first.style.height = 2;
  first.style.horizontalAlign = Align.Start;
  first.style.verticalAlign = Align.Start;
  let floating = View();
  floating.style.position = Position.Absolute;
  floating.style.x = 5;
  floating.style.y = 4;
  floating.style.width = 2;
  floating.style.height = 1;
  let second = View();
  second.style.width = 3;
  second.style.height = 2;
  second.style.horizontalAlign = Align.Start;
  second.style.verticalAlign = Align.Start;
  stack.addChild(first);
  stack.addChild(floating);
  stack.addChild(second);
  manager.root = stack;

  stack.doStyling(manager);
  manager.doArrange();
  check(first.frame.y == 1 && second.frame.y == 3,
    "tui/vstack/floating-does-not-advance");
  check(floating.frame.x == 6 && floating.frame.y == 5,
    "tui/vstack/floating-keeps-own-position");
}

/** 验证 VStack 只调度直接 children 绘制，并复用既有裁剪与命中顺序。 */
func vstack_draws_and_hits_direct_children() {
  let manager = ViewManager(Screen(5, 3));
  let stack = VStack();
  stack.style.position = Position.Fixed;
  stack.style.width = 3;
  stack.style.height = 2;
  stack.style.overflow = Overflow.Hidden;
  let child = View();
  child.style.width = 5;
  child.style.height = 1;
  child.style.horizontalAlign = Align.Start;
  child.style.verticalAlign = Align.Start;
  child.style.backColor = RgbColor(1, 2, 3);
  var hits = 0;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    hits += 1;
  });
  stack.addChild(child);
  manager.root = stack;

  stack.doStyling(manager);
  manager.doArrange();
  manager.doDraw();
  check(child.drawFrame.x == 0 && child.drawFrame.y == 0 &&
    child.drawFrame.width == 3 && child.drawFrame.height == 1,
    "tui/vstack/child-draw-clipped");
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 2, 0, 0));
  check(hits == 1, "tui/vstack/direct-child-hit");
}

/** 验证 Text 的 Auto 宽高、硬换行、末尾换行和最终尺寸对齐。 */
func text_auto_measure_and_alignment() {
  let manager = ViewManager(Screen(20, 10));
  let text = Text();
  text.style.horizontalAlign = Align.Start;
  text.style.verticalAlign = Align.Start;
  let paddingSize: int = 4;
  text.style.padding = Thickness(paddingSize);

  check(text.content == "", "tui/text/default-empty-content");
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 0 && text.frame.height == 0,
    "tui/text/empty-auto-size");

  text.content = "ab\ncde";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 3 && text.frame.height == 2,
    "tui/text/auto-hard-lines");

  text.content = "ab\r\nc";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 2 && text.frame.height == 2,
    "tui/text/auto-crlf-lines");

  text.content = "ab\n";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 2 && text.frame.height == 2,
    "tui/text/auto-trailing-empty-line");

  text.content = "abc";
  text.style.horizontalAlign = Align.Center;
  text.style.verticalAlign = Align.Center;
  arrangeStyledWidget(text, manager);
  check(text.frame.x == 8 && text.frame.y == 4,
    "tui/text/auto-center-final-size");
  check(text.frame.width == 3 && text.frame.height == 1,
    "tui/text/auto-center-dimensions");

  text.style.horizontalAlign = Align.End;
  text.style.verticalAlign = Align.End;
  arrangeStyledWidget(text, manager);
  check(text.frame.x == 17 && text.frame.y == 9,
    "tui/text/auto-end-final-size");

  text.style.horizontalAlign = Align.Start;
  text.style.verticalAlign = Align.Start;
  text.content = "\n";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 0 && text.frame.height == 0,
    "tui/text/zero-intrinsic-width-has-zero-height");

  text.style.width = 2;
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 2 && text.frame.height == 2,
    "tui/text/finite-width-preserves-empty-lines");
  check(!text.isAncestor(text),
    "tui/text/inherits-view-is-ancestor");
}

/** 验证有限宽度换行、百分比/Full 宽度以及内容和宽度变化后的重排。 */
func text_wrap_and_reflow_dimensions() {
  let manager = ViewManager(Screen(10, 8));
  let text = Text();
  text.style.horizontalAlign = Align.Start;
  text.style.verticalAlign = Align.Start;
  text.style.width = 3;
  text.style.height = auto;
  text.content = "abcdefg";

  arrangeStyledWidget(text, manager);
  check(text.frame.width == 3 && text.frame.height == 3,
    "tui/text/fixed-width-auto-height");

  text.style.width = 4;
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 4 && text.frame.height == 2,
    "tui/text/width-change-reflow");

  text.content = "xy";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 4 && text.frame.height == 1,
    "tui/text/content-change-reflow");

  let half: double = 0.5;
  text.style.width = half;
  text.content = "abcdefghijk";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 5 && text.frame.height == 3,
    "tui/text/percent-width-auto-height");

  text.style.width = auto;
  text.style.horizontalAlign = Align.Full;
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 10 && text.frame.height == 2,
    "tui/text/full-width-auto-height");

  text.style.height = 1;
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 10 && text.frame.height == 1,
    "tui/text/fixed-height-does-not-expand");
}

/** 验证 Text 复用 std.text grapheme 边界处理组合字符与 Emoji 换行。 */
func text_grapheme_wrap_and_emoji() {
  let screen = Screen(7, 4);
  let manager = ViewManager(screen);
  let text = Text();
  text.style.position = Position.Absolute;
  text.style.width = auto;
  text.style.height = auto;
  text.content = "😀";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 2 && text.frame.height == 1,
    "tui/text/single-codepoint-emoji-size");

  text.content = "👨‍👩‍👧‍👦";
  arrangeStyledWidget(text, manager);
  check(text.frame.width == 8 && text.frame.height == 1,
    "tui/text/multi-codepoint-grapheme-auto-size");

  text.style.width = 2;
  text.content = "AéB";
  arrangeStyledWidget(text, manager);
  drawStyledWidget(text, manager);
  check(text.frame.height == 2,
    "tui/text/grapheme-wraps-as-unit");
  let combinedBuffer = screen.buffer();
  check(combinedBuffer.cells[0].value == (u64)65 &&
    combinedBuffer.cells[1].value == TextUtil.encodeCellValue("é") &&
    combinedBuffer.cells[7].value == (u64)66,
    "tui/text/grapheme-draws-inline-cell");

  let familyScreen = Screen(3, 4);
  let familyManager = ViewManager(familyScreen);
  let family = Text();
  family.style.position = Position.Absolute;
  family.style.width = 3;
  family.style.height = auto;
  family.content = "👨‍👩‍👧‍👦";
  arrangeStyledWidget(family, familyManager);
  drawStyledWidget(family, familyManager);
  check(family.frame.height == 4,
    "tui/text/overwide-grapheme-splits-by-codepoint");
  let familyBuffer = familyScreen.buffer();
  check(familyBuffer.cells[0].value == TextUtil.encodeCellValue("👨‍") &&
    familyBuffer.cells[1].value == Cell.CONTINUATION &&
    familyBuffer.cells[2].value == (u64)0 &&
    familyBuffer.cells[3].value == TextUtil.encodeCellValue("👩‍") &&
    familyBuffer.cells[4].value == Cell.CONTINUATION &&
    familyBuffer.cells[5].value == (u64)0 &&
    familyBuffer.cells[6].value == TextUtil.encodeCellValue("👧‍") &&
    familyBuffer.cells[7].value == Cell.CONTINUATION &&
    familyBuffer.cells[8].value == (u64)0 &&
    familyBuffer.cells[9].value == TextUtil.encodeCellValue("👦") &&
    familyBuffer.cells[10].value == Cell.CONTINUATION,
    "tui/text/overwide-grapheme-splits-at-codepoint-boundaries");

  let atomicManager = ViewManager(Screen(11, 3));
  let atomic = Text();
  atomic.style.position = Position.Absolute;
  atomic.style.width = 11;
  atomic.style.height = auto;
  atomic.content = "A👨‍👩‍👧‍👦B";
  arrangeStyledWidget(atomic, atomicManager);
  check(atomic.frame.height == 1,
    "tui/text/fitting-grapheme-is-not-split");
}

/** 验证 Text 每行独立水平对齐，并在裁剪后保持原始对齐位置。 */
func text_horizontal_alignment_and_clipping() {
  let centerScreen = Screen(7, 3);
  let centerManager = ViewManager(centerScreen);
  let centerText = Text();
  check(centerText.textAlign == TextAlign.Left,
    "tui/text/default-left-align");
  centerText.style.position = Position.Absolute;
  centerText.style.width = 7;
  centerText.style.height = 3;
  centerText.content = "A\nBCD\nEFGHI";
  let centerWidget: TextWidget = centerText;
  centerWidget.textAlign = TextAlign.Center;
  arrangeStyledWidget(centerText, centerManager);
  drawStyledWidget(centerText, centerManager);

  let centerBuffer = centerScreen.buffer();
  check(centerBuffer.cells[3].value == (u64)65,
    "tui/text/center-one-cell-line");
  check(centerBuffer.cells[9].value == (u64)66 &&
    centerBuffer.cells[10].value == (u64)67 &&
    centerBuffer.cells[11].value == (u64)68,
    "tui/text/center-three-cell-line");
  check(centerBuffer.cells[15].value == (u64)69 &&
    centerBuffer.cells[19].value == (u64)73,
    "tui/text/center-five-cell-line");

  let rightScreen = Screen(4, 3);
  let rightManager = ViewManager(rightScreen);
  let rightText = Text();
  rightText.style.position = Position.Absolute;
  rightText.style.x = -2;
  rightText.style.width = 6;
  rightText.style.height = 3;
  rightText.textAlign = TextAlign.Right;
  rightText.content = "AB\nCDEF\nGHIJKL";
  arrangeStyledWidget(rightText, rightManager);
  drawStyledWidget(rightText, rightManager);

  let rightBuffer = rightScreen.buffer();
  check(rightBuffer.cells[0].value == (u64)0 &&
    rightBuffer.cells[1].value == (u64)0 &&
    rightBuffer.cells[2].value == (u64)65 &&
    rightBuffer.cells[3].value == (u64)66,
    "tui/text/right-align-short-line");
  check(rightBuffer.cells[4].value == (u64)67 &&
    rightBuffer.cells[7].value == (u64)70,
    "tui/text/right-align-medium-line");
  check(rightBuffer.cells[8].value == (u64)73 &&
    rightBuffer.cells[11].value == (u64)76,
    "tui/text/right-align-clipped-long-line");
}

/** 验证 TextOverflow 只处理 Text 自身高度溢出，并保留外部裁剪语义。 */
func text_overflow_ellipsis() {
  let clipScreen = Screen(7, 1);
  let clipManager = ViewManager(clipScreen);
  let clip = Text();
  check(clip.textOverflow == TextOverflow.Clip,
    "tui/text/overflow-default-clip");
  clip.style.position = Position.Absolute;
  clip.style.width = 7;
  clip.style.height = 1;
  clip.content = "abcdefgh";
  arrangeStyledWidget(clip, clipManager);
  drawStyledWidget(clip, clipManager);
  let clipBuffer = clipScreen.buffer();
  check(clipBuffer.cells[0].value == (u64)97 &&
    clipBuffer.cells[6].value == (u64)103,
    "tui/text/overflow-clip-keeps-visible-content");

  let ellipsisScreen = Screen(7, 1);
  let ellipsisManager = ViewManager(ellipsisScreen);
  let ellipsis = Text();
  ellipsis.style.position = Position.Absolute;
  ellipsis.style.width = 7;
  ellipsis.style.height = 1;
  ellipsis.textOverflow = TextOverflow.Ellipsis;
  ellipsis.content = "abcdefgh";
  arrangeStyledWidget(ellipsis, ellipsisManager);
  drawStyledWidget(ellipsis, ellipsisManager);
  let ellipsisBuffer = ellipsisScreen.buffer();
  check(ellipsisBuffer.cells[0].value == (u64)97 &&
    ellipsisBuffer.cells[3].value == (u64)100 &&
    ellipsisBuffer.cells[4].value == (u64)46 &&
    ellipsisBuffer.cells[5].value == (u64)46 &&
    ellipsisBuffer.cells[6].value == (u64)46,
    "tui/text/overflow-ellipsis-replaces-last-three-cells");

  let multiScreen = Screen(4, 2);
  let multiManager = ViewManager(multiScreen);
  let multi = Text();
  multi.style.position = Position.Absolute;
  multi.style.width = 4;
  multi.style.height = 2;
  multi.textOverflow = TextOverflow.Ellipsis;
  multi.content = "abcdefghij";
  arrangeStyledWidget(multi, multiManager);
  drawStyledWidget(multi, multiManager);
  let multiBuffer = multiScreen.buffer();
  check(multiBuffer.cells[0].value == (u64)97 &&
    multiBuffer.cells[3].value == (u64)100 &&
    multiBuffer.cells[4].value == (u64)101 &&
    multiBuffer.cells[5].value == (u64)46 &&
    multiBuffer.cells[6].value == (u64)46 &&
    multiBuffer.cells[7].value == (u64)46,
    "tui/text/overflow-ellipsis-only-on-last-visible-line");

  let narrowScreen = Screen(2, 1);
  let narrowManager = ViewManager(narrowScreen);
  let narrow = Text();
  narrow.style.position = Position.Absolute;
  narrow.style.width = 2;
  narrow.style.height = 1;
  narrow.textOverflow = TextOverflow.Ellipsis;
  narrow.content = "abc";
  arrangeStyledWidget(narrow, narrowManager);
  drawStyledWidget(narrow, narrowManager);
  let narrowBuffer = narrowScreen.buffer();
  check(narrowBuffer.cells[0].value == (u64)46 &&
    narrowBuffer.cells[1].value == (u64)46,
    "tui/text/overflow-ellipsis-fits-narrow-frame");

  let externalScreen = Screen(4, 1);
  let externalManager = ViewManager(externalScreen);
  let external = Text();
  external.style.position = Position.Absolute;
  external.style.width = 7;
  external.style.height = 1;
  external.textOverflow = TextOverflow.Ellipsis;
  external.content = "abcdefg";
  arrangeStyledWidget(external, externalManager);
  drawStyledWidget(external, externalManager);
  let externalBuffer = externalScreen.buffer();
  check(externalBuffer.cells[0].value == (u64)97 &&
    externalBuffer.cells[1].value == (u64)98 &&
    externalBuffer.cells[2].value == (u64)99 &&
    externalBuffer.cells[3].value == (u64)100,
    "tui/text/external-clip-does-not-trigger-ellipsis");
}

/** 验证 Text 通过 Widget 调度绘制自动换行、硬换行和 Unicode 码点。 */
func text_draw_wrap_unicode_and_hit_target() {
  let screen = Screen(6, 4);
  let manager = ViewManager(screen);
  let text = Text();
  text.style.position = Position.Absolute;
  text.style.x = 1;
  text.style.y = 0;
  text.style.width = 3;
  text.style.height = 3;
  text.style.foreColor = RgbColor(0x12, 0x34, 0x56);
  text.content = "A中😀B\nZ";
  manager.root = text;

  text.doStyling(manager);
  manager.doArrange();
  manager.doDraw();
  let buffer = screen.buffer();
  check(buffer.cells[1].value == (u64)65,
    "tui/text/draw-first-ascii");
  check(buffer.cells[2].value == TextUtil.encodeCellValue("中"),
    "tui/text/draw-chinese-cell-value");
  check(buffer.cells[3].value == Cell.CONTINUATION,
    "tui/text/draw-chinese-continuation");
  check(buffer.cells[7].value == TextUtil.encodeCellValue("😀"),
    "tui/text/draw-emoji-cell-value");
  check(buffer.cells[8].value == Cell.CONTINUATION,
    "tui/text/draw-emoji-continuation");
  check(buffer.cells[9].value == (u64)66,
    "tui/text/draw-soft-wrapped-row");
  check(buffer.cells[13].value == (u64)90,
    "tui/text/draw-hard-wrapped-row");
  check(buffer.cells[1].foreColor() == (u32)0x123456,
    "tui/text/draw-foreground");
  check(text.drawFrame.x == 1 && text.drawFrame.y == 0 &&
    text.drawFrame.width == 3 && text.drawFrame.height == 3,
    "tui/text/draw-frame-traced");

  var mouseHits = 0;
  var targetStable = true;
  text.mouseDown.on((event: MouseEvent<Widget>) {
    mouseHits += 1;
    targetStable = targetStable && event.target == (Widget)text;
  });
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press,
    MouseButton.Left, 2, 0, 0));
  check(mouseHits == 1 && targetStable,
    "tui/text/draw-frame-hit-target");
}

/** 验证 Text 的 none 背景保留底层 Cell，指定背景填充完整可见 frame。 */
func text_draw_background_semantics() {
  let screen = Screen(4, 2);
  let manager = ViewManager(screen);
  let buffer = screen.buffer();
  let under = RgbColor(0x01, 0x02, 0x03);
  buffer.draw((u32)0, (u32)0, (u32)4, (u32)1, (u64)88,
    none, under, CellStyle.Bold);

  let text = Text();
  text.style.position = Position.Absolute;
  text.style.width = 2;
  text.style.height = 1;
  text.style.foreColor = RgbColor(0xAA, 0xBB, 0xCC);
  text.content = "A";
  arrangeStyledWidget(text, manager);
  drawStyledWidget(text, manager);

  check(buffer.cells[0].value == (u64)65,
    "tui/text/none-bg-writes-glyph");
  check(buffer.cells[0].backColor() == (u32)0x010203,
    "tui/text/none-bg-preserves-underlay");
  check(buffer.cells[0].foreColor() == (u32)0xAABBCC,
    "tui/text/none-bg-writes-foreground");
  check((buffer.cells[0].style & Cell.MASK_FLAGS) == (u64)0,
    "tui/text/glyph-clears-underlay-flags");
  check(buffer.cells[1].value == (u64)88 && buffer.cells[1].bold(),
    "tui/text/none-bg-keeps-unwritten-cell");

  text.style.backColor = RgbColor(0x04, 0x05, 0x06);
  text.content = "B";
  arrangeStyledWidget(text, manager);
  drawStyledWidget(text, manager);
  check(buffer.cells[0].value == (u64)66 &&
    buffer.cells[0].backColor() == (u32)0x040506,
    "tui/text/explicit-bg-glyph-cell");
  check(buffer.cells[1].value == (u64)0 &&
    buffer.cells[1].backColor() == (u32)0x040506,
    "tui/text/explicit-bg-fills-frame");
}

/** 验证 Screen 与 Hidden 祖先裁剪只跳过原始行列，不重新排版文本。 */
func text_draw_clipping_preserves_content_origin() {
  let screen = Screen(4, 3);
  let manager = ViewManager(screen);
  let text = Text();
  text.style.position = Position.Absolute;
  text.style.x = -1;
  text.style.y = -1;
  text.style.width = 3;
  text.style.height = 3;
  text.content = "abcdefghi";
  arrangeStyledWidget(text, manager);
  drawStyledWidget(text, manager);

  let buffer = screen.buffer();
  check(text.drawFrame.x == 0 && text.drawFrame.y == 0 &&
    text.drawFrame.width == 2 && text.drawFrame.height == 2,
    "tui/text/screen-clipped-frame");
  check(buffer.cells[0].value == (u64)101 &&
    buffer.cells[1].value == (u64)102 &&
    buffer.cells[4].value == (u64)104 &&
    buffer.cells[5].value == (u64)105,
    "tui/text/screen-clip-keeps-origin");

  let hiddenScreen = Screen(6, 3);
  let hiddenManager = ViewManager(hiddenScreen);
  let parent = Container();
  parent.style.position = Position.Relative;
  parent.style.overflow = Overflow.Hidden;
  parent.frame = makeWidgetFrame(1, 0, 2, 2);
  let child = Text();
  child.style.position = Position.Absolute;
  child.style.x = -1;
  child.style.width = 4;
  child.style.height = 2;
  child.content = "abcdefgh";
  parent.addChild(child);
  parent.doStyling(hiddenManager);
  arrangeStyledWidget(child, hiddenManager);
  drawStyledWidget(child, hiddenManager);

  let hiddenBuffer = hiddenScreen.buffer();
  check(child.drawFrame.x == 1 && child.drawFrame.y == 0 &&
    child.drawFrame.width == 2 && child.drawFrame.height == 2,
    "tui/text/hidden-ancestor-frame");
  check(hiddenBuffer.cells[1].value == (u64)98 &&
    hiddenBuffer.cells[2].value == (u64)99 &&
    hiddenBuffer.cells[7].value == (u64)102 &&
    hiddenBuffer.cells[8].value == (u64)103,
    "tui/text/hidden-clip-keeps-origin");
}

func makeWidgetFrame(x: int, y: int, width: int, height: int): Rect {
  let frame = Rect();
  frame.x = x;
  frame.y = y;
  frame.width = width;
  frame.height = height;
  return frame;
}

/**
 * 判断 ViewManager 当前是否聚焦指定 Widget。
 */
func managerHasFocus(manager: ViewManager, expected: Widget): bool {
  if manager.focused() match focused: Widget {
    return focused == expected;
  }
  return false;
}

/**
 * 判断 ViewManager 当前是否没有有效焦点。
 */
func managerHasNoFocus(manager: ViewManager): bool {
  if manager.focused() match focused: Widget {
    return false;
  }
  return true;
}

/** 验证 ViewManager 焦点资格、组件树归属、失效清理与显式清除。 */
func view_manager_focus_lifecycle() {
  let manager = ViewManager(Screen(20, 10));
  let root = Container();
  let child = View();

  check(root.tabIndex == -1, "tui/focus/root-default-tab-index");
  check(child.tabIndex == -1, "tui/focus/child-default-tab-index");
  check(manager.focus(child) == false, "tui/focus/reject-without-root");

  manager.root = root;
  check(manager.focus(child) == false, "tui/focus/reject-detached-widget");
  root.addChild(child);
  check(manager.focus(child) == false, "tui/focus/reject-negative-tab-index");

  child.tabIndex = 0;
  check(manager.focus(child), "tui/focus/accept-attached-widget");
  check(managerHasFocus(manager, child), "tui/focus/current-child");
  check(manager.focus(child), "tui/focus/repeat-idempotent");

  child.tabIndex = -1;
  check(managerHasNoFocus(manager), "tui/focus/tab-index-invalidates-focus");

  child.tabIndex = 2;
  check(manager.focus(child), "tui/focus/refocus-child");
  root.removeChild(child);
  check(managerHasNoFocus(manager), "tui/focus/detach-invalidates-focus");

  root.tabIndex = 1;
  check(manager.focus(root), "tui/focus/root-can-focus");
  manager.clearFocus();
  manager.clearFocus();
  check(managerHasNoFocus(manager), "tui/focus/clear-idempotent");
}

/** 验证焦点路径差分、事件顺序、共同祖先去重和 ViewManager 边界。 */
func view_manager_focus_path_events() {
  let manager = ViewManager(Screen(30, 15));
  let root = Container();
  let left = Container();
  let right = Container();
  let childA = View();
  let childB = View();
  let childC = View();
  root.addChild(left);
  root.addChild(right);
  left.addChild(childA);
  left.addChild(childB);
  right.addChild(childC);
  childA.tabIndex = 0;
  childB.tabIndex = 0;
  childC.tabIndex = 0;
  manager.root = root;

  var order = 0;
  var targetsStable = true;
  var leftFocus = 0;
  var leftBlur = 0;
  var rightFocus = 0;
  var rightBlur = 0;
  var rootFocus = 0;
  var rootBlur = 0;
  var managerFocus = 0;
  var managerBlur = 0;

  childA.onFocus.on((event: FocusEvent<Widget>) {
    order = order * 10 + 1;
    targetsStable = targetsStable && event.target == (Widget)childA;
  });
  childA.onBlur.on((event: FocusEvent<Widget>) {
    order = order * 10 + 1;
    targetsStable = targetsStable && event.target == (Widget)childA;
  });
  childB.onFocus.on((event: FocusEvent<Widget>) {
    order = order * 10 + 2;
    targetsStable = targetsStable && event.target == (Widget)childB;
  });
  childB.onBlur.on((event: FocusEvent<Widget>) {
    order = order * 10 + 1;
    targetsStable = targetsStable && event.target == (Widget)childB;
  });
  childC.onFocus.on((event: FocusEvent<Widget>) {
    order = order * 10 + 3;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });
  childC.onBlur.on((event: FocusEvent<Widget>) {
    order = order * 10 + 1;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });
  left.onFocus.on((event: FocusEvent<Widget>) {
    leftFocus += 1;
    order = order * 10 + 2;
    targetsStable = targetsStable && event.target == (Widget)childA;
  });
  left.onBlur.on((event: FocusEvent<Widget>) {
    leftBlur += 1;
    order = order * 10 + 2;
    targetsStable = targetsStable && event.target == (Widget)childB;
  });
  right.onFocus.on((event: FocusEvent<Widget>) {
    rightFocus += 1;
    order = order * 10 + 4;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });
  right.onBlur.on((event: FocusEvent<Widget>) {
    rightBlur += 1;
    order = order * 10 + 2;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });
  root.onFocus.on((event: FocusEvent<Widget>) {
    rootFocus += 1;
    order = order * 10 + 3;
    targetsStable = targetsStable && event.target == (Widget)childA;
  });
  root.onBlur.on((event: FocusEvent<Widget>) {
    rootBlur += 1;
    order = order * 10 + 3;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });
  manager.onFocus.on((event: FocusEvent<Widget>) {
    managerFocus += 1;
    order = order * 10 + 4;
    targetsStable = targetsStable && event.target == (Widget)childA;
  });
  manager.onBlur.on((event: FocusEvent<Widget>) {
    managerBlur += 1;
    order = order * 10 + 4;
    targetsStable = targetsStable && event.target == (Widget)childC;
  });

  check(manager.focus(left) == false, "tui/focus-event/reject-negative-tab-index");
  check(leftFocus == 0, "tui/focus-event/rejected-target-emits-no-focus");
  check(manager.focus(childA), "tui/focus-event/focus-first-child");
  check(order == 1234, "tui/focus-event/none-to-child-order");
  check(leftFocus == 1 && rootFocus == 1 && managerFocus == 1,
    "tui/focus-event/none-to-child-path");

  order = 0;
  check(manager.focus(childB), "tui/focus-event/focus-sibling");
  check(order == 12, "tui/focus-event/sibling-only-targets");
  check(leftFocus == 1 && leftBlur == 0 && rootFocus == 1 && rootBlur == 0 &&
    managerFocus == 1 && managerBlur == 0,
    "tui/focus-event/sibling-common-ancestors-stable");

  order = 0;
  check(manager.focus(childC), "tui/focus-event/focus-other-branch");
  check(order == 1234, "tui/focus-event/blur-before-focus-branch-order");
  check(leftBlur == 1 && rightFocus == 1 && rootFocus == 1 && rootBlur == 0 &&
    managerFocus == 1 && managerBlur == 0,
    "tui/focus-event/root-common-ancestor-stable");

  order = 0;
  check(manager.focus(childC), "tui/focus-event/repeat-focus-success");
  check(order == 0, "tui/focus-event/repeat-focus-no-events");

  manager.clearFocus();
  check(order == 1234, "tui/focus-event/clear-blur-order");
  check(rightBlur == 1 && rootBlur == 1 && managerBlur == 1,
    "tui/focus-event/clear-full-path");
  check(targetsStable, "tui/focus-event/target-stable");
}

/** 验证失效焦点使用缓存旧路径 blur，并串行处理监听器中的重入请求。 */
func view_manager_focus_invalid_path_and_reentrant_request() {
  let manager = ViewManager(Screen(20, 10));
  let root = Container();
  let parent = Container();
  let child = View();
  root.addChild(parent);
  parent.addChild(child);
  child.tabIndex = 0;
  manager.root = root;
  check(manager.focus(child), "tui/focus-event/cache-focus-child");

  var blurOrder = 0;
  var blurTargetStable = true;
  child.onBlur.on((event: FocusEvent<Widget>) {
    blurOrder = blurOrder * 10 + 1;
    blurTargetStable = blurTargetStable && event.target == (Widget)child;
  });
  parent.onBlur.on((event: FocusEvent<Widget>) {
    blurOrder = blurOrder * 10 + 2;
    blurTargetStable = blurTargetStable && event.target == (Widget)child;
  });
  root.onBlur.on((event: FocusEvent<Widget>) {
    blurOrder = blurOrder * 10 + 3;
    blurTargetStable = blurTargetStable && event.target == (Widget)child;
  });
  manager.onBlur.on((event: FocusEvent<Widget>) {
    blurOrder = blurOrder * 10 + 4;
    blurTargetStable = blurTargetStable && event.target == (Widget)child;
  });

  parent.removeChild(child);
  check(managerHasNoFocus(manager), "tui/focus-event/detached-focus-invalid");
  check(blurOrder == 1234, "tui/focus-event/detached-uses-cached-path");
  check(blurTargetStable, "tui/focus-event/detached-blur-target");
  check(managerHasNoFocus(manager), "tui/focus-event/detached-remains-clear");
  check(blurOrder == 1234, "tui/focus-event/detached-blur-once");

  let reentrantManager = ViewManager(Screen(20, 10));
  let reentrantRoot = Container();
  let first = View();
  let skipped = View();
  let last = View();
  first.tabIndex = 0;
  skipped.tabIndex = 0;
  last.tabIndex = 0;
  reentrantRoot.addChild(first);
  reentrantRoot.addChild(skipped);
  reentrantRoot.addChild(last);
  reentrantManager.root = reentrantRoot;

  var firstFocus = 0;
  var firstBlur = 0;
  var skippedFocus = 0;
  var lastFocus = 0;
  var rootFocus = 0;
  var managerFocus = 0;
  first.onFocus.on((event: FocusEvent<Widget>) {
    firstFocus += 1;
    reentrantManager.focus(skipped);
    reentrantManager.focus(last);
  });
  first.onBlur.on((event: FocusEvent<Widget>) { firstBlur += 1; });
  skipped.onFocus.on((event: FocusEvent<Widget>) { skippedFocus += 1; });
  last.onFocus.on((event: FocusEvent<Widget>) { lastFocus += 1; });
  reentrantRoot.onFocus.on((event: FocusEvent<Widget>) { rootFocus += 1; });
  reentrantManager.onFocus.on((event: FocusEvent<Widget>) { managerFocus += 1; });

  check(reentrantManager.focus(first), "tui/focus-event/reentrant-first-request");
  check(firstFocus == 1 && firstBlur == 1, "tui/focus-event/reentrant-first-lifecycle");
  check(skippedFocus == 0 && lastFocus == 1, "tui/focus-event/reentrant-last-request-wins");
  check(rootFocus == 1 && managerFocus == 1,
    "tui/focus-event/reentrant-common-ancestors-stable");
  check(managerHasFocus(reentrantManager, last), "tui/focus-event/reentrant-final-focus");
}

/** 验证鼠标传播、ViewManager 事件及自动聚焦默认行为的组合规则。 */
func view_manager_mouse_default_focus_and_propagation() {
  let manager = ViewManager(Screen(30, 15));
  let root = Container();
  let child = View();
  root.addChild(child);
  root.tabIndex = 5;
  manager.root = root;
  manager.trace(root, makeWidgetFrame(0, 0, 20, 10));
  manager.trace(child, makeWidgetFrame(2, 2, 6, 4));

  var mode = 0;
  var preventAtManager = false;
  var childDown = 0;
  var rootDown = 0;
  var managerDown = 0;
  var managerSawUnbound = false;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    childDown += 1;
    if mode == 1 {
      event.preventDefault();
    } else if mode == 2 {
      event.stop();
    }
  });
  root.mouseDown.on((event: MouseEvent<Widget>) {
    rootDown += 1;
  });
  manager.mouseDown.on((event: MouseEvent<Widget>) {
    managerDown += 1;
    if !event.hasTarget() {
      managerSawUnbound = true;
    }
    if preventAtManager {
      event.preventDefault();
    }
  });

  let nearestAncestor = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(nearestAncestor);
  check(childDown == 1 && rootDown == 1 && managerDown == 1,
    "tui/mouse/propagates-through-manager");
  check(managerHasFocus(manager, root), "tui/mouse/focus-nearest-ancestor");

  child.tabIndex = 0;
  manager.clearFocus();
  mode = 1;
  let preventedByWidget = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(preventedByWidget);
  check(preventedByWidget.isPrevented(), "tui/mouse/widget-prevent-state");
  check(preventedByWidget.isStopped() == false, "tui/mouse/widget-prevent-keeps-routing");
  check(childDown == 2 && rootDown == 2 && managerDown == 2,
    "tui/mouse/prevent-still-propagates");
  check(managerHasNoFocus(manager), "tui/mouse/widget-prevents-focus");

  manager.clearFocus();
  mode = 2;
  let stopped = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(stopped);
  check(stopped.isStopped(), "tui/mouse/stop-state-after-route");
  check(stopped.isPrevented() == false, "tui/mouse/stop-does-not-prevent");
  check(childDown == 3 && rootDown == 2 && managerDown == 2,
    "tui/mouse/stop-skips-root-and-manager");
  check(managerHasFocus(manager, child), "tui/mouse/stop-keeps-default-focus");

  manager.clearFocus();
  mode = 0;
  preventAtManager = true;
  let preventedByManager = MouseEvent<Widget>(MouseAction.Press, MouseButton.Right, 3, 3, 0);
  manager.dispatchMouse(preventedByManager);
  check(childDown == 4 && rootDown == 3 && managerDown == 3,
    "tui/mouse/right-press-routes-through-manager");
  check(preventedByManager.isPrevented(), "tui/mouse/manager-prevent-state");
  check(managerHasNoFocus(manager), "tui/mouse/manager-prevents-focus");

  preventAtManager = false;
  let rightPress = MouseEvent<Widget>(MouseAction.Press, MouseButton.Right, 3, 3, 0);
  manager.dispatchMouse(rightPress);
  check(childDown == 5 && rootDown == 4 && managerDown == 4,
    "tui/mouse/right-press-routes-without-prevent");
  check(managerHasFocus(manager, child), "tui/mouse/all-non-wheel-press-focuses");

  let noHit = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 25, 12, 0);
  manager.dispatchMouse(noHit);
  check(managerDown == 5, "tui/mouse/no-hit-reaches-manager");
  check(managerSawUnbound, "tui/mouse/no-hit-target-unbound");
  check(noHit.hasTarget() == false, "tui/mouse/no-hit-event-unbound");
  check(managerHasFocus(manager, child), "tui/mouse/no-hit-keeps-focus");
}

/** 验证 ViewManager 将全部鼠标输入映射到对应的多播事件。 */
func view_manager_mouse_event_mapping() {
  let manager = ViewManager(Screen(10, 5));
  var down = 0;
  var move = 0;
  var up = 0;
  var wheel = 0;
  manager.mouseDown.on((event: MouseEvent<Widget>) { down += 1; });
  manager.mouseMove.on((event: MouseEvent<Widget>) { move += 1; });
  manager.mouseUp.on((event: MouseEvent<Widget>) { up += 1; });
  manager.wheel.on((event: MouseEvent<Widget>) { wheel += 1; });

  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 20, 20, 0));
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Move, MouseButton.None, 20, 20, 0));
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Release, MouseButton.Left, 20, 20, 0));
  manager.dispatchMouse(MouseEvent<Widget>(MouseAction.Press, MouseButton.WheelUp, 20, 20, 0));

  check(down == 1, "tui/mouse/manager-maps-down");
  check(move == 1, "tui/mouse/manager-maps-move");
  check(up == 1, "tui/mouse/manager-maps-up");
  check(wheel == 1, "tui/mouse/manager-maps-wheel");
  check(managerHasNoFocus(manager), "tui/mouse/wheel-does-not-focus");
}

/** 验证键盘事件从焦点 Widget 到 root、ViewManager 的路由和停止规则。 */
func view_manager_key_focus_route() {
  let manager = ViewManager(Screen(20, 10));
  let root = Container();
  let child = View();
  root.addChild(child);
  child.tabIndex = 0;
  manager.root = root;
  check(manager.focus(child), "tui/key-route/focus-child");

  var order = 0;
  var targetStable = true;
  var stopAtChild = false;
  var managerSawUnbound = false;
  child.key.on((event: KeyEvent<Widget>) {
    order = order * 10 + 1;
    targetStable = targetStable && event.hasTarget() && event.target == (Widget)child;
    if stopAtChild {
      event.stop();
    }
  });
  root.key.on((event: KeyEvent<Widget>) {
    order = order * 10 + 2;
    targetStable = targetStable && event.target == (Widget)child;
  });
  manager.key.on((event: KeyEvent<Widget>) {
    order = order * 10 + 3;
    if !event.hasTarget() {
      managerSawUnbound = true;
    } else {
      targetStable = targetStable && event.target == (Widget)child;
    }
  });

  let routed = KeyEvent<Widget>(SpecialKey.Enter, 0);
  manager.dispatchKey(routed);
  check(order == 123, "tui/key-route/child-root-manager-order");
  check(targetStable, "tui/key-route/target-stable");

  order = 0;
  stopAtChild = true;
  let stopped = KeyEvent<Widget>(SpecialKey.Enter, 0);
  manager.dispatchKey(stopped);
  check(order == 1, "tui/key-route/stop-skips-root-manager");
  check(stopped.isStopped(), "tui/key-route/stop-state-shared");

  stopAtChild = false;
  check(manager.focus(child), "tui/key-route/refocus-before-remove");
  root.removeChild(child);
  order = 0;
  let invalidFocus = KeyEvent<Widget>(SpecialKey.Enter, 0);
  manager.dispatchKey(invalidFocus);
  check(order == 3, "tui/key-route/invalid-focus-manager-only");
  check(managerSawUnbound, "tui/key-route/no-focus-manager-unbound");
  check(invalidFocus.hasTarget() == false, "tui/key-route/invalid-focus-no-target");
  check(managerHasNoFocus(manager), "tui/key-route/invalid-focus-cleared");
}

/** 验证 TuiApp.key 始终位于可停止的 Widget/ViewManager 路由之后。 */
func tuiapp_key_remains_application_level() {
  let app = TuiApp();
  let root = Container();
  let child = View();
  root.addChild(child);
  child.tabIndex = 0;
  app.view.root = root;
  check(app.view.focus(child), "tui/app-key/focus-child");

  var childKeys = 0;
  var managerKeys = 0;
  var appKeys = 0;
  var removableKeys = 0;
  var appSawStoppedTarget = true;
  child.key.on((event: KeyEvent<Widget>) {
    childKeys += 1;
    event.stop();
    event.preventDefault();
  });
  app.view.key.on((event: KeyEvent<Widget>) {
    managerKeys += 1;
  });
  app.key.on((event: KeyEvent<Widget>) {
    appKeys += 1;
    appSawStoppedTarget = appSawStoppedTarget && event.isStopped() &&
      event.isPrevented() && event.hasTarget() &&
      event.target == (Widget)child && event.isControl();
  });
  let removable: Action<KeyEvent<Widget>> = (event: KeyEvent<Widget>) {
    removableKeys += 1;
  };
  app.key.on(removable);

  app.input.feed((u8)0x03);
  check(childKeys == 1, "tui/app-key/widget-receives-input");
  check(managerKeys == 0, "tui/app-key/stop-skips-view-manager");
  check(appKeys == 1 && removableKeys == 1, "tui/app-key/all-listeners-run");
  check(appSawStoppedTarget, "tui/app-key/receives-stopped-prevented-target");

  app.key.off(removable);
  app.input.feed((u8)0x03);
  check(childKeys == 2, "tui/app-key/widget-receives-second-input");
  check(appKeys == 2, "tui/app-key/primary-listener-kept");
  check(removableKeys == 1, "tui/app-key/off-removes-listener");
}

func view_manager_mouse_target_lock_and_bubble() {
  let screen = Screen(40, 20);
  let manager = ViewManager(screen);
  let parent = Container();
  let child = View();
  let other = View();
  parent.addChild(child);
  manager.trace(parent, makeWidgetFrame(0, 0, 12, 12));
  manager.trace(child, makeWidgetFrame(2, 2, 4, 4));
  manager.trace(other, makeWidgetFrame(20, 2, 4, 4));

  var childDown = 0;
  var parentDown = 0;
  var childMove = 0;
  var parentMove = 0;
  var otherMove = 0;
  var targetStable = true;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    childDown += 1;
    targetStable = targetStable && event.hasTarget() &&
      event.target == (Widget)child;
    check(event.lock(), "tui/view/lock-hit-target");
  });
  parent.mouseDown.on((event: MouseEvent<Widget>) {
    parentDown += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  child.mouseMove.on((event: MouseEvent<Widget>) {
    childMove += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  parent.mouseMove.on((event: MouseEvent<Widget>) {
    parentMove += 1;
    targetStable = targetStable && event.target == (Widget)child;
  });
  other.mouseMove.on((event: MouseEvent<Widget>) {
    otherMove += 1;
  });

  let press = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(press);
  check(childDown == 1, "tui/view/hit-child-down");
  check(parentDown == 1, "tui/view/bubble-parent-down");
  check(press.target == (Widget)child, "tui/view/press-target-child");
  check(press.isLocked(), "tui/view/press-lock-established");

  let competing = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 21, 3, 0);
  competing.bindTarget((Widget)other);
  check(competing.lock() == false, "tui/view/lock-cannot-be-stolen");
  competing.unlock();
  check(press.isLocked(), "tui/view/lock-cannot-be-foreign-unlocked");

  let outsideMove = MouseEvent<Widget>(MouseAction.Move, MouseButton.None, 21, 3, 0);
  manager.dispatchMouse(outsideMove);
  check(childMove == 1, "tui/view/locked-move-child");
  check(parentMove == 1, "tui/view/locked-move-bubbles");
  check(otherMove == 0, "tui/view/locked-move-skips-hit-test");
  check(outsideMove.target == (Widget)child, "tui/view/locked-move-target-child");
  check(targetStable, "tui/view/target-stable-during-bubble");

  child.mouseUp.on((event: MouseEvent<Widget>) {
    event.unlock();
  });
  let release = MouseEvent<Widget>(MouseAction.Release, MouseButton.Left, 21, 3, 0);
  manager.dispatchMouse(release);
  check(release.isLocked() == false, "tui/view/release-explicit-unlock");

  let unlockedMove = MouseEvent<Widget>(MouseAction.Move, MouseButton.None, 21, 3, 0);
  manager.dispatchMouse(unlockedMove);
  check(otherMove == 1, "tui/view/unlocked-move-hit-other");
  check(unlockedMove.target == (Widget)other, "tui/view/unlocked-move-target-other");

  parentDown = 0;
  var childAfterStop = 0;
  child.mouseDown.on((event: MouseEvent<Widget>) {
    event.stop();
  });
  child.mouseDown.on((event: MouseEvent<Widget>) {
    if event.isStopped() {
      childAfterStop += 1;
    }
  });
  let stopped = MouseEvent<Widget>(MouseAction.Press, MouseButton.Left, 3, 3, 0);
  manager.dispatchMouse(stopped);
  check(stopped.isStopped(), "tui/view/stop-state-shared");
  check(childAfterStop == 1, "tui/view/stop-keeps-current-widget-listeners");
  check(parentDown == 0, "tui/view/stop-prevents-parent-bubble");
}

// ─── Phase 5: InputManager 测试 ──────────────────────────────────────────

// 模块级捕获变量（回调写入，测试读取验证）
seal var capturedKey: KeyEvent<i32> = KeyEvent<i32>();
seal var keyCaptured: bool = false;
seal var capturedMouse: MouseEvent<i32> = MouseEvent<i32>();
seal var mouseCaptured: bool = false;

func resetCaptures() {
  keyCaptured = false;
  mouseCaptured = false;
}

// 命名函数作为 onKey 回调
func captureKeyHandler(event: KeyEvent<i32>): void {
  capturedKey = event;
  keyCaptured = true;
}

// 命名函数作为 onMouse 回调
func captureMouseHandler(event: MouseEvent<i32>): void {
  capturedMouse = event;
  mouseCaptured = true;
}

func makeInputManager(): InputManager<i32> {
  resetCaptures();
  let mgr = InputManager<i32>();
  mgr.onKey = captureKeyHandler;
  mgr.onMouse = captureMouseHandler;
  return mgr;
}

func feedBytes(mgr: InputManager<i32>, bytes: byte[]) {
  let len = bytes.length();
  for var i: int = 0; i < len; i += 1 {
    mgr.feed((u8)bytes[i]);
  }
}

func input_printable_ascii() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x41);  // 'A'
  check(keyCaptured == true, "tui/input/printable-ascii-captured");
  check(capturedKey.isPrintable() == true, "tui/input/printable-ascii-is-printable");
  check(capturedKey.mods == (u8)0, "tui/input/printable-ascii-mods");
  check(capturedKey.hasTarget() == false, "tui/input/key-target-unbound");
}

func input_enter_key() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x0D);  // CR = Enter
  check(keyCaptured == true, "tui/input/enter-captured");
  check(capturedKey.isPrintable() == false, "tui/input/enter-not-printable");
}

func input_tab_key() {
  let mgr = makeInputManager();
  mgr.feed((u8)0x09);  // HT = Tab
  check(keyCaptured == true, "tui/input/tab-captured");
  check(capturedKey.isPrintable() == false, "tui/input/tab-not-printable");
}

