    test("input_unregistered_callback_drops_events()", () { input_unregistered_callback_drops_events(); });
    test("input_build_enable_mouse_sgr_bytes()", () { input_build_enable_mouse_sgr_bytes(); });
    test("input_build_disable_mouse_sgr_bytes()", () { input_build_disable_mouse_sgr_bytes(); });
  });
}
