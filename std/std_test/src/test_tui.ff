func input_shift_arrow_up() {
  let mgr = makeInputManager();
  // ESC[1;2A = Shift+Up
  let seq: byte[!] = byte[:6];
  seq[0] = (byte)0x1B; seq[1] = (byte)0x5B; seq[2] = (byte)0x31; seq[3] = (byte)0x3B; seq[4] = (byte)0x32; seq[5] = (byte)0x41;
  feedBytes(mgr, (byte[])seq);
  check(keyCaptured == true, "tui/input/shift-up-captured");
  check(capturedKey.isShift() == true, "tui/input/shift-up-is-shift");
  check(capturedKey.isControl() == false, "tui/input/shift-up-not-control");
