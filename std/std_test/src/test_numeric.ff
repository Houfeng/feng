  check(caught, "i16.parse/empty-throws");

  caught = false;
  let r2 = try i16.parse("32768") catch ex: string { caught = true; (i16)0; };
  check(caught, "i16.parse/overflow-throws");

  caught = false;
  let r3 = try i16.parse("-32769") catch ex: string { caught = true; (i16)0; };
  check(caught, "i16.parse/underflow-throws");

  caught = false;
  let r4 = try i16.parse("abc") catch ex: string { caught = true; (i16)0; };
  check(caught, "i16.parse/invalid-throws");
}

/* ---------- i32 ---------- */

func i32_toString_tests() {
  var v0: i32 = 0;
  check(v0.toString() == "0", "i32.toString/zero");
  var v1: i32 = 2147483647;
  check(v1.toString() == "2147483647", "i32.toString/max");
  var v2: i32 = -1;
  check(v2.toString() == "-1", "i32.toString/negative");
  var v3: i32 = 12345;
  check(v3.toString() == "12345", "i32.toString/positive");
}

func i32_parse_tests() {
  check(i32.parse("0") == 0, "i32.parse/zero");
  check(i32.parse("2147483647") == 2147483647, "i32.parse/max");
  check(i32.parse("-2147483648") == -2147483648, "i32.parse/min");
  check(i32.parse("+99") == 99, "i32.parse/positive-sign");
  check(i32.parse("-1") == -1, "i32.parse/negative");
}

func i32_parse_error_tests() {
  var caught: bool = false;

  caught = false;
  let r1 = try i32.parse("") catch ex: string { caught = true; (i32)0; };
  check(caught, "i32.parse/empty-throws");

  caught = false;
  let r2 = try i32.parse("2147483648") catch ex: string { caught = true; (i32)0; };
  check(caught, "i32.parse/overflow-throws");

  caught = false;
  let r3 = try i32.parse("abc") catch ex: string { caught = true; (i32)0; };
  check(caught, "i32.parse/invalid-throws");
}

/* ---------- i64 (i64) ---------- */

func i64_toString_tests() {
  var v0: i64 = (i64)0;
  check(v0.toString() == "0", "i64.toString/zero");
  var v1: i64 = (i64)9223372036854775807;
  check(v1.toString() == "9223372036854775807", "i64.toString/max");
  var v2: i64 = (i64)-1;
  check(v2.toString() == "-1", "i64.toString/negative");
  var v3: i64 = (i64)123456789;
  check(v3.toString() == "123456789", "i64.toString/positive");
}

func i64_parse_tests() {
  check(i64.parse("0") == (i64)0, "i64.parse/zero");
  check(i64.parse("9223372036854775807") == (i64)9223372036854775807, "i64.parse/max");
  check(i64.parse("+100") == (i64)100, "i64.parse/positive-sign");
  check(i64.parse("-1") == (i64)-1, "i64.parse/negative");
}

func i64_parse_error_tests() {
  var caught: bool = false;

  caught = false;
  let r1 = try i64.parse("") catch ex: string { caught = true; (i64)0; };
  check(caught, "i64.parse/empty-throws");

  caught = false;
  let r2 = try i64.parse("9223372036854775808") catch ex: string { caught = true; (i64)0; };
  check(caught, "i64.parse/overflow-throws");

  caught = false;
  let r3 = try i64.parse("abc") catch ex: string { caught = true; (i64)0; };
  check(caught, "i64.parse/invalid-throws");
}

/* ---------- u8 (byte) ---------- */

func u8_toString_tests() {
  var v0: byte = (byte)0;
  check(v0.toString() == "0", "u8.toString/zero");
  var v1: byte = (byte)255;
  check(v1.toString() == "255", "u8.toString/max");
  var v2: byte = (byte)1;
  check(v2.toString() == "1", "u8.toString/one");
  var v3: byte = (byte)100;
  check(v3.toString() == "100", "u8.toString/hundred");
}

func u8_parse_tests() {
  check(byte.parse("0") == (byte)0, "u8.parse/zero");
  check(byte.parse("255") == (byte)255, "u8.parse/max");
  check(byte.parse("+42") == (byte)42, "u8.parse/positive-sign");
}

func u8_parse_error_tests() {
  var caught: bool = false;

  caught = false;
  let r1 = try byte.parse("") catch ex: string { caught = true; (byte)0; };
  check(caught, "u8.parse/empty-throws");

  caught = false;
  let r2 = try byte.parse("256") catch ex: string { caught = true; (byte)0; };
  check(caught, "u8.parse/overflow-throws");

  caught = false;
  let r3 = try byte.parse("-1") catch ex: string { caught = true; (byte)0; };
  check(caught, "u8.parse/negative-throws");

  caught = false;
  let r4 = try byte.parse("abc") catch ex: string { caught = true; (byte)0; };
  check(caught, "u8.parse/invalid-throws");
}

