/* ---------- u64 ---------- */

func u64_toString_tests() {
  var v0: u64 = (u64)0;
  check(v0.toString() == "0", "u64.toString/zero");
  var v1: u64 = (u64)1;
  check(v1.toString() == "1", "u64.toString/one");
  var v2: u64 = (u64)9876543210;
  check(v2.toString() == "9876543210", "u64.toString/typical");
  var v3: u64 = u64.parse("18446744073709551615");
  check(v3.toString() == "18446744073709551615", "u64.toString/max");
}

func u64_parse_tests() {
  check(u64.parse("0") == (u64)0, "u64.parse/zero");
  check(u64.parse("18446744073709551615") == (u64)18446744073709551615, "u64.parse/max");
  check(u64.parse("+100") == (u64)100, "u64.parse/positive-sign");
}

func u64_parse_error_tests() {
  var caught: bool = false;

  caught = false;
  let r1 = try u64.parse("") catch ex: string { caught = true; (u64)0; };
  check(caught, "u64.parse/empty-throws");

  caught = false;
  let r2 = try u64.parse("18446744073709551616") catch ex: string { caught = true; (u64)0; };
  check(caught, "u64.parse/overflow-throws");

  caught = false;
  let r3 = try u64.parse("-1") catch ex: string { caught = true; (u64)0; };
  check(caught, "u64.parse/negative-throws");

  caught = false;
  let r4 = try u64.parse("abc") catch ex: string { caught = true; (u64)0; };
  check(caught, "u64.parse/invalid-throws");
}

/* ---------- runner ---------- */

open func run_numeric_tests() {
  describe("numeric tests", () {
    test("f64_parse_tests()", () { f64_parse_tests(); });
    test("f64_parse_error_tests()", () { f64_parse_error_tests(); });
    test("f32_parse_tests()", () { f32_parse_tests(); });
    test("f32_parse_error_tests()", () { f32_parse_error_tests(); });
    test("i8_toString_tests()", () { i8_toString_tests(); });
    test("i8_parse_tests()", () { i8_parse_tests(); });
    test("i8_parse_error_tests()", () { i8_parse_error_tests(); });
    test("i16_toString_tests()", () { i16_toString_tests(); });
    test("i16_parse_tests()", () { i16_parse_tests(); });
    test("i16_parse_error_tests()", () { i16_parse_error_tests(); });
    test("i32_toString_tests()", () { i32_toString_tests(); });
    test("i32_parse_tests()", () { i32_parse_tests(); });
    test("i32_parse_error_tests()", () { i32_parse_error_tests(); });
    test("i64_toString_tests()", () { i64_toString_tests(); });
    test("i64_parse_tests()", () { i64_parse_tests(); });
    test("i64_parse_error_tests()", () { i64_parse_error_tests(); });
    test("u8_toString_tests()", () { u8_toString_tests(); });
    test("u8_parse_tests()", () { u8_parse_tests(); });
    test("u8_parse_error_tests()", () { u8_parse_error_tests(); });
    test("u16_toString_tests()", () { u16_toString_tests(); });
    test("u16_parse_tests()", () { u16_parse_tests(); });
    test("u16_parse_error_tests()", () { u16_parse_error_tests(); });
    test("u32_toString_tests()", () { u32_toString_tests(); });
    test("u32_parse_tests()", () { u32_parse_tests(); });
    test("u32_parse_error_tests()", () { u32_parse_error_tests(); });
    test("u64_toString_tests()", () { u64_toString_tests(); });
    test("u64_parse_tests()", () { u64_parse_tests(); });
    test("u64_parse_error_tests()", () { u64_parse_error_tests(); });
  });
}