module std_test;

import std.test;

import std.io;
import std.text;
import std.collections;

/* ---------- 10.1 Construction and basic matching ---------- */

func regexp_test_basic() {
  let re1 = RegExp("hello");
  check(re1.test("hello world") == true, "regexp/test-found");
  check(re1.test("world") == false, "regexp/test-not-found");
  re1.destroy();

  let re2 = RegExp("hello");
  check(re2.isMatch("hello") == true, "regexp/isMatch-full");
  check(re2.isMatch("hello world") == false, "regexp/isMatch-partial");
  re2.destroy();

  let re3 = RegExp("\\d+");
  check(re3.test("abc123") == true, "regexp/test-digits");
  check(re3.test("abc") == false, "regexp/test-no-digits");
  re3.destroy();

  writeLine("__REGEXP_BASIC__=ok");
}

/* ---------- 10.2 Case insensitive ---------- */

func regexp_test_case_insensitive() {
  let re = RegExp("hello", RegExpFlag.CaseInsensitive);
  check(re.test("HELLO") == true, "regexp/ci-test");
  check(re.isMatch("Hello") == true, "regexp/ci-isMatch");
  re.destroy();

  writeLine("__REGEXP_CASE_INSENSITIVE__=ok");
}

/* ---------- 10.3 find ---------- */

func regexp_test_find() {
  let re1 = RegExp("\\d+");
  let r1 = re1.find("abc123def");
  check(r1.length() == (int)1, "regexp/find-found");
  check(r1[0].text == "123", "regexp/find-text");
  check(r1[0].start == (int)3, "regexp/find-start");
  check(r1[0].end == (int)6, "regexp/find-end");
  re1.destroy();

  let re2 = RegExp("\\d+");
  let r2 = re2.find("abcdef");
  check(r2.length() == (int)0, "regexp/find-none");
  re2.destroy();

  let re3 = RegExp("(\\w+)@(\\w+)");
  let r3 = re3.find("user@host");
  check(r3.length() == (int)1, "regexp/find-groups-found");
  check(r3[0].groups.length() == (int)3, "regexp/find-groups-count");
  check(r3[0].groups[0] == "user@host", "regexp/find-groups-0");
  check(r3[0].groups[1] == "user", "regexp/find-groups-1");
  check(r3[0].groups[2] == "host", "regexp/find-groups-2");
  re3.destroy();

  writeLine("__REGEXP_FIND__=ok");
}

/* ---------- 10.4 findAll ---------- */

func regexp_test_findAll() {
  let re1 = RegExp("\\d+");
  let r1 = re1.findAll("a1b22c333");
  check(r1.length() == (int)3, "regexp/findAll-count");
  check(r1[0].text == "1", "regexp/findAll-first");
  check(r1[1].text == "22", "regexp/findAll-second");
  check(r1[2].text == "333", "regexp/findAll-third");
  re1.destroy();

  let re2 = RegExp("\\d+");
  let r2 = re2.findAll("abc");
  check(r2.length() == (int)0, "regexp/findAll-none");
  re2.destroy();

  writeLine("__REGEXP_FIND_ALL__=ok");
}

/* ---------- 10.5 split ---------- */

func regexp_test_split() {
  let re1 = RegExp("[,;]");
  let r1 = re1.split("a,b;c");
  check(r1.length() == (int)3, "regexp/split-count");
  check(r1[0] == "a", "regexp/split-first");
  check(r1[1] == "b", "regexp/split-mid");
  check(r1[2] == "c", "regexp/split-last");
  re1.destroy();

  let re2 = RegExp("\\s+");
  let r2 = re2.split("hello  world");
  check(r2.length() == (int)2, "regexp/split-ws-count");
  check(r2[0] == "hello", "regexp/split-ws-first");
  check(r2[1] == "world", "regexp/split-ws-last");
  re2.destroy();

  let re3 = RegExp("\\d+");
  let r3 = re3.split("abc");
  check(r3.length() == (int)1, "regexp/split-no-match");
  check(r3[0] == "abc", "regexp/split-no-match-val");
  re3.destroy();

  writeLine("__REGEXP_SPLIT__=ok");
}

/* ---------- 10.6 replaceFirst / replaceAll ---------- */

func regexp_test_replace() {
  let re1 = RegExp("\\d+");
  check(re1.replaceFirst("a1b2c3", "X") == "aXb2c3", "regexp/replaceFirst");
  check(re1.replaceAll("a1b2c3", "X") == "aXbXcX", "regexp/replaceAll");
  re1.destroy();

  let re2 = RegExp("(\\w+)@(\\w+)");
  check(re2.replaceAll("user@host", "$2/$1") == "host/user", "regexp/replace-backref");
  re2.destroy();

  writeLine("__REGEXP_REPLACE__=ok");
}

/* ---------- 10.7 Unicode ---------- */

func regexp_test_unicode() {
  let re1 = RegExp("\\p{L}+");
  let r1 = re1.find("abc123");
  check(r1.length() == (int)1, "regexp/unicode-pL-found");
  check(r1[0].text == "abc", "regexp/unicode-pL");
  re1.destroy();

  let re2 = RegExp("中.");
  let r2 = re2.find("中文abc");
  check(r2.length() == (int)1, "regexp/unicode-cjk-found");
  check(r2[0].text == "中文", "regexp/unicode-cjk");
  re2.destroy();

  let re3 = RegExp("\\p{Han}+");
  let r3 = re3.findAll("hello中文world你好");
  check(r3.length() == (int)2, "regexp/unicode-han-count");
  check(r3[0].text == "中文", "regexp/unicode-han-first");
  check(r3[1].text == "你好", "regexp/unicode-han-second");
  re3.destroy();

  writeLine("__REGEXP_UNICODE__=ok");
}

/* ---------- 10.8 Compile error ---------- */

func regexp_test_compile_error() {
  var caught = false;
  try RegExp("[invalid") catch e: string {
    caught = e.contains("compile error");
  }
  check(caught == true, "regexp/compile-error");

  writeLine("__REGEXP_COMPILE_ERROR__=ok");
}

/* ---------- 10.9 String convenience methods ---------- */

func regexp_test_string_methods() {
  check("hello123".matches("\\w+") == true, "regexp/string-matches-true");
  check("hello123".matches("\\d+") == false, "regexp/string-matches-false");
  check("a1b2c3".replacePattern("\\d+", "X") == "aXbXcX", "regexp/string-replacePattern");

  let parts = "a,b;c".splitPattern("[,;]");
  check(parts.length() == (int)3, "regexp/string-splitPattern-count");
  check(parts[0] == "a", "regexp/string-splitPattern-first");
  check(parts[1] == "b", "regexp/string-splitPattern-mid");
  check(parts[2] == "c", "regexp/string-splitPattern-last");

  writeLine("__REGEXP_STRING_METHODS__=ok");
}

/* ---------- 10.10 Multiline flag ---------- */

func regexp_test_multiline() {
  let re = RegExp("^hello", RegExpFlag.Multiline);
  check(re.test("world\nhello") == true, "regexp/multiline-test");
  check(re.isMatch("world\nhello") == false, "regexp/multiline-isMatch-false");
  let r = re.find("first\nhello there");
  check(r.length() == (int)1, "regexp/multiline-find-found");
  check(r[0].text == "hello", "regexp/multiline-find-text");
  check(r[0].start == (int)6, "regexp/multiline-find-start");
  re.destroy();

  writeLine("__REGEXP_MULTILINE__=ok");
}

/* ---------- 10.11 DotAll flag ---------- */

func regexp_test_dotall() {
  let re1 = RegExp("a.b");
  check(re1.test("a\nb") == false, "regexp/dotall-off");
  re1.destroy();

  let re2 = RegExp("a.b", RegExpFlag.DotAll);
  check(re2.test("a\nb") == true, "regexp/dotall-on");
  check(re2.isMatch("a\nb") == true, "regexp/dotall-isMatch");
  re2.destroy();

  writeLine("__REGEXP_DOTALL__=ok");
}

/* ---------- 10.12 findAll match positions ---------- */

func regexp_test_findAll_positions() {
  let re = RegExp("\\d+");
  let r = re.findAll("a1b22c333");
  check(r.length() == (int)3, "regexp/findAll-pos-count");
  check(r[0].start == (int)1, "regexp/findAll-pos-0-start");
  check(r[0].end == (int)2, "regexp/findAll-pos-0-end");
  check(r[1].start == (int)3, "regexp/findAll-pos-1-start");
  check(r[1].end == (int)5, "regexp/findAll-pos-1-end");
  check(r[2].start == (int)6, "regexp/findAll-pos-2-start");
  check(r[2].end == (int)9, "regexp/findAll-pos-2-end");
  re.destroy();

  writeLine("__REGEXP_FINDALL_POS__=ok");
}

/* ---------- 10.13 findAll with groups ---------- */

func regexp_test_findAll_groups() {
  let re = RegExp("(\\w+)=(\\w+)");
  let r = re.findAll("a=1 b=2");
  check(r.length() == (int)2, "regexp/findAll-groups-count");
  check(r[0].groups[1] == "a", "regexp/findAll-groups-0-1");
  check(r[0].groups[2] == "1", "regexp/findAll-groups-0-2");
  check(r[1].groups[1] == "b", "regexp/findAll-groups-1-1");
  check(r[1].groups[2] == "2", "regexp/findAll-groups-1-2");
  re.destroy();

  writeLine("__REGEXP_FINDALL_GROUPS__=ok");
}

/* ---------- 10.14 replace no-match and empty subject ---------- */

func regexp_test_replace_edge() {
  let re = RegExp("\\d+");
  check(re.replaceFirst("abc", "X") == "abc", "regexp/replaceFirst-no-match");
  check(re.replaceAll("abc", "X") == "abc", "regexp/replaceAll-no-match");
  check(re.replaceFirst("", "X") == "", "regexp/replaceFirst-empty-subject");
  check(re.replaceAll("", "X") == "", "regexp/replaceAll-empty-subject");
  re.destroy();

  writeLine("__REGEXP_REPLACE_EDGE__=ok");
}

/* ---------- 10.15 replace with empty replacement ---------- */

func regexp_test_replace_empty_replacement() {
  let re = RegExp("\\d+");
  check(re.replaceFirst("a1b2", "") == "ab2", "regexp/replaceFirst-empty-repl");
  check(re.replaceAll("a1b2", "") == "ab", "regexp/replaceAll-empty-repl");
  re.destroy();

  writeLine("__REGEXP_REPLACE_EMPTY_REPL__=ok");
}

/* ---------- 10.16 test/isMatch on empty strings ---------- */

func regexp_test_empty_subject() {
  let re1 = RegExp("\\d+");
  check(re1.test("") == false, "regexp/test-empty-subject");
  check(re1.isMatch("") == false, "regexp/isMatch-empty-subject");
  re1.destroy();

  let re2 = RegExp(".*");
  check(re2.test("") == true, "regexp/test-empty-subject-star");
  check(re2.isMatch("") == true, "regexp/isMatch-empty-subject-star");
  re2.destroy();

  writeLine("__REGEXP_EMPTY_SUBJECT__=ok");
}

/* ---------- 10.17 find on UTF-8 ---------- */

func regexp_test_find_utf8() {
  let re = RegExp("\\p{Han}+");
  let r = re.find("hello中文world");
  check(r.length() == (int)1, "regexp/find-utf8-found");
  check(r[0].text == "中文", "regexp/find-utf8-text");
  check(r[0].start == (int)5, "regexp/find-utf8-start");
  check(r[0].end == (int)11, "regexp/find-utf8-end");
  re.destroy();

  writeLine("__REGEXP_FIND_UTF8__=ok");
}

/* ---------- 10.18 split with leading/trailing delimiter ---------- */

func regexp_test_split_edges() {
  let re = RegExp(",");
  let r1 = re.split(",a,b,");
  check(r1.length() == (int)4, "regexp/split-leading-trailing-count");
  check(r1[0] == "", "regexp/split-leading-empty");
  check(r1[1] == "a", "regexp/split-mid-a");
  check(r1[2] == "b", "regexp/split-mid-b");
  check(r1[3] == "", "regexp/split-trailing-empty");
  re.destroy();

  writeLine("__REGEXP_SPLIT_EDGES__=ok");
}

/* ---------- 10.19 string convenience methods edge cases ---------- */

func regexp_test_string_methods_edge() {
  check("".matches(".*") == true, "regexp/string-matches-empty-star");
  check("".matches("\\d+") == false, "regexp/string-matches-empty-digits");
  check("abc".replacePattern("xyz", "X") == "abc", "regexp/string-replacePattern-no-match");
  check("".replacePattern("\\d+", "X") == "", "regexp/string-replacePattern-empty");

  let parts = "abc".splitPattern("xyz");
  check(parts.length() == (int)1, "regexp/string-splitPattern-no-match-count");
  check(parts[0] == "abc", "regexp/string-splitPattern-no-match-val");

  writeLine("__REGEXP_STRING_METHODS_EDGE__=ok");
}

/* ---------- 10.20 original edge cases ---------- */

func regexp_test_edge_cases() {
  let re1 = RegExp("");
  check(re1.test("") == true, "regexp/empty-pattern-empty-subject");
  re1.destroy();

  let re2 = RegExp("");
  let r2 = re2.findAll("abc");
  check(r2.length() == (int)4, "regexp/empty-pattern-findAll");
  re2.destroy();

  let re3 = RegExp("\\d+");
  let r3 = re3.split("");
  check(r3.length() == (int)1, "regexp/split-empty-subject");
  check(r3[0] == "", "regexp/split-empty-subject-val");
  re3.destroy();

  let re4 = RegExp("\\d+");
  re4.find("abc");
  re4.destroy();
  check(true, "regexp/destroy-no-crash");

  writeLine("__REGEXP_EDGE_CASES__=ok");
}

/* ---------- Entry point ---------- */

open func run_regexp_tests() {
  describe("regexp tests", () {
    test("regexp_test_basic()", () { regexp_test_basic(); });
    test("regexp_test_case_insensitive()", () { regexp_test_case_insensitive(); });
    test("regexp_test_find()", () { regexp_test_find(); });
    test("regexp_test_findAll()", () { regexp_test_findAll(); });
    test("regexp_test_split()", () { regexp_test_split(); });
    test("regexp_test_replace()", () { regexp_test_replace(); });
    test("regexp_test_unicode()", () { regexp_test_unicode(); });
    test("regexp_test_compile_error()", () { regexp_test_compile_error(); });
    test("regexp_test_string_methods()", () { regexp_test_string_methods(); });
    test("regexp_test_multiline()", () { regexp_test_multiline(); });
    test("regexp_test_dotall()", () { regexp_test_dotall(); });
    test("regexp_test_findAll_positions()", () { regexp_test_findAll_positions(); });
    test("regexp_test_findAll_groups()", () { regexp_test_findAll_groups(); });
    test("regexp_test_replace_edge()", () { regexp_test_replace_edge(); });
    test("regexp_test_replace_empty_replacement()", () { regexp_test_replace_empty_replacement(); });
    test("regexp_test_empty_subject()", () { regexp_test_empty_subject(); });
    test("regexp_test_find_utf8()", () { regexp_test_find_utf8(); });
    test("regexp_test_split_edges()", () { regexp_test_split_edges(); });
    test("regexp_test_string_methods_edge()", () { regexp_test_string_methods_edge(); });
    test("regexp_test_edge_cases()", () { regexp_test_edge_cases(); });
  });
}