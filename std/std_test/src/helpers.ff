module std_test;

import std.test;
import std.text;

@cdecl("libc")
extern func write(fd: i32, buf: string*, count: int): int;

@cdecl("libc")
extern func pipe(fds: i32*): i32;

@cdecl("libc")
extern func dup2(from: i32, to: i32): i32;

@cdecl("libc")
extern func close(fd: i32): i32;

@cdecl("libc")
extern func exit(code: int): void;

func logLine(text: string) {
  let newline = "\n";

  write((i32)2, &text, text.length());
  write((i32)2, &newline, newline.length());
}

func failNow(name: string) {
  logLine("FAIL: " + name);
  exit(1);
}

open func check(cond: bool, name: string) {
  assert(cond, name, []);
}

open func replaceStdin(text: string) {
  let fds: i32[!] = i32[: (int)2];

  if pipe(&fds) != (i32)0 {
    failNow("harness/stdin-pipe");
  }
  if write(fds[1], &text, text.length()) != text.length() {
    close(fds[0]);
    close(fds[1]);
    failNow("harness/stdin-write");
  }
  if close(fds[1]) != (i32)0 {
    close(fds[0]);
    failNow("harness/stdin-close-write");
  }
  if dup2(fds[0], (i32)0) < (i32)0 {
    close(fds[0]);
    failNow("harness/stdin-dup2");
  }
  if close(fds[0]) != (i32)0 {
    failNow("harness/stdin-close-read");
  }
}
