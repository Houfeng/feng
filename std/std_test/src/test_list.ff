module std_test;

import std.test;

import std.io;
import std.collections;

type RefBox {
  var value: i32;
}

func list_add_get() {
  let l = List<i32>();
  let v0: i32 = 42;
  l.add(v0);
  check(l.get(0) == 42, "list/add-get");
}

func list_size() {
  let l = List<i32>();
  check(l.size() == 0, "list/size-empty");
  let v1: i32 = 1;
  let v2: i32 = 2;
  let v3: i32 = 3;
  l.add(v1);
  l.add(v2);
  l.add(v3);
  check(l.size() == 3, "list/size-after-add");
}

func list_set_index() {
  let l = List<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 99;
  l.add(a);
  l.add(b);
  l.set(0, c);
  check(l.get(0) == 99, "list/set-index");
  check(l.get(1) == 20, "list/set-index-other-unchanged");
}

func list_remove_at_shifts() {
  let l = List<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 30;
  l.add(a);
  l.add(b);
  l.add(c);
  l.removeAt(0);
  check(l.get(0) == 20, "list/remove-at-shifts-first");
  check(l.get(1) == 30, "list/remove-at-shifts-second");
}

func list_size_after_remove_at() {
  let l = List<i32>();
  let a: i32 = 1;
  let b: i32 = 2;
  let c: i32 = 3;
  l.add(a);
  l.add(b);
  l.add(c);
  l.removeAt(1);
  check(l.size() == 2, "list/size-after-remove-at");
}

func list_remove_value_first_match() {
  let l = List<i32>();
  l.add(10);
  l.add(20);
  l.add(20);
  l.add(30);

  check(l.remove(20), "list/remove-value-found");
  check(l.size() == 3, "list/remove-value-size");
  check(l.get(0) == 10, "list/remove-value-first");
  check(l.get(1) == 20, "list/remove-value-keeps-second-match");
  check(l.get(2) == 30, "list/remove-value-last");
}

func list_remove_value_absent() {
  let l = List<i32>();
  l.add(10);
  l.add(20);

  check(!l.remove(99), "list/remove-value-absent");
  check(l.size() == 2, "list/remove-value-absent-size");
  check(l.get(0) == 10, "list/remove-value-absent-first");
  check(l.get(1) == 20, "list/remove-value-absent-second");
}

func list_remove_value_uses_string_equality() {
  let l = List<string>();
  let prefix = "feng";
  let stored = prefix + "-lang";
  let target = "feng-lang";
  l.add(stored);

  check(l.remove(target), "list/remove-value-string-found");
  check(l.size() == 0, "list/remove-value-string-size");
}

func list_remove_value_uses_object_identity() {
  let stored = RefBox { value: 7 };
  let equalFields = RefBox { value: 7 };
  let l = List<RefBox>();
  l.add(stored);

  check(!l.remove(equalFields), "list/remove-value-object-distinct");
  check(l.remove(stored), "list/remove-value-object-identical");
  check(l.size() == 0, "list/remove-value-object-size");
}

func list_multiple_elements() {
  let l = List<i32>();
  for var i: int = 0; i < 20; i = i + 1 {
    l.add((i32)i);
  }
  check(l.size() == 20, "list/multiple-size");
  var allOk: bool = true;
  for var i: int = 0; i < 20; i = i + 1 {
    if l.get(i) != (i32)i {
      allOk = false;
    }
  }
  check(allOk, "list/multiple-values");
}

func list_entities_order() {
  let l = List<i32>();
  l.add(100);
  l.add(200);
  l.add(300);
  let ents = l.entries();
  check(ents[0] == 100, "list/entities-order-0");
  check(ents[1] == 200, "list/entities-order-1");
  check(ents[2] == 300, "list/entities-order-2");
}

func list_entities_count() {
  let l = List<i32>();
  l.add(1);
  l.add(2);
  check(l.size() == 2, "list/entities-count");
}

func list_reference_semantics() {
  let l = List<RefBox>();
  let b = RefBox { value: 10 };
  l.add(b);
  b.value = 99;
  check(l.get(0).value == 99, "list/reference-semantics");
}

func list_writable_array_constructor_is_private() {
  let source: i32[!] = [10, 20, 30];
  let l = List<i32>(source);

  source[0] = 99;
  l.set(1, 88);

  check(l.size() == 3, "list/writable-array-constructor-size");
  check(l.get(0) == 10, "list/writable-array-constructor-source-independent");
  check(source[1] == 20, "list/writable-array-constructor-list-independent");
}

func list_readonly_array_constructor_copies() {
  let source: i32[] = [4, 5, 6];
  let l = List<i32>(source);

  l.set(0, 40);

  check(l.size() == 3, "list/readonly-array-constructor-size");
  check(l.get(0) == 40, "list/readonly-array-constructor-list-write");
  check(source[0] == 4, "list/readonly-array-constructor-source-independent");
}

func list_insert_positions() {
  let l = List<i32>();
  l.add(20);
  l.add(40);
  l.insert(0, 10);
  l.insert(2, 30);
  l.insert(4, 50);

  check(l.size() == 5, "list/insert-positions-size");
  check(l.get(0) == 10, "list/insert-head");
  check(l.get(1) == 20, "list/insert-after-head");
  check(l.get(2) == 30, "list/insert-middle");
  check(l.get(3) == 40, "list/insert-before-tail");
  check(l.get(4) == 50, "list/insert-tail");
}

func list_insert_grows_full_storage() {
  let l = List<i32>(2);
  l.add(1);
  l.add(3);
  l.insert(1, 2);

  check(l.size() == 3, "list/insert-grow-size");
  check(l.get(0) == 1, "list/insert-grow-0");
  check(l.get(1) == 2, "list/insert-grow-1");
  check(l.get(2) == 3, "list/insert-grow-2");
}

func list_capacity_constructor_starts_empty() {
  let l = List<i32>(16);
  check(l.size() == 0, "list/capacity-constructor-empty");

  l.add(7);
  l.add(8);

  check(l.size() == 2, "list/capacity-constructor-size");
  check(l.get(0) == 7, "list/capacity-constructor-0");
  check(l.get(1) == 8, "list/capacity-constructor-1");
}

func list_clear_reuses_storage() {
  let l = List<string>(16);
  l.add("alpha");
  l.add("beta");
  l.clear();

  check(l.size() == 0, "list/clear-size");

  l.add("gamma");
  check(l.size() == 1, "list/clear-reuse-size");
  check(l.get(0) == "gamma", "list/clear-reuse-value");
}

func list_remove_at_shrinks_and_preserves_order() {
  let l = List<i32>();
  for var i: int = 0; i < 32; i = i + 1 {
    l.add((i32)i);
  }
  for var i: int = 0; i < 28; i = i + 1 {
    l.removeAt(0);
  }

  check(l.size() == 4, "list/shrink-size");
  check(l.get(0) == 28, "list/shrink-0");
  check(l.get(1) == 29, "list/shrink-1");
  check(l.get(2) == 30, "list/shrink-2");
  check(l.get(3) == 31, "list/shrink-3");
}

func list_insert_managed_element() {
  let first = RefBox { value: 1 };
  let middle = RefBox { value: 2 };
  let last = RefBox { value: 3 };
  let l = List<RefBox>();
  l.add(first);
  l.add(last);
  l.insert(1, middle);

  check(l.size() == 3, "list/insert-managed-size");
  check(l.get(0).value == 1, "list/insert-managed-0");
  check(l.get(1).value == 2, "list/insert-managed-1");
  check(l.get(2).value == 3, "list/insert-managed-2");
}

func list_for_in_basic() {
  let l = List<i32>();
  l.add(10);
  l.add(20);
  l.add(30);
  var sum: i32 = 0;
  for let v in l {
    sum = sum + v;
  }
  check(sum == 60, "list/for-in-basic");
}

func list_for_in_empty() {
  let l = List<i32>();
  var count: i32 = 0;
  for let v in l {
    count = count + v;
  }
  check(count == 0, "list/for-in-empty");
}

func list_for_in_nested() {
  let a = List<i32>();
  a.add(1);
  a.add(2);
  let b = List<i32>();
  b.add(10);
  b.add(20);
  var sum: i32 = 0;
  for let x in a {
    for let y in b {
      sum = sum + x * y;
    }
  }
  check(sum == 90, "list/for-in-nested");
}

func list_for_in_string() {
  let l = List<string>();
  l.add("a");
  l.add("b");
  l.add("c");
  var result = "";
  for let s in l {
    result = result + s;
  }
  check(result == "abc", "list/for-in-string");
  writeLine("__LIST_FOR_IN__=" + result);
}

type ForInGenericTester<T> {
  var items: List<T>;
  var lastSeen: T;
  var total: i32;

  func iterateAll() {
    self.total = 0;
    for let v in self.items {
      self.lastSeen = v;
      self.total = self.total + 1;
    }
  }
}

func list_for_in_generic() {
  let l = List<i32>();
  l.add(10);
  l.add(20);
  l.add(30);
  let t = ForInGenericTester<i32>();
  t.items = l;
  t.iterateAll();
  check(t.total == 3, "list/for-in-generic-count");
  check(t.lastSeen == 30, "list/for-in-generic-last-i32");
}

func list_for_in_generic_string() {
  let l = List<string>();
  l.add("alpha");
  l.add("beta");
  let t = ForInGenericTester<string>();
  t.items = l;
  t.iterateAll();
  check(t.total == 2, "list/for-in-generic-string-count");
  check(t.lastSeen == "beta", "list/for-in-generic-last-string");
}

open func run_list_tests() {
  describe("list tests", () {
    test("list_add_get()", () { list_add_get(); });
    test("list_size()", () { list_size(); });
    test("list_set_index()", () { list_set_index(); });
    test("list_remove_at_shifts()", () { list_remove_at_shifts(); });
    test("list_size_after_remove_at()", () { list_size_after_remove_at(); });
    test("list_remove_value_first_match()", () { list_remove_value_first_match(); });
    test("list_remove_value_absent()", () { list_remove_value_absent(); });
    test("list_remove_value_uses_string_equality()", () { list_remove_value_uses_string_equality(); });
    test("list_remove_value_uses_object_identity()", () { list_remove_value_uses_object_identity(); });
    test("list_multiple_elements()", () { list_multiple_elements(); });
    test("list_entities_order()", () { list_entities_order(); });
    test("list_entities_count()", () { list_entities_count(); });
    test("list_reference_semantics()", () { list_reference_semantics(); });
    test("list_writable_array_constructor_is_private()", () { list_writable_array_constructor_is_private(); });
    test("list_readonly_array_constructor_copies()", () { list_readonly_array_constructor_copies(); });
    test("list_insert_positions()", () { list_insert_positions(); });
    test("list_insert_grows_full_storage()", () { list_insert_grows_full_storage(); });
    test("list_capacity_constructor_starts_empty()", () { list_capacity_constructor_starts_empty(); });
    test("list_clear_reuses_storage()", () { list_clear_reuses_storage(); });
    test("list_remove_at_shrinks_and_preserves_order()", () { list_remove_at_shrinks_and_preserves_order(); });
    test("list_insert_managed_element()", () { list_insert_managed_element(); });
    test("list_for_in_basic()", () { list_for_in_basic(); });
    test("list_for_in_empty()", () { list_for_in_empty(); });
    test("list_for_in_nested()", () { list_for_in_nested(); });
    test("list_for_in_string()", () { list_for_in_string(); });
    test("list_for_in_generic()", () { list_for_in_generic(); });
    test("list_for_in_generic_string()", () { list_for_in_generic_string(); });
  });
}
