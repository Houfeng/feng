module std_test;

import std.test;

import std.collections;

/** A set test key that forces every entry into the same bucket chain. */
type SetCollisionKey: Hashable<SetCollisionKey> {
  let value: i32;

  /** Returns a constant hash to exercise collision-chain maintenance. */
  func hash(): u64 {
    return (u64)1;
  }

  /** Compares collision keys by their stored integer value. */
  func same(other: SetCollisionKey): bool {
    return self.value == other.value;
  }
}

/** A managed set key used to verify key lifecycle across storage migration. */
type SetManagedKey: Hashable<SetManagedKey> {
  let value: i32;

  /** Returns the stored integer as the key hash. */
  func hash(): u64 {
    return (u64)self.value;
  }

  /** Compares managed keys by their stored integer value. */
  func same(other: SetManagedKey): bool {
    return self.value == other.value;
  }
}

func set_add_has() {
  let s = Set<IntKey>();
  let k = IntKey { value: 10 };
  s.add(k);
  check(s.has(k), "set/add-has");
}

func set_has_false() {
  let s = Set<IntKey>();
  let k = IntKey { value: 99 };
  check(!s.has(k), "set/has-false");
}

func set_add_duplicate() {
  let s = Set<IntKey>();
  let k = IntKey { value: 5 };
  s.add(k);
  s.add(k);
  check(s.count() == 1, "set/add-duplicate");
}

func set_remove() {
  let s = Set<IntKey>();
  let k = IntKey { value: 8 };
  s.add(k);
  s.remove(k);
  check(!s.has(k), "set/remove");
}

func set_remove_absent() {
  let s = Set<IntKey>();
  let k = IntKey { value: 42 };
  s.remove(k);
  check(!s.has(k), "set/remove-absent");
}

func set_multiple_elements() {
  let s = Set<IntKey>();
  for var i: i32 = 0; i < 20; i = i + 1 {
    s.add(IntKey { value: i });
  }
  var allPresent: bool = true;
  for var i: i32 = 0; i < 20; i = i + 1 {
    if !s.has(IntKey { value: i }) {
      allPresent = false;
    }
  }
  check(allPresent, "set/multiple-elements");
  s.remove(IntKey { value: 5 });
  s.remove(IntKey { value: 15 });
  check(!s.has(IntKey { value: 5 }), "set/multiple-remove-1");
  check(!s.has(IntKey { value: 15 }), "set/multiple-remove-2");
  check(s.has(IntKey { value: 10 }), "set/multiple-survivor");
}

func set_count() {
  let s = Set<IntKey>();
  check(s.count() == 0, "set/count-empty");
  s.add(IntKey { value: 1 });
  s.add(IntKey { value: 2 });
  s.add(IntKey { value: 3 });
  check(s.count() == 3, "set/count-after-add");
  s.remove(IntKey { value: 2 });
  check(s.count() == 2, "set/count-after-remove");
}

func set_entities_two() {
  let s = Set<IntKey>();
  let k7 = IntKey { value: 7 };
  let k13 = IntKey { value: 13 };
  s.add(k7);
  s.add(k13);
  let ents = s.entries();
  let a: i32 = ents[0].value;
  let b: i32 = ents[1].value;
  check((a == 7) || (b == 7), "set/entities-has-7");
  check((a == 13) || (b == 13), "set/entities-has-13");
}

func set_int_direct_call() {
  let h: Hashable<i32> = (i32)7;
  check(h.same((i32)7), "set/int-hashable-same");
  let s = Set<i32>();
  s.add((i32)7);
  s.add((i32)13);
  check(s.count() == 2, "set/int-count-2");
  let ents = s.entries();
  let a = ents[0];
  let b = ents[1];
  check((a == (i32)7) || (b == (i32)7), "set/int-entries-has-7");
  check((a == (i32)13) || (b == (i32)13), "set/int-entries-has-13");
}

/** Verifies collision chains after removals move the last dense entry. */
func set_collision_remove_keeps_dense_chains() {
  let s = Set<SetCollisionKey>();
  for var i: i32 = 0; i < 32; i = i + 1 {
    let key = SetCollisionKey { value: i };
    s.add(key);
    s.add(key);
  }

  s.remove(SetCollisionKey { value: 5 });
  s.remove(SetCollisionKey { value: 17 });
  var valid: bool = s.count() == 30;
  for var i: i32 = 0; i < 32; i = i + 1 {
    let key = SetCollisionKey { value: i };
    if i == 5 || i == 17 {
      if s.has(key) {
        valid = false;
      }
    } else {
      if !s.has(key) {
        valid = false;
      }
    }
  }

  let entries = s.entries();
  if entries.length() != 30 {
    valid = false;
  }
  for let entry in entries {
    if entry.value == 5 || entry.value == 17 {
      valid = false;
    }
  }
  check(valid, "set/collision-remove-keeps-dense-chains");
}

/** Verifies managed keys remain valid across growth, removal, and shrink. */
func set_shrink_preserves_managed_keys() {
  let s = Set<SetManagedKey>();
  for var i: i32 = 0; i < 80; i = i + 1 {
    s.add(SetManagedKey { value: i });
  }
  for var i: i32 = 0; i < 76; i = i + 1 {
    s.remove(SetManagedKey { value: i });
  }

  var valid: bool = s.count() == 4;
  for var i: i32 = 76; i < 80; i = i + 1 {
    if !s.has(SetManagedKey { value: i }) {
      valid = false;
    }
  }

  let entries = s.entries();
  if entries.length() != 4 {
    valid = false;
  }
  for let entry in entries {
    if entry.value < 76 || entry.value >= 80 {
      valid = false;
    }
  }
  check(valid, "set/shrink-preserves-managed-keys");
}

/** Verifies entries returns an immutable snapshot independent of later removal. */
func set_entries_snapshot_survives_remove() {
  let s = Set<SetManagedKey>();
  s.add(SetManagedKey { value: 1 });
  s.add(SetManagedKey { value: 2 });
  s.add(SetManagedKey { value: 3 });
  let snapshot = s.entries();

  s.remove(SetManagedKey { value: 2 });
  var snapshotSum: i32 = 0;
  for let entry in snapshot {
    snapshotSum = snapshotSum + entry.value;
  }
  check(snapshot.length() == 3, "set/entries-snapshot-length");
  check(snapshotSum == 6, "set/entries-snapshot-values");
  check(s.count() == 2, "set/entries-live-count-after-remove");
  check(!s.has(SetManagedKey { value: 2 }), "set/entries-live-remove");
}

open func run_set_tests() {
  describe("set tests", () {
    test("set_add_has()", () { set_add_has(); });
    test("set_has_false()", () { set_has_false(); });
    test("set_add_duplicate()", () { set_add_duplicate(); });
    test("set_remove()", () { set_remove(); });
    test("set_remove_absent()", () { set_remove_absent(); });
    test("set_multiple_elements()", () { set_multiple_elements(); });
    test("set_count()", () { set_count(); });
    test("set_entities_two()", () { set_entities_two(); });
    test("set_int_direct_call()", () { set_int_direct_call(); });
    test("set_collision_remove_keeps_dense_chains()", () {
      set_collision_remove_keeps_dense_chains();
    });
    test("set_shrink_preserves_managed_keys()", () {
      set_shrink_preserves_managed_keys();
    });
    test("set_entries_snapshot_survives_remove()", () {
      set_entries_snapshot_survives_remove();
    });
  });
}
