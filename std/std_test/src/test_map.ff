module std_test;

import std.test;

import std.collections;

/** A map test key that forces every entry into the same bucket chain. */
type MapCollisionKey: Hashable<MapCollisionKey> {
  let value: i32;

  /** Returns a constant hash to exercise collision-chain maintenance. */
  func hash(): u64 {
    return (u64)1;
  }

  /** Compares collision keys by their stored integer value. */
  func same(other: MapCollisionKey): bool {
    return self.value == other.value;
  }
}

func map_set_get() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 10 };
  m.set(k, 100);
  let v: i32 = m.get(k);
  check(v == 100, "map/set-get");
}

func map_get_missing_default() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 99 };
  let v: i32 = m.get(k);
  check(v == 0, "map/get-missing-default");
}

func map_has_true() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 5 };
  m.set(k, 5);
  check(m.has(k), "map/has-true");
}

func map_has_false() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 7 };
  check(!m.has(k), "map/has-false");
}

func map_overwrite() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 3 };
  m.set(k, 1);
  m.set(k, 2);
  let v: i32 = m.get(k);
  check(v == 2, "map/overwrite");
}

func map_remove() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 8 };
  m.set(k, 8);
  m.remove(k);
  check(!m.has(k), "map/remove");
}

func map_remove_absent() {
  let m = Map<IntKey, i32>();
  let k = IntKey { value: 42 };
  m.remove(k);
  check(!m.has(k), "map/remove-absent");
}

func map_multiple_keys() {
  let m = Map<IntKey, i32>();
  for var i: i32 = 0; i < 20; i = i + 1 {
    let k = IntKey { value: i };
    m.set(k, i);
  }
  var allPresent: bool = true;
  for var i: i32 = 0; i < 20; i = i + 1 {
    let k = IntKey { value: i };
    if !m.has(k) {
      allPresent = false;
    }
  }
  check(allPresent, "map/multiple-keys");
  m.remove(IntKey { value: 5 });
  m.remove(IntKey { value: 15 });
  check(!m.has(IntKey { value: 5 }), "map/multiple-remove-1");
  check(!m.has(IntKey { value: 15 }), "map/multiple-remove-2");
  check(m.has(IntKey { value: 10 }), "map/multiple-survivor");
}

func map_count() {
  let m = Map<IntKey, i32>();
  check(m.count() == 0, "map/count-empty");
  m.set(IntKey { value: 1 }, 1);
  m.set(IntKey { value: 2 }, 2);
  m.set(IntKey { value: 3 }, 3);
  check(m.count() == 3, "map/count-after-set");
  m.remove(IntKey { value: 2 });
  check(m.count() == 2, "map/count-after-remove");
}

func map_entries_tuple_entity() {
  let m = Map<IntKey, i32>();
  m.set(IntKey { value: 11 }, 22);
  let ents = m.entries();
  var seen: i32 = 0;
  for let _ in ents {
    seen = seen + 1;
  }
  check(seen == 1, "map/entries-len");

  var found: bool = false;
  for let ent in ents {
    if ent.item1.value == 11 && ent.item2 == 22 {
      found = true;
    }
  }
  check(found, "map/entries-item");
}

/** Verifies collision chains after removals move the last dense entry. */
func map_collision_remove_keeps_dense_chains() {
  let m = Map<MapCollisionKey, i32>();
  for var i: i32 = 0; i < 32; i = i + 1 {
    m.set(MapCollisionKey { value: i }, i * 10);
  }

  m.remove(MapCollisionKey { value: 5 });
  m.remove(MapCollisionKey { value: 17 });
  var valid: bool = m.count() == 30;
  for var i: i32 = 0; i < 32; i = i + 1 {
    let key = MapCollisionKey { value: i };
    if i == 5 || i == 17 {
      if m.has(key) {
        valid = false;
      }
    } else {
      if !m.has(key) || m.get(key) != i * 10 {
        valid = false;
      }
    }
  }
  check(valid, "map/collision-remove-keeps-dense-chains");
}

/** Verifies managed values remain valid across growth, removal, and shrink. */
func map_shrink_preserves_managed_values() {
  let m = Map<IntKey, string>();
  for var i: i32 = 0; i < 80; i = i + 1 {
    m.set(IntKey { value: i }, "retained");
  }
  for var i: i32 = 0; i < 76; i = i + 1 {
    m.remove(IntKey { value: i });
  }

  var valid: bool = m.count() == 4;
  for var i: i32 = 76; i < 80; i = i + 1 {
    let key = IntKey { value: i };
    if !m.has(key) || m.get(key) != "retained" {
      valid = false;
    }
  }
  check(valid, "map/shrink-preserves-managed-values");
}

open func run_map_tests() {
  describe("map tests", () {
    test("map_set_get()", () { map_set_get(); });
    test("map_get_missing_default()", () { map_get_missing_default(); });
    test("map_has_true()", () { map_has_true(); });
    test("map_has_false()", () { map_has_false(); });
    test("map_overwrite()", () { map_overwrite(); });
    test("map_remove()", () { map_remove(); });
    test("map_remove_absent()", () { map_remove_absent(); });
    test("map_multiple_keys()", () { map_multiple_keys(); });
    test("map_count()", () { map_count(); });
    test("map_entries_tuple_entity()", () { map_entries_tuple_entity(); });
    test("map_collision_remove_keeps_dense_chains()", () {
      map_collision_remove_keeps_dense_chains();
    });
    test("map_shrink_preserves_managed_values()", () {
      map_shrink_preserves_managed_values();
    });
  });
}
