open module std.test;

import std;
import std.collections;
import std.io;
import std.text;
import std.numeric;

/**
 * Test kind
 */
enum TestKind {
  /**
   * A Describe block groups related test cases, typically containing multiple Test blocks
   */
  Describe = 0,

  /**
   * A Test block represents a single test case
   */
  Test = 1
}

/**
 * Test state
 */
type TestState {
  let name: string;
  let kind: TestKind;
  var state: bool;
  let output: Option<List<string>>;
}

/**
 * Test context
 */
type TestContext {

  var total: int;
  var passed: int;
  var failed: int;
  var skipped: int;

  seal let errors: List<string>;

  /**
   * Test execution stack
   * The last element is the currently executing test case
   */
  seal let stack: List<TestState>;

  /**
   * Return whether no test suite or case is currently active.
   */
  func isTopLevel(): bool {
    return self.stack.size() == 0;
  }

  func current(): TestState {
    return self.stack.get(self.stack.size() - 1);
  }

  func push(name: string, kind: TestKind) {
    if (kind == TestKind.Describe) {
      self.stack.add(TestState {
          name: name,
          kind: kind,
          state: true,
          output: none
      });
    } else {
      self.stack.add(TestState {
          name: name,
          kind: kind,
          state: true,
          output: List<string>()
      });
    }
  }

  func pop() {
    self.stack.remove(self.stack.size() - 1);
  }

  func markFailed() {
    for let state in self.stack {
      if !state.state { continue; }
      state.state = false;
    }
  }

  /**
   * Reset the test context
   */
  func reset() {
    self.total = 0;
    self.passed = 0;
    self.failed = 0;
    self.stack.clear();
    self.errors.clear();
  }

  /**
   * Get the current indentation string
   */
  func indent(): string {
    // 根节点不缩进
    let depth = self.stack.size() - 1;
    if (depth <= 0) { return ""; }
    return " ".repeat(depth * 2);
  }

  func hasError(): bool {
    return self.errors.size() > 0;
  }

  func addError(error: string) {
    self.errors.add(error);
  }

  func toErrorString(): string {
    return string.join("\n", self.errors.entries());
  }

  func getParentOutput(): Option<List<string>> {
    if self.stack.size() == 0 { return none; }
    // 从后往前找到第一个 Test 块，用 feng 的写法
    // 减 2 是因为不算自已
    for var i = self.stack.size() - 2; i >= 0; i -= 1 {
      let state = self.stack.get(i);
      if state.kind == TestKind.Test {
        return state.output;
      }
    }
    return none;
  }

  func println(format: string, args: string...) {
    let parentOutput = self.getParentOutput();
    let line = string.format(format, args);
    match parentOutput {
      p: List<string> {
        p.add(line);
      } else {
        // 没有 Test 块，直接输出到控制台
        println(line);
      }
    }
  }

  // func println(format: string, args: string...) {
  //   self.println(format, args);
  // }

  func flushOutput() {
    let current = self.current();
    if (current.kind != TestKind.Test) { return; }
    let selfOutput = current.output;
    match selfOutput {
      output: List<string> {
        let parentOutput = self.getParentOutput();
        match parentOutput {
          p: List<string> {
            for var i = 0; i < output.size(); i += 1 {
              p.add(output.get(i));
            }
          } else {
            for var i = 0; i < output.size(); i += 1 {
              println(output.get(i));
            }
          }
        }
        output.clear();
      } else {
        // do nothing
      }
    }
  }

}
