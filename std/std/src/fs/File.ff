open module std.fs;

import std.collections;
import std.text;

// libc file operations
@cdecl("libc", "open", 2)
extern func c_open(path: byte*, flags: i32, mode: i32): i32;

@cdecl("libc", "close")
extern func c_close(fd: i32): i32;

@cdecl("libc", "read")
extern func c_read(fd: int, buf: byte*, count: uint): int;

@cdecl("libc", "write")
extern func c_write(fd: int, buf: byte*, count: uint): int;

@cdecl("libc", "access")
extern func c_access(path: byte*, mode: i32): i32;

@cdecl("libc", "unlink")
extern func c_unlink(path: byte*): i32;

@cdecl("libc", "rename")
extern func c_rename(from: byte*, to: byte*): i32;

@cdecl("libc", "fstat")
extern func fs_posix_fstat(fd: int, buf: i64*): i32;

// Default file creation permission: 0644 = 420
seal let DEFAULT_FILE_MODE: int = 420;

/**
 * File I/O object, wrapping a file descriptor with read/write operations.
 * Bytes-first: read and write operate directly on byte buffers or byte[] data.
 */
open type File {
  seal var fd: int;
  seal var closed: bool;

  /**
   * Open or create a file and return a File instance.
   * @param path - File path
   * @param mode - File open mode
   */
  open static func create(path: string, mode: FileMode): File {
    let pathBytes = makeNullTerminatedPath(path);
    let flags = fileModeToPosixFlags(mode);
    let fd = (int)c_open(&pathBytes, flags, (i32)DEFAULT_FILE_MODE);
    if fd < 0 {
      throw "fs/open-failed";
    }
    return File { fd: fd, closed: false };
  }

  /**
   * Read up to buffer.length() bytes from the file.
   * @param buffer - Writable byte buffer provided by the caller
   * @return Number of bytes actually read; 0 on EOF
   */
  open func read(buffer: byte[!]): int {
    self.ensureOpen();
    let capacity = buffer.length();
    if capacity == (int)0 {
      return (int)0;
    }
    let result = c_read(self.fd, &buffer, (uint)capacity);
    if result < (int)0 {
      throw "fs/read-failed";
    }
    return result;
  }

  /**
   * Write bytes to the file.
   * @param bytes - Output byte sequence
   * @return Number of bytes actually written
   */
  open func write(bytes: byte[]): int {
    self.ensureOpen();
    let length = bytes.length();
    if length == (int)0 {
      return (int)0;
    }
    let result = c_write(self.fd, &bytes, (uint)length);
    if result < (int)0 {
      throw "fs/write-failed";
    }
    return result;
  }

  /**
   * Write the UTF-8 bytes of text to the file.
   * Semantically equivalent to passing the UTF-8 byte representation of text to write.
   * @param text - Text to write
   * @return Number of bytes actually written
   */
  open func writeText(text: string): int {
    return self.write(feng_string_to_utf8_bytes(text));
  }

  /**
   * Read all remaining bytes from the current offset and decode as a UTF-8 string.
   * @return UTF-8 string of the remaining file contents
   */
  open func readText(): string {
    let bytes = readAllBytes(self);
    return string.fromUtf8Bytes(bytes);
  }

  /**
   * Read all remaining content from the current offset and split by line.
   * Line terminators are not included in the returned content; CRLF is supported.
   * @return Array of lines as strings
   */
  open func readLines(): string[] {
    let text = self.readText();
    if text.length() == (int)0 {
      return string[: (int)0];
    }
    let textBytes = feng_string_to_utf8_bytes(text);
    let lines = List<string>();
    let lineBytes = List<byte>();
    let len = textBytes.length();
    for var i: int = (int)0; i < len; i += (int)1 {
      let b = textBytes[i];
      if b == (byte)10 {
        lines.add(string.fromUtf8Bytes(lineBytes.entries()));
        lineBytes.clear();
      } else {
        if b != (byte)13 {
          lineBytes.add(b);
        }
      }
    }
    // 最后一行（无尾部换行时保留）
    if (int)lineBytes.size() > (int)0 {
      lines.add(string.fromUtf8Bytes(lineBytes.entries()));
    }
    // 如果文本以 \n 结尾，split 会产生尾部空串，需要移除
    if len > (int)0 && textBytes[len - (int)1] == (byte)10 {
      if (int)lines.size() > (int)0 {
        let last = lines.get(lines.size() - 1);
        if last.length() == (int)0 {
          lines.removeAt(lines.size() - 1);
        }
      }
    }
    return lines.entries();
  }

  /**
   * Close the file and release the underlying file descriptor. Idempotent.
   */
  open func close(): void {
    if self.closed {
      return;
    }
    self.closed = true;
    try c_close((i32)self.fd) catch {
      // 幂等：忽略 close 异常
    };
  }

  /**
   * Return whether the file is closed.
   */
  open func isClosed(): bool {
    return self.closed;
  }

  /**
   * Get the metadata of the current file.
   * @return StatInfo of the file
   */
  open func stat(): StatInfo {
    self.ensureOpen();
    ensurePosixLayout();
    let statBuf: i64[!] = i64[:STAT_BUFFER_WORD_COUNT];
    let rc = fs_posix_fstat(self.fd, &statBuf);
    if rc != (i32)0 {
      throw "fs/stat-failed";
    }
    return readStatInfo(statBuf);
  }

  /**
   * Internal: check whether the file is open; throws if already closed.
   */
  seal func ensureOpen() {
    if self.closed {
      throw "fs/file-closed";
    }
  }
}

// ---- 顶层便捷函数 ----

/**
 * Read all remaining bytes through the public File stream API.
 */
seal func readAllBytes(file: File): byte[] {
  let allBytes = List<byte>();
  let chunk: byte[!] = byte[:(int)4096];
  while true {
    let count = file.read(chunk);
    if count == (int)0 {
      break;
    }
    for var i: int = (int)0; i < count; i += (int)1 {
      allBytes.add(chunk[i]);
    }
  }
  return allBytes.entries();
}

/**
 * Write all bytes through the public File stream API.
 */
seal func writeAllBytes(file: File, bytes: byte[]): void {
  let written = file.write(bytes);
  if written != bytes.length() {
    throw "fs/write-failed";
  }
}

/**
 * Read the entire file as a UTF-8 string.
 * Manages file open/close automatically; the file is always closed even if an exception is thrown.
 * @param path - File path
 * @return Full file contents
 */
open func readText(path: string): string {
  let file = File.create(path, FileMode.Read);
  let result = try file.readText() catch ex: string {
    file.close();
    throw ex;
  };
  file.close();
  return result;
}

/**
 * Write text to a file as UTF-8; creates the file if it doesn't exist, truncates if it does.
 * Manages file open/close automatically.
 * @param path - File path
 * @param text - Text to write
 */
open func writeText(path: string, text: string): void {
  let file = File.create(path, FileMode.WriteTrunc);
  try file.writeText(text) catch ex: string {
    file.close();
    throw ex;
  };
  file.close();
}

/**
 * Read the entire file as a byte array.
 * Manages file open/close automatically.
 * @param path - File path
 * @return Full file bytes
 */
open func readBytes(path: string): byte[] {
  let file = File.create(path, FileMode.Read);
  let result = try readAllBytes(file) catch ex: string {
    file.close();
    throw ex;
  };
  file.close();
  return result;
}

/**
 * Write a byte array to a file; creates the file if it doesn't exist, truncates if it does.
 * Manages file open/close automatically.
 * @param path - File path
 * @param bytes - Bytes to write
 */
open func writeBytes(path: string, bytes: byte[]): void {
  let file = File.create(path, FileMode.WriteTrunc);
  try writeAllBytes(file, bytes) catch ex: string {
    file.close();
    throw ex;
  };
  file.close();
}

/**
 * Check whether the path exists (file or directory), following symlinks.
 * Never throws.
 * @param path - Path
 * @return Whether the path exists
 */
open func exists(path: string): bool {
  let pathBytes = makeNullTerminatedPath(path);
  let rc = c_access(&pathBytes, (i32)0);
  return rc == (i32)0;
}

/**
 * Check whether the path is a regular file, following symlinks.
 * Never throws.
 * @param path - Path
 * @return Whether the path is a regular file
 */
open func isFile(path: string): bool {
  ensurePosixLayout();
  let pathBytes = makeNullTerminatedPath(path);
  let statBuf: i64[!] = i64[:STAT_BUFFER_WORD_COUNT];
  let rc = posix_stat(&pathBytes, &statBuf);
  if rc != (i32)0 {
    return false;
  }
  let info = readStatInfo(statBuf);
  return info.kind == EntryKind.File;
}

/**
 * Check whether the path is a directory, following symlinks.
 * Never throws.
 * @param path - Path
 * @return Whether the path is a directory
 */
open func isDir(path: string): bool {
  ensurePosixLayout();
  let pathBytes = makeNullTerminatedPath(path);
  let statBuf: i64[!] = i64[:STAT_BUFFER_WORD_COUNT];
  let rc = posix_stat(&pathBytes, &statBuf);
  if rc != (i32)0 {
    return false;
  }
  let info = readStatInfo(statBuf);
  return info.kind == EntryKind.Dir;
}

/**
 * Get the full metadata of the path (following symlinks); throws if the path is invalid or inaccessible.
 * @param path - Path
 * @return StatInfo
 */
open func stat(path: string): StatInfo {
  ensurePosixLayout();
  let pathBytes = makeNullTerminatedPath(path);
  let statBuf: i64[!] = i64[:STAT_BUFFER_WORD_COUNT];
  let rc = posix_stat(&pathBytes, &statBuf);
  if rc != (i32)0 {
    throw "fs/stat-failed";
  }
  return readStatInfo(statBuf);
}

/**
 * Remove a file or symlink; directories must not be removed via this function. Throws if the path is invalid.
 * @param path - File or symlink path
 */
open func remove(path: string): void {
  let pathBytes = makeNullTerminatedPath(path);
  let rc = c_unlink(&pathBytes);
  if rc != (i32)0 {
    throw "fs/remove-failed";
  }
}

/**
 * Rename or move a file/directory. Throws if the source path is invalid.
 * @param from - Source path
 * @param to - Destination path
 */
open func rename(from: string, to: string): void {
  let fromBytes = makeNullTerminatedPath(from);
  let toBytes = makeNullTerminatedPath(to);
  let rc = c_rename(&fromBytes, &toBytes);
  if rc != (i32)0 {
    throw "fs/rename-failed";
  }
}
