open module std.tui.input;

import std;

/**
 * SpecialKey 表示终端能可靠识别的特殊按键。
 *
 * 可打印字符不在此枚举中，通过 `Union<SpecialKey, u32>` 的 `u32` 分支传递码点。
 * 特殊键和可打印字符互斥——一个按键事件要么是特殊键，要么是可打印字符。
 */
open enum SpecialKey {
  /** Esc 键（0x1B） */
  Escape = 1,
  /** Tab 键（0x09） */
  Tab = 2,
  /** Enter / Return 键（0x0D） */
  Enter = 3,
  /** Backspace 退格键（0x08 或 0x7F） */
  Backspace = 4,
  /** Insert 插入键（CSI ~ 2） */
  Insert = 5,
  /** Delete 删除键（CSI ~ 3） */
  Delete = 6,
  /** Home 键（CSI H 或 ~ 1） */
  Home = 7,
  /** End 键（CSI F 或 ~ 4） */
  End = 8,
  /** PageUp 上翻页键（CSI ~ 5） */
  PageUp = 9,
  /** PageDown 下翻页键（CSI ~ 6） */
  PageDown = 10,
  /** 方向键 ↑（CSI A） */
  ArrowUp = 11,
  /** 方向键 ↓（CSI B） */
  ArrowDown = 12,
  /** 方向键 ←（CSI D） */
  ArrowLeft = 13,
  /** 方向键 →（CSI C） */
  ArrowRight = 14,
  /** F1 功能键（SS3 P 或 CSI P） */
  F1 = 15,
  /** F2 功能键（SS3 Q 或 CSI Q） */
  F2 = 16,
  /** F3 功能键（SS3 R 或 CSI R） */
  F3 = 17,
  /** F4 功能键（SS3 S 或 CSI S） */
  F4 = 18,
  /** F5 功能键（CSI ~ 15） */
  F5 = 19,
  /** F6 功能键（CSI ~ 17） */
  F6 = 20,
  /** F7 功能键（CSI ~ 18） */
  F7 = 21,
  /** F8 功能键（CSI ~ 19） */
  F8 = 22,
  /** F9 功能键（CSI ~ 20） */
  F9 = 23,
  /** F10 功能键（CSI ~ 21） */
  F10 = 24,
  /** F11 功能键（CSI ~ 23） */
  F11 = 25,
  /** F12 功能键（CSI ~ 24） */
  F12 = 26
}

// ─── 修饰键常量 ───────────────────────────────────────────────────────────

/**
 * Control 修饰键标志位。
 *
 * KeyEvent：仅在纯控制字符（0x01–0x07,0x0B–0x0C,0x0E–0x1A,0x1C–0x1F）时设置，
 * 100% 可靠。与特殊键冲突的控制字节（0x08=BS,0x09=HT,0x0D=CR,0x1B=ESC）
 * 优先映射为特殊键，不设 MOD_CONTROL。
 *
 * MouseEvent：来自 SGR 鼠标序列 button 高位（+16），100% 可靠。
 */
open let MOD_CONTROL: u8 = 1;

/**
 * Alt 修饰键标志位。
 *
 * KeyEvent 不设置——ESC 前缀无法 100% 消歧（Alt+A = ESC+a，与单独 Esc 后跟 a
 * 无法区分）。按严格标准，InputManager 不检测 Alt。
 *
 * MouseEvent：来自 SGR 鼠标序列 button 高位（+8），100% 可靠。
 */
open let MOD_ALT: u8 = 2;

/**
 * Shift 修饰键标志位。
 *
 * KeyEvent：仅在 CSI 特殊键修饰后缀（如 ESC[1;2A 的 ;2）时设置，100% 可靠。
 * 可打印字符的大写形式不设置 MOD_SHIFT（可能是 CapsLock，无法区分）。
 *
 * MouseEvent：来自 SGR 鼠标序列 button 高位（+4），100% 可靠。
 */
open let MOD_SHIFT: u8 = 4;

/**
 * KeyEvent 表示一个带路由目标类型的键盘事件。
 *
 * 普通引用类型，content/mods 构造后不可变。target 在 InputManager 完成解析时尚未绑定，
 * 由 ViewManager 在进入 Widget 回调前绑定。同一事件实例在 Widget 树中逐级传播，
 * target 保持不变，stop()/isStopped() 维护共享的停止状态，
 * preventDefault()/isPrevented() 维护独立的默认行为阻止状态。
 *
 * 按键内容通过 `Union<SpecialKey, u32>` 互斥表达：
 * - `SpecialKey` 分支：特殊键（方向键、功能键、Enter 等）
 * - `u32` 分支：可打印字符的 Unicode 码点
 *
 * 修饰键用 `u8` 位标志表示，快捷方法仅在 100% 能确定时返回 true。
 */
open type KeyEvent<T> {

  /** 路由目标；仅在 hasTarget() 返回 true 时有效。 */
  var target: T;

  /** target 是否已经由路由器绑定。 */
  seal var _hasTarget: bool;

  /** 是否已停止后续视图传播；仅由 stop() 修改。 */
  seal var stopped: bool;

  /** 是否已阻止 ViewManager 的键盘默认行为；仅由 preventDefault() 修改。 */
  seal var prevented: bool;

  /**
   * 按键内容：SpecialKey=特殊键，u32=可打印字符码点。
   * 两者通过 Union<u32, SpecialKey> 互斥。
   */
  let content: Union<u32, SpecialKey>;

  /**
   * 修饰键位标志（MOD_CONTROL / MOD_SHIFT 的按位或）。
   * KeyEvent 仅含可靠推断的修饰键，不设 MOD_ALT。
   */
  let mods: u8;

  /**
   * 默认构造函数：content=u32(0), mods=0。
   */
  func KeyEvent() {
    self._hasTarget = false;
    self.stopped = false;
    self.prevented = false;
    self.content = (u32)0;
    self.mods = 0;
  }

  /**
   * 构造函数：指定按键内容和修饰键。
   * @param content - u32 码点或 SpecialKey 枚举值
   * @param mods - 修饰键位标志的按位或
   */
  func KeyEvent(content: Union<u32, SpecialKey>, mods: u8) {
    self._hasTarget = false;
    self.stopped = false;
    self.prevented = false;
    self.content = content;
    self.mods = mods;
  }

  // ─── 快捷判定方法 ─────────────────────────────────────────────────────

  /**
   * 是否按住 Ctrl（100% 可靠）。
   *
   * 仅在纯控制字符（0x01–0x07,0x0B–0x0C,0x0E–0x1A,0x1C–0x1F）时返回 true。
   * 与特殊键冲突的控制字节（0x08=BS,0x09=HT,0x0D=CR,0x1B=ESC）
   * 优先映射为特殊键，返回 false。
   * @return 是否按住 Ctrl
   */
  func isControl(): bool {
    return (self.mods & MOD_CONTROL) != 0;
  }

  /**
   * 是否按住 Shift（100% 可靠）。
   *
   * 仅在 CSI 特殊键修饰后缀（如 ESC[1;2A 的 ;2）时返回 true。
   * 可打印字符的大写形式不设置 MOD_SHIFT（可能是 CapsLock，无法区分）。
   * @return 是否按住 Shift
   */
  func isShift(): bool {
    return (self.mods & MOD_SHIFT) != 0;
  }

  /**
   * 是否为可打印字符。
   *
   * content 为 u32 分支且码点不为 0 时返回 true。
   * @return 是否为可打印字符
   */
  func isPrintable(): bool {
    return match self.content {
      c: u32 { c != (u32)0; }
      else { false; }
    };
  }

  /**
   * 绑定事件路由目标。
   * 当前由后续焦点路由器使用；InputManager 本身不绑定目标。
   * @param target 路由选中的目标
   */
  func bindTarget(target: T): void {
    self.target = target;
    self._hasTarget = true;
  }

  /**
   * 查询 target 是否已经由路由器绑定。
   * @return target 是否有效
   */
  func hasTarget(): bool {
    return self._hasTarget;
  }

  /**
   * 停止当前 Widget 回调完成后的后续视图传播。
   * 重复调用保持停止状态，不中断当前 Event 中的其他监听器。
   */
  func stop(): void {
    self.stopped = true;
  }

  /**
   * 查询事件是否已停止后续视图传播。
   * @return stop() 是否已经被调用
   */
  func isStopped(): bool {
    return self.stopped;
  }

  /**
   * 阻止 ViewManager 在键盘事件路由后的默认行为。
   * 不停止传播，也不中断当前 Event 中的其他监听器。
   */
  func preventDefault(): void {
    self.prevented = true;
  }

  /**
   * 查询是否已阻止 ViewManager 的键盘默认行为。
   * @return preventDefault() 是否已经被调用
   */
  func isPrevented(): bool {
    return self.prevented;
  }
}
