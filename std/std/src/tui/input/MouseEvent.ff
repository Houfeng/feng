open module std.tui.input;

import std;

/**
 * MouseAction 表示鼠标动作类型。
 */
open enum MouseAction {
  /** 按下按钮 */
  Press = 0,
  /** 释放按钮 */
  Release = 1,
  /** 移动（含拖动和悬停） */
  Move = 2
}

/**
 * MouseButton 表示鼠标按钮类型。
 */
open enum MouseButton {
  /** 无按钮（悬停移动时使用） */
  None = 0,
  /** 左键 */
  Left = 1,
  /** 中键（滚轮点击） */
  Middle = 2,
  /** 右键 */
  Right = 3,
  /** 滚轮向上滚动 */
  WheelUp = 4,
  /** 滚轮向下滚动 */
  WheelDown = 5
}

/**
 * MouseEvent 表示一个带路由目标类型的鼠标事件。
 *
 * 普通引用类型，输入载荷字段均为 `let`，构造后不可变。
 * target 在 InputManager 完成解析时尚未绑定，由 ViewManager 在进入 Widget 回调前
 * 绑定为命中或锁定目标。同一事件实例在 Widget 树中逐级传播，target 保持不变，
 * stop()/isStopped() 维护共享的停止状态，preventDefault()/isPrevented()
 * 维护独立的默认行为阻止状态。
 *
 * 修饰键来自 SGR 鼠标序列（mode 1006）的 button 高位编码，
 * 由终端主动报告，100% 可靠——isControl/isAlt/isShift 均准确。
 *
 * 终端输入产生的坐标为 0-based；坐标使用 int，允许其他输入后端表达窗口外位置。
 * InputManager 解析时将终端 SGR 序列的 1-based 坐标减 1。
 */
open type MouseEvent<T> {

  /** 路由目标；仅在 hasTarget() 返回 true 时有效。 */
  var target: T;

  /** target 是否已经由路由器绑定。 */
  seal var _hasTarget: bool;

  /** 当前事件的 target 是否代表现有锁定目标。 */
  seal var _targetOwnsLock: bool;

  /** 鼠标动作类型 */
  let action: MouseAction;

  /** 按下的按钮（move 动作时为 none） */
  let button: MouseButton;

  /** 列坐标；终端输入为 0-based，其他输入后端可提供窗口外坐标 */
  let x: int;

  /** 行坐标；终端输入为 0-based，其他输入后端可提供窗口外坐标 */
  let y: int;

  /** 修饰键位标志（MOD_CONTROL / MOD_ALT / MOD_SHIFT 的按位或，100% 可靠） */
  let mods: u8;

  /** 是否已停止后续传播；仅由 stop() 修改 */
  seal var stopped: bool;

  /** 是否已阻止 ViewManager 的默认行为；仅由 preventDefault() 修改。 */
  seal var prevented: bool;

  /** 当前闭合 MouseEvent<T> 是否存在锁定目标。 */
  seal static var _locked: bool;

  /** 当前闭合 MouseEvent<T> 的锁定目标。 */
  seal static var _lockedTarget: T;

  /** 用于释放锁定目标引用的默认 T。 */
  seal static let _emptyTarget: T;

  /**
   * 默认构造函数：action=press, button=none, x=0, y=0, mods=0。
   */
  func MouseEvent() {
    self._hasTarget = false;
    self._targetOwnsLock = false;
    self.action = MouseAction.Press;
    self.button = MouseButton.None;
    self.x = 0;
    self.y = 0;
    self.mods = 0;
    self.stopped = false;
    self.prevented = false;
  }

  /**
   * 构造函数：指定所有字段。
   * @param action - 鼠标动作类型
   * @param button - 按下的按钮
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param mods - 修饰键位标志的按位或
   */
  func MouseEvent(action: MouseAction, button: MouseButton, x: int, y: int, mods: u8) {
    self._hasTarget = false;
    self._targetOwnsLock = false;
    self.action = action;
    self.button = button;
    self.x = x;
    self.y = y;
    self.mods = mods;
    self.stopped = false;
    self.prevented = false;
  }

  // ─── 快捷判定方法（均 100% 可靠，来自 SGR button 高位） ───────────────

  /**
   * 是否按住 Ctrl（100% 可靠，来自 SGR button 高位 +16）。
   * @return 是否按住 Ctrl
   */
  func isControl(): bool {
    return (self.mods & MOD_CONTROL) != 0;
  }

  /**
   * 是否按住 Alt（100% 可靠，来自 SGR button 高位 +8）。
   * @return 是否按住 Alt
   */
  func isAlt(): bool {
    return (self.mods & MOD_ALT) != 0;
  }

  /**
   * 是否按住 Shift（100% 可靠，来自 SGR button 高位 +4）。
   * @return 是否按住 Shift
   */
  func isShift(): bool {
    return (self.mods & MOD_SHIFT) != 0;
  }

  /**
   * 绑定事件路由目标。
   * InputManager 只解析输入，ViewManager 在进入 Widget 回调前调用该方法。
   * @param target 路由选中的目标
   */
  func bindTarget(target: T): void {
    self.target = target;
    self._hasTarget = true;
    self._targetOwnsLock = false;
  }

  /**
   * 绑定静态锁定目标，并标记当前事件可以代表该目标继续 lock 或 unlock。
   * @param target 当前闭合 MouseEvent<T> 保存的锁定目标
   */
  func bindLockedTarget(target: T): void {
    self.target = target;
    self._hasTarget = true;
    self._targetOwnsLock = true;
  }

  /**
   * 查询 target 是否已经由路由器绑定。
   * @return target 是否有效
   */
  func hasTarget(): bool {
    return self._hasTarget;
  }

  /**
   * 停止当前回调完成后的后续事件传播。
   * 重复调用保持停止状态，不中断当前回调。
   */
  func stop(): void {
    self.stopped = true;
  }

  /**
   * 查询事件是否已停止后续传播。
   * @return stop() 是否已经被调用
   */
  func isStopped(): bool {
    return self.stopped;
  }

  /**
   * 阻止 ViewManager 在事件路由后的默认行为。
   * 不停止传播，也不中断当前 Event 中的其他监听器。
   */
  func preventDefault(): void {
    self.prevented = true;
  }

  /**
   * 查询是否已阻止 ViewManager 的默认行为。
   * @return preventDefault() 是否已经被调用
   */
  func isPrevented(): bool {
    return self.prevented;
  }

  /**
   * 请求由当前路由目标锁定后续鼠标事件。
   * 未绑定 target 时失败；首个目标取得锁定，同一目标可重复锁定，其他目标不能抢占。
   * @return 当前目标是否拥有锁定
   */
  func lock(): bool {
    if !self._hasTarget {
      return false;
    }
    if MouseEvent<T>._locked {
      return self._targetOwnsLock;
    }
    MouseEvent<T>._lockedTarget = self.target;
    MouseEvent<T>._locked = true;
    self._targetOwnsLock = true;
    return true;
  }

  /**
   * 释放当前目标拥有的锁定。
   * 未绑定 target 或锁定属于其他目标时静默不处理。
   */
  func unlock(): void {
    if self._hasTarget && self._targetOwnsLock && MouseEvent<T>._locked {
      MouseEvent<T>._lockedTarget = MouseEvent<T>._emptyTarget;
      MouseEvent<T>._locked = false;
      self._targetOwnsLock = false;
    }
  }

  /**
   * 查询当前闭合 MouseEvent<T> 是否存在锁定目标。
   * @return 是否已有目标锁定鼠标事件
   */
  func isLocked(): bool {
    return MouseEvent<T>._locked;
  }

  /**
   * 查询当前闭合 MouseEvent<T> 是否存在锁定目标。
   * @return 是否存在锁定目标
   */
  static func hasLockedTarget(): bool {
    return MouseEvent<T>._locked;
  }

  /**
   * 获取当前闭合 MouseEvent<T> 的锁定目标，供事件路由器选择分发起点。
   * 调用前必须先确认 hasLockedTarget() 为 true。
   * @return 锁定目标
   */
  static func lockedTarget(): T {
    return MouseEvent<T>._lockedTarget;
  }
}
