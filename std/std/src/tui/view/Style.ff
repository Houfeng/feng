open module std.tui.view;

import std;
import std.collections;
import std.tui.common;
import std.tui.screen;
import std.tui.input;

/**
 * WidgetPosition 组件定位方式
 */
open enum Position {
  /** 普通布局，由父组件控制 */
  Normal,
  /** 与 Normal 使用相同布局，但可作为 Absolute 后代的定位参照 */
  Relative,
  /** 绝对布局，相对于最近的非 Normal 祖先定位 */
  Absolute,
  /** 固定布局，相对于屏幕定位 */
  Fixed
}

/**
 * WidgetAlign 组件对齐方式
 */
open enum Align {
  /** 填充整个可用空间 */
  Full,
  /** 靠开始位置对齐 */
  Start,
  /** 居中对齐 */
  Center,
  /** 靠结束位置对齐 */
  End
}

/**
 * WidgetOverflow 组件溢出处理方式
 * 无 Scroll 定义，因为 ScrollView 组件实现（ScrollView 自身是 Hidden）
 */
open enum Overflow {
  Visible,
  Hidden
}

/**
 * Auto 表示由组件的内在内容决定最终尺寸。
 * 零元素具名 tuple 不携带运行时数据。
 */
open type Auto();

/** 自动尺寸值。 */
open let auto: Auto = ();

/**
 * StyleApplyResult 表示一次样式应用实际改变的字段类别。
 */
open enum StyleApplyResult {
  /** 没有字段发生变化。 */
  None,
  /** 只有布局字段发生变化。 */
  Layout,
  /** 只有绘制字段发生变化。 */
  Draw,
  /** 布局字段和绘制字段均发生变化。 */
  LayoutAndDraw
}

/** Style.clear() 复用的零间距，避免清理草稿样式时产生临时对象。 */
let zeroThickness = Thickness(0);

/**
 * WidgetStyle 组件布局与样式约束
 */
open type Style {
  /**
   * 组件布局类型。
   * Normal/Relative 使用直接父组件扣除 padding 后的 content 区域；
   * Absolute 使用最近的非 Normal 祖先 frame；Fixed 使用整个 Screen。
   * Relative 的自身布局与 Normal 相同，但可作为 Absolute 后代的定位参照。
   */
  var position: Position;

  /**
   * X 坐标，仅用于 Absolute/Fixed，Normal/Relative 布局时忽略。
   * int 表示固定终端单元数，double 表示相对参照区域宽度的百分比；
   * 两种形式均允许负值，使组件可位于参照区域左侧。
   * 百分比基数不扣除自身 margin。最终 frame.x 还会叠加 margin.left，
   * Absolute 的相对坐标不受定位参照祖先的 padding 影响。
   */
  var x: Union<int, double>;

  /**
   * Y 坐标，仅用于 Absolute/Fixed，Normal/Relative 布局时忽略。
   * int 表示固定终端单元数，double 表示相对参照区域高度的百分比；
   * 两种形式均允许负值，使组件可位于参照区域上方。
   * 百分比基数不扣除自身 margin。最终 frame.y 还会叠加 margin.top，
   * Absolute 的相对坐标不受定位参照祖先的 padding 影响。
   */
  var y: Union<int, double>;

  /**
   * 宽度，Auto 表示内在内容宽度，int 表示固定终端单元数，double 表示百分比；
   * 解析结果保持非负。
   * 固定宽度保持原值，不扣除 margin；百分比宽度以参照区域扣除
   * margin.left/right 后的剩余宽度为基数。Normal/Relative + horizontalAlign=Full
   * 时忽略 width，直接占满扣除左右 margin 后的可用宽度。
   */
  var width: Union<Auto, int, double>;

  /**
   * 高度，Auto 表示内在内容高度，int 表示固定终端单元数，double 表示百分比；
   * 解析结果保持非负。
   * 固定高度保持原值，不扣除 margin；百分比高度以参照区域扣除
   * margin.top/bottom 后的剩余高度为基数。Normal/Relative + verticalAlign=Full
   * 时忽略 height，直接占满扣除上下 margin 后的可用高度。
   */
  var height: Union<Auto, int, double>;

  /**
   * 前景色；不参与布局，在绘制阶段使用。alpha 为 0 时保留画布已有前景色。
   */
  var foreColor: Option<RgbColor>;

  /**
   * 背景色；不参与布局，在绘制阶段使用。alpha 为 0 时表示透明背景。
   */
  var backColor: Option<RgbColor>;

  /**
   * 填充间距，不改变组件自身 frame。
   * Normal/Relative 子组件以直接父组件 frame 扣除 padding 后的 content 区域为布局参照；
   * Absolute 子组件的相对坐标不受定位参照祖先的 padding 影响。
   */
  var padding: Thickness;

  /**
   * 外边距。起始侧 margin 叠加到最终 frame.x/frame.y；两侧 margin
   * 共同缩小 Full 和百分比尺寸的计算基数，但不改变固定 width/height。
   */
  var margin: Thickness;

  /**
   * 溢出处理方式；不参与 frame 计算，在绘制阶段决定是否裁剪。
   */
  var overflow: Overflow;

  /**
   * Normal/Relative 布局的水平对齐方式；Absolute/Fixed 时忽略。
   * Start/Center/End 在扣除左右 margin 后的可用区域内按最终解析宽度定位；
   * Full 忽略 width 并占满该可用区域。
   */
  var horizontalAlign: Align;

  /**
   * Normal/Relative 布局的垂直对齐方式；Absolute/Fixed 时忽略。
   * Start/Center/End 在扣除上下 margin 后的可用区域内按最终解析高度定位；
   * Full 忽略 height 并占满该可用区域。
   */
  var verticalAlign: Align;

  /**
   * 将当前实例恢复为 Style 的默认状态。
   */
  open func clear(): void {
    self.position = Position.Normal;
    self.x = 0;
    self.y = 0;
    self.width = auto;
    self.height = auto;
    self.foreColor = none;
    self.backColor = none;
    self.padding = zeroThickness;
    self.margin = zeroThickness;
    self.overflow = Overflow.Visible;
    self.horizontalAlign = Align.Full;
    self.verticalAlign = Align.Full;
  }

  /**
   * 应用完整样式，只写入实际变化的字段。
   * @param source - 要应用的完整样式
   * @return 本次应用实际改变的字段类别
   */
  open func apply(source: Style): StyleApplyResult {
    var result = StyleApplyResult.None;
    if self.position != source.position {
      self.position = source.position;
      result = Style.markLayout(result);
    }
    if !Style.lengthEquals(self.x, source.x) {
      self.x = source.x;
      result = Style.markLayout(result);
    }
    if !Style.lengthEquals(self.y, source.y) {
      self.y = source.y;
      result = Style.markLayout(result);
    }
    if !Style.sizeEquals(self.width, source.width) {
      self.width = source.width;
      result = Style.markLayout(result);
    }
    if !Style.sizeEquals(self.height, source.height) {
      self.height = source.height;
      result = Style.markLayout(result);
    }
    if !Style.colorEquals(self.foreColor, source.foreColor) {
      self.foreColor = source.foreColor;
      result = Style.markDraw(result);
    }
    if !Style.colorEquals(self.backColor, source.backColor) {
      self.backColor = source.backColor;
      result = Style.markDraw(result);
    }
    if !Style.thicknessEquals(self.padding, source.padding) {
      self.padding = source.padding;
      result = Style.markLayout(result);
    }
    if !Style.thicknessEquals(self.margin, source.margin) {
      self.margin = source.margin;
      result = Style.markLayout(result);
    }
    if self.overflow != source.overflow {
      self.overflow = source.overflow;
      result = Style.markDraw(result);
    }
    if self.horizontalAlign != source.horizontalAlign {
      self.horizontalAlign = source.horizontalAlign;
      result = Style.markLayout(result);
    }
    if self.verticalAlign != source.verticalAlign {
      self.verticalAlign = source.verticalAlign;
      result = Style.markLayout(result);
    }
    return result;
  }

  /**
   * 应用稀疏样式，只处理 Patch 中存在且实际变化的字段。
   * @param patch - 要应用的稀疏样式
   * @return 本次应用实际改变的字段类别
   */
  open func apply(patch: StylePatch): StyleApplyResult {
    var result = StyleApplyResult.None;
    if patch.position match value: Position {
      if self.position != value {
        self.position = value;
        result = Style.markLayout(result);
      }
    }
    if patch.x match value: Union<int, double> {
      if !Style.lengthEquals(self.x, value) {
        self.x = value;
        result = Style.markLayout(result);
      }
    }
    if patch.y match value: Union<int, double> {
      if !Style.lengthEquals(self.y, value) {
        self.y = value;
        result = Style.markLayout(result);
      }
    }
    if patch.width match value: Union<Auto, int, double> {
      if !Style.sizeEquals(self.width, value) {
        self.width = value;
        result = Style.markLayout(result);
      }
    }
    if patch.height match value: Union<Auto, int, double> {
      if !Style.sizeEquals(self.height, value) {
        self.height = value;
        result = Style.markLayout(result);
      }
    }
    if patch.foreColor match value: RgbColor {
      let color: Option<RgbColor> = value;
      if !Style.colorEquals(self.foreColor, color) {
        self.foreColor = value;
        result = Style.markDraw(result);
      }
    }
    if patch.backColor match value: RgbColor {
      let color: Option<RgbColor> = value;
      if !Style.colorEquals(self.backColor, color) {
        self.backColor = value;
        result = Style.markDraw(result);
      }
    }
    if patch.padding match value: Thickness {
      if !Style.thicknessEquals(self.padding, value) {
        self.padding = value;
        result = Style.markLayout(result);
      }
    }
    if patch.margin match value: Thickness {
      if !Style.thicknessEquals(self.margin, value) {
        self.margin = value;
        result = Style.markLayout(result);
      }
    }
    if patch.overflow match value: Overflow {
      if self.overflow != value {
        self.overflow = value;
        result = Style.markDraw(result);
      }
    }
    if patch.horizontalAlign match value: Align {
      if self.horizontalAlign != value {
        self.horizontalAlign = value;
        result = Style.markLayout(result);
      }
    }
    if patch.verticalAlign match value: Align {
      if self.verticalAlign != value {
        self.verticalAlign = value;
        result = Style.markLayout(result);
      }
    }
    return result;
  }

  /** 将本次结果标记为包含布局变化。 */
  seal static func markLayout(result: StyleApplyResult): StyleApplyResult {
    return match result {
      StyleApplyResult.Draw { StyleApplyResult.LayoutAndDraw }
      StyleApplyResult.LayoutAndDraw { StyleApplyResult.LayoutAndDraw }
      else { StyleApplyResult.Layout }
    };
  }

  /** 将本次结果标记为包含绘制变化。 */
  seal static func markDraw(result: StyleApplyResult): StyleApplyResult {
    return match result {
      StyleApplyResult.Layout { StyleApplyResult.LayoutAndDraw }
      StyleApplyResult.LayoutAndDraw { StyleApplyResult.LayoutAndDraw }
      else { StyleApplyResult.Draw }
    };
  }

  /** 比较 double 样式值，并将两个 NaN 视为相同的无效值。 */
  seal static func doubleEquals(left: double, right: double): bool {
    return left == right || (left != left && right != right);
  }

  /** 比较固定值或百分比长度。 */
  seal static func lengthEquals(left: Union<int, double>,
    right: Union<int, double>): bool {
    return match left {
      leftValue: int {
        if right match rightValue: int { leftValue == rightValue }
        else { false }
      }
      leftValue: double {
        if right match rightValue: double {
          Style.doubleEquals(leftValue, rightValue)
        } else { false }
      }
      else { false }
    };
  }

  /** 比较自动值、固定值或百分比尺寸。 */
  seal static func sizeEquals(left: Union<Auto, int, double>,
    right: Union<Auto, int, double>): bool {
    return match left {
      Auto { right match Auto }
      leftValue: int {
        if right match rightValue: int { leftValue == rightValue }
        else { false }
      }
      leftValue: double {
        if right match rightValue: double {
          Style.doubleEquals(leftValue, rightValue)
        } else { false }
      }
      else { false }
    };
  }

  /** 比较两个可选颜色的 RGBA 分量。 */
  seal static func colorEquals(left: Option<RgbColor>,
    right: Option<RgbColor>): bool {
    return match left {
      None { right match None }
      leftValue: RgbColor {
        if right match rightValue: RgbColor {
          leftValue.r == rightValue.r &&
          leftValue.g == rightValue.g &&
          leftValue.b == rightValue.b &&
          leftValue.a == rightValue.a
        } else { false }
      }
      else { false }
    };
  }

  /** 比较两个间距对象的四边值。 */
  seal static func thicknessEquals(left: Thickness, right: Thickness): bool {
    return Style.lengthEquals(left.top, right.top) &&
      Style.lengthEquals(left.right, right.right) &&
      Style.lengthEquals(left.bottom, right.bottom) &&
      Style.lengthEquals(left.left, right.left);
  }
}
