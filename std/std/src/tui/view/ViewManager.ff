open module std.tui.view;

import std;
import std.collections;
import std.tui.common;
import std.tui.input;
import std.tui.screen;

/**
 * ViewManager 是一个管理所有 widgets 的类
 * 它负责管理 widgets 的布局、绘制、事件处理等功能
 */
open type ViewManager {
  /**
   * TuiApp 创建的 Screen；ViewManager 只持有引用，不重复创建。
   */
  seal let screen: Screen;

  /**
   * 记录绘制顺序
   * 用于 widgets 的鼠标事件层级处理，越靠后的 widget 说明层级越高，鼠标事件优先处理
   * 有 zIndex 的 widget 需要组件，需要在绘制时自行保障顺序（通常在父组件中）
   */
  seal let sequence: List<Widget>;

  /** 当前获得键盘焦点的 Widget。 */
  seal var _focused: Option<Widget>;

  /** root 之后的键盘多播事件。 */
  let key: Event<KeyEvent<Widget>> = Event<KeyEvent<Widget>>();

  /** root 之后的鼠标按下多播事件。 */
  let mouseDown: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标移动多播事件。 */
  let mouseMove: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标释放多播事件。 */
  let mouseUp: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标滚轮多播事件。 */
  let wheel: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 使用已有 Screen 创建 ViewManager。
   * @param screen 视图布局和绘制使用的 Screen
   */
  func ViewManager(screen: Screen) {
    self.screen = screen;
    self.sequence = List<Widget>();
    self._focused = none;
    self.root = none;
  }

  /**
   * 判断 Widget 是否属于当前 root 组件树。
   * @param widget 需要检查的 Widget
   * @return Widget 是 root 本身或其后代时返回 true
   */
  seal func isInRoot(widget: Widget): bool {
    if self.root match root: Widget {
      return root == widget || root.isAncestor(widget);
    }
    return false;
  }

  /**
   * 返回有效焦点；焦点已不可聚焦或脱离 root 时清除并返回 none。
   * @return 当前仍有效的焦点
   */
  seal func validFocus(): Option<Widget> {
    if self._focused match focused: Widget {
      if focused.tabIndex >= 0 && self.isInRoot(focused) {
        return focused;
      }
      self._focused = none;
    }
    return none;
  }

  /**
   * 尝试让当前 root 组件树中的可聚焦 Widget 获得焦点。
   * @param widget 需要获得焦点的 Widget
   * @return 设置成功或已经获得焦点时返回 true
   */
  open func focus(widget: Widget): bool {
    if widget.tabIndex < 0 || !self.isInRoot(widget) {
      return false;
    }
    self._focused = widget;
    return true;
  }

  /**
   * 清除当前焦点；没有焦点时静默返回。
   */
  open func clearFocus(): void {
    self._focused = none;
  }

  /**
   * 获取当前有效焦点。
   * @return 当前焦点；焦点无效或不存在时返回 none
   */
  open func focused(): Option<Widget> {
    return self.validFocus();
  }

  /**
   * 获取当前 Screen 宽度。
   * @return Screen 列数
   */
  open func getScreenWidth(): int {
    let size = self.screen.size();
    return (int)size.item1;
  }

  /**
   * 获取当前 Screen 高度。
   * @return Screen 行数
   */
  open func getScreenHeight(): int {
    let size = self.screen.size();
    return (int)size.item2;
  }

  /**
   * 获取当前 Screen 的 back buffer。
   * Screen resize 后 Buffer 会被替换，组件不应缓存返回值。
   * @return 当前绘制使用的 Buffer
   */
  open func getScreenBuffer(): Buffer {
    return self.screen.buffer();
  }

  /**
   * 缓存组件本帧实际绘制区域并跟踪绘制顺序。
   * @param widget 需要跟踪的 widget
   * @param drawFrame 经过祖先和 Screen 裁剪后的实际绘制区域
   */
  open func trace(widget: Widget, drawFrame: Rect): void {
    widget.drawFrame = drawFrame;
    self.sequence.add(widget);
  }

  /**
   * 判断屏幕坐标是否位于指定矩形内。
   * @param frame 需要检查的矩形
   * @param x 屏幕列坐标
   * @param y 屏幕行坐标
   * @return 坐标是否位于矩形内
   */
  seal func containsPoint(frame: Rect, x: int, y: int): bool {
    if frame.width <= 0 || frame.height <= 0 || x < frame.x || y < frame.y {
      return false;
    }
    let right = frame.x + frame.width;
    let bottom = frame.y + frame.height;
    return x < right && y < bottom;
  }

  /**
   * 按本帧实际绘制顺序从后向前查找最上层命中组件。
   * 命中直接读取 draw 阶段缓存的 drawFrame，不重新遍历祖先或读取样式。
   * @param x 屏幕列坐标
   * @param y 屏幕行坐标
   * @return 首个命中的组件；未命中时返回 none
   */
  seal func hitTest(x: int, y: int): Option<Widget> {
    var index = self.sequence.size();
    while index > 0 {
      index -= 1;
      let widget = self.sequence.get(index);
      if self.containsPoint(widget.drawFrame, x, y) {
        return widget;
      }
    }
    return none;
  }

  /**
   * 根据鼠标动作触发组件对应的多播事件。
   * 滚轮按钮优先映射为 wheel，其余事件按 action 分发。
   * @param widget 当前接收事件的组件
   * @param event 需要分发的鼠标事件
   */
  seal func invokeMouse(widget: Widget, event: MouseEvent<Widget>): void {
    if event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown {
      let targetEvent = widget.wheel;
      targetEvent.emit(event);
      return;
    }
    match event.action {
      MouseAction.Press {
        let targetEvent = widget.mouseDown;
        targetEvent.emit(event);
      }
      MouseAction.Move {
        let targetEvent = widget.mouseMove;
        targetEvent.emit(event);
      }
      MouseAction.Release {
        let targetEvent = widget.mouseUp;
        targetEvent.emit(event);
      }
    }
  }

  /**
   * 根据鼠标动作触发 ViewManager 对应的多播事件。
   * @param event 需要分发的鼠标事件
   */
  seal func invokeManagerMouse(event: MouseEvent<Widget>): void {
    if event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown {
      let targetEvent = self.wheel;
      targetEvent.emit(event);
      return;
    }
    match event.action {
      MouseAction.Press {
        let targetEvent = self.mouseDown;
        targetEvent.emit(event);
      }
      MouseAction.Move {
        let targetEvent = self.mouseMove;
        targetEvent.emit(event);
      }
      MouseAction.Release {
        let targetEvent = self.mouseUp;
        targetEvent.emit(event);
      }
    }
  }

  /**
   * 判断当前 Widget 是否为 ViewManager 的 root。
   * @param widget 传播链中的当前 Widget
   * @return 当前 Widget 是否为 root
   */
  seal func isCurrentRoot(widget: Widget): bool {
    if self.root match root: Widget {
      return root == widget;
    }
    return false;
  }

  /**
   * 执行鼠标按下后的默认聚焦行为。
   * 从原始 target 向上选择最近的可聚焦 Widget；滚轮及已阻止事件不处理。
   * @param target 鼠标最初命中或锁定的 target
   * @param event 已完成视图路由的鼠标事件
   */
  seal func applyMouseDefault(target: Widget, event: MouseEvent<Widget>): void {
    if event.action != MouseAction.Press ||
    event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown ||
    event.isPrevented() {
      return;
    }
    var current = target;
    while true {
      if current.tabIndex >= 0 {
        self.focus(current);
        return;
      }
      if current.parent match let parent: ContainerWidget {
        current = (Widget)parent;
      } else {
        return;
      }
    }
  }

  /**
   * 从锁定目标或本帧最上层命中组件开始分发鼠标事件，并沿 parent 自下向上冒泡。
   * 锁定目标优先于坐标命中；选定目标会写入 event.target，并在本次冒泡期间保持不变。
   * 当前组件的全部监听器返回后检查 event.isStopped()；停止后不再触发父组件或
   * ViewManager 事件。正常到达 root 后触发 ViewManager 对应事件，随后执行默认聚焦。
   * 未命中任何组件时直接触发 ViewManager 对应事件。
   * @param event InputManager 解析得到的鼠标事件
   */
  open func dispatchMouse(event: MouseEvent<Widget>): void {
    var selected: Option<Widget> = none;
    if MouseEvent<Widget>.hasLockedTarget() {
      selected = MouseEvent<Widget>.lockedTarget();
    } else {
      selected = self.hitTest(event.x, event.y);
    }
    if selected match let target: Widget {
      if MouseEvent<Widget>.hasLockedTarget() {
        event.bindLockedTarget(target);
      } else {
        event.bindTarget(target);
      }
      var current = target;
      var routing = true;
      while routing {
        self.invokeMouse(current, event);
        if event.isStopped() {
          routing = false;
        } else if self.isCurrentRoot(current) {
          self.invokeManagerMouse(event);
          routing = false;
        } else if current.parent match let parent: ContainerWidget {
          current = (Widget)parent;
        } else {
          routing = false;
        }
      }
      self.applyMouseDefault(target, event);
    } else {
      self.invokeManagerMouse(event);
    }
  }

  /**
   * 向当前焦点 Widget 分发键盘事件，并沿 parent 向 root 冒泡。
   * 正常到达 root 后触发 ViewManager.key；没有焦点时直接触发 ViewManager.key。
   * @param event InputManager 解析得到的键盘事件
   */
  open func dispatchKey(event: KeyEvent<Widget>): void {
    if self.validFocus() match let target: Widget {
      event.bindTarget(target);
      var current = target;
      var routing = true;
      while routing {
        let targetEvent = current.key;
        targetEvent.emit(event);
        if event.isStopped() {
          routing = false;
        } else if self.isCurrentRoot(current) {
          let managerEvent = self.key;
          managerEvent.emit(event);
          routing = false;
        } else if current.parent match let parent: ContainerWidget {
          current = (Widget)parent;
        } else {
          routing = false;
        }
      }
    } else {
      let managerEvent = self.key;
      managerEvent.emit(event);
    }
  }

  /**
   * 根组件
   * 所有的 widgets 都是从 root 开始递归调用 arrange 和 draw 方法
   */
  open var root: Option<Widget>;

  /**
   * 第一阶段：布局
   * 从 Root 开始，递归调用每个 Widget 的 arrange 方法，计算每个 Widget 的位置和大小
   * 布局结阶段结束后，所有 widgets 的 frame 都已经计算完成
   */
  open func arrange() {
    if self.root match root: Widget {
      root.arrange(self);
    }
  }

  /**
   * 第二阶段：绘制
   * 从 Root 开始，递归调用每个 Widget 的 draw 方法，绘制每个 Widget
   * 绘制阶段结束后，所有 widgets 都已经绘制完成
   */
  open func draw() {
    self.sequence.clear();
    if self.root match root: Widget {
      self.screen.buffer().clear();
      root.draw(self);
    }
  }

}
