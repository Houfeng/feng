open module std.tui.view;

import std;
import std.collections;
import std.tui.common;
import std.tui.input;
import std.tui.screen;

/** ViewManager 内部使用的单指针 click 识别状态。 */
seal enum ClickState {
  /** 当前没有待识别的 click。 */
  Idle,
  /** 左键已按下，且尚未观察到坐标变化。 */
  Pressed,
  /** 左键按下后已经移动，本轮不能再产生 click。 */
  Moved
}

/**
 * ViewManager 是一个管理所有 widgets 的类
 * 它负责管理 widgets 的布局、绘制、事件处理等功能
 */
open type ViewManager {
  /**
   * TuiApp 创建的 Screen；ViewManager 只持有引用，不重复创建。
   */
  seal let screen: Screen;

  /**
   * 记录绘制顺序
   * 用于 widgets 的鼠标事件层级处理，越靠后的 widget 说明层级越高，鼠标事件优先处理
   * 有 zIndex 的 widget 需要组件，需要在绘制时自行保障顺序（通常在父组件中）
   */
  seal let sequence: List<Widget>;

  /** 当前获得键盘焦点的 Widget。 */
  seal var _focused: Option<Widget>;

  /** 当前焦点从 target 到 root 的有序路径；组件脱离树后仍用于完整 blur。 */
  seal var _focusPath: List<Widget>;

  /** 下一焦点路径的复用缓冲；与 _focusPath 在切换完成时交换。 */
  seal var _nextFocusPath: List<Widget>;

  /** 当前实际鼠标命中目标到 root 的 Hover 路径。 */
  seal var _hoverPath: List<Widget>;

  /** 下一 Hover 路径的复用缓冲；与 _hoverPath 在更新完成时交换。 */
  seal var _nextHoverPath: List<Widget>;

  /** 当前鼠标按下激活目标到 root 的 Active 路径。 */
  seal let _activePath: List<Widget>;

  /** 当前单指针 click 识别状态。 */
  seal var _clickState: ClickState;

  /** 最近一次左键按下的起始坐标；Idle 状态下没有语义。 */
  seal var _clickPosition: Tuple<int, int>;

  /** 当前是否正在触发不可停止的焦点路径事件。 */
  seal var _focusChanging: bool;

  /** 焦点事件监听器是否提交了待串行处理的焦点请求。 */
  seal var _hasPendingFocus: bool;

  /** 焦点事件监听器最后一次提交的焦点请求。 */
  seal var _pendingFocus: Option<Widget>;

  /** 焦点首次进入 ViewManager 组件树时触发的多播事件。 */
  let onFocus: Event<FocusEvent<Widget>> = Event<FocusEvent<Widget>>();

  /** 焦点最终离开 ViewManager 组件树时触发的多播事件。 */
  let onBlur: Event<FocusEvent<Widget>> = Event<FocusEvent<Widget>>();

  /** root 之后的键盘多播事件。 */
  let key: Event<KeyEvent<Widget>> = Event<KeyEvent<Widget>>();

  /** root 之后的鼠标按下多播事件。 */
  let mouseDown: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标移动多播事件。 */
  let mouseMove: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标释放多播事件。 */
  let mouseUp: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的鼠标滚轮多播事件。 */
  let wheel: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /** root 之后的 click 多播事件。 */
  let click: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 使用已有 Screen 创建 ViewManager。
   * @param screen 视图布局和绘制使用的 Screen
   */
  func ViewManager(screen: Screen) {
    self.screen = screen;
    self.sequence = List<Widget>();
    self._focused = none;
    self._focusPath = List<Widget>();
    self._nextFocusPath = List<Widget>();
    self._hoverPath = List<Widget>();
    self._nextHoverPath = List<Widget>();
    self._activePath = List<Widget>();
    self._clickState = ClickState.Idle;
    self._clickPosition = (0, 0);
    self._focusChanging = false;
    self._hasPendingFocus = false;
    self._pendingFocus = none;
    self.root = none;
  }

  /**
   * 判断 Widget 是否属于当前 root 组件树。
   * @param widget 需要检查的 Widget
   * @return Widget 是 root 本身或其后代时返回 true
   */
  seal func isInRoot(widget: Widget): bool {
    if self.root match root: Widget {
      return root == widget || root.isAncestor(widget);
    }
    return false;
  }

  /**
   * 判断下一焦点是否与当前焦点相同。
   * @param next 待设置的焦点
   * @return 两个 Option 是否表示同一个 Widget 或都为 none
   */
  seal func isSameFocus(next: Option<Widget>): bool {
    if self._focused match current: Widget {
      if next match candidate: Widget {
        return current == candidate;
      }
      return false;
    }
    if next match candidate: Widget {
      return false;
    }
    return true;
  }

  /**
   * 将 target 到当前 root 的路径写入复用缓冲。
   * @param target 路径起点
   * @param path 需要清空并写入的路径缓冲
   */
  seal func fillPath(target: Widget, path: List<Widget>): void {
    path.clear();
    var current = target;
    while true {
      path.add(current);
      if self.isCurrentRoot(current) {
        return;
      }
      if current.parent match let parent: ContainerWidget {
        current = (Widget)parent;
      } else {
        path.clear();
        return;
      }
    }
  }

  /**
   * 按 target 到共同祖先之前的顺序触发不可停止的 blur 事件。
   * @param path 旧焦点路径
   * @param count 发生焦点离开状态变化的路径长度
   * @param target 真正失去焦点的 Widget
   */
  seal func emitBlurPath(path: List<Widget>, count: int, target: Widget): void {
    let event = FocusEvent<Widget>(target);
    for var index: int = 0; index < count; index += 1 {
      let targetEvent = path.get(index).onBlur;
      targetEvent.emit(event);
    }
  }

  /**
   * 按 target 到共同祖先之前的顺序触发不可停止的 focus 事件。
   * @param path 新焦点路径
   * @param count 发生焦点进入状态变化的路径长度
   * @param target 真正获得焦点的 Widget
   */
  seal func emitFocusPath(path: List<Widget>, count: int, target: Widget): void {
    let event = FocusEvent<Widget>(target);
    for var index: int = 0; index < count; index += 1 {
      let targetEvent = path.get(index).onFocus;
      targetEvent.emit(event);
    }
  }

  /**
   * 执行一次焦点路径差分并同步焦点目标及其 Focus 状态。
   * 状态和路径在事件触发前更新，使监听器读取 focused() 和 Widget.state 时
   * 看到本次新状态。Pseudo.Focus 只属于真实焦点目标，不传播到祖先。
   * @param next 本次请求的下一焦点
   */
  seal func performFocusChange(next: Option<Widget>): void {
    if self.isSameFocus(next) {
      return;
    }
    if next match candidate: Widget {
      if candidate.tabIndex < 0 || !self.isInRoot(candidate) {
        return;
      }
      self.fillPath(candidate, self._nextFocusPath);
    } else {
      self._nextFocusPath.clear();
    }

    let previous = self._focused;
    let oldPath = self._focusPath;
    let newPath = self._nextFocusPath;
    var oldChangedCount = oldPath.size();
    var newChangedCount = newPath.size();
    while oldChangedCount > 0 && newChangedCount > 0 {
      if oldPath.get(oldChangedCount - 1) != newPath.get(newChangedCount - 1) {
        break;
      }
      oldChangedCount -= 1;
      newChangedCount -= 1;
    }

    let focusMask = (int)Pseudo.Focus;
    if previous match oldTarget: Widget {
      oldTarget.removeState(focusMask);
    }
    if next match newTarget: Widget {
      newTarget.addState(focusMask);
    }

    self._focused = next;
    self._focusPath = newPath;
    self._nextFocusPath = oldPath;
    defer { oldPath.clear(); }

    var hadPrevious = false;
    var hasNext = false;
    if previous match oldTarget: Widget {
      hadPrevious = true;
      self.emitBlurPath(oldPath, oldChangedCount, oldTarget);
    }
    if next match newTarget: Widget {
      hasNext = true;
      self.emitFocusPath(newPath, newChangedCount, newTarget);
    }
    if hadPrevious && !hasNext {
      if previous match oldTarget: Widget {
        let event = FocusEvent<Widget>(oldTarget);
        let managerEvent = self.onBlur;
        managerEvent.emit(event);
      }
    } else if !hadPrevious && hasNext {
      if next match newTarget: Widget {
        let event = FocusEvent<Widget>(newTarget);
        let managerEvent = self.onFocus;
        managerEvent.emit(event);
      }
    }
  }

  /**
   * 提交焦点变更；焦点事件内的重入请求在本轮事件完成后串行处理，最后一次请求生效。
   * @param next 请求的下一焦点
   */
  seal func requestFocus(next: Option<Widget>): void {
    if self._focusChanging {
      self._pendingFocus = next;
      self._hasPendingFocus = true;
      return;
    }
    self._focusChanging = true;
    defer {
      self._focusChanging = false;
      self._hasPendingFocus = false;
      self._pendingFocus = none;
    }
    var requested = next;
    while true {
      self._hasPendingFocus = false;
      self.performFocusChange(requested);
      if self._hasPendingFocus {
        requested = self._pendingFocus;
        self._pendingFocus = none;
      } else {
        return;
      }
    }
  }

  /**
   * 返回有效焦点；焦点已不可聚焦或脱离 root 时清除并返回 none。
   * @return 当前仍有效的焦点
   */
  seal func validFocus(): Option<Widget> {
    if self._focused match focused: Widget {
      if focused.tabIndex >= 0 && self.isInRoot(focused) {
        return focused;
      }
      self.requestFocus(none);
    }
    return none;
  }

  /**
   * 尝试让当前 root 组件树中的可聚焦 Widget 获得焦点。
   * @param widget 需要获得焦点的 Widget
   * @return 设置成功或已经获得焦点时返回 true
   */
  open func focus(widget: Widget): bool {
    if widget.tabIndex < 0 || !self.isInRoot(widget) {
      return false;
    }
    self.requestFocus(widget);
    return true;
  }

  /**
   * 清除当前焦点；没有焦点时静默返回。
   */
  open func clearFocus(): void {
    self.requestFocus(none);
  }

  /**
   * 获取当前有效焦点。
   * @return 当前焦点；焦点无效或不存在时返回 none
   */
  open func focused(): Option<Widget> {
    return self.validFocus();
  }

  /**
   * 判断 sequence 中的 Widget 当前是否可以参与 Tab 切换。
   * sequence 已保证 Widget 在上一帧具有有效绘制区域；此处只补充实时焦点资格、
   * 可见性和 root 归属检查。pointerEvents 只控制鼠标，不影响键盘焦点。
   * @param widget sequence 中的候选 Widget
   * @return 当前是否为有效 Tab 候选
   */
  seal func isTabCandidate(widget: Widget): bool {
    return widget.tabIndex >= 0 &&
      widget.rtStyle.visibility == Visibility.Visible &&
      self.isInRoot(widget);
  }

  /**
   * 比较两个 Tab 候选的稳定顺序键 `(tabIndex, sequenceIndex)`。
   * @param left 左侧候选
   * @param leftIndex 左侧候选在 sequence 中的位置
   * @param right 右侧候选
   * @param rightIndex 右侧候选在 sequence 中的位置
   * @return left 的顺序严格位于 right 之前时返回 true
   */
  seal func isTabOrderBefore(left: Widget, leftIndex: int,
    right: Widget, rightIndex: int): bool {
    if left.tabIndex != right.tabIndex {
      return left.tabIndex < right.tabIndex;
    }
    return leftIndex < rightIndex;
  }

  /**
   * 沿 sequence 的稳定 Tab 顺序移动焦点。
   * 先定位当前焦点的 sequenceIndex，再扫描全部候选，同时选择相邻项与循环项；
   * 不排序、不遍历组件树，也不创建临时集合。
   * @param forward true 表示 Tab 正向，false 表示 Shift+Tab 反向
   * @return 找到候选且 focus() 接受目标时返回 true
   */
  seal func moveTabFocus(forward: bool): bool {
    var currentIndex = -1;
    var currentTabIndex = -1;
    if self.validFocus() match current: Widget {
      var index = 0;
      while index < self.sequence.size() {
        if self.sequence.get(index) == current {
          if self.isTabCandidate(current) {
            currentIndex = index;
            currentTabIndex = current.tabIndex;
          }
          break;
        }
        index += 1;
      }
    }

    let hasCurrent = currentIndex >= 0;
    var adjacent: Option<Widget> = none;
    var adjacentIndex = -1;
    var wrap: Option<Widget> = none;
    var wrapIndex = -1;

    var index = 0;
    while index < self.sequence.size() {
      let candidate = self.sequence.get(index);
      if self.isTabCandidate(candidate) {
        if wrap match currentWrap: Widget {
          let replaceWrap = if forward {
            self.isTabOrderBefore(candidate, index, currentWrap, wrapIndex)
          } else {
            self.isTabOrderBefore(currentWrap, wrapIndex, candidate, index)
          };
          if replaceWrap {
            wrap = candidate;
            wrapIndex = index;
          }
        } else {
          wrap = candidate;
          wrapIndex = index;
        }

        var beyondCurrent = !hasCurrent;
        if hasCurrent {
          if forward {
            beyondCurrent = candidate.tabIndex > currentTabIndex ||
              (candidate.tabIndex == currentTabIndex && index > currentIndex);
          } else {
            beyondCurrent = candidate.tabIndex < currentTabIndex ||
              (candidate.tabIndex == currentTabIndex && index < currentIndex);
          }
        }
        if beyondCurrent {
          if adjacent match currentAdjacent: Widget {
            let replaceAdjacent = if forward {
              self.isTabOrderBefore(candidate, index,
                currentAdjacent, adjacentIndex)
            } else {
              self.isTabOrderBefore(currentAdjacent, adjacentIndex,
                candidate, index)
            };
            if replaceAdjacent {
              adjacent = candidate;
              adjacentIndex = index;
            }
          } else {
            adjacent = candidate;
            adjacentIndex = index;
          }
        }
      }
      index += 1;
    }

    if adjacent match target: Widget {
      return self.focus(target);
    }
    if wrap match target: Widget {
      return self.focus(target);
    }
    return false;
  }

  /**
   * 在键盘视图路由完成后执行 Tab 默认焦点切换。
   * 仅处理无修饰 Tab 和仅带 Shift 的 Tab；stop() 不影响默认行为，
   * preventDefault() 可以阻止切换。
   * @param event 已完成 Widget/ViewManager 路由的同一键盘事件
   */
  seal func applyKeyDefault(event: KeyEvent<Widget>): void {
    if event.isPrevented() {
      return;
    }
    if event.content match key: SpecialKey {
      if key == SpecialKey.Tab {
        if event.mods == 0 {
          self.moveTabFocus(true);
        } else if event.mods == MOD_SHIFT {
          self.moveTabFocus(false);
        }
      }
    }
  }

  /**
   * 获取当前 Screen 宽度。
   * @return Screen 列数
   */
  open func getScreenWidth(): int {
    let size = self.screen.size();
    return (int)size.item1;
  }

  /**
   * 获取当前 Screen 高度。
   * @return Screen 行数
   */
  open func getScreenHeight(): int {
    let size = self.screen.size();
    return (int)size.item2;
  }

  /**
   * 获取当前 Screen 的 back buffer。
   * Screen resize 后 Buffer 会被替换，组件不应缓存返回值。
   * @return 当前绘制使用的 Buffer
   */
  open func getScreenBuffer(): Buffer {
    return self.screen.buffer();
  }

  /**
   * 请求设置焦点 Widget 的终端光标位置，不改变可见性。
   * 只有当前真实焦点可以提交，且坐标必须位于该 Widget 本帧 clippedFrame 内。
   * @param widget 请求终端光标位置的 Widget
   * @param x Screen 的零基列坐标
   * @param y Screen 的零基行坐标
   * @return 请求通过焦点、裁剪和 Screen 边界校验时返回 true
   */
  open func requestCursorPosition(widget: Widget, x: int, y: int): bool {
    if x < 0 || y < 0 || !self.containsPoint(widget.clippedFrame, x, y) {
      return false;
    }
    if self.validFocus() match focused: Widget {
      if focused == widget {
        return self.screen.setCursorPosition((u32)x, (u32)y);
      }
    }
    return false;
  }

  /**
   * 原子请求设置焦点 Widget 的终端光标位置和可见性。
   * 只有当前真实焦点可以提交，且坐标必须位于该 Widget 本帧 clippedFrame 内。
   * @param widget 请求终端光标状态的 Widget
   * @param x Screen 的零基列坐标
   * @param y Screen 的零基行坐标
   * @param visible 最终终端光标是否可见
   * @return 请求通过焦点、裁剪和 Screen 边界校验时返回 true
   */
  open func requestCursorPosition(widget: Widget, x: int, y: int,
    visible: bool): bool {
    if x < 0 || y < 0 || !self.containsPoint(widget.clippedFrame, x, y) {
      return false;
    }
    if self.validFocus() match focused: Widget {
      if focused == widget {
        return self.screen.setCursorPosition((u32)x, (u32)y, visible);
      }
    }
    return false;
  }

  /**
   * 缓存组件本帧实际绘制区域并跟踪绘制顺序。
   * @param widget 需要跟踪的 widget
   * @param clippedFrame 经过祖先和 Screen 裁剪后的实际绘制区域
   */
  open func trace(widget: Widget, clippedFrame: Rect): void {
    widget.clippedFrame = clippedFrame;
    self.sequence.add(widget);
  }

  /**
   * 判断屏幕坐标是否位于指定矩形内。
   * @param frame 需要检查的矩形
   * @param x 屏幕列坐标
   * @param y 屏幕行坐标
   * @return 坐标是否位于矩形内
   */
  seal func containsPoint(frame: Rect, x: int, y: int): bool {
    if frame.width <= 0 || frame.height <= 0 || x < frame.x || y < frame.y {
      return false;
    }
    let right = frame.x + frame.width;
    let bottom = frame.y + frame.height;
    return x < right && y < bottom;
  }

  /**
   * 按本帧实际绘制顺序从后向前查找最上层命中组件。
   * 命中直接读取 draw 阶段缓存的 clippedFrame，不重新遍历祖先或读取样式。
   * @param x 屏幕列坐标
   * @param y 屏幕行坐标
   * @return 首个命中的组件；未命中时返回 none
   */
  seal func hitTest(x: int, y: int): Option<Widget> {
    var index = self.sequence.size();
    while index > 0 {
      index -= 1;
      let widget = self.sequence.get(index);
      if widget.rtStyle.visibility == Visibility.Visible &&
      widget.rtStyle.pointerEvents == PointerEvents.All &&
      self.containsPoint(widget.clippedFrame, x, y) {
        return widget;
      }
    }
    return none;
  }

  /**
   * 根据实际坐标命中路径更新 Hover 状态。
   * 路径按 target 到 root 保存，通过共同祖先差分只更新真正离开或进入的部分。
   * @param target 当前实际坐标命中的最上层 Widget；未命中时为 none
   */
  seal func updateHover(target: Option<Widget>): void {
    self._nextHoverPath.clear();
    if target match widget: Widget {
      self.fillPath(widget, self._nextHoverPath);
    }

    let oldPath = self._hoverPath;
    let newPath = self._nextHoverPath;
    var oldChangedCount = oldPath.size();
    var newChangedCount = newPath.size();
    while oldChangedCount > 0 && newChangedCount > 0 {
      if oldPath.get(oldChangedCount - 1) != newPath.get(newChangedCount - 1) {
        break;
      }
      oldChangedCount -= 1;
      newChangedCount -= 1;
    }

    let hoverMask = (int)Pseudo.Hover;
    for var index: int = 0; index < oldChangedCount; index += 1 {
      oldPath.get(index).removeState(hoverMask);
    }
    for var index: int = 0; index < newChangedCount; index += 1 {
      newPath.get(index).addState(hoverMask);
    }

    self._hoverPath = newPath;
    self._nextHoverPath = oldPath;
    oldPath.clear();
  }

  /** 清除当前 Active 路径上的状态位并复用路径存储。 */
  seal func clearActive(): void {
    let activeMask = (int)Pseudo.Active;
    for let widget in self._activePath {
      widget.removeState(activeMask);
    }
    self._activePath.clear();
  }

  /**
   * 根据鼠标按下和释放维护 Active 路径。
   * 按下后移动及鼠标锁定不会改变路径；滚轮不属于激活操作。
   * @param event 当前鼠标事件
   * @param target 当前实际坐标命中的最上层 Widget
   */
  seal func updateActive(
    event: MouseEvent<Widget>,
    target: Option<Widget>
  ): void {
    if event.action == MouseAction.Release {
      self.clearActive();
      return;
    }
    if event.action != MouseAction.Press ||
    event.button == MouseButton.None ||
    event.button == MouseButton.WheelUp ||
    event.button == MouseButton.WheelDown {
      return;
    }

    self.clearActive();
    if target match widget: Widget {
      self.fillPath(widget, self._activePath);
      let activeMask = (int)Pseudo.Active;
      for let current in self._activePath {
        current.addState(activeMask);
      }
    }
  }

  /**
   * 根据原始鼠标事件推进单指针 click 状态机。
   * 当前只支持 click，不区分 doubleClick 或 longPress，因此不读取时间，也不设置
   * 按压时长阈值。Release 始终先恢复 Idle，确保后续回调停止传播、阻止默认行为或
   * 重入分发时都不会保留上一轮状态。
   * @param event 当前鼠标事件
   * @return 当前 release 是否满足 click 的位置与状态条件
   */
  seal func updateClickState(event: MouseEvent<Widget>): bool {
    if event.action == MouseAction.Press {
      self._clickState = ClickState.Idle;
      if event.button == MouseButton.Left {
        self._clickPosition = (event.x, event.y);
        self._clickState = ClickState.Pressed;
      }
      return false;
    }
    if event.action == MouseAction.Move {
      if self._clickState == ClickState.Pressed &&
      (event.x != self._clickPosition.item1 ||
      event.y != self._clickPosition.item2) {
        self._clickState = ClickState.Moved;
      }
      return false;
    }
    if event.action == MouseAction.Release {
      let shouldClick = event.button == MouseButton.Left &&
      self._clickState == ClickState.Pressed &&
      event.x == self._clickPosition.item1 &&
      event.y == self._clickPosition.item2;
      self._clickState = ClickState.Idle;
      return shouldClick;
    }
    return false;
  }

  /**
   * 根据鼠标动作触发组件对应的多播事件。
   * 滚轮按钮优先映射为 wheel，其余事件按 action 分发。
   * @param widget 当前接收事件的组件
   * @param event 需要分发的鼠标事件
   */
  seal func invokeMouse(widget: Widget, event: MouseEvent<Widget>): void {
    if event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown {
      let targetEvent = widget.wheel;
      targetEvent.emit(event);
      return;
    }
    match event.action {
      MouseAction.Press {
        let targetEvent = widget.mouseDown;
        targetEvent.emit(event);
      }
      MouseAction.Move {
        let targetEvent = widget.mouseMove;
        targetEvent.emit(event);
      }
      MouseAction.Release {
        let targetEvent = widget.mouseUp;
        targetEvent.emit(event);
      }
      MouseAction.Click {
        let targetEvent = widget.click;
        targetEvent.emit(event);
      }
    }
  }

  /**
   * 根据鼠标动作触发 ViewManager 对应的多播事件。
   * @param event 需要分发的鼠标事件
   */
  seal func invokeManagerMouse(event: MouseEvent<Widget>): void {
    if event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown {
      let targetEvent = self.wheel;
      targetEvent.emit(event);
      return;
    }
    match event.action {
      MouseAction.Press {
        let targetEvent = self.mouseDown;
        targetEvent.emit(event);
      }
      MouseAction.Move {
        let targetEvent = self.mouseMove;
        targetEvent.emit(event);
      }
      MouseAction.Release {
        let targetEvent = self.mouseUp;
        targetEvent.emit(event);
      }
      MouseAction.Click {
        let targetEvent = self.click;
        targetEvent.emit(event);
      }
    }
  }

  /**
   * 从指定目标开始路由一个鼠标事件；未指定目标时只触发 ViewManager 事件。
   * @param event 需要路由的鼠标事件
   * @param selected 路由起点
   * @param locked selected 是否来自当前鼠标锁定目标
   */
  seal func routeMouse(
    event: MouseEvent<Widget>,
    selected: Option<Widget>,
    locked: bool
  ): void {
    if selected match let target: Widget {
      var hiddenBoundary: Option<Widget> = none;
      var insideHiddenBoundary = false;
      if locked {
        event.bindLockedTarget(target);
        hiddenBoundary = self.resolveLockedHiddenBoundary(target);
        if hiddenBoundary match boundary: Widget {
          insideHiddenBoundary = true;
        }
      } else {
        event.bindTarget(target);
      }
      var current = target;
      var routing = true;
      while routing {
        if !insideHiddenBoundary &&
        current.rtStyle.visibility == Visibility.Visible &&
        current.rtStyle.pointerEvents == PointerEvents.All {
          self.invokeMouse(current, event);
        }
        if insideHiddenBoundary {
          if hiddenBoundary match boundary: Widget {
            if current == boundary {
              insideHiddenBoundary = false;
            }
          }
        }
        if event.isStopped() {
          routing = false;
        } else if self.isCurrentRoot(current) {
          self.invokeManagerMouse(event);
          routing = false;
        } else if current.parent match let parent: ContainerWidget {
          current = (Widget)parent;
        } else {
          routing = false;
        }
      }
    } else {
      self.invokeManagerMouse(event);
    }
  }

  /**
   * 判断当前 Widget 是否为 ViewManager 的 root。
   * @param widget 传播链中的当前 Widget
   * @return 当前 Widget 是否为 root
   */
  seal func isCurrentRoot(widget: Widget): bool {
    if self.root match root: Widget {
      return root == widget;
    }
    return false;
  }

  /**
   * 执行鼠标按下后的默认聚焦行为。
   * 从原始 target 向上选择最近的可聚焦 Widget；滚轮及已阻止事件不处理。
   * @param target 鼠标最初命中或锁定的 target
   * @param event 已完成视图路由的鼠标事件
   */
  seal func applyMouseDefault(target: Widget, event: MouseEvent<Widget>): void {
    if event.action != MouseAction.Press ||
    event.button == MouseButton.WheelUp || event.button == MouseButton.WheelDown ||
    event.isPrevented() {
      return;
    }
    var current = target;
    while true {
      if current.rtStyle.visibility == Visibility.Visible &&
      current.rtStyle.pointerEvents == PointerEvents.All &&
      current.tabIndex >= 0 {
        self.focus(current);
        return;
      }
      if current.parent match let parent: ContainerWidget {
        current = (Widget)parent;
      } else {
        return;
      }
    }
  }

  /**
   * 查找锁定目标到 root 路径中最外层的不可见 Widget。
   * 路由将跳过该边界及其内部子树，再从边界的可见父级继续冒泡。
   * @param target 当前锁定的鼠标目标
   * @return 最外层不可见边界；整条路径可见时返回 none
   */
  seal func resolveLockedHiddenBoundary(target: Widget): Option<Widget> {
    var result: Option<Widget> = none;
    var current = target;
    while true {
      if current.rtStyle.visibility != Visibility.Visible {
        result = current;
      }
      if self.isCurrentRoot(current) {
        return result;
      }
      if current.parent match let parent: ContainerWidget {
        current = (Widget)parent;
      } else {
        return result;
      }
    }
  }

  /**
   * 从锁定目标或本帧最上层命中组件开始分发鼠标事件，并沿 parent 自下向上冒泡。
   * 锁定目标优先于坐标命中；选定目标会写入 event.target，并在本次冒泡期间保持不变。
   * 当前组件的全部监听器返回后检查 event.isStopped()；停止后不再触发父组件或
   * ViewManager 事件。正常到达 root 后触发 ViewManager 对应事件，随后执行默认聚焦。
   * 未命中任何组件时直接触发 ViewManager 对应事件。
   * @param event InputManager 解析得到的鼠标事件
   */
  open func dispatchMouse(event: MouseEvent<Widget>): void {
    let hovered = self.hitTest(event.x, event.y);
    self.updateHover(hovered);
    let shouldClick = self.updateClickState(event);
    self.updateActive(event, hovered);

    var selected: Option<Widget> = none;
    let locked = MouseEvent<Widget>.hasLockedTarget();
    if locked {
      selected = MouseEvent<Widget>.lockedTarget();
    } else {
      selected = hovered;
    }
    self.routeMouse(event, selected, locked);
    if selected match let target: Widget {
      self.applyMouseDefault(target, event);
    }

    if event.action == MouseAction.Press &&
    event.button == MouseButton.Left && event.isPrevented() {
      self._clickState = ClickState.Idle;
    }
    if shouldClick && !event.isPrevented() {
      let clickEvent = MouseEvent<Widget>(MouseAction.Click,
        event.button, event.x, event.y, event.mods);
      self.routeMouse(clickEvent, hovered, false);
    }
  }

  /**
   * 向当前焦点 Widget 分发键盘事件，并沿 parent 向 root 冒泡。
   * 正常到达 root 后触发 ViewManager.key；没有焦点时直接触发 ViewManager.key。
   * @param event InputManager 解析得到的键盘事件
   */
  open func dispatchKey(event: KeyEvent<Widget>): void {
    if self.validFocus() match let target: Widget {
      event.bindTarget(target);
      var current = target;
      var routing = true;
      while routing {
        if current.rtStyle.visibility == Visibility.Visible {
          let targetEvent = current.key;
          targetEvent.emit(event);
        }
        if event.isStopped() {
          routing = false;
        } else if self.isCurrentRoot(current) {
          let managerEvent = self.key;
          managerEvent.emit(event);
          routing = false;
        } else if current.parent match let parent: ContainerWidget {
          current = (Widget)parent;
        } else {
          routing = false;
        }
      }
    } else {
      let managerEvent = self.key;
      managerEvent.emit(event);
    }
    self.applyKeyDefault(event);
  }

  /**
   * 根组件
   * 所有的 widgets 都是从 root 开始递归调用 arrange 和 draw 方法
   */
  open var root: Option<Widget>;

  /**
   * 标记当前根组件需要重新布局；没有根组件时静默返回。
   * Screen 尺寸等组件树外部布局条件变化时调用。
   */
  open func invalidateLayout(): void {
    if self.root match root: Widget {
      root.dirty.add(DirtyType.Layout);
    }
  }

  /**
   * 第一阶段：样式合并
   * Root 由框架强制铺满 Screen，再从 Root 开始合并组件树的运行时样式。
   */
  open func doStyling() {
    if self.root match root: Widget {
      root.overrideStyle.clear();
      root.overrideStyle.position = Position.Fixed;
      let rootX: Union<int, double> = 0;
      let rootY: Union<int, double> = 0;
      let rootWidth: Union<Auto, int, double> = self.getScreenWidth();
      let rootHeight: Union<Auto, int, double> = self.getScreenHeight();
      root.overrideStyle.x = rootX;
      root.overrideStyle.y = rootY;
      root.overrideStyle.width = rootWidth;
      root.overrideStyle.height = rootHeight;
      root.overrideStyle.margin = zeroThickness;
      root.doStyling(self);
    }
  }

  /**
   * 从当前实际 Hover target 向 root 解析鼠标指针形状。
   * 最近的非 Auto 值优先；整条路径均未指定时返回 Auto。
   * @return 当前应提交给 Screen 的鼠标指针形状
   */
  open func resolveCursor(): Cursor {
    for let widget in self._hoverPath {
      let cursor = widget.rtStyle.cursor;
      if cursor != Cursor.Auto {
        return cursor;
      }
    }
    return Cursor.Auto;
  }

  /**
   * 第二阶段：布局
   * 从 Root 开始，递归调用每个 Widget 的 arrange 方法，计算每个 Widget 的位置和大小
   * 布局结阶段结束后，所有 widgets 的 frame 都已经计算完成
   */
  open func doArrange() {
    if self.root match root: Widget {
      root.doArrange(self);
    }
  }

  /**
   * 第三阶段：绘制
   * 从 Root 开始，递归调用每个 Widget 的 draw 方法，绘制每个 Widget
   * 绘制阶段结束后，所有 widgets 都已经绘制完成
   */
  open func doDraw() {
    self.sequence.clear();
    if self.root match root: Widget {
      // 组件树每帧默认隐藏；焦点组件可以原子覆盖最终位置和可见性请求。
      self.screen.hideCursor();
      self.screen.buffer().clear();
      root.doDraw(self);
    }
  }

}
