open module std.tui.view;

import std;
import std.collections;
import std.tui.common;
import std.tui.screen;
import std.tui.input;

/**
 * Widget 组件契约
 */
open spec Widget {
  /**
   * 用户声明的布局与样式约束
   */
  let style: Style;

  /**
   * 布局阶段计算后的最终区域信息
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var frame: Rect;

  /**
   * 绘制阶段经过祖先和 Screen 裁剪后的本帧实际区域
   * 鼠标命中直接使用该绘制快照
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var drawFrame: Rect;

  /**
   * 父组件；仅由组件树 API 维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var parent: Option<ContainerWidget>;

  /**
   * 键盘事件回调
   */
  var onKey: Action<KeyEvent<Widget>>;

  /**
   * 鼠标按下事件回调
   */
  var onMouseDown: Action<MouseEvent<Widget>>;

  /**
   * 鼠标移动事件回调
   */
  var onMouseMove: Action<MouseEvent<Widget>>;

  /**
   * 鼠标释放事件回调
   */
  var onMouseUp: Action<MouseEvent<Widget>>;

  /**
   * 鼠标滚轮事件回调
   */
  var onWheel: Action<MouseEvent<Widget>>;

  /**
   * 对齐并计算当前组件的 frame
   * 容器组件自行决定是否及如何布局子组件
   */
  func arrange(manager: ViewManager): void;

  /**
   * 根据 frame 和非尺寸样式绘制当前组件
   * 需要组件将自身添加到 ViewManager 的 sequence 中，保证绘制顺序正确
   */
  func draw(manager: ViewManager): void;

  /**
   * 检查当前组件是否为指定组件的祖先
   * 当前组件与指定组件相同时返回 false
   */
  func isAncestor(w: Widget): bool;
}

/**
 * ContainerWidget 容器组件契约
 */
open spec ContainerWidget: Widget {
  /**
   * 直接子组件集合
   */
  let children: List<Widget>;

  /**
   * 添加子组件；已有父容器时自动迁移
   */
  func addChild(child: Widget): void;

  /**
   * 移除子组件；子组件不存在时静默返回
   */
  func removeChild(child: Widget): void;

  /**
   * 移除所有直接子组件
   */
  func clearChildren(): void;
}
