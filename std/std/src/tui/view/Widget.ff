open module std.tui.view;

import std;
import std.collections;
import std.tui.common;
import std.tui.screen;
import std.tui.input;

/**
 * Widget 组件契约
 */
open spec Widget {
  /**
   * 用户声明的布局与样式约束
   */
  let style: Style;

  /**
   * 当前样式阶段复用的草稿样式，仅供 TUI 框架维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  let draftStyle: Style;

  /**
   * 当前已经生效的运行时样式，仅供 TUI 框架维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  let rtStyle: Style;

  /**
   * 框架和父布局提供的最高优先级样式覆盖，仅供 TUI 框架维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  let overrideStyle: StylePatch;

  /**
   * 当前组件的状态位集合；Pseudo 只占其中一组框架内建状态位。
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var state: int;

  /**
   * 按定义顺序保存的状态样式，仅供 TUI 样式管线维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  let stateStyles: StateStyles;

  /** 获取指定内建伪状态的样式，首次使用时创建。 */
  func useStateStyle(pseudo: Pseudo): StylePatch;

  /** 将指定状态位加入当前状态集合。 */
  func addState(mask: int): void;

  /** 将指定状态位从当前状态集合移除。 */
  func removeState(mask: int): void;

  /**
   * 当前组件的组合脏状态，仅供 TUI 框架维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var dirty: DirtyMark;

  /**
   * 布局阶段计算后的最终区域；x/y 是相对于 Screen 原点的绝对坐标。
   * 父布局负责将直接 child 的相对布局结果转换为该绝对坐标。
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var frame: Rect;

  /**
   * frame 经过祖先和 Screen 裁剪后的本帧实际区域；x/y 同样是
   * 相对于 Screen 原点的绝对坐标。绘制和鼠标命中直接使用该快照。
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var clippedFrame: Rect;

  /**
   * 父组件；仅由组件树 API 维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var parent: Option<ContainerWidget>;

  /**
   * 焦点资格与后续 Tab 顺序。
   * 负值表示不可获得焦点，非负值表示可获得焦点。
   */
  var tabIndex: int;

  /**
   * 焦点首次进入当前组件子树时触发的多播事件。
   */
  let onFocus: Event<FocusEvent<Widget>>;

  /**
   * 焦点最终离开当前组件子树时触发的多播事件。
   */
  let onBlur: Event<FocusEvent<Widget>>;

  /**
   * 键盘多播事件
   */
  let key: Event<KeyEvent<Widget>>;

  /**
   * 鼠标按下多播事件
   */
  let mouseDown: Event<MouseEvent<Widget>>;

  /**
   * 鼠标移动多播事件
   */
  let mouseMove: Event<MouseEvent<Widget>>;

  /**
   * 鼠标释放多播事件
   */
  let mouseUp: Event<MouseEvent<Widget>>;

  /**
   * 鼠标滚轮多播事件
   */
  let wheel: Event<MouseEvent<Widget>>;

  /**
   * 请求直接父组件重新布局。
   * 更高祖先只标记子树布局路径；没有父组件时静默返回。
   */
  func requestReflow(): void;

  /**
   * 合并本轮有效样式，并根据最终布局样式变化标记布局。
   * 容器组件自行决定是否及如何处理子组件。
   */
  func doStyling(manager: ViewManager): void;

  /**
   * 根据布局脏标记调度 arrange。
   * 仅供 ViewManager 和负责子组件布局的组件调用。
   */
  func doArrange(manager: ViewManager): void;

  /**
   * 对齐并计算当前组件的 frame
   * 容器组件自行决定是否及如何布局子组件
   */
  func arrange(manager: ViewManager): void;

  /**
   * 计算并缓存有效绘制区域、登记绘制顺序，再调度 draw。
   * 仅供 ViewManager 和负责绘制子组件的组件调用。
   */
  func doDraw(manager: ViewManager): void;

  /**
   * 根据已缓存的 clippedFrame 和非尺寸样式绘制当前组件。
   * 容器组件自行决定是否及如何绘制子组件。
   */
  func draw(manager: ViewManager): void;

  /**
   * 检查当前组件是否为指定组件的祖先
   * 当前组件与指定组件相同时返回 false
   */
  func isAncestor(w: Widget): bool;
}

/**
 * ContainerWidget 容器组件契约
 */
open spec ContainerWidget: Widget {
  /**
   * 直接子组件集合
   */
  let children: List<Widget>;

  /**
   * 清理并准备直接 child 的运行时样式覆盖。
   * 仅供容器 styling 阶段调用；专用容器可覆盖并追加布局约束。
   */
  func prepareChildOverrideStyle(child: Widget): void;

  /**
   * 添加子组件；已有父容器时自动迁移
   */
  func addChild(child: Widget): void;

  /**
   * 移除子组件；子组件不存在时静默返回
   */
  func removeChild(child: Widget): void;

  /**
   * 移除所有直接子组件
   */
  func clearChildren(): void;
}
