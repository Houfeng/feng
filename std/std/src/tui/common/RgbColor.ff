open module std.tui.common;

/**
 * RgbColor 表示一个带 alpha 的 RGB 绘制颜色，用于终端前景色和背景色。
 *
 * @value 类型，4 字节字段（r, g, b, a），值语义。
 * 在 Buffer 的 draw 方法中配合 Option<RgbColor> 使用：
 *   - none 表示终端默认色（不写入 style 的颜色位段）
 *   - a == 0 表示透明，保留 Buffer 中已有的对应颜色通道
 *   - 本阶段任何非零 a 均按完全不透明处理
 */
@value
open type RgbColor {
  /** 红色分量（0-255） */
  open var r: u8;
  /** 绿色分量（0-255） */
  open var g: u8;
  /** 蓝色分量（0-255） */
  open var b: u8;
  /** Alpha 分量；本阶段 0 表示透明，非零表示完全不透明 */
  open var a: u8;

  /**
   * 默认构造函数：创建完全不透明的黑色 (0, 0, 0, 1)。
   */
  func RgbColor() {
    self.a = 1;
  }

  /**
   * 构造函数：创建指定 RGB 分量的完全不透明颜色。
   * @param r - 红色分量（0-255）
   * @param g - 绿色分量（0-255）
   * @param b - 蓝色分量（0-255）
   */
  func RgbColor(r: u8, g: u8, b: u8) {
    self.r = r;
    self.g = g;
    self.b = b;
    self.a = 1;
  }

  /**
   * 构造函数：创建指定 RGBA 分量的绘制颜色。
   * 本阶段 a == 0 表示透明，任何非零值均按完全不透明处理。
   * @param r - 红色分量（0-255）
   * @param g - 绿色分量（0-255）
   * @param b - 蓝色分量（0-255）
   * @param a - Alpha 分量
   */
  func RgbColor(r: u8, g: u8, b: u8, a: u8) {
    self.r = r;
    self.g = g;
    self.b = b;
    self.a = a;
  }
}
