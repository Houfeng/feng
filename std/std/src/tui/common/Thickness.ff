open module std.tui.common;

import std;

/**
 * Thickness 表示距形的四个边的厚度
 * 可用于 Padding、Margin、Border 等
 */
open type Thickness {
  /** 上侧厚度；int 为固定终端单元数，double 为相对比例 */
  let top: Union<int, double>;
  /** 右侧厚度；int 为固定终端单元数，double 为相对比例 */
  let right: Union<int, double>;
  /** 下侧厚度；int 为固定终端单元数，double 为相对比例 */
  let bottom: Union<int, double>;
  /** 左侧厚度；int 为固定终端单元数，double 为相对比例 */
  let left: Union<int, double>;

  /** 使用固定终端单元数分别构造四侧厚度。 */
  func Thickness(t: int, r: int, b: int, l: int): void {
    self.top = t;
    self.right = r;
    self.bottom = b;
    self.left = l;
  }

  /** 使用固定终端单元数按垂直、水平两轴构造厚度。 */
  func Thickness(v: int, h: int): void {
    self.top = v;
    self.right = h;
    self.bottom = v;
    self.left = h;
  }

  /** 使用相对比例分别构造四侧厚度。 */
  func Thickness(t: double, r: double, b: double, l: double): void {
    self.top = t;
    self.right = r;
    self.bottom = b;
    self.left = l;
  }

  /** 使用相对比例按垂直、水平两轴构造厚度。 */
  func Thickness(v: double, h: double): void {
    self.top = v;
    self.right = h;
    self.bottom = v;
    self.left = h;
  }

  /** 使用同一固定终端单元数构造四侧厚度。 */
  func Thickness(all: int): void {
    self.top = all;
    self.right = all;
    self.bottom = all;
    self.left = all;
  }

  /** 使用同一相对比例构造四侧厚度。 */
  func Thickness(all: double): void {
    self.top = all;
    self.right = all;
    self.bottom = all;
    self.left = all;
  }

}
