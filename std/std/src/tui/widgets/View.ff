open module std.tui.widgets;

import std;
import std.collections;
import std.tui.view;
import std.tui.input;
import std.tui.screen;
import std.tui.common;

/**
 * 基础视图组件
 * 基他组件可通过 mixin View 来获得基础的布局、绘制、事件处理能力
 */
open type View: Widget {
  /**
   * 用户声明的布局与样式约束
   */
  let style: Style;

  /**
   * 当前组件的组合脏状态；新组件及其初始子树需要布局
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var dirty: DirtyMark = DirtyMark(
    DirtyType.Layout,
    DirtyType.SubtreeLayout
  );

  /**
   * 布局阶段计算后的最终区域信息
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var frame: Rect;

  /**
   * 绘制阶段经过祖先和 Screen 裁剪后的本帧实际区域
   * 鼠标命中直接使用该绘制快照
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var drawFrame: Rect;

  /**
   * 父组件；仅由组件树 API 维护
   * 注意：未来 spec 的 seal 成员实施后将改为 seal
   */
  var parent: Option<ContainerWidget>;

  /**
   * 焦点资格与后续 Tab 顺序；默认 -1 表示不可获得焦点。
   */
  var tabIndex: int = -1;

  /**
   * 焦点首次进入当前组件子树时触发的多播事件。
   */
  let onFocus: Event<FocusEvent<Widget>> = Event<FocusEvent<Widget>>();

  /**
   * 焦点最终离开当前组件子树时触发的多播事件。
   */
  let onBlur: Event<FocusEvent<Widget>> = Event<FocusEvent<Widget>>();

  /**
   * 键盘多播事件
   */
  let key: Event<KeyEvent<Widget>> = Event<KeyEvent<Widget>>();

  /**
   * 鼠标按下多播事件
   */
  let mouseDown: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 鼠标移动多播事件
   */
  let mouseMove: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 鼠标释放多播事件
   */
  let mouseUp: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 鼠标滚轮多播事件
   */
  let wheel: Event<MouseEvent<Widget>> = Event<MouseEvent<Widget>>();

  /**
   * 按指定参照尺寸解析固定值或百分比。
   * 结果保留正负方向；NaN 解析为 0。
   */
  open static func resolveLength(value: Union<int, double>,
    reference: int): int {
    return match value {
      fixed: int { fixed }
      ratio: double {
        if ratio != ratio { 0 }
        else { (int)((double)reference * ratio) }
      }
      else { 0 }
    };
  }

  /**
   * 从参照尺寸中扣除两侧非负间距，扣除量过大时返回 0。
   */
  seal static func resolveAvailableSize(reference: int, leading: int, trailing: int): int {
    if reference <= 0 || leading >= reference || trailing >= reference - leading {
      return 0;
    }
    return reference - leading - trailing;
  }

  /**
   * 向坐标叠加有符号偏移。
   */
  seal static func addCoordinate(value: int, offset: int): int {
    return value + offset;
  }

  /**
   * 判断定位方式是否参与普通流布局。
   */
  seal static func isNormalFlow(position: Position): bool {
    return position == Position.Normal || position == Position.Relative;
  }

  /**
   * 请求直接父组件重新布局，并为更高祖先标记子树布局路径。
   * 直接父组件获得 Layout；更高祖先只获得 SubtreeLayout。
   */
  @mixable
  static func requestReflow(widget: Widget): void {
    if widget.parent match parent: ContainerWidget {
      let parentWidget = (Widget)parent;
      parentWidget.dirty.add(DirtyType.Layout);
      var current = parentWidget.parent;
      while current match let ancestor: ContainerWidget {
        let ancestorWidget = (Widget)ancestor;
        if ancestorWidget.dirty.has(DirtyType.SubtreeLayout) {
          return;
        }
        ancestorWidget.dirty.add(DirtyType.SubtreeLayout);
        current = ancestorWidget.parent;
      }
    }
  }

  /**
   * 消费布局脏标记并调度组件自己的 arrange 实现。
   * arrange 期间直接父级收到的 Layout 请求会在本次调用内继续处理。
   */
  @mixable
  static func doArrange(widget: Widget, manager: ViewManager): void {
    if !widget.dirty.has(DirtyType.Layout) &&
    !widget.dirty.has(DirtyType.SubtreeLayout) {
      return;
    }
    while true {
      widget.dirty.remove(DirtyType.Layout);
      widget.dirty.remove(DirtyType.SubtreeLayout);
      widget.arrange(manager);
      if !widget.dirty.has(DirtyType.Layout) {
        // 本轮自治布局已经同步处理子树；消费期间重新登记的路径标记。
        widget.dirty.remove(DirtyType.SubtreeLayout);
        return;
      }
    }
  }

  /**
   * 根据对齐方式在一个轴的可用区域中定位组件。
   * 组件尺寸超过可用区域时仍保持 Center/End 语义，允许结果位于参照区域之前。
   */
  seal static func resolveAlignedPosition(origin: int, available: int,
    size: int, align: Align): int {
    match align {
      Align.Center {
        return View.addCoordinate(origin, (available - size) / 2);
      }
      Align.End {
        return View.addCoordinate(origin, available - size);
      }
      else {
        return origin;
      }
    }
  }

  /**
   * 解析当前组件的布局参照区域。
   * Normal/Relative 使用直接父组件扣除 padding 后的 content 区域；
   * Absolute 使用最近的非 Normal 祖先 frame；Fixed 使用整个 Screen。
   * Absolute 不存在非 Normal 祖先、或普通流组件无 parent 时使用整个 Screen。
   */
  open static func resolveReferenceFrame(widget: Widget, manager: ViewManager): Rect {
    let reference = Rect();
    reference.x = 0;
    reference.y = 0;
    reference.width = manager.getScreenWidth();
    reference.height = manager.getScreenHeight();

    if widget.style.position == Position.Fixed {
      return reference;
    }

    if widget.style.position == Position.Absolute {
      var current: Option<ContainerWidget> = widget.parent;
      while current match let parent: ContainerWidget {
        let parentWidget = (Widget)parent;
        if parentWidget.style.position != Position.Normal {
          return parentWidget.frame;
        }
        current = parentWidget.parent;
      }
      return reference;
    }

    if widget.parent match parent: ContainerWidget {
      let parentWidget = (Widget)parent;
      reference.x = parentWidget.frame.x;
      reference.y = parentWidget.frame.y;
      reference.width = parentWidget.frame.width;
      reference.height = parentWidget.frame.height;

      if View.isNormalFlow(widget.style.position) {
        let padding = parentWidget.style.padding;
        var top = View.resolveLength(padding.top, reference.height);
        var right = View.resolveLength(padding.right, reference.width);
        var bottom = View.resolveLength(padding.bottom, reference.height);
        var left = View.resolveLength(padding.left, reference.width);
        if top < 0 { top = 0; }
        if right < 0 { right = 0; }
        if bottom < 0 { bottom = 0; }
        if left < 0 { left = 0; }
        reference.x = View.addCoordinate(reference.x, left);
        reference.y = View.addCoordinate(reference.y, top);
        reference.width = View.resolveAvailableSize(reference.width, left, right);
        reference.height = View.resolveAvailableSize(reference.height, top, bottom);
      }
    }

    return reference;
  }

  /**
   * 解析组件最终宽度。
   */
  open static func resolveWidth(widget: Widget, referenceWidth: int,
    left: int, right: int, intrinsic: int): int {
    let available = View.resolveAvailableSize(referenceWidth, left, right);
    if View.isNormalFlow(widget.style.position) &&
    widget.style.horizontalAlign == Align.Full {
      return available;
    }
    return match widget.style.width {
      autoValue: Auto { if intrinsic > 0 { intrinsic } else { 0 } }
      fixed: int { if fixed > 0 { fixed } else { 0 } }
      ratio: double {
        let length = View.resolveLength(ratio, available);
        if length > 0 { length } else { 0 }
      }
      else { 0 }
    };
  }

  /**
   * 解析组件最终高度。
   */
  open static func resolveHeight(widget: Widget, referenceHeight: int,
    top: int, bottom: int, intrinsic: int): int {
    let available = View.resolveAvailableSize(referenceHeight, top, bottom);
    if View.isNormalFlow(widget.style.position) &&
    widget.style.verticalAlign == Align.Full {
      return available;
    }
    return match widget.style.height {
      autoValue: Auto { if intrinsic > 0 { intrinsic } else { 0 } }
      fixed: int { if fixed > 0 { fixed } else { 0 } }
      ratio: double {
        let length = View.resolveLength(ratio, available);
        if length > 0 { length } else { 0 }
      }
      else { 0 }
    };
  }

  /**
   * 解析组件最终横坐标。
   */
  open static func resolveX(widget: Widget, reference: Rect,
    left: int, right: int, width: int): int {
    let marginOrigin = View.addCoordinate(reference.x, left);
    if View.isNormalFlow(widget.style.position) {
      let available = View.resolveAvailableSize(reference.width, left, right);
      return View.resolveAlignedPosition(marginOrigin, available, width,
      widget.style.horizontalAlign);
    }
    let offset = View.resolveLength(widget.style.x, reference.width);
    return View.addCoordinate(View.addCoordinate(reference.x, offset), left);
  }

  /**
   * 解析组件最终纵坐标。
   */
  open static func resolveY(widget: Widget, reference: Rect,
    top: int, bottom: int, height: int): int {
    let marginOrigin = View.addCoordinate(reference.y, top);
    if View.isNormalFlow(widget.style.position) {
      let available = View.resolveAvailableSize(reference.height, top, bottom);
      return View.resolveAlignedPosition(marginOrigin, available, height,
      widget.style.verticalAlign);
    }
    let offset = View.resolveLength(widget.style.y, reference.height);
    return View.addCoordinate(View.addCoordinate(reference.y, offset), top);
  }

  /**
   * 对齐并计算当前组件的 frame
   * 容器组件自行决定是否及如何布局子组件
   */
  @mixable
  static func arrange(widget: Widget, manager: ViewManager): void {
    let reference = View.resolveReferenceFrame(widget, manager);
    let margin = widget.style.margin;
    var top = View.resolveLength(margin.top, reference.height);
    var right = View.resolveLength(margin.right, reference.width);
    var bottom = View.resolveLength(margin.bottom, reference.height);
    var left = View.resolveLength(margin.left, reference.width);
    if top < 0 { top = 0; }
    if right < 0 { right = 0; }
    if bottom < 0 { bottom = 0; }
    if left < 0 { left = 0; }
    let width = View.resolveWidth(widget, reference.width, left, right, 0);
    let height = View.resolveHeight(widget, reference.height, top, bottom, 0);

    let frame = Rect();
    frame.x = View.resolveX(widget, reference, left, right, width);
    frame.y = View.resolveY(widget, reference, top, bottom, height);
    frame.width = width;
    frame.height = height;
    widget.frame = frame;
  }

  /**
   * 计算两个矩形的交集；无交集时返回宽高为 0 的矩形。
   */
  seal static func intersectFrame(first: Rect, second: Rect): Rect {
    var left = first.x;
    if second.x > left {
      left = second.x;
    }
    var top = first.y;
    if second.y > top {
      top = second.y;
    }

    var right = View.addCoordinate(first.x, first.width);
    let secondRight = View.addCoordinate(second.x, second.width);
    if secondRight < right {
      right = secondRight;
    }
    var bottom = View.addCoordinate(first.y, first.height);
    let secondBottom = View.addCoordinate(second.y, second.height);
    if secondBottom < bottom {
      bottom = secondBottom;
    }

    let result = Rect();
    result.x = left;
    result.y = top;
    if first.width <= 0 || first.height <= 0 || second.width <= 0 ||
    second.height <= 0 || right <= left || bottom <= top {
      result.width = 0;
      result.height = 0;
      return result;
    }
    result.width = right - left;
    result.height = bottom - top;
    return result;
  }

  /**
   * 解析当前组件的有效绘制区域。
   * 先使用最近的 overflow=Hidden 祖先 frame 裁剪，再裁剪到 Screen。
   */
  open static func resolveDrawFrame(widget: Widget, manager: ViewManager): Rect {
    var result = widget.frame;
    var current: Option<ContainerWidget> = widget.parent;
    while current match let parent: ContainerWidget {
      let parentWidget = (Widget)parent;
      if parentWidget.style.overflow == Overflow.Hidden {
        result = View.intersectFrame(result, parentWidget.frame);
        break;
      }
      current = parentWidget.parent;
    }

    let screen = Rect();
    screen.x = 0;
    screen.y = 0;
    screen.width = manager.getScreenWidth();
    screen.height = manager.getScreenHeight();
    return View.intersectFrame(result, screen);
  }

  /**
   * 计算并缓存当前组件的有效绘制区域，登记绘制顺序后调度 draw。
   * 空区域不会进入 sequence，也不会调用组件的 draw 实现。
   */
  @mixable
  static func doDraw(widget: Widget, manager: ViewManager): void {
    let frame = View.resolveDrawFrame(widget, manager);
    widget.drawFrame = frame;
    if frame.width == 0 || frame.height == 0 {
      return;
    }
    manager.trace(widget, frame);
    widget.draw(manager);
  }

  /**
   * 使用已缓存的 drawFrame 和非尺寸样式绘制当前组件的矩形。
   * 不绘制文本、边框或子组件。
   */
  @mixable
  static func draw(widget: Widget, manager: ViewManager): void {
    let frame = widget.drawFrame;
    if frame.width == 0 || frame.height == 0 {
      return;
    }
    if widget.style.backColor match color: RgbColor {
      if color.a != 0 {
        manager.getScreenBuffer().draw((u32)frame.x, (u32)frame.y,
          (u32)frame.width, (u32)frame.height, (u64)0,
          none, color);
      }
    }
  }

  /**
   * 检查当前组件是否为指定组件的祖先
   * 使用循环沿 parent 链向上查找，不使用递归
   */
  @mixable
  static func isAncestor(widget: Widget, w: Widget): bool {
    var current: Option < ContainerWidget > = w.parent;
    while current match let parent: ContainerWidget {
      if widget == (Widget)parent {
        return true;
      }
      current = parent.parent;
    }
    return false;
  }
}
