open module std.tui.widgets;

import std;
import std.collections;
import std.text;
import std.tui.common;
import std.tui.view;
import std.tui.input;
import std.tui.screen;

/** libunistring：解码下一个 UTF-8 码点。 */
@cdecl("feng_std_unistring", "u8_next")
extern func text_u8_next(puc: u32*, s: string*): string*;

/** libunistring：返回当前 extended grapheme cluster 之后的位置。 */
@cdecl("feng_std_unistring", "u8_grapheme_next")
extern func text_u8_grapheme_next(s: string*, end: string*): string*;

/** runtime：判断指针是否为空。 */
@runtime
extern func feng_pointer_is_null(ptr: string*): bool;

/** runtime：按字节偏移移动指针。 */
@runtime
extern func feng_pointer_move(ptr: string*, offset: int): string*;

/** runtime：判断两个字符串数据指针是否相等。 */
@runtime
extern func feng_pointer_equal(left: string*, right: string*): bool;

/**
 * TextLine 记录 Text.content 中一条最终显示行的原始字节区间。
 * 区间不包含硬换行码点，绘制时直接从原字符串解码，不创建 substring。
 */
@value
open type TextLine {
  /** 行首相对 content 数据起点的字节偏移。 */
  let start: int;
  /** 行尾相对 content 数据起点的字节偏移，采用左闭右开区间。 */
  let end: int;
  /** 本行包含的 Cell 数。 */
  let cells: int;

  /** 创建一条最终显示行。 */
  func TextLine(start: int, end: int, cells: int) {
    self.start = start;
    self.end = end;
    self.cells = cells;
  }
}

/** Text 组件的内容与内部排版状态契约。 */
open spec TextWidget: Widget {
  /** 需要显示的文本内容。 */
  var content: string;

  /** arrange 生成、draw 复用的最终显示行。 */
  seal let lines: List<TextLine>;
}

/**
 * Text 文本组件。
 * 根据最终内容宽度自动换行，并在 Auto 高度下使用最终行数确定 frame。
 */
open type Text: TextWidget {
  /** 展开 View 的 Widget 基础状态和未被 Text 覆盖的默认行为。 */
  ...: View = View();

  /** 需要显示的文本内容。 */
  open var content: string;

  /** arrange 生成、draw 复用的最终显示行。 */
  seal let lines: List<TextLine> = List<TextLine>();

  /** 判断当前宽度声明是否需要扫描内在内容宽度。 */
  seal static func needsIntrinsicWidth(text: TextWidget): bool {
    if (text.rtStyle.position == Position.Normal ||
    text.rtStyle.position == Position.Relative) &&
    text.rtStyle.horizontalAlign == Align.Full {
      return false;
    }
    if text.rtStyle.width match value: Auto {
      return true;
    }
    return false;
  }

  /**
   * 返回一个 grapheme 按 8 字节 Cell 内联规则拆分后的总显示列数。
   */
  seal static func graphemeCells(value: string): int {
    if value.length() <= TextUtil.MAX_CELL_BYTES {
      return TextUtil.measureCellWidth(value);
    }
    var result = 0;
    var chunkBytes = 0;
    var chunkWidth = 0;
    for let rune in value.runes() {
      let runeBytes = rune.length();
      if chunkBytes > 0 &&
      chunkBytes + runeBytes > TextUtil.MAX_CELL_BYTES {
        result += TextUtil.resolveCellWidth(chunkWidth);
        chunkBytes = 0;
        chunkWidth = 0;
      }
      chunkBytes += runeBytes;
      chunkWidth += TextUtil.measureRuneWidth(rune);
    }
    if chunkBytes > 0 {
      result += TextUtil.resolveCellWidth(chunkWidth);
    }
    return result;
  }

  /** 判断一个 grapheme 是否为 Text 支持的硬换行。 */
  seal static func isHardBreak(value: string): bool {
    return value == "\n" || value == "\r\n";
  }

  /**
   * 计算 content 中最长逻辑行的 Cell 数。
   * LF 和 CRLF 结束当前逻辑行，其他内容按 std.text grapheme 边界扫描。
   */
  seal static func measureIntrinsicWidth(text: TextWidget): int {
    if text.content.length() == 0 {
      return 0;
    }
    var current = 0;
    var longest = 0;
    for let grapheme in text.content.graphemes() {
      if Text.isHardBreak(grapheme) {
        if current > longest {
          longest = current;
        }
        current = 0;
      } else {
        current += Text.graphemeCells(grapheme);
      }
    }
    if current > longest {
      longest = current;
    }
    return longest;
  }

  /** 向复用行缓冲追加一条 content 字节区间。 */
  seal static func addLine(text: TextWidget, start: int,
    end: int, cells: int): void {
    text.lines.add(TextLine(start, end, cells));
  }

  /**
   * 将一个已拆分 Cell 计入当前行，必要时先结束上一行。
   * 返回更新后的 lineStart/lineCells，不产生中间集合。
   */
  seal static func layoutCell(text: TextWidget, width: int,
    cellStart: int, cellWidth: int,
    lineStart: int, lineCells: int): Tuple<int, int> {
    if lineCells > 0 && lineCells + cellWidth > width {
      Text.addLine(text, lineStart, cellStart, lineCells);
      return (cellStart, cellWidth);
    }
    return (lineStart, lineCells + cellWidth);
  }

  /**
   * 按最终内容宽度和 std.text grapheme 边界生成显示行。
   * 能放入整行的 grapheme 不在中间软换行；自身超过整行宽度时按码点拆分。
   * 空 content 或零宽度不生成行；末尾硬换行生成空的最终行。
   */
  seal static func layoutLines(text: TextWidget, width: int): void {
    text.lines.clear();
    let length = text.content.length();
    if length == 0 || width <= 0 {
      return;
    }

    var lineStart = 0;
    var lineCells = 0;
    var offset = 0;
    for let grapheme in text.content.graphemes() {
      let graphemeStart = offset;
      let graphemeEnd = graphemeStart + grapheme.length();
      offset = graphemeEnd;

      if Text.isHardBreak(grapheme) {
        Text.addLine(text, lineStart, graphemeStart, lineCells);
        lineStart = graphemeEnd;
        lineCells = 0;
        continue;
      }

      let cells = Text.graphemeCells(grapheme);
      if cells <= width {
        if lineCells > 0 && lineCells + cells > width {
          Text.addLine(text, lineStart, graphemeStart, lineCells);
          lineStart = graphemeStart;
          lineCells = 0;
        }
        lineCells += cells;
        continue;
      }

      var graphemeOffset = 0;
      var chunkStart = 0;
      var chunkBytes = 0;
      var chunkWidth = 0;
      for let rune in grapheme.runes() {
        let runeBytes = rune.length();
        if chunkBytes > 0 &&
        chunkBytes + runeBytes > TextUtil.MAX_CELL_BYTES {
          let state = Text.layoutCell(text, width,
            graphemeStart + chunkStart,
            TextUtil.resolveCellWidth(chunkWidth), lineStart, lineCells);
          lineStart = state.item1;
          lineCells = state.item2;
          chunkStart = graphemeOffset;
          chunkBytes = 0;
          chunkWidth = 0;
        }
        chunkBytes += runeBytes;
        chunkWidth += TextUtil.measureRuneWidth(rune);
        graphemeOffset += runeBytes;
      }
      if chunkBytes > 0 {
        let state = Text.layoutCell(text, width,
          graphemeStart + chunkStart,
          TextUtil.resolveCellWidth(chunkWidth), lineStart, lineCells);
        lineStart = state.item1;
        lineCells = state.item2;
      }
    }
    Text.addLine(text, lineStart, length, lineCells);
  }

  /**
   * 按当前行的 Cell 数计算其在 Text frame 内的起始横坐标。
   */
  seal static func resolveLineX(text: TextWidget, line: TextLine): int {
    let remaining = text.frame.width - line.cells;
    match text.rtStyle.textAlign {
      TextAlign.Center {
        return text.frame.x + remaining / 2;
      }
      TextAlign.Right {
        return text.frame.x + remaining;
      }
      else {
        return text.frame.x;
      }
    }
  }

  /**
   * 将一条显示行中完整落入水平可见范围的 Cell 值写入 back buffer。
   * grapheme 超过 8 字节时在码点边界拆分，Screen 不参与拆分。
   */
  seal static func drawLine(text: TextWidget, buffer: Buffer,
    line: TextLine, lineX: int, y: int,
    clipLeft: int, clipRight: int, transparent: RgbColor): void {
    if clipLeft >= clipRight || line.cells <= 0 {
      return;
    }
    let data: string* = &text.content;
    var cursor = feng_pointer_move(data, line.start);
    let lineEnd = feng_pointer_move(data, line.end);
    var column = 0;
    while column < line.cells && !feng_pointer_equal(cursor, lineEnd) {
      let graphemeEnd = text_u8_grapheme_next(cursor, lineEnd);
      if feng_pointer_is_null(graphemeEnd) {
        return;
      }
      var runeCursor = cursor;
      var cellValue: u64 = 0;
      var cellBytes = 0;
      var cellWidth = 0;
      while !feng_pointer_equal(runeCursor, graphemeEnd) {
        var value: u32 = 0;
        let next = text_u8_next(&value, runeCursor);
        if feng_pointer_is_null(next) {
          return;
        }
        let encoded = TextUtil.encodeCellValue(value);
        let encodedBytes = TextUtil.cellValueByteLength(encoded);
        if cellBytes > 0 &&
        cellBytes + encodedBytes > TextUtil.MAX_CELL_BYTES {
          let width = TextUtil.resolveCellWidth(cellWidth);
          let x = lineX + column;
          if x >= clipRight {
            return;
          }
          if x >= clipLeft && x + width <= clipRight {
            buffer.draw((u32)x, (u32)y, cellValue,
              text.rtStyle.foreColor, transparent);
          }
          column += width;
          cellValue = 0;
          cellBytes = 0;
          cellWidth = 0;
        }
        cellValue |= encoded << (u64)(cellBytes * 8);
        cellBytes += encodedBytes;
        cellWidth += TextUtil.measureCellWidth(value);
        runeCursor = next;
      }
      if cellBytes > 0 {
        let width = TextUtil.resolveCellWidth(cellWidth);
        let x = lineX + column;
        if x >= clipRight {
          return;
        }
        if x >= clipLeft && x + width <= clipRight {
          buffer.draw((u32)x, (u32)y, cellValue,
            text.rtStyle.foreColor, transparent);
        }
        column += width;
      }
      cursor = graphemeEnd;
    }
  }

  /** 返回需要显示省略号的行索引；不需要时返回 -1。 */
  seal static func resolveEllipsisLine(text: TextWidget): int {
    if text.rtStyle.textOverflow == TextOverflow.Ellipsis &&
    text.frame.width > 0 && text.frame.height > 0 &&
    text.lines.size() > text.frame.height {
      return text.frame.height - 1;
    }
    return -1;
  }

  /** 返回当前 Text frame 能够容纳的省略号 Cell 数。 */
  seal static func ellipsisCells(text: TextWidget): int {
    if text.frame.width < 3 {
      return text.frame.width;
    }
    return 3;
  }

  /**
   * 在 Text frame 最右侧绘制落入 clippedFrame 的省略号 Cell。
   * frame 宽度小于 3 时只绘制能够容纳的点。
   */
  seal static func drawEllipsis(text: TextWidget, buffer: Buffer,
    clippedFrame: Rect, y: int, transparent: RgbColor): void {
    let cells = Text.ellipsisCells(text);
    var start = text.frame.x + text.frame.width - cells;
    if start < clippedFrame.x {
      start = clippedFrame.x;
    }
    var end = text.frame.x + text.frame.width;
    let drawRight = clippedFrame.x + clippedFrame.width;
    if end > drawRight {
      end = drawRight;
    }
    var x = start;
    while x < end {
      buffer.draw((u32)x, (u32)y, (u64)46,
        text.rtStyle.foreColor, transparent);
      x += 1;
    }
  }

  /**
   * 测量 content 并写回最终 frame。
   * 宽度先解析，Auto 高度再使用最终分行数。
   */
  @mixable
  seal static func arrange(text: TextWidget, manager: ViewManager): void {
    let widget = (Widget)text;
    let reference = View.resolveReferenceFrame(widget, manager);
    let margin = widget.rtStyle.margin;
    var top = View.resolveLength(margin.top, reference.height);
    var right = View.resolveLength(margin.right, reference.width);
    var bottom = View.resolveLength(margin.bottom, reference.height);
    var left = View.resolveLength(margin.left, reference.width);
    if top < 0 { top = 0; }
    if right < 0 { right = 0; }
    if bottom < 0 { bottom = 0; }
    if left < 0 { left = 0; }
    var intrinsicWidth = 0;
    if Text.needsIntrinsicWidth(text) {
      intrinsicWidth = Text.measureIntrinsicWidth(text);
    }
    let width = View.resolveWidth(widget, reference.width,
      left, right, intrinsicWidth);
    Text.layoutLines(text, width);
    let height = View.resolveHeight(widget, reference.height,
      top, bottom, text.lines.size());

    let frame = Rect();
    frame.x = View.resolveX(widget, reference, left, right, width);
    frame.y = View.resolveY(widget, reference, top, bottom, height);
    frame.width = width;
    frame.height = height;
    widget.frame = frame;
  }

  /**
   * 绘制可见背景和文本；clippedFrame 只裁剪，不改变布局阶段的分行。
   */
  @mixable
  seal static func draw(text: TextWidget, manager: ViewManager): void {
    let widget = (Widget)text;
    let clippedFrame = widget.clippedFrame;
    if clippedFrame.width == 0 || clippedFrame.height == 0 {
      return;
    }
    let buffer = manager.getScreenBuffer();
    if text.rtStyle.backColor match color: RgbColor {
      if color.a != 0 {
        buffer.draw((u32)clippedFrame.x, (u32)clippedFrame.y,
          (u32)clippedFrame.width, (u32)clippedFrame.height, (u64)0,
          none, color);
      }
    }

    let firstLine = clippedFrame.y - text.frame.y;
    let transparent = RgbColor(0, 0, 0, 0);
    let ellipsisLine = Text.resolveEllipsisLine(text);
    var visibleRow = 0;
    while visibleRow < clippedFrame.height {
      let lineIndex = firstLine + visibleRow;
      if lineIndex >= text.lines.size() || lineIndex >= text.frame.height {
        return;
      }
      let line = text.lines.get(lineIndex);
      let ellipsis = lineIndex == ellipsisLine;
      let lineX = Text.resolveLineX(text, line);
      var visibleX = lineX;
      if visibleX < clippedFrame.x {
        visibleX = clippedFrame.x;
      }
      var visibleRight = lineX + line.cells;
      let drawRight = clippedFrame.x + clippedFrame.width;
      if visibleRight > drawRight {
        visibleRight = drawRight;
      }
      if ellipsis {
        let ellipsisStart = text.frame.x + text.frame.width -
          Text.ellipsisCells(text);
        if visibleRight > ellipsisStart {
          visibleRight = ellipsisStart;
        }
      }
      let visibleWidth = visibleRight - visibleX;
      if visibleWidth > 0 {
        Text.drawLine(text, buffer, line,
          lineX, clippedFrame.y + visibleRow,
          visibleX, visibleRight, transparent);
      }
      if ellipsis {
        Text.drawEllipsis(text, buffer, clippedFrame,
          clippedFrame.y + visibleRow, transparent);
      }
      visibleRow += 1;
    }
  }
}
