open module std.tui.widgets;

import std;
import std.collections;
import std.text;
import std.tui.common;
import std.tui.view;
import std.tui.input;
import std.tui.screen;

/** libunistring：解码下一个 UTF-8 码点。 */
@cdecl("feng_std_unistring", "u8_next")
extern func text_u8_next(puc: u32*, s: string*): string*;

/** runtime：判断指针是否为空。 */
@runtime
extern func feng_pointer_is_null(ptr: string*): bool;

/** runtime：按字节偏移移动指针。 */
@runtime
extern func feng_pointer_move(ptr: string*, offset: int): string*;

/** runtime：计算两个指针的字节偏移。 */
@runtime
extern func feng_pointer_diff(a: string*, b: string*): int;

/** Text 中每一行内容的水平对齐方式。 */
open enum TextAlign {
  /** 从 Text frame 左侧开始绘制。 */
  Left,
  /** 在 Text frame 内水平居中。 */
  Center,
  /** 与 Text frame 右侧对齐。 */
  Right
}

/**
 * TextLine 记录 Text.content 中一条最终显示行的原始字节区间。
 * 区间不包含硬换行码点，绘制时直接从原字符串解码，不创建 substring。
 */
@value
open type TextLine {
  /** 行首相对 content 数据起点的字节偏移。 */
  let start: int;
  /** 行尾相对 content 数据起点的字节偏移，采用左闭右开区间。 */
  let end: int;
  /** 本行包含的 Cell 数。 */
  let cells: int;

  /** 创建一条最终显示行。 */
  func TextLine(start: int, end: int, cells: int) {
    self.start = start;
    self.end = end;
    self.cells = cells;
  }
}

/** Text 组件的内容与内部排版状态契约。 */
open spec TextWidget: Widget {
  /** 需要显示的文本内容。 */
  var content: string;

  /** 每一行内容在 Text frame 内的水平对齐方式。 */
  var textAlign: TextAlign;

  /** arrange 生成、draw 复用的最终显示行。 */
  let lines: List<TextLine>;
}

/**
 * Text 文本组件。
 * 根据最终内容宽度自动换行，并在 Auto 高度下使用最终行数确定 frame。
 */
open type Text: TextWidget {
  /** 展开 View 的 Widget 基础状态和未被 Text 覆盖的默认行为。 */
  ...: View = View();

  /** 需要显示的文本内容。 */
  open var content: string;

  /** 每一行内容在 Text frame 内的水平对齐方式。 */
  open var textAlign: TextAlign = TextAlign.Left;

  /** arrange 生成、draw 复用的最终显示行。 */
  seal let lines: List<TextLine> = List<TextLine>();

  /** 判断当前宽度声明是否需要扫描内在内容宽度。 */
  seal static func needsIntrinsicWidth(text: TextWidget): bool {
    if (text.style.position == Position.Normal ||
    text.style.position == Position.Relative) &&
    text.style.horizontalAlign == Align.Full {
      return false;
    }
    if text.style.width match value: Auto {
      return true;
    }
    return false;
  }

  /** 返回一个 grapheme 按当前 Cell 契约占用的 Cell 数。 */
  seal static func graphemeCells(value: string): int {
    return value.runes().length();
  }

  /** 判断一个 grapheme 是否为 Text 支持的硬换行。 */
  seal static func isHardBreak(value: string): bool {
    return value == "\n" || value == "\r\n";
  }

  /**
   * 计算 content 中最长逻辑行的 Cell 数。
   * LF 和 CRLF 结束当前逻辑行，其他内容按 std.text grapheme 边界扫描。
   */
  seal static func measureIntrinsicWidth(text: TextWidget): int {
    if text.content.length() == 0 {
      return 0;
    }
    var current = 0;
    var longest = 0;
    for let grapheme in text.content.graphemes() {
      if Text.isHardBreak(grapheme) {
        if current > longest {
          longest = current;
        }
        current = 0;
      } else {
        current += Text.graphemeCells(grapheme);
      }
    }
    if current > longest {
      longest = current;
    }
    return longest;
  }

  /** 向复用行缓冲追加一条 content 字节区间。 */
  seal static func addLine(text: TextWidget, start: int,
    end: int, cells: int): void {
    text.lines.add(TextLine(start, end, cells));
  }

  /**
   * 按最终内容宽度和 std.text grapheme 边界生成显示行。
   * 能放入整行的 grapheme 不在中间软换行；自身超过整行宽度时按码点拆分。
   * 空 content 或零宽度不生成行；末尾硬换行生成空的最终行。
   */
  seal static func layoutLines(text: TextWidget, width: int): void {
    text.lines.clear();
    let length = text.content.length();
    if length == 0 || width <= 0 {
      return;
    }

    var lineStart = 0;
    var lineCells = 0;
    var offset = 0;
    for let grapheme in text.content.graphemes() {
      let graphemeStart = offset;
      let graphemeEnd = graphemeStart + grapheme.length();
      offset = graphemeEnd;

      if Text.isHardBreak(grapheme) {
        Text.addLine(text, lineStart, graphemeStart, lineCells);
        lineStart = graphemeEnd;
        lineCells = 0;
        continue;
      }

      let cells = Text.graphemeCells(grapheme);
      if cells <= width {
        if lineCells > 0 && lineCells + cells > width {
          Text.addLine(text, lineStart, graphemeStart, lineCells);
          lineStart = graphemeStart;
          lineCells = 0;
        }
        lineCells += cells;
        continue;
      }

      var graphemeOffset = 0;
      for let rune in grapheme.runes() {
        if lineCells >= width {
          let splitOffset = graphemeStart + graphemeOffset;
          Text.addLine(text, lineStart, splitOffset, lineCells);
          lineStart = splitOffset;
          lineCells = 0;
        }
        lineCells += 1;
        graphemeOffset += rune.length();
      }
    }
    Text.addLine(text, lineStart, length, lineCells);
  }

  /** 将可选前景色转换为 Cell 的低 24 位颜色编码。 */
  seal static func resolveForeBits(text: TextWidget): u64 {
    if text.style.foreColor match color: RgbColor {
      return ((u64)color.r << (u64)16) |
        ((u64)color.g << (u64)8) | (u64)color.b;
    }
    return (u64)0;
  }

  /**
   * 在指定 Cell 写入一个文本码点。
   * 清除旧前景色和字符样式，仅保留已经存在或明确绘制的背景色。
   */
  seal static func writeCell(buffer: Buffer, index: int,
    value: u32, foreBits: u64): void {
    buffer.cells[index].value = (u64)value;
    buffer.cells[index].style =
      (buffer.cells[index].style & Cell.MASK_BG) | foreBits;
  }

  /**
   * 按当前行的 Cell 数计算其在 Text frame 内的起始横坐标。
   */
  seal static func resolveLineX(text: TextWidget, line: TextLine): int {
    let remaining = text.frame.width - line.cells;
    match text.textAlign {
      TextAlign.Center {
        return text.frame.x + remaining / 2;
      }
      TextAlign.Right {
        return text.frame.x + remaining;
      }
      else {
        return text.frame.x;
      }
    }
  }

  /**
   * 将一条显示行中落入水平可见范围的码点写入 back buffer。
   */
  seal static func drawLine(text: TextWidget, buffer: Buffer,
    line: TextLine, x: int, y: int, skip: int,
    width: int, foreBits: u64): void {
    if skip >= line.cells || width <= 0 {
      return;
    }
    let data: string* = &text.content;
    var cursor = feng_pointer_move(data, line.start);
    var offset = line.start;
    var column = 0;
    while column < skip && offset < line.end {
      var ignored: u32 = 0;
      let next = text_u8_next(&ignored, cursor);
      if feng_pointer_is_null(next) {
        return;
      }
      cursor = next;
      offset = feng_pointer_diff(next, data);
      column += 1;
    }

    var visibleColumn = 0;
    while visibleColumn < width && offset < line.end {
      var value: u32 = 0;
      let next = text_u8_next(&value, cursor);
      if feng_pointer_is_null(next) {
        return;
      }
      let cellIndex = y * (int)buffer.width + x + visibleColumn;
      Text.writeCell(buffer, cellIndex, value, foreBits);
      cursor = next;
      offset = feng_pointer_diff(next, data);
      visibleColumn += 1;
    }
  }

  /**
   * 测量 content 并写回最终 frame。
   * 宽度先解析，Auto 高度再使用最终分行数。
   */
  @mixable
  static func arrange(text: TextWidget, manager: ViewManager): void {
    let widget = (Widget)text;
    let reference = View.resolveReferenceFrame(widget, manager);
    let margin = widget.style.margin;
    var top = View.resolveLength(margin.top, reference.height);
    var right = View.resolveLength(margin.right, reference.width);
    var bottom = View.resolveLength(margin.bottom, reference.height);
    var left = View.resolveLength(margin.left, reference.width);
    if top < 0 { top = 0; }
    if right < 0 { right = 0; }
    if bottom < 0 { bottom = 0; }
    if left < 0 { left = 0; }
    var intrinsicWidth = 0;
    if Text.needsIntrinsicWidth(text) {
      intrinsicWidth = Text.measureIntrinsicWidth(text);
    }
    let width = View.resolveWidth(widget, reference.width,
      left, right, intrinsicWidth);
    Text.layoutLines(text, width);
    let height = View.resolveHeight(widget, reference.height,
      top, bottom, text.lines.size());

    let frame = Rect();
    frame.x = View.resolveX(widget, reference, left, right, width);
    frame.y = View.resolveY(widget, reference, top, bottom, height);
    frame.width = width;
    frame.height = height;
    widget.frame = frame;
  }

  /**
   * 绘制可见背景和文本；drawFrame 只裁剪，不改变布局阶段的分行。
   */
  @mixable
  static func draw(text: TextWidget, manager: ViewManager): void {
    let widget = (Widget)text;
    let drawFrame = View.resolveDrawFrame(widget, manager);
    if drawFrame.width == 0 || drawFrame.height == 0 {
      return;
    }
    manager.trace(widget, drawFrame);
    let buffer = manager.getScreenBuffer();
    if text.style.backColor match color: RgbColor {
      buffer.draw((u32)drawFrame.x, (u32)drawFrame.y,
        (u32)drawFrame.width, (u32)drawFrame.height, (u64)0,
        none, color);
    }

    let firstLine = drawFrame.y - text.frame.y;
    let foreBits = Text.resolveForeBits(text);
    var visibleRow = 0;
    while visibleRow < drawFrame.height {
      let lineIndex = firstLine + visibleRow;
      if lineIndex >= text.lines.size() || lineIndex >= text.frame.height {
        return;
      }
      let line = text.lines.get(lineIndex);
      let lineX = Text.resolveLineX(text, line);
      var visibleX = lineX;
      if visibleX < drawFrame.x {
        visibleX = drawFrame.x;
      }
      var visibleRight = lineX + line.cells;
      let drawRight = drawFrame.x + drawFrame.width;
      if visibleRight > drawRight {
        visibleRight = drawRight;
      }
      let visibleWidth = visibleRight - visibleX;
      if visibleWidth > 0 {
        Text.drawLine(text, buffer, line,
          visibleX, drawFrame.y + visibleRow, visibleX - lineX,
          visibleWidth, foreBits);
      }
      visibleRow += 1;
    }
  }
}
