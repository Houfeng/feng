open module std.tui.widgets;

import std;
import std.collections;
import std.tui.common;
import std.tui.view;
import std.tui.input;

/**
 * Container 容器组件基础实现
 * 默认按普通叠放语义处理直接 children 的样式、布局和绘制。
 * 其他容器可复用组件树能力并覆盖需要扩展的阶段。
 */
open type Container: ContainerWidget {
  /**
   * 展开 View 提供的公共状态与 Widget 默认行为
   */
  ...: View = View();

  /**
   * 直接子组件集合
   */
  let children: List<Widget>;

  /**
   * 合并自身样式，再清理并合并所有直接 children 的样式。
   * 具体容器可定义自己的同签名 @mixable 方法改变 children 的处理范围和顺序。
   */
  @mixable
  static func doStyling(container: ContainerWidget,
    manager: ViewManager): void {
    View.doStyling(container, manager);
    for let child in container.children {
      child.overrideStyle.clear();
      child.doStyling(manager);
    }
  }

  /**
   * 先布局自身，再调度所有直接 children 的布局。
   * 每次进入容器布局时都重新标记直接 child，确保父级 frame、padding 或覆盖变化生效。
   */
  @mixable
  static func arrange(container: ContainerWidget,
    manager: ViewManager): void {
    View.arrange(container, manager);
    for let child in container.children {
      child.dirty.add(DirtyType.Layout);
      child.doArrange(manager);
    }
  }

  /** 按自身、直接 children 的顺序完成默认叠放绘制。 */
  @mixable
  static func draw(container: ContainerWidget, manager: ViewManager): void {
    View.draw(container, manager);
    for let child in container.children {
      child.doDraw(manager);
    }
  }

  /** 标记组件树修改引起的容器布局变化并向祖先传播。 */
  seal static func invalidateLayout(container: ContainerWidget): void {
    let widget = (Widget)container;
    widget.dirty.add(DirtyType.Layout);
    widget.requestReflow();
  }

  /**
   * 添加子组件；已有父容器时先从旧父容器移除
   * 循环关系会在修改组件树前抛出 tui/widget/cycle
   */
  @mixable
  static func addChild(container: ContainerWidget, child: Widget): void {
    if child == (Widget)container || child.isAncestor(container) {
      throw "tui/widget/cycle";
    }
    if child.parent match parent: ContainerWidget {
      parent.removeChild(child);
    }
    container.children.add(child);
    child.parent = container;
    Container.invalidateLayout(container);
  }

  /**
   * 移除直接子组件；子组件不存在时静默返回
   */
  @mixable
  static func removeChild(container: ContainerWidget, child: Widget): void {
    for var index: int = 0; index < container.children.size(); index += 1 {
      if container.children.get(index) == child {
        container.children.removeAt(index);
        child.parent = none;
        Container.invalidateLayout(container);
        return;
      }
    }
  }

  /**
   * 移除所有直接子组件并清除其 parent 引用
   */
  @mixable
  static func clearChildren(container: ContainerWidget): void {
    if container.children.size() == 0 {
      return;
    }
    for let child in container.children {
      child.parent = none;
    }
    container.children.clear();
    Container.invalidateLayout(container);
  }
}
