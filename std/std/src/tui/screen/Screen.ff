open module std.tui.screen;

import std;
import std.collections;
import std.text;
import std.numeric;
import std.process;
import std.tui.common;

// ─── ANSI 转义序列常量 ─────────────────────────────────────────────────────

/** Screen 内部使用的 OSC 22 鼠标指针名称协议。 */
seal enum PointerCursorProtocol {
  /** CSS cursor 名称集合，供 Kitty、Ghostty、Foot 等终端使用。 */
  Css,
  /** X11 cursor 名称集合，供 iTerm2 和原生 xterm 使用。 */
  X11
}

/**
 * Screen 表示终端用户界面（TUI）的渲染底座——差异同步层。
 *
 * 采用双缓冲 + Diff 引擎：`back` 是应用绘制当前帧的画布，`front` 是上次
 * render 后发送给终端的内容快照（diff 基准）。`render()` 时逐 cell 比较
 * 两者，只对变化的 cell 发射 ANSI 序列，渲染后用 back 覆盖 front（memcpy，
 * 不交换指针——交换会导致 back 残留上一帧内容、被迫全刷，性能反而下降）。
 *
 * 终端是有状态设备，"双缓冲"在此处是 diff 模型而非图形系统的页翻转。
 */
open type Screen {

  // ─── 双缓冲 ─────────────────────────────────────────────────────────────

  /** diff 基准：上次 render 后发送给终端的内容快照，永不对外暴露 */
  seal var front: Buffer;

  /** 绘制表面：应用通过 buffer() 获取此引用后自由绘制 */
  seal var back: Buffer;

  // ─── SGR 状态机 ─────────────────────────────────────────────────────────

  /** render() 过程中跟踪的当前 SGR 样式编码（0 表示尚未发射任何 SGR） */
  seal var currentSgr: u64;

  /** 当前由应用控制的鼠标指针形状；Auto 表示未控制。 */
  seal var currentPointerCursor: Cursor;

  /** 当前终端使用的 OSC 22 鼠标指针名称协议。 */
  seal var pointerCursorProtocol: PointerCursorProtocol;

  /** 当前 patch 是否存在终端光标位置请求。 */
  seal var hasCursorPositionRequest: bool;

  /** 当前 patch 请求的终端光标 Screen 列坐标。 */
  seal var cursorRequestX: u32;

  /** 当前 patch 请求的终端光标 Screen 行坐标。 */
  seal var cursorRequestY: u32;

  /** 当前 patch 是否存在终端光标可见性请求。 */
  seal var hasCursorVisibilityRequest: bool;

  /** 当前 patch 请求的终端光标可见性。 */
  seal var cursorRequestVisible: bool;

  /** 已记录的终端物理光标坐标是否仍可信。 */
  seal var physicalCursorKnown: bool;

  /** 最近一次确认的终端物理光标列坐标。 */
  seal var physicalCursorX: u32;

  /** 最近一次确认的终端物理光标行坐标。 */
  seal var physicalCursorY: u32;

  /** 已记录的终端物理光标可见性是否仍可信。 */
  seal var physicalCursorVisibilityKnown: bool;

  /** 最近一次确认的终端物理光标是否可见。 */
  seal var physicalCursorVisible: bool;

  // ─── 构造函数 ─────────────────────────────────────────────────────────────

  /**
   * 构造函数：创建指定尺寸的 Screen，front/back 均初始化为空白 Buffer。
   * @param width - 屏幕列数
   * @param height - 屏幕行数
   */
  func Screen(width: u32, height: u32) {
    self.front = Buffer(width, height);
    self.back = Buffer(width, height);
    self.currentSgr = (u64)0;
    self.currentPointerCursor = Cursor.Auto;
    self.pointerCursorProtocol = PointerCursorProtocol.Css;
    self.hasCursorPositionRequest = false;
    self.cursorRequestX = (u32)0;
    self.cursorRequestY = (u32)0;
    self.hasCursorVisibilityRequest = false;
    self.cursorRequestVisible = true;
    self.physicalCursorKnown = false;
    self.physicalCursorX = (u32)0;
    self.physicalCursorY = (u32)0;
    self.physicalCursorVisibilityKnown = false;
    self.physicalCursorVisible = true;
  }

  // ─── 公开 API ───────────────────────────────────────────────────────────

  /**
   * 返回 back buffer 引用，供应用绘制当前帧。
   * 调用方可在返回的 Buffer 上直接调用 draw / fill / clear 等方法。
   * resize() 后需重新调用此方法获取最新引用。
   * @return back buffer
   */
  open func buffer(): Buffer {
    return self.back;
  }

  /**
   * 返回当前屏幕尺寸（列数, 行数）。
   * @return Tuple<u32, u32>，item1 为 width，item2 为 height
   */
  open func size(): Tuple<u32, u32> {
    return (self.back.width, self.back.height);
  }

  /**
   * 调整屏幕尺寸：重建 front/back 为新尺寸的空白 Buffer。
   * 旧内容不迁移——TUI resize 时旧内容无法对齐，由上层组件树负责重新布局。
   * front 同时清空；物理终端中的旧内容由上层在 resize 后显式清屏，
   * 再以新的空白 front 为基准绘制当前画面。
   * @param width - 新列数
   * @param height - 新行数
   */
  open func resize(width: u32, height: u32) {
    self.front = Buffer(width, height);
    self.back = Buffer(width, height);
    self.currentSgr = (u64)0;
    self.hasCursorPositionRequest = false;
    self.hasCursorVisibilityRequest = false;
    self.physicalCursorKnown = false;
  }

  // 使用 List<byte> 收集输出，避免 string 拼接的 O(n²) 复制开销
  seal let output = List<byte>();

  /**
   * 构建 diff 后的 ANSI 转义序列字节，由调用方直接写入 stdout。
   * 比较 back 与 front 的差异，只对变化的 cell 发射 ANSI 序列。
   * 渲染完成后将 back 的内容覆盖到 front（memcpy，不交换指针），
   * 使 front 成为新的 diff 基准。连续相同 style 的 cell 只发射一次 SGR 序列。
   * 不执行 I/O，纯函数。
   * @return ANSI 转义序列字节数组，由调用方负责写入 stdout
   */
  open func buildPatchBytes(): byte[] {
    let output = self.output;
    // 每次生成 patch 后消费本帧光标请求并清空输出缓冲区。
    defer {
      self.hasCursorPositionRequest = false;
      self.hasCursorVisibilityRequest = false;
      output.clear();
    }
    // 初始化一些局部变量
    let w = self.back.width;
    let h = self.back.height;
    let total = (int)((u64)w * (u64)h);
    let frontCells = self.front.cells;
    let backCells = self.back.cells;
    // 最终请求隐藏时先隐藏，避免可见光标跟随 diff 的中间定位移动。
    if self.hasCursorVisibilityRequest && !self.cursorRequestVisible {
      self.ensureTerminalCursorVisibility(false);
    }
    // 保持可见的已定位光标在 diff 期间临时隐藏，最终位置恢复后再显示。
    let restoreVisibleAfterDiff = self.hasCursorPositionRequest &&
      ((self.hasCursorVisibilityRequest && self.cursorRequestVisible) ||
      (!self.hasCursorVisibilityRequest &&
      self.physicalCursorVisibilityKnown && self.physicalCursorVisible));
    var hasCellDiff = false;
    // 逐 cell 比较并发射差异序列
    var i: int = 0;
    while i < total {
      let f = frontCells[i];
      let b = backCells[i];
      // 续占 Cell 由前面的多列码点一次性输出，不独立发射。
      // 其他 Cell 仅在值或样式变化时发射。
      if b.value != Cell.CONTINUATION &&
      (f.value != b.value || f.style != b.style) {
        if !hasCellDiff {
          if restoreVisibleAfterDiff {
            self.ensureTerminalCursorVisibility(false);
          }
          hasCellDiff = true;
        }
        // 计算此 cell 的 (x, y) 坐标
        let y = (u32)((u64)i / (u64)w);
        let x = (u32)((u64)i % (u64)w);
        // 光标定位：\x1b[y;xH（1-based）
        self.writeTerminalCursorPosition(x, y);
        // SGR 状态机：仅当 style 变化时发射 SGR 序列
        if self.currentSgr != b.style {
          self.writeSgr(b.style);
          self.currentSgr = b.style;
        }
        // 发射 Cell 中已编码的 UTF-8 字节
        self.writeCellValue(b.value);
      }
      i = i + (int)1;
    }
    // 终端打印后的最终列受 Cell 宽度和行尾行为影响，不继续猜测其坐标。
    if hasCellDiff {
      self.physicalCursorKnown = false;
    }
    // 渲染完成后重置 SGR（避免样式泄漏到后续终端输出）
    if self.currentSgr != (u64)0 {
      self.writeSgrReset();
      self.currentSgr = (u64)0;
    }
    // 在所有 diff 后应用本帧请求的通用终端光标位置。
    if self.hasCursorPositionRequest &&
    (!self.physicalCursorKnown ||
    self.physicalCursorX != self.cursorRequestX ||
    self.physicalCursorY != self.cursorRequestY) {
      self.writeTerminalCursorPosition(
        self.cursorRequestX, self.cursorRequestY);
      self.physicalCursorKnown = true;
      self.physicalCursorX = self.cursorRequestX;
      self.physicalCursorY = self.cursorRequestY;
    }
    // 显示请求必须在最终定位之后执行；二参数定位则恢复进入 diff 前的可见性。
    if self.hasCursorVisibilityRequest && self.cursorRequestVisible {
      self.ensureTerminalCursorVisibility(true);
    } else if restoreVisibleAfterDiff {
      self.ensureTerminalCursorVisibility(true);
    }
    // back → front 覆盖（memcpy，不交换指针）
    var j: int = 0;
    while j < total {
      frontCells[j].value = backCells[j].value;
      frontCells[j].style = backCells[j].style;
      j = j + (int)1;
    }
    return output.entries();
  }

  /**
   * 构建 diff 后的 ANSI 转义序列字符串，供测试使用。
   * 内部调用 buildPatchBytes() 后转换为 string 返回。
   * 生产路径应直接使用 buildPatchBytes() 以避免 string 中间转换。
   * @return ANSI 转义序列字符串
   */
  open func buildPatchString(): string {
    let bytes = self.buildPatchBytes();
    return string.fromUtf8Bytes(bytes);
  }

  /**
   * 清空 back/front buffer（将所有 Cell 重置为默认值），并重置 SGR 状态机。
   * 不发射任何 ANSI 序列——如需清屏序列请调用 clearScreen()，或调用 clear() 组合两者。
   * 下次 buildPatchBytes() 时清空区域会作为变化发送给终端。
   */
  open func clearBuffer() {
    self.back.clear();
    self.front.clear();
    self.currentSgr = (u64)0;
  }

  /**
   * 仅向 output 追加清屏 ANSI 序列（`\x1b[2J\x1b[H`），不清空 back/front 缓冲区。
   * 供 TuiApp.run() 启动时清空物理终端屏幕——保留应用已绘制内容供首帧 diff 输出,
   * 避免清屏的同时擦除用户已绘制的画面。
   * output 中的清屏序列会在下次 buildPatchBytes() 时与 diff 序列一同输出。
   */
  open func clearScreen() {
    let output = self.output;
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    output.add((byte)0x32); // '2'
    output.add((byte)0x4a); // 'J'
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    output.add((byte)0x48); // 'H'
    // 清屏和 Home 的实际结果可能受终端尺寸变化影响，由最终位置请求重新确认。
    self.physicalCursorKnown = false;
  }

  /** 请求在下一次 buildPatchBytes() 中隐藏终端光标。 */
  open func hideCursor(): void {
    self.hasCursorVisibilityRequest = true;
    self.cursorRequestVisible = false;
  }

  /** 请求在下一次 buildPatchBytes() 中显示终端光标。 */
  open func showCursor(): void {
    self.hasCursorVisibilityRequest = true;
    self.cursorRequestVisible = true;
  }

  /**
   * 请求在本帧 diff 末尾设置终端光标位置，不改变可见性。
   * 坐标必须落在当前 Screen 内；无效坐标返回 false 且保留已有请求。
   * 该方法只更新请求状态，ANSI 定位由 buildPatchBytes() 统一追加。
   * @param x Screen 的零基列坐标
   * @param y Screen 的零基行坐标
   * @return 坐标有效并已接受时返回 true
   */
  open func setCursorPosition(x: u32, y: u32): bool {
    if x >= self.back.width || y >= self.back.height {
      return false;
    }
    self.hasCursorPositionRequest = true;
    self.cursorRequestX = x;
    self.cursorRequestY = y;
    return true;
  }

  /**
   * 原子请求在本帧 diff 末尾设置终端光标位置和可见性。
   * 坐标必须落在当前 Screen 内；无效坐标返回 false 且不改变已有请求。
   * @param x Screen 的零基列坐标
   * @param y Screen 的零基行坐标
   * @param visible 最终终端光标是否可见
   * @return 坐标有效并已接受时返回 true
   */
  open func setCursorPosition(x: u32, y: u32, visible: bool): bool {
    if x >= self.back.width || y >= self.back.height {
      return false;
    }
    self.hasCursorPositionRequest = true;
    self.cursorRequestX = x;
    self.cursorRequestY = y;
    self.hasCursorVisibilityRequest = true;
    self.cursorRequestVisible = visible;
    return true;
  }

  /**
   * 设置终端鼠标指针形状。
   *
   * 使用 OSC 22 及当前终端对应的形状名称；Auto 释放应用控制并恢复终端自行选择的形状。
   * 相同值不会重复追加控制序列。不支持 OSC 22 的终端会静默忽略。
   * @param cursor - 要设置的鼠标指针形状
   */
  open func setPointerCursor(cursor: Cursor): void {
    if self.currentPointerCursor == cursor {
      return;
    }
    let output = self.output;
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5d); // ']'
    output.add((byte)0x32); // '2'
    output.add((byte)0x32); // '2'
    output.add((byte)0x3b); // ';'
    if cursor != Cursor.Auto {
      self.writePointerCursorName(cursor);
    }
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5c); // '\\'
    self.currentPointerCursor = cursor;
  }

  /**
   * 根据当前进程环境一次性选择 OSC 22 鼠标指针名称协议。
   *
   * iTerm2 通过 TERM_PROGRAM 暴露身份；原生 xterm 通过 XTERM_VERSION 暴露身份。
   * 其他终端默认使用 CSS 名称，未知终端可静默忽略不支持的 OSC 22 序列。
   * 该方法由 TuiApp.init() 调用，不应在渲染循环中重复调用。
   */
  open func detectPointerCursorProtocol(): void {
    let terminalProgram = Process.getEnv("TERM_PROGRAM");
    let detected = if terminalProgram == "iTerm.app" ||
      Process.hasEnv("XTERM_VERSION") {
      PointerCursorProtocol.X11
    } else {
      PointerCursorProtocol.Css
    };
    if self.pointerCursorProtocol != detected {
      self.pointerCursorProtocol = detected;
      // 协议变化后强制下一次同步重新编码，即使逻辑 Cursor 没有变化。
      self.currentPointerCursor = Cursor.Auto;
    }
  }

  /**
   * 清理 Buffer & Screen
   * 清空 back/front buffer，并向 output 追加清屏 ANSI 序列。
   */
  open func clear() {
    self.clearBuffer();
    self.clearScreen();
  }

  // ─── 内部方法（seal） ──────────────────────────────────────────────────────

  /**
   * 将 u32 数值以十进制 ASCII 形式追加到 output 缓冲区。
   * 零值输出单字符 '0'。
   * @param value - 要写入的数值
   */
  seal func writeDecimal(value: u32) {
    let output = self.output;
    if value == (u32)0 {
      output.add((byte)0x30); // '0'
      return;
    }
    // 临时缓冲区：u32 最大 10 位十进制
    var tmp: byte[!] = byte[:10];
    var n: int = 0;
    var v: u32 = value;
    while v != (u32)0 {
      tmp[n] = (byte)((u32)0x30 + (v % (u32)10));
      n = n + (int)1;
      v = v / (u32)10;
    }
    // 逆序写入
    var k: int = n - (int)1;
    while k >= (int)0 {
      output.add(tmp[k]);
      k = k - (int)1;
    }
  }

  /** 将零基 Screen 坐标编码为 ANSI 物理光标定位序列。 */
  seal func writeTerminalCursorPosition(x: u32, y: u32): void {
    let output = self.output;
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    self.writeDecimal(y + (u32)1);
    output.add((byte)0x3b); // ';'
    self.writeDecimal(x + (u32)1);
    output.add((byte)0x48); // 'H'
  }

  /** 按需编码终端光标可见性，并同步已知物理状态。 */
  seal func ensureTerminalCursorVisibility(visible: bool): void {
    if self.physicalCursorVisibilityKnown &&
    self.physicalCursorVisible == visible {
      return;
    }
    let output = self.output;
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    output.add((byte)0x3f); // '?'
    output.add((byte)0x32); // '2'
    output.add((byte)0x35); // '5'
    let command = if visible { (byte)0x68 } else { (byte)0x6c }; // 'h' / 'l'
    output.add(command);
    self.physicalCursorVisibilityKnown = true;
    self.physicalCursorVisible = visible;
  }

  /** 将 Cursor 按当前终端名称协议编码并追加到输出缓冲。 */
  seal func writePointerCursorName(cursor: Cursor): void {
    let name = if self.pointerCursorProtocol == PointerCursorProtocol.X11 {
      self.resolveX11PointerCursorName(cursor)
    } else {
      self.resolveCssPointerCursorName(cursor)
    };
    for var index: int = 0; index < name.length(); index += 1 {
      self.output.add(name.getByte(index));
    }
  }

  /** 将逻辑 Cursor 映射为 CSS cursor 名称。 */
  seal func resolveCssPointerCursorName(cursor: Cursor): string {
    let name = match cursor {
      Cursor.Alias { "alias" }
      Cursor.Cell { "cell" }
      Cursor.Copy { "copy" }
      Cursor.Crosshair { "crosshair" }
      Cursor.Default { "default" }
      Cursor.ResizeEast { "e-resize" }
      Cursor.ResizeEastWest { "ew-resize" }
      Cursor.Grab { "grab" }
      Cursor.Grabbing { "grabbing" }
      Cursor.Help { "help" }
      Cursor.Move { "move" }
      Cursor.ResizeNorth { "n-resize" }
      Cursor.ResizeNorthEast { "ne-resize" }
      Cursor.ResizeNorthEastSouthWest { "nesw-resize" }
      Cursor.NoDrop { "no-drop" }
      Cursor.NotAllowed { "not-allowed" }
      Cursor.ResizeNorthSouth { "ns-resize" }
      Cursor.ResizeNorthWest { "nw-resize" }
      Cursor.ResizeNorthWestSouthEast { "nwse-resize" }
      Cursor.Pointer { "pointer" }
      Cursor.Progress { "progress" }
      Cursor.ResizeSouth { "s-resize" }
      Cursor.ResizeSouthEast { "se-resize" }
      Cursor.ResizeSouthWest { "sw-resize" }
      Cursor.Text { "text" }
      Cursor.VerticalText { "vertical-text" }
      Cursor.ResizeWest { "w-resize" }
      Cursor.Wait { "wait" }
      Cursor.ZoomIn { "zoom-in" }
      Cursor.ZoomOut { "zoom-out" }
      else { "" }
    };
    return name;
  }

  /**
   * 将逻辑 Cursor 映射为 iTerm2/xterm 支持的 X11 cursor 名称。
   * X11 名称集合不能完整表达 CSS cursor；无法精确表达的成员退化为最接近的
   * hand、arrow、cross 或方向 resize 名称。
   */
  seal func resolveX11PointerCursorName(cursor: Cursor): string {
    return match cursor {
      Cursor.Alias { "hand1" }
      Cursor.Cell { "cross" }
      Cursor.Copy { "hand2" }
      Cursor.Crosshair { "crosshair" }
      Cursor.Default { "arrow" }
      Cursor.ResizeEast { "right_side" }
      Cursor.ResizeEastWest { "sb_h_double_arrow" }
      Cursor.Grab { "hand1" }
      Cursor.Grabbing { "hand2" }
      Cursor.Help { "hand1" }
      Cursor.Move { "cross" }
      Cursor.ResizeNorth { "based_arrow_up" }
      Cursor.ResizeNorthEast { "based_arrow_up" }
      Cursor.ResizeNorthEastSouthWest { "cross" }
      Cursor.NoDrop { "X_cursor" }
      Cursor.NotAllowed { "X_cursor" }
      Cursor.ResizeNorthSouth { "sb_v_double_arrow" }
      Cursor.ResizeNorthWest { "based_arrow_up" }
      Cursor.ResizeNorthWestSouthEast { "cross" }
      Cursor.Pointer { "hand2" }
      Cursor.Progress { "arrow" }
      Cursor.ResizeSouth { "based_arrow_down" }
      Cursor.ResizeSouthEast { "based_arrow_down" }
      Cursor.ResizeSouthWest { "based_arrow_down" }
      Cursor.Text { "xterm" }
      Cursor.VerticalText { "xterm" }
      Cursor.ResizeWest { "left_side" }
      Cursor.Wait { "arrow" }
      Cursor.ZoomIn { "crosshair" }
      Cursor.ZoomOut { "crosshair" }
      else { "" }
    };
  }

  /** 向输出缓冲追加完整 SGR 重置序列。 */
  seal func writeSgrReset(): void {
    let output = self.output;
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    output.add((byte)0x30); // '0'
    output.add((byte)0x6d); // 'm'
  }

  /**
   * 判断从当前完整样式切换到目标完整样式前是否必须重置。
   * 显式颜色可直接覆盖；颜色恢复默认值或任一样式标志被移除时必须重置。
   */
  seal func needsSgrReset(current: u64, target: u64): bool {
    let currentHasFg = (current & Cell.HAS_FG) != (u64)0;
    let targetHasFg = (target & Cell.HAS_FG) != (u64)0;
    if currentHasFg && !targetHasFg {
      return true;
    }
    let currentHasBg = (current & Cell.HAS_BG) != (u64)0;
    let targetHasBg = (target & Cell.HAS_BG) != (u64)0;
    if currentHasBg && !targetHasBg {
      return true;
    }
    let currentFlags = current & Cell.MASK_FLAGS;
    let targetFlags = target & Cell.MASK_FLAGS;
    return (currentFlags & targetFlags) != currentFlags;
  }

  /**
   * 根据 Cell 的 style 编码，将 SGR（Select Graphic Rendition）序列
   * 直接追加到 output 缓冲区。
   * 样式布局：[ 保留/存在标记/样式标志 ] [ 24 bits 背景RGB ] [ 24 bits 前景RGB ]
   * @param style - Cell 的样式编码
   */
  seal func writeSgr(style: u64) {
    let output = self.output;
    // 前景色（低 24 bits）
    let fg = (u32)(style & Cell.MASK_FG);
    // 背景色（中 24 bits）
    let bg = (u32)((style >> (u64)24) & Cell.MASK_FG);
    let hasFg = (style & Cell.HAS_FG) != (u64)0;
    let hasBg = (style & Cell.HAS_BG) != (u64)0;
    // 若前景、背景、样式标志全为零，发射 SGR 重置 \x1b[0m
    if !hasFg && !hasBg && (style & Cell.MASK_FLAGS) == (u64)0 {
      self.writeSgrReset();
      return;
    }
    // Cell style 是完整目标状态；先清除目标不再包含的终端状态。
    if self.needsSgrReset(self.currentSgr, style) {
      self.writeSgrReset();
    }
    output.add((byte)0x1b); // ESC
    output.add((byte)0x5b); // '['
    var first: bool = true;
    // 前景色：38;2;r;g;b
    if hasFg {
      if !first { output.add((byte)0x3b); } // ';'
      first = false;
      output.add((byte)0x33); // '3'
      output.add((byte)0x38); // '8'
      output.add((byte)0x3b); // ';'
      output.add((byte)0x32); // '2'
      output.add((byte)0x3b); // ';'
      self.writeDecimal((fg >> (u32)16) & (u32)0xFF);
      output.add((byte)0x3b); // ';'
      self.writeDecimal((fg >> (u32)8) & (u32)0xFF);
      output.add((byte)0x3b); // ';'
      self.writeDecimal(fg & (u32)0xFF);
    }
    // 背景色：48;2;r;g;b
    if hasBg {
      if !first { output.add((byte)0x3b); } // ';'
      first = false;
      output.add((byte)0x34); // '4'
      output.add((byte)0x38); // '8'
      output.add((byte)0x3b); // ';'
      output.add((byte)0x32); // '2'
      output.add((byte)0x3b); // ';'
      self.writeDecimal((bg >> (u32)16) & (u32)0xFF);
      output.add((byte)0x3b); // ';'
      self.writeDecimal((bg >> (u32)8) & (u32)0xFF);
      output.add((byte)0x3b); // ';'
      self.writeDecimal(bg & (u32)0xFF);
    }
    // 终端样式标志位（bits 48-55；颜色存在标记不属于终端样式）
    if (style & Cell.STYLE_BOLD) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x31); // '1'
    }
    if (style & Cell.STYLE_DIM) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x32); // '2'
    }
    if (style & Cell.STYLE_ITALIC) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x33); // '3'
    }
    if (style & Cell.STYLE_UNDERLINE) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x34); // '4'
    }
    if (style & Cell.STYLE_BLINK) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x35); // '5'
    }
    if (style & Cell.STYLE_REVERSE) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x37); // '7'
    }
    if (style & Cell.STYLE_HIDDEN) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x38); // '8'
    }
    if (style & Cell.STYLE_STRIKETHROUGH) != (u64)0 {
      if !first { output.add((byte)0x3b); }
      first = false;
      output.add((byte)0x39); // '9'
    }
    output.add((byte)0x6d); // 'm'
  }

  /**
   * 将 Cell.value 中低位优先的 UTF-8 字节直接追加到 output 缓冲区。
   * 值 0 渲染为空格；grapheme 拆分已经由 Text、Input 等上层完成。
   * @param value - 已编码 Cell 值
   */
  seal func writeCellValue(value: u64) {
    let output = self.output;
    if value == (u64)0 {
      output.add((byte)0x20);
      return;
    }
    var remaining = value;
    while remaining != (u64)0 {
      output.add((byte)(remaining & (u64)0xFF));
      remaining >>= (u64)8;
    }
  }
}
