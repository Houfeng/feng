open module std.tui.screen;

import std;
import std.tui.common;

// ─── extern 函数声明（用于 draw 码点解码） ──────────────────────────────

/** libunistring: 解码下一个 UTF-8 码点，返回指向下一个码点起点的指针 */
@cdecl("feng_std_unistring", "u8_next")
extern func u8_next(puc: u32*, s: string*): string*;

/** runtime: 判断指针是否为空 */
extern func feng_pointer_is_null(ptr: string*): bool;

/**
 * Buffer 表示终端用户界面（TUI）中的矩形 Cell 矩阵。
 *
 * 拥有固定大小的 `Cell[]` 矩阵，行主序布局（`cells[y * width + x]`）。
 * 数组本身为只读 `Cell[]`，但 Cell 是 `@value` 类型，
 * 通过直接字段赋值（如 `buffer.cells[idx].value = 65`）可就地修改元素。
 *
 * Buffer 尺寸创建后不可变。终端尺寸调整由上层（Screen）重新创建新实例处理。
 */
open type Buffer {

  /** 矩阵列数（创建后不可变） */
  let width: u32;

  /** 矩阵行数（创建后不可变） */
  let height: u32;

  /** Cell 矩阵，行主序布局，长度为 width * height */
  let cells: Cell[];

  // ─── 构造函数 ─────────────────────────────────────────────────────────────

  /**
   * 构造函数：创建指定尺寸的 Buffer，所有 Cell 初始化为默认值（value=0, style=0）。
   * @param width - 矩阵列数
   * @param height - 矩阵行数
   */
  func Buffer(width: u32, height: u32) {
    self.width = width;
    self.height = height;
    let count = (int)((u64)width * (u64)height);
    self.cells = Cell[: count];
  }

  // ─── 内部方法（seal） ──────────────────────────────────────────────────────

  /**
   * 将 Style 枚举值映射为 Cell 的 STYLE_* 位值。
   * @param s - Style 枚举值
   * @return 对应的 u64 位值
   */
  seal func styleToBits(s: CellStyle): u64 {
    return match s {
      CellStyle.None { (u64)0; }
      CellStyle.Bold { Cell.STYLE_BOLD; }
      CellStyle.Dim { Cell.STYLE_DIM; }
      CellStyle.Italic { Cell.STYLE_ITALIC; }
      CellStyle.Underline { Cell.STYLE_UNDERLINE; }
      CellStyle.Blink { Cell.STYLE_BLINK; }
      CellStyle.Reverse { Cell.STYLE_REVERSE; }
      CellStyle.Hidden { Cell.STYLE_HIDDEN; }
      CellStyle.Strikethrough { Cell.STYLE_STRIKETHROUGH; }
      else { (u64)0; }
    };
  }

  /**
   * 将多个 Style 组合为单个 u64 样式编码（按位或）。
   * @param styles - Style 数组
   * @return 组合后的 u64 样式编码
   */
  seal func combineStyles(styles: CellStyle[]): u64 {
    var result: u64 = 0;
    for let s in styles {
      result |= self.styleToBits(s);
    }
    return result;
  }

  /**
   * 将前景色、背景色和样式数组打包为完整的 u64 样式编码。
   * none 的颜色不写入对应位段，表示终端默认色；alpha 为 0 的颜色位段
   * 由 drawCell 从目标 Cell 保留，本方法只打包非透明颜色。
   * @param fg - 前景色（none 表示终端默认前景色）
   * @param bg - 背景色（none 表示终端默认背景色）
   * @param styles - 样式数组
   * @return 完整的 u64 样式编码
   */
  seal func packStyle(fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle[]): u64 {
    var s = self.combineStyles(styles);
    if fg match let c: RgbColor {
      if c.a != 0 {
        s |= ((u64)c.r << (u64)16) | ((u64)c.g << (u64)8) |
          (u64)c.b | Cell.HAS_FG;
      }
    }
    if bg match let c: RgbColor {
      if c.a != 0 {
        s |= (((u64)c.r << (u64)16) | ((u64)c.g << (u64)8) |
          (u64)c.b) << (u64)24 | Cell.HAS_BG;
      }
    }
    return s;
  }

  /**
   * 返回绘制时需要从目标 Cell 保留的颜色位段。
   * none 表示终端默认色，不保留目标颜色；只有 alpha 为 0 的显式颜色表示透明。
   */
  seal func resolvePreserveMask(fg: Option<RgbColor>, bg: Option<RgbColor>): u64 {
    var mask: u64 = 0;
    if fg match let color: RgbColor {
      if color.a == 0 {
        mask |= Cell.MASK_FG | Cell.HAS_FG;
      }
    }
    if bg match let color: RgbColor {
      if color.a == 0 {
        mask |= Cell.MASK_BG | Cell.HAS_BG;
      }
    }
    return mask;
  }

  /**
   * 清除覆盖 index 的完整码点占用关系。
   * 字符值、前景色和字符样式被清除，已有背景色保留。
   */
  seal func clearGlyphAt(index: int, rowStart: int, rowEnd: int): void {
    var start = index;
    while start > rowStart && self.cells[start].value == Cell.CONTINUATION {
      start -= 1;
    }
    var end = start + 1;
    while end < rowEnd {
      if self.cells[end].value != Cell.CONTINUATION {
        break;
      }
      end += 1;
    }
    var current = start;
    while current < end {
      self.cells[current].value = (u64)0;
      self.cells[current].style &= Cell.MASK_BG | Cell.HAS_BG;
      current += 1;
    }
  }

  /**
   * 写入一个已确定显示列宽的 Cell，并为后续列写入续占标记。
   * 写入前会完整清除与目标列重叠的旧码点占用关系。
   * @param x - 起始列坐标
   * @param y - 行坐标
   * @param cell - 主 Cell 的字符和样式
   * @param width - 字符占用的显示列数
   * @param preserveMask - 从目标 Cell 保留的颜色位段
   */
  seal func drawCell(x: u32, y: u32, cell: Cell,
    width: u32, preserveMask: u64): void {
    if width == 0 || x >= self.width || y >= self.height ||
    (u64)x + (u64)width > (u64)self.width ||
    cell.value == Cell.CONTINUATION {
      return;
    }
    let rowStart = (int)((u64)y * (u64)self.width);
    let rowEnd = rowStart + (int)self.width;
    let start = rowStart + (int)x;
    let end = start + (int)width;
    var resolvedStyle = cell.style;
    if preserveMask != 0 {
      resolvedStyle |= self.cells[start].style & preserveMask;
    }
    var current = start;
    while current < end {
      self.clearGlyphAt(current, rowStart, rowEnd);
      current += 1;
    }
    self.cells[start].value = cell.value;
    self.cells[start].style = resolvedStyle;
    current = start + 1;
    while current < end {
      self.cells[current].value = Cell.CONTINUATION;
      self.cells[current].style = resolvedStyle;
      current += 1;
    }
  }

  // ─── draw 数组版本（seal，内部实现 + fill 转发用） ─────────────────────────

  /**
   * 在 (x, y) 处绘制文本，按每个码点的显示列宽写入 Cell。
   * 使用 u8_next 直接解码 UTF-8 码点，零字符串分配。
   * 超出右边界的内容被裁剪。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle[]): void {
    let s = self.packStyle(fg, bg, styles);
    let preserveMask = self.resolvePreserveMask(fg, bg);
    if y >= self.height {
      return;
    }
    let data: string* = &text;
    var cursor: string* = data;
    var uc: u32 = 0;
    var col: u32 = x;
    while true {
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        break;
      }
      let cellWidth = (u32)TextUtil.measureCellWidth(uc);
      if (u64)col + (u64)cellWidth > (u64)self.width {
        break;
      }
      self.drawCell(col, y, Cell((u64)uc, s), cellWidth, preserveMask);
      col += cellWidth;
      cursor = next;
    }
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，自动换行。
   * 文本按码点显示列宽填充，每行 w 列，超过 h 行后裁剪。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle[]): void {
    let s = self.packStyle(fg, bg, styles);
    let preserveMask = self.resolvePreserveMask(fg, bg);
    if x >= self.width || y >= self.height || w == 0 || h == 0 {
      return;
    }
    var rowWidth = w;
    if (u64)x + (u64)rowWidth > (u64)self.width {
      rowWidth = self.width - x;
    }
    let data: string* = &text;
    var cursor: string* = data;
    var row: u32 = 0;
    var col: u32 = 0;
    while row < h && y + row < self.height {
      var uc: u32 = 0;
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        return;
      }
      let cellWidth = (u32)TextUtil.measureCellWidth(uc);
      if cellWidth > rowWidth {
        cursor = next;
        continue;
      }
      if (u64)col + (u64)cellWidth > (u64)rowWidth {
        row += (u32)1;
        col = 0;
        continue;
      }
      self.drawCell(x + col, y + row, Cell((u64)uc, s), cellWidth, preserveMask);
      col += cellWidth;
      cursor = next;
    }
  }

  /**
   * 在 (x, y) 处绘制单个码点。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle[]): void {
    let s = self.packStyle(fg, bg, styles);
    let preserveMask = self.resolvePreserveMask(fg, bg);
    let cellWidth = (u32)TextUtil.measureCellWidth((u32)value);
    self.drawCell(x, y, Cell(value, s), cellWidth, preserveMask);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle[]): void {
    let s = self.packStyle(fg, bg, styles);
    let preserveMask = self.resolvePreserveMask(fg, bg);
    let cellWidth = (u32)TextUtil.measureCellWidth((u32)value);
    var row: u32 = 0;
    while row < h {
      let cy = y + row;
      if cy >= self.height {
        break;
      }
      var col: u32 = 0;
      while (u64)col + (u64)cellWidth <= (u64)w {
        let cx = x + col;
        if (u64)cx + (u64)cellWidth > (u64)self.width {
          break;
        }
        self.drawCell(cx, cy, Cell(value, s), cellWidth, preserveMask);
        col += cellWidth;
      }
      row += (u32)1;
    }
  }

  // ─── draw 变长参数版本 — 无颜色（open，公开 API） ──────────────────────────

  /**
   * 在 (x, y) 处绘制文本，使用终端默认前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, text: string, styles: CellStyle...): void {
    self.draw(x, y, text, none, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，使用终端默认颜色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, text: string, styles: CellStyle...): void {
    self.draw(x, y, w, h, text, none, none, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，使用终端默认颜色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, value: u64, styles: CellStyle...): void {
    self.draw(x, y, value, none, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，使用终端默认颜色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, value: u64, styles: CellStyle...): void {
    self.draw(x, y, w, h, value, none, none, styles);
  }

  // ─── draw 变长参数版本 — 带前景色（open，公开 API） ────────────────────────

  /**
   * 在 (x, y) 处绘制文本，指定前景色，背景色使用终端默认。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, text: string, fg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, text, fg, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，指定前景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, w, h, text, fg, none, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，指定前景色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, value: u64, fg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, value, fg, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，指定前景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, w, h, value, fg, none, styles);
  }

  // ─── draw 变长参数版本 — 带前景色及背景色（open，公开 API） ──────────────

  /**
   * 在 (x, y) 处绘制文本，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  open func draw(x: u32, y: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, text, fg, bg, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  open func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, w, h, text, fg, bg, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，指定前景色和背景色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  open func draw(x: u32, y: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, value, fg, bg, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  open func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: CellStyle...): void {
    self.draw(x, y, w, h, value, fg, bg, styles);
  }

  // ─── 便利方法 ─────────────────────────────────────────────────────────────

  /**
   * 用指定的码点、前景色、背景色和样式填充整个矩阵。
   * 等价于 draw(0, 0, width, height, value, fg, bg, styles)。
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func fill(value: u64, fg: RgbColor, bg: RgbColor, styles: CellStyle...): void {
    self.draw((u32)0, (u32)0, self.width, self.height, value, fg, bg, styles);
  }

  /**
   * 用指定的码点填充整个矩阵，使用终端默认颜色。
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func fill(value: u64, styles: CellStyle...): void {
    self.draw((u32)0, (u32)0, self.width, self.height, value, none, none, styles);
  }

  /**
   * 清空整个矩阵，将所有 Cell 重置为默认值（value=0, style=0）。
   */
  func clear(): void {
    self.fill((u64)0);
  }
}
