open module std.tui.screen;

import std;

// ─── extern 函数声明（用于 draw 码点解码） ──────────────────────────────

/** libunistring: 解码下一个 UTF-8 码点，返回指向下一个码点起点的指针 */
@cdecl("feng_std_unistring", "u8_next")
extern func u8_next(puc: u32*, s: string*): string*;

/** runtime: 判断指针是否为空 */
extern func feng_pointer_is_null(ptr: string*): bool;

/**
 * Buffer 表示终端用户界面（TUI）中的矩形 Cell 矩阵。
 *
 * 拥有固定大小的 `Cell[]` 矩阵，行主序布局（`cells[y * width + x]`）。
 * 数组本身为只读 `Cell[]`，但 Cell 是 `@value` 类型，
 * 通过直接字段赋值（如 `buffer.cells[idx].value = 65`）可就地修改元素。
 *
 * Buffer 尺寸创建后不可变。终端尺寸调整由上层（Screen）重新创建新实例处理。
 */
open type Buffer {

  /** 矩阵列数（创建后不可变） */
  let width: u32;

  /** 矩阵行数（创建后不可变） */
  let height: u32;

  /** Cell 矩阵，行主序布局，长度为 width * height */
  let cells: Cell[];

  // ─── 构造函数 ─────────────────────────────────────────────────────────────

  /**
   * 构造函数：创建指定尺寸的 Buffer，所有 Cell 初始化为默认值（value=0, style=0）。
   * @param width - 矩阵列数
   * @param height - 矩阵行数
   */
  func Buffer(width: u32, height: u32) {
    self.width = width;
    self.height = height;
    let count = (int)((u64)width * (u64)height);
    self.cells = Cell[: count];
  }

  // ─── 内部方法（seal） ──────────────────────────────────────────────────────

  /**
   * 将 Style 枚举值映射为 Cell 的 STYLE_* 位值。
   * @param s - Style 枚举值
   * @return 对应的 u64 位值
   */
  seal func styleToBits(s: Style): u64 {
    return match s {
      Style.none { (u64)0; }
      Style.bold { Cell.STYLE_BOLD; }
      Style.dim { Cell.STYLE_DIM; }
      Style.italic { Cell.STYLE_ITALIC; }
      Style.underline { Cell.STYLE_UNDERLINE; }
      Style.blink { Cell.STYLE_BLINK; }
      Style.reverse { Cell.STYLE_REVERSE; }
      Style.hidden { Cell.STYLE_HIDDEN; }
      Style.strikethrough { Cell.STYLE_STRIKETHROUGH; }
      else { (u64)0; }
    };
  }

  /**
   * 将多个 Style 组合为单个 u64 样式编码（按位或）。
   * @param styles - Style 数组
   * @return 组合后的 u64 样式编码
   */
  seal func combineStyles(styles: Style[]): u64 {
    var result: u64 = 0;
    for let s in styles {
      result |= self.styleToBits(s);
    }
    return result;
  }

  /**
   * 将前景色、背景色和样式数组打包为完整的 u64 样式编码。
   * none 的颜色不写入对应位段，表示终端默认色。
   * @param fg - 前景色（none 表示终端默认前景色）
   * @param bg - 背景色（none 表示终端默认背景色）
   * @param styles - 样式数组
   * @return 完整的 u64 样式编码
   */
  seal func packStyle(fg: Option<RgbColor>, bg: Option<RgbColor>, styles: Style[]): u64 {
    var s = self.combineStyles(styles);
    if fg match let c: RgbColor {
      s |= ((u64)c.r << (u64)16) | ((u64)c.g << (u64)8) | (u64)c.b;
    }
    if bg match let c: RgbColor {
      s |= (((u64)c.r << (u64)16) | ((u64)c.g << (u64)8) | (u64)c.b) << (u64)24;
    }
    return s;
  }

  // ─── draw 数组版本（seal，内部实现 + fill 转发用） ─────────────────────────

  /**
   * 在 (x, y) 处绘制文本，逐码点写入连续 Cell。
   * 使用 u8_next 直接解码 UTF-8 码点，零字符串分配。
   * 超出右边界的内容被裁剪。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: Style[]): void {
    let s = self.packStyle(fg, bg, styles);
    if y >= self.height {
      return;
    }
    let data: string* = &text;
    var cursor: string* = data;
    var uc: u32 = 0;
    var col: u32 = x;
    while true {
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        break;
      }
      if col >= self.width {
        break;
      }
      let idx = (int)((u64)y * (u64)self.width + (u64)col);
      self.cells[idx].value = (u64)uc;
      self.cells[idx].style = s;
      col += (u32)1;
      cursor = next;
    }
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，自动换行。
   * 文本逐码点填充，每行 w 列，超过 h 行后裁剪。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: Style[]): void {
    let s = self.packStyle(fg, bg, styles);
    let data: string* = &text;
    var cursor: string* = data;
    var uc: u32 = 0;
    var row: u32 = 0;
    while row < h {
      let cy = y + row;
      if cy >= self.height {
        break;
      }
      var col: u32 = 0;
      while col < w {
        let cx = x + col;
        if cx >= self.width {
          break;
        }
        let next: string* = u8_next(&uc, cursor);
        if feng_pointer_is_null(next) {
          return;
        }
        let idx = (int)((u64)cy * (u64)self.width + (u64)cx);
        self.cells[idx].value = (u64)uc;
        self.cells[idx].style = s;
        col += (u32)1;
        cursor = next;
      }
      row += (u32)1;
    }
  }

  /**
   * 在 (x, y) 处绘制单个码点。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: Style[]): void {
    let s = self.packStyle(fg, bg, styles);
    if x >= self.width || y >= self.height {
      return;
    }
    let idx = (int)((u64)y * (u64)self.width + (u64)x);
    self.cells[idx].value = value;
    self.cells[idx].style = s;
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色（none 表示终端默认）
   * @param bg - 背景色（none 表示终端默认）
   * @param styles - 样式数组
   */
  seal func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: Option<RgbColor>, bg: Option<RgbColor>, styles: Style[]): void {
    let s = self.packStyle(fg, bg, styles);
    var row: u32 = 0;
    while row < h {
      let cy = y + row;
      if cy >= self.height {
        break;
      }
      var col: u32 = 0;
      while col < w {
        let cx = x + col;
        if cx >= self.width {
          break;
        }
        let idx = (int)((u64)cy * (u64)self.width + (u64)cx);
        self.cells[idx].value = value;
        self.cells[idx].style = s;
        col += (u32)1;
      }
      row += (u32)1;
    }
  }

  // ─── draw 变长参数版本 — 无颜色（open，公开 API） ──────────────────────────

  /**
   * 在 (x, y) 处绘制文本，使用终端默认前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, text: string, styles: Style...): void {
    self.draw(x, y, text, none, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，使用终端默认颜色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, text: string, styles: Style...): void {
    self.draw(x, y, w, h, text, none, none, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，使用终端默认颜色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, value: u64, styles: Style...): void {
    self.draw(x, y, value, none, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，使用终端默认颜色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, value: u64, styles: Style...): void {
    self.draw(x, y, w, h, value, none, none, styles);
  }

  // ─── draw 变长参数版本 — 带前景色（open，公开 API） ────────────────────────

  /**
   * 在 (x, y) 处绘制文本，指定前景色，背景色使用终端默认。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, text: string, fg: RgbColor, styles: Style...): void {
    self.draw(x, y, text, fg, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，指定前景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: RgbColor, styles: Style...): void {
    self.draw(x, y, w, h, text, fg, none, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，指定前景色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, value: u64, fg: RgbColor, styles: Style...): void {
    self.draw(x, y, value, fg, none, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，指定前景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: RgbColor, styles: Style...): void {
    self.draw(x, y, w, h, value, fg, none, styles);
  }

  // ─── draw 变长参数版本 — 带前景色及背景色（open，公开 API） ──────────────

  /**
   * 在 (x, y) 处绘制文本，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, text: string, fg: RgbColor, bg: RgbColor, styles: Style...): void {
    self.draw(x, y, text, fg, bg, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内绘制文本，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param text - 要绘制的文本
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, text: string, fg: RgbColor, bg: RgbColor, styles: Style...): void {
    self.draw(x, y, w, h, text, fg, bg, styles);
  }

  /**
   * 在 (x, y) 处绘制单个码点，指定前景色和背景色。
   * @param x - 列坐标（0-based）
   * @param y - 行坐标（0-based）
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, value: u64, fg: RgbColor, bg: RgbColor, styles: Style...): void {
    self.draw(x, y, value, fg, bg, styles);
  }

  /**
   * 在 (x, y, w, h) 矩形区域内填充码点，指定前景色和背景色。
   * @param x - 起始列坐标（0-based）
   * @param y - 起始行坐标（0-based）
   * @param w - 矩形宽度
   * @param h - 矩形高度
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func draw(x: u32, y: u32, w: u32, h: u32, value: u64, fg: RgbColor, bg: RgbColor, styles: Style...): void {
    self.draw(x, y, w, h, value, fg, bg, styles);
  }

  // ─── 便利方法 ─────────────────────────────────────────────────────────────

  /**
   * 用指定的码点、前景色、背景色和样式填充整个矩阵。
   * 等价于 draw(0, 0, width, height, value, fg, bg, styles)。
   * @param value - Unicode 码点
   * @param fg - 前景色
   * @param bg - 背景色
   * @param styles - 样式变长参数
   */
  func fill(value: u64, fg: RgbColor, bg: RgbColor, styles: Style...): void {
    self.draw((u32)0, (u32)0, self.width, self.height, value, fg, bg, styles);
  }

  /**
   * 用指定的码点填充整个矩阵，使用终端默认颜色。
   * @param value - Unicode 码点
   * @param styles - 样式变长参数
   */
  func fill(value: u64, styles: Style...): void {
    self.draw((u32)0, (u32)0, self.width, self.height, value, none, none, styles);
  }

  /**
   * 清空整个矩阵，将所有 Cell 重置为默认值（value=0, style=0）。
   */
  func clear(): void {
    self.fill((u64)0);
  }
}
