open module std.tui.screen;

import std.text;

/** libc：根据进程环境选择字符分类 locale。 */
@cdecl("libc", "setlocale")
extern func text_util_setlocale(category: i32, locale: string*): string*;

/** libc：返回 Unicode 码点在当前 locale 中占用的终端列数。 */
@cdecl("libc", "wcwidth")
extern func text_util_wcwidth(value: i32): i32;

/** libunistring：解码下一个 UTF-8 码点。 */
@cdecl("feng_std_unistring", "u8_next")
extern func text_util_u8_next(puc: u32*, s: string*): string*;

/** libunistring：返回当前 extended grapheme cluster 之后的位置。 */
@cdecl("feng_std_unistring", "u8_grapheme_next")
extern func text_util_u8_grapheme_next(s: string*, end: string*): string*;

/** runtime：按字节偏移移动字符串数据指针。 */
@runtime
extern func feng_pointer_move(ptr: string*, offset: int): string*;

/** runtime：判断两个字符串数据指针是否相等。 */
@runtime
extern func feng_pointer_equal(left: string*, right: string*): bool;

/**
 * TextUtil 集中提供终端文本所需的初始化和显示列宽测量。
 *
 * `init()` 应在应用启动阶段调用一次。TuiApp 会自动调用；
 * 直接使用 Buffer/Screen 的调用方需自行调用。
 */
open type TextUtil {

  /** 一个 Cell.value 能够内联保存的 UTF-8 字节数。 */
  open static let MAX_CELL_BYTES: int = 8;

  /** POSIX LC_CTYPE 分类常量。 */
  seal static let LC_CTYPE: i32 = 0;

  /**
   * 按当前进程环境初始化 Unicode 字符分类 locale。
   * 该方法不由测量热路径隐式调用。
   * @throws "tui/text/locale-init-failed" - 当前环境的 locale 无法启用
   */
  open static func init(): void {
    let environment = "";
    let selected = text_util_setlocale(TextUtil.LC_CTYPE, &environment);
    if feng_pointer_is_null(selected) {
      throw "tui/text/locale-init-failed";
    }
  }

  /** 返回一个 Unicode 码点占用的终端显示列数。 */
  open static func measureCellWidth(value: u32): int {
    let width = text_util_wcwidth((i32)value);
    if width < 0 {
      return 1;
    }
    return (int)width;
  }

  /** 返回只含一个 Unicode 码点的 UTF-8 字符串的原始终端列宽。 */
  open static func measureRuneWidth(value: string): int {
    let data: string* = &value;
    var codepoint: u32 = 0;
    let next = text_util_u8_next(&codepoint, data);
    if feng_pointer_is_null(next) {
      return 0;
    }
    return TextUtil.measureCellWidth(codepoint);
  }

  /**
   * 将一个非空 grapheme 内各码点的宽度归并为终端 Cell 宽度。
   * 终端 grapheme 至少占一列、最多占两列。
   */
  open static func resolveCellWidth(width: int): int {
    if width < 1 {
      return 1;
    }
    if width > 2 {
      return 2;
    }
    return width;
  }

  /** 返回 UTF-8 文本按 extended grapheme cluster 占用的显示列数。 */
  open static func measureCellWidth(value: string): int {
    let data: string* = &value;
    let end = feng_pointer_move(data, value.length());
    var graphemeStart = data;
    var result = 0;
    while !feng_pointer_equal(graphemeStart, end) {
      let graphemeEnd = text_util_u8_grapheme_next(graphemeStart, end);
      if feng_pointer_is_null(graphemeEnd) {
        return result;
      }
      var cursor = graphemeStart;
      var width = 0;
      while !feng_pointer_equal(cursor, graphemeEnd) {
        var codepoint: u32 = 0;
        let next = text_util_u8_next(&codepoint, cursor);
        if feng_pointer_is_null(next) {
          return result;
        }
        width += TextUtil.measureCellWidth(codepoint);
        cursor = next;
      }
      result += TextUtil.resolveCellWidth(width);
      graphemeStart = graphemeEnd;
    }
    return result;
  }

  /** 将一个 Unicode 码点编码为低位优先的 UTF-8 Cell 值。 */
  open static func encodeCellValue(value: u32): u64 {
    if value < (u32)0x80 {
      return (u64)value;
    }
    if value < (u32)0x800 {
      return (u64)((u32)0xC0 | (value >> (u32)6)) |
        ((u64)((u32)0x80 | (value & (u32)0x3F)) << (u64)8);
    }
    if value < (u32)0x10000 {
      return (u64)((u32)0xE0 | (value >> (u32)12)) |
        ((u64)((u32)0x80 | ((value >> (u32)6) & (u32)0x3F)) << (u64)8) |
        ((u64)((u32)0x80 | (value & (u32)0x3F)) << (u64)16);
    }
    return (u64)((u32)0xF0 | (value >> (u32)18)) |
      ((u64)((u32)0x80 | ((value >> (u32)12) & (u32)0x3F)) << (u64)8) |
      ((u64)((u32)0x80 | ((value >> (u32)6) & (u32)0x3F)) << (u64)16) |
      ((u64)((u32)0x80 | (value & (u32)0x3F)) << (u64)24);
  }

  /**
   * 将一个不超过 8 字节的 UTF-8 片段编码为 Cell 值。
   * @throws "tui/text/cell-value-overflow" - 输入超过 8 个 UTF-8 字节
   */
  open static func encodeCellValue(value: string): u64 {
    if value.length() > TextUtil.MAX_CELL_BYTES {
      throw "tui/text/cell-value-overflow";
    }
    let data: string* = &value;
    var cursor = data;
    var result: u64 = 0;
    while true {
      var codepoint: u32 = 0;
      let next = text_util_u8_next(&codepoint, cursor);
      if feng_pointer_is_null(next) {
        return result;
      }
      result = TextUtil.appendCellValue(result, codepoint);
      cursor = next;
    }
    return result;
  }

  /** 返回已编码 Cell 值中使用的 UTF-8 字节数。 */
  open static func cellValueByteLength(value: u64): int {
    var remaining = value;
    var length = 0;
    while remaining != (u64)0 {
      length += 1;
      remaining >>= (u64)8;
    }
    return length;
  }

  /**
   * 将一个码点追加到尚未填满的 Cell 值。
   * @throws "tui/text/cell-value-overflow" - 追加后超过 8 个 UTF-8 字节
   */
  open static func appendCellValue(current: u64, value: u32): u64 {
    let encoded = TextUtil.encodeCellValue(value);
    let currentLength = TextUtil.cellValueByteLength(current);
    let encodedLength = TextUtil.cellValueByteLength(encoded);
    if currentLength + encodedLength > TextUtil.MAX_CELL_BYTES {
      throw "tui/text/cell-value-overflow";
    }
    return current | (encoded << (u64)(currentLength * 8));
  }

  /** 返回一个已编码 Cell 值占用的终端显示列数。 */
  open static func measureCellValueWidth(value: u64): int {
    if value == (u64)0 {
      return 1;
    }
    var remaining = value;
    var width = 0;
    while remaining != (u64)0 {
      let first = (u32)(remaining & (u64)0xFF);
      var codepoint: u32 = first;
      var length = 1;
      if (first & (u32)0xE0) == (u32)0xC0 {
        codepoint = first & (u32)0x1F;
        length = 2;
      } else if (first & (u32)0xF0) == (u32)0xE0 {
        codepoint = first & (u32)0x0F;
        length = 3;
      } else if (first & (u32)0xF8) == (u32)0xF0 {
        codepoint = first & (u32)0x07;
        length = 4;
      }
      var index = 1;
      while index < length {
        let next = (u32)((remaining >> (u64)(index * 8)) & (u64)0xFF);
        codepoint = (codepoint << (u32)6) | (next & (u32)0x3F);
        index += 1;
      }
      width += TextUtil.measureCellWidth(codepoint);
      remaining >>= (u64)(length * 8);
    }
    return TextUtil.resolveCellWidth(width);
  }
}
