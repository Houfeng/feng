open module std.tui.views;

import std;
import std.tui;

open type View: Widget {
  /**
   * 用户声明的布局与样式约束
   */
  let style: WidgetStyle;

  /**
   * 布局阶段计算后的最终区域信息
   */
  let frame: WidgetFrame;

  /**
   * 父组件；仅由组件树 API 维护
   */
  var parent: Option<ContainerWidget>;

  /**
   * 键盘事件回调
   */
  var onKey: Action<KeyEvent>;

  /**
   * 鼠标按下事件回调
   */
  var onMouseDown: Action<MouseEvent>;

  /**
   * 鼠标移动事件回调
   */
  var onMouseMove: Action<MouseEvent>;

  /**
   * 鼠标释放事件回调
   */
  var onMouseUp: Action<MouseEvent>;

  /**
   * 鼠标滚轮事件回调
   */
  var onWheel: Action<MouseEvent>;

  /**
   * 对齐并计算当前组件的 frame
   * 容器组件自行决定是否及如何布局子组件
   */
  @mixable
  static func arrange(widget: Widget, manager: ViewManager): void {
  }

  /**
   * 绘制当前组件；绘制阶段只使用 frame，不重新解释 style
   * 需要组件将自身添加到 ViewManager 的 sequence 中，保证绘制顺序正确
   */
  @mixable
  static func draw(widget: Widget, manager: ViewManager): void {
    manager.trace(widget);
  }

  /**
   * 检查当前组件是否为指定组件的祖先
   * 使用循环沿 parent 链向上查找，不使用递归
   */
  @mixable
  static func isAncestor(widget: Widget, w: Widget): bool {
    // var current: Option<ContainerWidget> = w.parent;
    // while current match let parent: ContainerWidget {
    //   if widget == parent {
    //     return true;
    //   }
    //   current = parent.parent;
    // }
    // return false;
  }
}
