open module std.time;

import std.text;
import std.numeric;

// External binding: get current time (seconds + microseconds since 1970)
@cdecl("feng_std_uv", "uv_gettimeofday")
extern func uv_gettimeofday(tv: i64*): i32;

/**
 * Left-pads an integer with zeros to the specified width.
 */
seal func padZero(value: i32, width: int): string {
  let s = value.toString();
  return s.padStart(width, "0");
}

/**
 * Returns whether the given year is a leap year.
 */
seal func isLeapYearValue(y: i32): bool {
  if y % 4 != 0 {
    return false;
  }
  if y % 100 != 0 {
    return true;
  }
  if y % 400 != 0 {
    return false;
  }
  return true;
}

/**
 * Returns the number of days in the given month (1-12) for the given year.
 */
seal func daysInMonthValue(year: i32, month: i32): i32 {
  if month == 2 {
    if isLeapYearValue(year) {
      return 29;
    }
    return 28;
  }
  if month == 4 || month == 6 || month == 9 || month == 11 {
    return 30;
  }
  return 31;
}

/**
 * Converts seconds since 1970-01-01 00:00:00 to date/time components.
 * out[0]=year, out[1]=month, out[2]=day, out[3]=hour, out[4]=minute, out[5]=second
 */
seal func secondsToComponents(totalSeconds: i64, out: i32[!]) {
  let secPerDay: i64 = (i64)86400;
  var days: i64 = totalSeconds / secPerDay;
  var timeOfDay: i64 = totalSeconds - days * secPerDay;
  if timeOfDay < (i64)0 {
    timeOfDay = timeOfDay + secPerDay;
    days = days - (i64)1;
  }

  let hour = (i32)(timeOfDay / (i64)3600);
  let minuteSec = timeOfDay - (i64)hour * (i64)3600;
  let minute = (i32)(minuteSec / (i64)60);
  let second = (i32)(minuteSec - (i64)minute * (i64)60);

  // Civil from days (Howard Hinnant algorithm)
  let z = days + (i64)719468;
  let era: i64 = if z >= (i64)0 {
    z / (i64)146097;
  } else {
    (z - (i64)146096) / (i64)146097;
  };
  let doe: i64 = z - era * (i64)146097;
  let yoe: i64 = (doe - doe / (i64)1460 + doe / (i64)36524 - doe / (i64)146096) / (i64)365;
  let y: i64 = yoe + era * (i64)400;
  let doy: i64 = doe - ((i64)365 * yoe + yoe / (i64)4 - yoe / (i64)100);
  let mp: i64 = ((i64)5 * doy + (i64)2) / (i64)153;
  let day: i64 = doy - ((i64)153 * mp + (i64)2) / (i64)5 + (i64)1;
  let month: i64 = if mp < (i64)10 {
    mp + (i64)3;
  } else {
    mp - (i64)9;
  };
  let year: i64 = if month <= (i64)2 {
    y + (i64)1;
  } else {
    y;
  };

  out[0] = (i32)year;
  out[1] = (i32)month;
  out[2] = (i32)day;
  out[3] = hour;
  out[4] = minute;
  out[5] = second;
}

/**
 * Converts date/time components to seconds since 1970-01-01 00:00:00 UTC.
 */
seal func componentsToSeconds(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32): i64 {
  var y: i64 = (i64)year;
  let m: i64 = (i64)month;
  let d: i64 = (i64)day;

  if m <= (i64)2 {
    y = y - (i64)1;
  }
  let era: i64 = if y >= (i64)0 {
    y / (i64)400;
  } else {
    (y - (i64)399) / (i64)400;
  };
  let yoe: i64 = y - era * (i64)400;
  let mp: i64 = if m > (i64)2 {
    m - (i64)3;
  } else {
    m + (i64)9;
  };
  let doy: i64 = ((i64)153 * mp + (i64)2) / (i64)5 + d - (i64)1;
  let doe: i64 = yoe * (i64)365 + yoe / (i64)4 - yoe / (i64)100 + doy;
  let totalDays: i64 = era * (i64)146097 + doe - (i64)719468;

  return totalDays * (i64)86400 + (i64)hour * (i64)3600 + (i64)minute * (i64)60 + (i64)second;
}

/**
 * Date and time value object (without timezone information).
 * Immutable — helper methods compute and return a new DateTime instance.
 */
open type DateTime {

  // 均为分量（不是从1970-01-01 00:00:00 000000000 开始）--------------------------
  let year: i32; // 自然年，非偏移年
  let month: i32; // 1-12
  let day: i32; // 1-31
  let hour: i32; // 0-23
  let minute: i32; // 0-59
  let second: i32; // 0-59
  let millisecond: i32; // 0-999
  let microsecond: i32; // 0-999
  let nanosecond: i32; // 0-999

  // 构造方法 -------------------------------------------------------------------

  /**
   * Construct a DateTime from milliseconds since 1970-01-01 00:00:00 UTC
   * @param milliseconds Millisecond timestamp
   */
  func DateTime(milliseconds: i64) {
    let seconds: i64 = if milliseconds >= (i64)0 {
      milliseconds / (i64)1000;
    } else {
      (milliseconds - (i64)999) / (i64)1000;
    };
    var remainingMs: i32 = (i32)(milliseconds - seconds * (i64)1000);

    let components: i32[!] = i32[:(int)6];
    secondsToComponents(seconds, components);

    self.year = components[0];
    self.month = components[1];
    self.day = components[2];
    self.hour = components[3];
    self.minute = components[4];
    self.second = components[5];
    self.millisecond = remainingMs;
    self.microsecond = 0;
    self.nanosecond = 0;
  }

  /**
   * Construct a DateTime using the current time (UTC)
   */
  func DateTime() {
    let tv: i64[!] = i64[:(int)2];
    let rc = uv_gettimeofday(&tv);
    if rc != 0 {
      throw "time/datetime/gettimeofday";
    }
    let seconds: i64 = tv[0];
    let microseconds: i32 = (i32)tv[1];

    let components: i32[!] = i32[:(int)6];
    secondsToComponents(seconds, components);

    self.year = components[0];
    self.month = components[1];
    self.day = components[2];
    self.hour = components[3];
    self.minute = components[4];
    self.second = components[5];
    self.millisecond = microseconds / 1000;
    self.microsecond = microseconds % 1000;
    self.nanosecond = 0;
  }

  /**
   * Internal constructor used to defer field assignment via literal binding
   * @param allowLazyBound Whether to allow deferred binding
   */
  seal func DateTime(allowLazyBound: bool) {}

  // 静态工厂方法 ----------------------------------------------------------------

  /**
   * Create a DateTime from individual components
   * @param year Year
   * @param month Month (1-12)
   * @param day Day (1-31)
   * @param hour Hour (0-23)
   * @param minute Minute (0-59)
   * @param second Second (0-59)
   * @param millisecond Millisecond (0-999)
   * @param microsecond Microsecond (0-999)
   * @param nanosecond Nanosecond (0-999)
   */
  open static func of(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32, millisecond: i32, microsecond: i32, nanosecond: i32): DateTime {
    if month < 1 || month > 12 {
      throw "time/datetime/invalid-month";
    }
    if day < 1 || day > daysInMonthValue(year, month) {
      throw "time/datetime/invalid-day";
    }
    if hour < 0 || hour > 23 {
      throw "time/datetime/invalid-hour";
    }
    if minute < 0 || minute > 59 {
      throw "time/datetime/invalid-minute";
    }
    if second < 0 || second > 59 {
      throw "time/datetime/invalid-second";
    }
    if millisecond < 0 || millisecond > 999 {
      throw "time/datetime/invalid-millisecond";
    }
    if microsecond < 0 || microsecond > 999 {
      throw "time/datetime/invalid-microsecond";
    }
    if nanosecond < 0 || nanosecond > 999 {
      throw "time/datetime/invalid-nanosecond";
    }
    return DateTime(true) {
      year: year,
      month: month,
      day: day,
      hour: hour,
      minute: minute,
      second: second,
      millisecond: millisecond,
      microsecond: microsecond,
      nanosecond: nanosecond
    };
  }

  /**
   * Create a DateTime from date components (time defaults to 00:00:00.000000000)
   * @param year Year
   * @param month Month (1-12)
   * @param day Day (1-31)
   */
  open static func of(year: i32, month: i32, day: i32): DateTime {
    return DateTime.of(year, month, day, 0, 0, 0, 0, 0, 0);
  }

  /**
   * Create a DateTime from date and time components (sub-second parts default to 0)
   * @param year Year
   * @param month Month (1-12)
   * @param day Day (1-31)
   * @param hour Hour (0-23)
   * @param minute Minute (0-59)
   * @param second Second (0-59)
   */
  open static func of(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32): DateTime {
    return DateTime.of(year, month, day, hour, minute, second, 0, 0, 0);
  }

  /**
   * Get a DateTime representing the current time (UTC)
   */
  open static func now(): DateTime {
    return DateTime();
  }

  /**
   * Create a DateTime from a millisecond timestamp
   * @param milliseconds Milliseconds since 1970-01-01 00:00:00 UTC
   */
  open static func fromMilliseconds(milliseconds: i64): DateTime {
    return DateTime(milliseconds);
  }

  /**
   * Create a DateTime from a seconds timestamp
   * @param seconds Seconds since 1970-01-01 00:00:00 UTC
   */
  open static func fromSeconds(seconds: i64): DateTime {
    return DateTime(seconds * (i64)1000);
  }

  // 转换方法 -------------------------------------------------------------------

  /**
   * Return the millisecond timestamp since 1970-01-01 00:00:00 UTC.
   * Sub-millisecond parts (microsecond, nanosecond) are truncated.
   */
  open func toMilliseconds(): i64 {
    let seconds = componentsToSeconds(self.year, self.month, self.day, self.hour, self.minute, self.second);
    return seconds * (i64)1000 + (i64)self.millisecond;
  }

  /**
   * Return the seconds timestamp since 1970-01-01 00:00:00 UTC.
   * Sub-second parts (millisecond, microsecond, nanosecond) are truncated.
   */
  open func toSeconds(): i64 {
    return componentsToSeconds(self.year, self.month, self.day, self.hour, self.minute, self.second);
  }

  // 查询方法 -------------------------------------------------------------------

  /**
   * Return whether this year is a leap year
   */
  open func isLeapYear(): bool {
    return isLeapYearValue(self.year);
  }

  /**
   * Return the number of days in this month
   */
  open func daysInMonth(): i32 {
    return daysInMonthValue(self.year, self.month);
  }

  /**
   * Return the number of days in this year (365 or 366)
   */
  open func daysInYear(): i32 {
    if self.isLeapYear() {
      return 366;
    }
    return 365;
  }

  /**
   * Return the day of the year (1-366)
   */
  open func dayOfYear(): i32 {
    var result: i32 = 0;
    var m: i32 = 1;
    while m < self.month {
      result = result + daysInMonthValue(self.year, m);
      m = m + 1;
    }
    return result + self.day;
  }

  /**
   * Return the day of the week (1=Monday, 2=Tuesday, ..., 7=Sunday, ISO 8601)
   */
  open func dayOfWeek(): i32 {
    let seconds = componentsToSeconds(self.year, self.month, self.day, 0, 0, 0);
    var days: i64 = seconds / (i64)86400;
    // 1970-01-01 is Thursday (4)
    var dow: i64 = (days + (i64)3) % (i64)7;
    if dow < (i64)0 {
      dow = dow + (i64)7;
    }
    return (i32)dow + 1;
  }

  // 算术方法（返回新对象） -------------------------------------------------------

  /**
   * Add the specified number of years and return a new DateTime.
   * If the resulting date is invalid (e.g. Feb 29 in a non-leap year), it is adjusted to the last day of that month.
   * @param years Number of years to add (may be negative)
   */
  open func addYears(years: i32): DateTime {
    let newYear = self.year + years;
    var newDay = self.day;
    let maxDay = daysInMonthValue(newYear, self.month);
    if newDay > maxDay {
      newDay = maxDay;
    }
    return DateTime(true) {
      year: newYear,
      month: self.month,
      day: newDay,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Add the specified number of months and return a new DateTime.
   * If the resulting date is invalid, it is adjusted to the last day of that month.
   * @param months Number of months to add (may be negative)
   */
  open func addMonths(months: i32): DateTime {
    var totalMonths: i32 = (self.year * 12 + (self.month - 1)) + months;
    var newYear: i32 = totalMonths / 12;
    var newMonth: i32 = totalMonths % 12 + 1;
    if newMonth <= 0 {
      newMonth = newMonth + 12;
      newYear = newYear - 1;
    }
    var newDay = self.day;
    let maxDay = daysInMonthValue(newYear, newMonth);
    if newDay > maxDay {
      newDay = maxDay;
    }
    return DateTime(true) {
      year: newYear,
      month: newMonth,
      day: newDay,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Add the specified number of days and return a new DateTime
   * @param days Number of days to add (may be negative)
   */
  open func addDays(days: i64): DateTime {
    let milliseconds = self.toMilliseconds() + days * (i64)86400000;
    let result = DateTime(milliseconds);
    return DateTime(true) {
      year: result.year,
      month: result.month,
      day: result.day,
      hour: result.hour,
      minute: result.minute,
      second: result.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Add the specified number of hours and return a new DateTime
   * @param hours Number of hours to add (may be negative)
   */
  open func addHours(hours: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + hours * (i64)3600000000000;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  /**
   * Add the specified number of minutes and return a new DateTime
   * @param minutes Number of minutes to add (may be negative)
   */
  open func addMinutes(minutes: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + minutes * (i64)60000000000;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  /**
   * Add the specified number of seconds and return a new DateTime
   * @param seconds Number of seconds to add (may be negative)
   */
  open func addSeconds(seconds: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + seconds * (i64)1000000000;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  /**
   * Add the specified number of milliseconds and return a new DateTime
   * @param milliseconds Number of milliseconds to add (may be negative)
   */
  open func addMilliseconds(milliseconds: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + milliseconds * (i64)1000000;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  /**
   * Add the specified number of microseconds and return a new DateTime
   * @param microseconds Number of microseconds to add (may be negative)
   */
  open func addMicroseconds(microseconds: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + microseconds * (i64)1000;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  /**
   * Add the specified number of nanoseconds and return a new DateTime
   * @param nanoseconds Number of nanoseconds to add (may be negative)
   */
  open func addNanoseconds(nanoseconds: i64): DateTime {
    let totalNanoseconds: i64 = self.toMilliseconds() * (i64)1000000
    + (i64)self.microsecond * (i64)1000 + (i64)self.nanosecond
    + nanoseconds;
    return DateTime.fromNanoseconds(totalNanoseconds);
  }

  // with 方法（替换单个分量） ---------------------------------------------------

  /**
   * Return a new DateTime with the year replaced; the day is adjusted if necessary
   */
  open func withYear(year: i32): DateTime {
    var newDay = self.day;
    let maxDay = daysInMonthValue(year, self.month);
    if newDay > maxDay {
      newDay = maxDay;
    }
    return DateTime(true) {
      year: year,
      month: self.month,
      day: newDay,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the month replaced; the day is adjusted if necessary
   */
  open func withMonth(month: i32): DateTime {
    if month < 1 || month > 12 {
      throw "time/datetime/invalid-month";
    }
    var newDay = self.day;
    let maxDay = daysInMonthValue(self.year, month);
    if newDay > maxDay {
      newDay = maxDay;
    }
    return DateTime(true) {
      year: self.year,
      month: month,
      day: newDay,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the day replaced
   */
  open func withDay(day: i32): DateTime {
    if day < 1 || day > daysInMonthValue(self.year, self.month) {
      throw "time/datetime/invalid-day";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: day,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the hour replaced
   */
  open func withHour(hour: i32): DateTime {
    if hour < 0 || hour > 23 {
      throw "time/datetime/invalid-hour";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the minute replaced
   */
  open func withMinute(minute: i32): DateTime {
    if minute < 0 || minute > 59 {
      throw "time/datetime/invalid-minute";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: self.hour,
      minute: minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the second replaced
   */
  open func withSecond(second: i32): DateTime {
    if second < 0 || second > 59 {
      throw "time/datetime/invalid-second";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: self.hour,
      minute: self.minute,
      second: second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the millisecond replaced
   */
  open func withMillisecond(millisecond: i32): DateTime {
    if millisecond < 0 || millisecond > 999 {
      throw "time/datetime/invalid-millisecond";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: millisecond,
      microsecond: self.microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the microsecond replaced
   */
  open func withMicrosecond(microsecond: i32): DateTime {
    if microsecond < 0 || microsecond > 999 {
      throw "time/datetime/invalid-microsecond";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: microsecond,
      nanosecond: self.nanosecond
    };
  }

  /**
   * Return a new DateTime with the nanosecond replaced
   */
  open func withNanosecond(nanosecond: i32): DateTime {
    if nanosecond < 0 || nanosecond > 999 {
      throw "time/datetime/invalid-nanosecond";
    }
    return DateTime(true) {
      year: self.year,
      month: self.month,
      day: self.day,
      hour: self.hour,
      minute: self.minute,
      second: self.second,
      millisecond: self.millisecond,
      microsecond: self.microsecond,
      nanosecond: nanosecond
    };
  }

  // 比较方法 -------------------------------------------------------------------

  /**
   * Compare two DateTime objects, returning a negative/zero/positive value.
   * Negative means self is earlier than other, positive means self is later than other.
   */
  open func compareTo(other: DateTime): i32 {
    if self.year != other.year {
      return self.year - other.year;
    }
    if self.month != other.month {
      return self.month - other.month;
    }
    if self.day != other.day {
      return self.day - other.day;
    }
    if self.hour != other.hour {
      return self.hour - other.hour;
    }
    if self.minute != other.minute {
      return self.minute - other.minute;
    }
    if self.second != other.second {
      return self.second - other.second;
    }
    if self.millisecond != other.millisecond {
      return self.millisecond - other.millisecond;
    }
    if self.microsecond != other.microsecond {
      return self.microsecond - other.microsecond;
    }
    return self.nanosecond - other.nanosecond;
  }

  /**
   * Return whether this DateTime is before the other DateTime
   */
  open func isBefore(other: DateTime): bool {
    return self.compareTo(other) < 0;
  }

  /**
   * Return whether this DateTime is after the other DateTime
   */
  open func isAfter(other: DateTime): bool {
    return self.compareTo(other) > 0;
  }

  /**
   * Return whether two DateTimes represent the same instant
   */
  open func equals(other: DateTime): bool {
    return self.compareTo(other) == 0;
  }

  // 格式化方法 -----------------------------------------------------------------

  /**
   * Return an ISO 8601 formatted date-time string.
   * Format: yyyy-MM-ddTHH:mm:ss.mmmuuunnn
   * Sub-second parts are omitted if all zero.
   * Only millisecond part is output if microsecond and nanosecond are zero.
   * Microsecond precision is used if nanosecond is zero.
   */
  open func toString(): string {
    var result = padZero(self.year, 4) + "-" + padZero(self.month, 2) + "-" + padZero(self.day, 2)
    + "T" + padZero(self.hour, 2) + ":" + padZero(self.minute, 2) + ":" + padZero(self.second, 2);

    if self.millisecond != 0 || self.microsecond != 0 || self.nanosecond != 0 {
      result = result + "." + padZero(self.millisecond, 3);
      if self.microsecond != 0 || self.nanosecond != 0 {
        result = result + padZero(self.microsecond, 3);
        if self.nanosecond != 0 {
          result = result + padZero(self.nanosecond, 3);
        }
      }
    }
    return result;
  }

  /**
   * Return the date part as a string.
   * Format: yyyy-MM-dd
   */
  open func toDateString(): string {
    return padZero(self.year, 4) + "-" + padZero(self.month, 2) + "-" + padZero(self.day, 2);
  }

  /**
   * Return the time part as a string.
   * Format: HH:mm:ss
   */
  open func toTimeString(): string {
    return padZero(self.hour, 2) + ":" + padZero(self.minute, 2) + ":" + padZero(self.second, 2);
  }

  // 内部辅助 -------------------------------------------------------------------

  /**
   * Reconstruct a DateTime from a nanosecond timestamp (internal use)
   */
  seal static func fromNanoseconds(totalNanoseconds: i64): DateTime {
    let nanosPerMillisecond: i64 = (i64)1000000;
    var milliseconds: i64 = totalNanoseconds / nanosPerMillisecond;
    var subMillisecond: i64 = totalNanoseconds - milliseconds * nanosPerMillisecond;
    if subMillisecond < (i64)0 {
      subMillisecond = subMillisecond + nanosPerMillisecond;
      milliseconds = milliseconds - (i64)1;
    }
    let remainingMicrosecond: i32 = (i32)(subMillisecond / (i64)1000);
    let remainingNanosecond: i32 = (i32)(subMillisecond - (i64)remainingMicrosecond * (i64)1000);

    let seconds: i64 = if milliseconds >= (i64)0 {
      milliseconds / (i64)1000;
    } else {
      (milliseconds - (i64)999) / (i64)1000;
    };
    let remainingMillisecond: i32 = (i32)(milliseconds - seconds * (i64)1000);

    let components: i32[!] = i32[:(int)6];
    secondsToComponents(seconds, components);

    return DateTime(true) {
      year: components[0],
      month: components[1],
      day: components[2],
      hour: components[3],
      minute: components[4],
      second: components[5],
      millisecond: remainingMillisecond,
      microsecond: remainingMicrosecond,
      nanosecond: remainingNanosecond
    };
  }

}
