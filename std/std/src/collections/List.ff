open module std.collections;

/** Returns the fixed storage capacity of a private writable array. */
@runtime
extern func feng_array_storage_get_capacity<T>(array: T[!]): int;

/** Inserts one element into a private writable array with spare capacity. */
@runtime
extern func feng_array_storage_insert<T>(array: T[!], index: int, value: T): void;

/** Removes a range of elements from a private writable array. */
@runtime
extern func feng_array_storage_remove<T>(array: T[!], index: int, count: int): void;

/**
 * Creates new-capacity storage, transfers the retained prefix without element
 * RC changes, releases any truncated suffix, and leaves the source array empty.
 */
@runtime
extern func feng_array_storage_migrate<T>(array: T[!], newCapacity: int): T[!];

/**
 * A list is a growable ordered collection of elements backed by a dynamic array.
 * @param <T> - the element type
 *
 * Implementation notes:
 * - Backed by a private contiguous array with independent length and capacity.
 * - Storage doubles in capacity when full and retains capacity across clear().
 * - Average O(1) amortized for add; O(n) for remove due to element shifting.
 * - get and set are O(1) by index.
 * - entries returns an immutable dense copy of all elements in order.
 */
open type List<T> {
  seal var items: T[!];
  seal var missing: T;

  /** Doubles backing storage capacity, using eight slots for the first allocation. */
  seal func grow() {
    let capacity = feng_array_storage_get_capacity(self.items);
    if capacity == (int)0 {
      self.items = feng_array_storage_migrate(self.items, (int)8);
      return;
    }
    self.items = feng_array_storage_migrate(self.items, capacity * (int)2);
  }

  /** Halves sparse backing storage while retaining a minimum capacity of eight. */
  seal func shrink() {
    let capacity = feng_array_storage_get_capacity(self.items);
    if capacity <= (int)8 {
      return;
    }
    if self.items.length() > capacity / (int)4 {
      return;
    }
    var newCapacity: int = capacity / (int)2;
    if newCapacity < (int)8 {
      newCapacity = (int)8;
    }
    self.items = feng_array_storage_migrate(self.items, newCapacity);
  }

  /** Creates an empty list without pre-allocating backing storage. */
  open func List() {}

  /**
   * Creates a list from a private writable clone of `items`.
   * @param items - source writable array copied into the list
   */
  open func List(items: T[!]) {
    self.items = items.clone();
  }

  /**
   * Creates a list from a private writable copy of `items`.
   * @param items - source read-only array copied into the list
   */
  open func List(items: T[]) {
    let length = items.length();
    self.items = feng_array_slice(items, (int)0, length);
  }

  /**
   * Creates an empty list with the given initial capacity pre-allocated.
   * Useful when the expected number of elements is known in advance,
   * avoiding intermediate grow() reallocations.
   * @param capacity - number of slots to pre-allocate (clamped to 0 if negative)
   */
  open func List(capacity: int) {
    if capacity > (int)0 {
      self.items = feng_array_storage_migrate(self.items, capacity);
    }
  }

  /**
   * Appends `item` to the end of the list.
   * @param item - the element to append
   */
  open func add(item: T) {
    let length = self.items.length();
    if length >= feng_array_storage_get_capacity(self.items) {
      self.grow();
    }
    feng_array_storage_insert(self.items, length, item);
  }

  /**
   * Inserts `item` at `index`, shifting subsequent elements right.
   * @param index - zero-based insertion position from zero through size()
   * @param item - the element to insert
   * @panic if `index` is less than zero or greater than size()
   */
  open func insert(index: int, item: T) {
    if self.items.length() >= feng_array_storage_get_capacity(self.items) {
      self.grow();
    }
    feng_array_storage_insert(self.items, index, item);
  }

  /**
   * Returns the element at position `index`.
   * @param index - zero-based position
   * @panic if `index` is less than zero or greater than or equal to size()
   */
  open func get(index: int): T {
    return self.items[index];
  }

  /**
   * Replaces the element at position `index` with `item`.
   * @param index - zero-based position
   * @param item - new value to store
   * @panic if `index` is less than zero or greater than or equal to size()
   */
  open func set(index: int, item: T) {
    self.items[index] = item;
  }

  /**
   * Returns true if the list contains an element equal to `item`.
   * @param item - element value to search for
   * @return true when an element is found; false otherwise
   */
  open func contains(item: T): bool {
    let length = self.items.length();
    for var i: int = 0; i < length; i += 1 {
      if feng_expression_equal(self.items[i], item) {
        return true;
      }
    }
    return false;
  }

  /**
   * Removes the element at position `index`, shifting subsequent elements left.
   * @param index - zero-based position of the element to remove
   * @panic if `index` is less than zero or greater than or equal to size()
   */
  open func removeAt(index: int) {
    feng_array_storage_remove(self.items, index, (int)1);
    self.shrink();
  }

  /**
   * Removes the first element equal to `item` while preserving relative order.
   * @param item - element value to remove
   * @return true when an element was removed; false when no element matched
   */
  open func remove(item: T): bool {
    let length = self.items.length();
    for var index: int = 0; index < length; index += (int)1 {
      if feng_expression_equal(self.items[index], item) {
        self.removeAt(index);
        return true;
      }
    }
    return false;
  }

  /**
   * Removes all elements from the list, resetting it to an empty state.
   */
  open func clear() {
    feng_array_storage_remove(self.items, (int)0, self.items.length());
  }

  /**
   * Returns the number of elements in the list.
   */
  open func size(): int {
    return self.items.length();
  }

  /**
   * Returns all elements as an immutable dense array in insertion order.
   * @return immutable array of all elements
   */
  open func entries(): T[] {
    let length = self.items.length();
    let result: T[!] = T[:length];
    for var i: int = 0; i < length; i = i + 1 {
      result[i] = self.items[i];
    }
    return (T[])result;
  }

  /**
   * Returns all elements as an immutable array suitable for for/in iteration.
   * @return immutable array of all elements
   */
  @iterable
  open func iter(): ListIterator<T> {
    return ListIterator<T>(self.items, self.items.length(), self.missing);
  }
}

/**
 * An iterator cursor over a List<T>.
 * @param <T> - the element type
 */
@value
open type ListIterator<T> {
  seal let items: T[!];
  seal let size: int;
  seal let missing: T;
  seal var index: int;

  open func ListIterator(items: T[!], size: int, missing: T) {
    self.items = items;
    self.size = size;
    self.missing = missing;
    self.index = 0;
  }

  /**
   * Advances the iterator and returns the next element, or signals completion.
   * @return (true, value) if an element is available, (false, _) otherwise
   */
  @iterator
  open func next(): IteratorResult<T> {
    if self.index >= self.size {
      return (false, self.missing);
    }
    let value = self.items[self.index];
    self.index = self.index + 1;
    return (true, value);
  }
}
