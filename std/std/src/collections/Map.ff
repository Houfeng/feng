open module std.collections;

/**
 * A map entity stores one key-value pair.
 * `item1` is key and `item2` is value.
 * @param <K> - the key type
 * @param <V> - the value type
 */
open type MapEntity<K, V>(K, V);

/**
 * A map is a collection of key-value pairs
 * @param <K> - the type of the keys in the map
 * @param <V> - the type of the values in the map
 *
 * Implementation notes:
 * - Separate bucket indices and dense entry arrays containing only live entries.
 * - Buckets and entry links encode an entry index plus one; zero means empty.
 * - Collisions are resolved by per-bucket chains and `same` key comparison.
 * - Removal keeps entries dense by moving the last entry into the removed slot.
 * - Dense storage grows and shrinks with the private array storage primitives.
 * - Average O(1) for get/set/remove/has under normal hash distribution.
 * - `get` returns the default zero value of `V` when key is missing.
 * - `entries` returns an immutable copy of all live entries.
 */
open type Map<K: Hashable<K>, V> {
  seal var buckets: int[!];
  seal var hashes: u64[!];
  seal var nexts: int[!];
  seal var keys: K[!];
  seal var values: V[!];
  seal var size: int;
  seal var capacity: int;
  seal var missingValue: V;

  /** Returns the bucket index selected by `hash`. */
  seal func slotForHash(hash: u64): int {
    return (int)(hash % (u64)self.capacity);
  }

  /** Resizes entry storage and rebuilds all bucket chains. */
  seal func rehash(newCapacity: int) {
    self.hashes = feng_array_storage_migrate(self.hashes, newCapacity);
    self.nexts = feng_array_storage_migrate(self.nexts, newCapacity);
    self.keys = feng_array_storage_migrate(self.keys, newCapacity);
    self.values = feng_array_storage_migrate(self.values, newCapacity);
    self.buckets = int[:newCapacity];
    self.capacity = newCapacity;
    for var i: int = 0; i < self.size; i = i + 1 {
      let bucket: int = self.slotForHash(self.hashes[i]);
      self.nexts[i] = self.buckets[bucket];
      self.buckets[bucket] = i + 1;
    }
  }

  /** Ensures bucket and entry storage have room for one more live entry. */
  seal func ensureWritableForInsert() {
    if self.capacity == 0 {
      self.rehash(8);
      return;
    }
    // Grow before bucket chains reach a high load factor.
    if (self.size + 1) * 10 >= self.capacity * 7 {
      self.rehash(self.capacity * 2);
    }
  }

  /** Shrinks sparse entry storage while retaining a minimum capacity of eight. */
  seal func maybeShrinkAfterRemove() {
    if self.capacity <= 8 {
      return;
    }
    if self.size * 10 <= self.capacity * 2 {
      var newCapacity: int = self.capacity / 2;
      if newCapacity < 8 {
        newCapacity = 8;
      }
      self.rehash(newCapacity);
    }
  }

  /** Returns the dense entry index for `key`, or minus one when absent. */
  seal func findEntry(key: K, keyHash: u64): int {
    if self.capacity == 0 {
      return -1;
    }
    let bucket: int = self.slotForHash(keyHash);
    var encodedIndex: int = self.buckets[bucket];
    while encodedIndex != 0 {
      let index: int = encodedIndex - 1;
      if self.hashes[index] == keyHash {
        let candidate: K = self.keys[index];
        let matched: bool = key.same(candidate);
        if matched {
          return index;
        }
      }
      encodedIndex = self.nexts[index];
    }
    return -1;
  }

  /**
   * Replaces a bucket-chain reference after the last dense entry is moved.
   * @param hash - hash of the moved entry
   * @param oldEncodedIndex - previous entry index plus one
   * @param newEncodedIndex - replacement entry index plus one
   */
  seal func replaceChainIndex(
    hash: u64,
    oldEncodedIndex: int,
    newEncodedIndex: int
  ) {
    let bucket: int = self.slotForHash(hash);
    if self.buckets[bucket] == oldEncodedIndex {
      self.buckets[bucket] = newEncodedIndex;
      return;
    }
    var encodedIndex: int = self.buckets[bucket];
    while encodedIndex != 0 {
      let index: int = encodedIndex - 1;
      if self.nexts[index] == oldEncodedIndex {
        self.nexts[index] = newEncodedIndex;
        return;
      }
      encodedIndex = self.nexts[index];
    }
  }

  /**
   * Removes a known entry index while preserving dense storage.
   * @param index - dense index of the entry to remove
   */
  seal func removeEntryAt(index: int) {
    let lastIndex: int = self.size - 1;
    if index != lastIndex {
      let movedHash: u64 = self.hashes[lastIndex];
      self.hashes[index] = movedHash;
      self.nexts[index] = self.nexts[lastIndex];
      self.keys[index] = self.keys[lastIndex];
      self.values[index] = self.values[lastIndex];
      self.replaceChainIndex(movedHash, lastIndex + 1, index + 1);
    }
    feng_array_storage_remove(self.hashes, lastIndex, 1);
    feng_array_storage_remove(self.nexts, lastIndex, 1);
    feng_array_storage_remove(self.keys, lastIndex, 1);
    feng_array_storage_remove(self.values, lastIndex, 1);
    self.size = self.size - 1;
    self.maybeShrinkAfterRemove();
  }

  /**
   * Returns the value associated with `key`.
   * If `key` does not exist, returns the zero default value of `V`.
   * @param key - lookup key
   */
  open func get(key: K): V {
    let keyHash: u64 = key.hash();
    let index: int = self.findEntry(key, keyHash);
    if index >= 0 {
      return self.values[index];
    }
    return self.missingValue;
  }

  /**
   * Inserts or updates the value for `key`.
   * If `key` already exists, only its value is replaced.
   * @param key - map key
   * @param value - value to insert or replace
   */
  open func set(key: K, value: V) {
    let keyHash: u64 = key.hash();
    let existingIndex: int = self.findEntry(key, keyHash);
    if existingIndex >= 0 {
      self.values[existingIndex] = value;
      return;
    }

    self.ensureWritableForInsert();
    let bucket: int = self.slotForHash(keyHash);
    feng_array_storage_insert(self.hashes, self.size, keyHash);
    feng_array_storage_insert(self.nexts, self.size, self.buckets[bucket]);
    feng_array_storage_insert(self.keys, self.size, key);
    feng_array_storage_insert(self.values, self.size, value);
    self.buckets[bucket] = self.size + 1;
    self.size = self.size + 1;
  }

  /**
   * Removes `key` from the map if it exists.
   * If `key` does not exist, this method has no effect.
   * @param key - key to remove
   */
  open func remove(key: K) {
    if self.capacity == 0 {
      return;
    }
    let keyHash: u64 = key.hash();
    let bucket: int = self.slotForHash(keyHash);
    var previousIndex: int = -1;
    var encodedIndex: int = self.buckets[bucket];
    while encodedIndex != 0 {
      let index: int = encodedIndex - 1;
      let entryHash: u64 = self.hashes[index];
      let candidate: K = self.keys[index];
      if entryHash == keyHash && key.same(candidate) {
        let nextEncodedIndex: int = self.nexts[index];
        if previousIndex < 0 {
          self.buckets[bucket] = nextEncodedIndex;
        } else {
          self.nexts[previousIndex] = nextEncodedIndex;
        }
        self.removeEntryAt(index);
        return;
      }
      previousIndex = index;
      encodedIndex = self.nexts[index];
    }
  }

  /**
   * Returns true if `key` exists in the map, otherwise false.
   * @param key - key to test
   */
  open func has(key: K): bool {
    let keyHash: u64 = key.hash();
    return self.findEntry(key, keyHash) >= 0;
  }

  /**
   * Returns the number of occupied entries in the map.
   */
  open func count(): int {
    return self.size;
  }

  /**
   * Returns all occupied entries as an immutable dense array.
   * @return immutable array of map entries
   */
  open func entries(): MapEntity<K, V>[] {
    let result: MapEntity<K, V>[!] = MapEntity<K, V>[:self.size];
    for var i: int = 0; i < self.size; i = i + 1 {
      result[i] = (self.keys[i], self.values[i]);
    }
    return (MapEntity<K, V>[])result;
  }
}
