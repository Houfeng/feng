open module std;

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple();

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2>(T1, T2);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3>(T1, T2, T3);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3, T4>(T1, T2, T3, T4);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3, T4, T5>(T1, T2, T3, T4, T5);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3, T4, T5, T6>(T1, T2, T3, T4, T5, T6);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3, T4, T5, T6, T7>(T1, T2, T3, T4, T5, T6, T7);

/**
 * The Tuple type represents a fixed-size collection of values of potentially different types.
 */
open type Tuple<T1, T2, T3, T4, T5, T6, T7, T8>(T1, T2, T3, T4, T5, T6, T7, T8);