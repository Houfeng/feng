open module std.text;

import std.collections;

@cdecl("feng_std_unistring", "u8_mbsnlen")
extern func u8_mbsnlen(s: string*, n: uint): uint;

@cdecl("feng_std_unistring", "u8_next")
extern func u8_next(puc: u32*, s: string*): string*;

@cdecl("feng_std_unistring", "u8_prev")
extern func u8_prev(puc: u32*, s: string*, start: string*): string*;


/**
 * Extends `string` with a rune-level view.
 */
open fit string {

  /**
   * Returns a view of this string as a sequence of runes (Unicode scalar values).
   * @return rune view
   */
  open func runes(): RuneView {
    return RuneView(self);
  }

}

/**
 * A read-only view of a string as a sequence of runes (Unicode scalar values).
 */
@value
open type RuneView {
  seal let text: string;

  /**
   * Constructs a new RuneView for the given string.
   * @param text - the string to view as runes
   */
  open func RuneView(text: string) {
    self.text = text;
  }

  /**
   * Returns the number of runes in this string.
   * @return rune count
   */
  open func length(): int {
    return (int)u8_mbsnlen(&self.text, (uint)self.text.length());
  }

  /**
   * Returns the substring of the rune at the given logical index.
   * @param index - zero-based rune index
   * @return substring containing the single rune
   */
  open func at(index: int): string {
    if index < (int)0 {
      throw "RuneView index out of bounds";
    }
    let data: string* = &self.text;
    var cursor: string* = data;
    var uc: u32 = 0;
    var i: int = 0;
    while i < index {
      cursor = u8_next(&uc, cursor);
      if feng_pointer_is_null(cursor) {
        throw "RuneView index out of bounds";
      }
      i += (int)1;
    }
    let next: string* = u8_next(&uc, cursor);
    if feng_pointer_is_null(next) {
      throw "RuneView index out of bounds";
    }
    let start = feng_pointer_diff(cursor, data);
    let end = feng_pointer_diff(next, data);
    return self.text.clone(start, end);
  }

  /**
   * Returns an iterator over the runes of this view.
   * @return rune iterator cursor
   */
  @iterable
  open func iter(): RuneIterator {
    return RuneIterator(self.text);
  }
}

/**
 * An iterator cursor that yields individual runes as substring slices.
 */
@value
open type RuneIterator {
  seal let text: string;
  seal let len: int;
  seal var offset: int;

  /**
   * Constructs a new RuneIterator for the given string.
   * @param text - the string to iterate as runes
   */
  open func RuneIterator(text: string) {
    self.text = text;
    self.len = text.length();
    self.offset = 0;
  }

  /**
   * Advances to the next rune and returns it, or signals completion.
   * @return (true, rune) if available, (false, _) otherwise
   */
  @iterator
  open func next(): IteratorResult<string> {
    if self.offset >= self.len {
      return (false, "");
    }
    let data: string* = &self.text;
    let cursor: string* = feng_pointer_move(data, self.offset);
    var uc: u32 = 0;
    let after: string* = u8_next(&uc, cursor);
    if feng_pointer_is_null(after) {
      return (false, "");
    }
    let start = self.offset;
    self.offset = feng_pointer_diff(after, data);
    return (true, self.text.clone(start, self.offset));
  }
}
