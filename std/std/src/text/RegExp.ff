open module std.text;

import std.collections;

/* ---------- Opaque C types ---------- */

/* PCRE2 match result data (opaque) */
@abi
seal type Pcre2MatchData {}

/* ---------- PCRE2 core API ---------- */

@cdecl("feng_std_pcre2", "pcre2_compile_8")
extern func pcre2_compile(
  pattern: byte*, length: uint, options: u32,
  errorCode: i32*, errorOffset: i64*,
  cContext: int
): int;

@cdecl("feng_std_pcre2", "pcre2_code_free_8")
extern func pcre2_code_free(code: int): void;

@cdecl("feng_std_pcre2", "pcre2_match_data_create_from_pattern_8")
extern func pcre2_match_data_create_from_pattern(
  code: int, gContext: int
): Pcre2MatchData*;

@cdecl("feng_std_pcre2", "pcre2_match_data_free_8")
extern func pcre2_match_data_free(match_data: Pcre2MatchData*): void;

@cdecl("feng_std_pcre2", "pcre2_match_8")
extern func pcre2_match(
  code: int, subject: byte*, length: uint, startOffset: uint,
  options: u32, match_data: Pcre2MatchData*, mContext: int
): i32;

@cdecl("feng_std_pcre2", "pcre2_get_ovector_pointer_8")
extern func pcre2_get_ovector_pointer(match_data: Pcre2MatchData*): int*;

@cdecl("feng_std_pcre2", "pcre2_get_ovector_count_8")
extern func pcre2_get_ovector_count(match_data: Pcre2MatchData*): u32;

@cdecl("feng_std_pcre2", "pcre2_get_error_message_8")
extern func pcre2_get_error_message(errorcode: i32, buffer: byte*, buffer_size: uint): i32;

@cdecl("feng_std_pcre2", "pcre2_substitute_8")
extern func pcre2_substitute(
  code: int, subject: byte*, length: uint, startoffset: uint,
  options: u32, match_data: int, mcontext: int,
  replacement: byte*, rlength: uint,
  outputbuffer: byte*, outlengthptr: int*
): i32;

/* ---------- Runtime pointer primitives ---------- */

@runtime
extern func feng_pointer_get_scalar<T>(ptr: int*): T;

@runtime
extern func feng_pointer_move(ptr: int*, offset: int): int*;

/* ---------- Constants ---------- */

/* PCRE2_UNSET: ~(size_t)0, bit pattern is -1 when read as signed platform-width int */
seal let PCRE2_UNSET: int = (int)-1;

/* ---------- RegExpFlag ---------- */

/**
 * Flags for controlling regex behavior.
 * Values correspond to PCRE2 option bits and can be combined with bitwise OR.
 */
open enum RegExpFlag {
  /**
   * Enables UTF-8 mode, treating the pattern and subject as UTF-8 encoded.
   * This is enabled by default in this implementation.
   */
  CaseInsensitive = 0x00000008,

  /**
   * Enables multiline mode, which changes the behavior of ^ and $ to match
   * at the beginning and end of each line, respectively.
   */
  Multiline = 0x00000400,

  /**
   * Enables dotall mode, which makes the dot (.) special character match
   * any character, including a newline.
   */
  DotAll = 0x00000020,

  /**
   * Enables extended mode, which allows whitespace and # comments in the pattern.
   */
  Extended = 0x00000080,

  /**
   * Enables ungreeedy mode, which makes quantifiers lazy by default.
   */
  Ungreedy = 0x00040000
}

/* ---------- Match ---------- */

/**
 * Represents a single regex match result, including captured groups.
 */
open type Match {
  /**
   * The substring of the subject that matched the full pattern.
   */
  open let text: string;

  /**
   * The starting index of the match in the subject string.
   */
  open let start: int;

  /**
   * The ending index of the match in the subject string.
   */
  open let end: int;

  /**
   * An array of captured groups, where each group is a substring of the subject.
   */
  open let groups: string[];
}

/* ---------- ovector helpers ---------- */

seal func ovectorStart(ovector: int*, index: u32): int {
  return feng_pointer_get_scalar<int>(
    feng_pointer_move(ovector, (int)index * (int)16)
  );
}

seal func ovectorEnd(ovector: int*, index: u32): int {
  return feng_pointer_get_scalar<int>(
    feng_pointer_move(ovector, (int)index * (int)16 + (int)8)
  );
}

/* ---------- buildMatch ---------- */

seal func buildMatch(subject: string, md: Pcre2MatchData*): Match {
  let ovector = pcre2_get_ovector_pointer(md);
  let ovCount = pcre2_get_ovector_count(md);
  let groupArr: string[!] = string[:(int)ovCount];
  var i: u32 = 0;
  while i < ovCount {
    let s = ovectorStart(ovector, i);
    let e = ovectorEnd(ovector, i);
    if s == PCRE2_UNSET || e == PCRE2_UNSET {
      groupArr[(int)i] = "";
    } else {
      groupArr[(int)i] = subject.clone(s, e);
    }
    i += (u32)1;
  }
  let matchStart = ovectorStart(ovector, (u32)0);
  let matchEnd = ovectorEnd(ovector, (u32)0);
  let matchText = subject.clone(matchStart, matchEnd);
  return Match {
    text: matchText,
    start: matchStart,
    end: matchEnd,
    groups: (string[])groupArr
  };
}

/* ---------- compilePattern ---------- */

seal func compilePattern(pattern: string, flags: u32): int {
  let patternBytes = pattern.toBytes();
  let buf: byte[!] = byte[:(int)256];
  var errorCode: i32 = 0;
  var errorOffset: i64 = 0;
  let compiled = pcre2_compile(
  &patternBytes, (uint)patternBytes.length(),
  flags, &errorCode, &errorOffset, (int)0
  );
  if compiled == (int)0 {
    let msgLen = pcre2_get_error_message(errorCode, &buf, (uint)256);
    throw "RegExp compile error: " + string.fromUtf8Bytes((byte[])buf, (int)msgLen);
  }
  return compiled;
}

/* ---------- RegExp ---------- */

/**
 * A compiled regular expression backed by PCRE2.
 * Instances are immutable and thread-safe after construction.
 */
open type RegExp {
  seal let code: int;
  seal let pattern: string;
  seal let flagBits: u32;

  /**
   * Compiles a regular expression pattern.
   * UTF-8 and Unicode property matching are enabled by default.
   * @param pattern - the regex pattern string
   * @throws string if the pattern is invalid
   */
  open func RegExp(pattern: string) {
    self.pattern = pattern;
    self.flagBits = (u32)0x00080000 | (u32)0x00020000;
    self.code = compilePattern(pattern, self.flagBits);
  }

  /**
   * Compiles a regular expression pattern with a single RegExpFlag.
   * @param pattern - the regex pattern string
   * @param flag - a RegExpFlag value
   * @throws string if the pattern is invalid
   */
  open func RegExp(pattern: string, flag: RegExpFlag) {
    self.pattern = pattern;
    self.flagBits = (u32)(int)flag | (u32)0x00080000 | (u32)0x00020000;
    self.code = compilePattern(pattern, self.flagBits);
  }

  /**
   * Returns whether this regex matches anywhere within the subject string.
   * @param subject - the string to test
   * @return true if any substring matches
   */
  open func test(subject: string): bool {
    let subjectBytes = subject.toBytes();
    let md = pcre2_match_data_create_from_pattern(self.code, (int)0);
    let rc = pcre2_match(
    self.code, &subjectBytes, (uint)subjectBytes.length(),
    (uint)0, (u32)0, md, (int)0
    );
    pcre2_match_data_free(md);
    return rc >= (i32)0;
  }

  /**
   * Returns whether this regex matches the entire subject string.
   * @param subject - the string to test
   * @return true if the entire subject matches
   */
  open func isMatch(subject: string): bool {
    let subjectBytes = subject.toBytes();
    let md = pcre2_match_data_create_from_pattern(self.code, (int)0);
    /* PCRE2_ANCHORED (0x80000000) | PCRE2_ENDANCHORED (0x20000000) */
    let rc = pcre2_match(
    self.code, &subjectBytes, (uint)subjectBytes.length(),
    (uint)0, (u32)0x80000000 | (u32)0x20000000, md, (int)0
    );
    pcre2_match_data_free(md);
    return rc >= (i32)0;
  }

  /**
   * Finds the first match in the subject string.
   * Returns a single-element array on match, or an empty array if no match.
   * @param subject - the string to search
   * @return array with 0 or 1 Match elements
   */
  open func find(subject: string): Match[] {
    let subjectBytes = subject.toBytes();
    var resultArr: Match[!] = Match[:(int)0];
    let md = pcre2_match_data_create_from_pattern(self.code, (int)0);
    let rc = pcre2_match(
    self.code, &subjectBytes, (uint)subjectBytes.length(),
    (uint)0, (u32)0, md, (int)0
    );
    if rc >= (i32)0 {
      resultArr = Match[:(int)1];
      resultArr[0] = buildMatch(subject, md);
    }
    pcre2_match_data_free(md);
    return (Match[])resultArr;
  }

  /**
   * Finds all non-overlapping matches in the subject string.
   * @param subject - the string to search
   * @return array of Match objects
   */
  open func findAll(subject: string): Match[] {
    let subjectBytes = subject.toBytes();
    let subjectLen = (uint)subjectBytes.length();
    var capacity: int = 8;
    var items: Match[!] = Match[:capacity];
    var count: int = 0;
    var scratch: Match[!] = items;
    let md = pcre2_match_data_create_from_pattern(self.code, (int)0);
    var offset: uint = 0;
    while offset <= subjectLen {
      let rc = pcre2_match(
      self.code, &subjectBytes, subjectLen,
      offset, (u32)0, md, (int)0
      );
      if rc < (i32)0 {
        break;
      }
      if count >= capacity {
        capacity = capacity * (int)2;
        scratch = Match[:capacity];
        var j: int = 0;
        while j < count {
          scratch[j] = items[j];
          j += (int)1;
        }
        items = scratch;
      }
      items[count] = buildMatch(subject, md);
      count += (int)1;
      if items[count - (int)1].end == (int)offset {
        offset += (uint)1;
      } else {
        offset = (uint)items[count - (int)1].end;
      }
    }
    pcre2_match_data_free(md);
    var result: Match[!] = Match[:count];
    var k: int = 0;
    while k < count {
      result[k] = items[k];
      k += (int)1;
    }
    return (Match[])result;
  }

  /**
   * Splits the subject string by matches of this regex.
   * @param subject - the string to split
   * @return array of substrings between matches
   */
  open func split(subject: string): string[] {
    let subjectBytes = subject.toBytes();
    let subjectLen = (uint)subjectBytes.length();
    let parts = List<string>();
    let md = pcre2_match_data_create_from_pattern(self.code, (int)0);
    var pos: uint = 0;
    while pos <= subjectLen {
      let rc = pcre2_match(
      self.code, &subjectBytes, subjectLen,
      pos, (u32)0, md, (int)0
      );
      if rc < (i32)0 {
        break;
      }
      let ovector = pcre2_get_ovector_pointer(md);
      let matchStart = (uint)ovectorStart(ovector, (u32)0);
      let matchEnd = (uint)ovectorEnd(ovector, (u32)0);
      if matchStart > pos {
        parts.add(subject.clone((int)pos, (int)matchStart));
      } else {
        parts.add("");
      }
      if matchEnd == pos {
        pos += (uint)1;
      } else {
        pos = matchEnd;
      }
    }
    if pos <= subjectLen {
      if pos < subjectLen {
        parts.add(subject.clone((int)pos, (int)subjectLen));
      } else {
        parts.add("");
      }
    }
    pcre2_match_data_free(md);
    return parts.entries();
  }

  /**
   * Replaces the first match with the replacement string.
   * Replacement may use $0 for full match and $1..$9 for captured groups.
   * @param subject - the string to search
   * @param replacement - the replacement string (supports backreferences)
   * @return new string with the first match replaced
   */
  open func replaceFirst(subject: string, replacement: string): string {
    return self.substituteInternal(subject, replacement, (u32)0);
  }

  /**
   * Replaces all matches with the replacement string.
   * Replacement may use $0 for full match and $1..$9 for captured groups.
   * @param subject - the string to search
   * @param replacement - the replacement string (supports backreferences)
   * @return new string with all matches replaced
   */
  open func replaceAll(subject: string, replacement: string): string {
    return self.substituteInternal(subject, replacement, (u32)0x00000100);
  }

  seal func substituteInternal(subject: string, replacement: string, options: u32): string {
    let subjectBytes = subject.toBytes();
    let replBytes = replacement.toBytes();
    var outLen: int = subjectBytes.length() * (int)2;
    if outLen < (int)256 {
      outLen = (int)256;
    }
    var outBuf: byte[!] = byte[:outLen];
    var actualLen: int = outLen;
    let subOpts = options | (u32)0x00000200 | (u32)0x00001000;
    let rc = pcre2_substitute(
    self.code, &subjectBytes, (uint)subjectBytes.length(),
    (uint)0, subOpts,
    (int)0, (int)0,
    &replBytes, (uint)replBytes.length(),
    &outBuf, &actualLen
    );
    if rc == (i32)-48 {
      outLen = actualLen + (int)1;
      outBuf = byte[:outLen];
      actualLen = outLen;
      let rc2 = pcre2_substitute(
      self.code, &subjectBytes, (uint)subjectBytes.length(),
      (uint)0, subOpts,
      (int)0, (int)0,
      &replBytes, (uint)replBytes.length(),
      &outBuf, &actualLen
      );
      if rc2 < (i32)0 {
        throw "RegExp substitute failed";
      }
    } else if rc < (i32)0 && rc != (i32)-1 {
      throw "RegExp substitute failed";
    }
    if rc == (i32)-1 {
      return subject.clone();
    }
    return string.fromUtf8Bytes((byte[])outBuf, actualLen);
  }

  /**
   * Releases the underlying PCRE2 resources.
   * Must be called when the RegExp is no longer needed.
   */
  open func destroy(): void {
    if self.code != (int)0 {
      pcre2_code_free(self.code);
    }
  }
}

/**
 * Extends `string` with regex convenience methods.
 */
open fit string {

  /**
   * Returns whether this string matches the given regex pattern.
   * @param pattern - regex pattern string
   * @return true if the entire string matches
   */
  open func matches(pattern: string): bool {
    let re = RegExp(pattern);
    let result = re.isMatch(self);
    re.destroy();
    return result;
  }

  /**
   * Replaces all matches of a regex pattern with the replacement string.
   * @param pattern - regex pattern string
   * @param replacement - replacement string (supports $0..$9 backreferences)
   * @return new string with all matches replaced
   */
  open func replacePattern(pattern: string, replacement: string): string {
    let re = RegExp(pattern);
    let result = re.replaceAll(self, replacement);
    re.destroy();
    return result;
  }

  /**
   * Splits this string by a regex pattern.
   * @param pattern - regex pattern string
   * @return array of substrings
   */
  open func splitPattern(pattern: string): string[] {
    let re = RegExp(pattern);
    let result = re.split(self);
    re.destroy();
    return result;
  }

}
