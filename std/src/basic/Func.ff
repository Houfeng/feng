open module std;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action(): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T>(arg1: T): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2>(arg1: T1, arg2: T2): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2, T3>(arg1: T1, arg2: T2, arg3: T3): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2, T3, T4>(arg1: T1, arg2: T2, arg3: T3, arg4: T4): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2, T3, T4, T5>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2, T3, T4, T5, T6>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5, arg6: T6): void;

/**
 * The Action spec family defines function signatures that return void.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for callbacks, event handlers, and side-effect operations.
 */
open spec Action<T1, T2, T3, T4, T5, T6, T7>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5, arg6: T6, arg7: T7): void;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<R>(): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T, R>(arg1: T): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, R>(arg1: T1, arg2: T2): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, T3, R>(arg1: T1, arg2: T2, arg3: T3): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, T3, T4, R>(arg1: T1, arg2: T2, arg3: T3, arg4: T4): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, T3, T4, T5, R>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, T3, T4, T5, T6, R>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5, arg6: T6): R;

/**
 * The Func spec family defines function signatures that return a value of type R.
 * Each overload accepts a different number of arguments (0–7), providing
 * a standard contract for transformations, computations, and pure functions.
 *
 * The last type parameter is always the return type R; all preceding parameters
 * are argument types.
 */
open spec Func<T1, T2, T3, T4, T5, T6, T7, R>(arg1: T1, arg2: T2, arg3: T3, arg4: T4, arg5: T5, arg6: T6, arg7: T7): R;