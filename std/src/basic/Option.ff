open module std;

/**
 * None 类型，不占用任何内存空间，表示没有值。
 * 在 Feng 中没有 Null，通过 None 类型配合联合类型来表示可能没有值的情况。
 * 建议将 None 放在联合类型的开头，能让默认零值不占内存空间，开销更小。
 * 示例：
 * ```
 * spec OptionType = None | Type;
 * let value: OptionType = ...;
 * if value {
 *   Type { ... }
 *   None { ... }
 * }
 * ```
 */
open type None();

/**
 * Option 联合类型，表示可能没有值。
 * 示例：
 * ```
 * let value: Option<Type> = ...;
 * if value {
 *   Type { ... }
 *   None { ... }
 * }
 * ```
 */
open spec Option<T>: None | T;