open module std;

/**
 * The None type occupies no memory space and represents the absence of a value.
 * Feng has no Null; instead, None combined with union types expresses the possibility
 * of no value. It is recommended to place None at the beginning of a union type so
 * that the default zero value occupies no memory, resulting in lower overhead.
 *
 * Example:
 * ```
 * spec OptionType: None | Type;
 * let value: OptionType = ...;
 * if value {
 *   Type { ... }
 *   None { ... }
 * }
 * ```
 */
open type None();

/**
 * The None value.
 */
// open let none: None = ();

/**
 * The Option union type represents a value that may or may not be present.
 *
 * Example:
 * ```
 * let value: Option<Type> = ...;
 * if value {
 *   Type { ... }
 *   None { ... }
 * }
 * ```
 */
open spec Option<T>: None | T;