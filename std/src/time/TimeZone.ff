open module std.time;

import std.text;

// libc time functions
@cdecl("libc")
extern func time(tloc: i64*): i64;

@cdecl("libc")
extern func localtime_r(timep: i64*, result: i64*): i64*;

@cdecl("libc")
extern func setenv(name: string*, value: string*, overwrite: int): int;

@cdecl("libc")
extern func unsetenv(name: string*): int;

@cdecl("libc")
extern func tzset(): void;

@cdecl("libc")
extern func readlink(path: string*, buf: byte*, bufsiz: i64): i64;

// Runtime pointer primitives
@runtime
extern func feng_pointer_move(ptr: i64*, offset: i64): i64*;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: i64*): T;

// struct tm layout on 64-bit macOS/Linux:
// 9 x int32 fields (36 bytes) + 4 bytes padding + i64 tm_gmtoff + char* tm_zone = 56 bytes
seal let TM_BUF_LONGS: i64 = (i64)8;
seal let TM_GMTOFF_OFFSET: i64 = (i64)40;

/**
 * Read the tm_gmtoff field (UTC offset in seconds) from a struct tm buffer
 */
seal func readGmtOffset(tmBuf: i64[!]): i32 {
  let gmtoffPtr = feng_pointer_move(&tmBuf, TM_GMTOFF_OFFSET);
  let gmtoff: i64 = feng_pointer_get_scalar<i64>(gmtoffPtr);
  return (i32)gmtoff;
}

/**
 * Fill the buffer with the current local time struct tm data
 */
seal func fillLocalTm(tmBuf: i64[!]) {
  let t: i64[!] = i64[:(i64)1];
  t[0] = time(&t);
  let rc = localtime_r(&t, &tmBuf);
}

/**
 * Read the system IANA timezone identifier by resolving the /etc/localtime symlink.
 * Extracts the portion after "zoneinfo/" as the IANA ID.
 */
seal func readSystemZoneId(): string {
  let path = "/etc/localtime";
  let buf: byte[!] = byte[:(i64)256];
  let len = readlink(&path, &buf, (i64)256);
  if len <= (i64)0 {
    throw "time/timezone/readlink-failed";
  }
  // "zoneinfo/" = [122, 111, 110, 101, 105, 110, 102, 111, 47], length = 9
  let markerLen: i64 = (i64)9;
  var found: i64 = (i64) - 1;
  var i: i64 = (i64)0;
  while i <= len - markerLen {
    if buf[i] == (byte)122 && buf[i + (i64)1] == (byte)111
    && buf[i + (i64)2] == (byte)110 && buf[i + (i64)3] == (byte)101
    && buf[i + (i64)4] == (byte)105 && buf[i + (i64)5] == (byte)110
    && buf[i + (i64)6] == (byte)102 && buf[i + (i64)7] == (byte)111
    && buf[i + (i64)8] == (byte)47 {
      found = i + markerLen;
      break;
    }
    i += (i64)1;
  }
  if found < (i64)0 {
    throw "time/timezone/invalid-symlink";
  }
  let idLen = len - found;
  let idBytes: byte[!] = byte[:idLen];
  for var k: i64 = (i64)0; k < idLen; k += (i64)1 {
    idBytes[k] = buf[found + k];
  }
  return string.fromUtf8Bytes((byte[])idBytes);
}

/**
 * Timezone query utility.
 * Provides access to the current system timezone offset and identifier.
 */
open type TimeZone {

  seal func TimeZone() {}

  /**
   * Get the UTC offset in seconds for the given timezone identifier.
   * Temporarily sets the TZ environment variable and calls localtime_r to obtain the offset.
   * @param zoneId IANA timezone identifier (e.g. "Asia/Shanghai", "America/New_York")
   * @return UTC offset in seconds (positive for east, negative for west)
   */
  static func getZoneOffset(zoneId: string): i32 {
    let tzName = "TZ";
    let rc1 = setenv(&tzName, &zoneId, 1);
    if rc1 != 0 {
      throw "time/timezone/setenv-failed";
    }
    tzset();
    let tmBuf: i64[!] = i64[:TM_BUF_LONGS];
    fillLocalTm(tmBuf);
    let offset = readGmtOffset(tmBuf);
    let rc2 = unsetenv(&tzName);
    tzset();
    return offset;
  }

  /**
   * Get the current system IANA timezone identifier (e.g. "Asia/Shanghai", "America/New_York")
   * @return IANA timezone identifier string
   */
  static func currentZoneId(): string {
    return readSystemZoneId();
  }

  /**
   * Get the current system timezone UTC offset in seconds
   * @return UTC offset in seconds (positive for east, negative for west)
   */
  static func currentOffset(): i32 {
    let tmBuf: i64[!] = i64[:TM_BUF_LONGS];
    fillLocalTm(tmBuf);
    return readGmtOffset(tmBuf);
  }
}
