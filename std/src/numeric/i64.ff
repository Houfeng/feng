open module std.numeric;

import std;
import std.text;
import std.collections;

/**
 * Extends i64 (i64) with conversion operations.
 */
open fit i64: Display {
  /**
   * Returns the decimal string representation of this integer.
   * Uses negative accumulation to correctly handle the minimum value.
   * @return decimal string
   */
  open func toString(): string {
    if self == (i64)0 {
      return "0";
    }
    var v: i64 = self;
    var negative = false;
    if v > (i64)0 {
      v = -v;
    } else {
      negative = true;
    }
    let digits: byte[!] = byte[:(i64)20];
    var pos: i32 = 19;
    while v < (i64)0 {
      let digit: i32 = (i32)(-(v % (i64)10));
      digits[pos] = (byte)(digit + 48);
      v = v / (i64)10;
      pos = pos - 1;
    }
    if negative {
      digits[pos] = (byte)45;
      pos = pos - 1;
    }
    let start = (i64)(pos + 1);
    let result: byte[] = ((byte[])digits).clone(start, (i64)20);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into a i64 (i64) value.
   * Accepts an optional leading '+' or '-' sign followed by one or more digits.
   * Uses negative accumulation to correctly handle the full i64 range
   * including the minimum value -9223372036854775808.
   * @param text - decimal string to parse
   * @return parsed i64 value
   * @throws if text is empty, contains non-digit characters, or overflows i64 range
   */
  open static func parse(text: string): i64 {
    let bytes = text.toBytes();
    let len = bytes.length();
    if len == (i64)0 {
      throw "Invalid i64 string: empty";
    }
    var pos: i64 = 0;
    var negative = false;
    let first = bytes[(i64)0];
    if first == (byte)45 {
      negative = true;
      pos = (i64)1;
    } else if first == (byte)43 {
      pos = (i64)1;
    }
    if pos == len {
      throw "Invalid i64 string: no digits";
    }
    let minDiv10: i64 = (i64)-922337203685477580;
    var result: i64 = 0;
    while pos < len {
      let b = bytes[pos];
      if b < (byte)48 || b > (byte)57 {
        throw "Invalid i64 string: invalid character";
      }
      let digit: i64 = (i64)(b - (byte)48);
      if result < minDiv10 || (result == minDiv10 && digit > (i64)8) {
        throw "Invalid i64 string: overflow";
      }
      result = result * (i64)10 - digit;
      pos = pos + (i64)1;
    }
    if !negative {
      if result < (i64)-9223372036854775807 {
        throw "Invalid i64 string: overflow";
      }
      result = -result;
    }
    return result;
  }
}
