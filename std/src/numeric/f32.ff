open module std.numeric;

import std.text;
import std.collections;

@cdecl("libc")
extern func strtof(text: string*, end: long*): f32;

/**
 * Extends f32 with conversion operations.
 */
open fit f32 {
  /**
   * Parses a decimal string into an f32 value.
   * Accepts an optional leading '+' or '-' sign, followed by digits
   * with an optional decimal point.
   * @param text - decimal string to parse
   * @return parsed f32 value
   * @throws if text is empty or contains non-numeric characters
   */
  open static func parse(text: string): f32 {
    let len = text.length();
    if len == (long)0 {
      throw "Invalid f32 string: empty";
    }
    var endRaw: long = 0;
    let result = strtof(&text, &endRaw);
    let endPos: long* = feng_pointer_get_pointer(&endRaw);
    let endByte: byte = feng_pointer_get_scalar<byte>(endPos);
    if endByte != (byte)0 {
      throw "Invalid f32 string: invalid character";
    }
    return result;
  }
}
