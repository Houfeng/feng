open module std.numeric;

import std;
import std.text;
import std.collections;

@cdecl("libc")
extern func strtof(text: string*, end: int*): f32;

@cdecl("libc", "snprintf", 3)
extern func snprintf_f32(buf: byte*, size: uint, fmt: byte*, value: f32): i32;

/**
 * Extends f32 with conversion operations.
 */
open fit f32: Display {
  /**
   * Returns the decimal string representation of this f32 value.
   * Uses "%g" format which removes trailing zeros.
   * @return decimal string
   */
  open func toString(): string {
    let buf: byte[!] = byte[:(int)32];
    let fmt: byte[!] = byte[:(int)3];
    fmt[0] = (byte)37;  // '%'
    fmt[1] = (byte)103; // 'g'
    fmt[2] = (byte)0;   // '\0'
    let len = snprintf_f32(&buf, (uint)32, &fmt, self);
    let result: byte[] = ((byte[])buf).clone((int)0, (int)len);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into an f32 value.
   * Accepts an optional leading '+' or '-' sign, followed by digits
   * with an optional decimal point.
   * @param text - decimal string to parse
   * @return parsed f32 value
   * @throws if text is empty or contains non-numeric characters
   */
  open static func parse(text: string): f32 {
    let len = text.length();
    if len == (int)0 {
      throw "Invalid f32 string: empty";
    }
    var endRaw: int = 0;
    let result = strtof(&text, &endRaw);
    let endPos: int* = feng_pointer_get_pointer(&endRaw);
    let endByte: byte = feng_pointer_get_scalar<byte>(endPos);
    if endByte != (byte)0 {
      throw "Invalid f32 string: invalid character";
    }
    return result;
  }
}
