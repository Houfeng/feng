open module std.numeric;

import std;
import std.text;
import std.collections;

/**
 * Extends u8 (byte) with conversion operations.
 */
open fit u8: Display {
  /**
   * Returns the decimal string representation of this unsigned integer.
   * @return decimal string
   */
  open func toString(): string {
    if self == (byte)0 {
      return "0";
    }
    var v: i32 = (i32)self;
    let digits: byte[!] = byte[:(int)3];
    var pos: int = 2;
    while v > 0 {
      digits[pos] = (byte)((v % 10) + 48);
      v = v / 10;
      pos = pos - (int)1;
    }
    let start = pos + (int)1;
    let result: byte[] = ((byte[])digits).clone(start, (int)3);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into a byte (u8) value.
   * Accepts an optional leading '+' sign followed by one or more digits.
   * @param text - decimal string to parse
   * @return parsed byte value
   * @throws if text is empty, contains non-digit characters, has a '-' sign, or overflows u8 range
   */
  open static func parse(text: string): byte {
    let bytes = text.toBytes();
    let len = bytes.length();
    if len == (int)0 {
      throw "Invalid u8 string: empty";
    }
    var pos: int = 0;
    let first = bytes[(int)0];
    if first == (byte)45 {
      throw "Invalid u8 string: negative not allowed";
    } else if first == (byte)43 {
      pos = (int)1;
    }
    if pos == len {
      throw "Invalid u8 string: no digits";
    }
    var result: i64 = 0;
    while pos < len {
      let b = bytes[pos];
      if b < (byte)48 || b > (byte)57 {
        throw "Invalid u8 string: invalid character";
      }
      result = result * (i64)10 + (i64)(b - (byte)48);
      pos = pos + (int)1;
    }
    if result > (i64)255 {
      throw "Invalid u8 string: overflow";
    }
    return (byte)result;
  }
}
