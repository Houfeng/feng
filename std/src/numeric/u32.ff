open module std.numeric;

import std;
import std.text;
import std.collections;

/**
 * Extends u32 with conversion operations.
 */
open fit u32: Display {
  /**
   * Returns the decimal string representation of this unsigned integer.
   * @return decimal string
   */
  open func toString(): string {
    if self == (u32)0 {
      return "0";
    }
    var v: i64 = (i64)self;
    let digits: byte[!] = byte[:(int)10];
    var pos: int = 9;
    while v > (i64)0 {
      digits[pos] = (byte)((i32)(v % (i64)10) + 48);
      v = v / (i64)10;
      pos = pos - (int)1;
    }
    let start = pos + (int)1;
    let result: byte[] = ((byte[])digits).clone(start, (int)10);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into a u32 value.
   * Accepts an optional leading '+' sign followed by one or more digits.
   * @param text - decimal string to parse
   * @return parsed u32 value
   * @throws if text is empty, contains non-digit characters, has a '-' sign, or overflows u32 range
   */
  open static func parse(text: string): u32 {
    let bytes = text.toBytes();
    let len = bytes.length();
    if len == (int)0 {
      throw "Invalid u32 string: empty";
    }
    var pos: int = 0;
    let first = bytes[(int)0];
    if first == (byte)45 {
      throw "Invalid u32 string: negative not allowed";
    } else if first == (byte)43 {
      pos = (int)1;
    }
    if pos == len {
      throw "Invalid u32 string: no digits";
    }
    var result: i64 = 0;
    while pos < len {
      let b = bytes[pos];
      if b < (byte)48 || b > (byte)57 {
        throw "Invalid u32 string: invalid character";
      }
      result = result * (i64)10 + (i64)(b - (byte)48);
      pos = pos + (int)1;
    }
    if result > (i64)4294967295 {
      throw "Invalid u32 string: overflow";
    }
    return (u32)result;
  }
}
