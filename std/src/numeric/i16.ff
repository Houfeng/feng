open module std.numeric;

import std;
import std.text;
import std.collections;

/**
 * Extends i16 with conversion operations.
 */
open fit i16: Display {
  /**
   * Returns the decimal string representation of this integer.
   * @return decimal string
   */
  open func toString(): string {
    if self == (i16)0 {
      return "0";
    }
    var v: i32 = (i32)self;
    var negative = false;
    if v < 0 {
      negative = true;
      v = -v;
    }
    let digits: byte[!] = byte[:(i64)6];
    var pos: i32 = 5;
    while v > 0 {
      digits[pos] = (byte)((v % 10) + 48);
      v = v / 10;
      pos = pos - 1;
    }
    if negative {
      digits[pos] = (byte)45;
      pos = pos - 1;
    }
    let start = (i64)(pos + 1);
    let result: byte[] = ((byte[])digits).clone(start, (i64)6);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into an i16 value.
   * Accepts an optional leading '+' or '-' sign followed by one or more digits.
   * @param text - decimal string to parse
   * @return parsed i16 value
   * @throws if text is empty, contains non-digit characters, or overflows i16 range
   */
  open static func parse(text: string): i16 {
    let bytes = text.toBytes();
    let len = bytes.length();
    if len == (i64)0 {
      throw "Invalid i16 string: empty";
    }
    var pos: i64 = 0;
    var negative = false;
    let first = bytes[(i64)0];
    if first == (byte)45 {
      negative = true;
      pos = (i64)1;
    } else if first == (byte)43 {
      pos = (i64)1;
    }
    if pos == len {
      throw "Invalid i16 string: no digits";
    }
    var result: i64 = 0;
    while pos < len {
      let b = bytes[pos];
      if b < (byte)48 || b > (byte)57 {
        throw "Invalid i16 string: invalid character";
      }
      result = result * (i64)10 + (i64)(b - (byte)48);
      pos = pos + (i64)1;
    }
    if negative {
      result = -result;
    }
    if result < (i64)-32768 || result > (i64)32767 {
      throw "Invalid i16 string: overflow";
    }
    return (i16)result;
  }
}
