open module std.numeric;

import std.text;
import std.collections;

/**
 * Extends i32 with conversion operations.
 */
open fit i32 {
  /**
   * Returns the decimal string representation of this integer.
   * @return decimal string
   */
  open func toString(): string {
    if self == 0 {
      return "0";
    }
    var v = self;
    var negative = false;
    if v < 0 {
      negative = true;
      v = -v;
    }
    let digits: byte[!] = byte[: (long)11];
    var pos: i32 = 10;
    while v > 0 {
      digits[pos] = (byte)((v % 10) + 48);
      v = v / 10;
      pos = pos - 1;
    }
    if negative {
      digits[pos] = (byte)45;
      pos = pos - 1;
    }
    let start = (long)(pos + 1);
    let result: byte[] = ((byte[])digits).clone(start, (long)11);
    return string.fromUtf8Bytes(result);
  }
}
