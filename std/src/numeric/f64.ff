open module std.numeric;

import std;
import std.text;
import std.collections;

@cdecl("libc")
extern func strtod(text: string*, end: i64*): f64;

@cdecl("libc", "snprintf", 3)
extern func snprintf_f64(buf: byte*, size: i64, fmt: byte*, value: f64): i32;

@runtime
extern func feng_pointer_get_pointer(ptr: i64*): i64*;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: i64*): T;

/**
 * Extends f64 with conversion operations.
 */
open fit f64: Display {
  /**
   * Returns the decimal string representation of this f64 value.
   * Uses "%g" format which removes trailing zeros.
   * @return decimal string
   */
  open func toString(): string {
    let buf: byte[!] = byte[:(i64)32];
    let fmt: byte[!] = byte[:(i64)3];
    fmt[0] = (byte)37;  // '%'
    fmt[1] = (byte)103; // 'g'
    fmt[2] = (byte)0;   // '\0'
    let len = snprintf_f64(&buf, (i64)32, &fmt, self);
    let result: byte[] = ((byte[])buf).clone((i64)0, (i64)len);
    return string.fromUtf8Bytes(result);
  }

  /**
   * Parses a decimal string into an f64 value.
   * Accepts an optional leading '+' or '-' sign, followed by digits
   * with an optional decimal point.
   * @param text - decimal string to parse
   * @return parsed f64 value
   * @throws if text is empty or contains non-numeric characters
   */
  open static func parse(text: string): f64 {
    let len = text.length();
    if len == (i64)0 {
      throw "Invalid f64 string: empty";
    }
    var endRaw: i64 = 0;
    let result = strtod(&text, &endRaw);
    let endPos: i64* = feng_pointer_get_pointer(&endRaw);
    let endByte: byte = feng_pointer_get_scalar<byte>(endPos);
    if endByte != (byte)0 {
      throw "Invalid f64 string: invalid character";
    }
    return result;
  }
}
