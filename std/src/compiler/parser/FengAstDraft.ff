open module std.compiler.parser;

import std;
import std.text;
import std.compiler.lexer;

// ======================================================================
// AST 骨架草案（方案 B：联合类型）
//
// 每种节点定义独立 variant type，通过 spec 联合类型组合。
// 收窄后直接访问字段，无间接调用开销。
//
// 5 个节点大类:
//   TypeReference(3) / Expression(21) / Statement(14) / TypeMember(4) / Declaration(6)
// ======================================================================

// 可见性 & 可变性 --------------------------------------------------------------

/**
 * 可见性枚举类型
 * 语义阶段 resolve 默认值：
 * - 模块/顶层声明无关键字 → Private
 * - 类型成员无关键字 → Public
 */
open enum Visibility {
  Default = 0,
  Private = 1,
  Public = 2
}

/**
 * 可变性枚举类型
 * 语义阶段 resolve 默认值：
 * - 函数参数可省略，无 let/var → Let
 * - 绑定/字段必须显式指定 let/var
 */
open enum Mutability {
  Default = 0,
  Let = 1,
  Var = 2
}

// 类型引用 ---------------------------------------------------------------------

/**
 * 命名类型引用：int, std.text.String, Map<K, V>
 */
open type NamedTypeRef {
  let segments: StringSpan[];
  let parameterTypeRefs: TypeReference[];
}

/**
 * 指针类型引用：int*, string*
 */
open type PointerTypeRef {
  let targetTypeRef: TypeReference;
}

/**
 * 数组类型引用：int[], int[!]
 */
open type ArrayTypeRef {
  let elementTypeRef: TypeReference;
  let elementWritable: bool;
}

/**
 * 类型引用体，支持命名类型、指针类型、数组类型
 */
open spec TypeReferenceBody: NamedTypeRef
| PointerTypeRef
| ArrayTypeRef;

/**
 * 类型引用种类枚举类型
 */
open enum TypeReferenceKind {
  Named = 0,
  Pointer = 1,
  Array = 2
}

/**
 * 类型引用节点，出现在所有需要写类型的位置
 */
open type TypeReference {
  let token: FengToken;
  let kind: TypeReferenceKind;
  let body: TypeReferenceBody;
}

// 绑定 ------------------------------------------------------------------------

/**
 * 简单绑定：let x: int = 5;
 */
open type SimpleBinding {
  let token: FengToken;
  let name: StringSpan;
  let mutability: Mutability;
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
}

/**
 * 解构绑定：let (a, b) = (1, 2);
 */
open type DestructureBinding {
  let token: FengToken;
  let mutability: Mutability;
  let names: StringSpan[];
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
}

/**
 * 绑定联合类型，用于顶层/成员/局部绑定
 */
open spec Binding: SimpleBinding | DestructureBinding;

// 泛型参数 ---------------------------------------------------------------------

/**
 * 泛型参数节点，类型约束可省略
 */
open type GenericParameter {
  let token: FengToken;
  let name: StringSpan;
  let constraintTypeRef: Option<TypeReference>;
}

// 函数 ------------------------------------------------------------------------

/**
 * 函数参数节点，引用 SimpleBinding，支持可变参数
 */
open type Parameter {
  let binding: SimpleBinding;
  let isVariadic: bool;
}

/**
 * 函数节点，支持泛型参数、参数列表、返回类型、函数体、外部函数标记
 */
open type Function {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: Option<TypeReference>;
  let body: Block;
  let isExtern: bool;
}

// 基础表达式 -------------------------------------------------------------------

open type IdentifierExpr {
  let name: StringSpan;
}

open type BooleanLiteralExpr {
  let value: bool;
}

open type IntegerLiteralExpr {
  let value: i64;
  let raw: StringSpan;
}

open type FloatLiteralExpr {
  let value: f64;
  let raw: StringSpan;
}

open type StringLiteralExpr {
  let value: StringSpan;
}

open type UnaryExpr {
  let operator: FengTokenKind;
  let operand: Expression;
}

open type CastExpr {
  let targetType: TypeReference;
  let value: Expression;
}

open type BinaryExpr {
  let operator: FengTokenKind;
  let left: Expression;
  let right: Expression;
}

/**
 * 函数/方法调用表达式
 *
 * 泛型具化调用：
 * - 语法：`foo<int, string>(arg1, arg2)`
 * - 表示：callee 为 GenericTargetExpr { target: IdentifierExpr, argumentTypeRefs: [...] }
 *
 * 普通调用：
 * - 语法：`foo(arg1, arg2)`
 * - 表示：callee 为 IdentifierExpr
 *
 * 方法调用：
 * - 语法：`obj.method(arg1)`
 * - 表示：callee 为 MemberAccessExpr
 */
open type CallExpr {
  let callee: Expression;
  let arguments: Expression[];
}

open type ArrayLiteralExpr {
  let items: Expression[];
}

open type TupleLiteralExpr {
  let items: Expression[];
}

open type ObjectLiteralField {
  let token: FengToken;
  let name: StringSpan;
  let value: Expression;
}

open type ObjectLiteralExpr {
  let target: Expression;
  let fields: ObjectLiteralField[];
}

open type ArrayNewExpr {
  let elementTypeRef: TypeReference;
  let size: Expression;
}

/**
 * 泛型具化表达式：对目标显式指定类型实参
 *
 * 用途：
 * - 表示 `identifier<TypeArgs>` 语法结构
 * - 可作为 CallExpr 的 callee，或独立存在
 *
 * 示例：
 * - 泛型调用：`foo<int>(x)` → CallExpr { callee: GenericTargetExpr, arguments: [x] }
 * - 独立引用：`let f = foo<int>` → Binding { initializer: GenericTargetExpr }
 */
open type GenericTargetExpr {
  let target: Expression;
  let argumentTypeRefs: TypeReference[];
}

open type MemberAccessExpr {
  let target: Expression;
  let member: StringSpan;
}

open type IndexAccessExpr {
  let target: Expression;
  let index: Expression;
}

open spec LambdaBody: Expression | Block;

open type LambdaExpr {
  // 暂时，lambda 不支持泛型参数，后续扩展
  // let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let body: LambdaBody;
  let returnTypeRef: Option<TypeReference>;
}

open type RangeBounds {
  let low: Expression;
  let high: Expression;
}

open spec MatchTarget: Expression | TypeReference | RangeBounds | SimpleBinding;

open type MatchOperatorExpr {
  let left: Expression;
  let right: MatchTarget;
}

// 块表达式 ---------------------------------------------------------------------

open type IfExpr {
  let condition: Expression;
  let thenBlock: Block;
  let elseBlock: Block;
}

open type MatchExpr {
  let target: Expression;
  let branches: MatchBranch[];
  let elseBlock: Block;
}

open type TryExpr {
  let body: Expression;
  let catchClauses: TryCatchClause[];
}

// 表达式整体结构 ---------------------------------------------------------------

open enum ExpressionKind {
  Identifier = 0,
  BooleanLiteral = 1,
  IntegerLiteral = 2,
  FloatLiteral = 3,
  StringLiteral = 4,
  ArrayLiteral = 5,
  TupleLiteral = 6,
  ObjectLiteral = 7,
  ArrayNew = 8,
  GenericTarget = 9,
  Call = 10,
  MemberAccess = 11,
  IndexAccess = 12,
  Unary = 13,
  Binary = 14,
  Lambda = 15,
  Cast = 16,
  MatchOperator = 17,
  If = 18,
  Match = 19,
  Try = 20
}

open spec ExpressionBody: IdentifierExpr
| BooleanLiteralExpr
| IntegerLiteralExpr
| FloatLiteralExpr
| StringLiteralExpr
| ArrayLiteralExpr
| TupleLiteralExpr
| ObjectLiteralExpr
| ArrayNewExpr
| GenericTargetExpr
| CallExpr
| MemberAccessExpr
| IndexAccessExpr
| UnaryExpr
| BinaryExpr
| LambdaExpr
| CastExpr
| MatchOperatorExpr
| IfExpr
| MatchExpr
| TryExpr;

open type Expression {
  let token: FengToken;
  let kind: ExpressionKind;
  let body: ExpressionBody;
}

// 语句 ------------------------------------------------------------------------


// 类型 ------------------------------------------------------------------------



// ---- 辅助结构 ----

open type Annotation {
  let token: FengToken;
  let name: StringSpan;
  let arguments: Expression[];
}

open enum SpecificationForm {
  Object = 0,
  Callable = 1,
  Union = 2
}


open enum StatementKind {
  Block = 0,
  Binding = 1,
  Assignment = 2,
  Expression = 3,
  Try = 4,
  If = 5,
  Match = 6,
  While = 7,
  For = 8,
  Return = 9,
  Throw = 10,
  Break = 11,
  Continue = 12,
  Defer = 13
}

open enum TypeMemberKind {
  Field = 0,
  Method = 1,
  Constructor = 2,
  Finalizer = 3
}

open enum DeclarationKind {
  GlobalBinding = 0,
  Type = 1,
  Enumeration = 2,
  Specification = 3,
  Fit = 4,
  Function = 5
}

// ---- 辅助结构 ----

open type EnumerationItem {
  let token: FengToken;
  let name: StringSpan;
  let hasExplicitValue: bool;
  let explicitValue: i64;
}

open enum MatchLabelKind {
  Value = 0,
  Range = 1,
  Type = 2
}

open type MatchLabel {
  let token: FengToken;
  let kind: MatchLabelKind;
  let value: Expression;
  let rangeLow: Expression;
  let rangeHigh: Expression;
  let typeReference: TypeReference;
}

open type MatchBranch {
  let token: FengToken;
  let labels: MatchLabel[];
  let body: Block;
  let hasBinding: bool;
  let bindingName: StringSpan;
  let bindingMutability: Mutability;
}

open type TryCatchClause {
  let token: FengToken;
  let name: StringSpan;
  let typeReference: TypeReference;
  let body: Block;
}

open type IfClause {
  let token: FengToken;
  let condition: Expression;
  let body: Block;
}

open type Block {
  let token: FengToken;
  let statements: Statement[];
}

// ---- Statement variants (14) ----

open type BlockStatement {
  let block: Block;
}

open type BindingStatement {
  let binding: Binding;
}

open type AssignmentStatement {
  let operator: FengTokenKind;
  let target: Expression;
  let value: Expression;
}

open type ExpressionStatement {
  let expression: Expression;
}

open type TryStatement {
  let body: Expression;
  let catchClauses: TryCatchClause[];
}

open type IfStatement {
  let clauses: IfClause[];
  let elseBlock: Block;
}

open type MatchStatement {
  let target: Expression;
  let branches: MatchBranch[];
  let elseBlock: Block;
}

open type WhileStatement {
  let condition: Expression;
  let body: Block;
}

open type ForStatement {
  let isForIn: bool;
  let body: Block;
  let init: Statement;
  let condition: Expression;
  let update: Statement;
  let iterBinding: Binding;
  let iterExpression: Expression;
}

open type ReturnStatement {
  let value: Expression;
}

open type ThrowStatement {
  let value: Expression;
}

open type BreakStatement {
}

open type ContinueStatement {
}

open type DeferStatement {
  let body: Block;
}

open spec StatementBody:
BlockStatement
| BindingStatement
| AssignmentStatement
| ExpressionStatement
| TryStatement
| IfStatement
| MatchStatement
| WhileStatement
| ForStatement
| ReturnStatement
| ThrowStatement
| BreakStatement
| ContinueStatement
| DeferStatement;

open type Statement {
  let token: FengToken;
  let kind: StatementKind;
  let body: StatementBody;
}

// ---- TypeMember variants (4) ----

open type FieldMember {
  let binding: Binding;
}

open type MethodMember {
  let function: Function;
}

open type ConstructorMember {
  let function: Function;
}

open type FinalizerMember {
  let function: Function;
}

open spec TypeMemberBody: FieldMember | MethodMember | ConstructorMember | FinalizerMember;

open type TypeMember {
  let token: FengToken;
  let kind: TypeMemberKind;
  let visibility: Visibility;
  let isStatic: bool;
  let docComment: StringSpan;
  let annotations: Annotation[];
  let body: TypeMemberBody;
}

// ---- Declaration variants (6) ----

open type BindingDeclaration {
  let binding: Binding;
}

open type TypeDeclaration {
  let name: StringSpan;
  let typeParameters: GenericParameter[];
  let members: TypeMember[];
  let declaredSpecifications: TypeReference[];
  let isTuple: bool;
  let isValue: bool;
}

open type EnumerationDeclaration {
  let name: StringSpan;
  let items: EnumerationItem[];
}

open type SpecificationDeclaration {
  let name: StringSpan;
  let typeParameters: GenericParameter[];
  let form: SpecificationForm;
  let parentSpecifications: TypeReference[];
  let objectMembers: TypeMember[];
  let callableParameters: Parameter[];
  let callableReturnType: TypeReference;
  let unionMembers: TypeReference[];
}

open type FitDeclaration {
  let target: TypeReference;
  let specifications: TypeReference[];
  let members: TypeMember[];
  let hasBody: bool;
}

open type FunctionDeclaration {
  let function: Function;
}

open spec DeclarationBody:
BindingDeclaration
| TypeDeclaration
| EnumerationDeclaration
| SpecificationDeclaration
| FitDeclaration
| FunctionDeclaration;

open type GlobalDeclaration {
  let token: FengToken;
  let kind: DeclarationKind;
  let visibility: Visibility;
  let isExtern: bool;
  let docComment: StringSpan;
  let annotations: Annotation[];
  let body: DeclarationBody;
}

// ---- Program ----

open type ImportDeclaration {
  let token: FengToken;
  let segments: StringSpan[];
  let alias: StringSpan;
  let hasAlias: bool;
}

open type Program {
  let path: string;
  let moduleToken: FengToken;
  let moduleVisibility: Visibility;
  let moduleSegments: StringSpan[];
  let imports: ImportDeclaration[];
  let declarations: GlobalDeclaration[];
}
