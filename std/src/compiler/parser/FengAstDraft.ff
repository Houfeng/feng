open module std.compiler.parser;

import std;
import std.text;
import std.compiler.lexer;

// 可见性 & 可变性 --------------------------------------------------------------

/**
 * 可见性枚举类型
 * 语义阶段 resolve 默认值：
 * - 模块/顶层声明无 open/seal 关键字 → Seal
 * - 类型成员无关键字 → Open
 */
open enum Visibility {
  Default = 0,
  Seal = 1,
  Open = 2
}

/**
 * 可变性枚举类型
 * 语义阶段 resolve 默认值：
 * - 函数参数可省略，无 let/var 关键字 → Let
 * - 绑定/字段必须显式指定 let/var
 */
open enum Mutability {
  Default = 0,
  Let = 1,
  Var = 2
}

// 类型引用 ---------------------------------------------------------------------

/**
 * 多段命名标识符，用于类型引用、模块路径等
 *
 * segments 字段：
 * - segments[0] 为最左侧标识符，segments[n] 为最右侧标识符
 * - segments 数组长度至少为 1
 */
open type SegmentedName {
  let token: FengToken;
  let fullName: StringSpan;
  let segments: StringSpan[];
}

/**
 * 命名类型引用：int, std.text.String, Map<K, V>
 *
 * 与表达式级 MemberAccessExpr 的差异：
 * - 类型位置语法仅允许标识符链（如 std.text.String），不含运行时表达式
 * - 因此 Parser 直接识别为多段 segments 数组，而非嵌套 MemberAccess
 * - 语义阶段按 segments 顺序解析：模块路径 → 类型查找 → 泛型实参代入
 */
open type NamedTypeRef {
  let name: SegmentedName;
  let parameterTypeRefs: TypeReference[];
}

/**
 * 指针类型引用：int*, string*
 */
open type PointerTypeRef {
  let targetTypeRef: TypeReference;
}

/**
 * 数组类型引用：int[], int[!]
 */
open type ArrayTypeRef {
  let elementTypeRef: TypeReference;
  let elementWritable: bool;
}

/**
 * 类型引用体，支持命名类型、指针类型、数组类型
 */
open spec TypeReferenceBody: NamedTypeRef
| PointerTypeRef
| ArrayTypeRef;

/**
 * 类型引用节点，出现在所有需要写类型的位置
 */
open type TypeReference {
  let token: FengToken;
  let body: TypeReferenceBody;
}

// 绑定 ------------------------------------------------------------------------

/**
 * 简单绑定：let x: int = 5;
 */
open type SimpleBinding {
  let token: FengToken;
  let name: StringSpan;
  let mutability: Mutability;
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
  let annotations: Annotation[];
}

/**
 * 解构绑定：let (a, b) = (1, 2);
 */
open type DestructureBinding {
  let token: FengToken;
  let mutability: Mutability;
  let names: StringSpan[];
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
  let annotations: Annotation[];
}

/**
 * 绑定联合类型，用于顶层/成员/局部绑定
 */
open spec Binding: SimpleBinding | DestructureBinding;

// 泛型参数 ---------------------------------------------------------------------

/**
 * 泛型参数节点，类型约束可省略
 */
open type GenericParameter {
  let token: FengToken;
  let name: StringSpan;
  let constraintTypeRef: Option<TypeReference>;
}

// 函数 ------------------------------------------------------------------------

/**
 * 函数参数节点，引用 SimpleBinding，支持可变参数
 */
open type Parameter {
  let binding: SimpleBinding;
  let isVariadic: bool;
}

/**
 * 函数节点，支持泛型参数、参数列表、返回类型、函数体、外部函数标记
 */
open type Function {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: Option<TypeReference>;
  let annotations: Annotation[];
  let body: Block;
}

// 基础表达式 -------------------------------------------------------------------

open type IdentifierExpr {
  let name: StringSpan;
}

open type BooleanLiteralExpr {
  let value: bool;
}

open type IntegerLiteralExpr {
  let value: i64;
  let raw: StringSpan;
}

open type FloatLiteralExpr {
  let value: f64;
  let raw: StringSpan;
}

open type StringLiteralExpr {
  let value: StringSpan;
}

open type UnaryExpr {
  let operator: FengTokenKind;
  let operand: Expression;
}

open type CastExpr {
  let targetType: TypeReference;
  let value: Expression;
}

open type BinaryExpr {
  let operator: FengTokenKind;
  let left: Expression;
  let right: Expression;
}

/**
 * 函数/方法调用表达式
 *
 * 泛型具化调用：
 * - 语法：`foo<int, string>(arg1, arg2)`
 * - 表示：callee 为 GenericTargetExpr { target: IdentifierExpr, argumentTypeRefs: [...] }
 *
 * 普通调用：
 * - 语法：`foo(arg1, arg2)`
 * - 表示：callee 为 IdentifierExpr
 *
 * 方法调用：
 * - 语法：`obj.method(arg1)`
 * - 表示：callee 为 MemberAccessExpr
 */
open type CallExpr {
  let callee: Expression;
  let arguments: Expression[];
}

open type ArrayLiteralExpr {
  let items: Expression[];
}

open type TupleLiteralExpr {
  let items: Expression[];
}

open type ObjectLiteralField {
  let token: FengToken;
  let name: StringSpan;
  let value: Expression;
}

open type ObjectLiteralExpr {
  let target: Expression;
  let fields: ObjectLiteralField[];
}

open type ArrayNewExpr {
  let elementTypeRef: TypeReference;
  let size: Expression;
}

/**
 * 泛型具化表达式：对目标显式指定类型实参
 *
 * 用途：
 * - 表示 `identifier<TypeArgs>` 语法结构
 * - 可作为 CallExpr 的 callee，或独立存在
 *
 * 示例：
 * - 泛型调用：`foo<int>(x)` → CallExpr { callee: GenericTargetExpr, arguments: [x] }
 * - 独立引用：`let f = foo<int>` → Binding { initializer: GenericTargetExpr }
 */
open type GenericTargetExpr {
  let target: Expression;
  let argumentTypeRefs: TypeReference[];
}

/**
 * 成员访问表达式：obj.field, std.foo.test
 *
 * 多段路径解析策略：
 * - 语法：`foo.bar.xyz` 按 `.` 左结合嵌套解析
 * - AST：MemberAccess(MemberAccess(Identifier("foo"), "bar"), "xyz")
 * - 语义阶段逐层消歧：从最左标识符查作用域，按解析结果切换查找策略
 *   - 若 `foo` 为模块 → `foo.bar` 按模块成员查找（子模块/类型/函数/绑定）
 *   - 若 `foo` 为值/类型 → `foo.bar` 按成员访问处理
 *   - 同一条链可混合：`std.text.String`（模块路径）+ `.length()`（方法访问）
 *
 * 与类型位置 NamedTypeRef.segments 的差异：
 * - 表达式位置允许运行时表达式（如 `obj.field`），Parser 无法预判语义
 * - 因此统一解析为嵌套 MemberAccess，由语义阶段消歧
 * - 类型位置仅允许标识符链，Parser 直接识别为 segments 数组
 */
open type MemberAccessExpr {
  let target: Expression;
  let member: StringSpan;
}

open type IndexAccessExpr {
  let target: Expression;
  let index: Expression;
}

open spec LambdaBody: Expression | Block;

open type LambdaExpr {
  // 暂时，lambda 不支持泛型参数，后续扩展
  // let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let body: LambdaBody;
  let returnTypeRef: Option<TypeReference>;
}

open type RangeExpr {
  let start: Expression;
  let end: Expression;
}

open spec MatchTarget: IntegerLiteralExpr
| StringLiteralExpr
| BooleanLiteralExpr
| MemberAccessExpr
| TypeReference
| SimpleBinding;

/**
 * 匹配运算符表达式：value match pattern1 | pattern2 | ...
 *
 * 解析策略：
 * - 贪婪消费所有 `|` 分隔的匹配目标
 */
open type MatchOperatorExpr {
  let value: Expression;
  let targets: MatchTarget[];
}

// 块表达式 ---------------------------------------------------------------------

open type IfClause {
  let token: FengToken;
  let condition: Expression;
  let body: Block;
}

open type IfExpr {
  let clauses: IfClause[];
  let elseBlock: Block;
}

/** Match Targets 的分支辅助结构 */
open type MatchClause {
  let token: FengToken;
  let targets: MatchTarget[];
  let body: Block;
}

open type MatchExpr {
  let target: Expression;
  let clauses: MatchClause[];
  let elseBlock: Block;
}

open type CatchClause {
  let token: FengToken;
  let binding: SimpleBinding;
  let body: Block;
}

open type TryExpr {
  let body: Expression;
  let catchClauses: CatchClause[];
  let catchAllBlock: Option<Block>;
}

// 表达式整体结构 ---------------------------------------------------------------

open spec ExpressionBody: IdentifierExpr
| BooleanLiteralExpr
| IntegerLiteralExpr
| FloatLiteralExpr
| StringLiteralExpr
| ArrayLiteralExpr
| TupleLiteralExpr
| ObjectLiteralExpr
| ArrayNewExpr
| GenericTargetExpr
| CallExpr
| MemberAccessExpr
| IndexAccessExpr
| UnaryExpr
| BinaryExpr
| LambdaExpr
| CastExpr
| MatchOperatorExpr
| IfExpr
| MatchExpr
| TryExpr
| RangeExpr;

open type Expression {
  let token: FengToken;
  // let annotations: Annotation[];
  let body: ExpressionBody;
}

// 块结构 ----------------------------------------------------------------------

open type Block {
  let token: FengToken;
  let statements: Statement[];
}

// 语句 ------------------------------------------------------------------------

open type BlockStmt {
  let block: Block;
}

open type BindingStmt {
  let binding: Binding;
}

/**
 * 赋值语句，支持简单赋值和复合赋值
 * operator: = / += / -= / *= / /= 等
 */
open type AssignmentStmt {
  let operator: FengTokenKind;
  let target: Expression;
  let value: Expression;
}

open type ExpressionStmt {
  let expression: Expression;
}

open type TryStmt {
  let body: Expression;
  let catchClauses: CatchClause[];
  let catchAllBlock: Option<Block>;
}

open type IfStmt {
  let clauses: IfClause[];
  let elseBlock: Block;
}

open type MatchStmt {
  let target: Expression;
  let clauses: MatchClause[];
  let elseBlock: Block;
}

open type WhileStmt {
  let condition: Expression;
  let body: Block;
}

open spec ForInit: SimpleBinding | AssignmentStmt;
open spec ForUpdate: Expression | AssignmentStmt;

open type ForStmt {
  let init: ForInit;
  let condition: Expression;
  let update: ForUpdate;
  let body: Block;
}

open type ForEachStmt {
  let binding: Binding;
  let iterable: Expression;
  let body: Block;
}

open type ReturnStmt {
  let value: Expression;
}

open type ThrowStmt {
  let value: Expression;
}

open type BreakStmt {}

open type ContinueStmt {}

open type DeferStmt {
  let body: Block;
}

open spec StatementBody: BlockStmt
| BindingStmt
| AssignmentStmt
| ExpressionStmt
| TryStmt
| IfStmt
| MatchStmt
| WhileStmt
| ForStmt
| ForEachStmt
| ReturnStmt
| ThrowStmt
| BreakStmt
| ContinueStmt
| DeferStmt;

open type Statement {
  let token: FengToken;
  let body: StatementBody;
}

// 类型 (type) -----------------------------------------------------------------

open type TypeField {
  let binding: SimpleBinding;
}

open type TypeMethod {
  let function: Function;
}

open type TypeConstructor {
  let function: Function;
}

open type TypeFinalizer {
  let function: Function;
}

open spec TypeMemberBody: TypeField
| TypeMethod
| TypeConstructor
| TypeFinalizer;

open type TypeMember {
  let token: FengToken;
  let visibility: Visibility;
  let isStatic: bool;
  let comment: StringSpan;
  let body: TypeMemberBody;
}

open type TypeDeclaration {
  let token: FengToken;
  let name: StringSpan;
  let visibility: Visibility;
  let genericParameter: GenericParameter[];
  let members: TypeMember[];
  let specs: TypeReference[];
  let annotations: Annotation[];
  let isTuple: bool;
  let isValue: bool;
}

// 枚举 (enum) -----------------------------------------------------------------

open type EnumItem {
  let token: FengToken;
  let name: StringSpan;
  let hasExplicitValue: bool;
  let explicitValue: i64;
}

open type EnumDeclaration {
  let token: FengToken;
  let name: StringSpan;
  let annotations: Annotation[];
  let items: EnumItem[];
}

// 契约 (spec) -----------------------------------------------------------------

/**
 * 对象契约：定义类型需实现的成员集合
 * spec Named { let name: string; func greet(): string; }
 */
open type ObjectSpec {
  let genericParameter: GenericParameter[];
  let members: TypeMember[];
  let parentTypeRefs: TypeReference[];
}

/**
 * 可调用契约：定义函数签名
 * spec Predicate<T>: (T) -> bool;
 */
open type CallableSpec {
  let genericParameter: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: TypeReference;
}

/**
 * 联合契约：定义可选类型集合
 * spec Option<T>: Some<T> | None;
 */
open type UnionSpec {
  let memberTypeRefs: TypeReference[];
}

open spec SpecBody: ObjectSpec
| CallableSpec
| UnionSpec;

/**
 * 契约声明节点
 */
open type SpecDeclaration {
  let token: FengToken;
  let name: StringSpan;
  let annotations: Annotation[];
  let body: SpecBody;
}

// 适配器 (fit) ----------------------------------------------------------------

/**
 * 适配器声明：fit TargetType: Spec1, Spec2 { ... }
 *
 * members 字段：
 * - Some(members): 有实现体，包含适配方法/字段
 * - None: 无实现体（仅声明适配关系）
 */
open type FitDeclaration {
  let targetTypeRef: TypeReference;
  let specTypeRefs: TypeReference[];
  let members: Option<TypeMember[]>;
}

// 注解 (annotation) -----------------------------------------------------------

/**
 * 注解节点：@test, @std.compiler.deprecated, @test(args)
 *
 * name 字段（SegmentedName）：
 * - 简单注解：@test → segments: ["test"]
 * - 限定名注解：@std.compiler.deprecated → segments: ["std", "compiler", "deprecated"]
 * - 语义阶段按 segments 顺序解析：模块路径 → 注解定义查找
 *
 * arguments 字段：
 * - 注解参数列表，如 @test("reason", 2024) 中的参数
 * - 无参数时为空数组
 */
open type Annotation {
  let token: FengToken;
  let name: SegmentedName;
  let arguments: Expression[];
}

// 模块 (module) ---------------------------------------------------------------

open type ModuleLevelBinding {
  let binding: SimpleBinding;
}

open type ModuleLevelFunction {
  let isExtern: bool;
  let function: Function;
}

open spec ModuleMemberBody: ModuleLevelBinding
| ModuleLevelFunction
| TypeDeclaration
| EnumDeclaration
| SpecDeclaration
| FitDeclaration;

open type ModuleMember {
  let token: FengToken;
  let name: StringSpan;
  let visibility: Visibility;
  let body: ModuleMemberBody;
}

/**
 * 模块导入声明：import std.text; import std.text as txt;
 *
 * alias 字段：
 * - Some(alias): 有别名，如 import std.text as txt
 * - None: 无别名，如 import std.text
 */
open type ModuleImport {
  let token: FengToken;
  let name: SegmentedName;
  let alias: Option<StringSpan>;
}

open type ModuleFile {
  let path: string;
  let imports: ModuleImport[];
}

open type ModuleDeclaration {
  let token: FengToken;
  let visibility: Visibility;
  let name: SegmentedName;
  let files: ModuleFile[];
  let members: ModuleMember[];
}

// 程序 (program) --------------------------------------------------------------

open type Program {
  let modules: ModuleDeclaration[];
}
