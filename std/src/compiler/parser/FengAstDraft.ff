open module std.compiler.parser;

import std.text;
import std.compiler.lexer;

// ======================================================================
// AST 骨架草案（方案 B：联合类型）
//
// 每种节点定义独立 variant type，通过 spec 联合类型组合。
// 收窄后直接访问字段，无间接调用开销。
//
// 5 个节点大类:
//   TypeReference(3) / Expression(22) / Statement(14) / TypeMember(4) / Declaration(6)
// ======================================================================

// 可见性 & 可变性 --------------------------------------------------------------

/**
 * 可见性枚举类型
 * Parser 阶段 resolve 默认值：
 * - 模块/顶层声明无关键字 → Private
 * - 类型成员无关键字 → Public
 */
open enum Visibility {
  Private = 0,
  Public = 1
}

/**
 * 可变性枚举类型
 * Parser 阶段 resolve 默认值：
 * - 函数参数可省略，无 let/var → Let
 * - 绑定/字段必须显式指定 let/var
 */
open enum Mutability {
  Let = 0,
  Var = 1
}

// 类型引用 ---------------------------------------------------------------------

/**
 * 命名类型引用：int, std.text.String, Map<K, V>
 */
open type TypeReferenceNamedBody {
  let segments: StringSpan[];
  let typeArguments: TypeReference[];
}

/**
 * 指针类型引用：int*, string*
 */
open type TypeReferencePointerBody {
  let inner: TypeReference;
}

/**
 * 数组类型引用：int[], int[!]
 */
open type TypeReferenceArrayBody {
  let inner: TypeReference;
  let elementWritable: bool;
}

open spec TypeReferenceBody: TypeReferenceNamedBody
| TypeReferencePointerBody
| TypeReferenceArrayBody;

open enum TypeReferenceKind {
  Named = 0,
  Pointer = 1,
  Array = 2
}

/**
 * 类型引用节点，出现在所有需要写类型的位置
 */
open type TypeReference {
  let token: FengToken;
  let kind: TypeReferenceKind;
  let body: TypeReferenceBody;
}

// 绑定 ------------------------------------------------------------------------

/**
 * 绑定节点，用于顶层/成员/局部绑定
 */
open type Binding {
  let token: FengToken;
  let name: StringSpan;
  let typeReference: TypeReference;
  let initializer: Expression;
  let mutability: Mutability;
  let isDestructure: bool;
  let destructureNames: StringSpan[];
}

// 泛型参数 ---------------------------------------------------------------------

/**
 * 泛型参数节点，类型约束可省略
 */
open type GenericParameter {
  let token: FengToken;
  let name: StringSpan;
  let typeRef: TypeReference;
}

// 函数 ------------------------------------------------------------------------

/**
 * 函数参数节点，支持可变性和可变参数
 */
open type Parameter {
  let token: FengToken;
  let name: StringSpan;
  let typeRef: TypeReference;
  let mutability: Mutability;
  let isVariadic: bool;
}

/**
 * 函数节点，支持泛型参数、参数列表、返回类型、函数体、外部函数标记
 */
open type Function {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnType: TypeReference;
  let body: Block;
  let isExtern: bool;
}


// 类型 ------------------------------------------------------------------------



// ---- 辅助结构 ----

open type Annotation {
  let token: FengToken;
  let name: StringSpan;
  let arguments: Expression[];
}

open enum SpecificationForm {
  Object = 0,
  Callable = 1,
  Union = 2
}

open enum ExpressionKind {
  Identifier = 0,
  SelfReference = 1,
  BooleanLiteral = 2,
  IntegerLiteral = 3,
  FloatLiteral = 4,
  StringLiteral = 5,
  ArrayLiteral = 6,
  TupleLiteral = 7,
  ObjectLiteral = 8,
  GenericTarget = 9,
  Call = 10,
  MemberAccess = 11,
  IndexAccess = 12,
  UnaryOperation = 13,
  BinaryOperation = 14,
  Lambda = 15,
  Cast = 16,
  If = 17,
  Match = 18,
  Try = 19,
  ArrayNew = 20,
  MatchOperator = 21
}

open enum StatementKind {
  Block = 0,
  Binding = 1,
  Assignment = 2,
  Expression = 3,
  Try = 4,
  If = 5,
  Match = 6,
  While = 7,
  For = 8,
  Return = 9,
  Throw = 10,
  Break = 11,
  Continue = 12,
  Defer = 13
}

open enum TypeMemberKind {
  Field = 0,
  Method = 1,
  Constructor = 2,
  Finalizer = 3
}

open enum DeclarationKind {
  GlobalBinding = 0,
  Type = 1,
  Enumeration = 2,
  Specification = 3,
  Fit = 4,
  Function = 5
}

// ---- 辅助结构 ----

open type EnumerationItem {
  let token: FengToken;
  let name: StringSpan;
  let hasExplicitValue: bool;
  let explicitValue: i64;
}

open type ObjectFieldInitializer {
  let token: FengToken;
  let name: StringSpan;
  let value: Expression;
}

open enum MatchLabelKind {
  Value = 0,
  Range = 1,
  Type = 2
}

open type MatchLabel {
  let token: FengToken;
  let kind: MatchLabelKind;
  let value: Expression;
  let rangeLow: Expression;
  let rangeHigh: Expression;
  let typeReference: TypeReference;
}

open type MatchBranch {
  let token: FengToken;
  let labels: MatchLabel[];
  let body: Block;
  let hasBinding: bool;
  let bindingName: StringSpan;
  let bindingMutability: Mutability;
}

open type TryCatchClause {
  let token: FengToken;
  let name: StringSpan;
  let typeReference: TypeReference;
  let body: Block;
}

open type IfClause {
  let token: FengToken;
  let condition: Expression;
  let body: Block;
}

open type Block {
  let token: FengToken;
  let statements: Statement[];
}

// ---- Expression variants (22) ----

open type IdentifierExpression {
  let name: StringSpan;
}

open type SelfReferenceExpression {
}

open type BooleanLiteralExpression {
  let value: bool;
}

open type IntegerLiteralExpression {
  let value: i64;
  let raw: StringSpan;
}

open type FloatLiteralExpression {
  let value: f64;
  let raw: StringSpan;
}

open type StringLiteralExpression {
  let value: StringSpan;
}

open type ArrayLiteralExpression {
  let items: Expression[];
}

open type TupleLiteralExpression {
  let items: Expression[];
}

open type ObjectLiteralExpression {
  let target: Expression;
  let fields: ObjectFieldInitializer[];
}

open type GenericTargetExpression {
  let target: Expression;
  let typeArguments: TypeReference[];
}

open type CallExpression {
  let callee: Expression;
  let arguments: Expression[];
  let explicitTypeArguments: TypeReference[];
}

open type MemberAccessExpression {
  let object: Expression;
  let memberName: StringSpan;
}

open type IndexAccessExpression {
  let object: Expression;
  let index: Expression;
}

open type UnaryOperationExpression {
  let operator: FengTokenKind;
  let operand: Expression;
}

open type BinaryOperationExpression {
  let operator: FengTokenKind;
  let left: Expression;
  let right: Expression;
}

open type LambdaExpression {
  let parameters: Parameter[];
  let expressionBody: Expression;
  let blockBody: Block;
  let isBlockBody: bool;
}

open type CastExpression {
  let targetType: TypeReference;
  let value: Expression;
}

open type IfExpression {
  let condition: Expression;
  let thenBlock: Block;
  let elseBlock: Block;
}

open type MatchExpression {
  let target: Expression;
  let branches: MatchBranch[];
  let elseBlock: Block;
}

open type TryExpression {
  let body: Expression;
  let catchClauses: TryCatchClause[];
}

open type ArrayNewExpression {
  let elementType: TypeReference;
  let size: Expression;
}

open type MatchOperatorExpression {
  let target: Expression;
  let labels: MatchLabel[];
  let hasBinding: bool;
  let bindingName: StringSpan;
  let bindingMutability: Mutability;
}

open spec ExpressionBody:
IdentifierExpression
| SelfReferenceExpression
| BooleanLiteralExpression
| IntegerLiteralExpression
| FloatLiteralExpression
| StringLiteralExpression
| ArrayLiteralExpression
| TupleLiteralExpression
| ObjectLiteralExpression
| GenericTargetExpression
| CallExpression
| MemberAccessExpression
| IndexAccessExpression
| UnaryOperationExpression
| BinaryOperationExpression
| LambdaExpression
| CastExpression
| IfExpression
| MatchExpression
| TryExpression
| ArrayNewExpression
| MatchOperatorExpression;

open type Expression {
  let token: FengToken;
  let kind: ExpressionKind;
  let body: ExpressionBody;
}

// ---- Statement variants (14) ----

open type BlockStatement {
  let block: Block;
}

open type BindingStatement {
  let binding: Binding;
}

open type AssignmentStatement {
  let operator: FengTokenKind;
  let target: Expression;
  let value: Expression;
}

open type ExpressionStatement {
  let expression: Expression;
}

open type TryStatement {
  let body: Expression;
  let catchClauses: TryCatchClause[];
}

open type IfStatement {
  let clauses: IfClause[];
  let elseBlock: Block;
}

open type MatchStatement {
  let target: Expression;
  let branches: MatchBranch[];
  let elseBlock: Block;
}

open type WhileStatement {
  let condition: Expression;
  let body: Block;
}

open type ForStatement {
  let isForIn: bool;
  let body: Block;
  let init: Statement;
  let condition: Expression;
  let update: Statement;
  let iterBinding: Binding;
  let iterExpression: Expression;
}

open type ReturnStatement {
  let value: Expression;
}

open type ThrowStatement {
  let value: Expression;
}

open type BreakStatement {
}

open type ContinueStatement {
}

open type DeferStatement {
  let body: Block;
}

open spec StatementBody:
BlockStatement
| BindingStatement
| AssignmentStatement
| ExpressionStatement
| TryStatement
| IfStatement
| MatchStatement
| WhileStatement
| ForStatement
| ReturnStatement
| ThrowStatement
| BreakStatement
| ContinueStatement
| DeferStatement;

open type Statement {
  let token: FengToken;
  let kind: StatementKind;
  let body: StatementBody;
}

// ---- TypeMember variants (4) ----

open type FieldMember {
  let binding: Binding;
}

open type MethodMember {
  let function: Function;
}

open type ConstructorMember {
  let function: Function;
}

open type FinalizerMember {
  let function: Function;
}

open spec TypeMemberBody: FieldMember | MethodMember | ConstructorMember | FinalizerMember;

open type TypeMember {
  let token: FengToken;
  let kind: TypeMemberKind;
  let visibility: Visibility;
  let isStatic: bool;
  let docComment: StringSpan;
  let annotations: Annotation[];
  let body: TypeMemberBody;
}

// ---- Declaration variants (6) ----

open type BindingDeclaration {
  let binding: Binding;
}

open type TypeDeclaration {
  let name: StringSpan;
  let typeParameters: GenericParameter[];
  let members: TypeMember[];
  let declaredSpecifications: TypeReference[];
  let isTuple: bool;
  let isValue: bool;
}

open type EnumerationDeclaration {
  let name: StringSpan;
  let items: EnumerationItem[];
}

open type SpecificationDeclaration {
  let name: StringSpan;
  let typeParameters: GenericParameter[];
  let form: SpecificationForm;
  let parentSpecifications: TypeReference[];
  let objectMembers: TypeMember[];
  let callableParameters: Parameter[];
  let callableReturnType: TypeReference;
  let unionMembers: TypeReference[];
}

open type FitDeclaration {
  let target: TypeReference;
  let specifications: TypeReference[];
  let members: TypeMember[];
  let hasBody: bool;
}

open type FunctionDeclaration {
  let function: Function;
}

open spec DeclarationBody:
BindingDeclaration
| TypeDeclaration
| EnumerationDeclaration
| SpecificationDeclaration
| FitDeclaration
| FunctionDeclaration;

open type GlobalDeclaration {
  let token: FengToken;
  let kind: DeclarationKind;
  let visibility: Visibility;
  let isExtern: bool;
  let docComment: StringSpan;
  let annotations: Annotation[];
  let body: DeclarationBody;
}

// ---- Program ----

open type ImportDeclaration {
  let token: FengToken;
  let segments: StringSpan[];
  let alias: StringSpan;
  let hasAlias: bool;
}

open type Program {
  let path: string;
  let moduleToken: FengToken;
  let moduleVisibility: Visibility;
  let moduleSegments: StringSpan[];
  let imports: ImportDeclaration[];
  let declarations: GlobalDeclaration[];
}
