open module std.compiler.parser;

import std;
import std.text;
import std.collections;
import std.compiler.lexer;

// 可见性 & 可变性 --------------------------------------------------------------

/**
 * 可见性枚举类型
 * 语义阶段 resolve 默认值：
 * - 模块/顶层声明无 open/seal 关键字 → Seal
 * - 类型成员无关键字 → Open
 */
open enum Visibility {
  Default = 0,
  Seal = 1,
  Open = 2
}

/**
 * 可变性枚举类型
 * 语义阶段 resolve 默认值：
 * - 函数参数可省略，无 let/var 关键字 → Let
 * - 绑定/字段必须显式指定 let/var
 */
open enum Mutability {
  Default = 0,
  Let = 1,
  Var = 2
}

// 类型引用 ---------------------------------------------------------------------

/**
 * 多段命名标识符，用于类型引用、模块路径等
 *
 * segments 字段：
 * - segments[0] 为最左侧标识符，segments[n] 为最右侧标识符
 * - segments 数组长度至少为 1
 */
open type SegmentedName {
  let token: FengToken;
  let fullName: StringSpan;
  let segments: StringSpan[];
}

/**
 * 命名类型引用：int, std.text.String, Map<K, V>
 *
 * 与表达式级 MemberAccessExpr 的差异：
 * - 类型位置语法仅允许标识符链（如 std.text.String），不含运行时表达式
 * - 因此 Parser 直接识别为多段 segments 数组，而非嵌套 MemberAccess
 * - 语义阶段按 segments 顺序解析：模块路径 → 类型查找 → 泛型实参代入
 */
open type NamedTypeRef {
  let token: FengToken;
  let name: SegmentedName;
  let parameterTypeRefs: TypeReference[];
}

/**
 * 指针类型引用：int*, string*
 */
open type PointerTypeRef {
  let token: FengToken;
  let targetTypeRef: TypeReference;
}

/**
 * 数组类型引用：int[], int[!]
 */
open type ArrayTypeRef {
  let token: FengToken;
  let elementTypeRef: TypeReference;
  let elementWritable: bool;
}

/**
 * 类型引用，支持命名类型、指针类型、数组类型
 */
open spec TypeReference: NamedTypeRef
| PointerTypeRef
| ArrayTypeRef;

// 绑定 ------------------------------------------------------------------------

/**
 * 简单绑定：let x: int = 5; var name = "hello";
 *
 * 支持可选的类型标注和初始化表达式，用于 let/var 声明语句
 */
open type SimpleBinding {
  let token: FengToken;
  let name: StringSpan;
  let mutability: Mutability;
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
  let annotations: Annotation[];
  let comment: StringSpan;
}

/**
 * 简单绑定签名：不含初始化表达式，用于函数参数、契约成员等声明位置
 */
open type SimpleBindingSignature {
  let token: FengToken;
  let name: StringSpan;
  let mutability: Mutability;
  let typeRef: Option<TypeReference>;
  let annotations: Annotation[];
  let comment: StringSpan;
}

/**
 * 解构绑定：let (a, b) = (1, 2); var (x, y, z) = tuple;
 *
 * 将元组或复合类型的各分量绑定到多个名称
 */
open type DestructureBinding {
  let token: FengToken;
  let mutability: Mutability;
  let names: StringSpan[];
  let typeRef: Option<TypeReference>;
  let initializer: Option<Expression>;
  let annotations: Annotation[];
  let comment: StringSpan;
}

/**
 * 绑定联合类型，用于顶层/成员/局部绑定
 */
open spec Binding: SimpleBinding | DestructureBinding;

// 泛型参数 ---------------------------------------------------------------------

/**
 * 泛型参数节点，类型约束可省略
 */
open type GenericParameter {
  let token: FengToken;
  let name: StringSpan;
  let constraintTypeRef: Option<TypeReference>;
}

// 函数 ------------------------------------------------------------------------

/**
 * 函数参数节点，引用 SimpleBindingSignature，支持可变参数
 * 函数参数，目前不支持解构绑定，也不支持默认值，所以使用 SimpleBindingSignature
 */
open type Parameter {
  let binding: SimpleBindingSignature;
  let isVariadic: bool;
}

/**
 * 函数签名节点，支持泛型参数、参数列表、返回类型、注解
 * 无函数体
 */
open type FunctionSignature {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: Option<TypeReference>;
  let annotations: Annotation[];
  let comment: StringSpan;
}

/**
 * 函数节点，支持泛型参数、参数列表、返回类型、函数体
 */
open type Function {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: Option<TypeReference>;
  let annotations: Annotation[];
  let body: Block;
  let comment: StringSpan;
}

// 基础表达式 -------------------------------------------------------------------

/**
 * 标识符表达式：引用变量、参数、函数等命名实体
 */
open type IdentifierExpr {
  let token: FengToken;
  let name: StringSpan;
}

/**
 * 布尔字面量表达式：true, false
 */
open type BooleanLiteralExpr {
  let token: FengToken;
  let value: bool;
}

/**
 * 整数字面量表达式：42, 0xFF, 0b1010
 *
 * raw 字段保留原始源码文本，用于精确还原（如进制前缀、下划线分隔符）
 */
open type IntegerLiteralExpr {
  let token: FengToken;
  let value: i64;
  let raw: StringSpan;
}

/**
 * 浮点数字面量表达式：3.14, 1.0e-5
 *
 * raw 字段保留原始源码文本
 */
open type FloatLiteralExpr {
  let token: FengToken;
  let value: f64;
  let raw: StringSpan;
}

/**
 * 字符串字面量表达式："hello", "line\n"
 */
open type StringLiteralExpr {
  let token: FengToken;
  let value: StringSpan;
}

/**
 * 一元表达式：!flag, -x, ~bits
 */
open type UnaryExpr {
  let token: FengToken;
  let operator: FengTokenKind;
  let operand: Expression;
}

/**
 * 类型转换表达式：value as TargetType
 */
open type CastExpr {
  let token: FengToken;
  let targetType: TypeReference;
  let value: Expression;
}

/**
 * 二元表达式：a + b, x == y, left && right
 */
open type BinaryExpr {
  let token: FengToken;
  let operator: FengTokenKind;
  let left: Expression;
  let right: Expression;
}

/**
 * 函数/方法调用表达式
 *
 * 泛型具化调用：
 * - 语法：`foo<int, string>(arg1, arg2)`
 * - 表示：callee 为 GenericTargetExpr { target: IdentifierExpr, argumentTypeRefs: [...] }
 *
 * 普通调用：
 * - 语法：`foo(arg1, arg2)`
 * - 表示：callee 为 IdentifierExpr
 *
 * 方法调用：
 * - 语法：`obj.method(arg1)`
 * - 表示：callee 为 MemberAccessExpr
 */
open type CallExpr {
  let token: FengToken;
  let callee: Expression;
  let arguments: Expression[];
}

/**
 * 数组字面量表达式：[1, 2, 3], []
 */
open type ArrayLiteralExpr {
  let token: FengToken;
  let items: Expression[];
}

/**
 * 元组字面量表达式：(1, 2), (a, b, c)
 */
open type TupleLiteralExpr {
  let token: FengToken;
  let items: Expression[];
}

/**
 * 对象字面量字段：name: value
 */
open type ObjectLiteralField {
  let token: FengToken;
  let name: StringSpan;
  let value: Expression;
}

/**
 * 对象字面量表达式：Point { x: 1, y: 2 }
 *
 * target 为目标类型表达式，fields 为字段初始化列表
 */
open type ObjectLiteralExpr {
  let token: FengToken;
  let target: Expression;
  let fields: ObjectLiteralField[];
}

/**
 * 数组构造表达式：new int[10], new MapEntry<K,V>[n]
 *
 * 按元素类型和大小创建数组实例
 */
open type ArrayNewExpr {
  let token: FengToken;
  let elementTypeRef: TypeReference;
  let size: Expression;
}

/**
 * 泛型具化表达式：对目标显式指定类型实参
 *
 * 用途：
 * - 表示 `identifier<TypeArgs>` 语法结构
 * - 可作为 CallExpr 的 callee，或独立存在
 *
 * 示例：
 * - 泛型调用：`foo<int>(x)` → CallExpr { callee: GenericTargetExpr, arguments: [x] }
 * - 独立引用：`let f = foo<int>` → Binding { initializer: GenericTargetExpr }
 */
open type GenericTargetExpr {
  let token: FengToken;
  let target: Expression;
  let argumentTypeRefs: TypeReference[];
}

/**
 * 成员访问表达式：obj.field, std.foo.test
 *
 * 多段路径解析策略：
 * - 语法：`foo.bar.xyz` 按 `.` 左结合嵌套解析
 * - AST：MemberAccess(MemberAccess(Identifier("foo"), "bar"), "xyz")
 * - 语义阶段逐层消歧：从最左标识符查作用域，按解析结果切换查找策略
 *   - 若 `foo` 为模块 → `foo.bar` 按模块成员查找（子模块/类型/函数/绑定）
 *   - 若 `foo` 为值/类型 → `foo.bar` 按成员访问处理
 *   - 同一条链可混合：`std.text.String`（模块路径）+ `.length()`（方法访问）
 *
 * 与类型位置 NamedTypeRef.segments 的差异：
 * - 表达式位置允许运行时表达式（如 `obj.field`），Parser 无法预判语义
 * - 因此统一解析为嵌套 MemberAccess，由语义阶段消歧
 * - 类型位置仅允许标识符链，Parser 直接识别为 segments 数组
 */
open type MemberAccessExpr {
  let token: FengToken;
  let target: Expression;
  let member: StringSpan;
}

/**
 * 下标访问表达式：arr[0], map["key"]
 */
open type IndexAccessExpr {
  let token: FengToken;
  let target: Expression;
  let index: Expression;
}

/**
 * Lambda 表达式体：单表达式或语句块
 */
open spec LambdaBody: Expression | Block;

/**
 * Lambda 表达式：(x) => x + 1, (a, b): int => { return a + b; }
 *
 * 支持单表达式体和语句块体，可选返回类型标注
 */
open type LambdaExpr {
  let token: FengToken;
  // 暂时，lambda 不支持泛型参数，后续扩展
  // let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let body: LambdaBody;
  let returnTypeRef: Option<TypeReference>;
}

/**
 * 范围表达式：start..end
 *
 * 用于 for 循环等需要范围迭代的上下文
 */
open type RangeExpr {
  let token: FengToken;
  let start: Expression;
  let end: Expression;
}

/**
 * 匹配目标联合类型：用于 match 分支的模式匹配标签
 *
 * 支持字面量、成员访问（枚举值/常量）、类型引用、绑定声明等模式
 */
open spec MatchTarget: IntegerLiteralExpr
| StringLiteralExpr
| BooleanLiteralExpr
| MemberAccessExpr
| TypeReference
| SimpleBinding;

/**
 * 匹配运算符表达式：value match pattern1 | pattern2 | ...
 *
 * 解析策略：
 * - 贪婪消费所有 `|` 分隔的匹配目标
 */
open type MatchOperatorExpr {
  let token: FengToken;
  let value: Expression;
  let targets: MatchTarget[];
}

// 块表达式 ---------------------------------------------------------------------

/**
 * if 分支子句：条件表达式 + 执行体
 */
open type IfClause {
  let token: FengToken;
  let condition: Expression;
  let body: Block;
}

/**
 * if 表达式：if cond1 { } else if cond2 { } else { }
 *
 * clauses 包含所有 if/else if 分支，elseBlock 为 else 分支体
 */
open type IfExpr {
  let token: FengToken;
  let clauses: IfClause[];
  let elseBlock: Block;
}

/** Match Targets 的分支辅助结构 */
open type MatchClause {
  let token: FengToken;
  let targets: MatchTarget[];
  let body: Block;
}

/**
 * match 表达式：match target { case1 => body1; case2 => body2; _ => elseBody }
 */
open type MatchExpr {
  let token: FengToken;
  let target: Expression;
  let clauses: MatchClause[];
  let elseBlock: Block;
}

/**
 * catch 子句：catch binding { body }
 *
 * binding 绑定捕获的异常对象，body 为异常处理逻辑
 */
open type CatchClause {
  let token: FengToken;
  let binding: SimpleBinding;
  let body: Block;
}

/**
 * try 表达式：try { body } catch e: ErrType { handler } catch { catchAll }
 *
 * 作为表达式使用时，整体求值为一个结果
 */
open type TryExpr {
  let token: FengToken;
  let body: Expression;
  let catchClauses: CatchClause[];
  let catchAllBlock: Option<Block>;
}

// 表达式联合类型 ----------------------------------------------------------------

/**
 * 表达式联合类型：所有表达式节点的统一入口
 */
open spec Expression: IdentifierExpr
| BooleanLiteralExpr
| IntegerLiteralExpr
| FloatLiteralExpr
| StringLiteralExpr
| ArrayLiteralExpr
| TupleLiteralExpr
| ObjectLiteralExpr
| ArrayNewExpr
| GenericTargetExpr
| CallExpr
| MemberAccessExpr
| IndexAccessExpr
| UnaryExpr
| BinaryExpr
| LambdaExpr
| CastExpr
| MatchOperatorExpr
| IfExpr
| MatchExpr
| TryExpr
| RangeExpr;

// 块结构 ----------------------------------------------------------------------

/**
 * 语句块：由花括号包裹的语句序列
 */
open type Block {
  let token: FengToken;
  let statements: Statement[];
}

// 语句 ------------------------------------------------------------------------

/**
 * 块语句：嵌套的语句块
 */
open type BlockStmt {
  let token: FengToken;
  let block: Block;
}

/**
 * 绑定语句：let/var 声明
 */
open type BindingStmt {
  let token: FengToken;
  let binding: Binding;
}

/**
 * 赋值语句，支持简单赋值和复合赋值
 * operator: = / += / -= / *= / /= 等
 */
open type AssignmentStmt {
  let token: FengToken;
  let operator: FengTokenKind;
  let target: Expression;
  let value: Expression;
}

/**
 * 表达式语句：函数调用等作为语句使用
 */
open type ExpressionStmt {
  let token: FengToken;
  let expression: Expression;
}

/**
 * try 语句：try { body } catch e: ErrType { handler } catch { catchAll }
 *
 * 作为语句使用时，不产生求值结果
 */
open type TryStmt {
  let token: FengToken;
  let body: Expression;
  let catchClauses: CatchClause[];
  let catchAllBlock: Option<Block>;
}

/**
 * if 语句：if cond { } else if cond { } else { }
 *
 * 作为语句使用时，不产生求值结果
 */
open type IfStmt {
  let token: FengToken;
  let clauses: IfClause[];
  let elseBlock: Block;
}

/**
 * match 语句：match target { case1 => body1; case2 => body2; _ => elseBody }
 *
 * 作为语句使用时，不产生求值结果
 */
open type MatchStmt {
  let token: FengToken;
  let target: Expression;
  let clauses: MatchClause[];
  let elseBlock: Block;
}

/**
 * while 语句：while condition { body }
 */
open type WhileStmt {
  let token: FengToken;
  let condition: Expression;
  let body: Block;
}

/**
 * for 循环初始化：绑定声明或赋值语句
 */
open spec ForInit: SimpleBinding | AssignmentStmt;
/**
 * for 循环更新：表达式或赋值语句
 */
open spec ForUpdate: Expression | AssignmentStmt;

/**
 * for 语句（三子句形式）：for init; condition; update { body }
 */
open type ForStmt {
  let token: FengToken;
  let init: ForInit;
  let condition: Expression;
  let update: ForUpdate;
  let body: Block;
}

/**
 * for-each 语句：for let item in iterable { body }
 *
 * 遍历可迭代对象的每个元素
 */
open type ForEachStmt {
  let token: FengToken;
  let binding: Binding;
  let iterable: Expression;
  let body: Block;
}

/**
 * return 语句：return value;
 */
open type ReturnStmt {
  let token: FengToken;
  let value: Expression;
}

/**
 * throw 语句：throw errorValue;
 */
open type ThrowStmt {
  let token: FengToken;
  let value: Expression;
}

/**
 * break 语句：跳出当前循环
 */
open type BreakStmt {
  let token: FengToken;
}

/**
 * continue 语句：跳过当前循环迭代
 */
open type ContinueStmt {
  let token: FengToken;
}

/**
 * defer 语句：defer { cleanup }
 *
 * 在当前作用域退出时执行延迟逻辑
 */
open type DeferStmt {
  let token: FengToken;
  let body: Block;
}

/**
 * 语句联合类型：所有语句节点的统一入口
 */
open spec Statement: BlockStmt
| BindingStmt
| AssignmentStmt
| ExpressionStmt
| TryStmt
| IfStmt
| MatchStmt
| WhileStmt
| ForStmt
| ForEachStmt
| ReturnStmt
| ThrowStmt
| BreakStmt
| ContinueStmt
| DeferStmt;

// 类型 (type) -----------------------------------------------------------------

/**
 * 类型字段成员：let/var name: Type = initializer;
 */
open type TypeField {
  let token: FengToken;
  let binding: SimpleBinding;
}

/**
 * 类型方法成员：func name(params): ReturnType { body }
 */
open type TypeMethod {
  let token: FengToken;
  let function: Function;
}

/**
 * 类型构造函数：func Self(params) { body }
 */
open type TypeConstructor {
  let token: FengToken;
  let function: Function;
}

/**
 * 类型析构函数：func ~Self() { body }
 */
open type TypeFinalizer {
  let token: FengToken;
  let function: Function;
}

/**
 * 类型成员体联合类型：字段、方法、构造函数、析构函数
 */
open spec TypeMemberBody: TypeField
| TypeMethod
| TypeConstructor
| TypeFinalizer;

/**
 * 结构对应语法的层次关系：
 * [open|seal] [static] <declaration>
 * ─────────  ──────── ────────────
 * visibility isStatic   body
 */
open type TypeMember {
  let token: FengToken;
  let visibility: Visibility;
  let isStatic: bool;
  let body: TypeMemberBody;
}

/**
 * 结构类型声明：[open|seal] type Name<T> : Spec1, Spec2 { members }
 *
 * isTuple: 是否为元组类型（成员按位置访问）
 * isValue: 是否为值类型（@value 注解标记）
 */
open type Type {
  let token: FengToken;
  let name: StringSpan;
  let genericParameters: GenericParameter[];
  let members: TypeMember[];
  let specTypeRefs: TypeReference[];
  let annotations: Annotation[];
  let isTuple: bool;
  let isValue: bool;
  let comment: StringSpan;
}

// 枚举 (enum) -----------------------------------------------------------------

/**
 * 枚举项：Name = value
 *
 * value 为可选的显式整数值，省略时自动递增
 */
open type EnumItem {
  let token: FengToken;
  let name: StringSpan;
  let value: Option<int>;
  let annotations: Annotation[];
  let comment: StringSpan;
}

/**
 * 枚举类型声明：enum Color { Red = 0, Green, Blue }
 */
open type Enum {
  let token: FengToken;
  let name: StringSpan;
  let annotations: Annotation[];
  let items: EnumItem[];
  let comment: StringSpan;
}

// 契约 (spec) -----------------------------------------------------------------

/**
 * 对象契约字段：let name: Type
 *
 * 使用 SimpleBindingSignature，不含初始化表达式
 */
open type ObjectSpecField {
  let token: FengToken;
  let binding: SimpleBindingSignature;
}

/**
 * 对象契约方法：func name(params): ReturnType
 *
 * 使用 FunctionSignature，不含函数体
 */
open type ObjectSpecMethod {
  let token: FengToken;
  let function: FunctionSignature;
}

/**
 * 对象契约成员体联合类型：字段或方法
 */
open spec ObjectSpecMemberBody: ObjectSpecField | ObjectSpecMethod;

/**
 * 对象契约成员：[static] field | method
 *
 * 与 TypeMember 的区别：契约成员不含函数体和初始化表达式
 */
open type ObjectSpecMember {
  let token: FengToken;
  let isStatic: bool;
  let body: ObjectSpecMemberBody;
}

/**
 * 对象契约：定义类型需实现的成员集合
 * spec Named { let name: string; func greet(): string; }
 */
open type ObjectSpec {
  let token: FengToken;
  let genericParameters: GenericParameter[];
  let members: ObjectSpecMember[];
  let parentTypeRefs: TypeReference[];
}

/**
 * 可调用契约：定义函数签名
 * spec Predicate<T>: (T) -> bool;
 */
open type CallableSpec {
  let token: FengToken;
  let genericParameters: GenericParameter[];
  let parameters: Parameter[];
  let returnTypeRef: TypeReference;
}

/**
 * 联合契约：定义可选类型集合
 * spec Option<T>: Some<T> | None;
 */
open type UnionSpec {
  let token: FengToken;
  let memberTypeRefs: TypeReference[];
}

/**
 * 契约体联合类型：对象契约、可调用契约、联合契约
 */
open spec SpecBody: ObjectSpec
| CallableSpec
| UnionSpec;

/**
 * 契约声明节点
 */
open type Spec {
  let token: FengToken;
  let name: StringSpan;
  let annotations: Annotation[];
  let body: SpecBody;
  let comment: StringSpan;
}

// 适配器 (fit) ----------------------------------------------------------------

/**
 * 适配器声明：fit TargetType: Spec1, Spec2 { ... }
 *
 * members 字段：
 * - Some(members): 有实现体，包含适配方法/字段
 * - None: 无实现体（仅声明适配关系）
 */
open type Fit {
  let token: FengToken;
  let targetTypeRef: TypeReference;
  let specTypeRefs: TypeReference[];
  let members: Option<TypeMember[]>;
}

// 注解 (annotation) -----------------------------------------------------------

/**
 * 注解节点：@test, @std.compiler.deprecated, @test(args)
 *
 * name 字段（SegmentedName）：
 * - 简单注解：@test → segments: ["test"]
 * - 限定名注解：@std.compiler.deprecated → segments: ["std", "compiler", "deprecated"]
 * - 语义阶段按 segments 顺序解析：模块路径 → 注解定义查找
 *
 * arguments 字段：
 * - 注解参数列表，如 @test("reason", 2024) 中的参数
 * - 无参数时为空数组
 */
open type Annotation {
  let token: FengToken;
  let name: SegmentedName;
  let arguments: Expression[];
}

// 模块 (module) ---------------------------------------------------------------

/**
 * 模块级绑定声明：顶层 let/var 声明
 */
open type ModuleBinding {
  let token: FengToken;
  let binding: SimpleBinding;
}

/**
 * 模块级函数声明：包含完整函数体
 */
open type ModuleFunction {
  let token: FengToken;
  let function: Function;
}

/**
 * 模块级外部函数声明：extern func name(params): ReturnType
 *
 * 使用 FunctionSignature，不含函数体，用于 FFI 绑定
 */
open type ModuleExternalFunction {
  let token: FengToken;
  let function: FunctionSignature;
}

/**
 * 模块成员体联合类型：绑定、函数、外部函数、类型、枚举、契约、适配器
 */
open spec ModuleMemberBody: ModuleBinding
| ModuleFunction
| ModuleExternalFunction
| Type
| Enum
| Spec
| Fit;

/**
 * 模块成员：[open|seal] body
 *
 * 包含可见性修饰和成员体
 */
open type ModuleMember {
  let token: FengToken;
  let visibility: Visibility;
  let body: ModuleMemberBody;
}

/**
 * 模块导入声明：import std.text; import std.text as txt;
 *
 * alias 字段：
 * - Some(alias): 有别名，如 import std.text as txt
 * - None: 无别名，如 import std.text
 */
open type ModuleImport {
  let token: FengToken;
  let name: SegmentedName;
  let alias: Option<StringSpan>;
}

/**
 * 模块文件：Parser 对单个 .ff 文件的解析结果
 *
 * 一个模块可分布在多个 ModuleFile 中，语义阶段按模块名合并
 * imports 作用于文件级别，而非整个模块
 */
open type ModuleFile {
  let token: FengToken;
  // 当前文件的路径
  let path: string;
  // import 作用于文件，而非整个模块
  let imports: ModuleImport[];
  // ---
  let moduleVisibility: Visibility;
  let moduleName: SegmentedName;
  let moduleMembers: ModuleMember[];
}

// 语义阶段 =====================================================================

// 模块 (module) ---------------------------------------------------------------

/**
 * 模块（语义阶段）：由语义分析器将同一模块的多个 ModuleFile 合并而成
 *
 * 语义阶段负责：
 * - 按模块名合并 files
 * - 检查可见性声明一致性
 */
open type Module {
  // 模块可见性
  let visibility: Visibility;
  // 模块名称
  let name: SegmentedName;

  // 模块可分布在多个文件，但 import 作用于文件，而非整个模块
  // 语义阶段，根据 path 合并为同一个模块，同时需检查可见性声明一致
  let files: ModuleFile[];

  // /**
  //  * 返回模块中所有成员的列表
  //  */
  // func members(): ModuleMember[] {
  //   var list = List<ModuleMember>();
  //   for let file in self.files {
  //     for let member in file.moduleMembers { list.add(member); }
  //   }
  //   return list.entries();
  // }
}

// 程序 (program) --------------------------------------------------------------

/**
 * 程序（语义阶段）：包含所有模块的顶层结构
 */
open type Program {
  let modules: Module[];
}
