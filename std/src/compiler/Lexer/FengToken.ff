open module std.compiler.lexer;

import std.text;

/**
 * FengToken 结构体表示词法分析器生成的一个词法单元，包含其类型、值以及在源代码中的位置。
 */
@value
open type FengToken {
  /** 词法单元的类型 */
  let kind: FengTokenKind;

  /** 词法单元的值 */
  let value: StringSpan;

  /** 词法单元所在的源文件 */
  let source: FengSource;
  
  /** 词法单元在源文件中的位置 */
  let location: FengSourceLocation;
}