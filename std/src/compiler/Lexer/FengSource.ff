open module std.compiler.lexer;

@value
open type FengSource {
  let path: string;
  let content: string;
  func FengSource(content: string, path: string) {
    self.path = path;
    self.content = content;
  }
}

@value
open type FengSourceLocation {
  /** 偏移量 */
  let offset: int;
  /** 词法单元所在的行号 */
  let line: int;
  /** 词法单元所在的列号 */
  let column: int;
}