open module std.compiler.lexer;

import std.text;
import std.collections;

/**
 * 词法分析器的输入源，代表一个源文件的内容和路径
 * 每个源文件对应一个 FengSource 对象
 */
open type FengSource {
  /** 源文件的内容 */
  seal let content: string;

  /** 源文件的路径 */
  let path: string;

  /** 从字符串内容创建 */
  func FengSource(content: string, path: string) {
    self.path = path;
    self.content = content;
  }

  /** 从字节数组创建（解码为字符串） */
  func FengSource(content: byte[], path: string) {
    self.path = path;
    self.content = string.fromUtf8Bytes(content);
  }

  /** 获取源文件的长度 */
  func length(): int {
    return self.content.length();
  }

  /** 获取指定字节偏移的字节值 */
  func at(index: int): byte {
    return self.content.getByte(index);
  }

  /** 获取指定字节范围的字符串切片 */
  func slice(start: int, end: int): StringSpan {
    return self.content.slice(start, end);
  }

  /** 克隆指定字节范围的字符串 */
  func clone(start: int, end: int): string {
    return self.content.clone(start, end);
  }

  /**
   * 提取指定字节偏移所在行的源码片段（不含行尾换行）。
   *
   * 用于 Lexer/Parser 构造 FengCompileError 时填充 snippet 字段。
   * 错误报告为冷路径，按需将 content 转为字节访问，不常驻缓存。
   * 偏移越界时夹到 [0, length] 区间后定位行边界。
   */
  func extractLineSnippet(offset: int): string {
    let length = self.content.length();
    if length == 0 { return ""; }
    var lineStart = offset;
    if lineStart >= length { lineStart = length - 1; }
    if lineStart < 0 { lineStart = 0; }
    while lineStart > 0 && self.at(lineStart - 1) != (byte)0x0A {
      lineStart = lineStart - 1;
    }
    var lineEnd = lineStart;
    while lineEnd < length
    && self.at(lineEnd) != (byte)0x0A
    && self.at(lineEnd) != (byte)0x0D {
      lineEnd = lineEnd + 1;
    }
    return self.content.clone(lineStart, lineEnd);
  }
}
