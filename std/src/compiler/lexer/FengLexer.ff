// /**
//  * Feng 词法分析器。
//  *
//  * 将源码字符串转换为 Token 流。逐字节扫描 + 回溯前瞻，
//  * 与 C 版 lexer 在 Token 种类、value、位置信息上行为等价，
//  * 但采用 Feng 语言的原生表达方式，不机械对齐 C 版实现。
//  *
//  * 设计要点：
//  * - 空白和注释作为独立 Token 发射，不跳过（Parser 负责过滤 trivia）
//  * - 数值解析、注解分类等语义解析交给 Parser
//  * - 文档注释（CommentDoc）作为普通 trivia Token 发射；
//  *   "附加到下一个非 trivia Token" 是 Parser 阶段的事，不在 Lexer 层维护
//  * - 词法错误直接抛出 FengCompileError，不混入 Token 流
//  *
//  * 用法示例：
//  *   let source = FengSource(content, "example.ff");
//  *   var lexer = FengLexer(source);
//  *   var token = lexer.next();
//  *   while token.kind != FengTokenKind.SpecialEndOfFile {
//  *     // 处理 token
//  *     token = lexer.next();
//  *   }
//  */
// open type FengLexer {
//   /** 源文件信息 */
//   seal let source: FengSource;
//   /** 源码字节内容（用于高效字节级访问） */
//   seal let bytes: byte[];
//   /** 字节长度 */
//   seal let length: int;
//   /** 当前字节偏移 */
//   seal var pos: int;
//   /** 当前行号（从 1 开始） */
//   seal var line: int;
//   /** 当前列号（从 1 开始） */
//   seal var column: int;
//   /** 前瞻缓存 */
//   seal var peeked: FengToken;
//   /** 前瞻缓存是否有效 */
//   seal var hasPeeked: bool;

//   /** 从 FengSource 创建 Lexer */
//   open func FengLexer(source: FengSource) {
//     self.source = source;
//     self.bytes = source.content.toBytes();
//     self.length = self.bytes.length();
//     self.pos = 0;
//     self.line = 1;
//     self.column = 1;
//     self.peeked = FengToken {
//       kind: FengTokenKind.SpecialEndOfFile,
//       value: StringSpan(source.content, 0, 0),
//       source: source,
//       location: FengLocation { offset: 0, line: 1, column: 1 }
//     };
//     self.hasPeeked = false;
//   }

