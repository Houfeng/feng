open module std.test;

import std;
import std.collections;
import std.io;
import std.text;
import std.numeric;

/**
 * 测试类型
 */
enum TestKind {
  /**
   * Describe 块用于描述一个测试套件，通常包含多个 Test 块
   */
  Describe = 0,

  /**
   * Test 块用于描述一个测试用例
   */
  Test = 1
}

/**
 * 测试状态
 */
type TestState {
  let name: string;
  let kind: TestKind;
  var state: bool;
}

/**
 * 测试上下文
 */
type TestContext {

  var total: int;
  var passed: int;
  var failed: int;

  seal let errors: List<string>;

  /**
   * 测试执行栈
   * 栈尾为当前正在测试的的测试用例
   */
  seal let stack: List<TestState>;

  func current(): TestState {
    return self.stack.get(self.stack.size() - 1);
  }

  func push(name: string, kind: TestKind) {
    self.stack.add(TestState { name: name, kind: kind, state: true });
  }

  func pop() {
    self.stack.remove(self.stack.size() - 1);
  }

  func markFailed() {
    for let state in self.stack {
      if !state.state { continue; }
      state.state = false;
    }
  }

  /**
   * 重置测试上下文
   */
  func reset() {
    self.total = 0;
    self.passed = 0;
    self.failed = 0;
    self.stack.clear();
    self.errors.clear();
  }

  /**
   * 获取缩进
   */
  func indent(): string {
    let size = self.stack.size();
    if (size <= 0) { return ""; }
    return " ".repeat((long)(size* 3));
  }

  func hasError(): bool {
    return self.errors.size() > 0;
  }

  func addError(error: string) {
    self.errors.add(error);
  }

  func toErrorString(): string {
    return string.join("\n", self.errors.entries());
  }

}