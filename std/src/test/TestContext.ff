open module std.test;

import std;
import std.collections;
import std.io;
import std.text;
import std.numeric;

/**
 * 测试类型
 */
enum TestKind {
  /**
   * Describe 块用于描述一个测试套件，通常包含多个 Test 块
   */
  Describe = 0,

  /**
   * Test 块用于描述一个测试用例
   */
  Test = 1
}

/**
 * 测试状态
 */
type TestState {
  let name: string;
  let kind: TestKind;
  var state: bool;
  let output: Option<List<string>>;
}

/**
 * 测试上下文
 */
type TestContext {

  var total: int;
  var passed: int;
  var failed: int;
  var skipped: int;

  seal let errors: List<string>;

  /**
   * 测试执行栈
   * 栈尾为当前正在测试的的测试用例
   */
  seal let stack: List<TestState>;

  func current(): TestState {
    return self.stack.get(self.stack.size() - 1);
  }

  func push(name: string, kind: TestKind) {
    if (kind == TestKind.Describe) {
      self.stack.add(TestState {
          name: name,
          kind: kind,
          state: true,
          output: none
      });
    } else {
      self.stack.add(TestState {
          name: name,
          kind: kind,
          state: true,
          output: List<string>()
      });
    }
  }

  func pop() {
    self.stack.remove(self.stack.size() - 1);
  }

  func markFailed() {
    for let state in self.stack {
      if !state.state { continue; }
      state.state = false;
    }
  }

  /**
   * 重置测试上下文
   */
  func reset() {
    self.total = 0;
    self.passed = 0;
    self.failed = 0;
    self.stack.clear();
    self.errors.clear();
  }

  /**
   * 获取缩进
   */
  func indent(): string {
    // 根节点不缩进
    let depth = self.stack.size() - 1;
    if (depth <= 0) { return ""; }
    return " ".repeat((long)(depth * 2));
  }

  func hasError(): bool {
    return self.errors.size() > 0;
  }

  func addError(error: string) {
    self.errors.add(error);
  }

  func toErrorString(): string {
    return string.join("\n", self.errors.entries());
  }

  func getParentOutput(): Option<List<string>> {
    if self.stack.size() == 0 { return none; }
    // 从后往前找到第一个 Test 块，用 feng 的写法
    // 减 2 是因为不算自已
    for var i = self.stack.size() - 2; i >= 0; i -= 1 {
      let state = self.stack.get(i);
      if state.kind == TestKind.Test {
        return state.output;
      }
    }
    return none;
  }

  func println(format: string, args: string...) {
    let parentOutput = self.getParentOutput();
    let line = string.format(format, args);
    if parentOutput {
      List<string> {
        parentOutput.add(line);
      } else {
        // 没有 Test 块，直接输出到控制台
        println(line);
      }
    }
  }

  // func println(format: string, args: string...) {
  //   self.println(format, args);
  // }

  func flushOutput() {
    let current = self.current();
    if (current.kind != TestKind.Test) { return; }
    let selfOutput = current.output;
    if selfOutput {
      List<string> {
        let parentOutput = self.getParentOutput();
        if parentOutput {
          List<string> {
            for var i = 0; i < selfOutput.size(); i += 1 {
              parentOutput.add(selfOutput.get(i));
            }
          } else {
            for var i = 0; i < selfOutput.size(); i += 1 {
              println(selfOutput.get(i));
            }
          }
        }
        selfOutput.clear();
      } else {
        // do nothing
      }
    }
  }

}