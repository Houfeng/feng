open module std.test;

import std;
import std.io;
import std.text;
import std.numeric;
import std.collections;
import std.process;

@runtime
extern func feng_expression_equal<T>(left: T, right: T): bool;

/**
 * 全局测试上下文
 */
let context = TestContext();

/**
 * 测试函数
 */
open spec TestFunction(): void;

/**
 * 测试执行
 * @param name 测试名称
 * @param kind 测试类型
 * @param skip 跳过测试
 * @param fn 测试函数
 */
func execute(name: string, kind: TestKind, skip: bool, fn: TestFunction): void {
  let isTopLevel = context.stack.size() == 0;
  if isTopLevel {
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
  }
  let indent = context.indent();
  let isTestCase = kind == TestKind.Test;
  if (isTestCase) {
    context.total += 1;
  } else {
    context.println("{0}{1}", indent, name);
  }
  if isTopLevel {
    println("─────────────────────────────────────────────────────────────");
  }
  // ---
  context.push(name, kind);
  if !skip { fn(); }
  if skip {
    context.skipped += 1;
    context.println("{0}\x1b[33m- [SKIP] \x1b[0m{1}", indent, name);
  } else if isTestCase && context.current().state {
    context.passed += 1;
    context.println("{0}\x1b[32m✔ [PASS] \x1b[0m{1}", indent, name);
  } else if isTestCase {
    context.failed += 1;
    context.println("{0}\x1b[31m✘ [FAIL] \x1b[0m{1}", indent, name);
  }
  context.flushOutput();
  context.pop();
  // ---
  if isTopLevel {
    if context.hasError() {
      println("─────────────────────────────────────────────────────────────");
      println("Errors: \n{0}", context.toErrorString());
    }
    println("─────────────────────────────────────────────────────────────");
    println(
      "Total: {0}, Passed: {1}, Failed: {2}, Skipped: {3}",
      context.total.toString(),
      context.passed.toString(),
      context.failed.toString(),
      context.skipped.toString()
    );
    println("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
    // 退出时如果有测试失败则返回非零状态码
    if (context.failed > 0) {
      Process.exit(1);
    } else {
      Process.exit(0);
    }
  }
}

/**
 * 测试描述
 * @param name 测试名称
 * @param fn 测试函数
 */
open func describe(name: string, fn: TestFunction): void {
  execute(name, TestKind.Describe, false, fn);
}

/**
 * 测试描述（可跳过）
 * @param name 测试名称
 * @param skip 是否跳过测试
 * @param fn 测试函数
 */
open func describe(name: string, skip: bool, fn: TestFunction): void {
  execute(name, TestKind.Describe, skip, fn);
}

/**
 * 测试用例
 * @param name 测试名称
 * @param fn 测试函数
 */
open func test(name: string, fn: TestFunction): void {
  execute(name, TestKind.Test, false, fn);
}

/**
 * 测试用例（可跳过）
 * @param name 测试名称
 * @param skip 是否跳过测试
 * @param fn 测试函数
 */
open func test(name: string, skip: bool, fn: TestFunction): void {
  execute(name, TestKind.Test, skip, fn);
}

/**
 * 断言辅助函数
 * @param ok 断言结果
 * @param message 错误信息，支持参数占位符
 * @param args 错误信息参数
 */
open func assert(ok: bool, message: string, args: string[]): void {
  if ok { return; }
  context.markFailed();
  context.addError(string.format(message, args));
}

/**
 * 断言辅助函数
 * @param ok 断言结果
 * @param message 错误信息，支持参数占位符
 * @param args 错误信息参数
 */
open func assert(ok: bool, message: string, args: string...): void {
  assert(ok, message, args);
}

/**
 * 断言相等
 * @param actual 实际值
 * @param expected 期望值
 * @param message 错误信息，支持参数占位符
 * @param args 错误信息参数
 */
open func assertEquals<T: Display>(actual: T, expected: T, message: string, args: string[]): void {
  let result = feng_expression_equal(actual, expected);
  assert(result, message, args);
  if !result {
    let reason = string.format("expected: {0}, actual: {1}", expected, actual);
    context.addError(reason);
  }
}

/**
 * 断言相等
 * @param actual 实际值
 * @param expected 期望值
 * @param message 错误信息，支持参数占位符
 * @param args 错误信息参数
 */
open func assertEquals<T: Display>(actual: T, expected: T, message: string, args: string...): void {
  assertEquals(actual, expected, message, args);
}