open module std.collections;

/**
 * A set stores unique keys.
 * @param <K> - the element type of this set
 *
 * Implementation notes:
 * - Uses the same open-addressing strategy as `Map`.
 * - Set stores keys only (no value payload).
 * - `entities` returns an immutable dense array of keys.
 */
open type Set<K: Hashable<K >> {
	// Slot states: 0 = never used, 1 = occupied, 2 = tombstone.
	seal var states: i32[!];
	seal var hashes: u64[!];
	seal var keys: K[!];
	seal var size: int;
	seal var used: int;
	seal var capacity: int;
	seal var missingKey: K;

	seal func nextSlot(slot: int): int {
		let next: int = slot + 1;
		if next >= self.capacity {
			return 0;
		}
		return next;
	}

	seal func slotForHash(hash: u64): int {
		return (int)(hash % (u64)self.capacity);
	}

	seal func insertRehashed(hash: u64, key: K) {
		var slot: int = self.slotForHash(hash);
		for var step: int = 0; step < self.capacity; step = step + 1 {
			if self.states[slot] != 1 {
				self.states[slot] = 1;
				self.hashes[slot] = hash;
				self.keys[slot] = key;
				self.size = self.size + 1;
				self.used = self.used + 1;
				return;
			}
			slot = self.nextSlot(slot);
		}
	}

	seal func rehash(newCapacity: int) {
		let oldStates: i32[!] = self.states;
		let oldHashes: u64[!] = self.hashes;
		let oldKeys: K[!] = self.keys;
		let oldCapacity: int = self.capacity;
		self.states = i32[: newCapacity];
		self.hashes = u64[: newCapacity];
		self.keys = K[: newCapacity];
		self.capacity = newCapacity;
		self.size = 0;
		self.used = 0;
		for var i: int = 0; i < oldCapacity; i = i + 1 {
			if oldStates[i] == 1 {
				self.insertRehashed(oldHashes[i], oldKeys[i]);
			}
		}
	}

	seal func ensureWritableForInsert() {
		if self.capacity == 0 {
			self.rehash(8);
			return;
		}
		if (self.used + 1) * 10 >= self.capacity * 7 {
			self.rehash(self.capacity * 2);
			return;
		}
		if self.size * 4 < self.used {
			self.rehash(self.capacity);
		}
	}

	seal func maybeShrinkAfterRemove() {
		if self.capacity <= 8 {
			return;
		}
		if self.size * 10 <= self.capacity * 2 {
			var newCapacity: int = self.capacity / 2;
			if newCapacity < 8 {
				newCapacity = 8;
			}
			self.rehash(newCapacity);
			return;
		}
		if self.size * 4 < self.used {
			self.rehash(self.capacity);
		}
	}

	seal func findSlot(key: K, keyHash: u64): int {
		if self.capacity == 0 {
			return -1;
		}
		var slot: int = self.slotForHash(keyHash);
		for var step: int = 0; step < self.capacity; step = step + 1 {
			let state: i32 = self.states[slot];
			if state == 0 {
				return -1;
			}
			if state == 1 && self.hashes[slot] == keyHash {
				let candidate: K = self.keys[slot];
				let matched: bool = key.same(candidate);
				if matched {
					return slot;
				}
			}
			slot = self.nextSlot(slot);
		}
		return -1;
	}

	/**
	 * Adds `key` into this set.
	 * @param key - element to add
	 * @return true if `key` was added, otherwise false
	 */
	open func add(key: K) {
		self.ensureWritableForInsert();
		let keyHash: u64 = key.hash();
		var slot: int = self.slotForHash(keyHash);
		var firstDeleted: int = -1;
		for var step: int = 0; step < self.capacity; step = step + 1 {
			let state: i32 = self.states[slot];
			if state == 0 {
				var target: int = slot;
				if firstDeleted >= 0 {
					target = firstDeleted;
				} else {
					self.used = self.used + 1;
				}
				self.states[target] = 1;
				self.hashes[target] = keyHash;
				self.keys[target] = key;
				self.size = self.size + 1;
				return;
			}
			if state == 2 {
				if firstDeleted < 0 {
					firstDeleted = slot;
				}
			} else {
				if self.hashes[slot] == keyHash {
					let candidate: K = self.keys[slot];
					let matched: bool = key.same(candidate);
					if matched {
						return;
					}
				}
			}
			slot = self.nextSlot(slot);
		}
		self.rehash(self.capacity * 2);
		self.add(key);
	}

	/**
	 * Removes `key` from this set if it exists.
	 * @param key - element to remove
	 * @return true if `key` was removed, otherwise false
	 */
	open func remove(key: K) {
		let keyHash: u64 = key.hash();
		let slot: int = self.findSlot(key, keyHash);
		if slot < 0 {
			return;
		}
		self.states[slot] = 2;
		self.hashes[slot] = 0;
		self.keys[slot] = self.missingKey;
		self.size = self.size - 1;
		self.maybeShrinkAfterRemove();
	}

	/**
	 * Returns true if `key` exists in this set, otherwise false.
	 * @param key - element to test
	 * @return true if `key` exists in this set, otherwise false
	 */
	open func has(key: K): bool {
		let keyHash: u64 = key.hash();
		return self.findSlot(key, keyHash) >= 0;
	}

	/**
	 * Returns the number of occupied elements in the set.
	 * @return number of elements
	 */
	open func count(): int {
		return self.size;
	}

	/**
	 * Returns all keys as an immutable dense array.
	 * @return immutable array of keys
	 */
	open func entries(): K[] {
		let items: K[!] = K[: self.size];
		var outputIndex: int = 0;
		for var i: int = 0; i < self.capacity; i = i + 1 {
			if self.states[i] == 1 {
				items[outputIndex] = self.keys[i];
				outputIndex = outputIndex + 1;
			}
		}
		return (K[])items;
	}
}
