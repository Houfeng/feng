open module std.collections;

@runtime
extern func feng_array_length_i64<T>(value: T[]): i64;

@runtime
extern func feng_array_slice<T>(value: T[], start: i64, length: i64): T[];

@runtime
extern func feng_expression_equal<T>(left: T, right: T): bool;

/**
 * Extends immutable arrays with standard length-related operations.
 * @param <T> - the element type
 */
open fit T[] {
  /**
   * Returns the number of elements in this array.
   * @return element count of this array
   */
  open func length(): i64 {
    return feng_array_length_i64(self);
  }

  /**
   * Returns the element at the specified index.
   * @param index - zero-based index of the element to return
   * @return element at the specified index
   */
  open func at(index: i64): T {
    if index < (i64)0 {
      throw "Array index out of bounds";
    }
    if index >= self.length() {
      throw "Array index out of bounds";
    }
    return ((T[])self)[index];
  }

  /**
   * Returns the index of the first occurrence of the specified value, or -1 if not found.
   * @param value - the value to search for
   * @return zero-based index of the first occurrence of `value`, or -1 if not found
   */
  open func indexOf(value: T): i64 {
    let len = self.length();
    for var i: i64 = 0; i < len; i += (i64)1 {
      if feng_expression_equal(self[i], value) { return i; }
    }
    return -1;
  }

  /**
   * Returns a dense copy of this array.
   * @return copied array containing all elements
   */
  open func clone(): T[] {
    return self.clone((i64)0, self.length());
  }

  /**
   * Returns a dense copy of the range `[start, end)`.
   * @param start - zero-based start offset of the copied range
   * @param end - zero-based exclusive end offset of the copied range
   * @return copied array containing all elements from `start` to `end`
   */
  open func clone(start: i64, end: i64): T[] {
    if start < (i64)0 {
      throw "Array clone start out of bounds";
    }
    if end < start {
      throw "Array clone end out of bounds";
    }
    if end > self.length() {
      throw "Array clone end out of bounds";
    }
    return feng_array_slice(self, start, end - start);
  }

  /**
   * Returns a dense read-only copy of this array.
   * @param start - zero-based start offset of the copied range
   * @return copied array containing all elements from `start` to the end of this array
   */
  open func clone(start: i64): T[] {
    return self.clone(start, self.length());
  }
}

/**
 * Extends writable arrays with standard length-related operations.
 * @param <T> - the element type
 */
open fit T[!] {
  /**
   * Returns the number of elements in this array.
   * @return element count of this array
   */
  open func length(): i64 {
    return feng_array_length_i64((T[])self);
  }

  /**
   * Returns the element at the specified index.
   * @param index - zero-based index of the element to return
   * @return element at the specified index
   */
  open func at(index: i64): T {
    return ((T[])self).at(index);
  }

  /**
   * Returns the index of the first occurrence of the specified value, or -1 if not found.
   * @param value - the value to search for
   * @return zero-based index of the first occurrence of `value`, or -1 if not found
   */
  open func indexOf(value: T): i64 {
    return ((T[])self).indexOf(value);
  }

  /**
   * Returns a dense read-only copy of this array.
   * @return copied array containing all elements
   */
  open func clone(): T[] {
    return ((T[])self).clone();
  }

  /**
   * Returns a dense read-only copy of the range `[start, end)`.
   * @param start - zero-based start offset of the copied range
   * @param end - zero-based exclusive end offset of the copied range
   * @return copied array containing all elements from `start` to `end`
   */
  open func clone(start: i64, end: i64): T[] {
    return ((T[])self).clone(start, end);
  }

  /**
   * Returns a dense read-only copy of the range `[start, length)`.
   * @param start - zero-based start offset of the copied range
   * @return copied array containing all elements from `start` to the end of this array
   */
  open func clone(start: i64): T[] {
    return ((T[])self).clone(start);
  }

}
