open module std.collections;

/**
 * A list is a growable ordered collection of elements backed by a dynamic array.
 * @param <T> - the element type
 *
 * Implementation notes:
 * - Backed by a contiguous array that doubles in capacity when full.
 * - Average O(1) amortized for add; O(n) for remove due to element shifting.
 * - get and set are O(1) by index.
 * - entities returns an immutable dense copy of all elements in order.
 */
open type List<T> {
  seal var items: T[!];
  seal var count: i32;
  seal var capacity: i32;
  seal var missing: T;

  seal func grow() {
    if self.capacity == 0 {
      self.items = T[: 8];
      self.capacity = 8;
      return;
    }
    let newCapacity: i32 = self.capacity * 2;
    let newItems: T[!] = T[: newCapacity];
    for var i: i32 = 0; i < self.count; i = i + 1 {
      newItems[i] = self.items[i];
    }
    self.items = newItems;
    self.capacity = newCapacity;
  }

  seal func shrink() {
    if self.capacity <= 8 {
      return;
    }
    if self.count * 4 > self.capacity {
      return;
    }
    var newCapacity: i32 = self.capacity / 2;
    if newCapacity < 8 {
      newCapacity = 8;
    }
    let newItems: T[!] = T[: newCapacity];
    for var i: i32 = 0; i < self.count; i = i + 1 {
      newItems[i] = self.items[i];
    }
    self.items = newItems;
    self.capacity = newCapacity;
  }

  /**
   * Appends `item` to the end of the list.
   * @param item - the element to append
   */
  open func add(item: T) {
    if self.count >= self.capacity {
      self.grow();
    }
    self.items[self.count] = item;
    self.count = self.count + 1;
  }

  /**
   * Returns the element at position `index`.
   * @param index - zero-based position
   */
  open func get(index: i32): T {
    return self.items[index];
  }

  /**
   * Replaces the element at position `index` with `item`.
   * @param index - zero-based position
   * @param item - new value to store
   */
  open func set(index: i32, item: T) {
    self.items[index] = item;
  }

  /**
   * Removes the element at position `index`, shifting subsequent elements left.
   * @param index - zero-based position of the element to remove
   */
  open func remove(index: i32) {
    for var i: i32 = index; i < self.count - 1; i = i + 1 {
      self.items[i] = self.items[i + 1];
    }
    self.items[self.count - 1] = self.missing;
    self.count = self.count - 1;
    self.shrink();
  }

  /**
   * Returns the number of elements in the list.
   */
  open func size(): i32 {
    return self.count;
  }

  /**
   * Returns all elements as an immutable dense array in insertion order.
   * @return immutable array of all elements
   */
  open func entries(): T[] {
    let result: T[!] = T[: self.count];
    for var i: i32 = 0; i < self.count; i = i + 1 {
      result[i] = self.items[i];
    }
    return (T[])result;
  }
}
