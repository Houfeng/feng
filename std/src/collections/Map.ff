open module std.collections;

/**
 * A map entity stores one key-value pair.
 * `item1` is key and `item2` is value.
 * @param <K> - the key type
 * @param <V> - the value type
 */
open type MapEntity<K, V>(K, V);

/**
 * A map is a collection of key-value pairs
 * @param <K> - the type of the keys in the map
 * @param <V> - the type of the values in the map
 *
 * Implementation notes:
 * - Open addressing hash table with linear probing.
 * - Average O(1) for get/set/remove/has under normal hash distribution.
 * - Collisions are resolved by probing and `same` key comparison.
 * - `get` returns the default zero value of `V` when key is missing.
 * - `entries` returns an immutable dense array of occupied entries.
 */
open type Map<K: Hashable<K>, V> {
  // Slot states: 0 = never used, 1 = occupied, 2 = tombstone.
  seal var states: i32[!];
  seal var hashes: u64[!];
  seal var keys: K[!];
  seal var values: V[!];
  seal var size: i32;
  seal var used: i32;
  seal var capacity: i32;
  seal var missingKey: K;
  seal var missingValue: V;

  seal func nextSlot(slot: i32): i32 {
    let next: i32 = slot + 1;
    if next >= self.capacity {
      return 0;
    }
    return next;
  }

  seal func slotForHash(hash: u64): i32 {
    return (i32)(hash % (u64)self.capacity);
  }

  seal func insertRehashed(hash: u64, key: K, value: V) {
    var slot: i32 = self.slotForHash(hash);
    for var step: i32 = 0; step < self.capacity; step = step + 1 {
      if self.states[slot] != 1 {
        self.states[slot] = 1;
        self.hashes[slot] = hash;
        self.keys[slot] = key;
        self.values[slot] = value;
        self.size = self.size + 1;
        self.used = self.used + 1;
        return;
      }
      slot = self.nextSlot(slot);
    }
  }

  seal func rehash(newCapacity: i32) {
    let oldStates: i32[!] = self.states;
    let oldHashes: u64[!] = self.hashes;
    let oldKeys: K[!] = self.keys;
    let oldValues: V[!] = self.values;
    let oldCapacity: i32 = self.capacity;
    self.states = i32[:newCapacity];
    self.hashes = u64[:newCapacity];
    self.keys = K[:newCapacity];
    self.values = V[:newCapacity];
    self.capacity = newCapacity;
    self.size = 0;
    self.used = 0;
    for var i: i32 = 0; i < oldCapacity; i = i + 1 {
      if oldStates[i] == 1 {
        self.insertRehashed(oldHashes[i], oldKeys[i], oldValues[i]);
      }
    }
  }

  seal func ensureWritableForInsert() {
    if self.capacity == 0 {
      self.rehash(8);
      return;
    }
    // Grow before reaching high probe costs.
    if (self.used + 1) * 10 >= self.capacity * 7 {
      self.rehash(self.capacity * 2);
      return;
    }
    // Too many tombstones: rebuild in-place to restore probe quality.
    if self.size * 4 < self.used {
      self.rehash(self.capacity);
    }
  }

  seal func maybeShrinkAfterRemove() {
    if self.capacity <= 8 {
      return;
    }
    if self.size * 10 <= self.capacity * 2 {
      var newCapacity: i32 = self.capacity / 2;
      if newCapacity < 8 {
        newCapacity = 8;
      }
      self.rehash(newCapacity);
      return;
    }
    if self.size * 4 < self.used {
      self.rehash(self.capacity);
    }
  }

  seal func findSlot(key: K, keyHash: u64): i32 {
    if self.capacity == 0 {
      return -1;
    }
    var slot: i32 = self.slotForHash(keyHash);
    for var step: i32 = 0; step < self.capacity; step = step + 1 {
      let state: i32 = self.states[slot];
      if state == 0 {
        return -1;
      }
      if state == 1 && self.hashes[slot] == keyHash {
        let candidate: K = self.keys[slot];
        let matched: bool = key.same(candidate);
        if matched {
          return slot;
        }
      }
      slot = self.nextSlot(slot);
    }
    return -1;
  }

  /**
   * Returns the value associated with `key`.
   * If `key` does not exist, returns the zero default value of `V`.
   * @param key - lookup key
   */
  open func get(key: K): V {
    let keyHash: u64 = key.hash();
    let slot: i32 = self.findSlot(key, keyHash);
    if slot >= 0 {
      return self.values[slot];
    }
    return self.missingValue;
  }

  /**
   * Inserts or updates the value for `key`.
   * If `key` already exists, only its value is replaced.
   * @param key - map key
   * @param value - value to insert or replace
   */
  open func set(key: K, value: V) {
    self.ensureWritableForInsert();
    let keyHash: u64 = key.hash();
    var slot: i32 = self.slotForHash(keyHash);
    var firstDeleted: i32 = -1;
    for var step: i32 = 0; step < self.capacity; step = step + 1 {
      let state: i32 = self.states[slot];
      if state == 0 {
        var target: i32 = slot;
        if firstDeleted >= 0 {
          target = firstDeleted;
        } else {
          self.used = self.used + 1;
        }
        self.states[target] = 1;
        self.hashes[target] = keyHash;
        self.keys[target] = key;
        self.values[target] = value;
        self.size = self.size + 1;
        return;
      }
      if state == 2 {
        if firstDeleted < 0 {
          firstDeleted = slot;
        }
      } else {
        if self.hashes[slot] == keyHash {
          let candidate: K = self.keys[slot];
          let matched: bool = key.same(candidate);
          if matched {
            self.values[slot] = value;
            return;
          }
        }
      }
      slot = self.nextSlot(slot);
    }
    // Full probing path means tombstones consumed all slack; rebuild and retry.
    self.rehash(self.capacity * 2);
    self.set(key, value);
  }

  /**
   * Removes `key` from the map if it exists.
   * If `key` does not exist, this method has no effect.
   * @param key - key to remove
   */
  open func remove(key: K) {
    let keyHash: u64 = key.hash();
    let slot: i32 = self.findSlot(key, keyHash);
    if slot < 0 {
      return;
    }
    self.states[slot] = 2;
    self.hashes[slot] = 0;
    self.keys[slot] = self.missingKey;
    self.values[slot] = self.missingValue;
    self.size = self.size - 1;
    self.maybeShrinkAfterRemove();
  }

  /**
   * Returns true if `key` exists in the map, otherwise false.
   * @param key - key to test
   */
  open func has(key: K): bool {
    let keyHash: u64 = key.hash();
    return self.findSlot(key, keyHash) >= 0;
  }

  /**
   * Returns the number of occupied entries in the map.
   */
  open func count(): i32 {
    return self.size;
  }

  /**
   * Returns all occupied entries as an immutable dense array.
   * @return immutable array of map entries
   */
  open func entries(): MapEntity<K, V>[] {
    let items: MapEntity<K, V>[!] = MapEntity<K, V>[:self.size];
    var outputIndex: i32 = 0;
    for var i: i32 = 0; i < self.capacity; i = i + 1 {
      if self.states[i] == 1 {
        items[outputIndex] = (self.keys[i], self.values[i]);
        outputIndex = outputIndex + 1;
      }
    }
    return (MapEntity<K, V>[])items;
  }
}

open let test_top_binding = "test";