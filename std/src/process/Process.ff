open module std.process;

import std.text;
import std.collections;

@runtime
extern func feng_string_to_utf8_bytes(value: string): byte[];

@runtime
extern func feng_pointer_is_null(ptr: CStream*): bool;

@runtime
extern func feng_pointer_is_null(ptr: byte*): bool;

@runtime
extern func feng_pointer_is_null(ptr: string*): bool;

@runtime
extern func feng_pointer_move(ptr: byte*, offset: i64): byte*;

@runtime
extern func feng_pointer_move(ptr: string*, offset: i64): string*;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: byte*): T;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: string*): T;

@cdecl("libc", "_exit")
extern func posix_exit(status: int): void;

@cdecl("libc")
extern func getpid(): int;

@cdecl("libc")
extern func getppid(): int;

@cdecl("libc")
extern func getenv(name: string*): string*;

@cdecl("libc")
extern func strlen(s: string*): i64;

@abi
seal type CStream {}

@cdecl("libc")
extern func popen(command: byte*, mode: byte*): CStream*;

@cdecl("libc")
extern func fread(ptr: byte*, size: i64, nmemb: i64, stream: CStream*): i64;

@cdecl("libc")
extern func pclose(stream: CStream*): int;

@cdecl("libc", "kill")
extern func posix_kill(pid: int, sig: int): int;

seal func emptyBytes(): byte[] {
  let items: byte[!] = byte[:(i64)0];
  return (byte[])items;
}

seal func appendToList(target: List<byte>, source: byte[]) {
  let len = source.length();
  for var i: i64 = (i64)0; i < len; i += (i64)1 {
    target.add(source[i]);
  }
}

seal func shellEscape(arg: byte[]): byte[] {
  let result = List<byte>();
  result.add((byte)39);
  let len = arg.length();
  for var i: i64 = (i64)0; i < len; i += (i64)1 {
    let b = arg[i];
    if b == (byte)39 {
      result.add((byte)39);
      result.add((byte)92);
      result.add((byte)39);
      result.add((byte)39);
    } else {
      result.add(b);
    }
  }
  result.add((byte)39);
  return result.entries();
}

open type Process {

  /**
   * Spawns a new process.
   */
  open static func spawn(path: string, args: string...): Process {
    let process = Process(path, args);
    process.run();
    return process;
  }

  /**
   * Returns the value of the environment variable with the given key.
   * Returns an empty string if the variable does not exist.
   * @param key - the environment variable name
   */
  open static func getEnv(key: string): string {
    let valuePtr = getenv(&key);
    if feng_pointer_is_null(valuePtr) {
      return "";
    }
    let len = strlen(valuePtr);
    let result: byte[!] = byte[:len];
    for var i: i64 = (i64)0; i < len; i += (i64)1 {
      let ptr: string* = feng_pointer_move(valuePtr, i);
      result[i] = feng_pointer_get_scalar<byte>(ptr);
    }
    return string.fromUtf8Bytes((byte[])result);
  }

  /**
   * Returns whether the environment variable with the given key exists.
   * @param key - the environment variable name
   */
  open static func hasEnv(key: string): bool {
    let valuePtr = getenv(&key);
    return !feng_pointer_is_null(valuePtr);
  }

  /**
   * Exits the current process with the given exit code.
   */
  open static func exit(code: int): void {
    posix_exit(code);
  }

  /**
   * Returns the PID of the current process.
   */
  open static func currentId(): int {
    return getpid();
  }

  /**
   * Returns the PID of the parent process.
   */
  open static func parentId(): int {
    return getppid();
  }

  /**
   * Returns the command line string used to spawn this process.
   */
  let path: string;

  /**
   * Returns the command line arguments used to spawn this process.
   */
  let args: string[];
  
  seal var pid: int;
  seal var exitStatus: int;
  seal var finished: bool;
  seal var stdoutData: byte[];

  seal func Process(path: string, args: string[]) {
    self.path = path;
    self.args = args;
    self.pid = -1;
    self.exitStatus = -1;
    self.finished = false;
    self.stdoutData = emptyBytes();
  }

  seal func buildCommand(): byte[] {
    let cmd = List<byte>();
    let pathBytes = feng_string_to_utf8_bytes(self.path);
    appendToList(cmd, shellEscape(pathBytes));
    let argsLen = self.args.length();
    for var i: i64 = (i64)0; i < argsLen; i += (i64)1 {
      cmd.add((byte)32);
      let argBytes = feng_string_to_utf8_bytes(self.args[i]);
      appendToList(cmd, shellEscape(argBytes));
    }
    cmd.add((byte)0);
    return cmd.entries();
  }

  seal func run(): void {
    let cmdBytes = self.buildCommand();
    let mode: byte[!] = byte[:(i64)2];
    mode[0] = (byte)114;
    mode[1] = (byte)0;

    let fp = popen(&cmdBytes, &mode);
    if feng_pointer_is_null(fp) {
      throw "process/spawn-failed";
    }

    let outputBuf = List<byte>();
    let chunk: byte[!] = byte[:(i64)4096];
    while true {
      let n = fread(&chunk, (i64)1, (i64)4096, fp);
      if n <= (i64)0 {
        break;
      }
      for var j: i64 = (i64)0; j < n; j += (i64)1 {
        outputBuf.add(chunk[j]);
      }
    }
    self.stdoutData = outputBuf.entries();

    let rawStatus = pclose(fp);
    self.exitStatus = (rawStatus >> 8) & 255;
    self.finished = true;
  }

  /**
   * Returns the process ID of the spawned process.
   */
  open func id(): int {
    return self.pid;
  }

  /**
   * Returns the exit code. Only meaningful after the process has finished.
   */
  open func exitCode(): int {
    return self.exitStatus;
  }

  /**
   * Returns the captured standard output as a string.
   */
  open func output(): string {
    return string.fromUtf8Bytes(self.stdoutData);
  }

  /**
   * Returns the captured standard output as raw bytes.
   */
  open func outputBytes(): byte[] {
    return self.stdoutData;
  }

  /**
   * Returns whether the process has finished executing.
   */
  open func isFinished(): bool {
    return self.finished;
  }

  /**
   * Sends SIGTERM to the process.
   */
  open func kill(): void {
    if !self.finished && self.pid > 0 {
      posix_kill(self.pid, 15);
    }
  }

  /**
   * Sends the specified signal to the process.
   */
  open func kill(signal: int): void {
    if !self.finished && self.pid > 0 {
      posix_kill(self.pid, signal);
    }
  }

}
