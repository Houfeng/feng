open module std.io;

import std.collections;
import std.text;

@cdecl("libc")
extern func read(fd: int, buf: byte*, count: long): long;

@cdecl("libc")
extern func write(fd: int, buf: byte*, count: long): long;

@runtime
extern func feng_string_to_utf8_bytes(value: string): byte[];

/**
 * Returns a new empty immutable byte array.
 */
seal func emptyByteArray(): byte[] {
	let items: byte[!] = byte[: (long)0];
	return (byte[])items;
}

/**
 * Appends all bytes from `values` to `target`.
 * @param target - byte list receiving appended data
 * @param values - bytes to append
 */
seal func appendBytes(target: List<byte>, values: byte[]) {
	let length = values.length();
	for var index: long = (long)0; index < length; index += (long)1 {
		target.add(values[index]);
	}
}

/**
 * Converts collected line bytes into a UTF-8 string.
 * @param line - byte list containing the line payload
 * @return UTF-8 string built from the current list entries
 */
seal func lineBytesToString(line: List<byte>): string {
	let entries = line.entries();
	return string.fromUtf8Bytes(entries);
}

/**
 * Builds the final UTF-8 byte sequence for `format`/`print`/`println`, excluding the trailing newline.
 * @param format - source format string containing `{argsIndex}` placeholders
 * @param args - interpolation arguments packed as a read-only string array
 * @return rendered bytes without any trailing newline byte
 */
seal func renderFormattedBytes(format: string, args: string[]): byte[] {
	let output = List<byte>();
	let formatBytes = feng_string_to_utf8_bytes(format);
	let encodedArgList = List<byte[]>();
	let argsLength = args.length();

	for var argIndex: long = (long)0; argIndex < argsLength; argIndex += (long)1 {
		encodedArgList.add(feng_string_to_utf8_bytes(args[argIndex]));
	}

	let encodedArgs = encodedArgList.entries();
	let formatLength = formatBytes.length();
	var index: long = (long)0;

	while index < formatLength {
		let current = formatBytes[index];
		if current != (byte)123 {
			output.add(current);
			index += (long)1;
			continue;
		}

		var closing: long = index + (long)1;
		var placeholderIndex: long = (long)0;
		var hasDigits = false;
		var isValid = true;

		while closing < formatLength {
			let token = formatBytes[closing];
			if token == (byte)125 {
				break;
			}
			if token < (byte)48 || token > (byte)57 {
				isValid = false;
				break;
			}
			hasDigits = true;
			placeholderIndex = placeholderIndex * (long)10 + ((long)token - (long)48);
			closing += (long)1;
		}

		if isValid && hasDigits && closing < formatLength && formatBytes[closing] == (byte)125 && placeholderIndex < encodedArgs.length() {
			appendBytes(output, encodedArgs[placeholderIndex]);
			index = closing + (long)1;
			continue;
		}

		output.add(current);
		index += (long)1;
	}

	return output.entries();
}

/**
 * Builds the final formatted string for `format`/`print`/`println`, excluding any implicit newline.
 * @param fmt - source format string containing `{argsIndex}` placeholders
 * @param args - interpolation arguments packed as a read-only string array
 * @return formatted UTF-8 string without any implicit trailing newline
 */
seal func renderFormattedString(fmt: string, args: string[]): string {
	let rendered = renderFormattedBytes(fmt, args);
	return string.fromUtf8Bytes(rendered);
}

/**
 * Returns a new byte array containing `bytes` followed by one trailing newline.
 * @param bytes - source bytes written before the trailing newline
 * @return rendered bytes ending with a single newline byte
 */
seal func appendTrailingNewline(bytes: byte[]): byte[] {
	let output = List<byte>();
	appendBytes(output, bytes);
	output.add((byte)10);
	return output.entries();
}

/**
 * Standard input/output object backed by libc standard streams.
 */
open type Stdio {
	seal let inputFd: int;
	seal let outputFd: int;
	seal let errorFd: int;
	seal var pending: byte[];
	seal var pendingOffset: long;

	/**
	 * Creates a stdio object bound to the process standard streams.
	 */
	open func Stdio() {
		self.inputFd = 0;
		self.outputFd = 1;
		self.errorFd = 2;
		self.pending = emptyByteArray();
		self.pendingOffset = (long)0;
	}

	/**
	 * Clears unread bytes retained for the next `readLine` call.
	 */
	seal func clearPending() {
		self.pending = emptyByteArray();
		self.pendingOffset = (long)0;
	}

	/**
	 * Copies unread pending bytes into `buffer`.
	 * @param buffer - writable destination buffer
	 * @return number of bytes copied from the pending segment
	 */
	seal func consumePending(buffer: byte[!]): long {
		let capacity = buffer.length();
		if capacity == (long)0 {
			return (long)0;
		}

		let pendingLength = self.pending.length();
		if self.pendingOffset >= pendingLength {
			self.clearPending();
			return (long)0;
		}

		var written: long = (long)0;
		while written < capacity && self.pendingOffset < pendingLength {
			buffer[written] = self.pending[self.pendingOffset];
			written += (long)1;
			self.pendingOffset += (long)1;
		}

		if self.pendingOffset >= pendingLength {
			self.clearPending();
		}

		return written;
	}

	/**
	 * Stores the unread suffix of `buffer` for the next `readLine` call.
	 * @param buffer - source buffer that still contains unread bytes
	 * @param start - zero-based inclusive start index of the unread suffix
	 * @param end - zero-based exclusive end index of the unread suffix
	 */
	seal func savePending(buffer: byte[!], start: long, end: long) {
		if start >= end {
			self.clearPending();
			return;
		}

		self.pending = ((byte[])buffer).clone(start, end);
		self.pendingOffset = (long)0;
	}

	/**
	 * Reads bytes from standard input into `buffer`.
	 * @param buffer - writable destination buffer
	 * @return actual bytes read, `0` on EOF, or a negative value on error
	 */
	open func read(buffer: byte[!]): long {
		let capacity = buffer.length();
		if capacity == (long)0 {
			return (long)0;
		}

		let pendingWritten = self.consumePending(buffer);
		if pendingWritten == capacity {
			return pendingWritten;
		}

		if pendingWritten == (long)0 {
			let libcRead = read(self.inputFd, &buffer, capacity);
			if libcRead < (long)0 {
				return libcRead;
			}
			return libcRead;
		}

		let remaining = capacity - pendingWritten;
		let tail: byte[!] = byte[: remaining];
		let libcRead = read(self.inputFd, &tail, remaining);
		if libcRead < (long)0 {
			if pendingWritten > (long)0 {
				return pendingWritten;
			}
			return libcRead;
		}

		for var index: long = (long)0; index < libcRead; index += (long)1 {
			buffer[pendingWritten + index] = tail[index];
		}

		return pendingWritten + libcRead;
	}

	/**
	 * Writes bytes to standard output without appending a newline.
	 * @param bytes - bytes to write
	 * @return actual bytes written, or a negative value on error
	 */
	open func write(bytes: byte[]): long {
		let length = bytes.length();
		if length == (long)0 {
			return (long)0;
		}
		return write(self.outputFd, &bytes, length);
	}

	/**
	 * Writes text to standard output without appending a newline.
	 * @param text - UTF-8 text to write
	 * @return actual bytes written, or a negative value on error
	 */
	open func write(text: string): long {
		return self.write(feng_string_to_utf8_bytes(text));
	}

	/**
	 * Writes text to standard output and appends one trailing newline byte.
	 * @param text - UTF-8 text written before the trailing newline
	 * @return actual bytes written, including the trailing newline, or a negative value on error
	 */
	open func writeLine(text: string): long {
		let bytes = feng_string_to_utf8_bytes(text);
		let line = appendTrailingNewline(bytes);
		return self.write(line);
	}

	/**
	 * Writes bytes to standard error without appending a newline.
	 * @param bytes - bytes to write
	 * @return actual bytes written, or a negative value on error
	 */
	open func writeError(bytes: byte[]): long {
		let length = bytes.length();
		if length == (long)0 {
			return (long)0;
		}
		return write(self.errorFd, &bytes, length);
	}

	/**
	 * Writes text to standard error without appending a newline.
	 * @param text - UTF-8 text to write
	 * @return actual bytes written, or a negative value on error
	 */
	open func writeError(text: string): long {
		return self.writeError(feng_string_to_utf8_bytes(text));
	}

	/**
	 * Writes bytes to standard error and appends one trailing newline byte.
	 * @param bytes - bytes to write before the trailing newline
	 * @return actual bytes written, including the trailing newline, or a negative value on error
	 */
	open func writeErrorLine(bytes: byte[]): long {
		let line = appendTrailingNewline(bytes);
		return self.writeError(line);
	}

	/**
	 * Writes text to standard error and appends one trailing newline byte.
	 * @param text - UTF-8 text written before the trailing newline
	 * @return actual bytes written, including the trailing newline, or a negative value on error
	 */
	open func writeErrorLine(text: string): long {
		return self.writeErrorLine(feng_string_to_utf8_bytes(text));
	}

	/**
	 * Reads a single UTF-8 line from standard input.
	 * The trailing newline is not included. Returns `""` on EOF before any byte.
	 * @return line content without the trailing newline
	 */
	open func readLine(): string {
		let line = List<byte>();
		let chunk: byte[!] = byte[: (long)4096];
		var foundNewline = false;

		while !foundNewline {
			let count = self.read(chunk);
			if count < (long)0 {
				throw "Stdio read failed";
			}
			if count == (long)0 {
				break;
			}

			var index: long = (long)0;
			while index < count {
				let current = chunk[index];
				if current == (byte)10 {
					self.savePending(chunk, index + (long)1, count);
					foundNewline = true;
					break;
				}
				if current != (byte)13 {
					line.add(current);
				}
				index += (long)1;
			}
		}

		return lineBytesToString(line);
	}

}

/**
 * Default stdio instance bound to stdin, stdout, and stderr.
 */
open let stdio = Stdio();

/**
 * Reads a single UTF-8 line from the default standard input.
 * The trailing newline is not included. Returns `""` on EOF before any byte.
 * @return line content without the trailing newline
 */
open func readLine(): string {
	return stdio.readLine();
}

/**
 * Writes text to the default standard output and appends one trailing newline byte.
 * @param text - UTF-8 text written before the trailing newline
 * @return actual bytes written, including the trailing newline, or a negative value on error
 */
open func writeLine(text: string): long {
	return stdio.writeLine(text);
}

/**
 * Formats `fmt` using `{argsIndex}` interpolation and returns the rendered string.
 * @param fmt - source format string
 * @param args - zero-based interpolation arguments
	 * @return formatted text without any implicit trailing newline
 */
open func format(fmt: string, args: string...): string {
	return renderFormattedString(fmt, args);
}

/**
 * Writes `format` after `{argsIndex}` interpolation without appending a newline.
 * @param fmt - source format string
 * @param args - zero-based interpolation arguments
	 * @return total bytes written
 */
open func print(fmt: string, args: string...): long {
	let rendered = renderFormattedBytes(fmt, args);
	return stdio.write(rendered);
}

/**
 * Writes `fmt` after `{argsIndex}` interpolation and appends one trailing newline.
 * @param fmt - source format string
 * @param args - zero-based interpolation arguments
	 * @return total bytes written, including the trailing newline
 */
open func println(fmt: string, args: string...): long {
	let text = renderFormattedString(fmt, args);
	return stdio.writeLine(text);
}
