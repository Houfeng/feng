pu mod std;

@cdecl("libc")
extern fn write(fd: int, buf: string*, count: long): long;

/**
 * Writes `text` to standard output without appending a newline.
 * @param text - UTF-8 text to write
 * @return actual bytes written or a negative value on error
 */
pu fn output(text: string): long {
	return write(1, &text, text.length());
}
