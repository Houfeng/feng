pu mod std;

use std.collections;

@cdecl("libc")
extern fn getchar(): int;

@runtime
extern fn feng_string_from_utf8_bytes(value: byte[!], length: long): string;

/**
 * Reads a single line from standard input and returns it as UTF-8 text.
 * The trailing newline is not included. Returns `""` on EOF before any byte.
 */
pu fn input(): string {
	let bytes = List:<byte>();

	while true {
		let ch = getchar();
		if ch < 0 || ch == 10 {
			break;
		}
		if ch != 13 {
			bytes.add((byte)ch);
		}
	}

	let data = bytes.entries();
	return feng_string_from_utf8_bytes(data, data.length());
}
