open module std.platform;

@cdecl("feng_std_uv", "uv_get_total_memory")
extern func uv_get_total_memory(): u64;

@cdecl("feng_std_uv", "uv_get_free_memory")
extern func uv_get_free_memory(): u64;

@cdecl("feng_std_uv", "uv_get_available_memory")
extern func uv_get_available_memory(): u64;

@cdecl("feng_std_uv", "uv_get_constrained_memory")
extern func uv_get_constrained_memory(): u64;

@cdecl("feng_std_uv", "uv_resident_set_memory")
extern func uv_resident_set_memory(rss: u64*): int;

/**
 * Provides memory queries backed by `libuv`.
 */
open type MemoryInfo {
  /**
   * Returns total physical memory in bytes.
   */
  open static func totalBytes(): u64 {
    return uv_get_total_memory();
  }

  /**
   * Returns free memory in bytes.
   */
  open static func freeBytes(): u64 {
    return uv_get_free_memory();
  }

  /**
   * Returns available memory in bytes.
   */
  open static func availableBytes(): u64 {
    return uv_get_available_memory();
  }

  /**
   * Returns constrained memory in bytes.
   */
  open static func constrainedBytes(): u64 {
    return uv_get_constrained_memory();
  }

  /**
   * Returns resident set size in bytes.
   */
  open static func residentBytes(): u64 {
    let rss: u64[!] = u64[: (long)1];
    let rssRc = uv_resident_set_memory(&rss);
    if rssRc != 0 {
      throw "platform/memory-info/resident";
    }

    return rss[0];
  }
}