pu mod std;

@cdecl("feng_intrinsic")
extern fn feng_string_utf8_length(value: string*): long;

/**
 * Extends `string` with standard length-related operations.
 */
pu fit string {
  /**
   * Returns the UTF-8 byte length of this string.
   * @return number of bytes in this string
   */
  pu fn length(): long {
    return feng_string_utf8_length(&self);
  }
}
