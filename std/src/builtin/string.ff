pu mod std;

@runtime
extern fn feng_string_utf8_length(value: string): long;

/**
 * Extends `string` with standard length-related operations.
 */
pu fit string {
  /**
   * Returns the UTF-8 byte length of this string.
   * @return number of bytes in this string
   */
  pu fn length(): long {
    return feng_string_utf8_length(self);
  }

  /**
   * Returns a view of this string as a sequence of runes.
   * @return rune view of this string
   */
  pu runes(): RuneView {
    return RuneView(self);
  }

  /**
   * Returns a view of this string as a sequence of graphemes.
   * @return grapheme view of this string
   */
  pu graphemes(): GraphemeView {
    return GraphemeView(self);
  }

}
