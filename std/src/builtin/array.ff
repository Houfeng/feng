pu mod std;

pu fit T[] {
  pu fn length(): long {
    var total: long = 0;
    for let item in self {
      total = total + (long)1;
    }
    return total;
  }
}

pu fit T[!] {
  pu fn length(): long {
    var total: long = 0;
    for let item in self {
      total = total + (long)1;
    }
    return total;
  }
}