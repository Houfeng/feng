open module std.thread;

@cdecl("feng_std_uv", "uv_mutex_init")
extern func uv_mutex_init(handle: int): i32;

@cdecl("feng_std_uv", "uv_mutex_destroy")
extern func uv_mutex_destroy(handle: int): void;

@cdecl("feng_std_uv", "uv_mutex_lock")
extern func uv_mutex_lock(handle: int): void;

@cdecl("feng_std_uv", "uv_mutex_trylock")
extern func uv_mutex_trylock(handle: int): i32;

@cdecl("feng_std_uv", "uv_mutex_unlock")
extern func uv_mutex_unlock(handle: int): void;

/**
 * A mutual exclusion lock for synchronizing access to shared data.
 */
open type Mutex {

  seal let handle: int;

  /**
   * Creates a new mutex.
   */
  open func Mutex() {
    self.handle = feng_alloc((int)64);
    if self.handle == (int)0 {
      throw "mutex/alloc-failed";
    }
    let result = uv_mutex_init(self.handle);
    if result != 0 {
      feng_free(self.handle);
      throw "mutex/init-failed";
    }
  }

  /**
   * Acquires the mutex, blocking the current thread until it is available.
   */
  open func lock(): void {
    uv_mutex_lock(self.handle);
  }

  /**
   * Attempts to acquire the mutex without blocking.
   * Returns true if the lock was acquired, false otherwise.
   */
  open func tryLock(): bool {
    return uv_mutex_trylock(self.handle) == 0;
  }

  /**
   * Releases the mutex.
   */
  open func unlock(): void {
    uv_mutex_unlock(self.handle);
  }

  /**
   * Destroys the mutex and frees its resources.
   */
  open func destroy(): void {
    uv_mutex_destroy(self.handle);
    feng_free(self.handle);
  }

}
