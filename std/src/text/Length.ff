pu mod std.text;

@cdecl("feng_runtime")
extern fn feng_string_utf8_length(value: string): long;

pu fit string {
  pu fn length(): long {
    return feng_string_utf8_length(self);
  }
}

pu fit T[] {
  pu fn length(): long {
    var total: long = 0;
    for let item in self {
      total = total + (long)1;
    }
    return total;
  }
}

pu fit T[!] {
  pu fn length(): long {
    var total: long = 0;
    for let item in self {
      total = total + (long)1;
    }
    return total;
  }
}
