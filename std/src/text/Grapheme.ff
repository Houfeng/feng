pu mod std.text;

/**
 * A view of a string as a sequence of graphemes.
 */
pu type GraphemeView {
  pr let text: string;
  pu fn GraphemeView(text: string) {
    self.text = text;
  }
  pu fn length(): long {
    return 0;
  }
}

/**
 * Extends `string` with standard length-related operations.
 */
pu fit string {

  /**
   * Returns a view of this string as a sequence of graphemes.
   * @return grapheme view of this string
   */
  pu fn graphemes(): GraphemeView {
    return GraphemeView(self);
  }

}
