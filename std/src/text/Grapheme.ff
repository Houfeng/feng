open module std.text;

import std.collections;

@cdecl("feng_std_unistring", "u8_grapheme_next")
extern func u8_grapheme_next(s: string*, end: string*): string*;


/**
 * Extends `string` with a grapheme-level view.
 */
open fit string {

  /**
   * Returns a view of this string as a sequence of grapheme clusters.
   * @return grapheme view of this string
   */
  open func graphemes(): GraphemeView {
    return GraphemeView(self);
  }

}

/**
 * A read-only view of a string as a sequence of grapheme clusters.
 */
open type GraphemeView {
  seal let text: string;

  /**
   * Creates a new grapheme view over the given string.
   * @param text - string to view
   */
  open func GraphemeView(text: string) {
    self.text = text;
  }

  /**
   * Returns the number of grapheme clusters in this string.
   * @return grapheme cluster count
   */
  open func length(): i64 {
    let data: string* = &self.text;
    let end: string* = feng_pointer_move(data, self.text.length());
    var cursor: string* = data;
    var count: i64 = 0;
    while !feng_pointer_equal(cursor, end) {
      cursor = u8_grapheme_next(cursor, end);
      if feng_pointer_is_null(cursor) {
        break;
      }
      count += (i64)1;
    }
    return count;
  }

  /**
   * Returns an iterator over the grapheme clusters of this view.
   * @return grapheme iterator cursor
   */
  @iterable
  open func iter(): GraphemeIterator {
    return GraphemeIterator(self.text);
  }

  /**
   * Returns the substring of the grapheme cluster at the given logical index.
   * @param index - zero-based grapheme index
   * @return substring containing the single grapheme cluster
   */
  open func at(index: i64): string {
    if index < (i64)0 {
      throw "GraphemeView index out of bounds";
    }
    let data: string* = &self.text;
    let end: string* = feng_pointer_move(data, self.text.length());
    var cursor: string* = data;
    var i: i64 = 0;
    while i < index {
      cursor = u8_grapheme_next(cursor, end);
      if feng_pointer_is_null(cursor) {
        throw "GraphemeView index out of bounds";
      }
      i += (i64)1;
    }
    if feng_pointer_equal(cursor, end) {
      throw "GraphemeView index out of bounds";
    }
    let next: string* = u8_grapheme_next(cursor, end);
    let start = feng_pointer_diff(cursor, data);
    var cluster_end: i64 = 0;
    if feng_pointer_is_null(next) {
      cluster_end = self.text.length();
    } else {
      cluster_end = feng_pointer_diff(next, data);
    }
    return self.text.clone(start, cluster_end);
  }
}

/**
 * An iterator cursor that yields individual grapheme clusters as substring slices.
 */
open type GraphemeIterator {
  seal let text: string;
  seal let len: i64;
  seal var offset: i64;

  /**
   * Creates a new grapheme iterator over the given string.
   * @param text - string to iterate over
   */
  open func GraphemeIterator(text: string) {
    self.text = text;
    self.len = text.length();
    self.offset = 0;
  }

  /**
   * Advances to the next grapheme cluster and returns it, or signals completion.
   * @return (true, grapheme) if available, (false, _) otherwise
   */
  @iterator
  open func next(): IteratorResult<string> {
    if self.offset >= self.len {
      return (false, "");
    }
    let data: string* = &self.text;
    let end: string* = feng_pointer_move(data, self.len);
    let cursor: string* = feng_pointer_move(data, self.offset);
    let after: string* = u8_grapheme_next(cursor, end);
    if feng_pointer_is_null(after) {
      return (false, "");
    }
    let start = self.offset;
    self.offset = feng_pointer_diff(after, data);
    return (true, self.text.clone(start, self.offset));
  }
}
