open module std.text;

import std;
import std.numeric;
import std.collections;

open fit bool {
  func toJsonString(): string {
    return self.toString();
  }
}

open fit double {
  func toJsonString(): string {
    return self.toString();
  }
}

open fit string {
  func toJsonString(): string {
    return "\"" + self.replace("\"", "\\\"") + "\"";
  }
}

open fit None {
  func toJsonString(): string {
    return "null";
  }
}

open type JsonArray {
  seal let payload: List<JsonPayload>;
  func JsonArray(payload: List<JsonPayload>) {
    self.payload = payload;
  }
  func JsonArray() {}
  func toJsonString(): string {
    return "[]";
  }
}

open type JsonObject {
  seal let payload: Map<string, JsonPayload>;
  func JsonObject(payload: Map<string, JsonPayload>) {
    self.payload = payload;
  }
  func JsonObject() {}
  func toJsonString(): string {
    return "{}";
  }
}

open spec JsonPayload: None
| double
| bool
| string
| JsonArray
| JsonObject;

open type JsonValue {
  let payload: JsonPayload;

  func JsonValue(payload: JsonPayload) {
    self.payload = payload;
  }

  func JsonValue() {}

  func isNull(): bool {
    return if self.payload {
      None { true }
      else { false }
    };
  }

  func isBool(): bool {
    return if self.payload {
      bool { true }
      else { false }
    };
  }

  func isNumber(): bool {
    return if self.payload {
      double { true }
      else { false }
    };
  }

  func isString(): bool {
    return if self.payload {
      string { true }
      else { false }
    };
  }

  func isArray(): bool {
    return if self.payload {
      JsonArray { true }
      else { false }
    };
  }

  func isObject(): bool {
    return if self.payload {
      JsonObject { true }
      else { false }
    };
  }

  func asNull(): None {
    return if self.payload {
      None { self.payload }
      else { none }
    };
  }

  func asBool(): bool {
    return if self.payload {
      bool { self.payload }
      else { false }
    };
  }

  func asNumber(): double {
    return if self.payload {
      double { self.payload }
      else { 0.0 }
    };
  }

  func asString(): string {
    return if self.payload {
      string { self.payload }
      else { "" }
    };
  }

  func asArray(): List<JsonPayload> {
    return if self.payload {
      JsonArray { self.payload }
      else { JsonArray() }
    };
  }

  func asObject(): Map<string, JsonPayload> {
    return if self.payload {
      JsonObject { self.payload }
      else { JsonObject() }
    };
  }

  func toJsonString(): string {
    return if self.payload {
      None { self.payload.toJsonString() }
      bool { self.payload.toJsonString() }
      double { self.payload.toJsonString() }
      string { self.payload.toJsonString() }
      JsonArray { self.payload.toJsonString() }
      JsonObject { self.payload.toJsonString() }
      else { "null" }
    };
  }

  func toString(): string {
    return self.toJsonString();
  }

}