  //     else { Map<string, JsonValue>() }
  //   };
  // }

  // func toJson(): string {
  //   return if self.payload {
  //     None { "null" }
  //     bool { self.payload.toString() }
  //     double { self.payload.toString() }
  //     string { "\"" + self.payload + "\"" }
