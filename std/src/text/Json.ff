open module std.text;

import std;
import std.collections;

open type JsonArray {
  seal let payload: List<JsonValue>;

  func JsonArray(payload: List<JsonValue>) {
    self.payload = payload;
  }

  func JsonArray() {}

  func size(): int {
    return self.payload.size();
  }

  func get(index: int): JsonValue {
    return self.payload.get(index);
  }

  func set(index: int, value: JsonValue) {
    self.payload.set(index, value);
  }

  func set(index: int, value: JsonValuePayload) {
    self.set(index, JsonValue(value));
  }

  func add(value: JsonValue) {
    self.payload.add(value);
  }

  func add(value: JsonValuePayload) {
    self.add(JsonValue(value));
  }

  func remove(index: int) {
    self.payload.remove(index);
  }

  func toJson(): string {
    let textArray = string[:self.size()];
    return string.join(",", textArray);
  }
}

open type JsonObject {
  seal let payload: Map<string, JsonValue>;

  func JsonObject(payload: Map<string, JsonValue>) {
    self.payload = payload;
  }

  func JsonObject() {}

  func size(): int {
    return self.payload.count();
  }

  func get(key: string): JsonValue {
    return self.payload.get(key);
  }

  func set(key: string, value: JsonValue) {
    self.payload.set(key, value);
  }

  func set(key: string, value: JsonValuePayload) {
    self.set(key, JsonValue(value));
  }

  func remove(key: string) {
    self.payload.remove(key);
  }

  func toJson(): string {
    let textPairs = string[:self.size()];
    return "{" + string.join(",", textPairs) + "}";
  }
}

open spec JsonValuePayload: None
| double
| bool
| string
| JsonArray
| JsonObject;

open type JsonValue {
  seal let payload: JsonValuePayload;

  func JsonValue(payload: JsonValuePayload) {
    self.payload = payload;
  }

  func JsonValue() {}

  func isNull(): bool {
    return if self.payload {
      None { true }
      else { false }
    };
  }

  func isBool(): bool {
    return if self.payload {
      bool { true }
      else { false }
    };
  }

  func isNumber(): bool {
    return if self.payload {
      double { true }
      else { false }
    };
  }

  func isString(): bool {
    return if self.payload {
      string { true }
      else { false }
    };
  }

  func isArray(): bool {
    return if self.payload {
      JsonArray { true }
      else { false }
    };
  }

  func isObject(): bool {
    return if self.payload {
      JsonObject { true }
      else { false }
    };
  }

  // func toNull(): None {
  //   return if self.payload {
  //     None { self.payload }
  //     else { none }
  //   };
  // }

  func toBool(): bool {
    return if self.payload {
      bool { self.payload }
      else { false }
    };
  }

  func toNumber(): double {
    return if self.payload {
      double { self.payload }
      else { 0.0 }
    };
  }

  func toString(): string {
    return if self.payload {
      string { self.payload }
      else { "" }
    };
  }

  func toArray(): JsonArray {
    return if self.payload {
      JsonArray { self.payload }
      else { JsonArray() }
    };
  }

  func toObject(): JsonObject {
    return if self.payload {
      JsonObject { self.payload }
      else { JsonObject() }
    };
  }
}