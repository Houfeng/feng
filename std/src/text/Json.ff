open module std.text;

import std;
import std.collections;

open spec JsonPayload: None
| double
| bool
| string
| List<JsonPayload>
| Map<string, JsonPayload>;

open type JsonValue {
  seal let payload: JsonPayload;

  func JsonValue(payload: JsonPayload) {
    self.payload = payload;
  }

  func JsonValue() {}

  func isNull(): bool {
    return if self.payload {
      None { true }
      else { false }
    };
  }

  func isBool(): bool {
    return if self.payload {
      bool { true }
      else { false }
    };
  }

  func isNumber(): bool {
    return if self.payload {
      double { true }
      else { false }
    };
  }

  func isString(): bool {
    return if self.payload {
      string { true }
      else { false }
    };
  }

  func isArray(): bool {
    return if self.payload {
      List<JsonPayload> { true }
      else { false }
    };
  }

  func isObject(): bool {
    return if self.payload {
      Map<string, JsonPayload> { true }
      else { false }
    };
  }

  func asNull(): None {
    return if self.payload {
      None { self.payload }
      else { none }
    };
  }

  func asBool(): bool {
    return if self.payload {
      bool { self.payload }
      else { false }
    };
  }

  func asNumber(): double {
    return if self.payload {
      double { self.payload }
      else { 0.0 }
    };
  }

  func asString(): string {
    return if self.payload {
      string { self.payload }
      else { "" }
    };
  }

  func asArray(): List<JsonPayload> {
    return if self.payload {
      List<JsonPayload> { self.payload }
      else { List<JsonPayload>() }
    };
  }

  func asObject(): Map<string, JsonPayload> {
    return if self.payload {
      Map<string, JsonPayload> { self.payload }
      else { Map<string, JsonPayload>() }
    };
  }
}