open module std.text;

import std;
import std.collections;

open spec JsonPayload: None
| double
| bool
| string
| List < JsonValue >
| Map<string, JsonValue>;

open type JsonValue {
  seal let payload: JsonPayload;

  func JsonValue(payload: JsonPayload) {
    self.payload = payload;
  }

  func JsonValue() {}

  func isNull(): bool {
    return if self.payload {
      None { true }
      else { false }
    };
  }

  func isBool(): bool {
    return if self.payload {
      bool { true }
      else { false }
    };
  }

  func isNumber(): bool {
    return if self.payload {
      double { true }
      else { false }
    };
  }

  func isString(): bool {
    return if self.payload {
      string { true }
      else { false }
    };
  }

  func isArray(): bool {
    return if self.payload {
      List<JsonValue> { true }
      else { false }
    };
  }

  func isObject(): bool {
    return if self.payload {
      Map<string, JsonValue> { true }
      else { false }
    };
  }

  func toBool(): bool {
    // let value = self.payload;
    return if self.payload {
      bool { self.payload }
      else { false }
    };
  }

  // func toNumber(): double {
  //   let value = self.payload;
  //   return if value {
  //     double { value }
  //     else { 0.0 }
  //   };
  // }

  // func toString(): string {
  //   let value = self.payload;
