open module std.text;

import std.collections;

@cdecl("feng_std_unistring", "uc_toupper")
extern func uc_toupper(uc: u32): u32;

@cdecl("feng_std_unistring", "uc_tolower")
extern func uc_tolower(uc: u32): u32;

@runtime
extern func feng_string_utf8_length(value: string): long;

@runtime
extern func feng_string_to_utf8_bytes(value: string): byte[];

@runtime
extern func feng_string_from_utf8_bytes(value: byte[], length: long): string;

@runtime
extern func feng_string_slice(value: string, start: long, length: long): string;

@runtime
extern func feng_string_slice_bytes(value: string, start: long, length: long): byte[];

@runtime
extern func feng_pointer_is_null(ptr: string*): bool;

@runtime
extern func feng_pointer_equal(a: string*, b: string*): bool;

@runtime
extern func feng_pointer_move(ptr: string*, offset: long): string*;

@runtime
extern func feng_pointer_diff(a: string*, b: string*): long;

/**
 * Extends `string` with standard UTF-8 operations.
 */
open fit string {
  /**
   * Returns a new string by copying all bytes from `bytes`.
   * @param bytes - UTF-8 byte sequence to copy
   * @return string containing the copied bytes
   */
  open static func fromUtf8Bytes(bytes: byte[]): string {
    return feng_string_from_utf8_bytes(bytes, bytes.length());
  }

  /**
   * Returns a new string by copying the first `length` bytes from `bytes`.
   * @param bytes - UTF-8 byte sequence to copy from
   * @param length - number of bytes to copy
   * @return string containing the copied bytes
   */
  open static func fromUtf8Bytes(bytes: byte[], length: long): string {
    return feng_string_from_utf8_bytes(bytes, length);
  }

  /**
   * Returns the UTF-8 byte length of this string.
   * @return number of bytes in this string
   */
  open func length(): long {
    return feng_string_utf8_length(self);
  }

  /**
   * Returns a single-byte substring at the specified byte offset.
   * For character-level access, use `runes()` or `graphemes()` views.
   * @param index - zero-based byte offset
   * @return length-1 substring containing the byte at `index`
   */
  open func at(index: long): string {
    if index < (long)0 {
      throw "String index out of bounds";
    }
    if index >= self.length() {
      throw "String index out of bounds";
    }
    return feng_string_slice(self, index, (long)1);
  }

  /**
   * Returns a dense copy of this string.
   * @return new string containing all bytes of this string
   */
  open func clone(): string {
    return self.clone((long)0, self.length());
  }

  /**
   * Returns a dense copy of the byte range `[start, end)`.
   * @param start - zero-based inclusive start byte offset
   * @param end - zero-based exclusive end byte offset
   * @return new string containing bytes from `start` to `end`
   */
  open func clone(start: long, end: long): string {
    if start < (long)0 {
      throw "String clone start out of bounds";
    }
    if end < start {
      throw "String clone end out of bounds";
    }
    if end > self.length() {
      throw "String clone end out of bounds";
    }
    return feng_string_slice(self, start, end - start);
  }

}

@runtime
extern func feng_string_range_equal(
  a: string, a_start: long, a_end: long,
  b: string, b_start: long, b_end: long
): bool;

/**
 * Checks whether a Unicode code point is a whitespace character.
 */
func isUnicodeWhitespace(cp: u32): bool {
  if cp <= (u32)0x0020 {
    return cp == (u32)0x0009 || cp == (u32)0x000A || cp == (u32)0x000B
    || cp == (u32)0x000C || cp == (u32)0x000D || cp == (u32)0x0020;
  }
  if cp == (u32)0x0085 || cp == (u32)0x00A0 {
    return true;
  }
  if cp == (u32)0x1680 {
    return true;
  }
  if cp >= (u32)0x2000 && cp <= (u32)0x200A {
    return true;
  }
  if cp == (u32)0x2028 || cp == (u32)0x2029 {
    return true;
  }
  if cp == (u32)0x202F || cp == (u32)0x205F || cp == (u32)0x3000 {
    return true;
  }
  return false;
}

/**
 * Extends `string` with search and transform operations.
 */
open fit string {

  /**
   * Returns the byte offset of the first occurrence of `target`, or -1 if not found.
   * @param target - substring to search for
   * @return byte offset or -1
   */
  open func indexOf(target: string): long {
    return self.indexOf(target, (long)0);
  }

  /**
   * Returns the byte offset of the first occurrence of `target` starting from `from`, or -1 if not found.
   * @param target - substring to search for
   * @param from - byte offset to start searching from
   * @return byte offset or -1
   */
  open func indexOf(target: string, from: long): long {
    let tlen = target.length();
    if tlen == (long)0 {
      return from;
    }
    let slen = self.length();
    if from < (long)0 {
      throw "String indexOf from out of bounds";
    }
    if from + tlen > slen {
      return (long)-1;
    }
    let limit = slen - tlen;
    var i = from;
    while i <= limit {
      if feng_string_range_equal(self, i, i + tlen, target, (long)0, tlen) {
        return i;
      }
      i += (long)1;
    }
    return (long)-1;
  }

  /**
   * Returns the byte offset of the last occurrence of `target`, or -1 if not found.
   * @param target - substring to search for
   * @return byte offset or -1
   */
  open func lastIndexOf(target: string): long {
    let tlen = target.length();
    if tlen == (long)0 {
      return self.length();
    }
    let slen = self.length();
    if tlen > slen {
      return (long)-1;
    }
    var i = slen - tlen;
    while i >= (long)0 {
      if feng_string_range_equal(self, i, i + tlen, target, (long)0, tlen) {
        return i;
      }
      i -= (long)1;
    }
    return (long)-1;
  }

  /**
   * Returns whether this string contains `target` as a substring.
   * @param target - substring to search for
   * @return true if found
   */
  open func contains(target: string): bool {
    return self.indexOf(target) >= (long)0;
  }

  /**
   * Returns whether this string starts with `prefix`.
   * @param prefix - prefix to check
   * @return true if this string starts with prefix
   */
  open func startsWith(prefix: string): bool {
    let plen = prefix.length();
    if plen == (long)0 {
      return true;
    }
    if plen > self.length() {
      return false;
    }
    return feng_string_range_equal(self, (long)0, plen, prefix, (long)0, plen);
  }

  /**
   * Returns whether this string ends with `suffix`.
   * @param suffix - suffix to check
   * @return true if this string ends with suffix
   */
  open func endsWith(suffix: string): bool {
    let slen = suffix.length();
    if slen == (long)0 {
      return true;
    }
    let len = self.length();
    if slen > len {
      return false;
    }
    return feng_string_range_equal(self, len - slen, len, suffix, (long)0, slen);
  }

  /**
   * Replaces all occurrences of `old` with `replacement`, returns a new string.
   * @param old - substring to find
   * @param replacement - substring to substitute
   * @return new string with all occurrences replaced
   */
  open func replace(old: string, replacement: string): string {
    let olen = old.length();
    if olen == (long)0 {
      return self.clone();
    }
    let slen = self.length();
    var result = "";
    var pos: long = 0;
    var found = self.indexOf(old, pos);
    while found >= (long)0 {
      if found > pos {
        result = result + self.clone(pos, found);
      }
      result = result + replacement;
      pos = found + olen;
      found = self.indexOf(old, pos);
    }
    if pos == (long)0 {
      return self.clone();
    }
    if pos < slen {
      result = result + self.clone(pos, slen);
    }
    return result;
  }

  /**
   * Removes leading Unicode whitespace characters, returns a new string.
   * @return trimmed string
   */
  open func trimStart(): string {
    let len = self.length();
    if len == (long)0 {
      return "";
    }
    let data: string* = &self;
    let end: string* = feng_pointer_move(data, len);
    var cursor: string* = data;
    var uc: u32 = 0;
    while !feng_pointer_equal(cursor, end) {
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        break;
      }
      if !isUnicodeWhitespace(uc) {
        break;
      }
      cursor = next;
    }
    let start = feng_pointer_diff(cursor, data);
    if start == len {
      return "";
    }
    return self.clone(start, len);
  }

  /**
   * Removes trailing Unicode whitespace characters, returns a new string.
   * @return trimmed string
   */
  open func trimEnd(): string {
    let len = self.length();
    if len == (long)0 {
      return "";
    }
    let data: string* = &self;
    var cursor: string* = feng_pointer_move(data, len);
    var uc: u32 = 0;
    while !feng_pointer_equal(cursor, data) {
      let prev: string* = u8_prev(&uc, cursor, data);
      if feng_pointer_is_null(prev) {
        break;
      }
      if !isUnicodeWhitespace(uc) {
        break;
      }
      cursor = prev;
    }
    let trimmed = feng_pointer_diff(cursor, data);
    if trimmed == (long)0 {
      return "";
    }
    return self.clone((long)0, trimmed);
  }

  /**
   * Removes leading and trailing Unicode whitespace characters, returns a new string.
   * @return trimmed string
   */
  open func trim(): string {
    return self.trimStart().trimEnd();
  }

}

/**
 * Encodes a Unicode code point into UTF-8 bytes and appends to a byte list.
 */
func encodeUtf8(cp: u32, output: List<byte>) {
  if cp < (u32)0x80 {
    output.add((byte)cp);
  } else if cp < (u32)0x800 {
    output.add((byte)((u32)0xC0 | (cp >> (u32)6)));
    output.add((byte)((u32)0x80 | (cp & (u32)0x3F)));
  } else if cp < (u32)0x10000 {
    output.add((byte)((u32)0xE0 | (cp >> (u32)12)));
    output.add((byte)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
    output.add((byte)((u32)0x80 | (cp & (u32)0x3F)));
  } else {
    output.add((byte)((u32)0xF0 | (cp >> (u32)18)));
    output.add((byte)((u32)0x80 | ((cp >> (u32)12) & (u32)0x3F)));
    output.add((byte)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
    output.add((byte)((u32)0x80 | (cp & (u32)0x3F)));
  }
}

/**
 * Extends `string` with utility and case conversion operations.
 */
open fit string {

  /**
   * Returns whether this string is empty (has zero bytes).
   * @return true if length is 0
   */
  open func isEmpty(): bool {
    return self.length() == (long)0;
  }

  /**
   * Returns the UTF-8 byte array of this string.
   * @return byte array copy of the string's UTF-8 content
   */
  open func toBytes(): byte[] {
    return feng_string_to_utf8_bytes(self);
  }

  /**
   * Returns a new string that repeats this string `count` times.
   * @param count - number of repetitions (must be >= 0)
   * @return repeated string
   */
  open func repeat(count: long): string {
    if count < (long)0 {
      throw "String repeat count must be non-negative";
    }
    if count == (long)0 || self.length() == (long)0 {
      return "";
    }
    var result = "";
    var i: long = 0;
    while i < count {
      result = result + self;
      i += (long)1;
    }
    return result;
  }

  /**
   * Splits this string by the given separator, returning an array of substrings.
   * @param separator - delimiter string; if empty, returns array with original string
   * @return array of substrings
   */
  open func split(separator: string): string[] {
    let parts = List<string>();
    let sepLen = separator.length();
    if sepLen == (long)0 {
      parts.add(self.clone());
      return parts.entries();
    }
    let slen = self.length();
    var pos: long = 0;
    var found = self.indexOf(separator, pos);
    while found >= (long)0 {
      if found > pos {
        parts.add(self.clone(pos, found));
      } else {
        parts.add("");
      }
      pos = found + sepLen;
      found = self.indexOf(separator, pos);
    }
    if pos <= slen {
      if pos < slen {
        parts.add(self.clone(pos, slen));
      } else {
        parts.add("");
      }
    }
    return parts.entries();
  }

  /**
   * Joins an array of strings with a separator.
   * @param separator - string inserted between elements
   * @param parts - array of strings to join
   * @return joined string
   */
  open static func join(separator: string, parts: string[]): string {
    let len = parts.length();
    if len == (long)0 {
      return "";
    }
    var result = parts[0];
    var i: long = 1;
    while i < len {
      result = result + separator + parts[i];
      i += (long)1;
    }
    return result;
  }

  /**
   * Returns a new string with all Unicode characters converted to uppercase.
   * @return uppercase string
   */
  open func toUpperCase(): string {
    let len = self.length();
    if len == (long)0 {
      return "";
    }
    let data: string* = &self;
    let end: string* = feng_pointer_move(data, len);
    var cursor: string* = data;
    let output = List<byte>();
    var uc: u32 = 0;
    while !feng_pointer_equal(cursor, end) {
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        break;
      }
      let mapped = uc_toupper(uc);
      encodeUtf8(mapped, output);
      cursor = next;
    }
    return string.fromUtf8Bytes(output.entries());
  }

  /**
   * Returns a new string with all Unicode characters converted to lowercase.
   * @return lowercase string
   */
  open func toLowerCase(): string {
    let len = self.length();
    if len == (long)0 {
      return "";
    }
    let data: string* = &self;
    let end: string* = feng_pointer_move(data, len);
    var cursor: string* = data;
    let output = List<byte>();
    var uc: u32 = 0;
    while !feng_pointer_equal(cursor, end) {
      let next: string* = u8_next(&uc, cursor);
      if feng_pointer_is_null(next) {
        break;
      }
      let mapped = uc_tolower(uc);
      encodeUtf8(mapped, output);
      cursor = next;
    }
    return string.fromUtf8Bytes(output.entries());
  }

  /**
   * Pads the start of this string to reach `targetLength` bytes using `pad`.
   * If the string is already at or longer than targetLength, returns a clone.
   * @param targetLength - desired minimum byte length
   * @param pad - string used for padding (repeated/truncated as needed)
   * @return padded string
   */
  open func padStart(targetLength: long, pad: string): string {
    let len = self.length();
    if len >= targetLength {
      return self.clone();
    }
    let padLen = pad.length();
    if padLen == (long)0 {
      return self.clone();
    }
    let needed = targetLength - len;
    let fullRepeats = needed / padLen;
    let remainder = needed - fullRepeats * padLen;
    var padding = pad.repeat(fullRepeats);
    if remainder > (long)0 {
      padding = padding + pad.clone((long)0, remainder);
    }
    return padding + self;
  }

  /**
   * Pads the end of this string to reach `targetLength` bytes using `pad`.
   * If the string is already at or longer than targetLength, returns a clone.
   * @param targetLength - desired minimum byte length
   * @param pad - string used for padding (repeated/truncated as needed)
   * @return padded string
   */
  open func padEnd(targetLength: long, pad: string): string {
    let len = self.length();
    if len >= targetLength {
      return self.clone();
    }
    let padLen = pad.length();
    if padLen == (long)0 {
      return self.clone();
    }
    let needed = targetLength - len;
    let fullRepeats = needed / padLen;
    let remainder = needed - fullRepeats * padLen;
    var padding = pad.repeat(fullRepeats);
    if remainder > (long)0 {
      padding = padding + pad.clone((long)0, remainder);
    }
    return self + padding;
  }

}