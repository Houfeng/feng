open module std.text;

import std.collections;

@runtime
extern func feng_string_utf8_length(value: string): long;

@runtime
extern func feng_string_from_utf8_bytes(value: byte[], length: long): string;

@runtime
extern func feng_string_slice(value: string, start: long, length: long): string;

@runtime
extern func feng_string_slice_bytes(value: string, start: long, length: long): byte[];

/**
 * Extends `string` with standard UTF-8 operations.
 */
open fit string {
  /**
   * Returns a new string by copying all bytes from `bytes`.
   * @param bytes - UTF-8 byte sequence to copy
   * @return string containing the copied bytes
   */
  open static func fromUtf8Bytes(bytes: byte[]): string {
    return feng_string_from_utf8_bytes(bytes, bytes.length());
  }

  /**
   * Returns the UTF-8 byte length of this string.
   * @return number of bytes in this string
   */
  open func length(): long {
    return feng_string_utf8_length(self);
  }

  /**
   * Returns a single-byte substring at the specified byte offset.
   * For character-level access, use `runes()` or `graphemes()` views.
   * @param index - zero-based byte offset
   * @return length-1 substring containing the byte at `index`
   */
  open func at(index: long): string {
    if index < (long)0 {
      throw "String index out of bounds";
    }
    if index >= self.length() {
      throw "String index out of bounds";
    }
    return feng_string_slice(self, index, (long)1);
  }

  /**
   * Returns a dense copy of this string.
   * @return new string containing all bytes of this string
   */
  open func clone(): string {
    return self.clone((long)0, self.length());
  }

  /**
   * Returns a dense copy of the byte range `[start, end)`.
   * @param start - zero-based inclusive start byte offset
   * @param end - zero-based exclusive end byte offset
   * @return new string containing bytes from `start` to `end`
   */
  open func clone(start: long, end: long): string {
    if start < (long)0 {
      throw "String clone start out of bounds";
    }
    if end < start {
      throw "String clone end out of bounds";
    }
    if end > self.length() {
      throw "String clone end out of bounds";
    }
    return feng_string_slice(self, start, end - start);
  }

}