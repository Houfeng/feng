open module std.json;

import std;
import std.numeric;
import std.text;
import std.collections;

open fit bool {
  func toJsonString(): string {
    return self.toString();
  }
}

open fit double {
  func toJsonString(): string {
    return self.toString();
  }
}

open fit string {
  func toJsonString(): string {
    return "\"" + self.replace("\"", "\\\"") + "\"";
  }
}

open fit None {
  func toJsonString(): string {
    return "null";
  }
}

open type JsonArray {
  seal let payload: List<JsonPayload>;
  func JsonArray(payload: List<JsonPayload>) {
    self.payload = payload;
  }
  func JsonArray(payload: JsonPayload[]) {
    self.payload = List<JsonPayload>(payload);
  }
  func JsonArray() {}
  func add(item: JsonPayload) {
    self.payload.add(item);
  }
  func add(item: JsonValue) {
    self.payload.add(item.payload);
  }
  /**
   * Returns the number of elements in this array.
   */
  func size(): i32 {
    return self.payload.size();
  }
  /**
   * Returns the element at the given index as a JsonValue.
   * @param index - zero-based position
   * @return the element as JsonValue
   */
  func get(index: i32): JsonValue {
    return JsonValue(self.payload.get(index));
  }
  func toJsonString(): string {
    let size = self.payload.size();
    if size == 0 {
      return "[]";
    }
    let parts: string[!] = string[:size];
    for var i: i32 = 0; i < size; i = i + 1 {
      let item = JsonValue(self.payload.get(i));
      parts[i] = item.toJsonString();
    }
    return "[" + string.join(",", (string[])parts) + "]";
  }
}

open type JsonObject {
  seal let payload: Map<string, JsonPayload>;
  func JsonObject(payload: Map<string, JsonPayload>) {
    self.payload = payload;
  }
  func JsonObject() {}
  /**
   * Sets the value for the given key.
   * @param key - the key to set
   * @param value - the value to associate with the key
   */
  func set(key: string, value: JsonPayload) {
    self.payload.set(key, value);
  }
  /**
   * Sets the value for the given key from a JsonValue.
   * @param key - the key to set
   * @param value - the JsonValue whose payload to associate with the key
   */
  func set(key: string, value: JsonValue) {
    self.payload.set(key, value.payload);
  }
  /**
   * Returns the value for the given key as a JsonValue.
   * @param key - the key to look up
   * @return the associated JsonValue, or an empty JsonValue if not found
   */
  func get(key: string): JsonValue {
    return JsonValue(self.payload.get(key));
  }
  /**
   * Returns true if the given key exists in this object.
   * @param key - the key to check
   * @return true if the key exists
   */
  func has(key: string): bool {
    return self.payload.has(key);
  }
  func toJsonString(): string {
    let entries = self.payload.entries();
    if entries.length() == (long)0 {
      return "{}";
    }
    let len = entries.length();
    let parts: string[!] = string[:len];
    var idx: long = 0;
    for let entry in entries {
      let key = entry.item1.toJsonString();
      let val = JsonValue(entry.item2).toJsonString();
      parts[idx] = key + ":" + val;
      idx += (long)1;
    }
    return "{" + string.join(",", (string[])parts) + "}";
  }
}

open spec JsonPayload: None
| double
| bool
| string
| JsonArray
| JsonObject;

open type JsonValue {
  let payload: JsonPayload;

  func JsonValue(payload: JsonPayload) {
    self.payload = payload;
  }

  func JsonValue() {}

  func isNull(): bool {
    return if self.payload {
      None { true }
      else { false }
    };
  }

  func isBool(): bool {
    return if self.payload {
      bool { true }
      else { false }
    };
  }

  func isNumber(): bool {
    return if self.payload {
      double { true }
      else { false }
    };
  }

  func isString(): bool {
    return if self.payload {
      string { true }
      else { false }
    };
  }

  func isArray(): bool {
    return if self.payload {
      JsonArray { true }
      else { false }
    };
  }

  func isObject(): bool {
    return if self.payload {
      JsonObject { true }
      else { false }
    };
  }

  func asNull(): None {
    return if self.payload {
      None { self.payload }
      else { none }
    };
  }

  func asBool(): bool {
    return if self.payload {
      bool { self.payload }
      else { false }
    };
  }

  func asNumber(): double {
    return if self.payload {
      double { self.payload }
      else { 0.0 }
    };
  }

  func asString(): string {
    return if self.payload {
      string { self.payload }
      else { "" }
    };
  }

  func asArray(): JsonArray {
    return if self.payload {
      JsonArray { self.payload }
      else { JsonArray() }
    };
  }

  func asObject(): JsonObject {
    return if self.payload {
      JsonObject { self.payload }
      else { JsonObject() }
    };
  }

  func toJsonString(): string {
    return if self.payload {
      None { self.payload.toJsonString() }
      bool { self.payload.toJsonString() }
      double { self.payload.toJsonString() }
      string { self.payload.toJsonString() }
      JsonArray { self.payload.toJsonString() }
      JsonObject { self.payload.toJsonString() }
      else { "null" }
    };
  }

  func toString(): string {
    return self.toJsonString();
  }

}
