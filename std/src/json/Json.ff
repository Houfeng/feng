open module std.json;

import std;
import std.text;

/**
 * JSON processing module
 * This module provides functions for working with JSON data, including:
 * - Checking the type of a JsonValue
 * - Converting a JsonValue to a specific type
 * - Serializing a JsonValue to a JSON string
 * - Deserializing a JSON string to a JsonValue
 * - Serializing a value of type T to a JSON string using the JsonSerializable specification
 */
open type Json {

  /**
   * Seal the Json type to prevent instantiation
   * This type is not meant to be instantiated, as it only provides static methods for working
   */
  seal func Json() {}

  /**
   * Check if a JsonValue is null
   * @param value The JsonValue to check
   * @return true if the value is null, false otherwise
   */
  static func isNull(value: JsonValue): bool {
    return match value {
      None { true }
      else { false }
    };
  }

  /**
   * Check if a JsonValue is a boolean
   * @param value The JsonValue to check
   * @return true if the value is a boolean, false otherwise
   */
  static func isBool(value: JsonValue): bool {
    return match value {
      bool { true }
      else { false }
    };
  }

  /**
   * Check if a JsonValue is a number
   * @param value The JsonValue to check
   * @return true if the value is a number, false otherwise
   */
  static func isNumber(value: JsonValue): bool {
    return match value {
      i32 { true }
      float { true }
      double { true }
      else { false }
    };
  }

  /**
   * Check if a JsonValue is a string
   * @param value The JsonValue to check
   * @return true if the value is a string, false otherwise
   */
  static func isString(value: JsonValue): bool {
    return match value {
      string { true }
      else { false }
    };
  }

  /**
   * Check if a JsonValue is an array
   * @param value The JsonValue to check
   * @return true if the value is an array, false otherwise
   */
  static func isArray(value: JsonValue): bool {
    return match value {
      JsonArray { true }
      else { false }
    };
  }

  /**
   * Check if a JsonValue is an object
   * @param value The JsonValue to check
   * @return true if the value is an object, false otherwise
   */
  static func isObject(value: JsonValue): bool {
    return match value {
      JsonObject { true }
      else { false }
    };
  }

  /**
   * Convert a JsonValue to a string
   * @param value The JsonValue to convert
   * @return The string
   */
  static func toString(value: JsonValue): string {
    return match (value) {
      v: string { v }
      else { "" }
    };
  }

  /**
   * Convert a JsonValue to a number
   * @param value The JsonValue to convert
   * @return The number
   */
  static func toNumber(value: JsonValue): double {
    return match (value) {
      v: i32 {(double)v }
      v: float {(double)v }
      v: double { v }
      else {(double)0 }
    };
  }

  /**
   * Convert a JsonValue to a boolean
   * @param value The JsonValue to convert
   * @return The boolean
   */
  static func toBool(value: JsonValue): bool {
    return match (value) {
      v: bool { v }
      else { false }
    };
  }

  /**
   * Convert a JsonValue to an array
   * @param value The JsonValue to convert
   * @return The array
   */
  static func toArray(value: JsonValue): JsonArray {
    return match (value) {
      v: JsonArray { v }
      else { JsonArray() }
    };
  }

  /**
   * Convert a JsonValue to an object
   * @param value The JsonValue to convert
   * @return The object
   */
  static func toObject(value: JsonValue): JsonObject {
    return match (value) {
      v: JsonObject { v }
      else { JsonObject() }
    };
  }

  /**
   * Convert a JsonValue to a string or None
   * @param value The JsonValue to convert
   * @return The string or None
   */
  static func toStringOrNull(value: JsonValue): Option<string> {
    if Json.isNull(value) { return none; }
    return Json.toString(value);
  }

  /**
   * Convert a JsonValue to a number or None
   * @param value The JsonValue to convert
   * @return The number or None
   */
  static func toNumberOrNull(value: JsonValue): Option<double> {
    if Json.isNull(value) { return none; }
    return Json.toNumber(value);
  }

  /**
   * Convert a JsonValue to a boolean or None
   * @param value The JsonValue to convert
   * @return The boolean or None
   */
  static func toBoolOrNull(value: JsonValue): Option<bool> {
    if Json.isNull(value) { return none; }
    return Json.toBool(value);
  }

  /**
   * Convert a JsonValue to an array or None
   * @param value The JsonValue to convert
   * @return The array or None
   */
  static func toArrayOrNull(value: JsonValue): Option<JsonArray> {
    if Json.isNull(value) { return none; }
    return Json.toArray(value);
  }

  /**
   * Convert a JsonValue to an object or None
   * @param value The JsonValue to convert
   * @return The object or None
   */
  static func toObjectOrNull(value: JsonValue): Option<JsonObject> {
    if Json.isNull(value) { return none; }
    return Json.toObject(value);
  }

  /**
   * Serialize a JsonValue to a JSON string
   * @param value The JsonValue to serialize
   * @return The JSON string
   */
  static func stringify(value: JsonValue): string {
    return match value {
      v: None { v.toJsonString() }
      v: bool { v.toJsonString() }
      v: i32 { v.toJsonString() }
      v: float { v.toJsonString() }
      v: double { v.toJsonString() }
      v: string { v.toJsonString() }
      v: JsonArray { v.toJsonString() }
      v: JsonObject { v.toJsonString() }
      else { "null" }
    };
  }

  /**
   * Deserialize a JSON string to a JsonValue
   * @param json The JSON string to deserialize
   * @return The JsonValue
   */
  static func parse(json: string): JsonValue {
    return JsonParser.parse(json);
  }

  /**
   * Serialize a value of type T to a JSON string
   * @param value The value to serialize
   * @return The JSON string
   */
  static func stringify<T: JsonSerializable<T>>(value: T): string {
    let jsonValue = T.toJson(value);
    return Json.stringify(jsonValue);
  }

  /**
   * Deserialize a JSON string to a value of type T
   * @param json The JSON string to deserialize
   * @return The value of type T
   */
  static func parse<T: JsonDeserializable<T>>(json: string): T {
    let jsonValue = Json.parse(json);
    if (Json.isObject(jsonValue)) {
      return T.fromJson(Json.toObject(jsonValue));
    } else {
      throw "Invalid JSON string";
    }
  }

}