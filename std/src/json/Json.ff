open module std.json;

import std;

/**
 * JSON 处理模块
 */
open type Json {

  seal func Json() {}

  static func isNull(value: JsonValue): bool {
    return if value {
      None { true }
      else { false }
    };
  }

  static func isBool(value: JsonValue): bool {
    return if value {
      bool { true }
      else { false }
    };
  }

  static func isNumber(value: JsonValue): bool {
    return if value {
      int { true }
      float { true }
      double { true }
      else { false }
    };
  }

  static func isString(value: JsonValue): bool {
    return if value {
      string { true }
      else { false }
    };
  }

  static func isArray(value: JsonValue): bool {
    return if value {
      JsonArray { true }
      else { false }
    };
  }

  static func isObject(value: JsonValue): bool {
    return if value {
      JsonObject { true }
      else { false }
    };
  }

  static func toString(value: JsonValue): string {
    return if (value) {
      string { value }
      else { "" }
    };
  }

  static func toNumber(value: JsonValue): double {
    return if (value) {
      int {(double)value }
      float {(double)value }
      double { value }
      else {(double)0 }
    };
  }

  static func toBool(value: JsonValue): bool {
    return if (value) {
      bool { value }
      else { false }
    };
  }

  static func toArray(value: JsonValue): JsonArray {
    return if (value) {
      JsonArray { value }
      else { JsonArray() }
    };
  }

  static func toObject(value: JsonValue): JsonObject {
    return if (value) {
      JsonObject { value }
      else { JsonObject() }
    };
  }

  static func toStringOrNone(value: JsonValue): Option<string> {
    if Json.isNull(value) { return none; }
    return Json.toString(value);
  }

  static func toNumberOrNone(value: JsonValue): Option<double> {
    if Json.isNull(value) { return none; }
    return Json.toNumber(value);
  }

  static func toBoolOrNone(value: JsonValue): Option<bool> {
    if Json.isNull(value) { return none; }
    return Json.toBool(value);
  }

  static func toArrayOrNone(value: JsonValue): Option<JsonArray> {
    if Json.isNull(value) { return none; }
    return Json.toArray(value);
  }

  static func toObjectOrNone(value: JsonValue): Option<JsonObject> {
    if Json.isNull(value) { return none; }
    return Json.toObject(value);
  }

  /**
   * 序列化
   */
  static func stringify(value: JsonValue): string {
    return if value {
      None { value.toJsonString() }
      bool { value.toJsonString() }
      int { value.toJsonString() }
      float { value.toJsonString() }
      double { value.toJsonString() }
      string { value.toJsonString() }
      JsonArray { value.toJsonString() }
      JsonObject { value.toJsonString() }
      else { "null" }
    };
  }

  static func stringify(value: JsonSerializable): string {
    return Json.stringify(value.toJson());
  }

  /**
   * 反序列化
   */
  static func parse(json: string): JsonValue {
    return JsonParser.parse(json);
  }

}