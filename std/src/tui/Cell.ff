open module std.tui;

/**
 * Cell represents a single character cell in a terminal user interface (TUI).
 * Each cell contains a Unicode code point and style information.
 */
@value
open type Cell {
  /**
   * 字符的 Unicode 码点
   * 支持所有 Unicode 字符，包括 Emoji、汉字、拉丁字母等
   * 部分超过 8 字节的组合 emoji 通过 ZWJ 拆分为多个 emoji
   */
  seal var value: u64;

  /**
   * 获取字符的 Unicode 码点
   */
  func value(): u64 {
    return self.value;
  }

  /**
   * 字符的样式信息
   * 通过或与运算，支持多种样式的组合，例如粗体、斜体、下划线、前景色、背景色等
   *
   * [ 16 bits 样式与标志位 ] [ 24 bits 背景 RGB ] [ 24 bits 前景 RGB ]
   * 直接用 16 进制表式，比如： 0x0001ADD8E6FF0000
   *
   * ==========================================
   * 提取前景色 (最低 24 bits)
   * ------------------------------------------
   * 直接使用 0xFFFFFF 掩码截取，指令开销最小
   * (self.style & 0xFFFFFF)
   *
   * ==========================================
   * 提取背景色 (中间 24 bits)
   * ------------------------------------------
   * 先右移 24 位，再使用 0xFFFFFF 掩码截取
   * ((self.style >> 24) & 0xFFFFFF)
   *
   * ==========================================
   * 样式位掩码常量定义 (占用 48-63 位)
   * ------------------------------------------
   * let STYLE_BOLD: u64          = 1 << 48;
   * let STYLE_DIM: u64           = 1 << 49;
   * let STYLE_ITALIC: u64        = 1 << 50;
   * let STYLE_UNDERLINE: u64     = 1 << 51;
   * let STYLE_BLINK: u64         = 1 << 52;
   * let STYLE_REVERSE: u64       = 1 << 53;
   * let STYLE_HIDDEN: u64        = 1 << 54;
   * let STYLE_STRIKETHROUGH: u64 = 1 << 55;
   *
   */
  seal var style: u64;

  /**
   * 获取样式信息
   */
  func style(): u64 {
    return self.style;
  }

  /**
   * 获取前景色
   */
  func foreColor(): u32 {
    return (u32)(self.style & 0xFFFFFF);
  }

  /**
   * 设置前景色
   */
  func foreColor(value: u32): void {
    self.style = (self.style & (u64)(~0xFFFFFF)) | ((u64)(value & 0xFFFFFF));
  }

  /**
   * 获取取背景色
   */
  func backColor(): u32 {
    return (u32)((self.style >> 24) & 0xFFFFFF);
  }

  /**
   *  设置背景色
   */
  func backColor(value: u32): void {
    self.style = (self.style & (u64)(~(0xFFFFFF << 24))) | ((u64)(value & 0xFFFFFF) << 24);
  }

  /**
   * 是否为粗体
   */
  func bold(): bool {
    return (self.style & (1 << 48)) != 0;
  }

  /**
   * 设置粗体
   */
  func bold(value: bool): void {
    if value {
      self.style |= (1 << 48);
    } else {
      self.style &= (u64)(~(1 << 48));
    }
  }

  /**
   * 是否为暗淡
   */
  func dim(): bool {
    return (self.style & (1 << 49)) != 0;
  }

  /**
   * 设置暗淡
   */
  func dim(value: bool): void {
    if value {
      self.style |= (1 << 49);
    } else {
      self.style &= (u64)(~(1 << 49));
    }
  }

  /**
   * 是否为斜体
   */
  func italic(): bool {
    return (self.style & (1 << 50)) != 0;
  }

  /**
   * 设置斜体
   */
  func italic(value: bool): void {
    if value {
      self.style |= (1 << 50);
    } else {
      self.style &= (u64)(~(1 << 50));
    }
  }

  /**
   * 是否为下划线
   */
  func underline(): bool {
    return (self.style & (1 << 51)) != 0;
  }

  /**
   * 设置下划线
   */
  func underline(value: bool): void {
    if value {
      self.style |= (1 << 51);
    } else {
      self.style &= (u64)(~(1 << 51));
    }
  }

  /**
   * 是否为闪烁
   */
  func blink(): bool {
    return (self.style & (1 << 52)) != 0;
  }

  /**
   * 设置闪烁
   */
  func blink(value: bool): void {
    if value {
      self.style |= (1 << 52);
    } else {
      self.style &= (u64)(~(1 << 52));
    }
  }

  /**
   * 是否为反转
   */
  func reverse(): bool {
    return (self.style & (1 << 53)) != 0;
  }

  /**
   * 设置反转
   */
  func reverse(value: bool): void {
    if value {
      self.style |= (1 << 53);
    } else {
      self.style &= (u64)(~(1 << 53));
    }
  }

  /**
   * 是否为隐藏
   */
  func hidden(): bool {
    return (self.style & (1 << 54)) != 0;
  }

  /**
   * 设置隐藏
   */
  func hidden(value: bool): void {
    if value {
      self.style |= (1 << 54);
    } else {
      self.style &= (u64)(~(1 << 54));
    }
  }

  /**
   * 是否为删除线
   */
  func strikeThrough(): bool {
    return (self.style & (1 << 55)) != 0;
  }

  /**
   * 设置删除线
   */
  func strikeThrough(value: bool): void {
    if value {
      self.style |= (1 << 55);
    } else {
      self.style &= (u64)(~(1 << 55));
    }
  }
}
