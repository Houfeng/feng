open module std.fs;

import std.collections;
import std.text;

// libc POSIX stat
@cdecl("libc", "stat")
extern func posix_stat(p: byte*, buf: i64*): int;

// Runtime helpers
@runtime
extern func feng_string_to_utf8_bytes(value: string): byte[];

@runtime
extern func feng_pointer_move(ptr: int*, offset: int): int*;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: int*): T;

// POSIX stat struct offsets (macOS aarch64, 64-bit inode)
seal let STAT_MODE_OFFSET: int = (int)4;
seal let STAT_SIZE_OFFSET: int = (int)96;
seal let STAT_ATIME_OFFSET: int = (int)32;
seal let STAT_MTIME_OFFSET: int = (int)48;
seal let STAT_CTIME_OFFSET: int = (int)64;

// POSIX S_IF* file type masks
seal let S_IFMT: i64 = (i64)61440;
seal let S_IFIFO: i64 = (i64)4096;
seal let S_IFCHR: i64 = (i64)8192;
seal let S_IFDIR: i64 = (i64)16384;
seal let S_IFBLK: i64 = (i64)24576;
seal let S_IFREG: i64 = (i64)32768;
seal let S_IFLNK: i64 = (i64)40960;
seal let S_IFSOCK: i64 = (i64)49152;

/**
 * Filesystem entry kind, replacing boolean isFile/isDir/isSymlink flags to prevent inconsistent state.
 */
open enum EntryKind {
  /**
   * Unknown file type.
   */
  Other = 0,

  /**
   * Named pipe (FIFO).
   */
  Fifo = 1,

  /**
   * Character device.
   */
  CharDevice = 2,

  /**
   * Directory.
   */
  Dir = 4,

  /**
   * Block device.
   */
  BlockDevice = 6,

  /**
   * Regular file.
   */
  File = 8,

  /**
   * Symbolic link.
   */
  Symlink = 10,

  /**
   * Unix domain socket.
   */
  Socket = 12
}

/**
 * File open mode, covering all meaningful POSIX open() flag combinations.
 *
 * Values correspond to macOS POSIX open flag combinations:
 *   O_RDONLY=0, O_WRONLY=1, O_RDWR=2,
 *   O_CREAT=512, O_TRUNC=1024, O_EXCL=2048, O_APPEND=8
 */
open enum FileMode {
  /**
   * Open file for reading.
   */
  Read = 0,

  /**
   * Open file for writing.
   */
  Write = 513,

  /**
   * Open file for writing, truncating it first.
   */
  WriteTrunc = 1537,

  /**
   * Open file for writing, creating it first.
   */
  WriteNew = 2561,

  /**
   * Open file for writing, appending to it if it exists.
   */
  WriteAppend = 521,

  /**
   * Open file for reading and writing.
   */
  ReadWrite = 2,

  /**
   * Open file for reading and writing, truncating it first.
   */
  ReadWriteCreate = 514,

  /**
   * Open file for reading and writing, truncating it first.
   */
  ReadWriteTrunc = 1538,

  /**
   * Open file for reading and writing, creating it first.
   */
  ReadWriteNew = 2562,

  /**
   * Open file for reading and writing, appending to it if it exists.
   */
  ReadWriteAppend = 522,

  /**
   * Open file for appending.
   */
  AppendExisting = 10
}

/**
 * Full metadata for a file/directory, returned by stat-family operations.
 * All fields are read-only.
 */
open type StatInfo {
  /**
   * File kind.
   */
  let kind: EntryKind;

  /**
   * File size in bytes.
   */
  let size: i64;

  /**
   * File mode bits.
   */
  let mode: u64;

  /**
   * Last modification time.
   */
  let modifiedAt: i64;

  /**
   * Last access time.
   */
  let accessedAt: i64;

  /**
   * Last change time.
   */
  let changedAt: i64;
}

/**
 * Lightweight directory entry info, returned by Dir.read or the Dir iterator.
 */
open type EntryInfo {
  /**
   * Entry name.
   */
  let name: string;

  /**
   * Entry path.
   */
  let path: string;

  /**
   * Entry kind.
   */
  let kind: EntryKind;

  /**
   * Directory path.
   */
  seal var dirPath: byte[];

  /**
   * Get the full metadata of this entry, calling POSIX stat internally (following symlinks).
   * @return StatInfo of the entry
   */
  open func stat(): StatInfo {
    let pathBytes = makeNullTerminatedPath(self.path);
    let statBuf: i64[!] = i64[:(i64)16];
    let rc = posix_stat(&pathBytes, &statBuf);
    if rc != 0 {
      throw "fs/stat-failed";
    }
    return readStatInfo(statBuf);
  }
}

/**
 * Extract EntryKind from st_mode (by S_IF* bit mask).
 */
seal func entryKindFromMode(mode: i64): EntryKind {
  let fileType = mode & S_IFMT;
  if fileType == S_IFREG { return EntryKind.File; }
  if fileType == S_IFDIR { return EntryKind.Dir; }
  if fileType == S_IFLNK { return EntryKind.Symlink; }
  if fileType == S_IFIFO { return EntryKind.Fifo; }
  if fileType == S_IFSOCK { return EntryKind.Socket; }
  if fileType == S_IFCHR { return EntryKind.CharDevice; }
  if fileType == S_IFBLK { return EntryKind.BlockDevice; }
  return EntryKind.Other;
}

/**
 * Map a dirent d_type value to EntryKind.
 * d_type values directly correspond to DT_* constants, matching EntryKind enum values.
 */
seal func entryKindFromDType(dtype: i64): EntryKind {
  if dtype == (i64)8 { return EntryKind.File; }
  if dtype == (i64)4 { return EntryKind.Dir; }
  if dtype == (i64)10 { return EntryKind.Symlink; }
  if dtype == (i64)1 { return EntryKind.Fifo; }
  if dtype == (i64)12 { return EntryKind.Socket; }
  if dtype == (i64)2 { return EntryKind.CharDevice; }
  if dtype == (i64)6 { return EntryKind.BlockDevice; }
  return EntryKind.Other;
}

/**
 * Convert a Feng string path to a NUL-terminated UTF-8 byte array for passing to POSIX C functions.
 */
seal func makeNullTerminatedPath(path: string): byte[!] {
  let pathBytes = feng_string_to_utf8_bytes(path);
  let pathLen = pathBytes.length();
  let nameBuf: byte[!] = byte[:pathLen + (i64)1];
  for var i: i64 = (i64)0; i < pathLen; i += (i64)1 {
    nameBuf[i] = pathBytes[i];
  }
  nameBuf[pathLen] = (byte)0;
  return nameBuf;
}

/**
 * Extract StatInfo from a POSIX stat buffer.
 * Uses known field offsets for macOS aarch64 struct stat.
 */
seal func readStatInfo(statBuf: i64[!]): StatInfo {
  let modeRaw: i64 = feng_pointer_get_scalar<i64>(feng_pointer_move(&statBuf, STAT_MODE_OFFSET));
  let modeMasked = modeRaw & S_IFMT;
  let kind = entryKindFromMode(modeMasked);

  let size: i64 = feng_pointer_get_scalar<i64>(feng_pointer_move(&statBuf, STAT_SIZE_OFFSET));

  let permBits: i64 = modeRaw & (i64)4095;

  let atime: i64 = feng_pointer_get_scalar<i64>(feng_pointer_move(&statBuf, STAT_ATIME_OFFSET));
  let mtime: i64 = feng_pointer_get_scalar<i64>(feng_pointer_move(&statBuf, STAT_MTIME_OFFSET));
  let ctime: i64 = feng_pointer_get_scalar<i64>(feng_pointer_move(&statBuf, STAT_CTIME_OFFSET));

  return StatInfo {
    kind: kind,
    size: (i64)size,
    mode: (u64)permBits,
    modifiedAt: (i64)mtime,
    accessedAt: (i64)atime,
    changedAt: (i64)ctime
  };
}
