open module std.fs;

import std.collections;
import std.text;
import std.platform;

// 不透明类型：表示 struct dirent 指针
@abi
seal type Dirent {}

// libc directory operations
@cdecl("libc", "opendir")
extern func c_opendir(path: byte*): i64;

@cdecl("libc", "readdir")
extern func c_readdir(dir: i64): Dirent*;

@cdecl("libc", "closedir")
extern func c_closedir(dir: i64): i32;

@cdecl("libc", "mkdir")
extern func c_mkdir(path: byte*, mode: i32): i32;

@cdecl("libc", "rmdir")
extern func c_rmdir(path: byte*): i32;

// Dirent* 指针操作
@runtime
extern func feng_pointer_is_null(ptr: Dirent*): bool;

@runtime
extern func feng_pointer_move(ptr: Dirent*, offset: i64): Dirent*;

@runtime
extern func feng_pointer_get_scalar<T>(ptr: Dirent*): T;

// dirent struct offsets，根据 SystemInfo.os/arch 惰性初始化
// macOS: struct dirent { __uint64_t d_ino(0); __uint64_t d_seekoff(8);
//   __uint16_t d_reclen(16); __uint16_t d_namlen(18);
//   __uint8_t d_type(20); char d_name[1024](21); }
// Linux: struct dirent { unsigned i64 d_ino(0); unsigned i64 d_off(8);
//   unsigned short d_reclen(16); unsigned char d_type(18);
//   char d_name[256](19); } — 无 d_namlen 字段，DIRENT_DNAMLEN_OFFSET 为 -1
seal var DIRENT_DTYPE_OFFSET: i64 = (i64)0;
seal var DIRENT_DNAMLEN_OFFSET: i64 = (i64)0;
seal var DIRENT_DNAME_OFFSET: i64 = (i64)0;
seal var direntOffsetsInited: bool = false;

/**
 * Initialize the dirent struct offsets based on the current OS and architecture.
 * macOS (arm64/aarch64/x86_64): d_type=20, d_namlen=18, d_name=21.
 * Linux (arm64/aarch64/x86_64): d_type=18, d_namlen=-1 (not present), d_name=19.
 */
seal func ensureDirentOffsets(): void {
  if direntOffsetsInited {
    return;
  }
  let os = SystemInfo.os();
  let arch = SystemInfo.arch();
  if os == "darwin" {
    if arch == "arm64" || arch == "aarch64" || arch == "x86_64" {
      DIRENT_DTYPE_OFFSET = (i64)20;
      DIRENT_DNAMLEN_OFFSET = (i64)18;
      DIRENT_DNAME_OFFSET = (i64)21;
    } else {
      throw "fs/unsupported-arch";
    }
  } else if os == "linux" {
    if arch == "arm64" || arch == "aarch64" || arch == "x86_64" {
      DIRENT_DTYPE_OFFSET = (i64)18;
      DIRENT_DNAMLEN_OFFSET = (i64)-1;
      DIRENT_DNAME_OFFSET = (i64)19;
    } else {
      throw "fs/unsupported-arch";
    }
  } else {
    throw "fs/unsupported-os";
  }
  direntOffsetsInited = true;
}

// Default directory creation permission: 0755 = 493
seal let DEFAULT_DIR_MODE: i32 = 493;

/**
 * Directory traversal object, wrapping a directory handle with read operations.
 */
open type Dir {
  seal var dir: i64;
  seal var dirPath: string;
  seal var closed: bool;

  /**
   * Open a directory and return a Dir instance.
   * @param path - Directory path
   */
  open static func create(path: string): Dir {
    let pathBytes = makeNullTerminatedPath(path);
    let dir = c_opendir(&pathBytes);
    if dir == (i64)0 {
      throw "fs/opendir-failed";
    }
    return Dir { dir: dir, dirPath: path, closed: false };
  }

  /**
   * Read up to batchSize directory entries; returns an empty array when traversal is complete.
   * @param batchSize - Batch size, must be greater than 0
   * @return Array of directory entries
   */
  open func read(batchSize: i64): EntryInfo[] {
    self.ensureOpen();
    if batchSize <= (i64)0 {
      throw "fs/readdir-failed";
    }
    let entries = List<EntryInfo>();
    var count: i64 = (i64)0;
    while count < batchSize {
      let entry = self.readEntry();
      if entry.name.length() == (i64)0 {
        break;
      }
      entries.add(entry);
      count += (i64)1;
    }
    return entries.entries();
  }

  /**
   * @iterator method, yields directory entries one by one, supporting for/in iteration.
   * @return IteratorResult<EntryInfo>; true yields a valid entry, false signals end of traversal
   */
  @iterator
  open func next(): IteratorResult<EntryInfo> {
    self.ensureOpen();
    let entry = self.readEntry();
    if entry.name.length() == (i64)0 {
      return (false, EntryInfo {
        name: "",
        path: "",
        kind: EntryKind.Other,
        dirPath: byte[:(i64)0]
      });
    }
    return (true, entry);
  }

  /**
   * Close the directory and release the underlying directory handle. Idempotent.
   */
  open func close(): void {
    if self.closed {
      return;
    }
    self.closed = true;
    try c_closedir(self.dir) catch {
      // 幂等：忽略 closedir 异常
    };
  }

  /**
   * Return whether the directory is closed.
   */
  open func isClosed(): bool {
    return self.closed;
  }

  /**
   * Internal: read a single directory entry.
   * Returns an EntryInfo with an empty name to signal end of traversal.
   */
  seal func readEntry(): EntryInfo {
    ensureDirentOffsets();
    let direntPtr = c_readdir(self.dir);
    if feng_pointer_is_null(direntPtr) {
      return EntryInfo {
        name: "",
        path: "",
        kind: EntryKind.Other,
        dirPath: byte[:(i64)0]
      };
    }

    // 读取 d_type（1 字节）
    let dtypePtr = feng_pointer_move(direntPtr, DIRENT_DTYPE_OFFSET);
    let dtypeLong: i64 = feng_pointer_get_scalar<i64>(dtypePtr);
    let dtype: byte = (byte)(dtypeLong & (i64)255);

    // 读取 d_name 并计算 nameLen
    let nameDataPtr = feng_pointer_move(direntPtr, DIRENT_DNAME_OFFSET);
    var nameLen: i64 = (i64)0;
    if DIRENT_DNAMLEN_OFFSET >= (i64)0 {
      // macOS: d_namlen 字段直接提供名称长度
      let namlenPtr = feng_pointer_move(direntPtr, DIRENT_DNAMLEN_OFFSET);
      let namlenLong: i64 = feng_pointer_get_scalar<i64>(namlenPtr);
      nameLen = namlenLong & (i64)255;
    } else {
      // Linux: 无 d_namlen 字段，扫描 d_name 的 null 终止符计算长度
      for var i: i64 = (i64)0; i < (i64)256; i += (i64)1 {
        let bytePtr = feng_pointer_move(nameDataPtr, i);
        let b: i64 = feng_pointer_get_scalar<i64>(bytePtr);
        if b == (i64)0 {
          break;
        }
        nameLen += (i64)1;
      }
    }

    // 拷贝 d_name 字节（长度 nameLen）
    let nameBuf: byte[!] = byte[:nameLen];
    for var i: i64 = (i64)0; i < nameLen; i += (i64)1 {
      let bytePtr = feng_pointer_move(nameDataPtr, i);
      let b: i64 = feng_pointer_get_scalar<i64>(bytePtr);
      nameBuf[i] = (byte)(b & (i64)255);
    }
    let name = string.fromUtf8Bytes((byte[])nameBuf);

    // 过滤 . 和 ..
    if name == "." || name == ".." {
      // 递归读取下一个条目
      return self.readEntry();
    }

    let kind = entryKindFromDType((i64)dtype);
    let fullPath = self.dirPath + "/" + name;

    return EntryInfo {
      name: name,
      path: fullPath,
      kind: kind,
      dirPath: feng_string_to_utf8_bytes(self.dirPath)
    };
  }

  /**
   * Internal: check whether the directory is open; throws if already closed.
   */
  seal func ensureOpen() {
    if self.closed {
      throw "fs/dir-closed";
    }
  }
}

// ---- 顶层便捷函数 ----

/**
 * Create a single directory; the parent directory must already exist.
 * @param path - Directory path
 */
open func mkdir(path: string): void {
  let pathBytes = makeNullTerminatedPath(path);
  let rc = c_mkdir(&pathBytes, DEFAULT_DIR_MODE);
  if rc != 0 {
    throw "fs/mkdir-failed";
  }
}

/**
 * Remove an empty directory; throws if the directory does not exist or is non-empty.
 * @param path - Directory path
 */
open func rmdir(path: string): void {
  let pathBytes = makeNullTerminatedPath(path);
  let rc = c_rmdir(&pathBytes);
  if rc != 0 {
    throw "fs/rmdir-failed";
  }
}

/**
 * Read all directory entries at once.
 * @param path - Directory path
 * @return Array of directory entries
 */
open func readDir(path: string): EntryInfo[] {
  let dir = Dir.create(path);
  let entries = List<EntryInfo>();
  while true {
    let batch = dir.read((i64)64);
    if batch.length() == (i64)0 {
      break;
    }
    for var i: i64 = (i64)0; i < batch.length(); i += (i64)1 {
      entries.add(batch[i]);
    }
  }
  dir.close();
  return entries.entries();
}
