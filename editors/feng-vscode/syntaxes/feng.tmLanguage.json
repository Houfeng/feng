{
  "name": "Feng",
  "scopeName": "source.feng",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#functionDefinitions"
    },
    {
      "include": "#typeDefinitions"
    },
    {
      "include": "#specDefinitions"
    },
    {
      "include": "#fitDefinitions"
    },
    {
      "include": "#enumDefinitions"
    },
    {
      "include": "#modulePaths"
    },
    {
      "include": "#aliases"
    },
    {
      "include": "#builtinTypes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#selfReference"
    },
    {
      "include": "#reservedWords"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#typeNames"
    },
    {
      "include": "#explicitGenericCall"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.feng",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.feng",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "match": "(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "keyword.other.documentation.tag.feng" },
                "2": { "name": "variable.other.documentation.parameter.feng" }
              }
            },
            {
              "name": "keyword.other.documentation.tag.feng",
              "match": "@[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        },
        {
          "name": "comment.block.feng",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.feng",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.feng",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.feng",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.feng",
              "match": "``"
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.annotation.feng",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "begin": "\\b(func)(\\s+)(~[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*)(<)",
          "end": ">",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.function.feng" },
            "3": { "name": "entity.name.function.feng" },
            "4": { "name": "punctuation.definition.typeparams.begin.feng" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparams.end.feng" }
          },
          "patterns": [
            { "include": "#genericTypeParams" }
          ]
        },
        {
          "match": "\\b(func)(\\s+)(~[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.feng" },
            "3": { "name": "entity.name.function.feng" }
          }
        }
      ]
    },
    "typeDefinitions": {
      "patterns": [
        {
          "begin": "\\b(type)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(<)",
          "end": ">",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.type.feng" },
            "3": { "name": "entity.name.type.feng" },
            "4": { "name": "punctuation.definition.typeparams.begin.feng" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparams.end.feng" }
          },
          "patterns": [
            { "include": "#genericTypeParams" }
          ]
        },
        {
          "match": "\\b(type)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.type.feng" },
            "3": { "name": "entity.name.type.feng" }
          }
        }
      ]
    },
    "specDefinitions": {
      "patterns": [
        {
          "begin": "\\b(spec)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(<)",
          "end": ">",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.spec.feng" },
            "3": { "name": "entity.name.type.feng" },
            "4": { "name": "punctuation.definition.typeparams.begin.feng" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparams.end.feng" }
          },
          "patterns": [
            { "include": "#genericTypeParams" }
          ]
        },
        {
          "match": "\\b(spec)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.spec.feng" },
            "3": {
              "name": "entity.name.type.feng"
            }
          }
        }
      ]
    },
    "fitDefinitions": {
      "patterns": [
        {
          "match": "\\b(fit)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.fit.feng"
            },
            "3": {
              "name": "entity.name.type.feng"
            }
          }
        }
      ]
    },
    "enumDefinitions": {
      "patterns": [
        {
          "match": "\\b(enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.enum.feng" },
            "3": { "name": "entity.name.type.enum.feng" }
          }
        }
      ]
    },
    "modulePaths": {
      "patterns": [
        {
          "match": "\\b(module|import)(\\s+)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.feng"
            },
            "3": {
              "name": "entity.name.namespace.feng"
            }
          }
        }
      ]
    },
    "aliases": {
      "patterns": [
        {
          "match": "\\b(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.feng"
            },
            "3": {
              "name": "entity.name.namespace.alias.feng"
            }
          }
        }
      ]
    },
    "builtinTypes": {
      "patterns": [
        {
          "name": "support.type.builtin.feng",
          "match": "\\b(?:bool|string|int|long|byte|float|double|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|void)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.feng",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.feng",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.feng",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.feng",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.feng",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "selfReference": {
      "patterns": [
        {
          "name": "variable.language.self.feng",
          "match": "\\bself\\b"
        }
      ]
    },
    "reservedWords": {
      "patterns": [
        {
          "name": "keyword.other.reserved.feng",
          "match": "\\b(?:class|struct|const|export|prop)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.feng",
          "match": "\\b(?:extern|let|var|open|seal|module|import|as|if|else|match|while|for|in|break|continue|defer|try|catch|finally|throw|return|static|unknown|enum)\\b"
        }
      ]
    },
    "typeNames": {
      "patterns": [
        {
          "name": "support.type.user.feng",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.feng",
          "match": "<<=|>>=|->|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|==|!=|<=|>=|=|\\+|-|\\*|/|%|&|\\||\\^|~|<|>|!"
        },
        {
          "name": "punctuation.separator.feng",
          "match": "[,:;.]"
        },
        {
          "name": "punctuation.section.block.begin.feng",
          "match": "[\\{\\(\\[]"
        },
        {
          "name": "punctuation.section.block.end.feng",
          "match": "[\\}\\)\\]]"
        }
      ]
    },
    "genericTypeParams": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.parameter.feng" },
            "2": { "name": "punctuation.separator.feng" },
            "3": { "name": "entity.name.type.feng" }
          }
        },
        {
          "name": "entity.name.type.parameter.feng",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.separator.feng",
          "match": ","
        }
      ]
    },
    "explicitGenericCall": {
      "patterns": [
        {
          "match": "(?<=[A-Za-z0-9_])<(?=[A-Za-z_])",
          "name": "punctuation.definition.generic.begin.feng"
        }
      ]
    }
  }
}