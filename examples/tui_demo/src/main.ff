module feng.examples;

import std;
import std.text;
import std.numeric;
import std.tui;
import std.tui.common;
import std.tui.input;
import std.tui.screen;
import std.tui.widgets;
import std.tui.view;

/**
 * 拖动示例的根容器：占满 Screen，并按子组件顺序自治布局和绘制。
 */
type DragSurface: ContainerWidget {
  ...: Container;

  /**
   * 先布局根容器，再布局所有直接子组件。
   */
  @mixable
  static func arrange(surface: ContainerWidget, manager: ViewManager): void {
    View.arrange(surface, manager);
    for let child in surface.children {
      child.arrange(manager);
    }
  }

  /**
   * 先绘制并跟踪根容器，再按顺序绘制所有直接子组件。
   */
  @mixable
  static func draw(surface: ContainerWidget, manager: ViewManager): void {
    View.draw(surface, manager);
    for let child in surface.children {
      child.draw(manager);
    }
  }
}

/**
 * TUI demo: 使用 ViewManager 绘制并拖动一个 20×20 的矩形。
 *
 * 运行方式：./build/bin/feng run ./examples/tui_demo
 * 退出方式：Ctrl+C 终止进程（atexit handler 会恢复终端模式）。
 */
func main(args: string[]) {
  // 构造 TuiApp（无外部 fd），init 进入 Raw Mode 并按终端尺寸初始化 Screen
  let app = TuiApp();
  app.init();
  defer { app.exit(); }
  app.input.onKey = (event: KeyEvent<Widget>) {
    // 按下 Ctrl+C 时退出应用
    if event.isControl() && event.content match let c: u32 && c == 0x03 {
      app.exit();
    }
  };

  // 根容器占满 Screen，负责自治布局和绘制子组件。
  let surface = DragSurface();
  app.view.root = surface;

  // 初始居中的 20×20 蓝色矩形。
  let rectangle = View();
  rectangle.style.width = (u32)20;
  rectangle.style.height = (u32)10;
  rectangle.style.horizontalAlign = Align.Center;
  rectangle.style.verticalAlign = Align.Center;
  rectangle.style.backColor = RgbColor(0, 0, 255);
  surface.addChild(rectangle);

  var dragging = false;
  var dragOffsetX: u32 = 0;
  var dragOffsetY: u32 = 0;

  // 只有经过 ViewManager 命中矩形的左键按下才开始拖动。
  rectangle.onMouseDown = (event: MouseEvent<Widget>) {
    if event.button == MouseButton.left && event.lock() {
      dragging = true;
      dragOffsetX = event.x - rectangle.frame.x;
      dragOffsetY = event.y - rectangle.frame.y;
    }
  };

  // lock 后即使鼠标移出矩形，move 事件仍直接路由到矩形。
  rectangle.onMouseMove = (event: MouseEvent<Widget>) {
    if event.action == MouseAction.move && dragging {
      var x: u32 = 0;
      var y: u32 = 0;
      if event.x > dragOffsetX {
        x = event.x - dragOffsetX;
      }
      if event.y > dragOffsetY {
        y = event.y - dragOffsetY;
      }

      let screenWidth = app.view.getScreenWidth();
      let screenHeight = app.view.getScreenHeight();
      let maxX: u32 = if screenWidth > rectangle.frame.width {
        screenWidth - rectangle.frame.width;
      } else { 0; };
      let maxY: u32 = if screenHeight > rectangle.frame.height {
        screenHeight - rectangle.frame.height;
      } else { 0; };
      if x > maxX { x = maxX; }
      if y > maxY { y = maxY; }

      rectangle.style.position = Position.Fixed;
      rectangle.style.x = x;
      rectangle.style.y = y;
    }
  };

  // release 仍路由到锁定的矩形，由锁定目标显式结束拖动并释放锁定。
  rectangle.onMouseUp = (event: MouseEvent<Widget>) {
    dragging = false;
    event.unlock();
  };

  app.run();
}
