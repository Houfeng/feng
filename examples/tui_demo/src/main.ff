module feng.examples;

import std;
import std.text;
import std.numeric;
import std.tui;
import std.tui.input;
import std.tui.screen;
import std.tui.widgets;
import std.tui.view;

/**
 * TUI demo: 通过 TuiApp 内部 Screen 绘制 "hello world"，并启动主循环。
 *
 * 运行方式：./build/bin/feng run ./examples/tui_demo
 * 退出方式：Ctrl+C 终止进程（atexit handler 会恢复终端模式）。
 */
func main(args: string[]) {
  // 构造 TuiApp（无外部 fd），init 进入 Raw Mode 并按终端尺寸初始化 Screen
  let app = TuiApp();
  app.init();
  defer { app.exit(); }
  app.input.onKey = (event: KeyEvent) {
    // 按下 Ctrl+C 时退出应用
    if event.isControl() && event.content match let c: u32 && c == 0x03 {
      app.exit();
    }
  };
  // app.input.onMouse = (event: MouseEvent) {
  //   // 鼠标点击时在终端打印坐标
  //   // if event.action == MouseAction.press {
  //   //   app.screen.buffer().draw(event.x, event.y, "Hello");
  //   // }
  //   app.screen.buffer().clear();
  //   app.screen.buffer().draw(event.x, event.y, "Hello", RgbColor(255, 0, 0));
  // };
  // // 在内部 Screen 的 back buffer 上绘制 "hello world"（带粗体样式）
  // app.screen.buffer().draw(10, 10, "hello world", Style.bold);
  let rootView = View();
  rootView.style.width = (f32)0.5;
  rootView.style.height = (f32)0.5;
  rootView.style.horizontalAlign = WidgetAlign.Center;
  rootView.style.verticalAlign = WidgetAlign.Center;
  rootView.style.backColor = RgbColor(0, 0, 255);
  app.view.root = rootView;
  app.run();
}
