module feng.examples;

import std;
import std.text;
import std.numeric;
import std.tui;
import std.tui.common;
import std.tui.input;
import std.tui.screen;
import std.tui.widgets;
import std.tui.view;

/**
 * 为矩形绑定独立的鼠标锁定和拖动状态。
 * 锁定后鼠标移出矩形仍继续拖动，并将最终位置限制在 Screen 内。
 */
func bindDrag(rectangle: View, app: TuiApp): void {
  var dragging = false;
  var dragOffsetX: int = 0;
  var dragOffsetY: int = 0;

  rectangle.mouseDown.on((event: MouseEvent<Widget>) {
    if event.button == MouseButton.Left && event.lock() {
      dragging = true;
      dragOffsetX = event.x - rectangle.frame.x;
      dragOffsetY = event.y - rectangle.frame.y;
    }
  });

  rectangle.mouseMove.on((event: MouseEvent<Widget>) {
    if event.action == MouseAction.Move && dragging {
      var x: int = 0;
      var y: int = 0;
      if event.x > dragOffsetX {
        x = event.x - dragOffsetX;
      }
      if event.y > dragOffsetY {
        y = event.y - dragOffsetY;
      }

      let screenWidth = app.view.getScreenWidth();
      let screenHeight = app.view.getScreenHeight();
      let maxX: int = if screenWidth > rectangle.frame.width {
        screenWidth - rectangle.frame.width;
      } else { 0; };
      let maxY: int = if screenHeight > rectangle.frame.height {
        screenHeight - rectangle.frame.height;
      } else { 0; };
      if x > maxX { x = maxX; }
      if y > maxY { y = maxY; }

      rectangle.style.position = Position.Fixed;
      rectangle.style.x = x;
      rectangle.style.y = y;
      rectangle.dirty.add(DirtyType.Layout);
      rectangle.requestReflow();
    }
  });

  rectangle.mouseUp.on((event: MouseEvent<Widget>) {
    dragging = false;
    event.unlock();
  });
}

/**
 * TUI demo: 使用 ViewManager 绘制 Text，并独立拖动蓝色和红色矩形。
 *
 * 运行方式：./build/bin/feng run ./examples/tui_demo
 * 退出方式：Ctrl+C 终止进程（atexit handler 会恢复终端模式）。
 */
func main(args: string[]) {
  // 构造 TuiApp（无外部 fd），init 进入 Raw Mode 并按终端尺寸初始化 Screen
  let app = TuiApp();
  app.init();
  defer { app.exit(); }
  app.key.on((event: KeyEvent<Widget>) {
    // 按下 Ctrl+C 时退出应用
    if event.isControl() && event.content match let c: u32 && c == 0x03 {
      app.exit();
    }
  });

  // 根容器占满 Screen，负责自治布局和绘制子组件。
  let surface = Container();
  app.view.root = surface;

  // VStack 作为全高左侧栏，并按加入顺序垂直排列两个直接 Text child。
  let stack = VStack();
  stack.style.width = 24;
  stack.style.horizontalAlign = Align.Start;
  let stackPadding: int = 1;
  stack.style.padding = Thickness(stackPadding);
  stack.style.backColor = RgbColor(40, 40, 40);
  surface.addChild(stack);

  let stackTitle = Text();
  stackTitle.content = "VStack";
  stackTitle.style.width = auto;
  stackTitle.style.height = auto;
  stackTitle.style.horizontalAlign = Align.Start;
  stackTitle.style.verticalAlign = Align.Start;
  stackTitle.style.foreColor = RgbColor(255, 220, 80);
  stack.addChild(stackTitle);

  let stackDescription = Text();
  stackDescription.content = "Direct children layout";
  stackDescription.style.width = auto;
  stackDescription.style.height = auto;
  stackDescription.style.horizontalAlign = Align.Start;
  stackDescription.style.verticalAlign = Align.Start;
  stackDescription.style.foreColor = RgbColor(180, 220, 255);
  stack.addChild(stackDescription);

  // 在 VStack 中嵌套一行 HStack，验证两个轴向容器的组合布局。
  let row = HStack();
  row.style.height = auto;
  stack.addChild(row);

  let rowTitle = Text();
  rowTitle.content = "HStack";
  rowTitle.style.width = auto;
  rowTitle.style.height = auto;
  rowTitle.style.verticalAlign = Align.Start;
  rowTitle.style.foreColor = RgbColor(255, 160, 100);
  row.addChild(rowTitle);

  let rowDescription = Text();
  rowDescription.content = " row";
  rowDescription.style.width = auto;
  rowDescription.style.height = auto;
  rowDescription.style.verticalAlign = Align.Start;
  rowDescription.style.foreColor = RgbColor(180, 220, 255);
  row.addChild(rowDescription);

  // 初始居中的蓝色矩形。
  let blueRectangle = View();
  blueRectangle.style.width = 20;
  blueRectangle.style.height = 10;
  blueRectangle.style.horizontalAlign = Align.Center;
  blueRectangle.style.verticalAlign = Align.Center;
  blueRectangle.style.backColor = RgbColor(0, 0, 255);
  blueRectangle.useStateStyle(Pseudo.Hover).backColor =
    RgbColor(0, 140, 255);
  blueRectangle.useStateStyle(Pseudo.Active).backColor =
    RgbColor(0, 80, 180);
  surface.addChild(blueRectangle);

  // 初始靠右居中的红色矩形；最后加入，作为覆盖 Text 的最上层组件。
  let redRectangle = View();
  redRectangle.style.width = 14;
  redRectangle.style.height = 6;
  redRectangle.style.horizontalAlign = Align.End;
  redRectangle.style.verticalAlign = Align.Center;
  redRectangle.style.backColor = RgbColor(255, 0, 0);
  redRectangle.useStateStyle(Pseudo.Hover).backColor =
    RgbColor(255, 120, 0);
  redRectangle.useStateStyle(Pseudo.Active).backColor =
    RgbColor(180, 0, 80);

  // Text 位于蓝色矩形之上、红色矩形之下。
  let text = Text();
  text.content = "Feng TUI Text 😀\n中文宽字符：拖动色块穿过文字\nGrapheme: é · auto wrap\nDrag the blue rectangle";
  text.textAlign = TextAlign.Center;
  text.style.width = 28;
  text.style.height = auto;
  text.style.horizontalAlign = Align.Center;
  text.style.verticalAlign = Align.Start;
  let textMarginTop: int = 2;
  let textMarginSide: int = 0;
  text.style.margin = Thickness(textMarginTop, textMarginSide,
    textMarginSide, textMarginSide);
  text.style.foreColor = RgbColor(0, 180, 120);
  surface.addChild(text);
  surface.addChild(redRectangle);

  bindDrag(blueRectangle, app);
  bindDrag(redRectangle, app);

  app.run();
}
