open module feng.examples.loop;

@cdecl("libc")
extern func puts(msg: string*): int;

/**
 * Loops through numbers and calculates their sum.
 * @param args The command-line arguments.
 */
open func loop_example(args: string[]) {
  puts(&"start..");
  var sum = 0;
  for var i = 0; i < 10000; i += 1 {
    sum = sum + i;
  }
  puts(&"end..");
}