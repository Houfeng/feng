module feng.examples.list;

import std.collections;

type ListExample<T> {
  let items: List<T>;
  func count(): i32 {
    return self.items.size();
  }
}

spec Handler(): void;

open func list_example(args: string[]) {
  let list = ListExample<Handler>();
  let handler: Handler = () {};
  list.items.add(handler);
}