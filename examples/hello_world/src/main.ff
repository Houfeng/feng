module hello_world;

import std.io;
import std.text;
import std.numeric;
import std.time;
import std.collections;
import std.json;
import std.test;

func main(args: string[]) {
  println("START");
  let obj = JsonObject();
  println("OBJ_CREATED");
  obj.set("a", (double)1);
  println("OBJ_SET");
  let jv = JsonValue(obj);
  println("JV_CREATED");
  println("JV: {0}", jv.toString());

  describe("JSON Tests", () {
      test("should create a JSON object", () {
          assert(true, "JSON object created successfully");
      });
      test("should create a JSON object", () {
          assert(false, "JSON object create");
      });
  });
}
