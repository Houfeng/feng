module hello_world;

import std.io;
import std;
import std.collections;


enum FutureState {
  Pending = 0,
  Resolved = 1,
  Rejected = 2
}

// @future
type Future<T> {

  // @future("state")
  seal let sm: int;

  seal var _state = FutureState.Pending;
  seal var _value: Option<T> = none;
  seal var _error: Option<string> = none;

  open func state(): FutureState { return self._state; }

  seal let waiters: List<int> = List<int>();

  seal func notifyWaiters() {
    for let waiter in self.waiters {
      // 通知所有等待者
      // feng_async_resume(waiter);
    }
  }

  seal func checkPending() {
    if self._state != FutureState.Pending {
      throw "Future already resolved or rejected";
    }
  }

  // @future("poll")
  seal func poll(waitPtr: int): Option<T> {
    return match self._state {
      FutureState.Resolved { self._value }
      FutureState.Rejected { throw "Future rejected" }
      FutureState.Pending { self.waiters.add(waitPtr); none }
      else { none }
    };
  }

  @friend(Promise<T>)
  seal func resolve(value: T) {
    self.checkPending();
    self._value = value;
    self._state = FutureState.Resolved;
    self.notifyWaiters();
  }

  @friend(Promise<T>)
  seal func reject(error: string) {
    self.checkPending();
    self._error = error;
    self._state = FutureState.Rejected;
    self.notifyWaiters();
  }

  func ~Future() {
    // 销毁状态机
    // feng_async_destroy(self.sm);
  }

}

type Promise<T> {
  open let future = Future<T>();
  open func resolve(value: T) {
    self.future.resolve(value);
  }
  open func reject(error: string) {
    self.future.reject(error);
  }
}