module feng.smoke.phase1a.generic_aggregate_return;

@cdecl("libc")
extern func puts(value: string*): i32;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func makeNamed<T>(name: string): Named {
    let user: User = User{name: name};
    return user;
}

func forwardNamed<T>(named: Named): Named {
    return named;
}

func reboundNamed<T>(name: string): Named {
    return makeNamed<T>(name);
}

func main(args: string[]) {
    let created: Named = makeNamed<i32>("generic aggregate return ok");
    puts(&created.greet());

    let forwarded: Named = forwardNamed<i32>(created);
    puts(&forwarded.greet());

    let rebound: Named = reboundNamed<i32>("generic aggregate return ok");
    puts(&rebound.greet());
}