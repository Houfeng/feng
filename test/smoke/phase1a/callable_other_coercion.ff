module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec MapperA(x: i32): i32;
spec MapperB(x: i32): i32;

func add1(x: i32): i32 {
    return x + 1;
}

func use_mapper(input: MapperA): i32 {
    let local: MapperA = input;
    let remapped: MapperB = (MapperB)local;
    return remapped(41);
}

func main(args: string[]) {
    let mapper: MapperA = add1;
    if use_mapper(mapper) == 42 {
        puts(&"other-coercion-ok");
    } else {
        puts(&"other-coercion-fail");
    }
}
