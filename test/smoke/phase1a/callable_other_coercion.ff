module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec MapperA(x: int): int;
spec MapperB(x: int): int;

func add1(x: int): int {
    return x + 1;
}

func use_mapper(input: MapperA): int {
    let local: MapperA = input;
    let remapped: MapperB = (MapperB)local;
    return remapped(41);
}

func main(args: string[]) {
    let mapper: MapperA = add1;
    if use_mapper(mapper) == 42 {
        puts(&"other-coercion-ok");
    } else {
        puts(&"other-coercion-fail");
    }
}
