module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func fail(): string {
    throw "boom";
    return "unreachable";
}

func catch_returns(): string {
    try fail() catch ex: string {
        return "catch-return";
    }
    return "normal";
}

func normal_value(): string {
    let value = try "normal" catch ex: string {
        "caught";
    };
    return value;
}

func main(args: string[]) {
    let first = catch_returns();
    puts(&first);

    let second = normal_value();
    puts(&second);
}
