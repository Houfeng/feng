mod feng.smoke;

@cdecl("libc")
extern fn puts(msg: string): int;

spec Mapper(x: int): int;
spec Reader(): int;

type Box {
    var n: int;

    fn makeReader(): Reader {
        return () -> self.n;
    }
}

fn main(args: string[]) {
    var base: int = 1;
    let mapper: Mapper = (x: int) -> x + base;
    base = 2;
    if mapper(40) == 42 {
        puts("local-ok");
    } else {
        puts("local-fail");
    }

    let box = Box{n: 7};
    let reader: Reader = box.makeReader();
    box.n = 8;
    if reader() == 8 {
        puts("self-ok");
    } else {
        puts("self-fail");
    }
}