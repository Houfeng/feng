module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Mapper(x: i32): i32;
spec Reader(): i32;

type Box {
    var n: i32;

    func makeReader(): Reader {
        return () -> self.n;
    }
}

func main(args: string[]) {
    var base: i32 = 1;
    let mapper: Mapper = (x: i32) -> x + base;
    base = 2;
    if mapper(40) == 42 {
        puts(&"local-ok");
    } else {
        puts(&"local-fail");
    }

    let box = Box{n: 7};
    let reader: Reader = box.makeReader();
    box.n = 8;
    if reader() == 8 {
        puts(&"self-ok");
    } else {
        puts(&"self-fail");
    }
}