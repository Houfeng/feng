module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

func throw_text(): string {
    throw "primary";
    return "unreachable";
}

func throw_i32(): i32 {
    let value: i32 = 7;
    throw value;
    return 0;
}

func throw_i32_text(): string {
    let value: i32 = 7;
    throw value;
    return "unreachable";
}

func throw_bool(): bool {
    throw true;
    return false;
}

func throw_bool_text(): string {
    throw true;
    return "unreachable";
}

func add_i32(left: i32, right: i32): i32 {
    return left + right;
}

func catch_string(): string {
    let value = try throw_text() catch ex: string {
        ex;
    };
    return value;
}

func catch_scalar(): string {
    let value = try throw_i32() catch ex: i32 {
        add_i32(ex, 35);
    };
    if value == 42 {
        return "scalar-42";
    }
    return "scalar-miss";
}

func catch_order(): string {
    let value = try throw_i32_text() catch ex: bool {
        "wrong-bool";
    } catch ex: i32 {
        "right-i32";
    };
    return value;
}

func unknown_rethrow(): string {
    let value = try (try throw_text() catch ex: unknown {
        throw ex;
    }) catch ex: string {
        "unknown-rethrown";
    };
    return value;
}

func auto_upthrow(): string {
    let value = try throw_bool_text() catch ex: bool {
        "auto-upthrow";
    };
    return value;
}

func main(args: string[]) {
    puts(&catch_string());
    puts(&catch_scalar());
    puts(&catch_order());
    puts(&unknown_rethrow());
    puts(&auto_upthrow());
}