module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

func label(n: i32): string {
    return "int";
}

func label(s: string): string {
    return "string";
}

func label(): string {
    return "none";
}

func main(args: string[]) {
    puts(&label(42));
    puts(&label("hi"));
    puts(&label());
}
