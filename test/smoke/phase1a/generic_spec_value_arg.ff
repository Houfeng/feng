module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func identity<T>(value: T): T {
    return value;
}

type Holder<T> {
    var value: T;

    func put(value: T) {
        self.value = value;
    }

    func readValue(): T {
        return self.value;
    }

    func echo<U>(value: U): U {
        return value;
    }

    func echoThroughMethod(value: T): T {
        return self.echo(value);
    }
}

func main(args: string[]) {
    let named: Named = User{name: "spec generic value ok"};

    let fromFn: Named = identity(named);
    puts(&fromFn.greet());

    let holder: Holder<Named> = Holder<Named>();
    holder.put(named);
    let fromTypeArg: Named = holder.readValue();
    puts(&fromTypeArg.greet());

    let fromMethod: Named = holder.echo(named);
    puts(&fromMethod.greet());

    let fromSelfCall: Named = holder.echoThroughMethod(named);
    puts(&fromSelfCall.greet());
}
