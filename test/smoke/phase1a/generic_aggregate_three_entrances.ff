module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func idNamed<T: Named>(value: T): T {
    return value;
}

type Holder<T: Named> {
    var value: T;

    func set(next: T) {
        self.value = next;
    }

    func read(): string {
        return self.value.greet();
    }

    func relay<U: Named>(item: U): string {
        return item.greet();
    }
}

func main(args: string[]) {
    let named: Named = User{name: "phase-e-ok"};

    let fromFn: Named = idNamed<Named>(named);

    let holder: Holder<Named> = Holder<Named>();
    holder.set(fromFn);

    let fromMethod: string = holder.relay<Named>(fromFn);
    puts(&fromMethod);
    puts(&holder.read());
}
