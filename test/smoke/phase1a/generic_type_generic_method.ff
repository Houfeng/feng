module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type Box<T> {
    var value: T;

    func echo<U>(value: U): U {
        return value;
    }

    func replace<U>(next: T, result: U): U {
        self.value = next;
        return result;
    }

    func current(): T {
        return self.value;
    }

    func currentAgain(): T {
        return self.current();
    }

    func echoInt(value: i32): i32 {
        return self.echo(value);
    }
}

func main(args: string[]) {
    let box = Box<i32>();
    let first: i32 = box.echo(20);
    let second: i32 = box.replace<i32>(22, first);
    if box.currentAgain() + second + box.echoInt(1) == 43 {
        puts(&"ok");
    } else {
        puts(&"fail");
    }
}
