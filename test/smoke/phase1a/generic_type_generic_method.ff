mod feng.smoke;

@cdecl("libc")
extern fn puts(msg: string*): int;

type Box<T> {
    var value: T;

    fn echo<U>(value: U): U {
        return value;
    }

    fn replace<U>(next: T, result: U): U {
        self.value = next;
        return result;
    }

    fn current(): T {
        return self.value;
    }

    fn currentAgain(): T {
        return self.current();
    }

    fn echoInt(value: int): int {
        return self.echo(value);
    }
}

fn main(args: string[]) {
    let box = Box<int>();
    let first: int = box.echo(20);
    let second: int = box.replace<int>(22, first);
    if box.currentAgain() + second + box.echoInt(1) == 43 {
        puts(&"ok");
    } else {
        puts(&"fail");
    }
}
