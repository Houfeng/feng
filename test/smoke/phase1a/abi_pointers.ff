module feng.smoke.abi_pointers;

@cdecl("libc")
extern func puts(msg: string*): int;

@cdecl("libc")
extern func write(fd: int, buf: byte*, count: i64): i64;

@abi
spec Cmp(a: int, b: int): int;

@abi
type Holder {
    var cb: Cmp*;
    var tag: int;
}

@abi
func cmp(a: int, b: int): int {
    return a - b;
}

func main(args: string[]) {
    let text: string = "phase6 abi ok";
    let values: byte[] = [111, 107, 10];
    let holder: Holder = Holder{cb: &cmp, tag: 7};
    let expected: i64 = 3;
    let written: i64 = write(1, &values, expected);

    if holder.tag == 7 && written == expected {
        puts(&text);
    } else {
        puts(&"phase6 abi bad");
    }
}