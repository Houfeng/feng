module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type IterResult(bool, i32);

type RangeCursor {
    var current: i32;
    let end: i32;

    @iterator
    func next(): IterResult {
        if self.current >= self.end {
            return (false, 0);
        }
        let value = self.current;
        self.current = self.current + 1;
        return (true, value);
    }
}

type Range {
    let start: i32;
    let end: i32;

    @iterable
    func iter(): RangeCursor {
        return RangeCursor { current: self.start, end: self.end };
    }
}

func main(args: string[]) {
    let nums: i32[] = [10, 20];
    for let n in nums {
        if n == 10 {
            puts(&"array-ten");
        } else {
            puts(&"array-twenty");
        }
    }

    let r = Range { start: 0, end: 2 };
    for let i in r {
        if i == 0 {
            puts(&"iter-zero");
        } else {
            puts(&"iter-one");
        }
    }
    puts(&"done");
}
