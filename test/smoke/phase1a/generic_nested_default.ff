module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type Box<T> {
    var value: T;
}

type Holder<T> {
    var inner: Box<T>;
}

func main(args: string[]) {
    let holder: Holder<i32> = Holder<i32>();
    holder.inner.value = 11;
    if holder.inner.value == 11 {
        puts(&"generic nested default ok");
    }
}
