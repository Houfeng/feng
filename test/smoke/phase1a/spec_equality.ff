module feng.smoke;

@cdecl("libc") extern func puts(msg: string*): i32;

spec Named {
    func greet(): string;
}

type User: Named {
    var name: string;
    func greet(): string {
        return self.name;
    }
}

func main(args: string[]) {
    let a = User { name: "alice" };
    let b = User { name: "bob" };
    let na: Named = a;
    let na2: Named = a;
    let nb: Named = b;
    if (na == na2) { puts(&"eq:same"); } else { puts(&"ne:same"); }
    if (na == nb) { puts(&"eq:diff"); } else { puts(&"ne:diff"); }
    if (na != nb) { puts(&"ne!:diff"); } else { puts(&"eq!:diff"); }
    if (na != na2) { puts(&"ne!:same"); } else { puts(&"eq!:same"); }
}
