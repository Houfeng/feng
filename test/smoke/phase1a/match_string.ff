module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func translate(word: string): string {
    let r = match word {
        "hi", "hello" { "greeting"; }
        "bye", "goodbye" { "farewell"; }
        else { "unknown"; }
    };
    return r;
}

func main(args: string[]) {
    puts(&translate("hi"));
    puts(&translate("hello"));
    puts(&translate("bye"));
    puts(&translate("goodbye"));
    puts(&translate("foo"));
}
