module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Named {
    var name: string;
    func greet(): string;
}

type User: Named {
    var name: string;

    func greet(): string {
        return self.name;
    }
}

func rename<T: Named>(user: T, next: string): string {
    user.name = next;
    return user.name;
}

func greetGeneric<T: Named>(user: T): string {
    return user.greet();
}

func main(args: string[]) {
    let user: User = User{name: "before"};
    puts(&rename(user, "generic constraint field ok"));
    puts(&greetGeneric(user));
}