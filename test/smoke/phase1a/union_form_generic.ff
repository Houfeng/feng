module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type Error {
    let code: i32;
}

spec Result<T>: Error | T;

func print_result(value: Result<i32>) {
    match value {
        i32 { puts(&"int"); }
        Error { puts(&"error"); }
    }
}

func main(args: string[]) {
    let ok: Result<i32> = 1;
    let err: Result<i32> = Error { code: 7 };
    print_result(ok);
    print_result(err);
}
