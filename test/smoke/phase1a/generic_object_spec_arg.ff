module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

/* object-form spec used as a generic type argument. Exercises the
 * codegen path where an object-form spec flows through substitution
 * into a container's method parameter T — recorded as an object-spec
 * coercion site whose target_spec_type_ref was previously a borrowed
 * synthetic type ref freed before codegen. Mirrors the callable-spec
 * counterpart (generic_callable_spec_arg) for the object-form path.
 *
 * Two binding shapes are covered:
 *   - let u: Named = User{...}; holder.put(u)
 *       src type == target slot type (Named), no coercion site recorded
 *       (no (Named, Named) SpecRelation); verifies the trivial-identity
 *       path still compiles and runs without regressions.
 *   - let v = User{...}; holder.put(v)
 *       src type User, target slot Named; triggers the substitute-path
 *       object-spec coercion site with a synthetic target_spec_type_ref
 *       — the path Bug 2's deep-clone fix protects. */
spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

type Holder<T> {
  var slot: T;

  func put(value: T) {
    self.slot = value;
  }

  func take(): T {
    return self.slot;
  }
}

func main(args: string[]) {
  let holder = Holder<Named>();
  let u: Named = User{name: "object-spec generic arg ok"};
  holder.put(u);
  let recovered: Named = holder.take();
  puts(&recovered.greet());

  let v = User{name: "object-spec generic arg ok"};
  holder.put(v);
  let recovered2: Named = holder.take();
  puts(&recovered2.greet());
}
