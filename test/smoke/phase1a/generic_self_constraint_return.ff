module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Cloneable<T> {
    func cloneValue(): T;
}

type Key: Cloneable<Key> {
    var id: i32;

    func cloneValue(): Key {
        return Key{id: self.id};
    }
}

type Copier<K: Cloneable<K>> {
    func copy(key: K): K {
        return key.cloneValue();
    }
}

func main(args: string[]) {
    let key: Key = Key{id: 7};
    let copier: Copier<Key> = Copier<Key>();
    let copied: Key = copier.copy(key);
    if copied.id == 7 {
        puts(&"self constraint return ok");
    }
}
