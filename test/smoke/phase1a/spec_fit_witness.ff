module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Named {
    func greet(): string;
}

type User {
    let name: string;
}

fit User: Named {
    func greet(): string {
        return "fit:" + self.name;
    }
}

func announce(n: Named) {
    puts(&n.greet());
}

func main(args: string[]) {
    let u = User { name: "feng" };
    announce(u);
    let n: Named = User { name: "alice" };
    puts(&n.greet());
}
