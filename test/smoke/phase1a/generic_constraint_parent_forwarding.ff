module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Named {
    func name(): string;
}

spec Labelled: Named {
}

type Item: Labelled {
    func name(): string {
        return "item";
    }
}

func useNamed<T: Named>(value: T): string {
    return value.name();
}

func useLabelled<U: Labelled>(value: U): string {
    return useNamed<U>(value);
}

func main(args: string[]) {
    let item: Item = Item{};
    puts(&useLabelled<Item>(item));
}