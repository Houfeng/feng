module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type Box<T> {
    var value: T;

    func setValue(next: T) {
        self.value = next;
    }

    func readValue(): T {
        return self.value;
    }
}

func main(args: string[]) {
    let numberBox: Box<i32> = Box<i32>();
    numberBox.setValue(7);
    if numberBox.readValue() == 7 {
        puts(&"generic method int ok");
    }

    let textBox: Box<string> = Box<string>();
    textBox.setValue("generic method string ok");
    puts(&textBox.readValue());
}
