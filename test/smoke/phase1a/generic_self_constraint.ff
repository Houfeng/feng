module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Eq<T> {
    func same(other: T): bool;
}

type Key: Eq<Key> {
    var id: i32;

    func same(other: Key): bool {
        return self.id == other.id;
    }
}

type MiniMap<K: Eq<K>, V> {
    var key: K;
    var value: V;

    func put(key: K, value: V) {
        self.key = key;
        self.value = value;
    }

    func hasKey(key: K): bool {
        return key.same(self.key);
    }

    func getValue(key: K): V {
        if self.hasKey(key) {
            return self.value;
        }
        return self.value;
    }
}

func main(args: string[]) {
    let key: Key = Key{id: 7};
    let map: MiniMap<Key, string> = MiniMap<Key, string>();
    map.put(key, "self constraint ok");
    if map.hasKey(key) {
        puts(&map.getValue(key));
    }
}
