module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func main(args: string[]) {
    let u = User { name: "feng" };
    let n: Named = u;
    puts(&n.greet());
}
