module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func pick(tag: i32, left: Named, right: Named): Named {
    return match tag {
        0 {
            left;
        }
        else {
            right;
        }
    };
}

func main(args: string[]) {
    let left: Named = User{name: "match-left"};
    let right: Named = User{name: "match-right"};
    puts(&pick(0, left, right).greet());
    puts(&pick(1, left, right).greet());
}