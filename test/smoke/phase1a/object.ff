module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

type User {
    let name: string;
    let age: i32;

    func greet(prefix: string): string {
        return prefix + self.name;
    }
}

func main(args: string[]) {
    let u = User { name: "feng", age: 18 };
    let m = u.greet("hello, ");
    puts(&m);
    puts(&u.name);
}
