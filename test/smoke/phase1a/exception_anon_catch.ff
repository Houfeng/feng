module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

func throw_i32(): i32 {
    let v: i32 = 42;
    throw v;
    return 0;
}

func throw_string(): string {
    throw "oops";
    return "";
}

func anon_catch_expr(): string {
    return try throw_string() catch {
        "anon-expr-caught";
    };
}

func main(args: string[]) {
    // anonymous catch as statement: catches any exception
    try throw_i32() catch {
        puts(&"anon-stmt-any");
    };

    // anonymous catch after specific catch: specific should fire when type matches
    try throw_i32() catch ex: i32 {
        puts(&"specific-i32");
    } catch {
        puts(&"anon-fallback");
    };

    // anonymous catch fires when specific clause does not match
    try throw_string() catch ex: i32 {
        puts(&"specific-i32");
    } catch {
        puts(&"anon-fallback");
    };

    // anonymous catch as expression: produce a value
    let v = anon_catch_expr();
    puts(&v);

    puts(&"done");
}
