module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

// A function that allocates a managed local (writable array) and then throws.
// The cleanup chain must release `tmp` before exception unwinding reaches catch.
func build_and_throw(): string {
    let tmp: i32[!] = [1, 2, 3];
    throw "boom-from-func";
    return "unreachable";
}

// A function that allocates a managed local and returns normally.
func build_and_return() {
    let tmp: i32[!] = [9, 8, 7];
    puts(&"normal-return");
}

func main(args: string[]) {
    // Caller also has a managed local; it must survive the throw and be
    // released by its own scope on normal exit.
    let outer: i32[!] = [10, 20, 30];

    let label = try build_and_throw() catch ex: string {
        "caught";
    };
    puts(&label);

    build_and_return();
    puts(&"after");
}
