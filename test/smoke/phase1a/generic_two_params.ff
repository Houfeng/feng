mod feng.smoke;

@cdecl("libc")
extern fn puts(msg: string): int;

/* Generic void function with two type params. */
fn swap_discard<T, U>(a: T, b: U) {}

fn main(args: string[]) {
    swap_discard(1, "hello");
    swap_discard("world", 42);
    swap_discard(true, 99);
    puts("generic two params ok");
}
