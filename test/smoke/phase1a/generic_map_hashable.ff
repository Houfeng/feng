module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Hashable {
    func hash(): i32;
    func sameHash(hash: i32): bool;
}

type Key: Hashable {
    var id: i32;

    func hash(): i32 {
        return self.id + 1;
    }

    func sameHash(hash: i32): bool {
        return self.hash() == hash;
    }
}

type MiniMap<K: Hashable, V> {
    var key: K;
    var value: V;

    func put(key: K, value: V) {
        self.key = key;
        self.value = value;
    }

    func hasKey(key: K): bool {
        return key.sameHash(self.key.hash());
    }

    func getValue(key: K): V {
        if self.hasKey(key) {
            return self.value;
        }
        return self.value;
    }
}

func main(args: string[]) {
    let key: Key = Key{id: 41};
    let map: MiniMap<Key, string> = MiniMap<Key, string>();
    map.put(key, "answer");
    puts(&map.getValue(key));
    if map.hasKey(key) {
        puts(&"ok");
    } else {
        puts(&"fail");
    }
}
