module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func add(a: i32, b: i32): i32 {
    return a + b;
}

func main(args: string[]) {
    let x: i32 = 40;
    let y: i32 = 2;
    let z = add(x, y);
    if z == 42 {
        puts(&"ok");
    } else {
        puts(&"fail");
    }
}
