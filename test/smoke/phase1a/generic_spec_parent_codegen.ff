module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Sequence<T> {
    func size(): int;
}

spec IntSequence: Sequence<int> {
}

type Counter: IntSequence {
    var n: int;

    func size(): int {
        return self.n;
    }
}

func check(seq: IntSequence): int {
    return seq.size();
}

func main(args: string[]) {
    let counter: Counter = Counter{n: 7};
    if check(counter) == 7 {
        puts(&"generic spec parent inherited member ok");
    }
}
