mod feng.smoke;

@cdecl("libc")
extern fn puts(msg: string): int;

spec Sequence<T> {
    fn size(): int;
}

spec IntSequence: Sequence<int> {
}

type Counter: IntSequence {
    var n: int;

    fn size(): int {
        return self.n;
    }
}

fn check(seq: IntSequence): int {
    return seq.size();
}

fn main(args: string[]) {
    let counter: Counter = Counter{n: 7};
    if check(counter) == 7 {
        puts("generic spec parent inherited member ok");
    }
}
