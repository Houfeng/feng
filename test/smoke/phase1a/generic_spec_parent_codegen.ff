module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Sequence<T> {
    func size(): i32;
}

spec IntSequence: Sequence<i32> {
}

type Counter: IntSequence {
    var n: i32;

    func size(): i32 {
        return self.n;
    }
}

func check(seq: IntSequence): i32 {
    return seq.size();
}

func main(args: string[]) {
    let counter: Counter = Counter{n: 7};
    if check(counter) == 7 {
        puts(&"generic spec parent inherited member ok");
    }
}
