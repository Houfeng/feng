module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Sequence<T> {
    func first(): T;
}

spec Collection<T>: Sequence<T> {
}

type IntBag: Collection<int> {
    func first(): int {
        return 7;
    }
}

func head(seq: Sequence<int>): int {
    return seq.first();
}

func main(args: string[]) {
    let bag: IntBag = IntBag{};
    if head(bag) == 7 {
        puts(&"generic spec open parent ok");
    }
}