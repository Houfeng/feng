module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Sequence<T> {
    func first(): T;
}

spec Collection<T>: Sequence<T> {
}

type IntBag: Collection<i32> {
    func first(): i32 {
        return 7;
    }
}

func head(seq: Sequence<i32>): i32 {
    return seq.first();
}

func main(args: string[]) {
    let bag: IntBag = IntBag{};
    if head(bag) == 7 {
        puts(&"generic spec open parent ok");
    }
}