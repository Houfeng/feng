module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func classify(age: i32): string {
    let label = if age {
        0 { "infant"; }
        1...17 { "minor"; }
        18...59 { "adult"; }
        else { "senior"; }
    };
    return label;
}

func main(args: string[]) {
    puts(&classify(0));
    puts(&classify(10));
    puts(&classify(30));
    puts(&classify(80));
}
