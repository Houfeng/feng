module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

// Exercises codegen for user-defined finalizers (`func ~T()`):
// the runtime invokes the finalizer through descriptor.finalizer when
// ARC reclaims the instance at end of scope.
type Greeter {
    let label: string;

    func ~Greeter() {
        puts(&self.label);
    }
}

func main(args: string[]) {
    let g = Greeter { label: "fin" };
    puts(&"built");
}
