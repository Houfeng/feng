module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Named {
    func greet(): string;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

func announce(n: Named) {
    puts(&n.greet());
}

func main(args: string[]) {
    let u = User { name: "feng" };
    announce(u);
}
