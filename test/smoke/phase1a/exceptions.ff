module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func maybe_throw(should_throw: bool) {
    if should_throw {
        throw "boom";
    }
}

func maybe_label(should_throw: bool): string {
    if should_throw {
        throw "boom";
    }
    return "ok";
}

func main(args: string[]) {
    let first = try maybe_label(true) catch ex: string {
        "caught-1";
    };
    puts(&first);

    let second = try maybe_label(false) catch ex: string {
        "unreachable-2";
    };
    puts(&second);

    try maybe_throw(false) catch {}
    puts(&"ok-3");

    puts(&"done");
}
