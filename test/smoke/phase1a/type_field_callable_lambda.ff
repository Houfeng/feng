module feng.smoke.type_field_callable_lambda;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Reader(): int;

type Box {
    var n: int;
    let read: Reader = () -> self.n;
}

func main(args: string[]) {
    let box = Box{n: 7};
    if box.read() == 7 {
        puts(&"member-lambda-ok");
    } else {
        puts(&"member-lambda-fail");
    }
}