module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Named {
    func greet(): string;
}

spec HasChild {
    var child: Named;
}

type User: Named {
    let name: string;

    func greet(): string {
        return self.name;
    }
}

type Holder: HasChild {
    var child: Named;
}

func rewrite<T: HasChild>(box: T, next: Named): string {
    box.child = next;
    return box.child.greet();
}

func main(args: string[]) {
    let holder: Holder = Holder{child: User{name: "before"}};
    let box: HasChild = holder;
    puts(&box.child.greet());
    puts(&rewrite<HasChild>(box, User{name: "after"}));
    puts(&box.child.greet());
}