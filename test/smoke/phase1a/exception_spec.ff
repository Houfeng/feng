module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Describable {
    func describe(): string;
}

type AppError: Describable {
    let msg: string;

    func describe(): string {
        return self.msg;
    }
}

func make_error(msg: string): Describable {
    let e = AppError { msg: msg };
    return e;
}

// throw a spec fat value — subject extracted at throw site,
// concrete descriptor (AppError) read from FengManagedHeader
func fail(msg: string): string {
    throw make_error(msg);
    return "unreachable";
}

func main(args: string[]) {
    // catch as concrete AppError — personality matches on descriptor identity
    let r = try fail("spec-error") catch ex: AppError {
        ex.msg;
    } catch ex: unknown {
        "unknown";
    };
    puts(&r);

    puts(&"done");
}
