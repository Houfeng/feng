module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

fit int {
  func double(): int {
    return self * 2;
  }
}

fit int[] {
  func head(): int {
    return self[0];
  }
}

func main(args: string[]) {
  if 21.double() != 42 {
    puts(&"fit builtin fail");
    return;
  }

  let xs: int[] = [7, 9];
  if xs.head() != 7 {
    puts(&"fit array fail");
    return;
  }

  puts(&"fit builtin ok");
}
