module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

fit i32 {
  func double(): i32 {
    return self * 2;
  }
}

fit i32[] {
  func head(): i32 {
    return self[0];
  }
}

func main(args: string[]) {
  if 21.double() != 42 {
    puts(&"fit builtin fail");
    return;
  }

  let xs: i32[] = [7, 9];
  if xs.head() != 7 {
    puts(&"fit array fail");
    return;
  }

  puts(&"fit builtin ok");
}
