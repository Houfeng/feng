module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Summable {
    func sum(): i32;
}

type Point(i32, i32);

fit Point: Summable {
    func sum(): i32 {
        return self.item1 + self.item2;
    }
}

func consume(value: Summable): i32 {
    return value.sum();
}

spec Show {
    func show(): string;
}

type Label(string, string);

fit Label: Show {
    func show(): string {
        return self.item1 + ":" + self.item2;
    }
}

func announce(value: Show) {
    puts(&value.show());
}

func main(args: string[]) {
    let point: Point = (5, 6);
    let as_spec: Summable = point;
    var replacement: Point = (1, 2);
    replacement = (3, 4);
    let (x, , z) = (7, 8, 9);

    if point.sum() + consume(point) + as_spec.sum() + replacement.item1 + replacement.item2 + x + z == 56 {
        puts(&"tuple-int-ok");
    } else {
        puts(&"tuple-int-fail");
    }

    let label: Label = ("left", "right");
    announce(label);
    let shown: Show = label;
    puts(&shown.show());
}