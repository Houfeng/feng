module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

@runtime
extern func feng_expression_equal<T>(left: T, right: T): bool;

spec Summable {
    func sum(): i32;
}

type Point(i32, i32);
type FloatPair(f64, i32);

type Unit();

fit Point: Summable {
    func sum(): i32 {
        return self.item1 + self.item2;
    }
}

func consume(value: Summable): i32 {
    return value.sum();
}

func makeUnit(): Unit {
    return ();
}

func unitScore(value: Unit): i32 {
    let () = value;
    return 1;
}

func same<T>(left: T, right: T): bool {
    return feng_expression_equal(left, right);
}

spec Show {
    func show(): string;
}

type Label(string, string);

fit Label: Show {
    func show(): string {
        return self.item1 + ":" + self.item2;
    }
}

func announce(value: Show) {
    puts(&value.show());
}

func main(args: string[]) {
    let unit: Unit = ();
    let () = unit;
    let () = ();
    let point: Point = (5, 6);
    let as_spec: Summable = point;
    var replacement: Point = (1, 2);
    replacement = (3, 4);
    let (x, , z) = (7, 8, 9);

    if unitScore(unit) + unitScore(()) + unitScore(makeUnit()) + point.sum() + consume(point) + as_spec.sum() + replacement.item1 + replacement.item2 + x + z == 59 {
        puts(&"tuple-int-ok");
    } else {
        puts(&"tuple-int-fail");
    }

    let label: Label = ("left", "right");
    announce(label);
    let shown: Show = label;
    puts(&shown.show());

    let same_label: Label = ("left", "right");
    let other_label: Label = ("left", "other");
    if same(label, same_label) {
        puts(&"tuple-string-eq-ok");
    } else {
        puts(&"tuple-string-eq-fail");
    }
    if same(label, other_label) {
        puts(&"tuple-string-neq-fail");
    } else {
        puts(&"tuple-string-neq-ok");
    }

    let positive_zero: FloatPair = (0.0, 1);
    let negative_zero: FloatPair = (-0.0, 1);
    if same(positive_zero, negative_zero) {
        puts(&"tuple-f64-zero-eq-ok");
    } else {
        puts(&"tuple-f64-zero-eq-fail");
    }
}