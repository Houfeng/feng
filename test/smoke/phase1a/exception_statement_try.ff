module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

func make_label(): string {
    return "bound-try";
}

func fail_i32(): i32 {
    let payload: i32 = 7;
    throw payload;
    return 0;
}

func main(args: string[]) {
    let label = try make_label() catch { "unknown"; };
    puts(&label);

    try fail_i32() catch ex: i32 {
    }
    puts(&"statement-catch");
}
