module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Sequence<T> {
    func size(): i32;
}

spec IntSequence: Sequence<i32> {
    func size(): i32;
}

type Counter: IntSequence {
    func size(): i32 {
        return 1;
    }
}

func main(args: string[]) {
    let counter: IntSequence = Counter{};
    if counter.size() == 1 {
        puts(&"generic spec parent override ok");
    }
}
