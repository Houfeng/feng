module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Sequence<T> {
    func size(): int;
}

spec IntSequence: Sequence<int> {
    func size(): int;
}

type Counter: IntSequence {
    func size(): int {
        return 1;
    }
}

func main(args: string[]) {
    let counter: IntSequence = Counter{};
    if counter.size() == 1 {
        puts(&"generic spec parent override ok");
    }
}
