module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type User {
    let name: string;

    func label(n: i32): string {
        return "int";
    }

    func label(s: string): string {
        return s;
    }

    func label(): string {
        return self.name;
    }
}

func main(args: string[]) {
    let u = User { name: "feng" };
    puts(&u.label(7));
    puts(&u.label("hello"));
    puts(&u.label());
}
