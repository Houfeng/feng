module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

spec Reader<T> {
    func read(): T;
}

type Box<T> {
    var value: T;
}

fit Box<T>: Reader<T> {
    func read(): T {
        return self.value;
    }
}

func readInt(reader: Reader<i32>): i32 {
    return reader.read();
}

func main(args: string[]) {
    let box: Box<i32> = Box<i32>();
    box.value = 42;
    if readInt(box) == 42 {
        puts(&"generic fit ok");
    }
}