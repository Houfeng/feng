module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): int;

spec Eq<T> {
    func same(other: T): bool;
}

type Key: Eq<Key> {
    var id: int;

    func same(other: Key): bool {
        return self.id == other.id;
    }
}

func sameAs<U: Eq<U>>(left: U, right: U): bool {
    return left.same(right);
}

func main(args: string[]) {
    let a: Key = Key{id: 7};
    let b: Key = Key{id: 7};
    if sameAs(a, b) {
        puts(&"function self constraint ok");
    }
}
