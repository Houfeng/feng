module feng.smoke;

@cdecl("libc") extern func puts(msg: string*): int;

spec Named {
    var name: string;
    func greet(): string;
}

type User: Named {
    var name: string;
    func greet(): string {
        return self.name;
    }
}

func main(args: string[]) {
    let u = User { name: "feng" };
    let n: Named = u;
    puts(&n.name);
    n.name = "tom";
    puts(&n.name);
    puts(&n.greet());
    puts(&u.name);
}
