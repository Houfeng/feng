module feng.smoke;

@cdecl("libc")
extern func puts(msg: string*): i32;

type IterResult(bool, i32);

type RangeCursor {
    var current: i32;
    let end: i32;

    @iterator
    func next(): IterResult {
        if self.current >= self.end {
            return (false, 0);
        }
        let value = self.current;
        self.current = self.current + 1;
        return (true, value);
    }
}

type Range {
    let start: i32;
    let end: i32;

    @iterable
    func iter(): RangeCursor {
        return RangeCursor { current: self.start, end: self.end };
    }
}

func main(args: string[]) {
    let r = Range { start: 1, end: 4 };
    for let n in r {
        if n == 1 {
            puts(&"one");
        } else if n == 2 {
            puts(&"two");
        } else if n == 3 {
            puts(&"three");
        }
    }
    puts(&"done");
}
