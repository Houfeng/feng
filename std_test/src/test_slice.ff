mod std_test;

use std;
use std.collections;

fn array_clone_all_readonly() {
  let values: int[] = [1, 2, 3];
  let copied = values.clone();

  check(copied.length() == (long)3, "slice/array-clone-all-length");
  check(copied[(int)0] == 1, "slice/array-clone-all-0");
  check(copied[(int)1] == 2, "slice/array-clone-all-1");
  check(copied[(int)2] == 3, "slice/array-clone-all-2");
}

fn array_clone_range_is_independent() {
  let values: int[!] = [10, 20, 30, 40];
  let copied = values.clone((long)1, (long)3);

  values[(int)1] = 99;
  values[(int)2] = 88;

  check(copied.length() == (long)2, "slice/array-clone-range-length");
  check(copied[(int)0] == 20, "slice/array-clone-range-0");
  check(copied[(int)1] == 30, "slice/array-clone-range-1");
}

fn array_clone_invalid_range() {
  let values: int[] = [1, 2, 3];
  var caught: bool = false;

  let ignored = try values.clone((long)2, (long)4) catch ex: string {
    caught = true;
    values;
  };

  check(caught, "slice/array-clone-invalid-range");
}

fn array_clone_negative_end() {
  let values: int[] = [1, 2, 3];
  var caught: bool = false;

  let ignored = try values.clone((long)0, (long)-1) catch ex: string {
    caught = true;
    values;
  };

  check(caught, "slice/array-clone-negative-length");
}

fn array_slice_to_end_readonly() {
  let values: int[] = [1, 2, 3, 4];
  let tail = values.slice((long)1);

  check(tail.length() == (long)3, "slice/array-tail-readonly-length");
  check(tail.get((long)0) == 2, "slice/array-tail-readonly-0");
  check(tail.get((long)1) == 3, "slice/array-tail-readonly-1");
  check(tail.get((long)2) == 4, "slice/array-tail-readonly-2");
}

fn array_slice_to_end_writable() {
  let values: int[!] = [10, 20, 30, 40];
  let tail = values.slice((long)2);

  check(tail.length() == (long)2, "slice/array-tail-writable-length");
  check(tail.get((long)0) == 30, "slice/array-tail-writable-0");
  check(tail.get((long)1) == 40, "slice/array-tail-writable-1");
}

fn span_slice_relative_range() {
  let values: int[] = [1, 2, 3, 4, 5];
  let middle = values.slice((long)1, (long)4);
  let tail = middle.slice((long)1, (long)3);

  check(tail.length() == (long)2, "slice/span-subslice-length");
  check(tail.get((long)0) == 3, "slice/span-subslice-0");
  check(tail.get((long)1) == 4, "slice/span-subslice-1");
}

fn span_slice_relative_tail() {
  let values: int[] = [1, 2, 3, 4, 5];
  let middle = values.slice((long)1, (long)4);
  let tail = middle.slice((long)1);

  check(tail.length() == (long)2, "slice/span-subslice-tail-length");
  check(tail.get((long)0) == 3, "slice/span-subslice-tail-0");
  check(tail.get((long)1) == 4, "slice/span-subslice-tail-1");
}

fn span_slice_invalid_relative_range() {
  let values: int[] = [1, 2, 3, 4];
  let middle = values.slice((long)1, (long)3);
  var caught: bool = false;

  let ignored = try middle.slice((long)1, (long)3) catch ex: string {
    caught = true;
    middle;
  };

  check(caught, "slice/span-subslice-invalid-range");
}

fn span_to_array_is_independent() {
  let values: int[!] = [7, 8, 9, 10];
  let middle = values.slice((long)1, (long)3);
  let copied = middle.toArray();

  values[(int)1] = 99;
  values[(int)2] = 88;

  check(copied.length() == (long)2, "slice/span-to-array-length");
  check(copied[(int)0] == 8, "slice/span-to-array-0");
  check(copied[(int)1] == 9, "slice/span-to-array-1");
}

fn span_to_array_empty() {
  let values: int[] = [1, 2, 3];
  let empty = values.slice((long)1, (long)1).toArray();

  check(empty.length() == (long)0, "slice/span-to-array-empty");
}

pu fn run_slice_tests() {
  array_clone_all_readonly();
  array_clone_range_is_independent();
  array_clone_invalid_range();
  array_clone_negative_end();
  array_slice_to_end_readonly();
  array_slice_to_end_writable();
  span_slice_relative_range();
  span_slice_relative_tail();
  span_slice_invalid_relative_range();
  span_to_array_is_independent();
  span_to_array_empty();
}