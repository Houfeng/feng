module std_test;

import std.test;

import std.collections;

func array_clone_all_readonly() {
  let values: i32[] = [1, 2, 3];
  let copied = values.clone();

  check(copied.length() == (i64)3, "slice/array-clone-all-length");
  check(copied[(i32)0] == 1, "slice/array-clone-all-0");
  check(copied[(i32)1] == 2, "slice/array-clone-all-1");
  check(copied[(i32)2] == 3, "slice/array-clone-all-2");
}

func array_clone_range_is_independent() {
  let values: i32[!] = [10, 20, 30, 40];
  let copied = values.clone((i64)1, (i64)3);

  values[(i32)1] = 99;
  values[(i32)2] = 88;

  check(copied.length() == (i64)2, "slice/array-clone-range-length");
  check(copied[(i32)0] == 20, "slice/array-clone-range-0");
  check(copied[(i32)1] == 30, "slice/array-clone-range-1");
}

func array_clone_invalid_range() {
  let values: i32[] = [1, 2, 3];
  var caught: bool = false;

  let ignored = try values.clone((i64)2, (i64)4) catch ex: string {
    caught = true;
    values;
  };

  check(caught, "slice/array-clone-invalid-range");
}

func array_clone_negative_end() {
  let values: i32[] = [1, 2, 3];
  var caught: bool = false;

  let ignored = try values.clone((i64)0, (i64)-1) catch ex: string {
    caught = true;
    values;
  };

  check(caught, "slice/array-clone-negative-length");
}

func array_slice_to_end_readonly() {
  let values: i32[] = [1, 2, 3, 4];
  let tail = values.slice((i64)1);

  check(tail.length() == (i64)3, "slice/array-tail-readonly-length");
  check(tail.get((i64)0) == 2, "slice/array-tail-readonly-0");
  check(tail.get((i64)1) == 3, "slice/array-tail-readonly-1");
  check(tail.get((i64)2) == 4, "slice/array-tail-readonly-2");
}

func array_slice_to_end_writable() {
  let values: i32[!] = [10, 20, 30, 40];
  let tail = values.slice((i64)2);

  check(tail.length() == (i64)2, "slice/array-tail-writable-length");
  check(tail.get((i64)0) == 30, "slice/array-tail-writable-0");
  check(tail.get((i64)1) == 40, "slice/array-tail-writable-1");
}

func span_slice_relative_range() {
  let values: i32[] = [1, 2, 3, 4, 5];
  let middle = values.slice((i64)1, (i64)4);
  let tail = middle.slice((i64)1, (i64)3);

  check(tail.length() == (i64)2, "slice/span-subslice-length");
  check(tail.get((i64)0) == 3, "slice/span-subslice-0");
  check(tail.get((i64)1) == 4, "slice/span-subslice-1");
}

func span_slice_relative_tail() {
  let values: i32[] = [1, 2, 3, 4, 5];
  let middle = values.slice((i64)1, (i64)4);
  let tail = middle.slice((i64)1);

  check(tail.length() == (i64)2, "slice/span-subslice-tail-length");
  check(tail.get((i64)0) == 3, "slice/span-subslice-tail-0");
  check(tail.get((i64)1) == 4, "slice/span-subslice-tail-1");
}

func span_slice_invalid_relative_range() {
  let values: i32[] = [1, 2, 3, 4];
  let middle = values.slice((i64)1, (i64)3);
  var caught: bool = false;

  let ignored = try middle.slice((i64)1, (i64)3) catch ex: string {
    caught = true;
    middle;
  };

  check(caught, "slice/span-subslice-invalid-range");
}

func span_to_array_is_independent() {
  let values: i32[!] = [7, 8, 9, 10];
  let middle = values.slice((i64)1, (i64)3);
  let copied = middle.toArray();

  values[(i32)1] = 99;
  values[(i32)2] = 88;

  check(copied.length() == (i64)2, "slice/span-to-array-length");
  check(copied[(i32)0] == 8, "slice/span-to-array-0");
  check(copied[(i32)1] == 9, "slice/span-to-array-1");
}

func span_to_array_empty() {
  let values: i32[] = [1, 2, 3];
  let empty = values.slice((i64)1, (i64)1).toArray();

  check(empty.length() == (i64)0, "slice/span-to-array-empty");
}

open func run_slice_tests() {
  describe("slice tests", () {
    test("array_clone_all_readonly()", () { array_clone_all_readonly(); });
    test("array_clone_range_is_independent()", () { array_clone_range_is_independent(); });
    test("array_clone_invalid_range()", () { array_clone_invalid_range(); });
    test("array_clone_negative_end()", () { array_clone_negative_end(); });
    test("array_slice_to_end_readonly()", () { array_slice_to_end_readonly(); });
    test("array_slice_to_end_writable()", () { array_slice_to_end_writable(); });
    test("span_slice_relative_range()", () { span_slice_relative_range(); });
    test("span_slice_relative_tail()", () { span_slice_relative_tail(); });
    test("span_slice_invalid_relative_range()", () { span_slice_invalid_relative_range(); });
    test("span_to_array_is_independent()", () { span_to_array_is_independent(); });
    test("span_to_array_empty()", () { span_to_array_empty(); });
  });
}