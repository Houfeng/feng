module std_test;

import std;
import std.test;
import std.collections;
import std.text;

import std.tui;

// ─── 静态常量 ──────────────────────────────────────────────────────────────

func cell_mask_fg() {
  check(Cell.MASK_FG == (u64)0xFFFFFF, "tui/cell/mask-fg");
}

func cell_mask_bg() {
  check(Cell.MASK_BG == ((u64)0xFFFFFF << (u64)24), "tui/cell/mask-bg");
}

func cell_mask_flags() {
  check(Cell.MASK_FLAGS == ((u64)0xFF << (u64)48), "tui/cell/mask-flags");
}

func cell_style_bold_const() {
  check(Cell.STYLE_BOLD == ((u64)1 << (u64)48), "tui/cell/style-bold-const");
}

func cell_style_dim_const() {
  check(Cell.STYLE_DIM == ((u64)1 << (u64)49), "tui/cell/style-dim-const");
}

func cell_style_italic_const() {
  check(Cell.STYLE_ITALIC == ((u64)1 << (u64)50), "tui/cell/style-italic-const");
}

func cell_style_underline_const() {
  check(Cell.STYLE_UNDERLINE == ((u64)1 << (u64)51), "tui/cell/style-underline-const");
}

func cell_style_blink_const() {
  check(Cell.STYLE_BLINK == ((u64)1 << (u64)52), "tui/cell/style-blink-const");
}

func cell_style_reverse_const() {
  check(Cell.STYLE_REVERSE == ((u64)1 << (u64)53), "tui/cell/style-reverse-const");
}

func cell_style_hidden_const() {
  check(Cell.STYLE_HIDDEN == ((u64)1 << (u64)54), "tui/cell/style-hidden-const");
}

func cell_style_strikethrough_const() {
  check(Cell.STYLE_STRIKETHROUGH == ((u64)1 << (u64)55), "tui/cell/style-strikethrough-const");
}

// ─── 构造函数 ──────────────────────────────────────────────────────────────

func cell_ctor_default() {
  let c = Cell();
  check(c.value == (u64)0, "tui/cell/ctor-default-value");
  check(c.style == (u64)0, "tui/cell/ctor-default-style");
}

func cell_ctor_value() {
  let c = Cell((u64)65);
  check(c.value == (u64)65, "tui/cell/ctor-value-value");
  check(c.style == (u64)0, "tui/cell/ctor-value-style");
}

func cell_ctor_value_style() {
  let c = Cell((u64)65, Cell.STYLE_BOLD);
  check(c.value == (u64)65, "tui/cell/ctor-value-style-value");
  check(c.style == Cell.STYLE_BOLD, "tui/cell/ctor-value-style-style");
}

// ─── 前景色 / 背景色读写 ────────────────────────────────────────────────────

func cell_fore_color_rw() {
  let c = Cell((u64)65);
  check(c.foreColor() == (u32)0, "tui/cell/fore-color-init");
  c.foreColor((u32)0xABCDEE);
  check(c.foreColor() == (u32)0xABCDEE, "tui/cell/fore-color-set");
}

func cell_back_color_rw() {
  let c = Cell((u64)65);
  check(c.backColor() == (u32)0, "tui/cell/back-color-init");
  c.backColor((u32)0x123456);
  check(c.backColor() == (u32)0x123456, "tui/cell/back-color-set");
}

func cell_fore_back_color_independent() {
  let c = Cell((u64)65);
  c.foreColor((u32)0xFF);
  c.backColor((u32)0xFF00);
  check(c.foreColor() == (u32)0xFF, "tui/cell/fore-back-independent-fg");
  check(c.backColor() == (u32)0xFF00, "tui/cell/fore-back-independent-bg");
}

// ─── 样式标志位读写 ──────────────────────────────────────────────────────────

func cell_bold_rw() {
  let c = Cell((u64)65);
  check(c.bold() == false, "tui/cell/bold-init");
  c.bold(true);
  check(c.bold() == true, "tui/cell/bold-set-true");
  check(c.style == Cell.STYLE_BOLD, "tui/cell/bold-style-value");
  c.bold(false);
  check(c.bold() == false, "tui/cell/bold-set-false");
  check(c.style == (u64)0, "tui/cell/bold-cleared");
}

func cell_dim_rw() {
  let c = Cell((u64)65);
  check(c.dim() == false, "tui/cell/dim-init");
  c.dim(true);
  check(c.dim() == true, "tui/cell/dim-set-true");
  c.dim(false);
  check(c.dim() == false, "tui/cell/dim-set-false");
}

func cell_italic_rw() {
  let c = Cell((u64)65);
  check(c.italic() == false, "tui/cell/italic-init");
  c.italic(true);
  check(c.italic() == true, "tui/cell/italic-set-true");
  c.italic(false);
  check(c.italic() == false, "tui/cell/italic-set-false");
}

func cell_underline_rw() {
  let c = Cell((u64)65);
  check(c.underline() == false, "tui/cell/underline-init");
  c.underline(true);
  check(c.underline() == true, "tui/cell/underline-set-true");
  c.underline(false);
  check(c.underline() == false, "tui/cell/underline-set-false");
}

func cell_blink_rw() {
  let c = Cell((u64)65);
  check(c.blink() == false, "tui/cell/blink-init");
  c.blink(true);
  check(c.blink() == true, "tui/cell/blink-set-true");
  c.blink(false);
  check(c.blink() == false, "tui/cell/blink-set-false");
}

func cell_reverse_rw() {
  let c = Cell((u64)65);
  check(c.reverse() == false, "tui/cell/reverse-init");
  c.reverse(true);
  check(c.reverse() == true, "tui/cell/reverse-set-true");
  c.reverse(false);
  check(c.reverse() == false, "tui/cell/reverse-set-false");
}

func cell_hidden_rw() {
  let c = Cell((u64)65);
  check(c.hidden() == false, "tui/cell/hidden-init");
  c.hidden(true);
  check(c.hidden() == true, "tui/cell/hidden-set-true");
  c.hidden(false);
  check(c.hidden() == false, "tui/cell/hidden-set-false");
}

func cell_strikethrough_rw() {
  let c = Cell((u64)65);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-init");
  c.strikeThrough(true);
  check(c.strikeThrough() == true, "tui/cell/strikethrough-set-true");
  c.strikeThrough(false);
  check(c.strikeThrough() == false, "tui/cell/strikethrough-set-false");
}

// ─── 样式组合 ──────────────────────────────────────────────────────────────

func cell_style_combination() {
  let c = Cell((u64)65);
  c.bold(true);
  c.italic(true);
  c.underline(true);
  check(c.bold() == true, "tui/cell/combination-bold");
  check(c.italic() == true, "tui/cell/combination-italic");
  check(c.underline() == true, "tui/cell/combination-underline");
  check(c.dim() == false, "tui/cell/combination-dim-false");
  check(c.blink() == false, "tui/cell/combination-blink-false");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(c.style == expected, "tui/cell/combination-style-value");
}

func cell_style_with_colors() {
  let c = Cell((u64)65);
  c.foreColor((u32)0xFFFFFF);
  c.backColor((u32)0x000000);
  c.bold(true);
  check(c.foreColor() == (u32)0xFFFFFF, "tui/cell/style-colors-fg");
  check(c.backColor() == (u32)0x000000, "tui/cell/style-colors-bg");
  check(c.bold() == true, "tui/cell/style-colors-bold");
  check(c.value == (u64)65, "tui/cell/style-colors-value");
}

// ─── Cell 直接字段读写（open var） ──────────────────────────────────────────

func cell_field_rw() {
  let c = Cell();
  check(c.value == (u64)0, "tui/cell/field-rw-value-init");
  check(c.style == (u64)0, "tui/cell/field-rw-style-init");
  c.value = (u64)0x4E2D;
  c.style = Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE;
  check(c.value == (u64)0x4E2D, "tui/cell/field-rw-value-write");
  check(c.style == (Cell.STYLE_BOLD | Cell.STYLE_UNDERLINE), "tui/cell/field-rw-style-write");
  check(c.bold() == true, "tui/cell/field-rw-bold");
  check(c.underline() == true, "tui/cell/field-rw-underline");
  c.value = (u64)65;
  c.style = (u64)0;
  check(c.value == (u64)65, "tui/cell/field-rw-value-overwrite");
  check(c.style == (u64)0, "tui/cell/field-rw-style-clear");
  check(c.bold() == false, "tui/cell/field-rw-bold-cleared");
}

// ─── Buffer 构造函数 ──────────────────────────────────────────────────────

func buffer_ctor() {
  let buf = Buffer((u32)10, (u32)5);
  check(buf.width == (u32)10, "tui/buffer/ctor-width");
  check(buf.height == (u32)5, "tui/buffer/ctor-height");
  check(buf.cells.length() == (int)50, "tui/buffer/ctor-cells-length");
}

func buffer_default_cells() {
  let buf = Buffer((u32)3, (u32)2);
  // 直接通过 cells 数组读取默认值
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/default-cells-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/default-cells-style");
  let idx = (int)((u64)1 * (u64)3 + (u64)1); // y=1, x=1
  check(buf.cells[idx].value == (u64)0, "tui/buffer/default-cells-value-1-1");
  check(buf.cells[idx].style == (u64)0, "tui/buffer/default-cells-style-1-1");
}

// ─── Buffer 直接操作 cells（就地修改） ───────────────────────────────────────

func buffer_cells_in_place_modify() {
  let buf = Buffer((u32)4, (u32)4);
  let idx = (int)((u64)1 * (u64)4 + (u64)2);  // y=1, x=2
  buf.cells[idx].value = (u64)65;
  buf.cells[idx].bold(true);
  buf.cells[idx].foreColor((u32)0xFF0000);

  check(buf.cells[idx].value == (u64)65, "tui/buffer/in-place-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/in-place-bold");
  check(buf.cells[idx].foreColor() == (u32)0xFF0000, "tui/buffer/in-place-fg");
}

// ─── Buffer draw 文本（单行） ────────────────────────────────────────────────

func buffer_draw_text_ascii() {
  let buf = Buffer((u32)10, (u32)3);
  buf.draw((u32)0, (u32)0, "Hello");
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-ascii-h");
  check(buf.cells[(int)1].value == (u64)101, "tui/buffer/draw-text-ascii-e");
  check(buf.cells[(int)4].value == (u64)111, "tui/buffer/draw-text-ascii-o");
  // 未写入的位置应保持默认
  check(buf.cells[(int)5].value == (u64)0, "tui/buffer/draw-text-ascii-after");
}

func buffer_draw_text_chinese() {
  let buf = Buffer((u32)10, (u32)2);
  // "中" U+4E2D, "文" U+6587
  buf.draw((u32)0, (u32)0, "中文");
  check(buf.cells[(int)0].value == (u64)0x4E2D, "tui/buffer/draw-text-chinese-0");
  check(buf.cells[(int)1].value == (u64)0x6587, "tui/buffer/draw-text-chinese-1");
}

func buffer_draw_text_emoji() {
  let buf = Buffer((u32)10, (u32)2);
  // 😀 U+1F600
  buf.draw((u32)0, (u32)0, "😀");
  check(buf.cells[(int)0].value == (u64)0x1F600, "tui/buffer/draw-text-emoji");
}

func buffer_draw_text_clip() {
  let buf = Buffer((u32)4, (u32)2);
  // 在宽度为 4 的行写 6 个字符，后 2 个应被裁剪
  buf.draw((u32)0, (u32)0, "ABCDEF");
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-text-clip-a");
  check(buf.cells[(int)3].value == (u64)68, "tui/buffer/draw-text-clip-d");
  // 第 5 个字符 'E' (69) 应被裁剪，不写入到下一行
  check(buf.cells[(int)4].value == (u64)0, "tui/buffer/draw-text-clip-next-row");
}

func buffer_draw_text_offset_and_clip() {
  let buf = Buffer((u32)5, (u32)2);
  // 从 x=2 开始写，只有 3 个位置可用
  buf.draw((u32)2, (u32)0, "ABCDE");
  check(buf.cells[(int)2].value == (u64)65, "tui/buffer/draw-text-offset-a");
  check(buf.cells[(int)4].value == (u64)67, "tui/buffer/draw-text-offset-c");
}

func buffer_draw_text_empty() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)0, "");
  // 空字符串不改变任何 Cell
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-empty");
}

func buffer_draw_text_y_out_of_bounds() {
  let buf = Buffer((u32)5, (u32)2);
  buf.draw((u32)0, (u32)5, "Hello");
  // 行越界，整行不写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-text-y-oob");
}

func buffer_draw_text_with_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", Style.bold, Style.underline);
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-style-value");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-style-bold");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/draw-text-style-underline");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-style-bold-1");
}

// ─── Buffer draw 矩形文本（自动换行） ──────────────────────────────────────

func buffer_draw_rect_text_wrap() {
  let buf = Buffer((u32)5, (u32)3);
  // 在 5x2 矩形内绘制 "ABCDEFGH" (8字符)，应自动换行
  buf.draw((u32)0, (u32)0, (u32)5, (u32)2, "ABCDEFGH");
  // 第一行: A B C D E
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-wrap-0a");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-wrap-0e");
  // 第二行: F G H
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-wrap-1f");
  let idx12 = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx12].value == (u64)72, "tui/buffer/draw-rect-wrap-1h");
  // 第三行不应被写入
  let idx20 = (int)((u64)2 * (u64)5 + (u64)0);
  check(buf.cells[idx20].value == (u64)0, "tui/buffer/draw-rect-wrap-2-empty");
}

func buffer_draw_rect_text_clip_height() {
  let buf = Buffer((u32)5, (u32)2);
  // 在 5x3 矩形内绘制，但 Buffer 只有 2 行，第 3 行应被裁剪
  buf.draw((u32)0, (u32)0, (u32)5, (u32)3, "ABCDEFGHIJKLMN");
  // 第一行写入 5 个
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/draw-rect-clip-h-0");
  check(buf.cells[(int)4].value == (u64)69, "tui/buffer/draw-rect-clip-h-4");
  // 第二行写入 5 个
  let idx10 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx10].value == (u64)70, "tui/buffer/draw-rect-clip-h-1f");
  let idx14 = (int)((u64)1 * (u64)5 + (u64)4);
  check(buf.cells[idx14].value == (u64)74, "tui/buffer/draw-rect-clip-h-1j");
}

// ─── Buffer draw 单码点 ────────────────────────────────────────────────────

func buffer_draw_codepoint() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)2, (u32)1, (u64)65, Style.bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)2);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-value");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-bold");
}

func buffer_draw_codepoint_out_of_bounds() {
  let buf = Buffer((u32)3, (u32)3);
  buf.draw((u32)5, (u32)0, (u64)65);
  buf.draw((u32)0, (u32)5, (u64)65);
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-codepoint-oob");
}

// ─── Buffer draw 矩形码点填充 ──────────────────────────────────────────────

func buffer_draw_rect_codepoint() {
  let buf = Buffer((u32)5, (u32)4);
  buf.draw((u32)1, (u32)1, (u32)3, (u32)2, (u64)65, Style.italic);
  // 矩形内 (1,1) 到 (3,2) 应被填充
  let idx11 = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx11].value == (u64)65, "tui/buffer/draw-rect-cp-11");
  let idx13 = (int)((u64)1 * (u64)5 + (u64)3);
  check(buf.cells[idx13].value == (u64)65, "tui/buffer/draw-rect-cp-13");
  let idx21 = (int)((u64)2 * (u64)5 + (u64)1);
  check(buf.cells[idx21].value == (u64)65, "tui/buffer/draw-rect-cp-21");
  check(buf.cells[idx21].italic() == true, "tui/buffer/draw-rect-cp-italic");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)65, "tui/buffer/draw-rect-cp-23");
  // 矩形外不应被写入
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/draw-rect-cp-outside-0");
  let idx33 = (int)((u64)3 * (u64)5 + (u64)3);
  check(buf.cells[idx33].value == (u64)0, "tui/buffer/draw-rect-cp-outside-33");
}

// ─── Buffer fill ────────────────────────────────────────────────────────────

func buffer_fill() {
  let buf = Buffer((u32)3, (u32)3);
  buf.fill((u64)65, Style.bold);
  // 检查多个位置
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-0-0");
  let idx22 = (int)((u64)2 * (u64)3 + (u64)2);
  check(buf.cells[idx22].value == (u64)65, "tui/buffer/fill-2-2");
  let idx11 = (int)((u64)1 * (u64)3 + (u64)1);
  check(buf.cells[idx11].bold() == true, "tui/buffer/fill-bold");
}

func buffer_fill_no_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)88);
  check(buf.cells[(int)0].value == (u64)88, "tui/buffer/fill-no-style-value");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/fill-no-style-style");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].value == (u64)88, "tui/buffer/fill-no-style-value-3");
}

func buffer_fill_multi_style() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, Style.bold, Style.italic, Style.underline);
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-multi-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/fill-multi-italic");
  check(buf.cells[(int)0].underline() == true, "tui/buffer/fill-multi-underline");
  let expected: u64 = Cell.STYLE_BOLD | Cell.STYLE_ITALIC | Cell.STYLE_UNDERLINE;
  check(buf.cells[(int)0].style == expected, "tui/buffer/fill-multi-combined");
}

// ─── Buffer clear ───────────────────────────────────────────────────────────

func buffer_clear() {
  let buf = Buffer((u32)3, (u32)2);
  buf.cells[(int)0].value = (u64)65;
  buf.cells[(int)0].bold(true);
  buf.cells[(int)3].value = (u64)66;
  buf.clear();
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/clear-value-0-0");
  check(buf.cells[(int)0].style == (u64)0, "tui/buffer/clear-style-0-0");
  let idx01 = (int)((u64)1 * (u64)3 + (u64)0);
  check(buf.cells[idx01].value == (u64)0, "tui/buffer/clear-value-0-1");
  check(buf.cells[idx01].style == (u64)0, "tui/buffer/clear-style-0-1");
}

// ─── RgbColor 构造函数 ────────────────────────────────────────────────────

func rgb_color_default() {
  let c = RgbColor();
  check(c.r == (u8)0, "tui/rgb/ctor-default-r");
  check(c.g == (u8)0, "tui/rgb/ctor-default-g");
  check(c.b == (u8)0, "tui/rgb/ctor-default-b");
}

func rgb_color_ctor() {
  let c = RgbColor((u8)0xFF, (u8)0x80, (u8)0x40);
  check(c.r == (u8)0xFF, "tui/rgb/ctor-r");
  check(c.g == (u8)0x80, "tui/rgb/ctor-g");
  check(c.b == (u8)0x40, "tui/rgb/ctor-b");
}

func rgb_color_field_rw() {
  let c = RgbColor();
  c.r = (u8)10;
  c.g = (u8)20;
  c.b = (u8)30;
  check(c.r == (u8)10, "tui/rgb/field-rw-r");
  check(c.g == (u8)20, "tui/rgb/field-rw-g");
  check(c.b == (u8)30, "tui/rgb/field-rw-b");
}

// ─── Buffer draw 带前景色 ──────────────────────────────────────────────────

func buffer_draw_text_with_fg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  check(buf.cells[(int)0].value == (u64)72, "tui/buffer/draw-text-fg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-color");
  check(buf.cells[(int)0].backColor() == (u32)0, "tui/buffer/draw-text-fg-bg-default");
  check(buf.cells[(int)0].bold() == false, "tui/buffer/draw-text-fg-no-style");
}

func buffer_draw_text_with_fg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), Style.bold);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-style-color");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-style-bold");
  check(buf.cells[(int)1].bold() == true, "tui/buffer/draw-text-fg-style-bold-1");
}

// ─── Buffer draw 带前景色及背景色 ──────────────────────────────────────────

func buffer_draw_text_with_fg_bg() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-bg");
}

func buffer_draw_text_with_fg_bg_and_style() {
  let buf = Buffer((u32)10, (u32)2);
  buf.draw((u32)0, (u32)0, "Hi", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0x00, (u8)0xFF), Style.bold, Style.italic);
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/draw-text-fg-bg-style-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x0000FF, "tui/buffer/draw-text-fg-bg-style-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/draw-text-fg-bg-style-bold");
  check(buf.cells[(int)0].italic() == true, "tui/buffer/draw-text-fg-bg-style-italic");
}

// ─── Buffer draw 码点带颜色 ────────────────────────────────────────────────

func buffer_draw_codepoint_with_fg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00));
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].value == (u64)65, "tui/buffer/draw-codepoint-fg-value");
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-color");
}

func buffer_draw_codepoint_with_fg_bg() {
  let buf = Buffer((u32)5, (u32)3);
  buf.draw((u32)1, (u32)1, (u64)65, RgbColor((u8)0xFF, (u8)0xFF, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0xFF), Style.bold);
  let idx = (int)((u64)1 * (u64)5 + (u64)1);
  check(buf.cells[idx].foreColor() == (u32)0xFFFF00, "tui/buffer/draw-codepoint-fg-bg-fg");
  check(buf.cells[idx].backColor() == (u32)0x00FFFF, "tui/buffer/draw-codepoint-fg-bg-bg");
  check(buf.cells[idx].bold() == true, "tui/buffer/draw-codepoint-fg-bg-bold");
}

// ─── Buffer fill 带颜色 ────────────────────────────────────────────────────

func buffer_fill_with_fg_bg() {
  let buf = Buffer((u32)2, (u32)2);
  buf.fill((u64)65, RgbColor((u8)0xFF, (u8)0x00, (u8)0x00), RgbColor((u8)0x00, (u8)0xFF, (u8)0x00), Style.bold);
  check(buf.cells[(int)0].value == (u64)65, "tui/buffer/fill-fg-bg-value");
  check(buf.cells[(int)0].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg");
  check(buf.cells[(int)0].backColor() == (u32)0x00FF00, "tui/buffer/fill-fg-bg-bg");
  check(buf.cells[(int)0].bold() == true, "tui/buffer/fill-fg-bg-bold");
  let idx3 = (int)((u64)1 * (u64)2 + (u64)1);
  check(buf.cells[idx3].foreColor() == (u32)0xFF0000, "tui/buffer/fill-fg-bg-fg-3");
}

// ─── Buffer 矩阵索引正确性 ──────────────────────────────────────────────────

func buffer_matrix_index() {
  let buf = Buffer((u32)5, (u32)4);
  // 在每个位置写入唯一的标识值
  var y: u32 = 0;
  while y < (u32)4 {
    var x: u32 = 0;
    while x < (u32)5 {
      let idx = (int)((u64)y * (u64)5 + (u64)x);
      buf.cells[idx].value = (u64)((u64)y * (u64)100 + (u64)x);
      x += (u32)1;
    }
    y += (u32)1;
  }
  // 验证读取
  check(buf.cells[(int)0].value == (u64)0, "tui/buffer/matrix-0-0");
  check(buf.cells[(int)4].value == (u64)4, "tui/buffer/matrix-4-0");
  let idx01 = (int)((u64)1 * (u64)5 + (u64)0);
  check(buf.cells[idx01].value == (u64)100, "tui/buffer/matrix-0-1");
  let idx23 = (int)((u64)2 * (u64)5 + (u64)3);
  check(buf.cells[idx23].value == (u64)203, "tui/buffer/matrix-3-2");
  let idx34 = (int)((u64)3 * (u64)5 + (u64)4);
  check(buf.cells[idx34].value == (u64)304, "tui/buffer/matrix-4-3");
}

// ─── Screen 基础结构 ───────────────────────────────────────────────────────

func screen_ctor() {
  let scr = Screen((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/ctor-width");
  check(sz.item2 == (u32)5, "tui/screen/ctor-height");
}

func screen_buffer_returns_back() {
  let scr = Screen((u32)10, (u32)5);
  let buf = scr.buffer();
  // buffer() 返回的 Buffer 可正常绘制
  buf.draw((u32)0, (u32)0, "Hi");
  check(buf.cells[(int)0].value == (u64)72, "tui/screen/buffer-draw-h");
  check(buf.cells[(int)1].value == (u64)105, "tui/screen/buffer-draw-i");
}

func screen_clear() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.clear();
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/clear-0");
  check(scr.buffer().cells[(int)1].value == (u64)0, "tui/screen/clear-1");
}

func screen_render_empty_no_diff() {
  let scr = Screen((u32)5, (u32)2);
  // front 和 back 都是空白，buildPatchString() 应返回空字符串（无差异）
  let out = scr.buildPatchString();
  check(out.length() == (int)0, "tui/screen/render-empty-no-diff");
}

func screen_render_full_diff() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  // 第一次 buildPatchString，front 全空白，back 有内容 → 应输出差异序列
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/render-full-diff-nonempty");
  // 第二次 buildPatchString，front 已同步 → 应无差异
  let out2 = scr.buildPatchString();
  check(out2.length() == (int)0, "tui/screen/render-after-sync-no-diff");
}

func screen_render_cursor_position() {
  let scr = Screen((u32)10, (u32)5);
  // 在 (2, 1) 处绘制
  scr.buffer().draw((u32)2, (u32)1, (u64)65);
  let out = scr.buildPatchString();
  // 应包含光标定位序列 \x1b[2;3H（行=2, 列=3，1-based）
  check(out.contains("\x1b[2;3H"), "tui/screen/render-cursor-position");
}

func screen_render_codepoint_output() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, (u64)65);  // 'A'
  let out = scr.buildPatchString();
  check(out.contains("A"), "tui/screen/render-codepoint-ascii");
}

func screen_render_codepoint_zero_to_space() {
  let scr = Screen((u32)5, (u32)2);
  // 先绘制非零内容并 buildPatchString 同步到 front
  scr.buffer().draw((u32)0, (u32)0, "AB");
  scr.buildPatchString();
  // 清空 back 为码点 0，buildPatchString 时码点 0 应输出空格
  scr.buffer().fill((u64)0);
  let out = scr.buildPatchString();
  check(out.contains(" "), "tui/screen/render-codepoint-zero-space");
}

func screen_render_sgr_reset() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", Style.bold);
  let out = scr.buildPatchString();
  // 渲染结束后应重置 SGR
  check(out.contains("\x1b[0m"), "tui/screen/render-sgr-reset");
}

func screen_render_sgr_bold() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", Style.bold);
  let out = scr.buildPatchString();
  // SGR 序列应包含 bold (1)
  check(out.contains("\x1b[1m") || out.contains(";1m"), "tui/screen/render-sgr-bold");
}

func screen_render_sgr_fg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", RgbColor((u8)0xFF, (u8)0x00, (u8)0x00));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg-color");
}

func screen_render_sgr_fg_bg_color() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X",
    RgbColor((u8)0xFF, (u8)0x00, (u8)0x00),
    RgbColor((u8)0x00, (u8)0x00, (u8)0xFF));
  let out = scr.buildPatchString();
  // 前景色 38;2;255;0;0 和背景色 48;2;0;0;255
  check(out.contains("38;2;255;0;0"), "tui/screen/render-sgr-fg");
  check(out.contains("48;2;0;0;255"), "tui/screen/render-sgr-bg");
}

func screen_render_sgr_multi_style() {
  let scr = Screen((u32)5, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "X", Style.bold, Style.italic, Style.underline);
  let out = scr.buildPatchString();
  // SGR 应包含 1;3;4
  check(out.contains("1"), "tui/screen/render-sgr-multi-bold");
  check(out.contains("3"), "tui/screen/render-sgr-multi-italic");
  check(out.contains("4"), "tui/screen/render-sgr-multi-underline");
}

func screen_render_partial_diff() {
  let scr = Screen((u32)10, (u32)2);
  // 第一次绘制 + buildPatchString
  scr.buffer().draw((u32)0, (u32)0, "Hello");
  let out1 = scr.buildPatchString();
  check(out1.length() > (int)0, "tui/screen/partial-diff-first");

  // 只修改一个 cell
  scr.buffer().draw((u32)0, (u32)0, (u64)74);  // 'J'
  let out2 = scr.buildPatchString();
  // 应只包含一个 cell 的差异，输出应比第一次短
  check(out2.length() < out1.length(), "tui/screen/partial-diff-second-shorter");
  check(out2.contains("J"), "tui/screen/partial-diff-second-contains-j");
}

func screen_render_no_sgr_for_unchanged_style() {
  let scr = Screen((u32)10, (u32)2);
  // 绘制两个连续 cell，相同样式
  scr.buffer().draw((u32)0, (u32)0, "AB", Style.bold);
  let out = scr.buildPatchString();
  // 应只发射一次 SGR bold（统计 "\x1b[" 后含 "1" 的 SGR 序列出现次数）
  // 验证：输出中 "1m" 或 ";1m" 只出现一次（不算最终 \x1b[0m）
  let resetSeq = "\x1b[0m";
  let withoutReset = out.replace(resetSeq, "");
  // bold SGR 序列 "\x1b[" 开头且以 "m" 结尾，包含 "1"
  check(withoutReset.contains("1m"), "tui/screen/no-sgr-repeat-bold-present");
}

func screen_resize() {
  let scr = Screen((u32)5, (u32)3);
  scr.buffer().draw((u32)0, (u32)0, "Hi");
  scr.buildPatchString();  // 同步 front

  // resize 后尺寸应更新
  scr.resize((u32)10, (u32)5);
  let sz = scr.size();
  check(sz.item1 == (u32)10, "tui/screen/resize-width");
  check(sz.item2 == (u32)5, "tui/screen/resize-height");

  // resize 后 back 为空白
  check(scr.buffer().cells[(int)0].value == (u64)0, "tui/screen/resize-back-cleared");

  // resize 后 front 也清空，绘制新内容后 buildPatchString 应全量重绘
  scr.buffer().draw((u32)0, (u32)0, "X");
  let out = scr.buildPatchString();
  check(out.length() > (int)0, "tui/screen/resize-render-full");
  check(out.contains("X"), "tui/screen/resize-render-contains-x");
}

func screen_render_unicode_chinese() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "中");
  let out = scr.buildPatchString();
  check(out.contains("中"), "tui/screen/render-unicode-chinese");
}

func screen_render_unicode_emoji() {
  let scr = Screen((u32)10, (u32)2);
  scr.buffer().draw((u32)0, (u32)0, "😀");
  let out = scr.buildPatchString();
  check(out.contains("😀"), "tui/screen/render-unicode-emoji");
}

