mod std_test;

use std;

fn input_reads_stdin_bytes() {
  let buffer: byte[!] = byte[:5];
  let readCount = input(buffer);

  check(readCount == (long)5, "io/input-count");
  check(buffer[0] == (byte)65, "io/input-byte-0");
  check(buffer[1] == (byte)66, "io/input-byte-1");
  check(buffer[2] == (byte)67, "io/input-byte-2");
  check(buffer[3] == (byte)68, "io/input-byte-3");
  check(buffer[4] == (byte)69, "io/input-byte-4");
}

fn output_writes_stdout() {
  let marker = "__STD_IO_OUTPUT__\n";
  let written = output(marker);

  check(written == marker.length(), "io/output-return");
}

fn print_writes_stdout_with_newline() {
  let marker = "__STD_IO_PRINT__";
  let written = print(marker);

  check(written == marker.length() + (long)1, "io/print-return");
}

pu fn run_io_tests() {
  input_reads_stdin_bytes();
  output_writes_stdout();
  print_writes_stdout_with_newline();
}