module std_test;

import std.test;

import std;
import std.io;
import std.text;

func readLine_reads_one_line_per_call() {
  let first = readLine();
  let second = readLine();
  let third = readLine();

  check(first.length() == (long)5, "io/readLine-first-line-length");
  check(second.length() == (long)2, "io/readLine-second-line-length");
  check(third.length() == (long)0, "io/readLine-eof-empty-length");

  writeLine("__STD_IO_READLINE1__=" + first);
  writeLine("__STD_IO_READLINE2__=" + second);
  writeLine("__STD_IO_READLINE3__=" + third);
}

func writeLine_writes_stdout_with_newline() {
  let marker = "__STD_IO_WRITELINE__";
  let written = writeLine(marker);

  check(written == marker.length() + (long)1, "io/writeLine-return");
}

func format_returns_text() {
  let rendered = string.format("__STD_IO_FORMAT__ {0}/{1}", "left", "right");
  let literal = string.format("__STD_IO_FORMAT_LITERAL__ {2}", "left", "right");

  check(rendered.length() == "__STD_IO_FORMAT__ left/right".length(), "io/format-return");
  check(literal.length() == "__STD_IO_FORMAT_LITERAL__ {2}".length(), "io/format-literal-return");

  writeLine(rendered);
  writeLine(literal);
}

func print_writes_stdout_without_newline() {
  let marker = "__STD_IO_PRINT__\n";
  let written = print(marker);

  check(written == marker.length(), "io/print-return");
}

func println_writes_stdout_with_newline() {
  let marker = "__STD_IO_PRINTLN__";
  let written = println(marker);

  check(written == marker.length() + (long)1, "io/println-return");
}

open func run_io_tests() {
  describe("io tests", () {
    test("readLine_reads_one_line_per_call()", () { readLine_reads_one_line_per_call(); });
    test("writeLine_writes_stdout_with_newline()", () { writeLine_writes_stdout_with_newline(); });
    test("format_returns_text()", () { format_returns_text(); });
    test("print_writes_stdout_without_newline()", () { print_writes_stdout_without_newline(); });
    test("println_writes_stdout_with_newline()", () { println_writes_stdout_with_newline(); });
  });
}