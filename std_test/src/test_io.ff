mod std_test;

use std;

fn readLine_reads_one_line_per_call() {
  let first = readLine();
  let second = readLine();
  let third = readLine();

  check(first.length() == (long)5, "io/readLine-first-line-length");
  check(second.length() == (long)2, "io/readLine-second-line-length");
  check(third.length() == (long)0, "io/readLine-eof-empty-length");

  writeLine("__STD_IO_READLINE1__=" + first);
  writeLine("__STD_IO_READLINE2__=" + second);
  writeLine("__STD_IO_READLINE3__=" + third);
}

fn writeLine_writes_stdout_with_newline() {
  let marker = "__STD_IO_WRITELINE__";
  let written = writeLine(marker);

  check(written == marker.length() + (long)1, "io/writeLine-return");
}

fn print_writes_stdout_without_newline() {
  let marker = "__STD_IO_PRINT__\n";
  let written = print(marker);

  check(written == marker.length(), "io/print-return");
}

pu fn run_io_tests() {
  readLine_reads_one_line_per_call();
  writeLine_writes_stdout_with_newline();
  print_writes_stdout_without_newline();
}