mod std_test;

use std;

fn input_reads_one_line_per_call() {
  let first = input();
  let second = input();
  let third = input();

  check(first.length() == (long)5, "io/input-first-line-length");
  check(second.length() == (long)2, "io/input-second-line-length");
  check(third.length() == (long)0, "io/input-eof-empty-length");

  print("__STD_IO_INPUT1__={0}", first);
  print("__STD_IO_INPUT2__={0}", second);
  print("__STD_IO_INPUT3__={0}", third);
}

fn print_writes_stdout_with_newline() {
  let marker = "__STD_IO_PRINT__";
  let written = print(marker);

  check(written == marker.length() + (long)1, "io/print-return");
}

pu fn run_io_tests() {
  input_reads_one_line_per_call();
  print_writes_stdout_with_newline();
}