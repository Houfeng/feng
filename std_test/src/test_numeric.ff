/* ---------- runner ---------- */

open func run_numeric_tests() {
  f64_parse_tests();
  f64_parse_error_tests();
  f32_parse_tests();
  f32_parse_error_tests();
  i8_parse_tests();
  i8_parse_error_tests();
  i16_parse_tests();
  i16_parse_error_tests();
  i32_parse_tests();
  i32_parse_error_tests();
  i64_parse_tests();
  i64_parse_error_tests();
  u8_parse_tests();
  u8_parse_error_tests();
  u16_parse_tests();
  u16_parse_error_tests();
  u32_parse_tests();
  u32_parse_error_tests();
  u64_parse_tests();
  u64_parse_error_tests();
}
