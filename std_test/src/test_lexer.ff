}

func lexer_string_empty() {
  let tokens = collectNonTrivia("\"\"");
  check(tokens[0].kind == FengTokenKind.LiteralString, "lexer/string-empty-kind");
  check(tokens[0].value.toString() == "\"\"", "lexer/string-empty-value");
  writeLine("__LEXER_STRING_EMPTY__=ok");
}

func lexer_string_escapes() {
  let tokens = collectNonTrivia("\"a\\nb\\tc\\\\d\\\"e\\0f\\x41\"");
