// ==================== 运算符 ====================

func lexer_operators_arithmetic() {
  let tokens = collectNonTrivia("+ - * / %");
  check(tokens[0].kind == FengTokenKind.OperatorPlus, "lexer/op-plus");
  check(tokens[1].kind == FengTokenKind.OperatorMinus, "lexer/op-minus");
  check(tokens[2].kind == FengTokenKind.OperatorStar, "lexer/op-star");
  check(tokens[3].kind == FengTokenKind.OperatorSlash, "lexer/op-slash");
  check(tokens[4].kind == FengTokenKind.OperatorPercent, "lexer/op-percent");
  writeLine("__LEXER_OPERATORS_ARITHMETIC__=ok");
}

func lexer_operators_comparison() {
  let tokens = collectNonTrivia("< <= > >= == !=");
  check(tokens[0].kind == FengTokenKind.OperatorLess, "lexer/op-lt");
  check(tokens[1].kind == FengTokenKind.OperatorLessEqual, "lexer/op-le");
  check(tokens[2].kind == FengTokenKind.OperatorGreater, "lexer/op-gt");
  check(tokens[3].kind == FengTokenKind.OperatorGreaterEqual, "lexer/op-ge");
  check(tokens[4].kind == FengTokenKind.OperatorEqual, "lexer/op-eq");
  check(tokens[5].kind == FengTokenKind.OperatorNotEqual, "lexer/op-ne");
  writeLine("__LEXER_OPERATORS_COMPARISON__=ok");
}

func lexer_operators_logical() {
  let tokens = collectNonTrivia("! && ||");
  check(tokens[0].kind == FengTokenKind.OperatorNot, "lexer/op-not");
  check(tokens[1].kind == FengTokenKind.OperatorLogicalAnd, "lexer/op-and");
  check(tokens[2].kind == FengTokenKind.OperatorLogicalOr, "lexer/op-or");
  writeLine("__LEXER_OPERATORS_LOGICAL__=ok");
}

func lexer_operators_bitwise() {
  let tokens = collectNonTrivia("& | ^ ~ << >>");
  check(tokens[0].kind == FengTokenKind.OperatorBitwiseAnd, "lexer/op-bitand");
  check(tokens[1].kind == FengTokenKind.OperatorBitwiseOr, "lexer/op-bitor");
  check(tokens[2].kind == FengTokenKind.OperatorBitwiseXor, "lexer/op-bitxor");
  check(tokens[3].kind == FengTokenKind.OperatorBitwiseNot, "lexer/op-bitnot");
  check(tokens[4].kind == FengTokenKind.OperatorShiftLeft, "lexer/op-shl");
  check(tokens[5].kind == FengTokenKind.OperatorShiftRight, "lexer/op-shr");
  writeLine("__LEXER_OPERATORS_BITWISE__=ok");
}

func lexer_operators_assignment() {
  let tokens = collectNonTrivia("= += -= *= /= %=");
  check(tokens[0].kind == FengTokenKind.OperatorAssign, "lexer/op-assign");
  check(tokens[1].kind == FengTokenKind.OperatorPlusAssign, "lexer/op-add-assign");
  check(tokens[2].kind == FengTokenKind.OperatorMinusAssign, "lexer/op-sub-assign");
  check(tokens[3].kind == FengTokenKind.OperatorStarAssign, "lexer/op-mul-assign");
  check(tokens[4].kind == FengTokenKind.OperatorSlashAssign, "lexer/op-div-assign");
  check(tokens[5].kind == FengTokenKind.OperatorPercentAssign, "lexer/op-mod-assign");
  writeLine("__LEXER_OPERATORS_ASSIGNMENT__=ok");
}

func lexer_operators_bitwise_assignment() {
  let tokens = collectNonTrivia("&= |= ^= <<= >>=");
  check(tokens[0].kind == FengTokenKind.OperatorBitwiseAndAssign, "lexer/op-bitand-assign");
  check(tokens[1].kind == FengTokenKind.OperatorBitwiseOrAssign, "lexer/op-bitor-assign");
  check(tokens[2].kind == FengTokenKind.OperatorBitwiseXorAssign, "lexer/op-bitxor-assign");
  check(tokens[3].kind == FengTokenKind.OperatorShiftLeftAssign, "lexer/op-shl-assign");
  check(tokens[4].kind == FengTokenKind.OperatorShiftRightAssign, "lexer/op-shr-assign");
  writeLine("__LEXER_OPERATORS_BITWISE_ASSIGNMENT__=ok");
}

func lexer_operators_other() {
  let tokens = collectNonTrivia("-> @");
  check(tokens[0].kind == FengTokenKind.OperatorArrow, "lexer/op-arrow");
  check(tokens[0].value.toString() == "->", "lexer/op-arrow-value");
  check(tokens[1].kind == FengTokenKind.OperatorAt, "lexer/op-at");
  writeLine("__LEXER_OPERATORS_OTHER__=ok");
}

// ==================== 分隔符 ====================

func lexer_punctuation() {
  let tokens = collectNonTrivia("( ) { } [ ] , : ; .");
  check(tokens[0].kind == FengTokenKind.PunctuationLeftParen, "lexer/punc-lparen");
  check(tokens[1].kind == FengTokenKind.PunctuationRightParen, "lexer/punc-rparen");
  check(tokens[2].kind == FengTokenKind.PunctuationLeftBrace, "lexer/punc-lbrace");
  check(tokens[3].kind == FengTokenKind.PunctuationRightBrace, "lexer/punc-rbrace");
  check(tokens[4].kind == FengTokenKind.PunctuationLeftBracket, "lexer/punc-lbracket");
  check(tokens[5].kind == FengTokenKind.PunctuationRightBracket, "lexer/punc-rbracket");
  check(tokens[6].kind == FengTokenKind.PunctuationComma, "lexer/punc-comma");
  check(tokens[7].kind == FengTokenKind.PunctuationColon, "lexer/punc-colon");
  check(tokens[8].kind == FengTokenKind.PunctuationSemicolon, "lexer/punc-semicolon");
  check(tokens[9].kind == FengTokenKind.PunctuationDot, "lexer/punc-dot");
  writeLine("__LEXER_PUNCTUATION__=ok");
}

func lexer_punctuation_ellipsis() {
  let tokens = collectNonTrivia("...");
  check(tokens[0].kind == FengTokenKind.PunctuationEllipsis, "lexer/punc-ellipsis-kind");
  check(tokens[0].value.toString() == "...", "lexer/punc-ellipsis-value");
  writeLine("__LEXER_PUNCTUATION_ELLIPSIS__=ok");
}

// ==================== 空白 ====================

func lexer_whitespace_space() {
  var lexer = makeLexer("  \t ");
  let token = lexer.next();
  check(token.kind == FengTokenKind.WhitespaceSpace, "lexer/ws-space-kind");
  check(token.value.length() == (int)4, "lexer/ws-space-length");
  writeLine("__LEXER_WHITESPACE_SPACE__=ok");
}

func lexer_whitespace_newline() {
  var lexer = makeLexer("\n");
  let token = lexer.next();
  check(token.kind == FengTokenKind.WhitespaceNewline, "lexer/ws-newline-kind");
  writeLine("__LEXER_WHITESPACE_NEWLINE__=ok");
}

// ==================== 注释 ====================

func lexer_comment_line() {
  var lexer = makeLexer("// this is a comment");
  let token = lexer.next();
  check(token.kind == FengTokenKind.CommentLine, "lexer/comment-line-kind");
  check(token.value.toString() == "// this is a comment", "lexer/comment-line-value");
  writeLine("__LEXER_COMMENT_LINE__=ok");
}

func lexer_comment_line_stops_at_newline() {
  var lexer = makeLexer("// comment\ncode");
  let t1 = lexer.next();
  check(t1.kind == FengTokenKind.CommentLine, "lexer/comment-line-stops-kind");
  check(t1.value.toString() == "// comment", "lexer/comment-line-stops-value");
  let t2 = lexer.next();
  check(t2.kind == FengTokenKind.WhitespaceNewline, "lexer/comment-line-newline");
  writeLine("__LEXER_COMMENT_LINE_STOPS_AT_NEWLINE__=ok");
}

func lexer_comment_block() {
  var lexer = makeLexer("/* block comment */");
  let token = lexer.next();
  check(token.kind == FengTokenKind.CommentBlock, "lexer/comment-block-kind");
  check(token.value.toString() == "/* block comment */", "lexer/comment-block-value");
  writeLine("__LEXER_COMMENT_BLOCK__=ok");
}

func lexer_comment_doc() {
  var lexer = makeLexer("/** doc comment */");
  let token = lexer.next();
  check(token.kind == FengTokenKind.CommentDoc, "lexer/comment-doc-kind");
  check(token.value.toString() == "/** doc comment */", "lexer/comment-doc-value");
  writeLine("__LEXER_COMMENT_DOC__=ok");
}

// ==================== 位置追踪 ====================

func lexer_location_first_token() {
  var lexer = makeLexer("abc");
  let token = lexer.next();
  check(token.location.offset == (int)0, "lexer/loc-first-offset");
  check(token.location.line == (int)1, "lexer/loc-first-line");
  check(token.location.column == (int)1, "lexer/loc-first-column");
  writeLine("__LEXER_LOCATION_FIRST_TOKEN__=ok");
}

func lexer_location_after_whitespace() {
  var lexer = makeLexer("  abc");
  let _ = lexer.next();
  let token = lexer.next();
  check(token.location.offset == (int)2, "lexer/loc-after-ws-offset");
  check(token.location.line == (int)1, "lexer/loc-after-ws-line");
  check(token.location.column == (int)3, "lexer/loc-after-ws-column");
  writeLine("__LEXER_LOCATION_AFTER_WHITESPACE__=ok");
}

func lexer_location_after_newline() {
  var lexer = makeLexer("a\nb");
  let _ = lexer.next();
  let _ = lexer.next();
  let token = lexer.next();
  check(token.kind == FengTokenKind.Identifier, "lexer/loc-newline-kind");
  check(token.value.toString() == "b", "lexer/loc-newline-value");
  check(token.location.line == (int)2, "lexer/loc-newline-line");
  check(token.location.column == (int)1, "lexer/loc-newline-column");
  writeLine("__LEXER_LOCATION_AFTER_NEWLINE__=ok");
}

func lexer_location_multi_line() {
  var lexer = makeLexer("x\n  y\n    z");
  let tokens = lexer.tokenize();
  var zLine: int = 0;
  var zCol: int = 0;
  for let t in tokens {
    if t.kind == FengTokenKind.Identifier && t.value.toString() == "z" {
      zLine = t.location.line;
      zCol = t.location.column;
    }
  }
  check(zLine == (int)3, "lexer/loc-multi-line");
  check(zCol == (int)5, "lexer/loc-multi-column");
  writeLine("__LEXER_LOCATION_MULTI_LINE__=ok");
}

// ==================== peek 行为 ====================

func lexer_peek_does_not_consume() {
  var lexer = makeLexer("abc");
  let p1 = lexer.peek();
  let p2 = lexer.peek();
  check(p1.kind == p2.kind, "lexer/peek-same-kind");
  check(p1.value.toString() == p2.value.toString(), "lexer/peek-same-value");
  let n = lexer.next();
  check(n.kind == FengTokenKind.Identifier, "lexer/peek-then-next-kind");
  check(n.value.toString() == "abc", "lexer/peek-then-next-value");
  writeLine("__LEXER_PEEK_DOES_NOT_CONSUME__=ok");
}

func lexer_peek_then_next_returns_same() {
  var lexer = makeLexer("42 + 7");
  let peeked = lexer.peek();
  let consumed = lexer.next();
  check(peeked.kind == consumed.kind, "lexer/peek-next-same-kind");
  check(peeked.value.toString() == consumed.value.toString(), "lexer/peek-next-same-value");
  check(peeked.location.offset == consumed.location.offset, "lexer/peek-next-same-offset");
  writeLine("__LEXER_PEEK_THEN_NEXT_RETURNS_SAME__=ok");
}

// ==================== tokenize ====================

func lexer_tokenize_full() {
  var lexer = makeLexer("let x = 42;");
  let tokens = lexer.tokenize();
  check(tokens.length() >= (int)6, "lexer/tokenize-count");
  let last = tokens[tokens.length() - 1];
  check(last.kind == FengTokenKind.SpecialEndOfFile, "lexer/tokenize-ends-eof");
  writeLine("__LEXER_TOKENIZE_FULL__=ok");
}

func lexer_tokenize_complex() {
  var lexer = makeLexer("func add(a: int, b: int): int { return a + b; }");
  let tokens = lexer.tokenize();
  var nonTriviaCount: int = 0;
  for let t in tokens {
    if !FengTokenUtil.isTrivia(t.kind) {
      nonTriviaCount = nonTriviaCount + 1;
    }
  }
  check(nonTriviaCount == (int)20, "lexer/tokenize-complex-count");
  writeLine("__LEXER_TOKENIZE_COMPLEX__=ok");
}

// ==================== FengTokenUtil 分类 ====================

func lexer_token_util_is_trivia() {
  check(FengTokenUtil.isTrivia(FengTokenKind.SpecialEndOfFile) == true, "lexer/util-trivia-eof");
  check(FengTokenUtil.isTrivia(FengTokenKind.WhitespaceSpace) == true, "lexer/util-trivia-space");
  check(FengTokenUtil.isTrivia(FengTokenKind.CommentLine) == true, "lexer/util-trivia-comment");
  check(FengTokenUtil.isTrivia(FengTokenKind.Identifier) == false, "lexer/util-not-trivia-ident");
  writeLine("__LEXER_TOKEN_UTIL_IS_TRIVIA__=ok");
}

func lexer_token_util_is_keyword() {
  check(FengTokenUtil.isKeyword(FengTokenKind.KeywordFunc) == true, "lexer/util-kw-func");
  check(FengTokenUtil.isKeyword(FengTokenKind.KeywordReturn) == true, "lexer/util-kw-return");
  check(FengTokenUtil.isKeyword(FengTokenKind.Identifier) == false, "lexer/util-not-kw-ident");
  check(FengTokenUtil.isKeyword(FengTokenKind.LiteralInteger) == false, "lexer/util-not-kw-int");
  writeLine("__LEXER_TOKEN_UTIL_IS_KEYWORD__=ok");
}

func lexer_token_util_is_literal() {
  check(FengTokenUtil.isLiteral(FengTokenKind.LiteralInteger) == true, "lexer/util-lit-int");
  check(FengTokenUtil.isLiteral(FengTokenKind.LiteralString) == true, "lexer/util-lit-string");
  check(FengTokenUtil.isLiteral(FengTokenKind.LiteralBool) == true, "lexer/util-lit-bool");
  check(FengTokenUtil.isLiteral(FengTokenKind.Identifier) == false, "lexer/util-not-lit-ident");
  writeLine("__LEXER_TOKEN_UTIL_IS_LITERAL__=ok");
}

func lexer_token_util_is_identifier() {
  check(FengTokenUtil.isIdentifier(FengTokenKind.Identifier) == true, "lexer/util-ident");
  check(FengTokenUtil.isIdentifier(FengTokenKind.KeywordFunc) == false, "lexer/util-not-ident-kw");
  writeLine("__LEXER_TOKEN_UTIL_IS_IDENTIFIER__=ok");
}

func lexer_token_util_is_punctuation() {
  check(FengTokenUtil.isPunctuation(FengTokenKind.PunctuationLeftParen) == true, "lexer/util-punc");
  check(FengTokenUtil.isPunctuation(FengTokenKind.PunctuationEllipsis) == true, "lexer/util-punc-ellipsis");
  check(FengTokenUtil.isPunctuation(FengTokenKind.OperatorPlus) == false, "lexer/util-not-punc-op");
  writeLine("__LEXER_TOKEN_UTIL_IS_PUNCTUATION__=ok");
}

func lexer_token_util_is_operator() {
  check(FengTokenUtil.isOperator(FengTokenKind.OperatorPlus) == true, "lexer/util-op-plus");
  check(FengTokenUtil.isOperator(FengTokenKind.OperatorArrow) == true, "lexer/util-op-arrow");
  check(FengTokenUtil.isOperator(FengTokenKind.PunctuationDot) == false, "lexer/util-not-op-punc");
  writeLine("__LEXER_TOKEN_UTIL_IS_OPERATOR__=ok");
}

func lexer_token_util_is_whitespace() {
  check(FengTokenUtil.isWhitespace(FengTokenKind.WhitespaceSpace) == true, "lexer/util-ws-space");
  check(FengTokenUtil.isWhitespace(FengTokenKind.WhitespaceNewline) == true, "lexer/util-ws-newline");
  check(FengTokenUtil.isWhitespace(FengTokenKind.CommentLine) == false, "lexer/util-not-ws-comment");
  writeLine("__LEXER_TOKEN_UTIL_IS_WHITESPACE__=ok");
}

func lexer_token_util_is_comment() {
  check(FengTokenUtil.isComment(FengTokenKind.CommentLine) == true, "lexer/util-comment-line");
  check(FengTokenUtil.isComment(FengTokenKind.CommentBlock) == true, "lexer/util-comment-block");
  check(FengTokenUtil.isComment(FengTokenKind.CommentDoc) == true, "lexer/util-comment-doc");
  check(FengTokenUtil.isComment(FengTokenKind.WhitespaceSpace) == false, "lexer/util-not-comment-ws");
  writeLine("__LEXER_TOKEN_UTIL_IS_COMMENT__=ok");
}

func lexer_token_util_kind_name() {
  check(FengTokenUtil.kindName(FengTokenKind.KeywordFunc) == "KeywordFunc", "lexer/util-name-kw-func");
  check(FengTokenUtil.kindName(FengTokenKind.OperatorPlus) == "OperatorPlus", "lexer/util-name-op-plus");
  check(FengTokenUtil.kindName(FengTokenKind.SpecialEndOfFile) == "SpecialEndOfFile", "lexer/util-name-eof");
  check(FengTokenUtil.kindName(FengTokenKind.Identifier) == "Identifier", "lexer/util-name-ident");
  writeLine("__LEXER_TOKEN_UTIL_KIND_NAME__=ok");
}

// ==================== 错误情况 ====================

func lexer_error_unterminated_string() {
  var lexer = makeLexer("\"hello");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-unterm-string-caught");
  check(errCode == "LE0003", "lexer/err-unterm-string-code");
  writeLine("__LEXER_ERROR_UNTERMINATED_STRING__=ok");
}

func lexer_error_unterminated_block_comment() {
  var lexer = makeLexer("/* no end");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-unterm-block-caught");
  check(errCode == "LE0006", "lexer/err-unterm-block-code");
  writeLine("__LEXER_ERROR_UNTERMINATED_BLOCK_COMMENT__=ok");
}

func lexer_error_invalid_escape() {
  var lexer = makeLexer("\"\\q\"");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-invalid-escape-caught");
  check(errCode == "LE0004", "lexer/err-invalid-escape-code");
  writeLine("__LEXER_ERROR_INVALID_ESCAPE__=ok");
}

func lexer_error_reserved_word() {
  var lexer = makeLexer("class");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-reserved-caught");
  check(errCode == "LE0001", "lexer/err-reserved-code");
  writeLine("__LEXER_ERROR_RESERVED_WORD__=ok");
}

func lexer_error_unexpected_character() {
  var lexer = makeLexer("#");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-unexpected-caught");
  check(errCode == "LE0007", "lexer/err-unexpected-code");
  writeLine("__LEXER_ERROR_UNEXPECTED_CHARACTER__=ok");
}

func lexer_error_invalid_number() {
  var lexer = makeLexer("0xGG");
  var caught = false;
  var errCode = "";
  try lexer.next() catch err: FengCompileError {
    caught = true;
    errCode = err.code;
  };
  check(caught, "lexer/err-invalid-num-caught");
  check(errCode == "LE0002", "lexer/err-invalid-num-code");
  writeLine("__LEXER_ERROR_INVALID_NUMBER__=ok");
}

// ==================== 组合场景 ====================

func lexer_mixed_tokens() {
  let tokens = collectNonTrivia("if x >= 10 { return true; }");
  check(tokens[0].kind == FengTokenKind.KeywordIf, "lexer/mixed-if");
  check(tokens[1].kind == FengTokenKind.Identifier, "lexer/mixed-ident");
  check(tokens[1].value.toString() == "x", "lexer/mixed-ident-val");
  check(tokens[2].kind == FengTokenKind.OperatorGreaterEqual, "lexer/mixed-ge");
  check(tokens[3].kind == FengTokenKind.LiteralInteger, "lexer/mixed-int");
  check(tokens[3].value.toString() == "10", "lexer/mixed-int-val");
  check(tokens[4].kind == FengTokenKind.PunctuationLeftBrace, "lexer/mixed-lbrace");
  check(tokens[5].kind == FengTokenKind.KeywordReturn, "lexer/mixed-return");
  check(tokens[6].kind == FengTokenKind.LiteralBool, "lexer/mixed-bool");
  check(tokens[7].kind == FengTokenKind.PunctuationSemicolon, "lexer/mixed-semicolon");
  check(tokens[8].kind == FengTokenKind.PunctuationRightBrace, "lexer/mixed-rbrace");
  writeLine("__LEXER_MIXED_TOKENS__=ok");
}

func lexer_dot_vs_decimal() {
  let tokens = collectNonTrivia("obj.field 3.14");
  check(tokens[0].kind == FengTokenKind.Identifier, "lexer/dot-dec-ident");
  check(tokens[1].kind == FengTokenKind.PunctuationDot, "lexer/dot-dec-dot");
  check(tokens[2].kind == FengTokenKind.Identifier, "lexer/dot-dec-field");
  check(tokens[3].kind == FengTokenKind.LiteralFloat, "lexer/dot-dec-float");
  check(tokens[3].value.toString() == "3.14", "lexer/dot-dec-float-val");
  writeLine("__LEXER_DOT_VS_DECIMAL__=ok");
}

func lexer_minus_vs_arrow() {
  let tokens = collectNonTrivia("a - b -> c");
  check(tokens[0].kind == FengTokenKind.Identifier, "lexer/minus-arrow-ident1");
  check(tokens[1].kind == FengTokenKind.OperatorMinus, "lexer/minus-arrow-minus");
  check(tokens[2].kind == FengTokenKind.Identifier, "lexer/minus-arrow-ident2");
  check(tokens[3].kind == FengTokenKind.OperatorArrow, "lexer/minus-arrow-arrow");
  check(tokens[4].kind == FengTokenKind.Identifier, "lexer/minus-arrow-ident3");
  writeLine("__LEXER_MINUS_VS_ARROW__=ok");
}

// ==================== FengTokenTransformer ====================

func transformer_constructor() {
  var lexer = makeLexer("let x = 1;");
  let tokens = lexer.tokenize();
  var transformer = FengTokenTransformer(tokens);
  check(transformer.length() == tokens.length(), "transformer/constructor-length");
  writeLine("__TRANSFORMER_CONSTRUCTOR__=ok");
}

func transformer_from_lexer() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  check(transformer.length() > (int)0, "transformer/from-lexer-length");
  check(transformer.at(0).kind == FengTokenKind.KeywordLet, "transformer/from-lexer-first");
  writeLine("__TRANSFORMER_FROM_LEXER__=ok");
}

func transformer_length() {
  var lexer = makeLexer("a b c");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  // 3 identifiers + 2 spaces + 1 EOF = 6
  check(transformer.length() == (int)6, "transformer/length-count");
  writeLine("__TRANSFORMER_LENGTH__=ok");
}

func transformer_at() {
  var lexer = makeLexer("func foo() {}");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  check(transformer.at(0).kind == FengTokenKind.KeywordFunc, "transformer/at-0");
  check(transformer.at(1).kind == FengTokenKind.WhitespaceSpace, "transformer/at-1");
  check(transformer.at(2).kind == FengTokenKind.Identifier, "transformer/at-2");
  check(transformer.at(2).value.toString() == "foo", "transformer/at-2-val");
  writeLine("__TRANSFORMER_AT__=ok");
}

func transformer_slice() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let span = transformer.slice(0, 3);
  check(span.length() == (int)3, "transformer/slice-length");
  check(span.at(0).kind == FengTokenKind.KeywordLet, "transformer/slice-0");
  check(span.at(1).kind == FengTokenKind.WhitespaceSpace, "transformer/slice-1");
  check(span.at(2).kind == FengTokenKind.Identifier, "transformer/slice-2");
  writeLine("__TRANSFORMER_SLICE__=ok");
}

func transformer_slice_empty() {
  var lexer = makeLexer("x");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let span = transformer.slice(0, 0);
  check(span.length() == (int)0, "transformer/slice-empty-length");
  writeLine("__TRANSFORMER_SLICE_EMPTY__=ok");
}

func transformer_replace_same_length() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let originalLength = transformer.length();

  // Replace identifier "x" with identifier "y" by creating a new token
  let oldToken = transformer.at(2);  // identifier token
  let source = FengSource("y", "test.ff");
  var newToken = FengToken {
    kind: FengTokenKind.Identifier,
    value: source.slice(0, 1),
    location: oldToken.location
  };

  let replacement = [newToken];
  transformer.replace(2, 3, replacement);

  check(transformer.length() == originalLength, "transformer/replace-same-length");
  check(transformer.at(2).value.toString() == "y", "transformer/replace-same-value");
  writeLine("__TRANSFORMER_REPLACE_SAME_LENGTH__=ok");
}

func transformer_replace_longer() {
  var lexer = makeLexer("x");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let originalLength = transformer.length();

  // Replace single identifier with two tokens
  var lexer2 = makeLexer("a b");
  let tokens2 = lexer2.tokenize();
  let replacement = [tokens2[0], tokens2[1], tokens2[2]];  // "a", " ", "b"

  transformer.replace(0, 1, replacement);

  check(transformer.length() == originalLength + (int)2, "transformer/replace-longer-length");
  check(transformer.at(0).value.toString() == "a", "transformer/replace-longer-0");
  check(transformer.at(1).kind == FengTokenKind.WhitespaceSpace, "transformer/replace-longer-1");
  check(transformer.at(2).value.toString() == "b", "transformer/replace-longer-2");
  writeLine("__TRANSFORMER_REPLACE_LONGER__=ok");
}

func transformer_replace_shorter() {
  var lexer = makeLexer("a b c");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let originalLength = transformer.length();

  // Replace "a b c" (3 identifiers + 2 spaces) with single identifier
  var lexer2 = makeLexer("x");
  let tokens2 = lexer2.tokenize();
  let replacement = [tokens2[0]];  // just "x"

  transformer.replace(0, 5, replacement);

  check(transformer.length() == originalLength - (int)4, "transformer/replace-shorter-length");
  check(transformer.at(0).value.toString() == "x", "transformer/replace-shorter-0");
  writeLine("__TRANSFORMER_REPLACE_SHORTER__=ok");
}

func transformer_replace_empty() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let originalLength = transformer.length();

  // Delete the identifier (replace with empty array)
  transformer.replace(2, 3, []);

  check(transformer.length() == originalLength - (int)1, "transformer/replace-empty-length");
  // After deletion, position 2 should be the space before "="
  check(transformer.at(2).kind == FengTokenKind.WhitespaceSpace, "transformer/replace-empty-shift");
  writeLine("__TRANSFORMER_REPLACE_EMPTY__=ok");
}

func transformer_find_declaration_end_with_braces() {
  var lexer = makeLexer("func foo() { return 1; }");
  var transformer = FengTokenTransformer.fromLexer(lexer);

  let end = transformer.findDeclarationEnd(0);
  // Should find the closing brace
  check(end > (int)0, "transformer/find-decl-end-braces-found");
  check(transformer.at(end - 1).kind == FengTokenKind.PunctuationRightBrace,
        "transformer/find-decl-end-braces-rbrace");
  writeLine("__TRANSFORMER_FIND_DECLARATION_END_WITH_BRACES__=ok");
}

func transformer_find_declaration_end_nested_braces() {
  var lexer = makeLexer("func foo() { if x { return 1; } else { return 2; } }");
  var transformer = FengTokenTransformer.fromLexer(lexer);

  let end = transformer.findDeclarationEnd(0);
  // Should find the outermost closing brace
  check(end > (int)0, "transformer/find-decl-end-nested-found");
  check(transformer.at(end - 1).kind == FengTokenKind.PunctuationRightBrace,
        "transformer/find-decl-end-nested-rbrace");
  writeLine("__TRANSFORMER_FIND_DECLARATION_END_NESTED_BRACES__=ok");
}

func transformer_find_declaration_end_semicolon() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);

  let end = transformer.findDeclarationEnd(0);
  // Should find the semicolon
  check(end > (int)0, "transformer/find-decl-end-semi-found");
  check(transformer.at(end - 1).kind == FengTokenKind.PunctuationSemicolon,
        "transformer/find-decl-end-semi-semicolon");
  writeLine("__TRANSFORMER_FIND_DECLARATION_END_SEMICOLON__=ok");
}

func transformer_find_declaration_end_with_string() {
  var lexer = makeLexer("func foo() { let s = \"{}\"; }");
  var transformer = FengTokenTransformer.fromLexer(lexer);

  let end = transformer.findDeclarationEnd(0);
  // Should ignore braces inside string literal
  check(end > (int)0, "transformer/find-decl-end-string-found");
  check(transformer.at(end - 1).kind == FengTokenKind.PunctuationRightBrace,
        "transformer/find-decl-end-string-rbrace");
  writeLine("__TRANSFORMER_FIND_DECLARATION_END_WITH_STRING__=ok");
}

func token_span_length() {
  var lexer = makeLexer("a b c d");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let span = transformer.slice(0, 5);
  check(span.length() == (int)5, "token-span/length");
  writeLine("__TOKEN_SPAN_LENGTH__=ok");
}

func token_span_at() {
  var lexer = makeLexer("let x = 1;");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let span = transformer.slice(2, 5);  // "x", " ", "="
  check(span.at(0).kind == FengTokenKind.Identifier, "token-span/at-0");
  check(span.at(0).value.toString() == "x", "token-span/at-0-val");
  check(span.at(1).kind == FengTokenKind.WhitespaceSpace, "token-span/at-1");
  check(span.at(2).kind == FengTokenKind.OperatorAssign, "token-span/at-2");
  writeLine("__TOKEN_SPAN_AT__=ok");
}

func token_span_to_array() {
  var lexer = makeLexer("a b c");
  var transformer = FengTokenTransformer.fromLexer(lexer);
  let span = transformer.slice(0, 3);  // "a", " ", "b"
  let arr = span.toArray();
  check(arr.length() == (int)3, "token-span/to-array-length");
  check(arr[0].value.toString() == "a", "token-span/to-array-0");
  check(arr[1].kind == FengTokenKind.WhitespaceSpace, "token-span/to-array-1");
  check(arr[2].value.toString() == "b", "token-span/to-array-2");
  writeLine("__TOKEN_SPAN_TO_ARRAY__=ok");
}

