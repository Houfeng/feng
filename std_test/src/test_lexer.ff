module std_test;

import std.test;
import std.compiler.lexer;
import std.compiler.common;
import std.text;
import std.collections;
import std.io;

// ==================== 辅助函数 ====================

func makeLexer(content: string): FengLexer {
  let source = FengSource(content, "test.ff");
  return FengLexer(source);
}

func collectNonTrivia(content: string): FengToken[] {
  var lexer = makeLexer(content);
  let tokens = lexer.tokenize();
  let result = List<FengToken>();
  for let t in tokens {
    if !FengTokenUtil.isTrivia(t.kind) {
      result.add(t);
    }
  }
  return result.entries();
}

func kindName(kind: FengTokenKind): string {
  return FengTokenUtil.kindName(kind);
}

// ==================== 空输入 ====================

func lexer_empty_source() {
  var lexer = makeLexer("");
  let token = lexer.next();
  check(token.kind == FengTokenKind.SpecialEndOfFile, "lexer/empty-eof");
  check(token.value.length() == (int)0, "lexer/empty-eof-length");
  writeLine("__LEXER_EMPTY_SOURCE__=ok");
}

// ==================== 标识符 ====================

func lexer_identifier_simple() {
  let tokens = collectNonTrivia("foo");
  check(tokens.length() == (int)1, "lexer/ident-simple-count");
  check(tokens[0].kind == FengTokenKind.Identifier, "lexer/ident-simple-kind");
  check(tokens[0].value.toString() == "foo", "lexer/ident-simple-value");
  writeLine("__LEXER_IDENTIFIER_SIMPLE__=ok");
}

func lexer_identifier_with_digits() {
  let tokens = collectNonTrivia("x1_abc_2");
  check(tokens[0].kind == FengTokenKind.Identifier, "lexer/ident-digits-kind");
  check(tokens[0].value.toString() == "x1_abc_2", "lexer/ident-digits-value");
  writeLine("__LEXER_IDENTIFIER_WITH_DIGITS__=ok");
}

func lexer_identifier_underscore() {
  let tokens = collectNonTrivia("_private");
  check(tokens[0].kind == FengTokenKind.Identifier, "lexer/ident-underscore-kind");
  check(tokens[0].value.toString() == "_private", "lexer/ident-underscore-value");
  writeLine("__LEXER_IDENTIFIER_UNDERSCORE__=ok");
}

// ==================== 关键字 ====================

func lexer_keywords_basic() {
  let tokens = collectNonTrivia("type enum spec fit extern func let var");
  check(tokens[0].kind == FengTokenKind.KeywordType, "lexer/kw-type");
  check(tokens[1].kind == FengTokenKind.KeywordEnum, "lexer/kw-enum");
  check(tokens[2].kind == FengTokenKind.KeywordSpec, "lexer/kw-spec");
  check(tokens[3].kind == FengTokenKind.KeywordFit, "lexer/kw-fit");
  check(tokens[4].kind == FengTokenKind.KeywordExtern, "lexer/kw-extern");
  check(tokens[5].kind == FengTokenKind.KeywordFunc, "lexer/kw-func");
  check(tokens[6].kind == FengTokenKind.KeywordLet, "lexer/kw-let");
  check(tokens[7].kind == FengTokenKind.KeywordVar, "lexer/kw-var");
  writeLine("__LEXER_KEYWORDS_BASIC__=ok");
}

func lexer_keywords_modifiers() {
  let tokens = collectNonTrivia("static open seal self");
  check(tokens[0].kind == FengTokenKind.KeywordStatic, "lexer/kw-static");
  check(tokens[1].kind == FengTokenKind.KeywordOpen, "lexer/kw-open");
  check(tokens[2].kind == FengTokenKind.KeywordSeal, "lexer/kw-seal");
  check(tokens[3].kind == FengTokenKind.KeywordSelf, "lexer/kw-self");
  writeLine("__LEXER_KEYWORDS_MODIFIERS__=ok");
}

func lexer_keywords_module() {
  let tokens = collectNonTrivia("module import as");
  check(tokens[0].kind == FengTokenKind.KeywordModule, "lexer/kw-module");
  check(tokens[1].kind == FengTokenKind.KeywordImport, "lexer/kw-import");
  check(tokens[2].kind == FengTokenKind.KeywordAs, "lexer/kw-as");
  writeLine("__LEXER_KEYWORDS_MODULE__=ok");
}

func lexer_keywords_control() {
  let tokens = collectNonTrivia("if else match while for in break continue");
  check(tokens[0].kind == FengTokenKind.KeywordIf, "lexer/kw-if");
  check(tokens[1].kind == FengTokenKind.KeywordElse, "lexer/kw-else");
  check(tokens[2].kind == FengTokenKind.KeywordMatch, "lexer/kw-match");
  check(tokens[3].kind == FengTokenKind.KeywordWhile, "lexer/kw-while");
  check(tokens[4].kind == FengTokenKind.KeywordFor, "lexer/kw-for");
  check(tokens[5].kind == FengTokenKind.KeywordIn, "lexer/kw-in");
  check(tokens[6].kind == FengTokenKind.KeywordBreak, "lexer/kw-break");
  check(tokens[7].kind == FengTokenKind.KeywordContinue, "lexer/kw-continue");
  writeLine("__LEXER_KEYWORDS_CONTROL__=ok");
}

func lexer_keywords_exception() {
  let tokens = collectNonTrivia("try catch unknown throw return defer void");
  check(tokens[0].kind == FengTokenKind.KeywordTry, "lexer/kw-try");
  check(tokens[1].kind == FengTokenKind.KeywordCatch, "lexer/kw-catch");
  check(tokens[2].kind == FengTokenKind.KeywordUnknown, "lexer/kw-unknown");
  check(tokens[3].kind == FengTokenKind.KeywordThrow, "lexer/kw-throw");
  check(tokens[4].kind == FengTokenKind.KeywordReturn, "lexer/kw-return");
  check(tokens[5].kind == FengTokenKind.KeywordDefer, "lexer/kw-defer");
  check(tokens[6].kind == FengTokenKind.KeywordVoid, "lexer/kw-void");
  writeLine("__LEXER_KEYWORDS_EXCEPTION__=ok");
}

// ==================== 布尔字面量 ====================

func lexer_bool_literals() {
  let tokens = collectNonTrivia("true false");
  check(tokens[0].kind == FengTokenKind.LiteralBool, "lexer/bool-true-kind");
  check(tokens[0].value.toString() == "true", "lexer/bool-true-value");
  check(tokens[1].kind == FengTokenKind.LiteralBool, "lexer/bool-false-kind");
  check(tokens[1].value.toString() == "false", "lexer/bool-false-value");
  writeLine("__LEXER_BOOL_LITERALS__=ok");
}

// ==================== 整数 ====================

func lexer_integer_decimal() {
  let tokens = collectNonTrivia("0 42 12345");
  check(tokens[0].kind == FengTokenKind.LiteralInteger, "lexer/int-dec-zero-kind");
  check(tokens[0].value.toString() == "0", "lexer/int-dec-zero-value");
  check(tokens[1].kind == FengTokenKind.LiteralInteger, "lexer/int-dec-42-kind");
  check(tokens[1].value.toString() == "42", "lexer/int-dec-42-value");
  check(tokens[2].kind == FengTokenKind.LiteralInteger, "lexer/int-dec-12345-kind");
  check(tokens[2].value.toString() == "12345", "lexer/int-dec-12345-value");
  writeLine("__LEXER_INTEGER_DECIMAL__=ok");
}

func lexer_integer_hex() {
  writeLine("__LEXER_INTEGER_HEX__=start");
  var lexer = makeLexer("0xFF");
  writeLine("__LEXER_INTEGER_HEX__=lexer-created");
  let token = lexer.next();
  writeLine("__LEXER_INTEGER_HEX__=token-got");
  check(token.kind == FengTokenKind.LiteralInteger, "lexer/int-hex-kind");
  writeLine("__LEXER_INTEGER_HEX__=ok");
}

func lexer_integer_binary() {
  let tokens = collectNonTrivia("0b1010 0B11");
  check(tokens[0].kind == FengTokenKind.LiteralInteger, "lexer/int-bin-kind");
  check(tokens[0].value.toString() == "0b1010", "lexer/int-bin-value");
  check(tokens[1].kind == FengTokenKind.LiteralInteger, "lexer/int-bin-upper-kind");
  check(tokens[1].value.toString() == "0B11", "lexer/int-bin-upper-value");
  writeLine("__LEXER_INTEGER_BINARY__=ok");
}

func lexer_integer_octal() {
  let tokens = collectNonTrivia("0o77 0O12");
  check(tokens[0].kind == FengTokenKind.LiteralInteger, "lexer/int-oct-kind");
  check(tokens[0].value.toString() == "0o77", "lexer/int-oct-value");
  check(tokens[1].kind == FengTokenKind.LiteralInteger, "lexer/int-oct-upper-kind");
  check(tokens[1].value.toString() == "0O12", "lexer/int-oct-upper-value");
  writeLine("__LEXER_INTEGER_OCTAL__=ok");
}

func lexer_integer_underscore() {
  let tokens = collectNonTrivia("1_000_000 0xFF_FF");
  check(tokens[0].kind == FengTokenKind.LiteralInteger, "lexer/int-underscore-kind");
  check(tokens[0].value.toString() == "1_000_000", "lexer/int-underscore-value");
  check(tokens[1].kind == FengTokenKind.LiteralInteger, "lexer/int-underscore-hex-kind");
  check(tokens[1].value.toString() == "0xFF_FF", "lexer/int-underscore-hex-value");
  writeLine("__LEXER_INTEGER_UNDERSCORE__=ok");
}

// ==================== 浮点数 ====================

func lexer_float_decimal_point() {
  let tokens = collectNonTrivia("3.14 0.5");
  check(tokens[0].kind == FengTokenKind.LiteralFloat, "lexer/float-pi-kind");
  check(tokens[0].value.toString() == "3.14", "lexer/float-pi-value");
  check(tokens[1].kind == FengTokenKind.LiteralFloat, "lexer/float-half-kind");
  check(tokens[1].value.toString() == "0.5", "lexer/float-half-value");
  writeLine("__LEXER_FLOAT_DECIMAL_POINT__=ok");
}

func lexer_float_exponent() {
  let tokens = collectNonTrivia("1e10 2E3 1e+4 5e-2");
  check(tokens[0].kind == FengTokenKind.LiteralFloat, "lexer/float-exp-kind");
  check(tokens[0].value.toString() == "1e10", "lexer/float-exp-value");
  check(tokens[1].kind == FengTokenKind.LiteralFloat, "lexer/float-exp-upper-kind");
  check(tokens[1].value.toString() == "2E3", "lexer/float-exp-upper-value");
  check(tokens[2].kind == FengTokenKind.LiteralFloat, "lexer/float-exp-plus-kind");
  check(tokens[2].value.toString() == "1e+4", "lexer/float-exp-plus-value");
  check(tokens[3].kind == FengTokenKind.LiteralFloat, "lexer/float-exp-minus-kind");
  check(tokens[3].value.toString() == "5e-2", "lexer/float-exp-minus-value");
  writeLine("__LEXER_FLOAT_EXPONENT__=ok");
}

func lexer_float_combined() {
  let tokens = collectNonTrivia("3.14e2 1.0e-3");
  check(tokens[0].kind == FengTokenKind.LiteralFloat, "lexer/float-combined-kind");
  check(tokens[0].value.toString() == "3.14e2", "lexer/float-combined-value");
  check(tokens[1].kind == FengTokenKind.LiteralFloat, "lexer/float-combined-neg-kind");
  check(tokens[1].value.toString() == "1.0e-3", "lexer/float-combined-neg-value");
  writeLine("__LEXER_FLOAT_COMBINED__=ok");
}

