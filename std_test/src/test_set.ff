module std_test;

import std.collections;

func set_add_has() {
  let s = Set<IntKey>();
  let k = IntKey { value: 10 };
  s.add(k);
  check(s.has(k), "set/add-has");
}

func set_has_false() {
  let s = Set<IntKey>();
  let k = IntKey { value: 99 };
  check(!s.has(k), "set/has-false");
}

func set_add_duplicate() {
  let s = Set<IntKey>();
  let k = IntKey { value: 5 };
  s.add(k);
  s.add(k);
  check(s.count() == 1, "set/add-duplicate");
}

func set_remove() {
  let s = Set<IntKey>();
  let k = IntKey { value: 8 };
  s.add(k);
  s.remove(k);
  check(!s.has(k), "set/remove");
}

func set_remove_absent() {
  let s = Set<IntKey>();
  let k = IntKey { value: 42 };
  s.remove(k);
  check(!s.has(k), "set/remove-absent");
}

func set_multiple_elements() {
  let s = Set<IntKey>();
  for var i: i32 = 0; i < 20; i = i + 1 {
    s.add(IntKey { value: i });
  }
  var allPresent: bool = true;
  for var i: i32 = 0; i < 20; i = i + 1 {
    if !s.has(IntKey { value: i }) {
      allPresent = false;
    }
  }
  check(allPresent, "set/multiple-elements");
  s.remove(IntKey { value: 5 });
  s.remove(IntKey { value: 15 });
  check(!s.has(IntKey { value: 5 }), "set/multiple-remove-1");
  check(!s.has(IntKey { value: 15 }), "set/multiple-remove-2");
  check(s.has(IntKey { value: 10 }), "set/multiple-survivor");
}

func set_count() {
  let s = Set<IntKey>();
  check(s.count() == 0, "set/count-empty");
  s.add(IntKey { value: 1 });
  s.add(IntKey { value: 2 });
  s.add(IntKey { value: 3 });
  check(s.count() == 3, "set/count-after-add");
  s.remove(IntKey { value: 2 });
  check(s.count() == 2, "set/count-after-remove");
}

func set_entities_two() {
  let s = Set<IntKey>();
  let k7 = IntKey { value: 7 };
  let k13 = IntKey { value: 13 };
  s.add(k7);
  s.add(k13);
  let ents = s.entries();
  let a: i32 = ents[0].value;
  let b: i32 = ents[1].value;
  check((a == 7) || (b == 7), "set/entities-has-7");
  check((a == 13) || (b == 13), "set/entities-has-13");
}

func set_int_direct_call() {
  let h: Hashable<i32> = 7;
  check(h.same(7), "set/int-hashable-same");
  let s = Set<int>();
  s.add(7);
  s.add(13);
  check(s.count() == 2, "set/int-count-2");
  let ents = s.entries();
  let a = ents[0];
  let b = ents[1];
  check((a == 7) || (b == 7), "set/int-entries-has-7");
  check((a == 13) || (b == 13), "set/int-entries-has-13");
}

open func run_set_tests() {
  set_add_has();
  set_has_false();
  set_add_duplicate();
  set_remove();
  set_remove_absent();
  set_multiple_elements();
  set_count();
  set_entities_two();
  set_int_direct_call();
}
