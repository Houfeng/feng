mod std_test;

use std.collections;

type RefBox {
  var value: i32;
}

fn list_add_get() {
  let l = List:<i32>();
  let v0: i32 = 42;
  l.add(v0);
  check(l.get(0) == 42, "list/add-get");
}

fn list_size() {
  let l = List:<i32>();
  check(l.size() == 0, "list/size-empty");
  let v1: i32 = 1;
  let v2: i32 = 2;
  let v3: i32 = 3;
  l.add(v1);
  l.add(v2);
  l.add(v3);
  check(l.size() == 3, "list/size-after-add");
}

fn list_set_index() {
  let l = List:<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 99;
  l.add(a);
  l.add(b);
  l.set(0, c);
  check(l.get(0) == 99, "list/set-index");
  check(l.get(1) == 20, "list/set-index-other-unchanged");
}

fn list_remove_shifts() {
  let l = List:<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 30;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(0);
  check(l.get(0) == 20, "list/remove-shifts-first");
  check(l.get(1) == 30, "list/remove-shifts-second");
}

fn list_size_after_remove() {
  let l = List:<i32>();
  let a: i32 = 1;
  let b: i32 = 2;
  let c: i32 = 3;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(1);
  check(l.size() == 2, "list/size-after-remove");
}

fn list_multiple_elements() {
  let l = List:<i32>();
  for var i: i32 = 0; i < 20; i = i + 1 {
    l.add(i);
  }
  check(l.size() == 20, "list/multiple-size");
  var allOk: bool = true;
  for var i: i32 = 0; i < 20; i = i + 1 {
    if l.get(i) != i {
      allOk = false;
    }
  }
  check(allOk, "list/multiple-values");
}

fn list_entities_order() {
  let l = List:<i32>();
  l.add(100);
  l.add(200);
  l.add(300);
  let ents = l.entries();
  check(ents[0] == 100, "list/entities-order-0");
  check(ents[1] == 200, "list/entities-order-1");
  check(ents[2] == 300, "list/entities-order-2");
}

fn list_entities_count() {
  let l = List:<i32>();
  l.add(1);
  l.add(2);
  check(l.size() == 2, "list/entities-count");
}

fn list_reference_semantics() {
  let l = List:<RefBox>();
  let b = RefBox { value: 10 };
  l.add(b);
  b.value = 99;
  check(l.get(0).value == 99, "list/reference-semantics");
}

pu fn run_list_tests() {
  list_add_get();
  list_size();
  list_set_index();
  list_remove_shifts();
  list_size_after_remove();
  list_multiple_elements();
  list_entities_order();
  list_entities_count();
  list_reference_semantics();
}
