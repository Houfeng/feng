module std_test;

import std.io;
import std.collections;

type RefBox {
  var value: i32;
}

func list_add_get() {
  let l = List<i32>();
  let v0: i32 = 42;
  l.add(v0);
  check(l.get(0) == 42, "list/add-get");
}

func list_size() {
  let l = List<i32>();
  check(l.size() == 0, "list/size-empty");
  let v1: i32 = 1;
  let v2: i32 = 2;
  let v3: i32 = 3;
  l.add(v1);
  l.add(v2);
  l.add(v3);
  check(l.size() == 3, "list/size-after-add");
}

func list_set_index() {
  let l = List<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 99;
  l.add(a);
  l.add(b);
  l.set(0, c);
  check(l.get(0) == 99, "list/set-index");
  check(l.get(1) == 20, "list/set-index-other-unchanged");
}

func list_remove_shifts() {
  let l = List<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 30;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(0);
  check(l.get(0) == 20, "list/remove-shifts-first");
  check(l.get(1) == 30, "list/remove-shifts-second");
}

func list_size_after_remove() {
  let l = List<i32>();
  let a: i32 = 1;
  let b: i32 = 2;
  let c: i32 = 3;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(1);
  check(l.size() == 2, "list/size-after-remove");
}

func list_multiple_elements() {
  let l = List<i32>();
  for var i: i32 = 0; i < 20; i = i + 1 {
    l.add(i);
  }
  check(l.size() == 20, "list/multiple-size");
  var allOk: bool = true;
  for var i: i32 = 0; i < 20; i = i + 1 {
    if l.get(i) != i {
      allOk = false;
    }
  }
  check(allOk, "list/multiple-values");
}

func list_entities_order() {
  let l = List<i32>();
  l.add(100);
  l.add(200);
  l.add(300);
  let ents = l.entries();
  check(ents[0] == 100, "list/entities-order-0");
  check(ents[1] == 200, "list/entities-order-1");
  check(ents[2] == 300, "list/entities-order-2");
}

func list_entities_count() {
  let l = List<i32>();
  l.add(1);
  l.add(2);
  check(l.size() == 2, "list/entities-count");
}

func list_reference_semantics() {
  let l = List<RefBox>();
  let b = RefBox { value: 10 };
  l.add(b);
  b.value = 99;
  check(l.get(0).value == 99, "list/reference-semantics");
}

func list_for_in_basic() {
  let l = List<i32>();
  l.add(10);
  l.add(20);
  l.add(30);
  var sum: i32 = 0;
  for let v in l {
    sum = sum + v;
  }
  check(sum == 60, "list/for-in-basic");
}

func list_for_in_empty() {
  let l = List<i32>();
  var count: i32 = 0;
  for let v in l {
    count = count + v;
  }
  check(count == 0, "list/for-in-empty");
}

func list_for_in_nested() {
  let a = List<i32>();
  a.add(1);
  a.add(2);
  let b = List<i32>();
  b.add(10);
  b.add(20);
  var sum: i32 = 0;
  for let x in a {
    for let y in b {
      sum = sum + x * y;
    }
  }
  check(sum == 90, "list/for-in-nested");
}

func list_for_in_string() {
  let l = List<string>();
  l.add("a");
  l.add("b");
  l.add("c");
  var result = "";
  for let s in l {
    result = result + s;
  }
  check(result == "abc", "list/for-in-string");
  writeLine("__LIST_FOR_IN__=" + result);
}

