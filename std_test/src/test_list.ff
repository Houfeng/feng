open func run_list_tests() {
  list_add_get();
  list_size();
  list_set_index();
  list_remove_shifts();
  list_size_after_remove();
  list_multiple_elements();
  list_entities_order();
  list_entities_count();
  list_reference_semantics();
  list_for_in_basic();
  list_for_in_empty();
  list_for_in_nested();
  list_for_in_string();
  // list_for_in_generic();
  // list_for_in_generic_string();
}
