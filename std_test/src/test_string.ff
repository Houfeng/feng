module std_test;

import std.test;

import std.io;
import std.text;
import std.collections;

func string_from_utf8_bytes_ascii() {
  let bytes: byte[] = [(byte)104, (byte)101, (byte)108, (byte)108, (byte)111];
  let text = string.fromUtf8Bytes(bytes);

  check(text.length() == (i64)5, "string/fromUtf8Bytes-ascii-length");
  writeLine("__STRING_FROM_UTF8_ASCII__=" + text);
}

func string_from_utf8_bytes_utf8() {
  let bytes: byte[] = [(byte)228, (byte)189, (byte)160, (byte)229, (byte)165, (byte)189];
  let text = string.fromUtf8Bytes(bytes);

  check(text.length() == (i64)6, "string/fromUtf8Bytes-utf8-length");
  writeLine("__STRING_FROM_UTF8_UTF8__=" + text);
}

func string_from_utf8_bytes_empty() {
  let bytes: byte[!] = byte[: (i64)0];
  let text = string.fromUtf8Bytes((byte[])bytes);

  check(text.length() == (i64)0, "string/fromUtf8Bytes-empty-length");
  writeLine("__STRING_FROM_UTF8_EMPTY__=" + text);
}

func string_clone_full() {
  let text = "hello";
  let cloned = text.clone();

  check(cloned.length() == (i64)5, "string/clone-full-length");
  check(cloned == "hello", "string/clone-full-eq");
  writeLine("__STRING_CLONE_FULL__=" + cloned);
}

func string_clone_range() {
  let text = "hello world";
  let cloned = text.clone((i64)6, (i64)11);

  check(cloned.length() == (i64)5, "string/clone-range-length");
  check(cloned == "world", "string/clone-range-eq");
  writeLine("__STRING_CLONE_RANGE__=" + cloned);
}

func string_clone_empty() {
  let text = "hello";
  let cloned = text.clone((i64)0, (i64)0);

  check(cloned.length() == (i64)0, "string/clone-empty-length");
  check(cloned == "", "string/clone-empty-eq");
  writeLine("__STRING_CLONE_EMPTY__=" + cloned);
}

func string_clone_utf8() {
  let text = "你好世界";
  let cloned = text.clone();

  check(cloned.length() == (i64)12, "string/clone-utf8-length");
  check(cloned == "你好世界", "string/clone-utf8-eq");
  writeLine("__STRING_CLONE_UTF8__=" + cloned);
}

func string_clone_utf8_range() {
  let text = "你好世界";
  let cloned = text.clone((i64)6, (i64)12);

  check(cloned.length() == (i64)6, "string/clone-utf8-range-length");
  check(cloned == "世界", "string/clone-utf8-range-eq");
  writeLine("__STRING_CLONE_UTF8_RANGE__=" + cloned);
}

func string_at_ascii() {
  let text = "hello";
  let ch = text.at(1);

  check(ch == "e", "string/at-ascii");
  check(ch.length() == (i64)1, "string/at-ascii-length");
  writeLine("__STRING_AT_ASCII__=" + ch);
}

func string_at_first_last() {
  let text = "abc";

  check(text.at(0) == "a", "string/at-first");
  check(text.at(2) == "c", "string/at-last");
  writeLine("__STRING_AT_FIRST_LAST__=ok");
}

func string_at_utf8_byte() {
  let text = "你好";
  let b = text.at(0);

  check(b.length() == (i64)1, "string/at-utf8-byte-length");
  writeLine("__STRING_AT_UTF8_BYTE__=ok");
}

func string_rune_length_ascii() {
  let text = "hello";
  check(text.runes().length() == (i64)5, "string/rune-length-ascii");
  writeLine("__STRING_RUNE_LENGTH_ASCII__=ok");
}

func string_rune_length_utf8() {
  let text = "你好世界";
  check(text.runes().length() == (i64)4, "string/rune-length-utf8");
  writeLine("__STRING_RUNE_LENGTH_UTF8__=ok");
}

func string_rune_at() {
  let text = "你好世界";
  check(text.runes().at(0) == "你", "string/rune-at-first");
  check(text.runes().at(1) == "好", "string/rune-at-second");
  check(text.runes().at(3) == "界", "string/rune-at-last");
  writeLine("__STRING_RUNE_AT__=ok");
}

func string_grapheme_length_ascii() {
  let text = "abc";
  check(text.graphemes().length() == (i64)3, "string/grapheme-length-ascii");
  writeLine("__STRING_GRAPHEME_LENGTH_ASCII__=ok");
}

func string_grapheme_length_utf8() {
  let text = "你好";
  check(text.graphemes().length() == (i64)2, "string/grapheme-length-utf8");
  writeLine("__STRING_GRAPHEME_LENGTH_UTF8__=ok");
}

func string_grapheme_length_emoji() {
  let family = "👨‍👩‍👧‍👦";
  check(family.graphemes().length() == (i64)1, "string/grapheme-length-emoji");
  check(family.runes().length() == (i64)7, "string/grapheme-emoji-rune-count");
  writeLine("__STRING_GRAPHEME_LENGTH_EMOJI__=ok");
}

func string_grapheme_at() {
  let text = "你好世界";
  check(text.graphemes().at(0) == "你", "string/grapheme-at-first");
  check(text.graphemes().at(3) == "界", "string/grapheme-at-last");
  writeLine("__STRING_GRAPHEME_AT__=ok");
}

func string_equality() {
  let a = "hello";
  let b = "hello";
  let c = a.clone();
  let d = "world";

  check(a == b, "string/eq-same-literal");
  check(a == c, "string/eq-cloned");
  check(a != d, "string/ne-different");
  check(!(a == d), "string/not-eq-different");
  check("" == "", "string/eq-empty");
  writeLine("__STRING_EQUALITY__=ok");
}

func string_indexOf() {
  check("hello world".indexOf("world") == (i64)6, "string/indexOf-found");
  check("hello world".indexOf("xyz") == (i64)-1, "string/indexOf-not-found");
  check("hello".indexOf("") == (i64)0, "string/indexOf-empty-target");
  check("".indexOf("a") == (i64)-1, "string/indexOf-empty-self");
  check("hello".indexOf("hello") == (i64)0, "string/indexOf-full-match");
  check("aabaa".indexOf("a", (i64)2) == (i64)3, "string/indexOf-from");
  check("aabaa".indexOf("a", (i64)4) == (i64)4, "string/indexOf-from-last");
  check("aabaa".indexOf("a", (i64)5) == (i64)-1, "string/indexOf-from-past");
  check("你好世界".indexOf("世界") == (i64)6, "string/indexOf-utf8");
  writeLine("__STRING_INDEX_OF__=ok");
}

func string_lastIndexOf() {
  check("aabaa".lastIndexOf("a") == (i64)4, "string/lastIndexOf-last");
  check("aabaa".lastIndexOf("b") == (i64)2, "string/lastIndexOf-mid");
  check("hello".lastIndexOf("xyz") == (i64)-1, "string/lastIndexOf-not-found");
  check("hello".lastIndexOf("") == (i64)5, "string/lastIndexOf-empty");
  check("你好你好".lastIndexOf("你好") == (i64)6, "string/lastIndexOf-utf8");
  writeLine("__STRING_LAST_INDEX_OF__=ok");
}

func string_contains() {
  check("hello world".contains("world") == true, "string/contains-found");
  check("hello world".contains("xyz") == false, "string/contains-not-found");
  check("hello".contains("") == true, "string/contains-empty");
  check("".contains("") == true, "string/contains-both-empty");
  writeLine("__STRING_CONTAINS__=ok");
}

func string_startsWith() {
  check("hello".startsWith("hel") == true, "string/startsWith-true");
  check("hello".startsWith("world") == false, "string/startsWith-false");
  check("hello".startsWith("") == true, "string/startsWith-empty");
  check("hello".startsWith("hello") == true, "string/startsWith-full");
  check("hello".startsWith("hello!") == false, "string/startsWith-longer");
  check("".startsWith("") == true, "string/startsWith-both-empty");
  check("你好世界".startsWith("你好") == true, "string/startsWith-utf8");
  writeLine("__STRING_STARTS_WITH__=ok");
}

func string_endsWith() {
  check("hello".endsWith("llo") == true, "string/endsWith-true");
  check("hello".endsWith("hel") == false, "string/endsWith-false");
  check("hello".endsWith("") == true, "string/endsWith-empty");
  check("hello".endsWith("hello") == true, "string/endsWith-full");
  check("hello".endsWith("!hello") == false, "string/endsWith-longer");
  check("你好世界".endsWith("世界") == true, "string/endsWith-utf8");
  writeLine("__STRING_ENDS_WITH__=ok");
}

func string_replace() {
  check("hello world".replace("world", "feng") == "hello feng", "string/replace-simple");
  check("aaa".replace("a", "bb") == "bbbbbb", "string/replace-all");
  check("hello".replace("xyz", "abc") == "hello", "string/replace-no-match");
  check("hello".replace("", "x") == "hello", "string/replace-empty-old");
  check("abcabc".replace("abc", "") == "", "string/replace-to-empty");
  check("hello".replace("l", "r") == "herro", "string/replace-multi");
  check("你好世界".replace("世界", "feng") == "你好feng", "string/replace-utf8");
  writeLine("__STRING_REPLACE__=ok");
}

func string_trim() {
  check(" hello ".trim() == "hello", "string/trim-spaces");
  check("hello".trim() == "hello", "string/trim-no-ws");
  check("   ".trim() == "", "string/trim-all-ws");
  check("".trim() == "", "string/trim-empty");
  check("\t\n hello \r\n".trim() == "hello", "string/trim-mixed-ascii-ws");
  writeLine("__STRING_TRIM__=ok");
}

func string_trimStart() {
  check("  hello".trimStart() == "hello", "string/trimStart-spaces");
  check("hello  ".trimStart() == "hello  ", "string/trimStart-trailing");
  check("hello".trimStart() == "hello", "string/trimStart-no-ws");
  check("   ".trimStart() == "", "string/trimStart-all-ws");
  check("\t\nhello".trimStart() == "hello", "string/trimStart-mixed");
  writeLine("__STRING_TRIM_START__=ok");
}

func string_trimEnd() {
  check("hello  ".trimEnd() == "hello", "string/trimEnd-spaces");
  check("  hello".trimEnd() == "  hello", "string/trimEnd-leading");
  check("hello".trimEnd() == "hello", "string/trimEnd-no-ws");
  check("   ".trimEnd() == "", "string/trimEnd-all-ws");
  check("hello\t\n".trimEnd() == "hello", "string/trimEnd-mixed");
  writeLine("__STRING_TRIM_END__=ok");
}

func string_isEmpty() {
  check("".isEmpty() == true, "string/isEmpty-empty");
  check("a".isEmpty() == false, "string/isEmpty-non-empty");
  check(" ".isEmpty() == false, "string/isEmpty-space");
  writeLine("__STRING_IS_EMPTY__=ok");
}

func string_toBytes() {
  check("hello".toBytes().length() == (i64)5, "string/toBytes-ascii");
  check("你好".toBytes().length() == (i64)6, "string/toBytes-utf8");
  check("".toBytes().length() == (i64)0, "string/toBytes-empty");
  writeLine("__STRING_TO_BYTES__=ok");
}

func string_repeat() {
  check("ab".repeat((i64)3) == "ababab", "string/repeat-3");
  check("x".repeat((i64)0) == "", "string/repeat-0");
  check("".repeat((i64)5) == "", "string/repeat-empty");
  check("hi".repeat((i64)1) == "hi", "string/repeat-1");
  check("你".repeat((i64)2) == "你你", "string/repeat-utf8");
  writeLine("__STRING_REPEAT__=ok");
}

func string_split() {
  let r1 = "a,b,c".split(",");
  check(r1.length() == (i64)3, "string/split-count");
  check(r1[0] == "a", "string/split-first");
  check(r1[1] == "b", "string/split-mid");
  check(r1[2] == "c", "string/split-last");

  let r2 = "hello".split(",");
  check(r2.length() == (i64)1, "string/split-no-match");
  check(r2[0] == "hello", "string/split-no-match-val");

  let r3 = ",,".split(",");
  check(r3.length() == (i64)3, "string/split-empty-parts-count");
  check(r3[0] == "", "string/split-empty-first");
  check(r3[1] == "", "string/split-empty-mid");
  check(r3[2] == "", "string/split-empty-last");

  let r4 = "".split(",");
  check(r4.length() == (i64)1, "string/split-empty-str");
  check(r4[0] == "", "string/split-empty-str-val");

  let r5 = "a".split("");
  check(r5.length() == (i64)1, "string/split-empty-sep");
  check(r5[0] == "a", "string/split-empty-sep-val");

  let r6 = "你好,世界".split(",");
  check(r6.length() == (i64)2, "string/split-utf8-count");
  check(r6[0] == "你好", "string/split-utf8-first");
  check(r6[1] == "世界", "string/split-utf8-last");

  writeLine("__STRING_SPLIT__=ok");
}

func string_join() {
  let empty: string[] = [];
  check(string.join(",", empty) == "", "string/join-empty");
  check(string.join(",", ["a", "b", "c"]) == "a,b,c", "string/join-three");
  check(string.join("", ["a", "b"]) == "ab", "string/join-no-sep");
  check(string.join("--", ["x"]) == "x", "string/join-single");
  check(string.join(",", ["", ""]) == ",", "string/join-empty-parts");
  writeLine("__STRING_JOIN__=ok");
}

func string_toUpperCase() {
  check("hello".toUpperCase() == "HELLO", "string/toUpperCase-ascii");
  check("Hello World".toUpperCase() == "HELLO WORLD", "string/toUpperCase-mixed");
  check("HELLO".toUpperCase() == "HELLO", "string/toUpperCase-already");
  check("".toUpperCase() == "", "string/toUpperCase-empty");
  check("123!@#".toUpperCase() == "123!@#", "string/toUpperCase-non-alpha");
  check("你好".toUpperCase() == "你好", "string/toUpperCase-cjk");
  check("café".toUpperCase() == "CAFÉ", "string/toUpperCase-latin-ext");
  writeLine("__STRING_TO_UPPER_CASE__=ok");
}

func string_toLowerCase() {
  check("HELLO".toLowerCase() == "hello", "string/toLowerCase-ascii");
  check("Hello World".toLowerCase() == "hello world", "string/toLowerCase-mixed");
  check("hello".toLowerCase() == "hello", "string/toLowerCase-already");
  check("".toLowerCase() == "", "string/toLowerCase-empty");
  check("123!@#".toLowerCase() == "123!@#", "string/toLowerCase-non-alpha");
  check("你好".toLowerCase() == "你好", "string/toLowerCase-cjk");
  check("CAFÉ".toLowerCase() == "café", "string/toLowerCase-latin-ext");
  writeLine("__STRING_TO_LOWER_CASE__=ok");
}

func string_padStart() {
  check("hi".padStart((i64)5, "0") == "000hi", "string/padStart-basic");
  check("hello".padStart((i64)3, "0") == "hello", "string/padStart-no-pad");
  check("hi".padStart((i64)5, "ab") == "abahi", "string/padStart-multi-char");
  check("".padStart((i64)3, "x") == "xxx", "string/padStart-empty-str");
  check("hi".padStart((i64)2, "0") == "hi", "string/padStart-exact");
  writeLine("__STRING_PAD_START__=ok");
}

func string_padEnd() {
  check("hi".padEnd((i64)5, "0") == "hi000", "string/padEnd-basic");
  check("hello".padEnd((i64)3, "0") == "hello", "string/padEnd-no-pad");
  check("hi".padEnd((i64)5, "ab") == "hiaba", "string/padEnd-multi-char");
  check("".padEnd((i64)3, "x") == "xxx", "string/padEnd-empty-str");
  check("hi".padEnd((i64)2, "0") == "hi", "string/padEnd-exact");
  writeLine("__STRING_PAD_END__=ok");
}

func string_byte_for_in() {
  let text = "abc";
  var result = "";
  for let ch in text {
    result = result + ch + ".";
  }
  check(result == "a.b.c.", "string/byte-for-in");
  writeLine("__STRING_BYTE_FOR_IN__=" + result);
}

func string_rune_for_in() {
  let text = "A中B";
  var result = "";
  var count: i32 = 0;
  for let r in text.runes() {
    result = result + r;
    count = count + 1;
  }
  check(count == 3, "string/rune-for-in-count");
  check(result == "A中B", "string/rune-for-in-content");
  writeLine("__STRING_RUNE_FOR_IN__=" + result);
}

func string_rune_for_in_empty() {
  var count: i32 = 0;
  for let r in "".runes() {
    count = count + 1;
  }
  check(count == 0, "string/rune-for-in-empty");
  writeLine("__STRING_RUNE_FOR_IN_EMPTY__=ok");
}

func string_rune_for_in_emoji() {
  let text = "A😀B";
  var result = "";
  var count: i32 = 0;
  for let r in text.runes() {
    result = result + "[" + r + "]";
    count = count + 1;
  }
  check(count == 3, "string/rune-for-in-emoji-count");
  writeLine("__STRING_RUNE_FOR_IN_EMOJI__=" + result);
}

func string_byte_for_in_empty() {
  var count: i32 = 0;
  for let ch in "" {
    count = count + 1;
  }
  check(count == 0, "string/byte-for-in-empty");
  writeLine("__STRING_BYTE_FOR_IN_EMPTY__=ok");
}

func string_byte_for_in_single() {
  var result = "";
  for let ch in "x" {
    result = result + ch;
  }
  check(result == "x", "string/byte-for-in-single");
  writeLine("__STRING_BYTE_FOR_IN_SINGLE__=ok");
}

func string_grapheme_for_in_ascii() {
  let text = "abc";
  var result = "";
  var count: i32 = 0;
  for let g in text.graphemes() {
    result = result + g + ".";
    count = count + 1;
  }
  check(count == 3, "string/grapheme-for-in-ascii-count");
  check(result == "a.b.c.", "string/grapheme-for-in-ascii-content");
  writeLine("__STRING_GRAPHEME_FOR_IN_ASCII__=" + result);
}

func string_grapheme_for_in_utf8() {
  let text = "你好世界";
  var result = "";
  var count: i32 = 0;
  for let g in text.graphemes() {
    result = result + "[" + g + "]";
    count = count + 1;
  }
  check(count == 4, "string/grapheme-for-in-utf8-count");
  check(result == "[你][好][世][界]", "string/grapheme-for-in-utf8-content");
  writeLine("__STRING_GRAPHEME_FOR_IN_UTF8__=" + result);
}

func string_grapheme_for_in_emoji() {
  let family = "👨‍👩‍👧‍👦";
  var count: i32 = 0;
  var cluster = "";
  for let g in family.graphemes() {
    cluster = g;
    count = count + 1;
  }
  check(count == 1, "string/grapheme-for-in-emoji-count");
  check(cluster == family, "string/grapheme-for-in-emoji-content");
  writeLine("__STRING_GRAPHEME_FOR_IN_EMOJI__=ok");
}

func string_grapheme_for_in_mixed() {
  let text = "A中😀";
  var result = "";
  var count: i32 = 0;
  for let g in text.graphemes() {
    result = result + "[" + g + "]";
    count = count + 1;
  }
  check(count == 3, "string/grapheme-for-in-mixed-count");
  check(result == "[A][中][😀]", "string/grapheme-for-in-mixed-content");
  writeLine("__STRING_GRAPHEME_FOR_IN_MIXED__=" + result);
}

func string_grapheme_for_in_empty() {
  var count: i32 = 0;
  for let g in "".graphemes() {
    count = count + 1;
  }
  check(count == 0, "string/grapheme-for-in-empty");
  writeLine("__STRING_GRAPHEME_FOR_IN_EMPTY__=ok");
}

func string_grapheme_for_in_single() {
  var result = "";
  for let g in "x".graphemes() {
    result = result + g;
  }
  check(result == "x", "string/grapheme-for-in-single");
  writeLine("__STRING_GRAPHEME_FOR_IN_SINGLE__=ok");
}

open func run_string_tests() {
  describe("string tests", () {
    test("string_from_utf8_bytes_ascii()", () { string_from_utf8_bytes_ascii(); });
    test("string_from_utf8_bytes_utf8()", () { string_from_utf8_bytes_utf8(); });
    test("string_from_utf8_bytes_empty()", () { string_from_utf8_bytes_empty(); });
    test("string_clone_full()", () { string_clone_full(); });
    test("string_clone_range()", () { string_clone_range(); });
    test("string_clone_empty()", () { string_clone_empty(); });
    test("string_clone_utf8()", () { string_clone_utf8(); });
    test("string_clone_utf8_range()", () { string_clone_utf8_range(); });
    test("string_at_ascii()", () { string_at_ascii(); });
    test("string_at_first_last()", () { string_at_first_last(); });
    test("string_at_utf8_byte()", () { string_at_utf8_byte(); });
    test("string_rune_length_ascii()", () { string_rune_length_ascii(); });
    test("string_rune_length_utf8()", () { string_rune_length_utf8(); });
    test("string_rune_at()", () { string_rune_at(); });
    test("string_grapheme_length_ascii()", () { string_grapheme_length_ascii(); });
    test("string_grapheme_length_utf8()", () { string_grapheme_length_utf8(); });
    test("string_grapheme_length_emoji()", () { string_grapheme_length_emoji(); });
    test("string_grapheme_at()", () { string_grapheme_at(); });
    test("string_equality()", () { string_equality(); });
    test("string_indexOf()", () { string_indexOf(); });
    test("string_lastIndexOf()", () { string_lastIndexOf(); });
    test("string_contains()", () { string_contains(); });
    test("string_startsWith()", () { string_startsWith(); });
    test("string_endsWith()", () { string_endsWith(); });
    test("string_replace()", () { string_replace(); });
    test("string_trim()", () { string_trim(); });
    test("string_trimStart()", () { string_trimStart(); });
    test("string_trimEnd()", () { string_trimEnd(); });
    test("string_isEmpty()", () { string_isEmpty(); });
    test("string_toBytes()", () { string_toBytes(); });
    test("string_repeat()", () { string_repeat(); });
    test("string_split()", () { string_split(); });
    test("string_join()", () { string_join(); });
    test("string_toUpperCase()", () { string_toUpperCase(); });
    test("string_toLowerCase()", () { string_toLowerCase(); });
    test("string_padStart()", () { string_padStart(); });
    test("string_padEnd()", () { string_padEnd(); });
    test("string_byte_for_in()", () { string_byte_for_in(); });
    test("string_byte_for_in_empty()", () { string_byte_for_in_empty(); });
    test("string_byte_for_in_single()", () { string_byte_for_in_single(); });
    test("string_rune_for_in()", () { string_rune_for_in(); });
    test("string_rune_for_in_empty()", () { string_rune_for_in_empty(); });
    test("string_rune_for_in_emoji()", () { string_rune_for_in_emoji(); });
