module std_test;

import std.test;

import std.collections;
import std.text;

func string_length_ascii() {
  check("abc".length() == (i64)3, "length/string-ascii");
}

func string_length_utf8_bytes() {
  check("你好".length() == (i64)6, "length/string-utf8-bytes");
}

func string_length_empty() {
  check("".length() == (i64)0, "length/string-empty");
}

func array_length_readonly() {
  let values: i32[] = [1, 2, 3, 4];
  check(values.length() == (i64)4, "length/array-readonly");
}

func array_length_writable() {
  let values: i32[!] = [10, 20];
  check(values.length() == (i64)2, "length/array-writable");
}

func array_length_empty() {
  let values: i32[];
  check(values.length() == (i64)0, "length/array-empty");
}

func array_length_nested() {
  let matrix: i32[][!] = [[1, 2, 3], [4]];
  check(matrix.length() == (i64)2, "length/array-nested-outer");
  check(matrix[0].length() == (i64)3, "length/array-nested-inner");
}

func array_index_of_int() {
  let values: i32[!] = [10, 20, 30, 20];

  check(values.indexOf(20) == (i64)1, "length/array-index-of-int-hit");
  check(values.indexOf(99) == (i64)-1, "length/array-index-of-int-miss");
}

func array_index_of_string() {
  let values: string[!] = ["zero", "hello", "world"];
  let joined = "he" + "llo";

  check(values.indexOf(joined) == (i64)1, "length/array-index-of-string-hit");
  check(values.indexOf("missing") == (i64)-1, "length/array-index-of-string-miss");
}

func span_length_readonly() {
  let values: i32[] = [1, 2, 3, 4];
  let middle = values.slice((i64)1, (i64)3);

  check(middle.length() == (i64)2, "length/span-length-readonly");
}

func span_get_readonly() {
  let values: i32[] = [1, 2, 3, 4];
  let middle = values.slice((i64)1, (i64)3);

  check(middle.get((i64)0) == 2, "length/span-get-readonly-0");
  check(middle.get((i64)1) == 3, "length/span-get-readonly-1");
}

func span_slice_writable_source() {
  let values: i32[!] = [10, 20, 30];
  let tail = values.slice((i64)1, (i64)3);

  check(tail.length() == (i64)2, "length/span-writable-source-length");
  check(tail.get((i64)0) == 20, "length/span-writable-source-0");
  check(tail.get((i64)1) == 30, "length/span-writable-source-1");
}

func span_slice_invalid_range() {
  let values: i32[] = [1, 2, 3];
  let fallback = values.slice((i64)0, (i64)1);
  var caught: bool = false;

  let ignored = try values.slice((i64)2, (i64)4) catch ex: string {
    caught = true;
    fallback;
  };

  check(caught, "length/span-slice-invalid-range");
}

func span_slice_negative_start() {
  let values: i32[] = [1, 2, 3];
  let fallback = values.slice((i64)0, (i64)1);
  var caught: bool = false;

  let ignored = try values.slice((i64)-1, (i64)1) catch ex: string {
    caught = true;
    fallback;
  };

  check(caught, "length/span-slice-negative-start");
}

func span_get_invalid_index() {
  let values: i32[] = [1, 2, 3];
  let middle = values.slice((i64)1, (i64)3);
  var caught: bool = false;

  let ignored = try middle.get((i64)2) catch ex: string {
    caught = true;
    (i32)0;
  };

  check(caught, "length/span-get-invalid-index");
}

func span_get_negative_index() {
  let values: i32[] = [1, 2, 3];
  let middle = values.slice((i64)1, (i64)3);
  var caught: bool = false;

  let ignored = try middle.get((i64)-1) catch ex: string {
    caught = true;
    (i32)0;
  };

  check(caught, "length/span-get-negative-index");
}

open func run_length_tests() {
  describe("length tests", () {
    test("string_length_ascii()", () { string_length_ascii(); });
    test("string_length_utf8_bytes()", () { string_length_utf8_bytes(); });
    test("string_length_empty()", () { string_length_empty(); });
    test("array_length_readonly()", () { array_length_readonly(); });
    test("array_length_writable()", () { array_length_writable(); });
    test("array_length_empty()", () { array_length_empty(); });
    test("array_length_nested()", () { array_length_nested(); });
    test("array_index_of_int()", () { array_index_of_int(); });
    test("array_index_of_string()", () { array_index_of_string(); });
    test("span_length_readonly()", () { span_length_readonly(); });
    test("span_get_readonly()", () { span_get_readonly(); });
    test("span_slice_writable_source()", () { span_slice_writable_source(); });
    test("span_slice_invalid_range()", () { span_slice_invalid_range(); });
    test("span_slice_negative_start()", () { span_slice_negative_start(); });
    test("span_get_invalid_index()", () { span_get_invalid_index(); });
    test("span_get_negative_index()", () { span_get_negative_index(); });
  });
}