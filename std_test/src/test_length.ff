module std_test;

import std;
import std.collections;

func string_length_ascii() {
  check("abc".length() == (long)3, "length/string-ascii");
}

func string_length_utf8_bytes() {
  check("你好".length() == (long)6, "length/string-utf8-bytes");
}

func string_length_empty() {
  check("".length() == (long)0, "length/string-empty");
}

func array_length_readonly() {
  let values: int[] = [1, 2, 3, 4];
  check(values.length() == (long)4, "length/array-readonly");
}

func array_length_writable() {
  let values: int[!] = [10, 20];
  check(values.length() == (long)2, "length/array-writable");
}

func array_length_empty() {
  let values: int[];
  check(values.length() == (long)0, "length/array-empty");
}

func array_length_nested() {
  let matrix: int[][!] = [[1, 2, 3], [4]];
  check(matrix.length() == (long)2, "length/array-nested-outer");
  check(matrix[0].length() == (long)3, "length/array-nested-inner");
}

func array_index_of_int() {
  let values: int[!] = [10, 20, 30, 20];

  check(values.indexOf(20) == (long)1, "length/array-index-of-int-hit");
  check(values.indexOf(99) == (long)-1, "length/array-index-of-int-miss");
}

func array_index_of_string() {
  let values: string[!] = ["zero", "hello", "world"];
  let joined = "he" + "llo";

  check(values.indexOf(joined) == (long)1, "length/array-index-of-string-hit");
  check(values.indexOf("missing") == (long)-1, "length/array-index-of-string-miss");
}

func span_length_readonly() {
  let values: int[] = [1, 2, 3, 4];
  let middle = values.slice((long)1, (long)3);

  check(middle.length() == (long)2, "length/span-length-readonly");
}

func span_get_readonly() {
  let values: int[] = [1, 2, 3, 4];
  let middle = values.slice((long)1, (long)3);

  check(middle.get((long)0) == 2, "length/span-get-readonly-0");
  check(middle.get((long)1) == 3, "length/span-get-readonly-1");
}

func span_slice_writable_source() {
  let values: int[!] = [10, 20, 30];
  let tail = values.slice((long)1, (long)3);

  check(tail.length() == (long)2, "length/span-writable-source-length");
  check(tail.get((long)0) == 20, "length/span-writable-source-0");
  check(tail.get((long)1) == 30, "length/span-writable-source-1");
}

func span_slice_invalid_range() {
  let values: int[] = [1, 2, 3];
  let fallback = values.slice((long)0, (long)1);
  var caught: bool = false;

  let ignored = try values.slice((long)2, (long)4) catch ex: string {
    caught = true;
    fallback;
  };

  check(caught, "length/span-slice-invalid-range");
}

func span_slice_negative_start() {
  let values: int[] = [1, 2, 3];
  let fallback = values.slice((long)0, (long)1);
  var caught: bool = false;

  let ignored = try values.slice((long)-1, (long)1) catch ex: string {
    caught = true;
    fallback;
  };

  check(caught, "length/span-slice-negative-start");
}

func span_get_invalid_index() {
  let values: int[] = [1, 2, 3];
  let middle = values.slice((long)1, (long)3);
  var caught: bool = false;

  let ignored = try middle.get((long)2) catch ex: string {
    caught = true;
    (int)0;
  };

  check(caught, "length/span-get-invalid-index");
}

func span_get_negative_index() {
  let values: int[] = [1, 2, 3];
  let middle = values.slice((long)1, (long)3);
  var caught: bool = false;

  let ignored = try middle.get((long)-1) catch ex: string {
    caught = true;
    (int)0;
  };

  check(caught, "length/span-get-negative-index");
}

open func run_length_tests() {
  string_length_ascii();
  string_length_utf8_bytes();
  string_length_empty();
  array_length_readonly();
  array_length_writable();
  array_length_empty();
  array_length_nested();
  array_index_of_int();
  array_index_of_string();
  span_length_readonly();
  span_get_readonly();
  span_slice_writable_source();
  span_slice_invalid_range();
  span_slice_negative_start();
  span_get_invalid_index();
  span_get_negative_index();
}
