module std_test;

import std.text;

@cdecl("libc")
extern func write(fd: int, buf: string*, count: long): long;

@cdecl("libc")
extern func pipe(fds: int*): int;

@cdecl("libc")
extern func dup2(from: int, to: int): int;

@cdecl("libc")
extern func close(fd: int): int;

@cdecl("libc")
extern func exit(code: int): void;

func logLine(text: string) {
  let newline = "\n";

  write(2, &text, text.length());
  write(2, &newline, newline.length());
}

func failNow(name: string) {
  logLine("FAIL: " + name);
  exit(1);
}

open func check(cond: bool, name: string) {
  if cond {
    logLine("ok: " + name);
  } else {
    failNow(name);
  }
}

open func replaceStdin(text: string) {
  let fds: int[!] = int[: (long)2];

  if pipe(&fds) != 0 {
    failNow("harness/stdin-pipe");
  }
  if write(fds[1], &text, text.length()) != text.length() {
    close(fds[0]);
    close(fds[1]);
    failNow("harness/stdin-write");
  }
  if close(fds[1]) != 0 {
    close(fds[0]);
    failNow("harness/stdin-close-write");
  }
  if dup2(fds[0], 0) < 0 {
    close(fds[0]);
    failNow("harness/stdin-dup2");
  }
  if close(fds[0]) != 0 {
    failNow("harness/stdin-close-read");
  }
}
