module std_test;

import std.test;
import std.text;

@cdecl("libc")
extern func write(fd: i32, buf: string*, count: i64): i64;

@cdecl("libc")
extern func pipe(fds: i32*): i32;

@cdecl("libc")
extern func dup2(from: i32, to: i32): i32;

@cdecl("libc")
extern func close(fd: i32): i32;

@cdecl("libc")
extern func exit(code: i32): void;

func logLine(text: string) {
  let newline = "\n";

  write(2, &text, text.length());
  write(2, &newline, newline.length());
}

func failNow(name: string) {
  logLine("FAIL: " + name);
  exit(1);
}

open func check(cond: bool, name: string) {
  assert(cond, name, []);
}

open func replaceStdin(text: string) {
  let fds: i32[!] = i32[: (i64)2];

  if pipe(&fds) != 0 {
    failNow("harness/stdin-pipe");
  }
  if write(fds[1], &text, text.length()) != text.length() {
    close(fds[0]);
    close(fds[1]);
    failNow("harness/stdin-write");
  }
  if close(fds[1]) != 0 {
    close(fds[0]);
    failNow("harness/stdin-close-write");
  }
  if dup2(fds[0], 0) < 0 {
    close(fds[0]);
    failNow("harness/stdin-dup2");
  }
  if close(fds[0]) != 0 {
    failNow("harness/stdin-close-read");
  }
}
