+  // The embedded addend may contain both the displacement of the PC from its
+  // anchor and a displacement of the actual target from its anchor. Resolve
+  // the latter before replacing the PC anchor, otherwise alternate entry
+  // symbols lose their displacement and acquire the wrong unwind range.
+  if (!pcSym->isec() || &pcSym->isec()->section != &isec->section)
+    fatal("invalid FDE relocation in __eh_frame");
+  int64_t pcOffset = isec->data.data() - pcSym->isec()->data.data() +
+                     subtrahend.offset - pcSym->value;
+  int64_t targetOffset = pcOffset + (Invert ? -minuend.addend : minuend.addend);
+  if (targetOffset != 0 && target && target->isec()) {
+    const Section &section = target->isec()->section;
+    uint64_t offset = target->isec()->data.data() -
+                          section.subsections.front().isec->data.data() +
+                      target->value + targetOffset;
+    auto *targetIsec =
+        cast<ConcatInputSection>(findContainingSubsection(section, &offset));
+    target = findSymbolAtOffset(targetIsec, offset);
