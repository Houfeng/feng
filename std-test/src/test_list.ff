mod std_test;

use std.collections;

fn list_add_get() {
  let l = List:<i32>();
  let v0: i32 = 42;
  l.add(v0);
  check(l.get(0) == 42, "list/add-get");
}

fn list_size() {
  let l = List:<i32>();
  check(l.size() == 0, "list/size-empty");
  let v1: i32 = 1;
  let v2: i32 = 2;
  let v3: i32 = 3;
  l.add(v1);
  l.add(v2);
  l.add(v3);
  check(l.size() == 3, "list/size-after-add");
}

fn list_set_index() {
  let l = List:<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 99;
  l.add(a);
  l.add(b);
  l.set(0, c);
  check(l.get(0) == 99, "list/set-index");
  check(l.get(1) == 20, "list/set-index-other-unchanged");
}

fn list_remove_shifts() {
  let l = List:<i32>();
  let a: i32 = 10;
  let b: i32 = 20;
  let c: i32 = 30;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(0);
  check(l.get(0) == 20, "list/remove-shifts-first");
  check(l.get(1) == 30, "list/remove-shifts-second");
}

fn list_size_after_remove() {
  let l = List:<i32>();
  let a: i32 = 1;
  let b: i32 = 2;
  let c: i32 = 3;
  l.add(a);
  l.add(b);
  l.add(c);
  l.remove(1);
  check(l.size() == 2, "list/size-after-remove");
}

fn list_multiple_elements() {
  let l = List:<i32>();
  let a0: i32 = 0;
  let a1: i32 = 1;
  let a2: i32 = 2;
  let a3: i32 = 3;
  let a4: i32 = 4;
  l.add(a0);
  l.add(a1);
  l.add(a2);
  l.add(a3);
  l.add(a4);
  check(l.size() == 5, "list/multiple-size");
  let ok: bool = l.get(0) == 0 &&
    l.get(1) == 1 &&
    l.get(2) == 2 &&
    l.get(3) == 3 &&
    l.get(4) == 4;
  check(ok, "list/multiple-values");
}

fn list_entities_order() {
  let l = List:<i32>();
  let a: i32 = 100;
  let b: i32 = 200;
  let c: i32 = 300;
  l.add(a);
  l.add(b);
  l.add(c);
  check(l.get(0) == 100, "list/entities-order-0");
  check(l.get(1) == 200, "list/entities-order-1");
  check(l.get(2) == 300, "list/entities-order-2");
}

fn list_entities_count() {
  let l = List:<i32>();
  let a: i32 = 1;
  let b: i32 = 2;
  l.add(a);
  l.add(b);
  check(l.size() == 2, "list/entities-count");
}

pu fn run_list_tests() {
  list_add_get();
  list_size();
  list_set_index();
  list_remove_shifts();
  list_size_after_remove();
  list_multiple_elements();
  list_entities_order();
  list_entities_count();
}
